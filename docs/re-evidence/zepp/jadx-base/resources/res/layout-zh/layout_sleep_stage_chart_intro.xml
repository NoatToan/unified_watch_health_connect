<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="15dp"
    android:paddingBottom="15dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <com.huami.sleep.view.UnitTextView
            android:textSize="19sp"
            android:textColor="@color/s1"
            android:id="@+id/dpDurationTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:typeface="km"
            app:unitColor="@color/s2"
            app:unitSize="12sp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/s2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/sleep_sign_deep_sleep"
            android:drawablePadding="4dp"
            android:drawableStart="@drawable/slp_info_rect_deep"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <com.huami.sleep.view.UnitTextView
            android:textSize="19sp"
            android:textColor="@color/s1"
            android:id="@+id/lightDurationTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:typeface="km"
            app:unitColor="@color/s2"
            app:unitSize="12sp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/s2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/sleep_sign_light_sleep"
            android:drawablePadding="4dp"
            android:drawableStart="@drawable/slp_info_rect_light"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/remLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <com.huami.sleep.view.UnitTextView
            android:textSize="19sp"
            android:textColor="@color/s1"
            android:id="@+id/remDurationTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:typeface="km"
            app:unitColor="@color/s2"
            app:unitSize="12sp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/s2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/sleep_subview_rem_sleep"
            android:drawablePadding="4dp"
            android:drawableStart="@drawable/slp_info_rect_rem"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <com.huami.sleep.view.UnitTextView
            android:textSize="19sp"
            android:textColor="@color/s1"
            android:id="@+id/wakeDurationTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:typeface="km"
            app:unitColor="@color/s2"
            app:unitSize="12sp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/s2"
            android:id="@+id/titleTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/sleep_subview_awake_sleep"
            android:drawablePadding="4dp"
            android:drawableStart="@drawable/slp_info_rect_wake"/>
    </LinearLayout>
</LinearLayout>
