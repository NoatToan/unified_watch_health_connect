<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout-zh/my_tools_grid_item_0"
    android:background="?attr/selectableItemBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/tool_icon_bk"
        android:tag="binding_1"
        android:layout_width="@dimen/size_40dp"
        android:layout_height="@dimen/size_40dp"
        android:scaleType="fitXY"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:shapeAppearanceOverlay="@style/ShapeCircleStyle"/>
    <ImageView
        android:id="@+id/tool_icon"
        android:tag="binding_2"
        android:layout_width="@dimen/size_24dp"
        android:layout_height="@dimen/size_24dp"
        app:layout_constraintBottom_toBottomOf="@+id/tool_icon_bk"
        app:layout_constraintEnd_toEndOf="@+id/tool_icon_bk"
        app:layout_constraintStart_toStartOf="@+id/tool_icon_bk"
        app:layout_constraintTop_toTopOf="@+id/tool_icon_bk"
        app:tint="@color/s5"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/s1"
        android:gravity="center_horizontal"
        android:id="@+id/tool_name"
        android:tag="binding_3"
        android:layout_width="72dp"
        android:layout_height="32dp"
        android:layout_marginTop="5dp"
        android:maxLines="2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tool_icon_bk"/>
</androidx.constraintlayout.widget.ConstraintLayout>
