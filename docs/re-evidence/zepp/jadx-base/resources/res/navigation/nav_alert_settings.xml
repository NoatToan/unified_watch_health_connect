<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_alert_settings"
    app:startDestination="@+id/alertSettingsHost">
    <fragment
        android:name="com.xiaomi.hm.health.device.settings.alert.AlertSettingsFragment"
        android:id="@+id/alertSettingsHost">
        <action
            android:id="@+id/action_to_incomingCallAlertActivity"
            app:destination="@+id/incomingCallAlertActivity"/>
        <action
            android:id="@+id/action_to_appAlertActivity"
            app:destination="@+id/appAlertActivity"/>
        <action
            android:id="@+id/action_to_longSitAlertActivity"
            app:destination="@+id/longSitAlertActivity"/>
        <action
            android:id="@+id/action_to_standAlertActivity"
            app:destination="@+id/standAlertActivity"/>
        <action
            android:id="@+id/action_to_smAlertActivity"
            app:destination="@+id/smAlertActivity"/>
        <action
            android:id="@+id/action_to_reachGoalRemindActivity"
            app:destination="@+id/reachGoalRemindActivity"/>
    </fragment>
    <activity
        android:label="IncomingCallAlertActivity"
        android:name="com.xiaomi.hm.health.ui.smartplay.IncomingCallAlertActivity"
        android:id="@+id/incomingCallAlertActivity"/>
    <activity
        android:label="AppNotificationAlertActivity"
        android:name="com.xiaomi.hm.health.ui.smartplay.AppNotificationAlertActivity"
        android:id="@+id/appAlertActivity"/>
    <activity
        android:label="LongSitAlertActivity"
        android:name="com.xiaomi.hm.health.ui.smartplay.logsit.LongSitAlertActivity"
        android:id="@+id/longSitAlertActivity"/>
    <activity
        android:label="LongSitAlertActivity"
        android:name="com.xiaomi.hm.health.ui.smartplay.logsit.LongSitAlertActivity"
        android:id="@+id/standAlertActivity"/>
    <activity
        android:label="SMAlertByNotificationActivity"
        android:name="com.xiaomi.hm.health.ui.smartplay.SMAlertByNotificationActivity"
        android:id="@+id/smAlertActivity"/>
    <activity
        android:label="ReachGoalRemindActivity"
        android:name="com.xiaomi.hm.health.ui.smartplay.ReachGoalRemindActivity"
        android:id="@+id/reachGoalRemindActivity"/>
</navigation>
