<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_blood_pressure_correct"
    app:startDestination="@+id/blood_pressure_tips">
    <fragment
        android:name="com.huami.device.feature.health.ui.bloodpressure.fragment.BloodPressureTipsFragment"
        android:id="@+id/blood_pressure_tips">
        <action
            android:id="@+id/blood_pressure_tips_to_person_info"
            app:destination="@+id/blood_pressure_person_info"/>
    </fragment>
    <fragment
        android:name="com.huami.device.feature.health.ui.bloodpressure.fragment.PersonInfoFragment"
        android:id="@+id/blood_pressure_person_info">
        <action
            android:id="@+id/person_info_to_prepare"
            app:destination="@+id/blood_pressure_prepare"/>
    </fragment>
    <fragment
        android:name="com.huami.device.feature.health.ui.bloodpressure.fragment.BloodPressurePrepareFragment"
        android:id="@+id/blood_pressure_prepare">
        <action
            android:id="@+id/prepare_to_guide"
            app:destination="@+id/blood_pressure_guide"/>
        <action
            android:id="@+id/prepare_to_measure"
            app:destination="@+id/blood_pressure_measure"/>
    </fragment>
    <fragment
        android:name="com.huami.device.feature.health.ui.bloodpressure.fragment.BloodPressureGuideFragment"
        android:id="@+id/blood_pressure_guide">
        <action
            android:id="@+id/guide_to_measure"
            app:destination="@+id/blood_pressure_measure"/>
    </fragment>
    <fragment
        android:name="com.huami.device.feature.health.ui.bloodpressure.fragment.BloodPressureMeasureFragment"
        android:id="@+id/blood_pressure_measure">
        <action
            android:id="@+id/measure_to_correct"
            app:destination="@+id/blood_pressure_correct"/>
        <action
            android:id="@+id/measure_to_input"
            app:destination="@+id/blood_pressure_input"/>
    </fragment>
    <dialog
        android:name="com.huami.device.feature.health.ui.bloodpressure.fragment.BloodPressureInputResultFragment"
        android:id="@+id/blood_pressure_input"/>
    <fragment
        android:name="com.huami.device.feature.health.ui.bloodpressure.fragment.BloodPressureCorrectFragment"
        android:id="@+id/blood_pressure_correct"/>
</navigation>
