            android:name="lastPage"
            android:defaultValue="true"
            app:argType="boolean"/>
        <argument
            android:name="filterType"
            android:defaultValue="WEEK"
            app:argType="com.xiaomi.hm.health.running.calori.SportFilterType"/>
    </fragment>
    <fragment
        android:name="com.xiaomi.hm.health.running.calori.CaloriItemFragment"
        android:id="@+id/bt_month_fragment">
        <argument
            android:name="startTime"
            app:argType="long"/>
        <argument
            android:name="endTime"
