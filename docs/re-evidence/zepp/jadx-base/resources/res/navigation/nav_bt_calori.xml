<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" app:startDestination="@+id/bt_day_fragment">
    <fragment
        android:name="com.xiaomi.hm.health.running.calori.CaloriItemFragment"
        android:id="@+id/bt_day_fragment">
        <argument
            android:name="startTime"
            app:argType="long"/>
        <argument
            android:name="endTime"
            app:argType="long"/>
        <argument
            android:name="lastPage"
            android:defaultValue="true"
            app:argType="boolean"/>
