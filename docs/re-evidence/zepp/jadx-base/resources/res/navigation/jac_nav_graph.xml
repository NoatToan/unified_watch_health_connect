<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@+id/JacCarHostFragment">
    <fragment
        android:label="@string/jac_car_s_car_title"
        android:name="com.huami.jac.ui.amazfit.fragment.JacCarHostFragment"
        android:id="@+id/JacCarHostFragment">
        <action
            android:id="@+id/to_no_card"
            app:destination="@+id/JacCardNoKeyFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            app:popUpTo="@+id/JacCarHostFragment"
            app:popUpToInclusive="true"/>
        <action
            android:id="@+id/to_detail"
            app:destination="@+id/JacCardDetailFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            app:popUpTo="@+id/JacCarHostFragment"
            app:popUpToInclusive="true"/>
        <action
            android:id="@+id/to_check"
            app:destination="@+id/JacCarCheckFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            app:popUpTo="@+id/JacCarHostFragment"
            app:popUpToInclusive="true"/>
    </fragment>
    <fragment
        android:label="@string/jac_car_s_car_title"
        android:name="com.huami.jac.ui.amazfit.fragment.JacCardNoKeyFragment"
        android:id="@+id/JacCardNoKeyFragment"/>
    <fragment
        android:name="com.huami.jac.ui.amazfit.fragment.JacCardDetailFragment"
        android:id="@+id/JacCardDetailFragment">
        <argument
            android:name="backToJac"
            android:defaultValue="false"
            app:argType="boolean"/>
    </fragment>
    <fragment
        android:name="com.huami.jac.ui.amazfit.fragment.JacCarCheckFragment"
        android:id="@+id/JacCarCheckFragment">
        <argument
            android:name="action"
            app:argType="string"/>
        <argument
            android:name="token"
            app:argType="string"/>
        <argument
            android:name="keyToken"
            app:argType="string"/>
        <action
            android:id="@+id/to_progress"
            app:destination="@+id/JacCardProgressFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            app:popUpTo="@+id/JacCarCheckFragment"
            app:popUpToInclusive="true"/>
    </fragment>
    <fragment
        android:name="com.huami.jac.ui.amazfit.fragment.JacCardProgressFragment"
        android:id="@+id/JacCardProgressFragment">
        <argument
            android:name="action"
            app:argType="string"/>
        <argument
            android:name="token"
            app:argType="string"/>
        <argument
            android:name="keyToken"
            app:argType="string"/>
        <action
            android:id="@+id/to_result"
            app:destination="@+id/JacCardResultFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            app:popUpTo="@+id/JacCardProgressFragment"
            app:popUpToInclusive="true"/>
    </fragment>
    <fragment
        android:name="com.huami.jac.ui.amazfit.fragment.JacCardResultFragment"
        android:id="@+id/JacCardResultFragment">
        <argument
            android:name="isSuccess"
            app:argType="boolean"/>
        <argument
            android:name="errorMsg"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="errorCode"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <action
            android:id="@+id/to_detail"
            app:destination="@+id/JacCardDetailFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            app:popUpTo="@+id/JacCardResultFragment"
            app:popUpToInclusive="true"/>
    </fragment>
</navigation>
