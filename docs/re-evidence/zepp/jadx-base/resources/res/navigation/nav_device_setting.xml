<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" app:startDestination="@+id/deviceSettingHost">
    <fragment
        android:label="DeviceSetting"
        android:name="com.xiaomi.hm.health.device.setting.ui.DeviceSettingFragment"
        android:id="@+id/deviceSettingHost">
        <action
            android:id="@+id/action_to_aboutDeviceFragment"
            app:destination="@+id/aboutDeviceFragment"/>
        <action
            android:id="@+id/action_to_schedule"
            app:destination="@+id/scheduleActivity"/>
        <action
            android:id="@+id/action_to_reminder"
            app:destination="@+id/eventReminder"/>
        <action
            android:id="@+id/action_to_assistant"
            app:destination="@+id/nav_assistant_v2"/>
        <action
            android:id="@+id/action_to_smartActivity"
            app:destination="@+id/smartActivity"/>
        <action
            android:id="@+id/action_to_watchSettingFragment"
            app:destination="@+id/nav_watch_setting"/>
        <action
            android:id="@+id/action_to_worldClockActivity"
            app:destination="@+id/worldClockActivity"/>
        <action
            android:id="@+id/action_to_smartAssistantSetting"
            app:destination="@+id/smartAssistantSettingFragment"/>
        <action
            android:id="@+id/action_to_miBandAlarmActivity"
            app:destination="@+id/miBandAlarmActivity"/>
        <action
            android:id="@+id/action_to_huamiOSAlarmActivity"
            app:destination="@+id/huamiOSAlarmActivity"/>
        <action
            android:id="@+id/action_to_weatherSettingActivity"
            app:destination="@+id/weatherSettingActivity"/>
        <action
            android:id="@+id/action_to_huamiOSWeatherSettingActivity"
            app:destination="@+id/huamiOSWeatherSettingActivity"/>
        <action
            android:id="@+id/action_to_musicTransferActivity"
            app:destination="@+id/musicActivity"/>
        <action
            android:id="@+id/action_to_esimActivity"
            app:destination="@+id/esimActivity"/>
        <action
            android:id="@+id/action_to_unbindDeviceActivity"
            app:destination="@+id/unbindDeviceActivity">
            <argument
                android:name="unbind_type"
                android:defaultValue="0"
                app:argType="integer"
                app:nullable="false"/>
        </action>
        <action
            android:id="@+id/action_to_incomingCallAlertActivity"
            app:destination="@+id/incomingCallAlertActivity"/>
        <action
            android:id="@+id/action_to_walletActivity"
            app:destination="@+id/walletActivity"/>
        <action
            android:id="@+id/action_to_vibrateTypeActivity"
            app:destination="@+id/vibrateTypeActivity"/>
        <action
            android:id="@+id/action_to_sleepSettingFragment"
            app:destination="@+id/sleepSettingFragment"/>
        <action
            android:id="@+id/action_to_btPhoneActivity"
            app:destination="@+id/btPhoneActivity"/>
        <action
            android:id="@+id/action_to_gt2SystemUpgrade"
            app:destination="@+id/gt2SystemUpgradeActivity"/>
        <action
            android:id="@+id/action_to_sport_setting"
            app:destination="@+id/sportSettingActivity"/>
        <action
            android:id="@+id/action_to_alertSettings"
            app:destination="@+id/nav_alert_settings"/>
        <action
            android:id="@+id/action_to_labActivity"
            app:destination="@+id/labActivity"/>
        <action
            android:id="@+id/action_to_appSortFragment"
            app:destination="@+id/appSortFragment"/>
        <action
            android:id="@+id/action_to_test_repository"
            app:destination="@+id/testDeviceRepository"/>
        <action
            android:id="@+id/action_to_manage_reply_message"
            app:destination="@+id/fragmentTextMessageDirection"/>
        <action
            android:id="@+id/action_to_todoList"
            app:destination="@+id/nav_todo_list"/>
        <action
            android:id="@+id/action_to_recorder"
            app:destination="@+id/deviceRecordActivity"/>
        <action
            android:id="@+id/action_to_smartCardSettingFragment"
            app:destination="@+id/smartCardSettingFragment"/>
        <action
            android:id="@+id/action_to_memberCard"
            app:destination="@+id/memberCardActivity"/>
    </fragment>
    <activity
        android:label="SmartActivity"
        android:name="com.huami.assistant.ui.activity.SmartActivity"
        android:id="@+id/smartActivity"/>
    <fragment
        android:label="AboutDeviceFragment"
        android:name="com.xiaomi.hm.health.device.setting.ui.subview.AboutDeviceFragment"
        android:id="@+id/aboutDeviceFragment"/>
    <fragment
        android:label="AssistantSettingFragment"
        android:name="com.xiaomi.hm.health.device.assistant.smart.SmartAssistantSettingFragment"
        android:id="@+id/smartAssistantSettingFragment">
        <action
            android:id="@+id/action_to_smartCardSettingFragment"
            app:destination="@+id/smartCardSettingFragment"/>
    </fragment>
    <fragment
        android:label="SmartCardSettingFragment"
        android:name="com.xiaomi.hm.health.device.assistant.smart.SmartCardSettingFragment"
        android:id="@+id/smartCardSettingFragment"/>
    <fragment
        android:label="@string/st_sleep_setting"
        android:name="com.xiaomi.hm.health.device.sleep.SleepSettingFragment"
        android:id="@+id/sleepSettingFragment"/>
    <activity
        android:label="ScheduleActivity"
        android:name="com.huami.assistant.ui.v2.ScheduleActivity"
        android:id="@+id/scheduleActivity"/>
    <activity
        android:label="Reminder"
        android:name="com.xiaomi.hm.health.ui.smartplay.eventremind.EventRemindActivity"
        android:id="@+id/eventReminder"/>
    <activity
        android:name="com.huami.worldclock.home.WorldClockActivity"
        android:id="@+id/worldClockActivity">
        <argument
            android:name="device_type"
            android:defaultValue="MILI"
            app:argType="com.xiaomi.hm.health.bt.device.HMDeviceType"/>
    </activity>
    <activity
        android:label="MiBandAlarmActivity"
        android:name="com.xiaomi.hm.health.ui.smartplay.MiBandAlarmActivity"
        android:id="@+id/miBandAlarmActivity"/>
    <activity
        android:label="MiBandAlarmActivity"
        android:name="com.xiaomi.hm.health.ui.smartplay.HuamiOSAlarmActivity"
        android:id="@+id/huamiOSAlarmActivity"/>
    <activity
        android:label="HMWeatherSettingActivity"
        android:name="com.xiaomi.hm.health.device.HMWeatherSettingActivity"
        android:id="@+id/weatherSettingActivity"/>
    <activity
        android:label="HuamiOSWeatherActivity"
        android:name="com.xiaomi.hm.health.weather.HuamiOSWeatherActivity"
        android:id="@+id/huamiOSWeatherSettingActivity"/>
    <activity
        android:label="EsimActivity"
        android:name="com.huami.watch.companion.esim.ui.activity.EsimActivity"
        android:id="@+id/esimActivity"/>
    <activity
        android:label="HMUnbindDeviceActivity"
        android:name="com.xiaomi.hm.health.device.HMUnbindDeviceActivity"
        android:id="@+id/unbindDeviceActivity"/>
    <activity
        android:label="电话设置"
        android:name="com.xiaomi.hm.health.ui.smartplay.IncomingCallAlertActivity"
        android:id="@+id/incomingCallAlertActivity"/>
    <activity
        android:label="@string/app_sort_card_bag"
        android:name="com.xiaomi.hm.health.nfc.WalletActivity"
        android:id="@+id/walletActivity"/>
    <activity
        android:label="@string/custom_vibrate_mode"
        android:name="com.xiaomi.hm.health.ui.smartplay.customvibrate.ui.VibrateTypeActivity"
        android:id="@+id/vibrateTypeActivity"/>
    <activity
        android:label="@string/setting_app_music"
        android:name="com.xiaomi.hm.health.device.MusicManagerActivity"
        android:id="@+id/musicActivity"/>
    <activity
        android:label="电话"
        android:name="com.xiaomi.hm.health.ui.smartplay.btphone.BtPhoneActivity"
        android:id="@+id/btPhoneActivity"/>
    <activity
        android:label="@string/system_update"
        android:name="com.xiaomi.hm.health.device.HMGt2SystemUpgradeActivity"
        android:id="@+id/gt2SystemUpgradeActivity"/>
    <activity
        android:label="@string/widget_sport_order"
        android:name="com.xiaomi.hm.health.device.settings.sport.SportSettingHomeActivity"
        android:id="@+id/sportSettingActivity"/>
    <activity
        android:label="@string/library"
        android:name="com.xiaomi.hm.health.ui.smartplay.SettingItemLibraryActivity"
        android:id="@+id/labActivity"/>
    <activity
        android:label="@string/device_recorder"
        android:name="com.huami.devicerecorder.DeviceRecorderActivity"
        android:id="@+id/deviceRecordActivity"/>
    <activity
        android:label="@string/membership_title"
        android:name="com.huami.member_card.MembershipCardActivity"
        android:id="@+id/memberCardActivity"/>
    <fragment
        android:label="@string/app_list_manage"
        android:name="com.xiaomi.hm.health.device.setting.appsort.AppSortFragment"
        android:id="@+id/appSortFragment"/>
    <fragment
        android:label="Test"
        android:name="com.xiaomi.hm.health.devicex.manage.test.CheckDeviceRepositoryFragment"
        android:id="@+id/testDeviceRepository"/>
    <fragment
        android:label="SMS AND Contact"
        android:name="com.xiaomi.hm.health.device.setting.ui.subview.TextMessageDirectionFragment"
        android:id="@+id/fragmentTextMessageDirection">
        <action
            android:id="@+id/action_to_contact"
            app:destination="@+id/bt_phone_contact_fragment"/>
    </fragment>
    <fragment
        android:name="com.xiaomi.hm.health.ui.smartplay.btphone.contact.BtContactFragment"
        android:id="@+id/bt_phone_contact_fragment">
        <action
            android:id="@+id/contact_back_to_bt_phone"
            app:popUpTo="@+id/bt_phone_fragment"/>
    </fragment>
    <include app:graph="@navigation/nav_assistant_v2"/>
    <include app:graph="@navigation/nav_watch_setting"/>
    <include app:graph="@navigation/nav_alert_settings"/>
    <include app:graph="@navigation/nav_todo_list"/>
</navigation>
