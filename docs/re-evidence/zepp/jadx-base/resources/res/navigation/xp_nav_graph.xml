<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@+id/CarHostFragment">
    <fragment
        android:label="@string/car_s_car_title"
        android:name="com.huami.xiaopeng.ui.amazfit.fragment.CarHostFragment"
        android:id="@+id/CarHostFragment">
        <action
            android:id="@+id/to_no_card"
            app:destination="@+id/CardNoKeyFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            app:popUpTo="@+id/CarHostFragment"
            app:popUpToInclusive="true"/>
        <action
            android:id="@+id/to_detail"
            app:destination="@+id/CardDetailFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            app:popUpTo="@+id/CarHostFragment"
            app:popUpToInclusive="true"/>
        <action
            android:id="@+id/to_check"
            app:destination="@+id/CarCheckFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            app:popUpTo="@+id/CarHostFragment"
            app:popUpToInclusive="true"/>
    </fragment>
    <fragment
        android:label="@string/car_s_car_title"
        android:name="com.huami.xiaopeng.ui.amazfit.fragment.CardNoKeyFragment"
        android:id="@+id/CardNoKeyFragment"/>
    <fragment
        android:name="com.huami.xiaopeng.ui.amazfit.fragment.CardDetailFragment"
        android:id="@+id/CardDetailFragment">
        <argument
            android:name="backToXp"
            android:defaultValue="false"
            app:argType="boolean"/>
    </fragment>
    <fragment
        android:name="com.huami.xiaopeng.ui.amazfit.fragment.CarCheckFragment"
        android:id="@+id/CarCheckFragment">
        <argument
            android:name="action"
            app:argType="string"/>
        <argument
            android:name="token"
            app:argType="string"/>
        <argument
            android:name="keyToken"
            app:argType="string"/>
        <action
            android:id="@+id/to_progress"
            app:destination="@+id/CardProgressFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            app:popUpTo="@+id/CarCheckFragment"
            app:popUpToInclusive="true"/>
    </fragment>
    <fragment
        android:name="com.huami.xiaopeng.ui.amazfit.fragment.CardProgressFragment"
        android:id="@+id/CardProgressFragment">
        <argument
            android:name="action"
            app:argType="string"/>
        <argument
            android:name="token"
            app:argType="string"/>
        <argument
            android:name="keyToken"
            app:argType="string"/>
        <action
            android:id="@+id/to_result"
            app:destination="@+id/CardResultFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            app:popUpTo="@+id/CardProgressFragment"
            app:popUpToInclusive="true"/>
    </fragment>
    <fragment
        android:name="com.huami.xiaopeng.ui.amazfit.fragment.CardResultFragment"
        android:id="@+id/CardResultFragment">
        <argument
            android:name="isSuccess"
            app:argType="boolean"/>
        <argument
            android:name="errorMsg"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="errorCode"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <action
            android:id="@+id/to_detail"
            app:destination="@+id/CardDetailFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            app:popUpTo="@+id/CardResultFragment"
            app:popUpToInclusive="true"/>
    </fragment>
</navigation>
