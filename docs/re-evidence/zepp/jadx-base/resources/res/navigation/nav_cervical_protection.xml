<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_cervical_protection"
    app:startDestination="@+id/cervicalProtectionHomeFragment">
    <fragment
        android:label="CervicalProtectionHomeFragment"
        android:name="com.xiaomi.hm.health.device.headset.ui.fragment.CervicalProtectionHomeFragment"
        android:id="@+id/cervicalProtectionHomeFragment">
        <action
            android:id="@+id/action_cervicalProtectionHomeFragment_to_cervicalProtectionCalibrationFragment"
            app:destination="@+id/cervicalProtectionCalibrationFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/action_cervicalProtectionHomeFragment_to_cervicalProtectionDetailFragment"
            app:destination="@+id/cervicalProtectionDetailFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
    <fragment
        android:label="CervicalProtectionCalibrationFragment"
        android:name="com.xiaomi.hm.health.device.headset.ui.fragment.CervicalProtectionCalibrationFragment"
        android:id="@+id/cervicalProtectionCalibrationFragment">
        <action
            android:id="@+id/action_cervicalProtectionCalibrationFragment_to_cervicalProtectionDetailFragment"
            app:destination="@+id/cervicalProtectionDetailFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
    <fragment
        android:label="CervicalProtectionDetailFragment"
        android:name="com.xiaomi.hm.health.device.headset.ui.fragment.CervicalProtectionDetailFragment"
        android:id="@+id/cervicalProtectionDetailFragment">
        <action
            android:id="@+id/action_cervicalProtection_detail_to_home"
            app:destination="@+id/cervicalProtectionHomeFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/action_cervicalProtectionDetailFragment_to_cervicalProtectionCalibrationFragment"
            app:destination="@+id/cervicalProtectionCalibrationFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
</navigation>
