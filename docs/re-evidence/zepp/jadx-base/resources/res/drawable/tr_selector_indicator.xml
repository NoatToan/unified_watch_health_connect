<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tr_orange"/>
            <size
                android:height="2dp"
                android:width="20dp"/>
            <corners android:radius="1.4dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tr_white"/>
            <size
                android:height="2dp"
                android:width="20dp"/>
            <corners android:radius="1.4dp"/>
        </shape>
    </item>
</selector>
