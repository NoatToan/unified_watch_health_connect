<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#ff6000"/>
            <stroke
                android:width="1px"
                android:color="@color/relatives_black_40_percent"/>
            <corners
                android:topLeftRadius="@dimen/relatives_size_20dp"
                android:topRightRadius="@dimen/relatives_size_20dp"
                android:bottomLeftRadius="@dimen/relatives_size_20dp"
                android:bottomRightRadius="@dimen/relatives_size_20dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#ff6000"/>
            <stroke
                android:width="1px"
                android:color="@color/relatives_black_40_percent"/>
            <corners
                android:topLeftRadius="@dimen/relatives_size_20dp"
                android:topRightRadius="@dimen/relatives_size_20dp"
                android:bottomLeftRadius="@dimen/relatives_size_20dp"
                android:bottomRightRadius="@dimen/relatives_size_20dp"/>
        </shape>
    </item>
</selector>
