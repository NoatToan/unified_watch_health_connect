<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape
            android:shape="ring"
            android:innerRadiusRatio="1"
            android:thicknessRatio="1"
            android:useLevel="false"
            android:innerRadius="31dp"
            android:thickness="4dp">
            <solid android:color="#ffffff"/>
            <size
                android:height="70dp"
                android:width="70dp"/>
        </shape>
    </item>
    <item
        android:left="5dp"
        android:top="5dp"
        android:right="5dp"
        android:bottom="5dp">
        <shape android:shape="oval">
            <solid android:color="#6fca51"/>
            <size
                android:height="59dp"
                android:width="59dp"/>
        </shape>
    </item>
</layer-list>
