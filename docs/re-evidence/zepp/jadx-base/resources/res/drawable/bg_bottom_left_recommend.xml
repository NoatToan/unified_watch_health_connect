<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape
            android:shape="oval"
            android:useLevel="false">
            <solid android:color="@android:color/black"/>
        </shape>
    </item>
    <item>
        <shape
            android:shape="ring"
            android:innerRadiusRatio="2.1"
            android:useLevel="false"
            android:thickness="@dimen/size_1dp">
            <gradient
                android:startColor="#1d1d2b"
                android:endColor="#474748"
                android:angle="45"
                android:type="linear"/>
        </shape>
    </item>
</layer-list>
