<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_checked="true"
        android:color="@color/bm_detail_tab_checked_bg">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/bm_detail_size_23dp"/>
            <solid android:color="@color/bm_detail_tab_checked_bg"/>
        </shape>
    </item>
    <item
        android:state_checked="false"
        android:color="@color/bm_detail_tab_unchecked_bg">
        <shape android:shape="rectangle">
            <corners
                android:topRightRadius="@dimen/bm_detail_size_23dp"
                android:bottomRightRadius="@dimen/bm_detail_size_23dp"/>
            <solid android:color="@color/bm_detail_tab_unchecked_bg"/>
        </shape>
    </item>
</selector>
