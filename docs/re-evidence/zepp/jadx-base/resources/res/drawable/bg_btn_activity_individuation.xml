<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <solid android:color="@color/p5"/>
            <stroke
                android:width="0dp"
                android:color="@color/cl_4d000000"/>
            <corners android:radius="@dimen/size_10dp"/>
            <padding
                android:left="@dimen/round_bg_stroke"
                android:top="@dimen/round_bg_stroke"
                android:right="@dimen/round_bg_stroke"
                android:bottom="@dimen/round_bg_stroke"/>
        </shape>
    </item>
    <item android:state_enabled="true">
        <shape>
            <solid android:color="@color/p3"/>
            <stroke
                android:width="0dp"
                android:color="@color/cl_4d000000"/>
            <corners android:radius="@dimen/size_10dp"/>
            <padding
                android:left="@dimen/round_bg_stroke"
                android:top="@dimen/round_bg_stroke"
                android:right="@dimen/round_bg_stroke"
                android:bottom="@dimen/round_bg_stroke"/>
        </shape>
    </item>
</selector>
