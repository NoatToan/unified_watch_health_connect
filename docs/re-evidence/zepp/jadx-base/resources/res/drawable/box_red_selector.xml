<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_enabled="true"
        android:state_checked="true"
        android:drawable="@drawable/private_haydn_box_red_checked"/>
    <item
        android:state_enabled="false"
        android:state_checked="true">
        <bitmap
            android:src="@drawable/private_haydn_box_red_checked"
            android:alpha="0.3"/>
    </item>
    <item
        android:state_enabled="true"
        android:state_checked="false"
        android:drawable="@drawable/private_haydn_box_red_unchecked"/>
    <item
        android:state_enabled="false"
        android:state_checked="false">
        <bitmap
            android:src="@drawable/private_haydn_box_red_unchecked"
            android:alpha="0.3"/>
    </item>
</selector>
