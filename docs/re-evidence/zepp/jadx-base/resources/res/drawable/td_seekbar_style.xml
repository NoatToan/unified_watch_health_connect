<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="2.5dp"/>
            <gradient
                android:startColor="#80515151"
                android:endColor="#80515151"
                android:angle="270"
                android:centerY="0.5"
                android:centerColor="#80515151"/>
            <size android:height="@dimen/td_size_5dp"/>
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="2.5dp"/>
                <gradient
                    android:startColor="#0076fe"
                    android:endColor="#1ae4bf"
                    android:angle="180"
                    android:centerY="0.5"/>
                <size android:height="@dimen/td_size_5dp"/>
            </shape>
        </clip>
    </item>
</layer-list>
