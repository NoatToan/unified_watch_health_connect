<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="false">
        <layer-list>
            <item
                android:height="14dp"
                android:width="14dp"
                android:drawable="@drawable/ic_check_20_s3"/>
        </layer-list>
    </item>
    <item android:state_checked="true">
        <layer-list>
            <item
                android:height="14dp"
                android:width="14dp"
                android:drawable="@drawable/ic_checked_solid_14"/>
        </layer-list>
    </item>
</selector>
