<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="4dp"/>
            <gradient
                android:startColor="@color/s4"
                android:endColor="@color/s4"
                android:angle="0"/>
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="4dp"/>
                <gradient
                    android:startColor="@color/pai_low_hr"
                    android:endColor="@color/pai_low_hr"
                    android:angle="0"/>
            </shape>
        </clip>
    </item>
</layer-list>
