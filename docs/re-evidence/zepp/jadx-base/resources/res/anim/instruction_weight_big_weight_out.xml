<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android" android:fillBefore="true">
    <scale
        android:duration="1000"
        android:pivotX="100%"
        android:pivotY="50%"
        android:fillAfter="true"
        android:fromXScale="0.64"
        android:toXScale="1"
        android:fromYScale="0.64"
        android:toYScale="1"/>
    <translate
        android:duration="1000"
        android:fillBefore="true"
        android:fromXDelta="20%"
        android:toXDelta="0%"
        android:fromYDelta="0%"
        android:toYDelta="0%"/>
</set>
