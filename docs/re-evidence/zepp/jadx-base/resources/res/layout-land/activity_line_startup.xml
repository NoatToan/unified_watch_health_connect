<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/content"
    android:background="@color/s44"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="start"
        android:id="@+id/td_line_startup_back_btn"
        android:background="@drawable/td_startup_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:layout_marginStart="20dp"/>
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/td_line_startup_setting_btn"
        android:background="@drawable/td_running_setting_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:layout_marginEnd="13dp"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="31sp"
        android:textColor="@color/s5"
        android:layout_gravity="center_horizontal"
        android:id="@+id/startup_title_tx"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="@string/td_startup_title"
        android:fontFamily="lt"
        android:layout_marginStart="4dp"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="19sp"
        android:textColor="@color/s5"
        android:layout_gravity="center_horizontal"
        android:id="@+id/startup_ad_tx"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="89dp"
        android:alpha="0.5"
        android:fontFamily="lt"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="16sp"
        android:textColor="@color/s5"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/startup_ad_friend_tx"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="117dp"
        android:alpha="0.5"
        android:fontFamily="lt"/>
    <RelativeLayout
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/startup_ad_friend"
        android:layout_width="wrap_content"
        android:layout_height="35dp"
        android:layout_marginTop="145dp">
        <com.huami.treadmill.ui.component.HorizontalAvatar
            android:id="@+id/horizontal_avatar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"/>
        <ImageView
            android:id="@+id/startup_ad_friend_refresh"
            android:background="@drawable/td_line_startup_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_toEndOf="@+id/horizontal_avatar"/>
    </RelativeLayout>
    <ImageView
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/startup_bg"
        android:background="@drawable/td_line_startup_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <ImageView
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/line_startup_breath"
        android:background="@drawable/td_line_startup_breath"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</FrameLayout>
