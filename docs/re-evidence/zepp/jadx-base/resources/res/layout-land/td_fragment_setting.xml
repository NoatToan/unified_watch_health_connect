<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/Dialog.FullScreen"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/td_size_54dp">
    <RelativeLayout
        android:gravity="center_vertical"
        android:layout_gravity="end"
        android:orientation="horizontal"
        android:id="@+id/td_unsave_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-82dp"
        android:layout_marginEnd="14dp">
        <ImageView
            android:id="@+id/unsave_icon"
            android:background="@drawable/td_setting_unsave_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </RelativeLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:paddingEnd="57dp">
        <TextView
            android:textSize="18sp"
            android:textColor="@color/s5"
            android:gravity="center_vertical"
            android:id="@+id/td_title_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/td_broadcast_volume"
            android:alpha="0.8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/td_icon_volume_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="15dp"
            android:src="@drawable/td_icon_volume"
            app:layout_constraintBottom_toBottomOf="@+id/td_title_1"
            app:layout_constraintStart_toEndOf="@+id/td_title_1"
            app:layout_constraintTop_toTopOf="@+id/td_title_1"/>
        <ImageView
            android:id="@+id/td_icon_volume_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/td_icon_volumes"
            app:layout_constraintBottom_toBottomOf="@+id/td_title_1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/td_title_1"/>
        <SeekBar
            android:id="@+id/broadcast_volume_controller"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxHeight="@dimen/td_size_5dp"
            android:progressDrawable="@drawable/td_seekbar_style"
            android:minHeight="@dimen/td_size_5dp"
            android:thumb="@drawable/td_dot_shape"
            android:layout_marginStart="14.7dp"
            android:layout_marginEnd="15dp"
            app:layout_constraintBottom_toBottomOf="@+id/td_title_1"
            app:layout_constraintEnd_toStartOf="@+id/td_icon_volume_end"
            app:layout_constraintStart_toEndOf="@+id/td_icon_volume_start"
            app:layout_constraintTop_toTopOf="@+id/td_title_1"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/td_size_67dp"
        android:paddingEnd="57dp">
        <TextView
            android:textSize="18sp"
            android:textColor="@color/s5"
            android:gravity="center_vertical"
            android:id="@+id/td_title_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/td_screen_brightness"
            android:alpha="0.8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/td_icon_brightness_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="15dp"
            android:src="@drawable/td_ic_screen_brightness"
            app:layout_constraintBottom_toBottomOf="@+id/td_title_2"
            app:layout_constraintStart_toEndOf="@+id/td_title_2"
            app:layout_constraintTop_toTopOf="@+id/td_title_2"/>
        <ImageView
            android:id="@+id/td_icon_brightness_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/td_ic_screen_brightness_on"
            app:layout_constraintBottom_toBottomOf="@+id/td_title_2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/td_title_2"/>
        <SeekBar
            android:id="@+id/light_controller"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxHeight="@dimen/td_size_5dp"
            android:progressDrawable="@drawable/td_seekbar_style"
            android:minHeight="@dimen/td_size_5dp"
            android:thumb="@drawable/td_dot_shape"
            android:layout_marginStart="14.7dp"
            android:layout_marginEnd="15dp"
            app:layout_constraintBottom_toBottomOf="@+id/td_title_2"
            app:layout_constraintEnd_toStartOf="@+id/td_icon_brightness_end"
            app:layout_constraintStart_toEndOf="@+id/td_icon_brightness_start"
            app:layout_constraintTop_toTopOf="@+id/td_title_2"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bg_music_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/td_size_67dp"
        android:paddingEnd="57dp">
        <TextView
            android:textSize="18sp"
            android:textColor="@color/s5"
            android:gravity="center_vertical"
            android:id="@+id/td_title_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/td_background_music"
            android:alpha="0.8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/td_icon_bg_volume_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="15dp"
            android:src="@drawable/td_icon_volume"
            app:layout_constraintBottom_toBottomOf="@+id/td_title_3"
            app:layout_constraintStart_toEndOf="@+id/td_title_3"
            app:layout_constraintTop_toTopOf="@+id/td_title_3"/>
        <ImageView
            android:id="@+id/td_icon_bg_volume_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/td_icon_volumes"
            app:layout_constraintBottom_toBottomOf="@+id/td_title_3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/td_title_3"/>
        <SeekBar
            android:id="@+id/bg_music_controller"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxHeight="@dimen/td_size_5dp"
            android:progressDrawable="@drawable/td_seekbar_style"
            android:minHeight="@dimen/td_size_5dp"
            android:thumb="@drawable/td_dot_shape"
            android:layout_marginStart="14.7dp"
            android:layout_marginEnd="15dp"
            app:layout_constraintBottom_toBottomOf="@+id/td_title_3"
            app:layout_constraintEnd_toStartOf="@+id/td_icon_bg_volume_end"
            app:layout_constraintStart_toEndOf="@+id/td_icon_bg_volume_start"
            app:layout_constraintTop_toTopOf="@+id/td_title_3"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
