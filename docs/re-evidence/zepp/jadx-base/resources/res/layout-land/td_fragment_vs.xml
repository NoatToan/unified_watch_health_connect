<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/Dialog.FullScreen"
    android:id="@+id/td_vs_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/td_vs_middle_btn"
        android:background="@drawable/td_vs_btn_bg"
        android:layout_width="@dimen/td_size_154dp"
        android:layout_height="@dimen/td_size_154dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="58sp"
            android:textColor="@color/s5"
            android:gravity="center_horizontal"
            android:id="@+id/td_vs_middle_btn_tx"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="ow"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="12sp"
            android:textColor="@color/s5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/td_speed_unit"
            android:fontFamily="lt"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/td_vs_start_btn"
        android:background="@drawable/td_vs_btn_bg"
        android:layout_width="@dimen/td_size_154dp"
        android:layout_height="@dimen/td_size_154dp"
        android:layout_marginEnd="@dimen/td_size_30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/td_vs_middle_btn"
        app:layout_constraintTop_toTopOf="parent">
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="58sp"
            android:textColor="@color/s5"
            android:gravity="center_horizontal"
            android:id="@+id/td_vs_start_btn_tx"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="ow"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="12sp"
            android:textColor="@color/s5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/td_speed_unit"
            android:fontFamily="lt"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/td_vs_end_btn"
        android:background="@drawable/td_vs_btn_bg"
        android:layout_width="@dimen/td_size_154dp"
        android:layout_height="@dimen/td_size_154dp"
        android:layout_marginStart="@dimen/td_size_30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/td_vs_middle_btn"
        app:layout_constraintTop_toTopOf="parent">
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="58sp"
            android:textColor="@color/s5"
            android:gravity="center_horizontal"
            android:id="@+id/td_vs_end_btn_tx"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="ow"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="12sp"
            android:textColor="@color/s5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/td_speed_unit"
            android:fontFamily="lt"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
