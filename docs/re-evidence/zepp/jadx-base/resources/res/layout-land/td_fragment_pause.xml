<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:c="http://schemas.android.com/apk/res-auto"
    android:theme="@style/Dialog.FullScreen"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/td_unsave_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:layout_marginStart="15dp">
        <ImageView
            android:id="@+id/unsave_icon"
            android:background="@drawable/td_pause_unsave_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:layout_alignParentTop="true"
            android:layout_marginStart="10dp"
            android:layout_alignParentStart="true"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="15sp"
            android:textColor="@color/s5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/td_pause_unsave_tips"
            android:layout_toRightOf="@+id/unsave_icon"
            android:layout_centerVertical="true"
            android:alpha="0.6"
            android:fontFamily="lt"
            android:layout_marginStart="10dp"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/td_pause"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageButton
            android:id="@+id/td_pause_continue_btn"
            android:background="@drawable/td_pause_continue_btn_bg"
            android:layout_width="@dimen/td_size_154dp"
            android:layout_height="@dimen/td_size_154dp"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="16sp"
            android:textColor="@color/s5"
            android:gravity="center"
            android:id="@+id/continue_tx"
            android:layout_width="154dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/td_pause_continue_tips"
            android:layout_below="@+id/td_pause_continue_btn"
            android:fontFamily="lt"/>
        <com.huami.treadmill.ui.component.CustomRoundProgressBar
            android:id="@+id/td_pause_finish_btn"
            android:background="@drawable/td_pause_finish_btn_bg"
            android:layout_width="@dimen/td_size_154dp"
            android:layout_height="@dimen/td_size_154dp"
            android:layout_toRightOf="@+id/td_pause_continue_btn"
            android:layout_marginStart="68dp"
            c:RoundProgressBarProgressBgColor="#4cffffff"
            c:RoundProgressBarProgressBgWidth="2dp"
            c:RoundProgressBarProgressColor="@color/s5"
            c:RoundProgressBarProgressWidth="2dp"
            c:RoundProgressBarTotal="1000"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="16sp"
            android:textColor="@color/s5"
            android:gravity="center"
            android:layout_width="154dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/td_pause_finish_tips"
            android:layout_below="@+id/td_pause_finish_btn"
            android:fontFamily="lt"
            android:layout_marginStart="222dp"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</FrameLayout>
