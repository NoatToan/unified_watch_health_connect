<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/content"
    android:background="@color/s44"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:gravity="center_vertical"
        android:layout_gravity="end"
        android:orientation="horizontal"
        android:id="@+id/td_running_setting_btn"
        android:background="@drawable/td_setting_unsave_btn_bg"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:layout_marginEnd="13dp">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/td_running_setting_icon"/>
    </RelativeLayout>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:layout_width="650dp"
        android:layout_height="wrap_content">
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="42sp"
            android:textColor="@color/s5"
            android:gravity="center"
            android:id="@+id/td_running_time_tx"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:layout_weight="1"
            android:layout_centerInParent="true"
            android:fontFamily="km"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="42sp"
            android:textColor="@color/s5"
            android:gravity="center"
            android:id="@+id/td_running_round_tx"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="0"
            android:layout_weight="1"
            android:layout_centerInParent="true"
            android:fontFamily="km"/>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="center"
        android:layout_width="650dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp">
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="15sp"
            android:textColor="#b3fbfbfb"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/td_running_time"
            android:layout_weight="1"
            android:layout_centerHorizontal="true"
            android:fontFamily="lt"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="15sp"
            android:textColor="#b3fbfbfb"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/td_running_round"
            android:layout_weight="1"
            android:layout_centerHorizontal="true"
            android:fontFamily="lt"/>
    </LinearLayout>
    <RelativeLayout
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.huami.treadmill.ui.component.HrRingView
            android:id="@+id/hr_ring_vw"
            android:layout_width="143dp"
            android:layout_height="143dp"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_gravity="center"
        android:id="@+id/running_fat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="42sp"
            android:textColor="@color/s5"
            android:id="@+id/td_running_fat_tx"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:layout_centerInParent="true"
            android:fontFamily="km"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="15sp"
            android:textColor="@color/s5"
            android:gravity="top|center_horizontal"
            android:id="@+id/td_running_fat_tip_tx"
            android:layout_width="83dp"
            android:layout_height="90dp"
            android:layout_marginTop="80dp"
            android:layout_below="@+id/td_running_fat_tx"
            android:layout_centerHorizontal="true"
            android:alpha="0.7"
            android:fontFamily="lt"/>
    </RelativeLayout>
    <ImageView
        android:layout_gravity="center"
        android:background="@drawable/td_running_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <ImageView
        android:layout_gravity="center"
        android:background="@drawable/td_running_inner_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <RelativeLayout
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.huami.treadmill.ui.component.AvatarTailView
            android:id="@+id/avatar_tail_vw"
            android:layout_width="591dp"
            android:layout_height="250dp"/>
    </RelativeLayout>
</FrameLayout>
