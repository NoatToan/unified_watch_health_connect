<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/content"
    android:background="#000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="start"
        android:id="@+id/td_startup_back_btn"
        android:background="@drawable/td_startup_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:layout_marginStart="20dp"/>
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/td_startup_setting_btn"
        android:background="@drawable/td_running_setting_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:layout_marginEnd="13dp"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="30sp"
        android:textColor="@color/s5"
        android:layout_gravity="center_horizontal"
        android:id="@+id/startup_title_tx"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="52dp"
        android:text="@string/td_startup_title"
        android:fontFamily="lt"
        android:layout_marginStart="4dp"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="18sp"
        android:textColor="@color/s5"
        android:layout_gravity="center_horizontal"
        android:id="@+id/startup_ad_tx"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="100dp"
        android:text="@string/td_startup_ad"
        android:alpha="0.9"
        android:fontFamily="lt"/>
    <ImageView
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/startup_bg"
        android:background="@drawable/td_startup_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <ImageView
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/startup_breath"
        android:background="@drawable/td_startup_breath"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</FrameLayout>
