<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/container"
    android:background="#000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:background="@drawable/td_error_info_bg_shape"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <RelativeLayout
        android:layout_gravity="center"
        android:background="@drawable/td_error_info_shape"
        android:layout_width="295dp"
        android:layout_height="wrap_content">
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="16sp"
            android:textColor="@color/s5"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/td_erorr_info_title"
            android:layout_width="268dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="@string/td_error_stop_info"
            android:fontFamily="lt"
            android:layout_marginStart="14dp"/>
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/td_erorr_info_img"
            android:background="@drawable/td_error_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_below="@+id/td_erorr_info_title"
            android:layout_marginStart="15dp"/>
    </RelativeLayout>
</FrameLayout>
