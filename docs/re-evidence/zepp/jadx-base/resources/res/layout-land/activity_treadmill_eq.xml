<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/title_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="48dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="start|center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/arrow_back"
                android:layout_marginStart="11dp"/>
            <TextView
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bolt_eq_title"/>
        </FrameLayout>
        <com.xiaomi.hm.health.device.view.TreadmillEqView
            android:id="@+id/eq_view"
            android:background="@color/s10"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <com.xiaomi.hm.health.device.view.TreadmillEqBottomView
            android:id="@+id/eq_bottom_view"
            android:layout_width="match_parent"
            android:layout_height="34dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="41dp">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/s2"
                android:gravity="center"
                android:id="@+id/eq_close"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/eq_close"
                android:layout_weight="1"
                android:onClick="onClick"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/s2"
                android:gravity="center"
                android:id="@+id/eq_diy"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/eq_diy"
                android:layout_weight="1"
                android:onClick="onClick"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/s2"
                android:gravity="center"
                android:id="@+id/eq_popular"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/eq_liuxing"
                android:layout_weight="1"
                android:onClick="onClick"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/s2"
                android:gravity="center"
                android:id="@+id/eq_dance"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/eq_wuqu"
                android:layout_weight="1"
                android:onClick="onClick"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/s2"
                android:gravity="center"
                android:id="@+id/eq_blue"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/eq_landiao"
                android:layout_weight="1"
                android:onClick="onClick"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/s2"
                android:gravity="center"
                android:id="@+id/eq_classic"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/eq_gudian"
                android:layout_weight="1"
                android:onClick="onClick"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/s2"
                android:gravity="center"
                android:id="@+id/eq_jazz"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/eq_jueshi"
                android:layout_weight="1"
                android:onClick="onClick"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/s2"
                android:gravity="center"
                android:id="@+id/eq_slow"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/eq_mange"
                android:layout_weight="1"
                android:onClick="onClick"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/s2"
                android:gravity="center"
                android:id="@+id/eq_electronic"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/eq_dianziyue"
                android:layout_weight="1"
                android:onClick="onClick"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/s2"
                android:gravity="center"
                android:id="@+id/eq_rock"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/eq_yaogun"
                android:layout_weight="1"
                android:onClick="onClick"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/s2"
                android:gravity="center"
                android:id="@+id/eq_country"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/eq_xiangcun"
                android:layout_weight="1"
                android:onClick="onClick"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/s2"
                android:gravity="center"
                android:id="@+id/eq_voice"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/eq_rensheng"
                android:layout_weight="1"
                android:onClick="onClick"/>
        </LinearLayout>
    </LinearLayout>
    <View
        android:id="@+id/mask_view"
        android:background="@color/cl_4d000000"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
