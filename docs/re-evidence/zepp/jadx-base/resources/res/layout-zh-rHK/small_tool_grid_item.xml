<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout-zh-rHK/small_tool_grid_item_0"
    android:background="?attr/selectableItemBackground"
    android:layout_width="match_parent"
    android:layout_height="94dp">
    <androidx.cardview.widget.CardView
        android:id="@+id/bg_card_view"
        android:visibility="gone"
        android:layout_width="72dp"
        android:layout_height="90dp"
        app:cardBackgroundColor="@color/s38"
        app:cardCornerRadius="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/tool_icon_card_bk"
                android:tag="binding_1"
                android:layout_width="@dimen/td_size_44dp"
                android:layout_height="@dimen/td_size_44dp"
                android:layout_marginTop="9dp"
                android:scaleType="fitXY"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"
                app:shapeAppearanceOverlay="@style/ShapeCircleStyle"/>
            <ImageView
                android:id="@+id/tool_icon_card"
                android:tag="binding_2"
                android:layout_width="@dimen/size_24dp"
                android:layout_height="@dimen/size_24dp"
                android:elevation="2dp"
                app:layout_constraintBottom_toBottomOf="@+id/tool_icon_card_bk"
                app:layout_constraintEnd_toEndOf="@+id/tool_icon_card_bk"
                app:layout_constraintStart_toStartOf="@+id/tool_icon_card_bk"
                app:layout_constraintTop_toTopOf="@+id/tool_icon_card_bk"
                app:tint="@color/s5"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/s1"
                android:gravity="center_horizontal"
                android:id="@+id/tool_name_card"
                android:tag="binding_3"
                android:layout_width="72dp"
                android:layout_height="0dp"
                android:layout_marginTop="4dp"
                android:maxLines="2"
                android:elevation="2dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tool_icon_card_bk"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/tool_icon_bk"
        android:tag="binding_4"
        android:layout_width="@dimen/td_size_44dp"
        android:layout_height="@dimen/td_size_44dp"
        android:layout_marginTop="@dimen/size_11dp"
        android:scaleType="fitXY"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:shapeAppearanceOverlay="@style/ShapeCircleStyle"/>
    <ImageView
        android:id="@+id/tool_icon"
        android:tag="binding_5"
        android:layout_width="@dimen/size_24dp"
        android:layout_height="@dimen/size_24dp"
        android:elevation="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/tool_icon_bk"
        app:layout_constraintEnd_toEndOf="@+id/tool_icon_bk"
        app:layout_constraintStart_toStartOf="@+id/tool_icon_bk"
        app:layout_constraintTop_toTopOf="@+id/tool_icon_bk"
        app:tint="@color/s5"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/s1"
        android:gravity="center_horizontal"
        android:id="@+id/tool_name"
        android:tag="binding_6"
        android:layout_width="72dp"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="2dp"
        android:maxLines="2"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"
        android:elevation="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tool_icon_bk"/>
</androidx.constraintlayout.widget.ConstraintLayout>
