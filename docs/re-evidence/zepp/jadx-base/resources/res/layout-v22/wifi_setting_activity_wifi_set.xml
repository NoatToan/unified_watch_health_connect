<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/device_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <RelativeLayout
        android:id="@+id/layout_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/device_status">
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/wifi_set_title"
            android:layout_centerHorizontal="true"
            style="@style/Rainbow.TextAppearance.Title1"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/wifi_set_tip"
            android:layout_below="@+id/tv_title"
            android:layout_centerHorizontal="true"
            style="@style/Rainbow.TextAppearance.Body4"/>
        <RelativeLayout
            android:id="@+id/layout_wifi_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="60dp"
            android:layout_below="@+id/tv_tip"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp">
            <androidx.appcompat.widget.AppCompatEditText
                android:textSize="15sp"
                android:typeface="monospace"
                android:textColor="@color/s1"
                android:textColorHint="@color/s21"
                android:gravity="start|center_vertical"
                android:id="@+id/edit_wifi_name"
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:hint="请输入Wifi名字"
                android:drawablePadding="6dp"
                android:textCursorDrawable="@null"
                android:drawableStart="@mipmap/wifi_setting_icon_wifi"
                android:textAlignment="viewStart"
                android:drawableTint="@color/s1"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="15sp"
                android:textColor="@color/s21"
                android:gravity="center"
                android:id="@+id/tv_other_wifi"
                android:layout_width="wrap_content"
                android:layout_height="60dp"
                android:text="@string/wifi_other_wifi"
                android:drawablePadding="3dp"
                android:drawableEnd="@mipmap/wifi_setting_icon_arrow_right"
                android:layout_alignParentEnd="true"
                android:drawableTint="@color/s21"/>
            <View
                android:id="@+id/line"
                android:background="@color/s5"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_below="@+id/edit_wifi_name"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12sp"
                android:textColor="@color/p3"
                android:id="@+id/tv_wifi_tips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/wifi_set_tip1"
                android:drawablePadding="7dp"
                android:layout_below="@+id/line"
                android:drawableEnd="@mipmap/icon_wifi_help"
                android:drawableTint="@color/p3"/>
        </RelativeLayout>
        <FrameLayout
            android:orientation="vertical"
            android:id="@+id/layout_wifi_pwd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:layout_below="@+id/layout_wifi_name"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp">
            <androidx.appcompat.widget.AppCompatEditText
                android:textSize="15sp"
                android:typeface="monospace"
                android:textColor="@color/s1"
                android:textColorHint="@color/s21"
                android:gravity="start|center_vertical"
                android:id="@+id/edit_wifi_pwd"
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:hint="请输入密码"
                android:drawablePadding="6dp"
                android:inputType="textPassword"
                android:textCursorDrawable="@null"
                android:drawableStart="@mipmap/wifi_setting_icon_wifi_password"
                android:textAlignment="viewStart"
                android:drawableTint="@color/s1"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="end|center_vertical"
                android:id="@+id/iv_show_password"
                android:visibility="gone"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@mipmap/wifi_setting_icon_pwd_eye_close"
                android:scaleType="centerInside"
                android:tint="@color/s2"
                android:alpha="0.4"
                android:layout_marginEnd="15dp"/>
            <View
                android:layout_gravity="bottom"
                android:background="@color/s5"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
        </FrameLayout>
        <Button
            android:enabled="false"
            android:id="@+id/tv_connect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="60dp"
            android:text="@string/wifi_connect"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            style="@style/Rainbow.Widget.Button.48"/>
    </RelativeLayout>
    <View
        android:id="@+id/mask_view"
        android:background="#77f7f7f7"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/device_status"/>
</RelativeLayout>
