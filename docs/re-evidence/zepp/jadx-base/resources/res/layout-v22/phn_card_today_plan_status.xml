<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/phn_shape_card_common"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_plan_card_image"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/phn_coach_today_plan_img"
        android:scaleType="fitXY"
        android:contentDescription="@string/phn_welcome_use_content_modify"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/tv_plan_today_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:text="@string/phn_no_plan_today"
        android:layout_marginStart="16dp"
        style="@style/Rainbow.TextAppearance.Title1"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/s2"
        android:id="@+id/tv_plan_today_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="16dp"
        android:text="@string/phn_no_plan_today_desc"
        android:layout_marginStart="16dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_plan_today_button_content"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="15dp">
        <View
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/s2"
            android:layout_gravity="center"
            android:id="@+id/tv_plan_today_card_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/phn_making_plans"
            android:drawableEnd="@drawable/ic_arrow_forward_20_2x"
            android:drawableTint="@color/s2"/>
    </LinearLayout>
</LinearLayout>
