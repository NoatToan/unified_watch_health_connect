<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/td_size_30dp">
    <FrameLayout
        android:id="@+id/top_one"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/top_one_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/td_size_43dp"
            android:src="@drawable/top_diligent_one"/>
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/top_icon"
            android:layout_width="@dimen/td_size_38dp"
            android:layout_height="@dimen/td_size_38dp"
            android:layout_marginTop="@dimen/td_size_31dp"
            android:scaleType="centerCrop"/>
        <ImageView
            android:layout_gravity="center_horizontal"
            android:background="@drawable/td_ring_stroke"
            android:layout_width="@dimen/td_size_38dp"
            android:layout_height="@dimen/td_size_38dp"
            android:layout_marginTop="@dimen/td_size_31dp"
            android:scaleType="centerCrop"/>
        <TextView
            android:textSize="13.4sp"
            android:textColor="@color/s5"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/top_name"
            android:layout_width="@dimen/td_size_54dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/td_size_19dp"
            android:lines="1"/>
        <ImageView
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/td_size_21dp"
            android:src="@drawable/td_crown"/>
    </FrameLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/s2"
        android:gravity="end"
        android:id="@+id/got_to_kings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/td_size_24dp"
        android:text="@string/td_successive_kings"
        android:drawablePadding="@dimen/td_size_5dp"
        android:lineSpacingExtra="1.4sp"
        android:drawableEnd="@drawable/ic_arrow_forward_20_2x"
        android:layout_marginEnd="@dimen/td_size_23dp"
        android:drawableTint="@color/s2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/s2"
        android:id="@+id/top_left_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="-3.5sp"
        android:layout_marginEnd="@dimen/td_size_6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_one"/>
</androidx.constraintlayout.widget.ConstraintLayout>
