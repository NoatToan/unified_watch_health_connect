<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:scrollbars="none"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="never">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_marginHorizontal="10dp">
        <com.huami.lib.rainbow.ListTile
            android:id="@+id/account_bind"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="?attr/listPreferredItemHeightSmall"
            app:ltv_radius_position="all"
            app:ltv_title="@string/account_ui_account_and_security_title"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">
            <com.huami.lib.rainbow.ListTile
                android:id="@+id/night_setting_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="?attr/listPreferredItemHeightSmall"
                app:ltv_radius_position="top"
                app:ltv_title="@string/app_night_mode"/>
            <com.huami.lib.rainbow.ListTile
                android:id="@+id/unit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="?attr/listPreferredItemHeightSmall"
                app:ltv_title="@string/setting_unit"/>
            <com.huami.lib.rainbow.ListTile
                android:id="@+id/notify"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="?attr/listPreferredItemHeightSmall"
                app:ltv_checked="true"
                app:ltv_radius_position="bottom"
                app:ltv_subtitle="@string/notification_switch_subtitle"
                app:ltv_title="@string/notification_switch_title"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <com.huami.lib.rainbow.ListTile
            android:id="@+id/cache"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="?attr/listPreferredItemHeightSmall"
            app:ltv_radius_position="top"
            app:ltv_title="@string/setting_cache"/>
        <com.huami.lib.rainbow.ListTile
            android:id="@+id/permission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/listPreferredItemHeightSmall"
            app:ltv_title="@string/permission_manager_button_text"/>
        <com.huami.lib.rainbow.ListTile
            android:id="@+id/revoke"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/listPreferredItemHeightSmall"
            app:ltv_title="@string/setting_revoke"/>
        <com.huami.lib.rainbow.ListTile
            android:id="@+id/lab"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/listPreferredItemHeightSmall"
            app:ltv_title="@string/action_mark"/>
        <com.huami.lib.rainbow.ListTile
            android:id="@+id/update"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/listPreferredItemHeightSmall"
            app:ltv_title="@string/setting_update"/>
        <com.huami.lib.rainbow.ListTile
            android:id="@+id/about"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/listPreferredItemHeightSmall"
            app:itemDivider="gone"
            app:ltv_radius_position="bottom"
            app:ltv_title="@string/setting_about"/>
        <com.huami.lib.rainbow.ListTile
            android:id="@+id/developer"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/listPreferredItemHeightSmall"
            app:ltv_checked="true"
            app:ltv_radius_position="bottom"
            app:ltv_title="@string/devicex_developer_mode"/>
        <com.huami.http.serverfault.widget.ServerFaultView
            android:id="@+id/server_fault_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_12dp"
            android:layout_marginStart="@dimen/size_20dp"
            android:layout_marginEnd="@dimen/size_20dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/size_14sp"
            android:textColor="@color/s2"
            android:gravity="center"
            android:id="@+id/current_login_info_text"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:lineSpacingExtra="8dp"
            android:layout_marginStart="@dimen/size_22dp"
            android:layout_marginEnd="@dimen/size_22dp"/>
        <Button
            android:textColor="@color/p3"
            android:id="@+id/logout"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="64dp"
            android:text="@string/logout"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:backgroundTint="@color/s38"
            style="@style/Rainbow.Widget.Button.48"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</ScrollView>
