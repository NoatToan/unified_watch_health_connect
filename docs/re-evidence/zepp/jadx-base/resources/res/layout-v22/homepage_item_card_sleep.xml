<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.huami.module.homepage.cards.cardui.CardTitleBarView
        android:id="@+id/sleep_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:showExpandButton="false"
        app:titleText="@string/homepage_item_card_sleep"/>
    <View
        android:id="@+id/left_vertical_line"
        android:background="@color/s4"
        android:layout_width="0.5dp"
        android:layout_height="50dp"
        android:layout_marginTop="15dp"
        app:layout_constraintEnd_toStartOf="@+id/right_vertical_line"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sleep_bar"/>
    <View
        android:id="@+id/right_vertical_line"
        android:background="@color/s4"
        android:layout_width="0.5dp"
        android:layout_height="50dp"
        android:layout_marginTop="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/left_vertical_line"
        app:layout_constraintTop_toBottomOf="@+id/sleep_bar"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/sleep_smile"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/sleep_score"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/sleep_score"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/sleep_score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBaseline_toBaselineOf="@+id/sleep_duration"
        app:layout_constraintStart_toEndOf="@+id/sleep_smile"
        style="@style/Rainbow.TextAppearance.Number4"/>
    <TextView
        android:textColor="@color/s2"
        android:ellipsize="end"
        android:id="@+id/sleep_score_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxWidth="95dp"
        android:text="@string/homepage_item_card_sleep_score"
        android:maxLines="1"
        android:layout_marginStart="15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sleep_smile"
        style="@style/Rainbow.TextAppearance.Body5"/>
    <TextView
        android:textColor="@color/s2"
        android:id="@+id/sleep_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        app:layout_constraintStart_toEndOf="@+id/left_vertical_line"
        app:layout_constraintTop_toTopOf="@+id/left_vertical_line"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <TextView
        android:textColor="@color/s2"
        android:ellipsize="end"
        android:id="@+id/sleep_duration_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="95dp"
        android:text="@string/homepage_item_card_sleep_duration"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="@+id/sleep_score_title"
        app:layout_constraintStart_toStartOf="@+id/sleep_duration"
        app:layout_constraintTop_toTopOf="@+id/sleep_score_title"
        style="?attr/textAppearanceBody5"/>
    <TextView
        android:textColor="@color/s2"
        android:id="@+id/deep_sleep_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        app:layout_constraintStart_toEndOf="@+id/right_vertical_line"
        app:layout_constraintTop_toTopOf="@+id/left_vertical_line"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <TextView
        android:textColor="@color/s2"
        android:ellipsize="end"
        android:id="@+id/deep_sleep_duration_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="90dp"
        android:text="@string/homepage_item_card_deep_sleep_duration"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="@+id/sleep_score_title"
        app:layout_constraintStart_toStartOf="@+id/deep_sleep_duration"
        app:layout_constraintTop_toTopOf="@+id/sleep_score_title"
        style="@style/Rainbow.TextAppearance.Body5"/>
    <FrameLayout
        android:id="@+id/sleep_chart_container"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/left_vertical_line"/>
    <FrameLayout
        android:id="@+id/hrChartLayout"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        app:layout_constraintBottom_toBottomOf="@+id/sleep_chart_container"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/sleep_start_time"
        android:paddingBottom="15dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@+id/sleep_chart_container"
        app:layout_constraintTop_toBottomOf="@+id/sleep_chart_container"
        style="@style/Rainbow.TextAppearance.Number8"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/sleep_end_time"
        android:paddingBottom="15dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/sleep_start_time"
        app:layout_constraintEnd_toEndOf="@+id/sleep_chart_container"
        app:layout_constraintTop_toTopOf="@+id/sleep_start_time"
        style="@style/Rainbow.TextAppearance.Number8"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/detail"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sleep_start_time">
        <TextView
            android:textColor="@color/s1"
            android:id="@+id/avg_sleep_title"
            android:paddingLeft="15dp"
            android:paddingRight="15dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingHorizontal="15dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Rainbow.TextAppearance.Body4"/>
        <FrameLayout
            android:id="@+id/avg_sleep_chart_container"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginTop="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/avg_sleep_title"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.huami.module.homepage.cards.cardui.BackgroundTextView
        android:textColor="@color/s1"
        android:gravity="center"
        android:id="@+id/no_sleep_data"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:text="@string/homepage_item_card_no_sleep_data"
        app:backgroundTintAlpha="0.92"
        app:cornerDirection="bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sleep_bar"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <TextView
        android:textColor="@color/s2"
        android:id="@+id/nap_sleep_time"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginStart="15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sleep_bar"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <TextView
        android:textColor="@color/s2"
        android:id="@+id/nap_sleep_state"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="@string/homepage_nap_sleep"
        android:layout_marginStart="15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/nap_sleep_time"
        style="@style/Rainbow.TextAppearance.Body5"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/homepage_normal_sleep_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="left_vertical_line,right_vertical_line,sleep_smile,sleep_score,sleep_score_title,sleep_duration,sleep_duration_title,deep_sleep_duration,deep_sleep_duration_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
