<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/login_scroll_view"
    android:background="@color/s10"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:background="@drawable/account_ui_bg_2022"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/login_linear_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.huami.lib.rainbow.titlebar.RainbowTitleBar
                android:id="@+id/title_bar"
                android:background="@color/account_ui_transparency"
                android:layout_width="match_parent"
                android:layout_height="@dimen/account_ui_size_50dp"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center_horizontal"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginTop="30dp"
                android:src="@drawable/app_icon_60"/>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/account_ui_hm_email_input_height"
                android:layout_marginTop="40dp"
                android:paddingStart="@dimen/account_ui_account_login_side_padding"
                android:paddingEnd="@dimen/account_ui_account_login_side_padding">
                <androidx.appcompat.widget.AppCompatEditText
                    android:textSize="@dimen/account_ui_phone_edit_text_size"
                    android:typeface="monospace"
                    android:textColor="@color/s1"
                    android:textColorHint="@color/s3"
                    android:gravity="start|center_vertical"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/et_username"
                    android:background="@drawable/account_ui_bg_login_edit"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/account_ui_hm_email_input_height"
                    android:hint="@string/account_ui_input_phone_or_email"
                    android:inputType="text"
                    android:paddingStart="@dimen/account_ui_padding_login_editor_start"
                    android:paddingEnd="@dimen/account_ui_editor_clear_padding_end"
                    android:autofillHints="username"/>
                <ImageView
                    android:layout_gravity="end"
                    android:id="@+id/btn_username_clear"
                    android:layout_width="@dimen/account_ui_hm_email_input_height"
                    android:layout_height="@dimen/account_ui_hm_email_input_height"
                    android:src="@drawable/account_ui_editor_clear"
                    android:scaleType="centerInside"/>
            </FrameLayout>
            <Space
                android:layout_width="match_parent"
                android:layout_height="@dimen/account_ui_size_10dp"/>
            <FrameLayout
                android:id="@+id/layout_login_password"
                android:layout_width="match_parent"
                android:layout_height="@dimen/account_ui_hm_email_input_height"
                android:paddingStart="@dimen/account_ui_account_login_side_padding"
                android:paddingEnd="@dimen/account_ui_account_login_side_padding">
                <androidx.appcompat.widget.AppCompatEditText
                    android:textSize="@dimen/account_ui_phone_edit_text_size"
                    android:typeface="monospace"
                    android:textColor="@color/s1"
                    android:textColorHint="@color/s3"
                    android:gravity="start|center_vertical"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/et_password"
                    android:background="@drawable/account_ui_bg_login_edit"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/account_ui_hm_email_input_height"
                    android:hint="@string/account_ui_input_password"
                    android:inputType="textPassword"
                    android:textAlignment="viewStart"
                    android:paddingStart="@dimen/account_ui_padding_login_editor_start"
                    android:paddingEnd="@dimen/account_ui_editor_clear_pwd_padding_end"
                    android:autofillHints="password"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="end"
                    android:id="@+id/iv_show_password"
                    android:layout_width="@dimen/account_ui_hm_email_input_height"
                    android:layout_height="@dimen/account_ui_hm_email_input_height"
                    android:src="@drawable/account_ui_hm_email_eye_close"
                    android:scaleType="centerInside"/>
                <LinearLayout
                    android:layout_gravity="end"
                    android:orientation="horizontal"
                    android:id="@+id/btn_password_clear"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="@dimen/account_ui_hm_email_input_height">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="@dimen/account_ui_hm_email_input_height"
                        android:layout_height="@dimen/account_ui_hm_email_input_height"
                        android:src="@drawable/account_ui_editor_clear"
                        android:scaleType="centerInside"/>
                    <View
                        android:layout_gravity="center_vertical"
                        android:background="@color/s4"
                        android:layout_width="1dp"
                        android:layout_height="30dp"/>
                </LinearLayout>
            </FrameLayout>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/p3"
                android:gravity="center_vertical"
                android:id="@+id/tv_login_prompt"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/account_ui_size_10dp"
                android:layout_marginStart="@dimen/account_ui_account_login_side_padding"
                android:layout_marginEnd="@dimen/account_ui_account_login_side_padding"
                style="@style/Rainbow.TextAppearance.Body5"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="14sp"
                android:textColor="@color/s41"
                android:id="@+id/tv_forget_password"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/account_ui_login_forget_password"
                android:layout_marginStart="@dimen/account_ui_account_login_side_padding"
                android:layout_marginEnd="@dimen/account_ui_account_login_side_padding"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:enabled="false"
                android:textSize="14sp"
                android:textColor="@color/account_ui_select_alive_btn_txt_color"
                android:gravity="center"
                android:id="@+id/tv_login"
                android:background="@drawable/account_ui_btn_bg_login"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="@dimen/account_ui_size_24dp"
                android:text="@string/account_ui_login"
                android:layout_marginStart="@dimen/account_ui_account_login_side_padding"
                android:layout_marginEnd="@dimen/account_ui_account_login_side_padding"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="14sp"
                android:textColor="@color/s1"
                android:gravity="center"
                android:id="@+id/tv_register"
                android:background="@drawable/account_ui_btn_stroke_s46"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="@dimen/account_ui_size_14dp"
                android:text="@string/account_ui_account_register"
                android:layout_marginStart="@dimen/account_ui_account_login_side_padding"
                android:layout_marginEnd="@dimen/account_ui_account_login_side_padding"/>
            <com.huami.http.serverfault.widget.ServerFaultView
                android:id="@+id/server_fault_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/account_ui_size_16dp"
                android:layout_marginBottom="@dimen/account_ui_size_16dp"/>
            <TextView
                android:textColor="@color/s2"
                android:gravity="center"
                android:id="@+id/checkout_server_tv"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="20dp"
                android:text="@string/account_ui_checkout_server"/>
            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/account_ui_account_login_side_padding"
                android:layout_marginEnd="@dimen/account_ui_account_login_side_padding">
                <View
                    android:background="@color/s3"
                    android:layout_width="0dp"
                    android:layout_height="0.5dp"
                    android:layout_weight="1"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/layout_login_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="11.3dp"
                    android:layout_marginEnd="11.3dp">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="12sp"
                        android:textColor="@color/s3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/account_ui_third_part_auth_login"/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ic_login_type_visibility"
                        android:visibility="gone"
                        android:layout_width="@dimen/account_ui_size_18dp"
                        android:layout_height="@dimen/account_ui_size_18dp"
                        android:src="@drawable/account_ui_icon_login_type_opened"
                        android:layout_marginStart="3dp"
                        android:layout_marginEnd="0dp"/>
                </LinearLayout>
                <View
                    android:background="@color/s3"
                    android:layout_width="0dp"
                    android:layout_height="0.5dp"
                    android:layout_weight="1"/>
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:layout_gravity="center_horizontal"
                android:id="@+id/rv_third_part"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/account_ui_login_third_part_height"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"
                android:layout_marginStart="@dimen/account_ui_account_login_side_padding"
                android:layout_marginEnd="@dimen/account_ui_account_login_side_padding"/>
        </LinearLayout>
    </FrameLayout>
</androidx.core.widget.NestedScrollView>
