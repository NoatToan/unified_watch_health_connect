<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:orientation="vertical"
        android:id="@+id/toolbar"
        android:background="@color/s38"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/iv_back"
            android:padding="5dp"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/ic_arrow_back_20_2x"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:layout_alignParentStart="true"
            app:tint="?android:attr/textColorPrimary"/>
        <TextView
            android:textSize="17sp"
            android:textColor="@color/s1"
            android:id="@+id/tv_title"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/file_manager_title_translist"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/s1"
            android:gravity="center"
            android:id="@+id/btn_clear_all"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:text="@string/file_manager_clear_all"
            android:layout_centerVertical="true"
            android:onClick="onClearAllBtnClick"
            android:layout_marginEnd="20dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/layout_transform_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/s2"
                android:id="@+id/tv_desc"
                android:background="@color/s38"
                android:paddingLeft="15dp"
                android:paddingTop="8dp"
                android:paddingRight="15dp"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/record_sync_desc"
                android:drawablePadding="4dp"
                android:paddingHorizontal="15dp"
                app:drawableStartCompat="@drawable/ic_alert_20"
                app:drawableTint="@color/p3"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_file_upload"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/layout_empty"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:background="@drawable/ic_alert_20"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:backgroundTint="@color/s2"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/s2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/file_manager_no_task"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
    </FrameLayout>
    <View
        android:id="@+id/fog_layer"
        android:background="@color/s38"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:alpha="0.65"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>
    <View
        android:id="@+id/fog_layer2"
        android:background="@color/s38"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="100dp"
        android:layout_height="0dp"
        android:alpha="0.65"
        app:layout_constraintBottom_toBottomOf="@+id/toolbar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/back_fog_layer"
        android:background="@color/s38"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="54dp"
        android:layout_height="0dp"
        android:alpha="0.65"
        app:layout_constraintBottom_toBottomOf="@+id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
