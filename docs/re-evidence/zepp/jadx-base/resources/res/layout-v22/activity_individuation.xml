<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.lib.rainbow.titlebar.RainbowTitleBar
        android:theme="@style/Theme.App.Zepp"
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menuIcon="@drawable/edit"
        app:navigationIcon="@drawable/ic_arrow_back_20_2x"
        app:title="@string/special_contacts"/>
    <TextView
        android:textSize="@dimen/size_14sp"
        android:textColor="@color/s2"
        android:id="@+id/tv_usage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/size_18dp"
        android:layout_marginTop="@dimen/size_12dp"
        android:layout_marginRight="@dimen/size_18dp"
        android:layout_marginBottom="@dimen/size_14dp"
        android:text="@string/label_contact_usage"
        android:layout_below="@+id/title_bar"
        android:layout_marginHorizontal="@dimen/size_18dp"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_contacts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/size_12dp"
        android:layout_marginRight="@dimen/size_12dp"
        android:layout_marginBottom="@dimen/size_10dp"
        android:layout_above="@+id/layout_bottom"
        android:layout_below="@+id/tv_usage"
        android:layout_marginHorizontal="@dimen/size_12dp"/>
    <FrameLayout
        android:id="@+id/layout_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:drawableTop="@drawable/add"
        android:layout_alignParentBottom="true">
        <TextView
            android:textColor="@color/s1"
            android:gravity="center_horizontal"
            android:id="@+id/tv_add_contact"
            android:background="@color/s38"
            android:paddingTop="@dimen/size_12dp"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_100dp"
            android:text="@string/label_add_contact"
            android:drawableTop="@drawable/add"
            android:drawablePadding="@dimen/size_8dp"/>
        <Button
            android:enabled="false"
            android:textColor="@color/s5"
            android:id="@+id/btn_delete"
            android:background="@drawable/bg_btn_activity_individuation"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_45dp"
            android:layout_marginLeft="@dimen/size_18dp"
            android:layout_marginRight="@dimen/size_18dp"
            android:layout_marginBottom="@dimen/size_45dp"
            android:text="@string/delete"
            android:layout_marginHorizontal="@dimen/size_18dp"/>
    </FrameLayout>
</RelativeLayout>
