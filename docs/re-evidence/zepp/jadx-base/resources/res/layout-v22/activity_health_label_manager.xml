<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/health_label_container"
    android:background="@color/s38"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/health_label_manager_back"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:src="@drawable/ic_health_label_back"
        android:scaleType="center"
        android:tint="@color/s1"
        android:layout_marginStart="@dimen/margin_15"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/s1"
        android:gravity="center_vertical"
        android:id="@+id/health_label_manager_title"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:text="@string/health_label_manager_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Rainbow.TextAppearance.Title3"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/s1"
        android:gravity="center_vertical"
        android:id="@+id/health_label_manager_edit"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:text="@string/health_label_manager_edit"
        android:drawableStart="@drawable/ic_health_label_edit"
        android:layout_marginEnd="@dimen/margin_15"
        android:drawableTint="@color/s1"
        app:drawableTint="@color/s1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/s1"
        android:gravity="center_vertical"
        android:id="@+id/health_label_manager_cancel"
        android:visibility="gone"
        android:layout_width="48dp"
        android:layout_height="56dp"
        android:text="@string/health_label_manager_cancel"
        android:layout_marginStart="@dimen/margin_15"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/p3"
        android:gravity="center"
        android:id="@+id/health_label_manager_done"
        android:background="@drawable/shape_label_manager_done"
        android:visibility="gone"
        android:layout_width="60dp"
        android:layout_height="26dp"
        android:text="@string/health_label_manager_done"
        android:layout_marginEnd="@dimen/margin_15"
        app:layout_constraintBottom_toBottomOf="@+id/health_label_manager_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/health_label_manager_title"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <View
        android:id="@+id/view1"
        android:background="#25000000"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        app:layout_constraintTop_toBottomOf="@+id/health_label_manager_title"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/health_label_manager_recycler_view"
        android:paddingTop="15dp"
        android:paddingBottom="15dp"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        app:layout_constraintBottom_toTopOf="@+id/health_label_manager_add_layout"
        app:layout_constraintTop_toBottomOf="@+id/view1"
        app:layout_constraintVertical_weight="1"/>
    <include
        android:id="@+id/layout_health_label_manager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/health_label_manager_add_layout"
        app:layout_constraintTop_toBottomOf="@+id/view1"
        app:layout_constraintVertical_bias="0"
        app:layout_constraintVertical_weight="1"
        layout="@layout/layout_label_manager_show_mode"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/health_label_manager_add_layout"
        android:background="@color/s38"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <View
            android:id="@+id/health_label_manager_add_view"
            android:background="@drawable/shape_label_manager_add"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/margin_15"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/health_label_text_red"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="@string/health_label_manager_add"
            android:drawablePadding="4dp"
            android:drawableStart="@drawable/ic_health_label_text_add"
            android:drawableTint="@color/p3"
            app:layout_constraintBottom_toBottomOf="@+id/health_label_manager_add_view"
            app:layout_constraintEnd_toEndOf="@+id/health_label_manager_add_view"
            app:layout_constraintStart_toStartOf="@+id/health_label_manager_add_view"
            app:layout_constraintTop_toTopOf="@+id/health_label_manager_add_view"
            style="@style/Rainbow.TextAppearance.Body3"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
