<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/s2"
        android:id="@+id/tv_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_14dp"
        android:layout_marginBottom="@dimen/size_14dp"
        android:text="@string/diagnosis_choose_tip"
        android:layout_marginStart="@dimen/size_18dp"
        android:layout_marginEnd="@dimen/size_18dp"
        android:layout_marginVertical="@dimen/size_14dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_questions"
        android:background="@drawable/bg_round_activity_diagnosis"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/size_10dp"
        android:layout_marginRight="@dimen/size_10dp"
        android:divider="@drawable/divider"
        android:layout_below="@+id/tv_tip"
        android:showDividers="middle"
        android:paddingStart="@dimen/size_18dp"
        android:paddingEnd="@dimen/size_18dp"
        android:layout_marginHorizontal="@dimen/size_10dp">
        <CheckBox
            android:id="@+id/cb_phone_alert"
            android:text="@string/no_phone_alert"
            style="@style/checkbox_diagnosis_activity"/>
        <CheckBox
            android:id="@+id/cb_alert_nameless"
            android:text="@string/ringing_without_name"
            style="@style/checkbox_diagnosis_activity"/>
        <CheckBox
            android:id="@+id/cb_app_alert"
            android:text="@string/no_app_alert"
            style="@style/checkbox_diagnosis_activity"/>
        <CheckBox
            android:id="@+id/cb_msg_alert"
            android:text="@string/no_msg_alert"
            style="@style/checkbox_diagnosis_activity"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_diagnosis_result"
        android:background="@drawable/bg_round_activity_diagnosis"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/size_10dp"
        android:layout_marginRight="@dimen/size_10dp"
        android:layout_below="@+id/tv_tip"
        android:layout_marginHorizontal="@dimen/size_10dp"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/tv_setting_tip"
        android:paddingLeft="@dimen/size_18dp"
        android:paddingTop="@dimen/size_14dp"
        android:paddingRight="@dimen/size_18dp"
        android:paddingBottom="@dimen/size_14dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tip_setting_permissions"
        android:layout_below="@+id/layout_diagnosis_result"
        android:paddingHorizontal="@dimen/size_18dp"
        android:paddingVertical="@dimen/size_14dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_permission_request"
        android:background="@drawable/bg_round_activity_diagnosis"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/size_10dp"
        android:layout_marginRight="@dimen/size_10dp"
        android:divider="@drawable/divider"
        android:layout_below="@+id/tv_setting_tip"
        android:showDividers="middle"
        android:layout_marginHorizontal="@dimen/size_10dp"/>
    <TextView
        android:textColor="@color/s2"
        android:id="@+id/tv_feedback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size_76dp"
        android:text="@string/another_questions"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
    <Button
        android:enabled="false"
        android:textColor="@color/s5"
        android:id="@+id/btn_diagnose"
        android:background="@drawable/bg_btn_activity_diagnosis"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_45dp"
        android:layout_marginLeft="@dimen/size_18dp"
        android:layout_marginRight="@dimen/size_18dp"
        android:layout_marginBottom="@dimen/size_18dp"
        android:text="@string/start_diagnosing"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="@dimen/size_18dp"/>
</RelativeLayout>
