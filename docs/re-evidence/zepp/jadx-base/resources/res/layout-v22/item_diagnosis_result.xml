<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingLeft="@dimen/size_18dp"
    android:paddingRight="@dimen/size_18dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/size_40dp"
    android:paddingHorizontal="@dimen/size_18dp">
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/s1"
        android:id="@+id/tv_point"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/placeholder_point"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/size_10dp"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/tv_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/size_8dp"
        android:layout_toStartOf="@+id/tv_result"
        android:layout_toEndOf="@+id/tv_point"/>
    <TextView
        android:textColor="@color/s2"
        android:id="@+id/tv_result"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
