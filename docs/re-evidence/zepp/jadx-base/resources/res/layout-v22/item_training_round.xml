<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/s36"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_fixed"
            android:paddingTop="18dp"
            android:paddingBottom="18dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/s1"
                android:gravity="center"
                android:id="@+id/tx_round_name"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/round_name"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/s1"
                android:id="@+id/tx_course_name"
                android:visibility="invisible"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="9dp"/>
        </LinearLayout>
        <View
            android:id="@+id/group_divider"
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/ll_expandable"
        android:background="@color/s36"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcv_groups"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="15dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ll_all_actions"
            android:padding="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/s3"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/all_actions"
                android:drawablePadding="4dp"
                android:drawableEnd="@drawable/ic_arrow_right"
                android:drawableTint="@color/s3"/>
        </LinearLayout>
        <include
            android:id="@+id/child_divider"
            layout="@layout/view_space"/>
    </LinearLayout>
</LinearLayout>
