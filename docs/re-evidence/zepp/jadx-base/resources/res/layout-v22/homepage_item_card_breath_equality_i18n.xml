<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minHeight="150dp">
    <com.huami.module.homepage.cards.cardui.PiecewiseLineView
        android:id="@+id/stateBar"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_marginBottom="19dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/no_sleep_breath_data"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textColor="@color/s1"
        android:ellipsize="end"
        android:id="@+id/state"
        android:paddingLeft="15dp"
        android:paddingRight="15dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:maxLines="2"
        android:paddingHorizontal="15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sleep_breath_bar"
        style="@style/Rainbow.TextAppearance.Body1"/>
    <TextView
        android:textColor="@color/s2"
        android:id="@+id/desc"
        android:paddingLeft="15dp"
        android:paddingRight="15dp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:paddingHorizontal="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/state"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <Space
        android:id="@+id/bottom_space"
        android:layout_width="match_parent"
        android:layout_height="18dp"
        app:layout_constraintTop_toBottomOf="@+id/stateBar"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/detail"
        android:paddingBottom="15dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bottom_space">
        <TextView
            android:textColor="@color/s1"
            android:id="@+id/bad_breath_times"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/homepage_item_card_bad_breath_times"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Rainbow.TextAppearance.Body4"/>
        <FrameLayout
            android:id="@+id/chart_container"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginTop="9dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/bad_breath_times"/>
        <TextView
            android:textColor="@color/s1"
            android:id="@+id/start_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginStart="15dp"
            app:layout_constraintStart_toStartOf="@+id/chart_container"
            app:layout_constraintTop_toBottomOf="@+id/chart_container"
            style="@style/Rainbow.TextAppearance.Number8"/>
        <TextView
            android:textColor="@color/s1"
            android:id="@+id/end_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="15dp"
            app:layout_constraintEnd_toEndOf="@+id/chart_container"
            app:layout_constraintTop_toBottomOf="@+id/chart_container"
            style="@style/Rainbow.TextAppearance.Number8"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.huami.module.homepage.cards.cardui.BackgroundTextView
        android:textColor="@color/s1"
        android:gravity="center"
        android:id="@+id/no_sleep_breath_data"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_margin="15dp"
        android:layout_marginBottom="8dp"
        android:text="@string/homepage_item_card_no_sleep_breath_data"
        app:backgroundTintAlpha="0.92"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <com.huami.module.homepage.cards.cardui.CardTitleBarView
        android:id="@+id/sleep_breath_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:timeWarpRules="calculate"
        app:titleText="@string/homepage_item_card_breath_equality"/>
</androidx.constraintlayout.widget.ConstraintLayout>
