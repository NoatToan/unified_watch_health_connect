<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s38"
    android:layout_width="match_parent"
    android:layout_height="340dp">
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="23dp"
        android:layout_centerHorizontal="true">
        <com.airbnb.lottie.LottieAnimationView
            android:layout_gravity="center"
            android:id="@+id/lv_lottie_progress_animation"
            android:layout_width="104dp"
            android:layout_height="104dp"
            app:lottie_autoPlay="true"
            app:lottie_loop="false"/>
        <com.airbnb.lottie.LottieAnimationView
            android:layout_gravity="center"
            android:id="@+id/lv_lottie_bg_animation"
            android:layout_width="154dp"
            android:layout_height="154dp"
            app:lottie_autoPlay="true"
            app:lottie_fileName="pai_value_ripple_orange.json"
            app:lottie_loop="true"/>
        <RelativeLayout
            android:layout_gravity="center"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginBottom="3dp">
            <com.huami.pai.view.PAINumberRunningTextView
                android:textColor="@color/s5"
                android:id="@+id/pai_frame_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:text="--"
                android:layout_centerHorizontal="true"
                style="@style/Rainbow.TextAppearance.Number1"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textColor="@color/s5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:text="@string/pai_pai_unit"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                style="@style/Rainbow.TextAppearance.Body3"/>
        </RelativeLayout>
    </FrameLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/pai_date"
        android:padding="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_tips_16"
        android:layout_marginEnd="3dp"
        android:layout_alignParentEnd="true"
        android:drawableTint="@color/s2"
        style="@style/Rainbow.TextAppearance.Body5"/>
    <include layout="@layout/pai_daily_record"/>
</RelativeLayout>
