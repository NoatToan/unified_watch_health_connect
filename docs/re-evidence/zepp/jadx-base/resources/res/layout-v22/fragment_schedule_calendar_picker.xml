<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_title"
        android:layout_width="match_parent"
        android:layout_height="60dp">
        <ImageView
            android:id="@+id/calendar_prev"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_arrow_back_20_2x"
            app:tint="@color/s1"/>
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/s1"
            android:gravity="center"
            android:id="@+id/calendar_year_month"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="110dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"/>
        <ImageView
            android:id="@+id/calendar_next"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_arrow_forward_20_2x"
            app:tint="@color/s1"/>
    </LinearLayout>
    <View
        android:background="@color/s4"
        android:layout_width="match_parent"
        android:layout_height="0.3dp"/>
    <com.haibin.calendarview.CalendarView
        android:id="@+id/calendar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="235dp"
        app:calendar_height="38dp"
        app:current_month_lunar_text_color="@color/s2"
        app:current_month_text_color="@color/s1"
        app:day_text_size="14sp"
        app:month_view="com.huami.assistant.ui.schedule.view.calendar.MonthView"
        app:month_view_auto_select_day="last_select_day_ignore_current"
        app:month_view_show_mode="mode_only_current"
        app:other_month_text_color="@color/s3"
        app:scheme_text="假"
        app:scheme_text_color="@color/s1"
        app:scheme_theme_color="@color/s1"
        app:selected_text_color="@color/s36"
        app:selected_theme_color="@color/p3"
        app:week_background="@color/s39"
        app:week_text_color="@color/s1"
        app:week_text_size="12sp"
        app:week_view="com.huami.assistant.ui.schedule.view.calendar.WeekView"
        app:year_view_day_text_color="@color/s1"
        app:year_view_day_text_size="9sp"
        app:year_view_month_text_color="@color/p3"
        app:year_view_month_text_size="20sp"
        app:year_view_scheme_color="@color/s33"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/layout_time"
        android:layout_width="match_parent"
        android:layout_height="58dp">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/s1"
            android:gravity="start|center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/schedule_time"
            android:drawablePadding="8dp"
            android:drawableStart="@drawable/ic_schedule_time"
            android:textDirection="locale"
            android:textAlignment="viewStart"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="10dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/s2"
            android:gravity="end"
            android:id="@+id/time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:drawableEnd="@drawable/ic_arrow_forward_20_2x"
            android:textDirection="locale"
            android:textAlignment="viewEnd"
            android:layout_marginEnd="20dp"
            android:drawableTint="@color/s2"/>
    </LinearLayout>
</LinearLayout>
