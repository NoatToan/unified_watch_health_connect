<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="64dp">
    <ImageView
        android:id="@+id/hr_icon"
        android:layout_centerVertical="true"
        android:layout_marginStart="19dp"
        style="@style/HeartRateIconStyle"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/s3"
        android:id="@+id/hr_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_below="@+id/hr_value"
        android:layout_marginStart="12dp"
        android:layout_toEndOf="@+id/hr_icon"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="18sp"
        android:textColor="@color/s1"
        android:id="@+id/hr_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="km"
        android:layout_alignStart="@+id/hr_date"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/s2"
        android:id="@+id/hr_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:text="@string/heart_rate_unit_hr"
        android:layout_alignBaseline="@+id/hr_value"
        android:layout_marginStart="2dp"
        android:layout_toEndOf="@+id/hr_value"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/s20"
        android:id="@+id/hr_mark"
        android:background="@drawable/heart_rate_rest_text_bg_normal"
        android:paddingLeft="9dp"
        android:paddingTop="2dp"
        android:paddingRight="9dp"
        android:paddingBottom="2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBaseline="@+id/hr_unit"
        android:layout_marginStart="6dp"
        android:layout_toEndOf="@+id/hr_unit"
        android:paddingHorizontal="9dp"
        android:paddingVertical="2dp"/>
</RelativeLayout>
