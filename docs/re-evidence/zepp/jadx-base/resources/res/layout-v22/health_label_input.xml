<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/health_label_66000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="bottom"
        android:layout_gravity="bottom"
        android:id="@+id/health_label_item"
        android:background="@color/s4"
        android:layout_width="match_parent"
        android:layout_height="108dp">
        <com.huami.healthlabel.ui.custom.KeyEditView
            android:textColor="@color/s1"
            android:textColorHint="@color/s3"
            android:gravity="center_vertical"
            android:id="@+id/health_label_input_edit"
            android:background="@drawable/shape_rect_radius_6_s5"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_margin="10dp"
            android:hint="@string/health_label_manager_input_hint"
            android:ems="10"
            android:maxLength="10"
            android:inputType="textPersonName"
            android:paddingHorizontal="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textColor="@color/s3"
            android:id="@+id/health_label_limit_tips_tv"
            android:layout_width="wrap_content"
            android:layout_height="21dp"
            android:layout_marginTop="18dp"
            android:text="@string/health_label_limit_length"
            android:layout_marginEnd="22dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0"
            style="@style/Rainbow.TextAppearance.Body4"/>
        <TextView
            android:textColor="@color/s2"
            android:id="@+id/health_label_select_color_tv"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:text="@string/health_label_select_color"
            android:layout_marginStart="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/health_label_input_edit"
            style="@style/Rainbow.TextAppearance.Body4"/>
        <com.huami.healthlabel.ui.custom.InputSelectView
            android:orientation="horizontal"
            android:id="@+id/health_label_color_rg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:weightSum="5"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintStart_toEndOf="@+id/health_label_select_color_tv"
            app:layout_constraintTop_toBottomOf="@+id/health_label_input_edit"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
