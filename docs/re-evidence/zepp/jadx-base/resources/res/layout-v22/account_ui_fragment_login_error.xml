<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/account_ui_trans"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/account_ui_dialog_empty_area"/>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/account_ui_dialog_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/s2"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:background="@color/account_ui_trans"
            android:layout_width="match_parent"
            android:layout_height="@dimen/account_ui_size_58dp"
            android:text="@string/account_ui_login_error_title"/>
        <TextView
            android:textSize="@dimen/account_ui_size_12sp"
            android:textColor="@color/s3"
            android:gravity="center"
            android:id="@+id/tv_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/account_ui_login_error_content"/>
        <EditText
            android:textSize="@dimen/account_ui_size_12sp"
            android:textColor="@color/s1"
            android:textColorHint="@color/s3"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_contact"
            android:background="@drawable/account_ui_bg_round"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="@dimen/account_ui_size_36dp"
            android:layout_marginTop="@dimen/account_ui_size_13dp"
            android:layout_marginBottom="23dp"
            android:hint="@string/account_ui_login_error_hint"
            android:maxLines="1"
            android:maxLength="40"
            android:inputType="textEmailAddress"
            android:paddingStart="@dimen/account_ui_size_10dp"
            android:paddingEnd="@dimen/account_ui_size_10dp"
            android:layout_marginStart="@dimen/account_ui_size_18dp"
            android:layout_marginEnd="@dimen/account_ui_size_18dp"
            android:importantForAutofill="no"/>
        <View
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <LinearLayout
            android:orientation="horizontal"
            android:background="@color/account_ui_trans"
            android:layout_width="match_parent"
            android:layout_height="@dimen/account_ui_item_height_max">
            <TextView
                android:textSize="@dimen/account_ui_size_14sp"
                android:textColor="@color/s2"
                android:gravity="center"
                android:id="@+id/btn_cancel"
                android:background="@drawable/selector_dialog_button_start"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/account_ui_cancel"
                android:layout_weight="1"/>
            <View
                android:background="@color/s4"
                android:layout_width="1px"
                android:layout_height="match_parent"/>
            <TextView
                android:textSize="@dimen/account_ui_size_14sp"
                android:textColor="@color/s1"
                android:gravity="center"
                android:id="@+id/btn_feedback"
                android:background="@drawable/selector_dialog_button_end"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/account_ui_login_error_feedback"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
