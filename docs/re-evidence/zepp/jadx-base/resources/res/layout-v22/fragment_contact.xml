<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/size_14sp"
        android:textColor="@color/s2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_12dp"
        android:text="@string/label_set_contacts"
        android:layout_marginStart="@dimen/size_18dp"/>
    <EditText
        android:textSize="@dimen/size_16sp"
        android:textColor="@color/s1"
        android:textColorHint="@color/s3"
        android:id="@+id/et_contact"
        android:background="@color/s38"
        android:paddingLeft="@dimen/size_15dp"
        android:paddingRight="@dimen/size_15dp"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_64dp"
        android:layout_marginLeft="@dimen/size_10dp"
        android:layout_marginTop="@dimen/size_12dp"
        android:layout_marginRight="@dimen/size_10dp"
        android:layout_marginBottom="@dimen/size_12dp"
        android:hint="@string/hint_input_contact"
        android:maxLines="1"
        android:maxLength="20"
        android:inputType="textCapCharacters"
        android:layout_marginHorizontal="@dimen/size_10dp"
        android:layout_marginVertical="@dimen/size_12dp"
        android:paddingHorizontal="@dimen/size_15dp"/>
    <TextView
        android:textSize="@dimen/size_14sp"
        android:textColor="@color/s2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/size_18dp"
        android:layout_marginRight="@dimen/size_18dp"
        android:text="@string/label_contact_desc"
        android:layout_marginHorizontal="@dimen/size_18dp"/>
</LinearLayout>
