<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.lib.rainbow.titlebar.RainbowTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/bt_phone_pair_title"/>
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <FrameLayout
        android:background="@color/s38"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.huami.lib.rainbow.button.RainbowButton
            android:textColor="#ff5353"
            android:gravity="center"
            android:id="@+id/bt_go_setting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/size_15dp"
            android:layout_marginTop="@dimen/size_20dp"
            android:layout_marginRight="@dimen/size_15dp"
            android:layout_marginBottom="@dimen/td_size_44dp"
            android:text="@string/go_device_ble_settings"
            android:layout_marginHorizontal="@dimen/size_15dp"
            style="?attr/buttonStyleGray_48_flat"/>
    </FrameLayout>
</LinearLayout>
