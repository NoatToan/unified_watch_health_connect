<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.huami.module.homepage.cards.cardui.PiecewiseArcView
        android:id="@+id/phn_arc"
        android:layout_width="128dp"
        android:layout_height="110dp"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="20dp"
        android:layout_marginStart="19dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/phn_title"
        app:layout_constraintVertical_bias="0"/>
    <ProgressBar
        android:id="@+id/phn_line"
        android:layout_width="0dp"
        android:layout_height="8dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="66dp"
        android:max="100"
        android:progress="0"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="15dp"
        android:mirrorForRtl="true"
        android:progressTint="@color/s20"
        android:progressBackgroundTint="@color/s4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/phn_arc"
        style="@android:style/Widget.ProgressBar.Horizontal"/>
    <TextView
        android:textColor="@color/s1"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/phn_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:maxWidth="128dp"
        android:maxLines="3"
        app:layout_constraintBottom_toBottomOf="@+id/phn_arc"
        app:layout_constraintEnd_toEndOf="@+id/phn_arc"
        app:layout_constraintStart_toStartOf="@+id/phn_arc"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <TextView
        android:textColor="@color/s2"
        android:id="@+id/phn_zero"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/homepage_item_card_pai_0"
        app:layout_constraintStart_toStartOf="@+id/phn_line"
        app:layout_constraintTop_toBottomOf="@+id/phn_line"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <TextView
        android:textColor="@color/s2"
        android:id="@+id/phn_100"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/homepage_item_card_pai_100"
        android:layout_marginStart="114dp"
        app:layout_constraintEnd_toEndOf="@+id/phn_line"
        app:layout_constraintTop_toBottomOf="@+id/phn_line"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/s1"
        android:id="@+id/phn_today_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        app:layout_constraintBottom_toTopOf="@+id/phn_line"
        app:layout_constraintStart_toStartOf="@+id/phn_line"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/s1"
        android:gravity="center"
        android:id="@+id/phn_no_plan"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/phn_no_plan_today"
        android:layout_marginEnd="15dp"
        android:paddingHorizontal="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/phn_arc"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <com.huami.module.homepage.cards.cardui.BackgroundTextView
        android:textColor="@color/s1"
        android:gravity="center_horizontal"
        android:id="@+id/phn_mask"
        android:paddingTop="65dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:backgroundTintAlpha="0.92"
        app:layout_constraintBottom_toBottomOf="@+id/phn_arc"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/phn_title"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/phn_plan_button"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="?attr/buttonStyleRed_38_outline"/>
    <com.huami.module.homepage.cards.cardui.CardTitleBarView
        android:id="@+id/phn_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:titleText="@string/phn_common_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
