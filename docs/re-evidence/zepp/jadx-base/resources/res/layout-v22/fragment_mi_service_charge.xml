<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_mi_service_content"
        android:background="@color/s36"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/size_18dp"
        android:paddingEnd="@dimen/size_18dp">
        <RelativeLayout
            android:id="@+id/rl_mi_invoice_head"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_58dp"
            android:minHeight="@dimen/size_58dp">
            <TextView
                android:id="@+id/tv_mi_invoice_head"
                android:layout_width="@dimen/size_130dp"
                android:layout_height="@dimen/size_22dp"
                android:text="@string/wl_invoice_category"
                android:layout_centerVertical="true"
                style="@style/InVoiceHeadStyle"/>
            <ImageView
                android:id="@+id/iv_mi_arrow_right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/wl_card_arrow_right"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
            <TextView
                android:gravity="end"
                android:id="@+id/tv_mi_invoice_type"
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/wl_invoice_type_name"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/size_18dp"
                android:layout_toStartOf="@+id/iv_mi_arrow_right"
                android:layout_toEndOf="@+id/tv_mi_invoice_head"
                style="@style/InVoiceContentStyle"/>
            <View
                android:background="@color/s4"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_mi_invoice_title"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_58dp"
            android:minHeight="@dimen/size_58dp">
            <TextView
                android:id="@+id/tv_mi_invoice_title"
                android:layout_width="@dimen/size_130dp"
                android:layout_height="@dimen/size_22dp"
                android:text="@string/wl_invoice_head"
                android:layout_centerVertical="true"
                style="@style/InVoiceHeadStyle"/>
            <EditText
                android:gravity="end"
                android:id="@+id/et_mi_invoice_title"
                android:background="@null"
                android:paddingTop="@dimen/size_10dp"
                android:paddingBottom="@dimen/size_10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/wl_invoice_input_receive_name"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@+id/tv_mi_invoice_title"
                style="@style/InVoiceContentStyle"/>
            <View
                android:background="@color/s4"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_mi_company_name"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_58dp"
            android:minHeight="@dimen/size_58dp">
            <TextView
                android:id="@+id/tv_mi_company"
                android:layout_width="@dimen/size_130dp"
                android:layout_height="@dimen/size_22dp"
                android:text="@string/wl_invoice_head"
                android:layout_centerVertical="true"
                style="@style/InVoiceHeadStyle"/>
            <EditText
                android:gravity="end"
                android:id="@+id/et_mi_company_name"
                android:background="@null"
                android:paddingTop="@dimen/size_10dp"
                android:paddingBottom="@dimen/size_10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/wl_invoice_input_company_name"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@+id/tv_mi_company"
                style="@style/InVoiceContentStyle"/>
            <View
                android:background="@color/s4"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_mi_tax_payer_number"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_58dp"
            android:minHeight="@dimen/size_58dp">
            <TextView
                android:id="@+id/tv_mi_taxpayer_number"
                android:layout_width="@dimen/size_130dp"
                android:layout_height="@dimen/size_22dp"
                android:text="@string/wl_invoice_taxpayer_number"
                android:layout_centerVertical="true"
                style="@style/InVoiceHeadStyle"/>
            <EditText
                android:gravity="end"
                android:id="@+id/et_mi_taxpayer_number"
                android:background="@null"
                android:paddingTop="@dimen/size_10dp"
                android:paddingBottom="@dimen/size_10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/wl_invoice_input_taxpayer_number"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@+id/tv_mi_taxpayer_number"
                style="@style/InVoiceContentStyle"/>
            <View
                android:background="@color/s4"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_58dp"
            android:minHeight="@dimen/size_58dp">
            <TextView
                android:id="@+id/tv_mi_content"
                android:layout_width="@dimen/size_130dp"
                android:layout_height="@dimen/size_22dp"
                android:text="@string/wl_invoice_content"
                android:layout_centerVertical="true"
                style="@style/InVoiceHeadStyle"/>
            <TextView
                android:gravity="end"
                android:id="@+id/tv_mi_content_massage"
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/wl_invoice_recharge_fee"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@+id/tv_mi_content"
                style="@style/InVoiceContentStyle"/>
            <View
                android:background="@color/s4"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_58dp"
            android:minHeight="@dimen/size_58dp">
            <TextView
                android:id="@+id/tv_mi_money"
                android:layout_width="@dimen/size_130dp"
                android:layout_height="@dimen/size_22dp"
                android:text="@string/wl_invoice_money"
                android:layout_centerVertical="true"
                style="@style/InVoiceHeadStyle"/>
            <TextView
                android:gravity="end"
                android:id="@+id/tv_mi_money_content"
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/wl_invoice_recharge_fee"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@+id/tv_mi_money"
                style="@style/InVoiceContentStyle"/>
            <View
                android:background="@color/s4"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_mi_phone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_58dp"
            android:minHeight="@dimen/size_58dp">
            <TextView
                android:id="@+id/tv_mi_phone"
                android:layout_width="@dimen/size_130dp"
                android:layout_height="@dimen/size_22dp"
                android:text="@string/wl_invoice_phone"
                android:layout_centerVertical="true"
                style="@style/InVoiceHeadStyle"/>
            <EditText
                android:gravity="end"
                android:id="@+id/et_mi_phone"
                android:background="@null"
                android:paddingTop="@dimen/size_10dp"
                android:paddingBottom="@dimen/size_10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/wl_invoice_input_receive_number"
                android:layout_centerVertical="true"
                android:inputType="phone"
                android:layout_toEndOf="@+id/tv_mi_phone"
                android:importantForAutofill="no"
                style="@style/InVoiceContentStyle"/>
            <View
                android:background="@color/s4"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_mi_email"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_58dp"
            android:minHeight="@dimen/size_58dp">
            <TextView
                android:id="@+id/tv_mi_email"
                android:layout_width="@dimen/size_130dp"
                android:layout_height="@dimen/size_22dp"
                android:text="@string/wl_invoice_email"
                android:layout_centerVertical="true"
                style="@style/InVoiceHeadStyle"/>
            <EditText
                android:gravity="end"
                android:id="@+id/et_mi_email"
                android:background="@null"
                android:paddingTop="@dimen/size_10dp"
                android:paddingBottom="@dimen/size_10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/wl_invoice_input_receive_email"
                android:layout_centerVertical="true"
                android:inputType="textEmailAddress"
                android:layout_toEndOf="@+id/tv_mi_email"
                android:importantForAutofill="no"
                style="@style/InVoiceContentStyle"/>
            <View
                android:background="@color/s4"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
    </LinearLayout>
    <RelativeLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/ll_mi_service_content">
        <TextView
            android:textSize="@dimen/size_14sp"
            android:textColor="@color/s15"
            android:gravity="center_horizontal"
            android:id="@+id/tv_mi_inVoice_tip"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_20dp"
            android:layout_marginBottom="@dimen/size_88dp"
            android:text="@string/wl_invoice_user_known"
            android:layout_alignParentBottom="true"/>
        <Button
            android:id="@+id/tv_mi_submit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/size_24dp"
            android:text="@string/wl_invoice_submit"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/size_18dp"
            android:layout_marginEnd="@dimen/size_18dp"
            style="@style/Rainbow.Widget.Button.44.Circular"/>
    </RelativeLayout>
</RelativeLayout>
