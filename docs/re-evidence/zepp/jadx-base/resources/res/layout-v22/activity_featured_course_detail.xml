<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <com.google.android.material.appbar.AppBarLayout
            android:orientation="vertical"
            android:id="@+id/app_bar_layout"
            android:background="@color/s36"
            android:fitsSystemWindows="true"
            android:layout_width="match_parent"
            android:layout_height="313dp">
            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:id="@+id/collapsingToolbarLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:contentScrim="@color/s36"
                app:layout_scrollFlags="exitUntilCollapsed|scroll"
                app:statusBarScrim="@color/color_999999"
                app:titleEnabled="false">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/head_layout"
                    android:fitsSystemWindows="true"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:layout_collapseMode="parallax"
                    app:layout_scrollFlags="enterAlwaysCollapsed|scroll">
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="210dp">
                        <ImageView
                            android:id="@+id/iv_bg"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"/>
                        <RelativeLayout
                            android:layout_gravity="bottom"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:layout_marginStart="17dp"
                            android:layout_marginEnd="17dp">
                            <TextView
                                android:textSize="21sp"
                                android:textColor="#fcfcfc"
                                android:ellipsize="end"
                                android:id="@+id/tv_name"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:layout_marginEnd="8dp"
                                android:layout_toStartOf="@+id/iv_preview"/>
                            <ImageView
                                android:id="@+id/iv_preview"
                                android:visibility="gone"
                                android:layout_width="71dp"
                                android:layout_height="34dp"
                                android:src="@drawable/ic_preview"
                                android:onClick="onClick"
                                android:layout_alignParentEnd="true"/>
                        </RelativeLayout>
                    </FrameLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:background="@color/s36"
                        android:layout_width="match_parent"
                        android:layout_height="47dp"
                        android:paddingStart="17dp"
                        android:paddingEnd="17dp">
                        <TextView
                            android:textSize="11sp"
                            android:textColor="@color/s2"
                            android:id="@+id/tv_action_amount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                        <View
                            android:background="@color/s4"
                            android:layout_width="@dimen/divider"
                            android:layout_height="10dp"
                            android:layout_marginStart="10dp"/>
                        <TextView
                            android:textSize="11sp"
                            android:textColor="@color/s2"
                            android:id="@+id/tv_consumption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"/>
                        <View
                            android:background="@color/s4"
                            android:layout_width="@dimen/divider"
                            android:layout_height="10dp"
                            android:layout_marginStart="10dp"/>
                        <TextView
                            android:textSize="13sp"
                            android:textColor="@color/s1"
                            android:id="@+id/tv_dificulityDegree"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"/>
                        <LinearLayout
                            android:gravity="end"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="11sp"
                                android:textColor="@color/s2"
                                android:id="@+id/tv_participantNumber"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:drawablePadding="5dp"
                                android:drawableStart="@drawable/ic_learn"/>
                        </LinearLayout>
                    </LinearLayout>
                    <View
                        app:layout_scrollFlags="exitUntilCollapsed|scroll"
                        style="@style/TrainingHorizontalDivider"/>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/partner_layout"
                        android:background="@color/s36"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="67dp"
                        android:paddingStart="13dp"
                        android:paddingEnd="13dp">
                        <com.huami.lib.view.image.HMCircleImageView
                            android:id="@+id/iv_partner_logo"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_partner_logo_default_small"/>
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:layout_marginBottom="13dp"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp">
                            <TextView
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="@color/s1"
                                android:id="@+id/tv_partner_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                            <TextView
                                android:textSize="11sp"
                                android:textColor="@color/s1"
                                android:id="@+id/tv_partner_recommend"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"/>
                        </LinearLayout>
                        <TextView
                            android:textSize="13sp"
                            android:textColor="@color/s2"
                            android:gravity="center_vertical"
                            android:id="@+id/tv_more_courses"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:text="@string/more_courses"
                            android:drawablePadding="@dimen/activity_horizontal_margin"
                            android:drawableEnd="@drawable/ic_arrow_forward_20"
                            android:drawableTint="@color/s3"
                            app:tint="@color/s2"/>
                    </LinearLayout>
                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="8dp"/>
                </LinearLayout>
                <com.xiaomi.hm.health.training.ui.widget.SimpleToolbar
                    android:id="@+id/toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="?android:attr/actionBarSize"
                    app:contentInsetStart="0dp"
                    app:layout_collapseMode="pin"
                    app:popupTheme="@style/ThemeOverlay.AppCompat.Light">
                    <ImageView
                        android:id="@+id/iv_left"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_back_white"
                        android:scaleType="centerInside"/>
                    <TextView
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/s1"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@+id/txt_main_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:layout_marginEnd="48dp"/>
                    <ImageView
                        android:layout_gravity="end"
                        android:id="@+id/iv_right"
                        android:visibility="invisible"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_more_white"
                        android:scaleType="centerInside"/>
                </com.xiaomi.hm.health.training.ui.widget.SimpleToolbar>
            </com.google.android.material.appbar.CollapsingToolbarLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_scrollFlags="exitUntilCollapsed|scroll">
                <View style="@style/TrainingHorizontalDivider"/>
                <net.lucode.hackware.magicindicator.MagicIndicator
                    android:id="@+id/magicindicator"
                    android:background="@color/s36"
                    android:layout_width="match_parent"
                    android:layout_height="47dp"/>
                <View style="@style/TrainingHorizontalDivider"/>
            </LinearLayout>
        </com.google.android.material.appbar.AppBarLayout>
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">
            <com.xiaomi.hm.health.training.ui.widget.WrapContentHeightViewPager
                android:id="@+id/viewpager"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </androidx.core.widget.NestedScrollView>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/bottom_layout"
        android:background="@color/s36"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="61dp">
        <View
            android:background="@color/black10"
            android:layout_width="match_parent"
            android:layout_height="0.33dp"/>
        <RelativeLayout
            android:id="@+id/purchase_layout"
            android:background="@color/s4"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="17dp"
            android:paddingEnd="14dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="match_parent">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="13sp"
                        android:textColor="@color/s2"
                        android:id="@+id/tv_oriPrice"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"/>
                    <com.huami.widget.typeface.TypefaceTextView
                        android:textSize="25sp"
                        android:textColor="@color/color_ff8810"
                        android:id="@+id/tv_salePrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="km"/>
                </LinearLayout>
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/s2"
                    android:id="@+id/tv_expiry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:id="@+id/tv_purchase"
                android:background="@drawable/btn_bg_corner_origin"
                android:layout_width="143dp"
                android:layout_height="47dp"
                android:layout_centerVertical="true"
                android:onClick="onClick"
                android:layout_alignParentEnd="true">
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/white"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tr_purchase_course"
                    android:drawablePadding="9dp"
                    android:drawableStart="@drawable/ic_buy"/>
            </LinearLayout>
        </RelativeLayout>
        <LinearLayout
            android:gravity="center"
            android:id="@+id/join_layout"
            android:background="@drawable/btn_bg_corner_origin"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="7dp"
            android:layout_marginBottom="7dp"
            android:onClick="onClick"
            android:layout_marginStart="13dp"
            android:layout_marginEnd="13dp">
            <TextView
                android:textSize="15sp"
                android:textColor="#fcfcfc"
                android:gravity="center"
                android:id="@+id/tv_learn"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/tr_learn_course"
                android:drawablePadding="7dp"
                android:drawableStart="@drawable/ic_learn_course"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
