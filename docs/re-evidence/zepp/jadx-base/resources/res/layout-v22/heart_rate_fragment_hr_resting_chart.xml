<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_chart_data"
                android:background="@color/s38"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="10dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <com.huami.widget.typeface.TypefaceTextView
                    android:textSize="40sp"
                    android:textColor="@color/s1"
                    android:id="@+id/text_heart_rate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.huami.widget.typeface.TypefaceTextView
                    android:textSize="12sp"
                    android:textColor="@color/s2"
                    android:id="@+id/text_unit"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/heart_rate_unit_hr"
                    android:layout_marginStart="5dp"
                    app:layout_constraintBaseline_toBaselineOf="@+id/text_heart_rate"
                    app:layout_constraintStart_toEndOf="@+id/text_heart_rate"/>
                <com.huami.widget.typeface.TypefaceTextView
                    android:textSize="12sp"
                    android:textColor="@color/s2"
                    android:id="@+id/text_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/text_heart_rate"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <FrameLayout
                android:id="@+id/chart_container"
                android:background="@color/s38"
                android:layout_width="match_parent"
                android:layout_height="209dp"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/heart_rate_size_15dp"
                android:layout_marginTop="0dp"
                android:layout_marginRight="@dimen/heart_rate_size_15dp"
                android:overScrollMode="never"
                android:layout_marginHorizontal="@dimen/heart_rate_size_15dp"
                style="@style/HeartRateDetailContainerStyle"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/list_container"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/heart_rate_bg_border_round"
                android:paddingLeft="18dp"
                android:paddingRight="18dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/heart_rate_size_15dp"
                android:layout_marginRight="@dimen/heart_rate_size_15dp"
                android:layout_marginBottom="23dp"
                android:minHeight="72dp"
                android:layout_marginHorizontal="@dimen/heart_rate_size_15dp">
                <TextView
                    android:textSize="18sp"
                    android:textColor="@color/s1"
                    android:id="@+id/title_rhr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13.5dp"
                    android:text="@string/heart_rate_rest"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/s2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/heart_rate_rhr_intro"
                    android:layout_below="@+id/title_rhr"/>
                <View
                    android:layout_marginTop="14dp"
                    style="@style/HeartRateVerticalDivider"/>
                <LinearLayout
                    android:layout_gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:id="@+id/learn_more"
                    android:paddingLeft="10dp"
                    android:paddingTop="5dp"
                    android:paddingRight="10dp"
                    android:paddingBottom="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:layout_marginBottom="9dp"
                    android:layout_marginVertical="9dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/s2"
                        android:layout_gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/learn_more"/>
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:layout_width="12dp"
                        android:layout_height="13.5dp"
                        android:src="@drawable/ic_arrow_forward_20_2x"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="4dp"
                        android:layout_alignParentEnd="true"
                        app:tint="@color/s2"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
