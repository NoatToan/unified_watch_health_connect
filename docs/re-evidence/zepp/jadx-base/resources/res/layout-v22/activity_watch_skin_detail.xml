<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:orientation="vertical"
        android:id="@+id/layout_container"
        android:background="@color/s38"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="4dp"
        android:fillViewport="true">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:id="@+id/cinco_container"
                android:paddingTop="30dp"
                android:paddingBottom="30dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="15dp"
                android:paddingEnd="15dp">
                <androidx.cardview.widget.CardView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/card_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:foreground="?android:attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/s38"
                    app:cardCornerRadius="5dp"
                    app:cardElevation="0dp"
                    app:cardPreventCornerOverlap="true"
                    app:cardUseCompatPadding="false">
                    <ImageView
                        android:id="@+id/cinco_bg_img"
                        android:layout_width="100dp"
                        android:layout_height="201dp"/>
                    <ImageView
                        android:id="@+id/cinco_transparent_img"
                        android:layout_width="100dp"
                        android:layout_height="201dp"/>
                </androidx.cardview.widget.CardView>
                <LinearLayout
                    android:layout_gravity="end|bottom"
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="19dp">
                    <ImageView
                        android:id="@+id/watch_skin_large_iv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/icon_watch_skin_enlarge"/>
                    <ImageView
                        android:id="@+id/watch_skin_collect_iv"
                        android:background="@drawable/watch_skin_collect_slt"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"/>
                </LinearLayout>
            </FrameLayout>
            <View
                android:layout_gravity="top"
                android:background="@color/s4"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/s2"
                android:id="@+id/watch_skin_detail_title"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="@string/watch_skin_detail_title"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/watch_skin_star_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="15dp"
                android:paddingStart="15dp"
                android:paddingEnd="15dp">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/s2"
                    android:id="@+id/watch_skin_detail_star"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/watch_skin_detail_star"/>
                <androidx.appcompat.widget.AppCompatRatingBar
                    android:id="@+id/watch_skin_rate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:max="5"
                    android:stepSize="0.5"
                    android:isIndicator="true"
                    android:layout_marginStart="5dp"
                    style="@style/WatchSkinRatingStyle"/>
            </LinearLayout>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/s2"
                android:id="@+id/watch_skin_detail"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:lineHeight="21dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/layout_customize"
                android:paddingBottom="30dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="15dp"
                android:paddingEnd="15dp">
                <View
                    android:layout_gravity="top"
                    android:id="@+id/divider_color"
                    android:background="@color/s4"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/s2"
                    android:id="@+id/tv_color"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/watch_skin_detail_color"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/select_color_rv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="15dp"/>
                <View
                    android:layout_gravity="top"
                    android:background="@color/s4"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginTop="15dp"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/s2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/watch_skin_detail_customize"/>
                <FrameLayout
                    android:id="@+id/add_view"
                    android:background="@drawable/shape_watch_skin_detail_normal"
                    android:clickable="true"
                    android:layout_width="80dp"
                    android:layout_height="119dp"
                    android:layout_marginTop="14dp">
                    <View
                        android:layout_gravity="center"
                        android:id="@+id/add_skin_bg"
                        android:background="@drawable/shape_watch_skin_add"
                        android:layout_width="40dp"
                        android:layout_height="80dp"/>
                    <ImageView
                        android:layout_gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/watch_skin_add"/>
                </FrameLayout>
            </LinearLayout>
            <FrameLayout
                android:background="@color/s10"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:minHeight="96dp">
                <FrameLayout
                    android:layout_gravity="bottom"
                    android:id="@+id/open_vip_layout"
                    android:background="@color/s10"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="65dp"
                    android:minHeight="35dp"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/s2"
                        android:layout_gravity="start|center_vertical"
                        android:id="@+id/watch_skin_vip_tips_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/open_vip_tips"
                        android:drawablePadding="5dp"
                        android:drawableStart="@drawable/vip_icon"
                        android:layout_marginEnd="100dp"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/s34"
                        android:layout_gravity="end|center_vertical"
                        android:id="@+id/open_vip_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/open_vip_now"
                        android:drawablePadding="5dp"
                        android:drawableEnd="@drawable/icon_right_arrow_normal"/>
                </FrameLayout>
                <FrameLayout
                    android:layout_gravity="bottom"
                    android:background="@color/s38"
                    android:layout_width="match_parent"
                    android:layout_height="65dp"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp">
                    <TextView
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:layout_gravity="bottom"
                        android:id="@+id/watch_skin_buy_tv"
                        android:background="@drawable/common_corner_rect_red"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="45dp"
                        android:layout_marginTop="30dp"
                        android:layout_marginBottom="10dp"/>
                    <com.xiaomi.hm.health.device.watch_skin.WatchSkinProgressView
                        android:textColor="@color/s5"
                        android:gravity="center"
                        android:layout_gravity="bottom"
                        android:id="@+id/sync_apply_btn"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="45dp"
                        android:layout_marginTop="30dp"
                        android:layout_marginBottom="10dp"
                        android:text="@string/sync_watch_skin"
                        app:dialogMode="false"/>
                </FrameLayout>
            </FrameLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <include
        android:visibility="gone"
        layout="@layout/watch_skin_error_layout"/>
    <FrameLayout
        android:id="@+id/disable_mask"
        android:background="@color/transparency"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/color_container"
        android:background="@drawable/bg_dial_select_more_color"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="end|top"
            android:id="@+id/close_more_color_icon"
            android:padding="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:src="@drawable/dial_arrow_down"
            android:layout_marginEnd="8dp"/>
        <androidx.recyclerview.widget.RecyclerView
            android:layout_gravity="center_horizontal"
            android:id="@+id/select_more_color_rv"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginTop="35dp"
            android:layout_marginBottom="11dp"
            android:overScrollMode="never"/>
    </FrameLayout>
</FrameLayout>
