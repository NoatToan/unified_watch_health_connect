<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:huami="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_header"
        android:background="@drawable/bg_round_app_notification"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/size_10dp"
        android:layout_marginTop="@dimen/size_12dp"
        android:layout_marginRight="@dimen/size_10dp"
        android:layout_marginHorizontal="@dimen/size_10dp">
        <com.huami.lib.rainbow.ListTile
            android:id="@+id/notification_enable"
            android:background="@null"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            huami:ltv_checked="true"
            huami:ltv_title="@string/enable_app_alert"/>
        <com.huami.lib.rainbow.ListTile
            android:id="@+id/awake_switch"
            android:background="@null"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            huami:ltv_checked="true"
            huami:ltv_title="@string/smart_play_screen_sleep_title"/>
        <com.huami.lib.rainbow.ListTile
            android:id="@+id/item_reply_management"
            android:background="@null"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            huami:ltv_title="@string/title_reply_management"/>
    </LinearLayout>
    <com.xiaomi.hm.health.ui.smartplay.appnotify.view.NotificationFaqView
        android:id="@+id/tv_notification_faq"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/size_14dp"
        android:layout_marginTop="@dimen/size_12dp"
        android:layout_marginRight="@dimen/size_14dp"
        android:layout_marginBottom="@dimen/size_12dp"
        android:layout_below="@+id/layout_header"
        android:layout_marginHorizontal="@dimen/size_14dp"
        android:layout_marginVertical="@dimen/size_12dp"/>
    <TextView
        android:id="@+id/tv_desc_notification"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/size_14dp"
        android:layout_marginTop="@dimen/size_12dp"
        android:layout_marginRight="@dimen/size_14dp"
        android:layout_marginBottom="@dimen/size_12dp"
        android:text="@string/tip_switch_notification"
        android:layout_below="@+id/tv_notification_faq"
        android:layout_marginHorizontal="@dimen/size_14dp"
        android:layout_marginVertical="@dimen/size_12dp"/>
</RelativeLayout>
