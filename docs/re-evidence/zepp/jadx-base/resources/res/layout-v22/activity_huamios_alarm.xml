<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <RelativeLayout
        android:layout_gravity="bottom"
        android:id="@+id/edit_layout"
        android:background="@color/s38"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="@dimen/size_70dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <View
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/alarm_edit_parent"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_centerHorizontal="true">
            <TextView
                android:textSize="@dimen/size_12sp"
                android:textColor="@color/s2"
                android:gravity="center"
                android:id="@+id/alarm_edit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/edit"
                android:drawablePadding="@dimen/size_6dp"
                app:drawableTopCompat="@drawable/ic_alarm_edit"/>
            <TextView
                android:textSize="@dimen/size_12sp"
                android:textColor="@color/s2"
                android:gravity="center"
                android:id="@+id/alarm_add"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/smart_alarm_add"
                android:drawablePadding="@dimen/size_6dp"
                android:layout_marginStart="90dp"
                android:drawableTint="@color/s1"
                app:drawableTopCompat="@drawable/icon_add_alarm"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/size_12sp"
            android:textColor="@color/p4"
            android:id="@+id/alarm_done"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/smart_alarm_done"
            android:drawablePadding="@dimen/size_6dp"
            android:layout_centerInParent="true"
            android:drawableTint="@color/p4"
            app:drawableTopCompat="@drawable/icon_alarm_edit_finish"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/null_text"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/edit_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/container">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/img_no_alarm"
            app:tint="@color/s3"/>
        <TextView
            android:textSize="14.7sp"
            android:textColor="@color/s2"
            android:gravity="center"
            android:id="@+id/null_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26.7dp"
            android:text="@string/alarm_null_data_tip"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/alarm_layout"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/edit_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/container">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/alarm_tip_rl"
            android:background="@color/s36"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/size_12sp"
                android:textColor="@color/s2"
                android:id="@+id/alarm_tip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_15dp"
                android:layout_marginBottom="7.3dp"
                android:text="@string/miband_tips"
                android:layout_marginStart="@dimen/common_item_padding"
                android:layout_marginEnd="@dimen/common_item_padding"/>
            <View
                android:background="@color/s4"
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider"
                android:layout_marginStart="@dimen/common_item_padding"
                android:layout_marginEnd="@dimen/common_item_padding"/>
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/alarm_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"/>
    </LinearLayout>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/mask_view"
        android:background="@color/cl_4d000000"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/container"/>
</androidx.constraintlayout.widget.ConstraintLayout>
