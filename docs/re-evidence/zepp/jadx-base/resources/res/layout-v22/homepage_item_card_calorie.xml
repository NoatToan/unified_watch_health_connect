<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.huami.module.homepage.cards.cardui.CardTitleBarView
        android:id="@+id/calorie_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:showExpandButton="true"
        app:titleText="@string/homepage_item_card_calorie"/>
    <com.huami.module.homepage.cards.cardui.ProgressRingView
        android:id="@+id/ring"
        android:layout_width="128dp"
        android:layout_height="128dp"
        android:layout_marginTop="11dp"
        android:layout_marginStart="15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/calorie_bar"
        app:layout_goneMarginStart="15dp"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/s1"
        android:gravity="center_horizontal"
        android:id="@+id/calorie_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawableTop="@drawable/item_card_calorie"
        android:drawablePadding="-4dp"
        app:layout_constraintBottom_toBottomOf="@+id/ring"
        app:layout_constraintEnd_toEndOf="@+id/ring"
        app:layout_constraintStart_toStartOf="@+id/ring"
        app:layout_constraintTop_toTopOf="@+id/ring"
        style="@style/Rainbow.TextAppearance.Number2"/>
    <TextView
        android:textColor="@color/s1"
        android:ellipsize="end"
        android:id="@+id/activity_consume"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:text="@string/homepage_item_card_activity_consume"
        android:maxLines="2"
        android:paddingStart="24dp"
        android:paddingEnd="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/ring"
        app:layout_constraintTop_toTopOf="@+id/ring"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <com.huami.module.homepage.cards.cardui.PiecewiseLineView
        android:id="@+id/progressBar"
        android:layout_width="0dp"
        android:layout_height="20dp"
        android:layout_marginTop="6dp"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/activity_consume"
        app:layout_constraintTop_toBottomOf="@+id/activity_consume"/>
    <com.huami.module.homepage.cards.cardui.I18nNumberView
        android:textColor="@color/s2"
        android:id="@+id/percent_15"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        app:layout_constraintEnd_toStartOf="@+id/percent_30"
        app:layout_constraintStart_toStartOf="@+id/progressBar"
        app:layout_constraintTop_toBottomOf="@+id/progressBar"
        app:numberText="15"
        app:unitText="%"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <com.huami.module.homepage.cards.cardui.I18nNumberView
        android:textColor="@color/s2"
        android:id="@+id/percent_30"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        app:layout_constraintEnd_toEndOf="@+id/progressBar"
        app:layout_constraintStart_toEndOf="@+id/percent_15"
        app:layout_constraintTop_toBottomOf="@+id/progressBar"
        app:numberText="30"
        app:unitText="%"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <Space
        android:id="@+id/space_above_detail"
        android:layout_width="match_parent"
        android:layout_height="18dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ring"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/detail"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/space_above_detail">
        <TextView
            android:textColor="@color/s1"
            android:ellipsize="end"
            android:id="@+id/step_avg_step_last_7days"
            android:paddingLeft="15dp"
            android:paddingRight="15dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/homepage_item_card_step_avg_calorie_last_7days_hold"
            android:maxLines="2"
            android:paddingHorizontal="15dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Rainbow.TextAppearance.Body4"/>
        <FrameLayout
            android:id="@+id/chart_container"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginTop="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/step_avg_step_last_7days"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
