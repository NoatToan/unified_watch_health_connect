<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:id="@+id/ll_door_detail"
            android:background="@color/s38"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/size_18dp"
            android:paddingEnd="@dimen/size_18dp"
            app:divider="@drawable/access_door_divider_shape"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:showDividers="end|middle">
            <androidx.cardview.widget.CardView
                android:id="@+id/card"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_205dp"
                android:layout_marginTop="@dimen/size_14dp"
                android:layout_marginBottom="@dimen/size_15dp"
                android:layout_centerHorizontal="true"
                app:cardCornerRadius="@dimen/size_13dp">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <ImageView
                        android:id="@+id/card_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/bg_door_card"
                        android:scaleType="centerCrop"/>
                    <TextView
                        android:textSize="@dimen/size_12sp"
                        android:textColor="@color/s5"
                        android:id="@+id/tv_edit_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/size_14dp"
                        android:text="@string/access_card_edit_card"
                        android:drawablePadding="@dimen/size_5.5dp"
                        android:layout_alignParentBottom="true"
                        android:drawableEnd="@drawable/ic_arrow_right_detail_fragment"
                        android:layout_marginStart="@dimen/size_20dp"
                        android:layout_marginEnd="@dimen/size_15dp"
                        android:layout_alignParentEnd="true"/>
                    <TextView
                        android:textSize="@dimen/size_18sp"
                        android:textColor="@color/s5"
                        android:id="@+id/tv_card_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/size_14dp"
                        android:text="@string/access_card_family_name"
                        android:layout_alignParentTop="true"
                        android:layout_marginStart="@dimen/size_20dp"
                        android:layout_alignParentStart="true"/>
                    <TextView
                        android:textSize="@dimen/t3"
                        android:textColor="@color/s4"
                        android:id="@+id/tv_card_state"
                        android:background="@drawable/wl_solid_semicircle_shape_gray"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:visibility="invisible"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/size_14dp"
                        android:text="@string/access_card_default_card"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:layout_marginEnd="@dimen/size_14dp"
                        android:layout_alignParentEnd="true"/>
                    <TextView
                        android:textSize="@dimen/t3"
                        android:textColor="@color/s4"
                        android:id="@+id/tv_encryption_card_tip"
                        android:background="@drawable/wl_solid_semicircle_shape_gray"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/size_10dp"
                        android:text="@string/access_door_emulation_card_tip"
                        android:drawablePadding="@dimen/size_2dp"
                        android:layout_alignParentBottom="true"
                        android:drawableStart="@drawable/ic_access_door_key"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:layout_marginStart="@dimen/size_10dp"
                        android:layout_alignParentStart="true"/>
                </RelativeLayout>
            </androidx.cardview.widget.CardView>
            <TextView
                android:textColor="@color/s1"
                android:gravity="center_vertical"
                android:id="@+id/tv_fre_question"
                android:background="@drawable/access_item_click_bg"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_58dp"
                android:text="@string/access_card_fre_question"
                android:drawableEnd="@drawable/ic_arrow_forward_20_2x"
                android:drawableTint="@color/s3"/>
            <TextView
                android:textColor="@color/s1"
                android:gravity="center_vertical"
                android:id="@+id/tv_delete_card"
                android:background="@drawable/access_item_click_bg"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_58dp"
                android:text="@string/access_card_delete_card"
                android:drawableEnd="@drawable/ic_arrow_forward_20_2x"
                android:drawableTint="@color/s3"/>
            <TextView
                android:textColor="@color/s1"
                android:gravity="center_vertical"
                android:id="@+id/tv_set_default_card"
                android:background="@drawable/access_item_click_bg"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_58dp"
                android:text="@string/access_card_set_default_card"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/door_card_time_switch"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.appcompat.widget.AppCompatButton
                    android:textSize="@dimen/size_14sp"
                    android:textColor="@color/dark_sky_blue_three"
                    android:gravity="end|center_vertical"
                    android:id="@+id/bt_scheduled_switch_card_add"
                    android:background="@android:color/transparent"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/size_58dp"
                    android:minWidth="@dimen/size_50dp"
                    android:text="@string/smart_alarm_add"
                    android:drawableStart="@drawable/access_door_btn_scheduled_add"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textColor="@color/s1"
                    android:id="@+id/tv_title_scheduled_switch_card"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/wl_scheduled_switch_card"
                    app:layout_constraintBottom_toBottomOf="@+id/bt_scheduled_switch_card_add"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/bt_scheduled_switch_card_add"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_scheduled_switch_times"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/size_10dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/bt_scheduled_switch_card_add"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <TextView
            android:textSize="@dimen/size_14sp"
            android:textColor="@color/s3"
            android:id="@+id/tv_encryption_tip"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_20dp"
            android:text="@string/access_door_card_detail_tip"
            android:lineSpacingMultiplier="1.2"
            android:layout_marginStart="@dimen/size_18dp"
            android:layout_marginEnd="@dimen/size_18dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_door_detail"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
