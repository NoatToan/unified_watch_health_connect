<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/item_label_history_ring"
        android:background="@drawable/shape_label_history_ring"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginStart="15dp"
        app:layout_constraintBottom_toBottomOf="@+id/item_label_history_date"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/item_label_history_date"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/text_size_16"
        android:textColor="@color/s1"
        android:gravity="center_vertical"
        android:id="@+id/item_label_history_date"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="9dp"
        app:layout_constraintStart_toEndOf="@+id/item_label_history_ring"/>
</androidx.constraintlayout.widget.ConstraintLayout>
