<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/pay_cashier_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/s1"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/pay_cashier_title"
        android:paddingLeft="15dp"
        android:paddingRight="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="19dp"
        android:text="@string/pay_cashier_payment"
        style="@style/Rainbow.TextAppearance.Title2"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/pay_cashier_rv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"/>
    <androidx.appcompat.widget.AppCompatButton
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/s5"
        android:gravity="center"
        android:id="@+id/pay_cashier_pay_bt"
        android:background="@color/s12"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="5dp"
        android:layout_marginRight="15dp"
        android:layout_marginBottom="33dp"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/pay_cashier_state_icon"
        android:visibility="visible"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="64dp"/>
    <com.airbnb.lottie.LottieAnimationView
        android:layout_gravity="center_horizontal"
        android:id="@+id/pay_cashier_state_lv"
        android:visibility="gone"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="64dp"
        app:lottie_fileName="pay_cashier_loading.json"
        app:lottie_loop="true"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/s1"
        android:gravity="center"
        android:id="@+id/pay_cashier_state_tv"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="14dp"
        android:layout_marginRight="15dp"
        android:layout_marginBottom="64dp"
        style="@style/Rainbow.TextAppearance.Body4"/>
</LinearLayout>
