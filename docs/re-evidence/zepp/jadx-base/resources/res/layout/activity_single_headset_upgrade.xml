<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="20sp"
        android:textColor="@color/s1"
        android:gravity="center"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_18dp"
        android:text="@string/headset_fw_upgrade_left"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14sp"
        android:textColor="@color/s2"
        android:gravity="center"
        android:id="@+id/tv_title_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_9dp"
        android:text="@string/headset_fw_upgrade_left_tips"
        android:layout_marginStart="@dimen/size_40dp"
        android:layout_marginEnd="@dimen/size_40dp"/>
    <Space
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_headset"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/img_mozart_upgrade_left"/>
    <Space
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="3"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/s2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size_32dp"
        android:text="@string/headset_fw_upgrade_tips"
        android:layout_marginStart="@dimen/size_50dp"
        android:layout_marginEnd="@dimen/size_50dp"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/s1"
        android:gravity="center"
        android:id="@+id/tv_upgrade"
        android:background="@drawable/bg_bind_device_cancel"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_48dp"
        android:layout_marginBottom="@dimen/size_48dp"
        android:text="@string/headset_fw_upgrade_check"
        android:layout_marginStart="@dimen/size_20dp"
        android:layout_marginEnd="@dimen/size_20dp"/>
</androidx.appcompat.widget.LinearLayoutCompat>
