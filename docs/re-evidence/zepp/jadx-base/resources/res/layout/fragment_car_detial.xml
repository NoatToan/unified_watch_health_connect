<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_detail"
    android:background="@color/s36"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.cardview.widget.CardView
        android:id="@+id/card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/size_15dp"
        android:layout_marginStart="@dimen/dp_10"
        android:layout_marginEnd="@dimen/dp_10"
        app:cardCornerRadius="@dimen/car_image_round_rect_radius"
        app:cardPreventCornerOverlap="false"
        app:layout_constraintDimensionRatio="324:205"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/card_image_detail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/xp_img_xiaopeng"
            android:scaleType="centerCrop"
            android:contentDescription="@string/car_s_xiaopeng_create_key"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/s5"
            android:layout_gravity="end"
            android:id="@+id/carStatus"
            android:background="@drawable/car_solid_semicircle_shape"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="@string/car_default_card"
            android:paddingStart="11dp"
            android:paddingEnd="11dp"
            android:layout_marginEnd="15dp"/>
    </androidx.cardview.widget.CardView>
    <com.huami.xiaopeng.ui.amazfit.view.CarItemView
        android:id="@+id/openedKeys"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_58dp"
        android:layout_marginTop="@dimen/size_15dp"
        app:carItemDivider="both"
        app:itemTitle="@string/car_s_xiaopeng_opened_keys"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/card"/>
    <com.huami.xiaopeng.ui.amazfit.view.CarItemView
        android:id="@+id/keyAdd"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_58dp"
        app:carItemDivider="bottom"
        app:itemTitle="@string/car_s_xiaopeng_key_add"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/openedKeys"/>
    <com.huami.xiaopeng.ui.amazfit.view.CarItemView
        android:id="@+id/keyHelp"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_58dp"
        app:carItemDivider="bottom"
        app:itemTitle="@string/car_s_xiaopeng_help"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/keyAdd"/>
    <com.huami.xiaopeng.ui.amazfit.view.CarItemView
        android:id="@+id/keyDelete"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_58dp"
        app:carItemDivider="bottom"
        app:itemEndArrow="false"
        app:itemTitle="@string/car_s_xiaopeng_key_delete"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/keyHelp"/>
    <com.huami.xiaopeng.ui.amazfit.view.CarItemView
        android:id="@+id/keyDefault"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_58dp"
        app:carItemDivider="bottom"
        app:itemEndArrow="false"
        app:itemTitle="@string/car_s_xiaopeng_key_default"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/keyDelete"/>
</androidx.constraintlayout.widget.ConstraintLayout>
