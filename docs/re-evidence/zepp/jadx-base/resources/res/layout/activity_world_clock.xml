<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"/>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="bottom"
            android:id="@+id/area_handle"
            android:background="@color/s38"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_66dp"
            android:layout_alignParentBottom="true">
            <Button
                android:textSize="@dimen/size_12sp"
                android:textColor="@color/s2"
                android:gravity="center_horizontal"
                android:id="@+id/world_clock_edit"
                android:background="@android:color/transparent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/size_34dp"
                android:minHeight="@dimen/size_34dp"
                android:text="@string/world_clock_edit"
                android:drawableTop="@drawable/world_clock_layer_edit"
                android:drawablePadding="3dp"
                android:layout_marginEnd="@dimen/size_48dp"/>
            <Button
                android:textSize="@dimen/size_12sp"
                android:textColor="@color/s2"
                android:gravity="center_horizontal"
                android:id="@+id/world_clock_add"
                android:background="@android:color/transparent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/size_34dp"
                android:minHeight="@dimen/size_34dp"
                android:text="@string/world_clock_add"
                android:drawableTop="@drawable/world_clock_layer_add"
                android:drawablePadding="3dp"/>
        </LinearLayout>
        <Button
            android:textSize="@dimen/size_16sp"
            android:textColor="@color/s5"
            android:layout_gravity="bottom"
            android:id="@+id/btn_complete"
            android:background="@color/s20"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_66dp"
            android:text="@string/btn_complete"
            android:layout_alignParentBottom="true"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="@dimen/size_66dp"
            android:layout_below="@+id/container">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:background="@color/s38"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_10dp"/>
            <TextView
                android:textSize="@dimen/size_16sp"
                android:textColor="@color/s2"
                android:layout_gravity="center"
                android:id="@+id/empty_hint"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/world_clock_empty_hint"
                android:drawablePadding="@dimen/size_60dp"
                app:drawableTopCompat="@drawable/icon_world_clock_empty_hint"/>
        </FrameLayout>
        <View
            android:id="@+id/mask_view"
            android:background="@color/cl_b2000000"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/container"/>
    </RelativeLayout>
</FrameLayout>
