<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.lib.rainbow.titlebar.RainbowTitleBar
        android:id="@+id/mode_setting_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:menuText="@string/save"
        app:menuTint="@color/p3"
        app:title="@string/app_night_mode"
        style="@style/Rainbow.TextAppearance.Title3"/>
    <com.huami.lib.rainbow.ListTile
        android:id="@+id/mode_setting_system"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mode_setting_title_bar"
        app:ltv_leading="@drawable/ic_all_done_20_2x"
        app:ltv_radius_position="top"
        app:ltv_subtitle="@string/app_night_mode_tips"
        app:ltv_title="@string/app_night_mode_system"/>
    <com.huami.lib.rainbow.ListTile
        android:id="@+id/mode_setting_normal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mode_setting_system"
        app:ltv_leading="@drawable/ic_all_done_20_2x"
        app:ltv_title="@string/app_night_mode_normal"/>
    <com.huami.lib.rainbow.ListTile
        android:id="@+id/mode_setting_night"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mode_setting_normal"
        app:ltv_leading="@drawable/ic_all_done_20_2x"
        app:ltv_radius_position="bottom"
        app:ltv_title="@string/app_night_mode"/>
</androidx.constraintlayout.widget.ConstraintLayout>
