<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.huami.lib.rainbow.titlebar.RainbowTitleBar
            android:id="@+id/friend_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:menuIcon="@drawable/ic_more_20_2x"
            app:navigationIcon="@drawable/ic_arrow_back_20_2x"
            app:title="@string/relatives_title_friend_list"
            style="@style/Rainbow.TextAppearance.Title3"/>
        <View
            android:layout_gravity="end|bottom"
            android:id="@+id/friend_red_dot"
            android:background="@drawable/ic_red_circle"
            android:visibility="visible"
            android:layout_width="@dimen/relatives_size_7dp"
            android:layout_height="@dimen/relatives_size_7dp"
            android:layout_marginBottom="@dimen/relatives_size_30dp"
            android:layout_marginEnd="@dimen/relatives_size_12dp"/>
    </FrameLayout>
    <com.scwang.smartrefresh.layout.SmartRefreshLayout
        android:id="@+id/refresh_layout"
        android:background="@color/s10"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ListView
                android:id="@+id/list_view"
                android:fadingEdge="none"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:cacheColorHint="#00000000"
                android:divider="#00000000"
                android:fastScrollEnabled="false"
                android:headerDividersEnabled="false"
                android:footerDividersEnabled="false"
                android:smoothScrollbar="true"
                android:overScrollMode="never"
                android:requiresFadingEdge="none"/>
            <RelativeLayout
                android:layout_gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/empty_list"
                android:background="@color/s10"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:id="@+id/relation_empty_image"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/relatives_size_150dp"
                    android:src="@drawable/relatives_ic_relation_empty"
                    android:layout_centerHorizontal="true"/>
                <com.huami.widget.typeface.TypefaceTextView
                    android:textSize="14sp"
                    android:textColor="@color/s2"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/relatives_size_10dp"
                    android:text="@string/relatives_label_empty_friend"
                    android:layout_below="@+id/relation_empty_image"
                    android:layout_centerHorizontal="true"
                    android:lineSpacingExtra="14sp"
                    android:fontFamily="lt"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/relatives_size_85dp"
                    android:layout_alignParentBottom="true">
                    <com.huami.widget.typeface.TypefaceTextView
                        android:textSize="17sp"
                        android:textColor="@color/p3"
                        android:gravity="center"
                        android:id="@+id/action_button_qr"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/relatives_click_button_h"
                        android:layout_marginTop="@dimen/relatives_size_36dp"
                        android:text="@string/relatives_label_my_qrcode"
                        android:fontFamily="lt"
                        android:layout_marginStart="@dimen/relatives_common_item_padding"
                        android:layout_marginEnd="@dimen/relatives_common_item_padding"/>
                    <com.huami.widget.typeface.TypefaceTextView
                        android:textSize="15sp"
                        android:textColor="@color/s1"
                        android:gravity="center"
                        android:id="@+id/action_button"
                        android:background="@drawable/relatives_common_corner_rect_red"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/relatives_size_48dp"
                        android:layout_marginTop="30.3dp"
                        android:layout_marginBottom="@dimen/relatives_size_70dp"
                        android:text="@string/relatives_label_scan_add"
                        android:fontFamily="lt"
                        android:layout_marginStart="@dimen/relatives_common_item_padding"
                        android:layout_marginEnd="@dimen/relatives_common_item_padding"/>
                </LinearLayout>
            </RelativeLayout>
        </FrameLayout>
    </com.scwang.smartrefresh.layout.SmartRefreshLayout>
</LinearLayout>
