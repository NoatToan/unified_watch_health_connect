<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container_chart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container_analyse"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_12"
        app:layout_constraintTop_toBottomOf="@+id/container_chart"/>
    <com.huami.lib.rainbow.ListTile
        android:id="@+id/ltv_add"
        android:background="@drawable/card_corner_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_12"
        android:layout_marginStart="@dimen/size_10"
        android:layout_marginEnd="@dimen/size_10"
        app:layout_constraintTop_toBottomOf="@+id/container_analyse"
        app:ltv_title="@string/blood_pressure_add_data"
        style="@style/Rainbow.TextAppearance.Body3"/>
    <com.huami.lib.rainbow.ListTile
        android:id="@+id/ltv_history"
        android:background="@drawable/card_corner_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_12"
        android:layout_marginStart="@dimen/size_10"
        android:layout_marginEnd="@dimen/size_10"
        app:layout_constraintTop_toBottomOf="@+id/ltv_add"
        app:ltv_title="@string/blood_pressure_manual_data"/>
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container_research"
        android:paddingTop="@dimen/size_12"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/ltv_history"/>
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_12"
        app:layout_constraintTop_toBottomOf="@+id/container_research"/>
</androidx.constraintlayout.widget.ConstraintLayout>
