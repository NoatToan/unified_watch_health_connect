<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/video_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <SurfaceView
            android:id="@+id/video_surface"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/video_buffering_progress"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateDrawable="@drawable/training_progress"/>
    </FrameLayout>
    <RelativeLayout
        android:id="@+id/video_control"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:background="@drawable/training_playback_title_layer_bg"
            android:layout_width="match_parent"
            android:layout_height="46dp">
            <ImageView
                android:id="@+id/video_close"
                android:layout_width="48dp"
                android:layout_height="46dp"
                android:src="@drawable/icon_training_video_close"
                android:scaleType="center"
                android:layout_centerVertical="true"/>
            <ImageView
                android:id="@+id/video_bgm"
                android:layout_width="48dp"
                android:layout_height="46dp"
                android:src="@drawable/icon_training_video_bgm"
                android:scaleType="center"
                android:layout_toRightOf="@+id/video_close"
                android:layout_centerVertical="true"
                android:layout_marginStart="10dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/white"
                android:id="@+id/current_action"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:background="@drawable/training_playback_control_layer_bg"
            android:paddingTop="4dp"
            android:layout_width="match_parent"
            android:layout_height="66dp"
            android:layout_alignParentBottom="true">
            <ImageView
                android:id="@+id/video_pause"
                android:background="@drawable/icon_training_video_pause"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_centerHorizontal="true"/>
            <ImageView
                android:id="@+id/video_prev"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/icon_training_video_prev"
                android:scaleType="center"
                android:layout_toLeftOf="@+id/video_pause"
                android:layout_marginEnd="60dp"/>
            <ImageView
                android:id="@+id/video_next"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/icon_training_video_next"
                android:scaleType="center"
                android:layout_toRightOf="@+id/video_pause"
                android:layout_marginStart="60dp"/>
        </RelativeLayout>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/bottom_area"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/invisible_placeholder"
            android:layout_width="1dp"
            android:layout_height="1dp"/>
        <RelativeLayout
            android:id="@+id/training_timer"
            android:layout_width="82dp"
            android:layout_height="82dp"
            android:layout_marginBottom="24dp"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="18dp">
            <com.xiaomi.hm.health.training.ui.widget.progress.TrainingActionRingProgressView
                android:id="@+id/trainingArcProgress"
                android:layout_width="82dp"
                android:layout_height="82dp"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="14sp"
                android:textColor="@color/white60"
                android:id="@+id/training_cost_time"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="50dp"
                android:layout_centerHorizontal="true"
                android:fontFamily="km"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/white100"
                android:id="@+id/training_timer_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/training_timer"
                android:drawableTop="@drawable/icon_training_timer"
                android:drawablePadding="3dp"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <com.xiaomi.hm.health.training.ui.widget.TrainingActionBarProgressView
            android:id="@+id/trainingBarProgress"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_alignParentBottom="true"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/seek_bar_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:paddingStart="5dp"
            android:paddingEnd="18dp">
            <SeekBar
                android:id="@+id/online_video_progress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="1dp"
                android:maxHeight="6dp"
                android:max="100"
                android:progressDrawable="@drawable/online_video_seekbar_progress"
                android:thumb="@drawable/online_video_seekbar_thumb"
                android:thumbOffset="7dp"
                android:layout_weight="1"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/white80"
                android:id="@+id/video_current_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:minWidth="57dp"
                android:layout_marginStart="10dp"/>
        </LinearLayout>
        <RelativeLayout
            android:id="@+id/training_hr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="18dp"
            android:layout_alignParentEnd="true">
            <com.xiaomi.hm.health.training.ui.widget.TrainingHrIndicatorView
                android:id="@+id/trainingHrIndicatorView"
                android:layout_width="82dp"
                android:layout_height="82dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/white100"
                android:id="@+id/training_hr_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/training_hr"
                android:drawableTop="@drawable/icon_training_heart"
                android:drawablePadding="3dp"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
    </RelativeLayout>
</RelativeLayout>
