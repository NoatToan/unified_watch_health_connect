<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/page_3_layout"
        android:background="@drawable/unit_setting_dialog_bg"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="155dp"
        android:layout_centerHorizontal="true">
        <TextView
            android:textSize="9sp"
            android:textColor="@color/s2"
            android:id="@+id/unit_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/instruction_unit_setting"
            android:layout_marginStart="34dp"/>
        <View
            android:id="@+id/divider_title"
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="5dp"
            android:layout_below="@+id/unit_title"
            android:layout_marginStart="34dp"
            android:layout_marginEnd="34dp"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:src="@drawable/weight_bfs_unit_arrow"
            android:layout_below="@+id/divider_title"
            android:layout_marginStart="18dp"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/s3"
            android:id="@+id/unit_tv_kg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/weight_bfs_unit_kg"
            android:layout_below="@+id/divider_title"
            android:layout_marginStart="34dp"/>
        <View
            android:id="@+id/divider_below_kg"
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_below="@+id/unit_tv_kg"
            android:layout_marginStart="34dp"
            android:layout_marginEnd="34dp"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/s3"
            android:id="@+id/unit_tv_yb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/weight_bfs_unit_pound"
            android:layout_below="@+id/divider_below_kg"
            android:layout_marginStart="34dp"/>
        <View
            android:id="@+id/divider_below_yb"
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_below="@+id/unit_tv_yb"
            android:layout_marginStart="34dp"
            android:layout_marginEnd="34dp"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/s3"
            android:id="@+id/unit_tv_jin"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/weight_bfs_unit_jin"
            android:layout_below="@+id/divider_below_yb"
            android:layout_marginStart="34dp"/>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
