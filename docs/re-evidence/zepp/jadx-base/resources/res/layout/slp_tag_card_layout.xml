<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/selectView"
        android:paddingTop="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/s1"
            android:id="@+id/sleepTagTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="220dp"
            android:text="@string/sleep_tag"
            android:layout_marginStart="15dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="220dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/s2"
            android:id="@+id/selCancelTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancel"
            android:paddingStart="@dimen/slp_size_15dp"
            android:paddingEnd="15dp"
            app:layout_constraintBottom_toBottomOf="@+id/sleepTagTv"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/sleepTagTv"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/p3"
            android:id="@+id/confirmTv"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/confirm"
            app:layout_constraintBottom_toBottomOf="@+id/sleepTagTv"
            app:layout_constraintEnd_toStartOf="@+id/selCancelTv"
            app:layout_constraintTop_toTopOf="@+id/sleepTagTv"/>
        <com.huami.sleep.view.NestRecyclerView
            android:orientation="horizontal"
            android:id="@+id/tagRV"
            android:paddingTop="15dp"
            android:paddingBottom="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintTop_toBottomOf="@+id/sleepTagTv"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/manualLayout"
        android:background="@color/s4"
        android:paddingLeft="10dp"
        android:paddingTop="10dp"
        android:paddingRight="10dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/s1"
            android:id="@+id/cancelTv"
            android:padding="15dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/slp_cancel"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <EditText
            android:textSize="12sp"
            android:textColor="@color/s1"
            android:textColorHint="@color/s3"
            android:id="@+id/inputEt"
            android:background="@drawable/sleep_main_bg"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:hint="@string/slp_add_tag"
            android:singleLine="true"
            android:maxLength="6"
            android:imeOptions="actionDone"
            android:paddingStart="10dp"
            android:paddingEnd="40dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/cancelTv"
            app:layout_constraintRight_toLeftOf="@+id/cancelTv"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.5"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/s3"
            android:id="@+id/counterTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            app:layout_constraintBottom_toBottomOf="@+id/inputEt"
            app:layout_constraintEnd_toEndOf="@+id/inputEt"
            app:layout_constraintTop_toTopOf="@+id/inputEt"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
