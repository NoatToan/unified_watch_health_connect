<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_success"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:background="@color/s36"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_160dp">
            <ImageView
                android:id="@+id/iv_apply_success"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_20dp"
                android:src="@drawable/wl_ic_invoice_success"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="18sp"
                android:textColor="@color/s1"
                android:id="@+id/tv_apply_success"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_8dp"
                android:layout_below="@+id/iv_apply_success"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="18sp"
                android:textColor="@color/s1"
                android:id="@+id/tv_apply_failure"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/iv_apply_success"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/s2"
                android:id="@+id/tv_apply_failure_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_2dp"
                android:layout_below="@+id/tv_apply_failure"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_8dp"/>
        <RelativeLayout
            android:gravity="center_vertical"
            android:id="@+id/wl_order_number_rl"
            android:background="@color/s36"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_58dp">
            <TextView
                android:textSize="@dimen/size_15sp"
                android:textColor="@color/s1"
                android:id="@+id/tv_repair_order"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wl_repair_order"
                android:layout_marginStart="@dimen/size_18dp"/>
            <TextView
                android:textSize="@dimen/size_15sp"
                android:textColor="@color/s41"
                android:id="@+id/tv_copy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wl_copy"
                android:layout_marginEnd="@dimen/size_18dp"
                android:layout_alignParentEnd="true"/>
            <TextView
                android:textSize="@dimen/size_15sp"
                android:textColor="@color/s2"
                android:ellipsize="end"
                android:gravity="end"
                android:id="@+id/tv_order_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_marginStart="@dimen/size_18dp"
                android:layout_marginEnd="19dp"
                android:layout_toStartOf="@+id/tv_copy"
                android:layout_toEndOf="@+id/tv_repair_order"/>
        </RelativeLayout>
        <TextView
            android:textSize="@dimen/size_14sp"
            android:textColor="@color/s1"
            android:id="@+id/tv_tip_msg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_20dp"
            android:layout_marginStart="@dimen/size_18dp"
            android:layout_marginEnd="@dimen/size_18dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
