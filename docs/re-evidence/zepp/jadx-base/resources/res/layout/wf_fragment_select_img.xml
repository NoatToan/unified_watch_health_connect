<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/dlg_empty_area_btn"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/wf_dialog_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14.5sp"
                android:textColor="@color/wf_select_img_text_color"
                android:gravity="center"
                android:id="@+id/select_image_camera_area"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/wf_select_from_camera"/>
            <View
                android:background="@color/black20"
                android:layout_width="match_parent"
                android:layout_height="1px"/>
            <TextView
                android:textSize="14.5sp"
                android:textColor="@color/wf_select_img_text_color"
                android:gravity="center"
                android:id="@+id/select_image_local_area"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/wf_select_from_local"/>
        </LinearLayout>
        <FrameLayout
            android:background="@drawable/wf_dialog_bg"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp">
            <TextView
                android:textSize="13sp"
                android:textColor="@color/wf_select_img_text_color"
                android:gravity="center"
                android:id="@+id/select_image_cancel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/wf_select_cancel"/>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
