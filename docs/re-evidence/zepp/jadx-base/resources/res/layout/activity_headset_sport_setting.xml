<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.lib.rainbow.titlebar.RainbowTitleBar
        android:id="@+id/rainbowTitleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/headset_settings_sport"/>
    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.huami.lib.rainbow.ListTile
        android:id="@+id/headset_beat_enhancement_item"
        android:background="@color/s38"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:ltv_checked="false"
        app:ltv_subtitle="@string/headset_beat_enhancement_summary"
        app:ltv_title="@string/headset_beat_enhancement"/>
    <com.huami.lib.rainbow.ListTile
        android:id="@+id/headset_auto_side_listen_item"
        android:background="@color/s38"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:ltv_checked="false"
        app:ltv_subtitle="@string/headset_auto_side_listen_summary"
        app:ltv_title="@string/headset_auto_side_listen"/>
    <com.huami.lib.rainbow.ListTile
        android:id="@+id/headset_sport_heart_rate_broadcast_item"
        android:background="@color/s38"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:ltv_checked="false"
        app:ltv_subtitle="@string/sport_heart_boradcast_tips"
        app:ltv_title="@string/sport_heart_boradcast"/>
</LinearLayout>
