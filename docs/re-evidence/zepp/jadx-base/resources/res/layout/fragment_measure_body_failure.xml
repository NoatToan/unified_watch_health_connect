<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/s38"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/layout_weight_title_and_view"/>
    <TextView
        android:textColor="@color/s2"
        android:gravity="center"
        android:id="@+id/weighting_bf_help"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginTop="35dp"
        android:minWidth="80dp"
        android:text="@string/weighting_weight_bf_help"
        android:layout_below="@+id/layout_weight"
        android:layout_centerHorizontal="true"/>
    <Button
        android:textColor="@color/p4"
        android:id="@+id/weighting_bf_save"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="15dp"
        android:text="@string/weighting_weight_bf_save"
        android:layout_above="@+id/weighting_bf_abandon"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        style="?attr/buttonStyleGray_48_flat"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/s1"
        android:gravity="center"
        android:id="@+id/weighting_bf_abandon"
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:layout_marginBottom="20dp"
        android:text="@string/weighting_weight_bf_abandon"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
