<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item_root_view"
    android:layout_width="match_parent"
    android:layout_height="150dp">
    <TextView
        android:textSize="14sp"
        android:textColor="#e6000000"
        android:gravity="center"
        android:id="@+id/type_title"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:text="@string/training_type"
        android:layout_marginStart="20dp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@drawable/training_item_value_text_color_selector"
        android:gravity="end|center_vertical"
        android:id="@+id/type_setting"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:minWidth="100dp"
        android:text="@string/training_click_setting"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="56dp"
        android:layout_toEndOf="@+id/type_title"
        android:layout_alignParentEnd="true"/>
    <View
        android:id="@+id/line1"
        android:background="#14000000"
        android:layout_width="match_parent"
        android:layout_height="0.3dp"
        android:layout_below="@+id/type_title"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="56dp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#e6000000"
        android:gravity="center"
        android:id="@+id/duration_title"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:text="@string/training_duration"
        android:layout_below="@+id/type_title"
        android:layout_marginStart="20dp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@drawable/training_item_value_text_color_selector"
        android:gravity="end|center_vertical"
        android:id="@+id/duration_setting"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:minWidth="100dp"
        android:text="@string/training_click_setting"
        android:layout_below="@+id/type_title"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="56dp"
        android:layout_toEndOf="@+id/duration_title"
        android:layout_alignParentEnd="true"/>
    <View
        android:id="@+id/line2"
        android:background="#14000000"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0.3dp"
        android:layout_below="@+id/duration_title"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="56dp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#e6000000"
        android:gravity="start|center_vertical"
        android:id="@+id/reminder_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="200dp"
        android:minHeight="50dp"
        android:text="@string/sport_training_reminder"
        android:layout_below="@+id/duration_title"
        android:layout_centerVertical="true"
        android:layout_alignStart="@+id/duration_title"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@drawable/training_item_value_text_color_selector"
        android:gravity="end|center_vertical"
        android:id="@+id/reminder_setting"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:minWidth="100dp"
        android:text="@string/training_click_setting"
        android:layout_below="@+id/duration_title"
        android:layout_centerVertical="true"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="56dp"
        android:layout_toEndOf="@+id/reminder_title"
        android:layout_alignParentEnd="true"/>
    <ImageView
        android:id="@+id/delete_icon"
        android:visibility="visible"
        android:layout_width="20dp"
        android:layout_height="40dp"
        android:src="@drawable/btn_delete_training_info_selector"
        android:scaleType="centerInside"
        android:layout_centerVertical="true"
        android:layout_marginEnd="20dp"
        android:layout_alignParentEnd="true"/>
    <View
        android:id="@+id/line"
        android:background="#14000000"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0.3dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
</RelativeLayout>
