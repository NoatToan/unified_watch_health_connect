<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/tr_pager_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="9.7dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="9.7dp"/>
    <com.huami.training.ui.widget.CourseCardView
        android:id="@+id/planCardRingBg"
        android:layout_width="0dp"
        android:layout_height="144dp"
        android:layout_marginTop="15dp"
        app:cardBackgroundColor="#ffffff"
        app:layout_constraintEnd_toEndOf="@+id/end"
        app:layout_constraintStart_toStartOf="@+id/start"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TrainingCard"/>
    <com.huami.training.ui.widget.CourseCardView
        android:id="@+id/planCard"
        android:layout_width="0dp"
        android:layout_height="136dp"
        android:layout_marginTop="19dp"
        android:foreground="?attr/selectableItemBackground"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        app:cardBackgroundColor="#ffffff"
        app:layout_constraintEnd_toEndOf="@+id/end"
        app:layout_constraintStart_toStartOf="@+id/start"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TrainingCard">
        <ImageView
            android:id="@+id/planBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/tr_fit_plan_default_bg"
            android:scaleType="centerCrop"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="15.3sp"
                android:textColor="@android:color/white"
                android:ellipsize="end"
                android:id="@+id/planStartTip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="38dp"
                android:text="@string/tr_fit_begin_tips"
                android:maxLines="1"
                android:fontFamily="lt"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="16sp"
                android:textColor="@android:color/white"
                android:ellipsize="end"
                android:id="@+id/planTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="23.3dp"
                android:maxLines="1"
                android:fontFamily="lt-bold"
                android:layout_marginStart="19.3dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="12sp"
                android:textColor="@android:color/white"
                android:ellipsize="end"
                android:id="@+id/planProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:fontFamily="lt"
                android:layout_marginEnd="20dp"
                app:layout_constraintBottom_toBottomOf="@+id/planTitle"
                app:layout_constraintEnd_toEndOf="parent"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="12sp"
                android:textColor="#8d8d8d"
                android:ellipsize="end"
                android:id="@+id/planDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:maxLines="1"
                android:fontFamily="lt"
                app:layout_constraintStart_toStartOf="@+id/planTitle"
                app:layout_constraintTop_toBottomOf="@+id/planTitle"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="12sp"
                android:textColor="#ffffff"
                android:ellipsize="end"
                android:id="@+id/planDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:fontFamily="lt"
                android:layout_marginEnd="6dp"
                app:layout_constraintBaseline_toBaselineOf="@+id/planDifficulty"
                app:layout_constraintEnd_toStartOf="@+id/planDifficulty"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="12sp"
                android:textColor="#ffffff"
                android:ellipsize="end"
                android:id="@+id/planDifficulty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:fontFamily="lt"
                app:layout_constraintBottom_toBottomOf="@+id/planDesc"
                app:layout_constraintEnd_toEndOf="@+id/planProgress"/>
            <ProgressBar
                android:id="@+id/planProgressBar"
                android:layout_width="0dp"
                android:layout_height="7.7dp"
                android:layout_marginTop="15dp"
                android:progressDrawable="@drawable/tr_fit_progress_drawable"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/planDifficulty"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/planContent"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="planTitle,planProgressBar,planProgress,planDesc,planDuration,planDifficulty"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.huami.training.ui.widget.CourseCardView>
    <ImageView
        android:id="@+id/startPlan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="118dp"
        android:src="@drawable/tr_fit_start"
        android:elevation="@dimen/tr_card_elevation"
        app:layout_constraintEnd_toEndOf="@+id/end"
        app:layout_constraintStart_toStartOf="@+id/start"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/planArea"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="planCardRingBg,planCard,startPlan"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="16sp"
        android:textColor="#333333"
        android:ellipsize="end"
        android:id="@+id/joinedTrainingTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="19.3dp"
        android:text="@string/tr_joined_course"
        android:maxLines="1"
        android:fontFamily="lt"
        android:layout_marginStart="14dp"
        app:layout_constraintStart_toEndOf="@+id/start"
        app:layout_constraintTop_toBottomOf="@+id/startPlan"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="12sp"
        android:textColor="#8d8d8d"
        android:ellipsize="end"
        android:id="@+id/viewMoreJoinedCourse"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tr_view_more"
        android:maxLines="1"
        android:fontFamily="lt"
        android:layout_marginEnd="15dp"
        app:layout_constraintBottom_toBottomOf="@+id/joinedTrainingTitle"
        app:layout_constraintEnd_toStartOf="@+id/end"/>
    <com.huami.training.ui.widget.CourseCardView
        android:id="@+id/joinedTrainingsCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="7.7dp"
        android:layout_marginBottom="10dp"
        android:minHeight="123.3dp"
        app:cardBackgroundColor="#ffffff"
        app:layout_constraintBottom_toTopOf="@+id/promotionalCourses"
        app:layout_constraintEnd_toEndOf="@+id/end"
        app:layout_constraintStart_toStartOf="@+id/start"
        app:layout_constraintTop_toBottomOf="@+id/joinedTrainingTitle"
        style="@style/TrainingCard">
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="15.3sp"
            android:textColor="#333333"
            android:ellipsize="end"
            android:layout_gravity="center_horizontal"
            android:id="@+id/emptyJoinedTrainingTips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26.7dp"
            android:text="@string/tr_fit_begin_course_tips"
            android:maxLines="1"
            android:fontFamily="lt"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/joinedTrainings"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="51.6dp"
            android:overScrollMode="never"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:gravity="center_vertical"
            android:layout_gravity="bottom|center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/addTraining"
            android:layout_width="match_parent"
            android:layout_height="51.6dp">
            <ImageView
                android:id="@+id/addTrainingIcon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/tr_fit_add_course"
                android:layout_marginEnd="4.7dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/addTrainingText"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="13.4sp"
                android:textColor="#ff6000"
                android:gravity="center_vertical"
                android:id="@+id/addTrainingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tr_add_course"
                android:fontFamily="lt"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toEndOf="@+id/addTrainingIcon"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.huami.training.ui.widget.CourseCardView>
    <FrameLayout
        android:id="@+id/promotionalCourses"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="27dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/joinedTrainingsCard"/>
    <Space
        android:layout_width="match_parent"
        android:layout_height="13.3dp"
        app:layout_constraintTop_toBottomOf="@+id/promotionalCourses"/>
</androidx.constraintlayout.widget.ConstraintLayout>
