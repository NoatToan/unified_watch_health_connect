<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s38"
    android:paddingTop="13.3dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/size_18dp"
    android:paddingEnd="@dimen/size_18dp">
    <ImageView
        android:id="@+id/energy_record_icon"
        android:padding="3dp"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginTop="7.7dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="15.3sp"
        android:textColor="@color/s1"
        android:ellipsize="end"
        android:id="@+id/energy_record_title"
        android:layout_width="184dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:layout_marginStart="13.5dp"
        app:layout_constraintStart_toEndOf="@+id/energy_record_icon"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/size_14sp"
        android:textColor="@color/s2"
        android:id="@+id/energy_record_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="13.3dp"
        android:drawablePadding="4.8dp"
        app:drawableStartCompat="@drawable/ic_time_14_s2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/energy_record_title"
        app:layout_constraintTop_toBottomOf="@+id/energy_record_title"/>
    <TextView
        android:textSize="@dimen/size_14sp"
        android:textColor="@color/s2"
        android:id="@+id/energy_record_cal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBaseline_toBaselineOf="@+id/energy_record_title"
        app:layout_constraintEnd_toEndOf="parent"/>
    <TextView
        android:textSize="@dimen/size_14sp"
        android:textColor="@color/s2"
        android:id="@+id/energy_record_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBaseline_toBaselineOf="@+id/energy_record_desc"
        app:layout_constraintEnd_toEndOf="parent"/>
    <View
        android:id="@+id/energy_divider"
        android:background="@color/s4"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
