<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="15sp"
        android:textColor="@color/s3"
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="@dimen/heart_type_width"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"/>
    <TextView
        android:textSize="18sp"
        android:textColor="@drawable/hrr_value_text_color_selector"
        android:gravity="center"
        android:id="@+id/value"
        android:background="@drawable/border_edit_heart_selector"
        android:layout_width="@dimen/heart_percent_width"
        android:layout_height="40dp"
        android:singleLine="true"
        android:layout_marginStart="12dp"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/s3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/hr_unit_name"
        android:layout_marginStart="5dp"/>
    <TextView
        android:textSize="18sp"
        android:textColor="@drawable/hrr_value_text_color_selector"
        android:gravity="center"
        android:id="@+id/percent"
        android:background="@drawable/border_edit_heart_selector"
        android:layout_width="@dimen/heart_percent_width"
        android:layout_height="40dp"
        android:singleLine="true"
        android:layout_marginStart="@dimen/heart_percent_margin_start"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/s3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="%"
        android:layout_marginStart="5dp"/>
</LinearLayout>
