<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s38"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.treadmill.ext.AutoNestedScrollView
        android:id="@+id/auto_nsv"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/detail_line_bg"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/td_size_403dp"
                    android:src="@drawable/td_detail_line_bg"
                    android:scaleType="centerCrop"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:background="@color/s38"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/td_size_24dp"
                    android:paddingEnd="@dimen/td_size_24dp"
                    app:layout_constraintTop_toBottomOf="@+id/detail_line_bg">
                    <TextView
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/s1"
                        android:id="@+id/line_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/td_size_24dp"
                        android:maxWidth="250dp"
                        android:singleLine="true"
                        android:lineSpacingExtra="-7.8sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="11.7sp"
                        android:textColor="@color/s1"
                        android:id="@+id/line_area"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9.3dp"
                        android:drawablePadding="3dp"
                        android:drawableStart="@drawable/td_location_map"
                        app:layout_constraintStart_toStartOf="@+id/line_title"
                        app:layout_constraintTop_toBottomOf="@+id/line_title"/>
                    <com.huami.widget.typeface.TypefaceTextView
                        android:textSize="38.3sp"
                        android:textColor="@color/s1"
                        android:gravity="end"
                        android:id="@+id/line_dis"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="ow"
                        app:layout_constraintBottom_toBottomOf="@+id/line_area"
                        app:layout_constraintEnd_toStartOf="@+id/line_dis_unit"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/s1"
                        android:id="@+id/line_dis_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/td_running_kilometer"
                        app:layout_constraintBottom_toBottomOf="@+id/line_area"
                        app:layout_constraintEnd_toEndOf="parent"/>
                    <View
                        android:id="@+id/line_dividing_line"
                        android:background="@color/s10"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/td_size_13dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/line_area"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/s1"
                        android:id="@+id/line_run_number"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/td_size_19dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/line_dividing_line"/>
                    <com.huami.treadmill.ui.component.HorizontalAvatar
                        android:id="@+id/horizontal_avatar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toBottomOf="@+id/line_run_number"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/line_run_number"/>
                    <com.huami.treadmill.ui.component.CollapsibleTextView
                        android:textSize="12sp"
                        android:textColor="@color/s2"
                        android:ellipsize="end"
                        android:gravity="left"
                        android:id="@+id/line_introduction"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/td_size_30dp"
                        android:layout_marginBottom="@dimen/td_size_30dp"
                        app:collapsedLines="2"
                        app:collapsedText="@string/td_text_show_all"
                        app:expandedText="@string/td_text_hide"
                        app:layout_constrainedWidth="true"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/line_run_number"
                        app:suffixColor="@android:color/holo_blue_light"
                        app:suffixTrigger="false"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <net.lucode.hackware.magicindicator.MagicIndicator
                android:id="@+id/tab_layout"
                android:background="@color/s38"
                android:layout_width="match_parent"
                android:layout_height="@dimen/td_size_50dp"
                android:layout_marginTop="@dimen/td_size_10dp"
                android:layout_marginBottom="@dimen/td_size_1dp"/>
            <com.huami.treadmill.ext.AutoViewPager
                android:id="@+id/view_pager"
                android:background="@color/s38"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/td_size_100dp"
                app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
        </LinearLayout>
    </com.huami.treadmill.ext.AutoNestedScrollView>
    <View
        android:id="@+id/status_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/td_size_16dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/action_bar"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="@dimen/td_size_54dp"
        android:layout_marginTop="@dimen/td_size_16dp">
        <ImageView
            android:id="@+id/bar_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/td_left_arrow_back"
            android:layout_marginStart="14.3dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="17sp"
            android:textColor="@color/s1"
            android:gravity="center_horizontal"
            android:id="@+id/bar_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lines="1"
            android:layout_marginStart="@dimen/td_size_10dp"
            android:layout_marginEnd="@dimen/td_size_10dp"
            android:letterSpacing="0.02"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/bar_back"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <include
        android:layout_gravity="bottom"
        android:id="@+id/me_rank"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/td_size_58dp"
        android:layout_marginStart="@dimen/td_size_1dp"
        android:layout_marginEnd="@dimen/td_size_1dp"
        layout="@layout/item_td_me_rank"/>
    <LinearLayout
        android:layout_gravity="bottom"
        android:background="@color/s38"
        android:padding="@dimen/td_size_10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:textSize="17.3sp"
            android:textColor="@color/s5"
            android:id="@+id/start_run"
            android:background="@drawable/td_btn_shape"
            android:layout_width="match_parent"
            android:layout_height="@dimen/td_size_38dp"
            android:text="@string/td_start_run"
            android:letterSpacing="0.02"/>
    </LinearLayout>
</FrameLayout>
