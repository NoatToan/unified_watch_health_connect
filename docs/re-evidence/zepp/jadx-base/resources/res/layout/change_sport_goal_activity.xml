<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/info_content_size"
        android:textColor="@color/s2"
        android:gravity="center"
        android:id="@+id/bracelet_title_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sport_goal_setting_title_info_margin_top"
        android:text="@string/person_info_goal_info"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp"/>
    <com.huami.widget.wheelview.WheelView
        android:id="@+id/person_info_goal_picker"
        android:layout_width="match_parent"
        android:layout_height="@dimen/wheel_hight_large"
        android:layout_centerInParent="true"
        android:layout_marginStart="@dimen/sport_goal_setting_margin_start_end"
        android:layout_marginEnd="@dimen/sport_goal_setting_margin_start_end"/>
    <Button
        android:id="@+id/change_sport_goal_confirm"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size_32dp"
        android:text="@string/confirm"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/size_15dp"
        android:layout_marginEnd="@dimen/size_15dp"
        style="@style/Rainbow.Widget.Button.48"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/personinfo_change_sport_goal_tip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:id="@+id/container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <View
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/personinfo_change_sport_goal_mask"
        android:background="@color/s38"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/personinfo_change_sport_goal_tip"
        android:alpha="0.85"/>
</RelativeLayout>
