<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/pale_grey_two"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="vertical"
            android:background="#f8f8f8"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="14.5dp"
            android:layout_marginBottom="14.5dp">
            <TextView
                android:textSize="15sp"
                android:textColor="#191919"
                android:id="@+id/alexa_text_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/alexa_pair_content_1"
                android:layout_marginStart="14.5dp"
                android:layout_marginEnd="14.5dp"/>
            <TextView
                android:textSize="15sp"
                android:textColor="#191919"
                android:id="@+id/alexa_text_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14.5dp"
                android:text="@string/alexa_pair_content_2"
                android:layout_marginStart="14.5dp"
                android:layout_marginEnd="14.5dp"/>
            <TextView
                android:textSize="15sp"
                android:textColor="#191919"
                android:id="@+id/alexa_text_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14.5dp"
                android:text="@string/alexa_pair_content_3"
                android:layout_marginStart="14.5dp"
                android:layout_marginEnd="14.5dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/alexa_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14.5dp"
                android:layout_marginStart="14.5dp"
                android:layout_marginEnd="14.5dp"
                android:elevation="4dp">
                <TextView
                    android:textSize="13sp"
                    android:textColor="#191919"
                    android:gravity="center_vertical"
                    android:background="@drawable/alexa_paired_bg_1"
                    android:layout_width="match_parent"
                    android:layout_height="43.2dp"
                    android:text="@string/alexa_pair_content_4"
                    android:paddingStart="14.5dp"
                    android:paddingEnd="14.5dp"/>
                <RelativeLayout
                    android:background="@drawable/alexa_paired_bg_2"
                    android:layout_width="match_parent"
                    android:layout_height="43.2dp">
                    <TextView
                        android:textSize="13sp"
                        android:textColor="#191919"
                        android:id="@+id/device_name_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="14.5dp"/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/alexa_settings"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="14.5dp"
                        android:layout_alignParentEnd="true"/>
                </RelativeLayout>
            </LinearLayout>
            <TextView
                android:textSize="15sp"
                android:textColor="#191919"
                android:id="@+id/alexa_text_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="@string/alexa_pair_content_5"
                android:layout_marginStart="14.5dp"
                android:layout_marginEnd="14.5dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/alexa_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14.5dp"
                android:layout_marginStart="14.5dp"
                android:layout_marginEnd="14.5dp"
                android:elevation="4dp">
                <RelativeLayout
                    android:background="@drawable/alexa_paired_bg_3"
                    android:layout_width="match_parent"
                    android:layout_height="43.2dp">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/alexa_back"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="14.5dp"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="#191919"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/alexa_pair_content_4"
                        android:layout_centerInParent="true"/>
                </RelativeLayout>
                <TextView
                    android:textSize="13sp"
                    android:textColor="#191919"
                    android:gravity="center_vertical"
                    android:background="#ffffff"
                    android:layout_width="match_parent"
                    android:layout_height="43.2dp"
                    android:layout_marginTop="14.5dp"
                    android:text="@string/alexa_pair_content_7"
                    android:paddingStart="14.5dp"
                    android:paddingEnd="14.5dp"/>
                <View
                    android:background="@drawable/alexa_paired_bg_4"
                    android:layout_width="match_parent"
                    android:layout_height="14.5dp"/>
            </LinearLayout>
            <TextView
                android:textSize="15sp"
                android:textColor="#191919"
                android:id="@+id/alexa_text_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="@string/alexa_pair_content_8"
                android:layout_marginStart="14.5dp"
                android:layout_marginEnd="14.5dp"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <RelativeLayout
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="80dp">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/go_to_bluetooth_setting_btn"
            android:background="@drawable/default_red_btn"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="9.6dp"
            android:text="@string/alexa_pair_content_9"
            android:layout_marginStart="14.5dp"
            android:layout_marginEnd="14.5dp"/>
    </RelativeLayout>
</LinearLayout>
