<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:id="@+id/task_item_head"
    android:background="@color/s38"
    android:layout_width="match_parent"
    android:layout_height="48dp">
    <TextView
        android:textSize="12sp"
        android:textColor="@color/s2"
        android:gravity="start|center_vertical"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:minWidth="70dp"
        android:singleLine="true"
        android:layout_marginStart="20dp"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/s1"
        android:gravity="center"
        android:id="@+id/tv_retry_all"
        android:background="@drawable/retry_upload_botton"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:minWidth="86dp"
        android:text="@string/file_manager_retry_all"
        android:layout_marginEnd="20dp"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
