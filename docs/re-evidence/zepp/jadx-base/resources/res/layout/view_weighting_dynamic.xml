<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="250dp">
    <com.xiaomi.hm.health.bodyfat.view.WeightChartView
        android:id="@+id/weight_chart"
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:layout_centerHorizontal="true"
        app:circleColor="@color/weighting_circle_color"
        app:edgeColor="@color/weighting_circle_edge_color"
        app:unFillColor="@color/weighting_circle_not_fill_color"
        app:weightFillColor="@color/weighting_circle_fill_color"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/weight_content_all"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/weight_overweight"
            android:background="@drawable/weight_overweight"
            android:visibility="gone"
            android:layout_width="108dp"
            android:layout_height="52dp"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/weight_low_power"
            android:background="@drawable/weight_low_power"
            android:visibility="gone"
            android:layout_width="108dp"
            android:layout_height="52dp"/>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/weight_number_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:layout_gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.huami.widget.typeface.TypefaceTextView
                    android:textSize="58sp"
                    android:textColor="@color/weighting_value_text_color"
                    android:ellipsize="none"
                    android:gravity="center"
                    android:id="@+id/number"
                    android:paddingTop="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:layout_centerInParent="true"
                    android:fontFamily="km"/>
                <TextView
                    android:textSize="12sp"
                    android:textStyle="normal"
                    android:textColor="@color/weighting_unit_text_color"
                    android:id="@+id/number_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="@string/unit_kg"
                    android:maxLines="1"
                    android:layout_alignBaseline="@+id/number"
                    android:layout_marginStart="2dp"
                    android:layout_toEndOf="@+id/number"/>
            </RelativeLayout>
            <RelativeLayout
                android:layout_gravity="center"
                android:id="@+id/weight_bmi_tips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-7dp">
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/s5"
                    android:id="@+id/bmi_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:layout_centerInParent="true"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/s5"
                    android:id="@+id/bmi_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toStartOf="@+id/bmi_number"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/s5"
                    android:id="@+id/bmi_standard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@+id/bmi_number"/>
            </RelativeLayout>
        </LinearLayout>
        <TextView
            android:textSize="12.7sp"
            android:textColor="@color/weighting_tip_text_color"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tips"
            android:layout_width="120dp"
            android:layout_height="wrap_content"/>
        <com.xiaomi.hm.health.bodyfat.view.FatMeasuringView
            android:layout_gravity="center"
            android:id="@+id/bodyfat_view"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8.7dp"/>
    </LinearLayout>
</RelativeLayout>
