<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/device_setting_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.lib.rainbow.ListTile
        android:id="@+id/firmware_version"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:itemDivider="normal"
        app:ltv_title="@string/mili_setting_fw_version"/>
    <com.huami.lib.rainbow.ListTile
        android:id="@+id/wifi_version"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:itemDivider="normal"
        app:ltv_title="Wi-Fi版本号"/>
    <com.huami.lib.rainbow.ListTile
        android:id="@+id/mac_address"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:itemDivider="normal"
        app:ltv_title="@string/mili_setting_mac_address"/>
</androidx.appcompat.widget.LinearLayoutCompat>
