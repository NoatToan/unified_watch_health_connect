<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:paddingBottom="30dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="30dp">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp">
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="24sp"
            android:textColor="@color/s1"
            android:id="@+id/text_distance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/step_text_empty_data"
            android:fontFamily="lt-bold"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textColor="@color/s2"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/step_text_amount_of_distance"
            style="@style/Rainbow.TextAppearance.Body5"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="24sp"
            android:textColor="@color/s1"
            android:id="@+id/text_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/step_text_empty_data"
            android:fontFamily="lt-bold"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textColor="@color/s2"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/step_text_amount_of_time"
            style="@style/Rainbow.TextAppearance.Body5"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/layout_total_cal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="12dp">
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="24sp"
            android:textColor="@color/s1"
            android:id="@+id/text_cal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/step_text_empty_data"
            android:fontFamily="lt-bold"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textColor="@color/s2"
            android:gravity="center"
            android:id="@+id/label_amount_cal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/step_text_amount_of_cal"
            style="@style/Rainbow.TextAppearance.Body5"/>
    </LinearLayout>
</LinearLayout>
