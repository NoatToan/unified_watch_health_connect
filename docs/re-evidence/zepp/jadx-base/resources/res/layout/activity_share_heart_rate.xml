<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:baseui="http://schemas.android.com/apk/res-auto"
    android:id="@+id/content_layout"
    android:fitsSystemWindows="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/share_bar_bg"
        android:background="@drawable/shape_share_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="300dp"/>
    <FrameLayout
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/common_title_height"
        android:layout_marginTop="20dp"
        android:paddingStart="12.6dp"
        android:paddingEnd="12.6dp">
        <Button
            android:layout_gravity="start|center_vertical"
            android:id="@+id/back_button"
            android:background="@drawable/ic_arrow_back_20"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:scaleType="centerInside"
            android:backgroundTint="@color/s1"/>
    </FrameLayout>
    <com.huami.lib.view.image.CircleImageView
        android:id="@+id/user_avatar"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_marginTop="20dp"
        android:src="@drawable/setting_avatar_default"
        android:layout_below="@+id/title_bar"
        android:layout_centerHorizontal="true"
        baseui:civ_border_color="@color/white_60"
        baseui:civ_border_width="1.3dp"
        baseui:civ_fill_color="@color/white60"
        baseui:hm_civ_border_color_touch="@color/origin100"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/user_nickname"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_below="@+id/user_avatar"
        android:layout_centerHorizontal="true"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="42dp"
        android:text="@string/hr_heartrate"
        android:layout_below="@+id/user_nickname"
        android:layout_centerHorizontal="true"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="48sp"
        android:textColor="@color/s1"
        android:id="@+id/value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_below="@+id/title"
        android:layout_centerHorizontal="true"
        android:fontFamily="km"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/s2"
        android:gravity="bottom"
        android:paddingBottom="11dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        android:text="@string/unit_hr"
        android:layout_below="@+id/title"
        android:layout_alignBottom="@+id/value"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="3.3dp"
        android:layout_toEndOf="@+id/value"/>
    <TextView
        android:textColor="@color/s2"
        android:id="@+id/date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_below="@+id/value"
        android:layout_centerHorizontal="true"
        style="@style/Rainbow.TextAppearance.Body5"/>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="81dp"
        android:src="@drawable/share_heart_rate_img"
        android:layout_below="@+id/date"
        android:layout_centerHorizontal="true"/>
    <RelativeLayout
        android:gravity="center"
        android:id="@+id/share_logo"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="@dimen/running_share_pane_margin"
        android:layout_alignParentBottom="true">
        <ImageView
            android:gravity="center"
            android:id="@+id/tv_logo"
            android:layout_width="130dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_share_logo"/>
    </RelativeLayout>
    <FrameLayout
        android:id="@+id/share_pane_container"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
