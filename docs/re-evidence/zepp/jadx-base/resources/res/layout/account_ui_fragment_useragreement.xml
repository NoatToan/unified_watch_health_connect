<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/account_ui_trans"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/account_ui_dialog_empty_area"/>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/account_ui_dialog_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/account_ui_main_ui_dialog_title_size"
                android:textColor="@color/s2"
                android:id="@+id/user_agreement_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="@string/account_ui_user_agreement_title"
                android:layout_marginStart="42dp"
                android:layout_marginEnd="42dp"/>
            <TextView
                android:textSize="@dimen/account_ui_info_content_size"
                android:textColor="@color/s1"
                android:gravity="start"
                android:id="@+id/useragreement_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="15dp"
                android:layout_marginStart="40dp"
                android:layout_marginEnd="40dp"/>
            <LinearLayout
                android:gravity="center"
                android:id="@+id/useragreement_ux_ll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="31dp"
                android:layout_marginStart="40dp"
                android:layout_marginEnd="40dp">
                <CheckBox
                    android:id="@+id/useragreement_ux_checkbox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    style="@style/CheckboxStyle"/>
                <TextView
                    android:textSize="@dimen/account_ui_info_content_size"
                    android:textColor="@color/s1"
                    android:id="@+id/useragreement_ux"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/account_ui_user_agreement_ux"/>
            </LinearLayout>
        </LinearLayout>
        <View
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <LinearLayout
            android:orientation="horizontal"
            android:background="@color/account_ui_trans"
            android:layout_width="match_parent"
            android:layout_height="@dimen/account_ui_item_height_max">
            <TextView
                android:textSize="@dimen/account_ui_person_info_setting_text_size"
                android:textColor="@color/s1"
                android:gravity="center"
                android:id="@+id/useragreement_btn_cancel"
                android:background="@drawable/account_ui_btn_click_bg_round_dialog_bottom_left"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/account_ui_exit_app"
                android:layout_weight="1"/>
            <View
                android:background="@color/s4"
                android:layout_width="1px"
                android:layout_height="match_parent"/>
            <TextView
                android:textSize="@dimen/account_ui_person_info_setting_text_size"
                android:textColor="@color/s1"
                android:gravity="center"
                android:id="@+id/useragreement_btn_save"
                android:background="@drawable/account_ui_btn_click_bg_round_dialog_bottom_right"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/account_ui_agree"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
