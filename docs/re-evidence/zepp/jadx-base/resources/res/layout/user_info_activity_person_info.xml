<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:baseui="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/account_ui_bg_2022"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:background="@color/user_info_trans"
        android:layout_width="match_parent"
        android:layout_height="@dimen/user_info_person_info_head_height">
        <RelativeLayout
            android:id="@+id/person_info_mine_head"
            android:layout_width="match_parent"
            android:layout_height="@dimen/user_info_person_info_head_bg_height"
            android:layout_alignParentTop="true"/>
        <RelativeLayout
            android:id="@+id/person_info_avatar_rl"
            android:background="@color/user_info_trans"
            android:layout_width="@dimen/user_info_person_avatar_size"
            android:layout_height="@dimen/user_info_person_avatar_size"
            android:layout_marginTop="@dimen/user_info_person_avatar_margin_top"
            android:layout_centerHorizontal="true">
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                baseui:cardCornerRadius="44dp"
                baseui:cardElevation="0dp">
                <com.huami.lib.view.image.CircleImageView
                    android:id="@+id/person_info_avatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/setting_avatar_default"
                    baseui:civ_border_color="@color/s3"
                    baseui:civ_border_width="1.3dp"
                    baseui:civ_fill_color="@color/s3"
                    baseui:hm_civ_mask_color="@color/s3"
                    baseui:hm_civ_show_mask="true"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:layout_gravity="bottom"
                    android:id="@+id/tv_avatar_in_audit"
                    android:background="#191919"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/account_ui_in_audit"
                    android:alpha="0.5"/>
            </androidx.cardview.widget.CardView>
            <ImageView
                android:layout_width="@dimen/user_info_person_info_camera"
                android:layout_height="@dimen/user_info_person_info_camera"
                android:src="@drawable/user_info_setting_camera"
                android:layout_alignParentBottom="true"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <TextView
            android:textSize="@dimen/user_info_person_info_head_id_text_size"
            android:textColor="@color/s1"
            android:id="@+id/person_info_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/user_info_person_info_head_id_margin_top"
            android:layout_below="@+id/person_info_avatar_rl"
            android:layout_centerInParent="true"/>
        <TextView
            android:textSize="@dimen/account_ui_size_12sp"
            android:textColor="@color/s5"
            android:id="@+id/person_info_unauthorized"
            android:background="@drawable/user_info_btn_unauthorized_bg_round"
            android:paddingTop="@dimen/user_info_size_1dp"
            android:paddingBottom="@dimen/user_info_size_1dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/user_info_size_4dp"
            android:text="@string/user_info_unautorize_tip"
            android:layout_below="@+id/person_info_id"
            android:layout_centerInParent="true"
            android:paddingStart="@dimen/user_info_size_6dp"
            android:paddingEnd="@dimen/user_info_size_6dp"/>
        <TextView
            android:textSize="@dimen/user_info_person_info_head_info_text_size"
            android:textColor="@color/s2"
            android:gravity="center_vertical"
            android:background="@color/s38"
            android:layout_width="match_parent"
            android:layout_height="@dimen/user_info_person_info_head_info_height"
            android:text="@string/user_info_person_info_head_info"
            android:layout_alignParentBottom="true"
            android:paddingStart="@dimen/common_item_padding"
            android:paddingEnd="@dimen/common_item_padding"/>
        <View
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/user_info_person_info_item_margin"
            android:layout_marginEnd="@dimen/common_item_padding"/>
    </RelativeLayout>
    <ListView
        android:id="@+id/person_info_list"
        android:background="@color/s38"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="@null"
        android:dividerHeight="0dp"/>
    <View
        android:background="@color/s4"
        android:layout_width="match_parent"
        android:layout_height="0.33dp"/>
</LinearLayout>
