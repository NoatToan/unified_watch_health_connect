<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/content_layout"
    android:fitsSystemWindows="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/share_bar_bg"
        android:background="@drawable/shape_share_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="300dp"/>
    <RelativeLayout
        android:id="@+id/share_bg_rl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:id="@+id/title_bar_back"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="@dimen/common_title_height"
            android:layout_height="@dimen/common_title_height"
            android:layout_marginTop="24dp"
            android:paddingStart="12.6dp"
            android:paddingEnd="12.6dp">
            <Button
                android:layout_gravity="start|center_vertical"
                android:id="@+id/back_button"
                android:background="@drawable/ic_arrow_back_20"
                android:clickable="false"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:scaleType="centerInside"
                android:backgroundTint="@color/s1"/>
        </FrameLayout>
        <RelativeLayout
            android:id="@+id/share_top"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="21dp"
            android:layout_below="@+id/title_bar_back">
            <com.huami.lib.view.image.CircleImageView
                android:id="@+id/share_icon"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:src="@drawable/setting_avatar_default"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                app:civ_border_color="@color/white_60"
                app:civ_border_width="1.3dp"
                app:civ_fill_color="@color/white60"
                app:hm_civ_border_color_touch="@color/origin100"/>
            <ImageView
                android:id="@+id/share_achieve_mark_view"
                android:visibility="gone"
                android:layout_width="86dp"
                android:layout_height="86dp"
                android:layout_marginTop="-3.2dp"
                android:src="@drawable/img_avatar_frame"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textColor="@color/s1"
                android:id="@+id/share_username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_below="@+id/share_icon"
                android:layout_centerHorizontal="true"
                style="@style/Rainbow.TextAppearance.Body4"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="191dp"
            android:layout_below="@+id/share_top">
            <ImageView
                android:id="@+id/share_left_arrow"
                android:background="@drawable/right_arrow_icon"
                android:visibility="gone"
                android:layout_width="22.6dp"
                android:layout_height="22.6dp"
                android:layout_marginTop="80dp"
                android:layout_alignParentTop="true"
                android:layout_marginStart="26.6dp"
                android:layout_alignParentStart="true"/>
            <ImageView
                android:id="@+id/share_right_arrow"
                android:background="@drawable/right_arrow_icon"
                android:visibility="gone"
                android:layout_width="22.6dp"
                android:layout_height="22.6dp"
                android:layout_marginTop="80dp"
                android:layout_alignParentTop="true"
                android:layout_marginEnd="26.6dp"
                android:layout_alignParentEnd="true"/>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_toStartOf="@+id/share_right_arrow"
                android:layout_toEndOf="@+id/share_left_arrow">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/s1"
                    android:id="@+id/share_value_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:layout_alignParentTop="true"
                    android:layout_centerHorizontal="true"/>
                <RelativeLayout
                    android:id="@+id/share_value_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_below="@+id/share_value_title"
                    android:layout_centerHorizontal="true">
                    <com.huami.lib.view.text.UnitTextView
                        android:textSize="48sp"
                        android:textColor="@color/s1"
                        android:id="@+id/unit_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        app:typeface="km"
                        app:unitColor="@color/s2"
                        app:unitSize="12sp"/>
                    <ImageView
                        android:id="@+id/share_weight_icon"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="3dp"
                        android:layout_toStartOf="@+id/unit_text"/>
                </RelativeLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_below="@+id/share_value_layout"
                    android:layout_centerHorizontal="true">
                    <TextView
                        android:textColor="@color/s2"
                        android:id="@+id/share_value_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Rainbow.TextAppearance.Body5"/>
                </LinearLayout>
            </RelativeLayout>
        </RelativeLayout>
    </RelativeLayout>
    <View
        android:id="@+id/share_divider_line"
        android:background="@color/white_20_percent"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider"
        android:layout_below="@+id/share_bg_rl"
        android:layout_marginStart="23.3dp"
        android:layout_marginEnd="23.3dp"/>
    <ToggleButton
        android:textColor="@color/s20"
        android:id="@+id/share_hidden_icon"
        android:background="@drawable/share_weight_button_shape"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginTop="-20dp"
        android:checked="true"
        android:textOn="@string/share_weight_hidden_tip"
        android:textOff="@string/share_weight_show_tip"
        android:maxLines="1"
        android:drawablePadding="5.3dp"
        android:layout_below="@+id/share_bg_rl"
        android:layout_centerHorizontal="true"
        style="@style/Rainbow.TextAppearance.Body5"/>
    <View
        android:id="@+id/value_bg"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/share_divider_line"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/share_detail_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/share_pane_container"
        android:layout_below="@+id/share_divider_line">
        <com.xiaomi.hm.health.view.ShareItemView
            android:layout_gravity="center"
            android:id="@+id/first_item"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <View
            android:layout_gravity="center_vertical"
            android:background="@color/s4"
            android:layout_width="@dimen/divider"
            android:layout_height="41dp"/>
        <com.xiaomi.hm.health.view.ShareItemView
            android:layout_gravity="center"
            android:id="@+id/second_item"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <View
            android:layout_gravity="center_vertical"
            android:background="@color/s4"
            android:layout_width="@dimen/divider"
            android:layout_height="41dp"/>
        <com.xiaomi.hm.health.view.ShareItemView
            android:layout_gravity="center"
            android:id="@+id/third_item"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <RelativeLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/weight_item"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="90dp"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/icon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/icon_share_figure_s3"
                android:layout_centerHorizontal="true"/>
            <com.huami.lib.view.text.UnitTextView
                android:textSize="16sp"
                android:textColor="@color/s1"
                android:ellipsize="marquee"
                android:id="@+id/weight_item_value"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5.1dp"
                android:singleLine="true"
                android:layout_below="@+id/icon"
                android:layout_centerHorizontal="true"
                app:typeface="km"
                app:unitColor="@color/black"
                app:unitSize="16sp"/>
            <TextView
                android:textColor="@color/s2"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/share_weight_figure"
                android:layout_below="@+id/weight_item_value"
                android:layout_centerHorizontal="true"
                style="@style/Rainbow.TextAppearance.Body5"/>
        </RelativeLayout>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/continue_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-40dp"
        android:layout_below="@+id/share_bg_rl">
        <TextView
            android:textSize="18sp"
            android:textColor="@color/s2"
            android:id="@+id/continue_dot_line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/share_line"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/s2"
            android:id="@+id/continue_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:layout_marginEnd="5dp"
            android:layout_toStartOf="@+id/continue_dot_line"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/s2"
            android:id="@+id/continue_stop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:layout_marginStart="5dp"
            android:layout_toEndOf="@+id/continue_dot_line"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="58.7dp"
            android:src="@drawable/share_contine_not_img"
            android:layout_below="@+id/continue_stop"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:gravity="center"
        android:id="@+id/share_logo"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="@dimen/running_share_pane_margin"
        android:layout_marginBottom="10dp"
        android:layout_alignParentBottom="true">
        <ImageView
            android:gravity="center"
            android:id="@+id/tv_logo"
            android:layout_width="130dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_share_logo"/>
    </RelativeLayout>
    <FrameLayout
        android:id="@+id/share_pane_container"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
