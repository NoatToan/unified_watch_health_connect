<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/shape_rect_white_corner_6"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/heart_reta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/heart_section"
        android:layout_marginStart="14dp"
        style="@style/Rainbow.TextAppearance.Body3"/>
    <ImageView
        android:visibility="invisible"
        android:layout_width="19dp"
        android:layout_height="19dp"
        android:layout_marginTop="14dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="@dimen/d1"
        android:layout_toEndOf="@+id/heart_reta"
        app:srcCompat="@drawable/ic_tips_20_s2"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/sport_detail_hr_section_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        android:layout_below="@+id/heart_reta"/>
</RelativeLayout>
