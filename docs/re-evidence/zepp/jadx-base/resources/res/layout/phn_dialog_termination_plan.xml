<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/phn_shape_corners_top"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textColor="@color/s1"
        android:gravity="center"
        android:id="@+id/tv_termination_plan_reason_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:text="@string/phn_termination_plan_reason_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Rainbow.TextAppearance.Title2"/>
    <TextView
        android:textColor="@color/s1"
        android:gravity="center"
        android:id="@+id/tv_termination_plan_reason_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/phn_termination_plan_reason_desc"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_termination_plan_reason_title"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <View
        android:id="@+id/view_line"
        android:background="@color/s4"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="22dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_termination_plan_reason_desc"/>
    <RadioGroup
        android:orientation="vertical"
        android:id="@+id/rg_termination_plan_reason_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_line">
        <RadioButton
            android:id="@+id/rb_reason_first"
            android:text="@string/phn_termination_plan_reason_first"
            style="@style/phn_ui.NounExplain.RadioButton"/>
        <RadioButton
            android:id="@+id/rb_reason_second"
            android:text="@string/phn_termination_plan_reason_second"
            style="@style/phn_ui.NounExplain.RadioButton"/>
        <RadioButton
            android:id="@+id/rb_reason_third"
            android:text="@string/phn_termination_plan_reason_third"
            style="@style/phn_ui.NounExplain.RadioButton"/>
        <RadioButton
            android:id="@+id/rb_reason_other"
            android:text="@string/phn_termination_plan_reason_other"
            style="@style/phn_ui.NounExplain.RadioButton"/>
    </RadioGroup>
    <androidx.appcompat.widget.AppCompatEditText
        android:textColor="@color/s1"
        android:textColorHint="@color/s3"
        android:gravity="top|left"
        android:id="@+id/et_other"
        android:background="@drawable/phn_shape_edit_background"
        android:padding="10dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:hint="@string/phn_termination_plan_reason_other_edit_hint"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rg_termination_plan_reason_list"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <LinearLayout
        android:orientation="horizontal"
        android:background="@color/s4"
        android:paddingTop="16dp"
        android:paddingBottom="35dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        app:layout_constraintTop_toBottomOf="@+id/et_other">
        <TextView
            android:textColor="@color/s2"
            android:gravity="center"
            android:id="@+id/tv_reason_jump_over"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/phn_termination_plan_reason_jump_over"
            android:layout_weight="1"
            style="@style/Rainbow.TextAppearance.Body3"/>
        <TextView
            android:textColor="@color/s2"
            android:gravity="center"
            android:id="@+id/tv_reason_submit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/phn_termination_plan_reason_submit"
            android:layout_weight="1"
            style="@style/Rainbow.TextAppearance.Body3"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
