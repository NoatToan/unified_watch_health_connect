<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/account_ui_trans"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/account_ui_dialog_empty_area"/>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/account_ui_dialog_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/account_ui_main_ui_dialog_title_size"
            android:textColor="@color/s1"
            android:gravity="center"
            android:id="@+id/account_error_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="@string/account_ui_account_frozen"
            android:layout_marginStart="42dp"
            android:layout_marginEnd="42dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/s2"
            android:gravity="center"
            android:id="@+id/account_error_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/s2"
            android:gravity="start"
            android:id="@+id/account_error_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="30dp"
            android:text="@string/account_ui_account_frozen_need_guardian_agree_content"
            android:layout_marginStart="25dp"
            android:layout_marginEnd="25dp"/>
        <View
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/account_error_double"
            android:background="@color/account_ui_trans"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/account_ui_item_height_max">
            <TextView
                android:textSize="@dimen/account_ui_person_info_setting_text_size"
                android:textColor="@color/s1"
                android:gravity="center"
                android:id="@+id/account_error_exit"
                android:background="@drawable/account_ui_btn_click_bg_round_dialog_bottom_left"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/account_ui_exit"
                android:layout_weight="1"/>
            <View
                android:background="@color/s4"
                android:layout_width="1px"
                android:layout_height="match_parent"/>
            <TextView
                android:textSize="@dimen/account_ui_person_info_setting_text_size"
                android:textColor="@color/s1"
                android:gravity="center"
                android:id="@+id/account_error_setting"
                android:background="@drawable/account_ui_btn_click_bg_round_dialog_bottom_right"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/account_ui_gpdr_login_locked_need_granted"
                android:layout_weight="1"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/account_ui_person_info_setting_text_size"
            android:textColor="@color/s1"
            android:gravity="center"
            android:id="@+id/account_error_got_it"
            android:background="@drawable/account_ui_btn_bottom_radius"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/account_ui_item_height_max"
            android:text="@string/account_ui_got_it"/>
    </LinearLayout>
</LinearLayout>
