<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/s36"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/search_view"
        android:background="@color/s3"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@color/s38"
        android:padding="@dimen/size_15dp"
        android:layout_width="match_parent"
        android:layout_height="67dp">
        <EditText
            android:textColor="@color/s1"
            android:textColorHint="@color/s3"
            android:id="@+id/et_search"
            android:background="@drawable/access_selector_search_community"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingStart="@dimen/size_10dp"
            android:paddingEnd="@dimen/size_10dp"/>
        <TextView
            android:textSize="@dimen/size_15sp"
            android:textColor="@color/s1"
            android:id="@+id/tv_search"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/access_door_search_text"
            android:layout_weight="0"
            android:layout_marginStart="@dimen/size_15dp"/>
    </LinearLayout>
    <View
        android:id="@+id/search_view_1"
        android:background="@color/s4"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_10dp"/>
    <TextView
        android:textSize="@dimen/size_12sp"
        android:textColor="@color/s3"
        android:id="@+id/tv_community_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_15dp"
        android:text=""
        android:layout_marginStart="@dimen/size_15dp"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="@dimen/size_15dp"
        android:layout_marginStart="@dimen/size_15dp"
        android:layout_marginEnd="@dimen/size_15dp"/>
</LinearLayout>
