<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/segment_dialog_empty_area"/>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/running_detail_shape_rect_white_corner_6"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textColor="@color/s1"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="@dimen/segment_setting_title_height"
            android:text="@string/modify_count"
            style="@style/Rainbow.TextAppearance.Title2"/>
        <View
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/wheel_hight">
            <com.huami.widget.wheelview.WheelView
                android:id="@+id/info_height_foot_wheel"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
            <View
                android:id="@+id/wheel_split_line"
                android:background="@color/s4"
                android:visibility="gone"
                android:layout_width="1px"
                android:layout_height="match_parent"/>
            <com.huami.widget.wheelview.WheelView
                android:id="@+id/info_height_wheel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"/>
        </LinearLayout>
        <View
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <LinearLayout
            android:orientation="horizontal"
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_height_max">
            <TextView
                android:textColor="@color/s2"
                android:gravity="center"
                android:id="@+id/height_btn_cancel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/running_btn_continue"
                android:layout_weight="1"
                style="@style/Rainbow.TextAppearance.Body3"/>
            <TextView
                android:textColor="@color/s1"
                android:gravity="center"
                android:id="@+id/height_btn_save"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/running_btn_confirm"
                android:layout_weight="1"
                style="@style/Rainbow.TextAppearance.Body3"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
