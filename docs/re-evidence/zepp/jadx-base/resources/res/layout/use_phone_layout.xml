<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/pale_grey_two"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="20sp"
        android:textColor="@color/black80"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/text_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="98dp"
        android:text="@string/use_phone_tips1"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/black60"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:text="@string/use_phone_tips2"
        android:layout_below="@+id/text_tips"
        android:layout_centerHorizontal="true"/>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="82dp"
        android:src="@drawable/img_phone"
        android:layout_below="@+id/subtitle"
        android:layout_centerHorizontal="true"/>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="136dp"
        android:src="@drawable/img_steps"
        android:layout_below="@+id/subtitle"
        android:layout_centerHorizontal="true"
        android:alpha="0.5"/>
    <TextView
        android:id="@+id/gotIt"
        android:text="@string/got_it"
        style="@style/BottomTextStyle"/>
</RelativeLayout>
