<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.lib.rainbow.titlebar.RainbowTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        app:menuText="@string/use"
        app:navigationIcon="@drawable/ic_arrow_back_20_2x"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/header"
        android:background="@color/s36"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:layout_below="@+id/title_bar">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/s3"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/input_heart_value_hint"
            android:lineSpacingExtra="6sp"
            android:paddingStart="20dp"/>
        <View
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"/>
        <RelativeLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/resting_heart_area"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/s1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/resting_heart_rate"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/s3"
                android:id="@+id/resting_heart_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/training_click_setting"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/title_area"
        android:background="@color/s36"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_below="@+id/header"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/s1"
            android:id="@+id/region_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/reserve_heart_region"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/p4"
            android:id="@+id/reset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/reset_heart"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <ScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="0.7dp"
        android:fillViewport="true"
        android:layout_below="@+id/title_area">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:background="@color/s36"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.huami.watch.companion.ui.view.HeartTypeView
                    android:gravity="center_vertical"
                    android:id="@+id/area1"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="30dp"/>
                <View
                    android:background="@color/s4"
                    android:layout_width="0.7dp"
                    android:layout_height="8dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="6dp"
                    android:layout_marginStart="56dp"/>
                <com.huami.watch.companion.ui.view.HeartTypeView
                    android:gravity="center_vertical"
                    android:id="@+id/area2"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"/>
                <View
                    android:background="@color/s4"
                    android:layout_width="0.7dp"
                    android:layout_height="8dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="6dp"
                    android:layout_marginStart="56dp"/>
                <com.huami.watch.companion.ui.view.HeartTypeView
                    android:gravity="center_vertical"
                    android:id="@+id/area3"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"/>
                <View
                    android:background="@color/s4"
                    android:layout_width="0.7dp"
                    android:layout_height="8dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="6dp"
                    android:layout_marginStart="56dp"/>
                <com.huami.watch.companion.ui.view.HeartTypeView
                    android:gravity="center_vertical"
                    android:id="@+id/area4"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"/>
                <View
                    android:background="@color/s4"
                    android:layout_width="0.7dp"
                    android:layout_height="8dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="6dp"
                    android:layout_marginStart="56dp"/>
                <com.huami.watch.companion.ui.view.HeartTypeView
                    android:gravity="center_vertical"
                    android:id="@+id/area5"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"/>
                <View
                    android:background="@color/s4"
                    android:layout_width="0.7dp"
                    android:layout_height="8dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="6dp"
                    android:layout_marginStart="56dp"/>
                <com.huami.watch.companion.ui.view.HeartTypeView
                    android:gravity="center_vertical"
                    android:id="@+id/area6"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginBottom="50dp"/>
            </LinearLayout>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/s3"
                android:id="@+id/tips"
                android:paddingTop="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/edit_heart_tips"
                android:lineSpacingExtra="6sp"
                android:paddingStart="40dp"
                android:paddingEnd="20dp"/>
        </LinearLayout>
    </ScrollView>
    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
