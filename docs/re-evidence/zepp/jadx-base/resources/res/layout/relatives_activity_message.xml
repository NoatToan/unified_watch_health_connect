<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/logo_bracelet"
        android:layout_width="@dimen/relatives_size_68dp"
        android:layout_height="@dimen/relatives_size_68dp"
        android:src="@drawable/relatives_ic_message_email"
        android:layout_above="@+id/no_data_refresh"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/s2"
        android:gravity="center"
        android:id="@+id/no_data_refresh"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/relatives_size_35dp"
        android:layout_marginTop="@dimen/relatives_size_10dp"
        android:layout_marginBottom="@dimen/relatives_size_10dp"
        android:text="@string/relatives_label_message_empty"
        android:layout_centerInParent="true"/>
    <ListView
        android:id="@+id/message_list"
        android:background="@color/s10"
        android:visibility="gone"
        android:scrollbars="none"
        android:fadingEdge="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:listSelector="@android:color/transparent"
        android:cacheColorHint="#00000000"
        android:divider="@drawable/relatives_friend_notice_msg_divider"
        android:dividerHeight="@dimen/relatives_size_1dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentBottom="true"
        android:fastScrollEnabled="false"
        android:headerDividersEnabled="false"
        android:footerDividersEnabled="false"
        android:smoothScrollbar="true"/>
    <TextView
        android:textSize="@dimen/relatives_font_size_f3"
        android:textColor="@color/s5"
        android:gravity="center"
        android:layout_gravity="top"
        android:id="@+id/toast_view"
        android:background="@color/relatives_color_aa2086b4"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/relatives_size_36dp"
        android:text="@string/relatives_label_message_too_busy"/>
</RelativeLayout>
