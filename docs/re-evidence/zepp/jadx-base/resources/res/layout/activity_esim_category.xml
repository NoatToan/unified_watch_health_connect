<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:scrollbars="none"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.huami.lib.rainbow.titlebar.RainbowTitleBar
            android:id="@+id/actionbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:title="@string/esim_add_account"/>
        <TextView
            android:textSize="13.4sp"
            android:textStyle="bold"
            android:textColor="@color/s1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="9.7dp"
            android:text="@string/esim_open_online"
            android:layout_marginStart="7.7dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/online_share"
            android:background="@drawable/bg_esim_round_category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginStart="7.7dp"
            android:layout_marginEnd="7.7dp">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28.7dp"
                android:src="@drawable/ic_esim_category_first"/>
            <TextView
                android:textSize="13.3sp"
                android:textStyle="bold"
                android:textColor="@color/s1"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="32dp"
                android:text="@string/esim_share_phone_number"
                android:drawablePadding="7dp"
                android:lineSpacingExtra="0sp"
                android:drawableEnd="@drawable/ic_esim_right_arrow"
                app:drawableTint="@color/s1"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/online_separate"
            android:background="@drawable/bg_esim_round_category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9.3dp"
            android:layout_marginStart="7.7dp"
            android:layout_marginEnd="7.7dp">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28.7dp"
                android:src="@drawable/ic_esim_category_second"/>
            <TextView
                android:textSize="13.3sp"
                android:textStyle="bold"
                android:textColor="@color/s1"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="32dp"
                android:text="@string/esim_separate_phone_number"
                android:drawablePadding="7dp"
                android:lineSpacingExtra="0sp"
                android:drawableEnd="@drawable/ic_esim_right_arrow"
                app:drawableTint="@color/s1"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9.7dp">
            <TextView
                android:textSize="13.4sp"
                android:textStyle="bold"
                android:textColor="@color/s1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/esim_open_offline"
                android:layout_marginStart="7.7dp"/>
            <TextView
                android:textSize="11.3sp"
                android:textColor="@color/s2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/esim_business_hall"
                android:lineSpacingExtra="6sp"
                android:layout_marginStart="10dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/offline"
            android:background="@drawable/bg_esim_round_category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9.3dp"
            android:layout_marginStart="7.7dp"
            android:layout_marginEnd="7.7dp">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28.7dp"
                android:src="@drawable/ic_esim_category_third"/>
            <TextView
                android:textSize="13.3sp"
                android:textStyle="bold"
                android:textColor="@color/s1"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="32dp"
                android:text="@string/esim_business_hall_scan_qr"
                android:drawablePadding="7dp"
                android:lineSpacingExtra="0sp"
                android:drawableEnd="@drawable/ic_esim_right_arrow"
                app:drawableTint="@color/s1"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
