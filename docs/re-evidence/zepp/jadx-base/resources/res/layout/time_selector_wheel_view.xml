<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/transparent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:background="@drawable/bg_dialog_shape"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size_15dp"
        android:layout_marginStart="@dimen/size_15dp"
        android:layout_marginEnd="@dimen/size_15dp"
        app:divider="@drawable/dividing_line_vertical_shape"
        app:showDividers="middle">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/s1"
            android:gravity="center"
            android:id="@+id/time_selector_title"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_60dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.huami.widget.wheelview.WheelView
                android:id="@+id/wheelView_am_pm"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
            <Space
                android:id="@+id/space1"
                android:visibility="gone"
                android:layout_width="@dimen/size_0.5dp"
                android:layout_height="match_parent"
                android:layout_weight="0.4"/>
            <com.huami.widget.wheelview.WheelView
                android:id="@+id/wheelView_hour"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <Space
                android:id="@+id/space3"
                android:visibility="gone"
                android:layout_width="@dimen/size_0.5dp"
                android:layout_height="match_parent"
                android:layout_weight="0.2"/>
            <com.huami.widget.wheelview.WheelView
                android:id="@+id/wheelView_minute"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <Space
                android:id="@+id/space2"
                android:visibility="gone"
                android:layout_width="@dimen/size_0.5dp"
                android:layout_height="match_parent"
                android:layout_weight="0.4"/>
        </LinearLayout>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="horizontal"
            android:paddingTop="@dimen/size_18dp"
            android:paddingBottom="@dimen/size_18dp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            app:divider="@drawable/dividing_line_shape"
            app:showDividers="middle">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/s2"
                android:gravity="center"
                android:id="@+id/btn_cancel"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/size_24dp"
                android:text="@string/cancel"
                android:layout_weight="1"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/s1"
                android:gravity="center"
                android:id="@+id/btn_yes"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/size_24dp"
                android:text="@string/yes"
                android:layout_weight="1"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>
</FrameLayout>
