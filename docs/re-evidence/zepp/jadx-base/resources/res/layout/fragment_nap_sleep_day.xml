<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s10"
    android:paddingBottom="55dp"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/head"
        android:background="@color/s38"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/selectInfoLL"
            android:padding="7dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/s2"
                android:id="@+id/sleepType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sporadic_sleep"/>
            <com.huami.sleep.view.UnitTextView
                android:textSize="40sp"
                android:textColor="@color/s1"
                android:id="@+id/duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                app:typeface="km"
                app:unitColor="@color/s2"
                app:unitSize="13sp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/s2"
                android:id="@+id/date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <View
            android:id="@+id/belowTipLine"
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="7dp"
            android:layout_marginRight="15dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/selectInfoLL"/>
        <View
            android:id="@+id/line"
            android:background="@color/s4"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="50dp"
            android:layout_marginRight="15dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/belowTipLine"/>
        <com.huami.sleep.napsleep.view.SleepDayChartView
            android:id="@+id/day_chart"
            android:layout_width="match_parent"
            android:layout_height="162dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/belowTipLine"/>
        <RelativeLayout
            android:id="@+id/timeLayout"
            android:paddingLeft="15dp"
            android:paddingRight="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/day_chart">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/s3"
                android:id="@+id/start_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/s3"
                android:id="@+id/end_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <View
            android:id="@+id/belowChartLine"
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/timeLayout"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.huami.sleep.daysleep.sleepstagechart.ui.view.SleepStageInfoView
        android:id="@+id/sleep_duration"
        android:background="@color/s38"
        android:paddingLeft="@dimen/slp_size_15dp"
        android:paddingRight="@dimen/slp_size_15dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/head"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/rationLL"
        android:background="@drawable/sleep_main_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sleep_duration">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="64dp">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/s1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sleep_deep_ratio"
                android:layout_centerVertical="true"
                android:layout_marginStart="15dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/s2"
                android:id="@+id/nap_deep_ratio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginEnd="15dp"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="64dp">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/s1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sleep_light_ratio"
                android:layout_centerVertical="true"
                android:layout_marginStart="15dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/s2"
                android:id="@+id/nap_light_ratio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginEnd="15dp"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/sleep_record"
        android:background="@drawable/sleep_main_bg"
        android:paddingTop="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/slp_size_15dp"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rationLL">
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/s1"
            android:id="@+id/sleep_record_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sporadic_sleep_record"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcv_record"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/sleep_record_title"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/sleep_main_bg"
        android:padding="@dimen/slp_size_15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/slp_size_15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sleep_record">
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="@dimen/slp_size_18sp"
            android:textStyle="bold"
            android:textColor="@color/s1"
            android:id="@+id/tips_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sporadic_sleep"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="13sp"
            android:textColor="@color/s2"
            android:id="@+id/tips_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/slp_size_15dp"
            android:text="@string/sporadic_sleep_tips"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tips_title"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="13sp"
            android:textColor="@color/s2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/nap_sleep_tips_2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tips_1"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
