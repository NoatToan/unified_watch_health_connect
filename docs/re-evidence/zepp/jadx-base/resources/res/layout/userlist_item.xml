<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="55dp"
    android:layout_height="149.3dp">
    <com.huami.lib.view.image.HMCircleImageView
        android:id="@+id/user_icon"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:layout_marginTop="42dp"
        android:src="@drawable/setting_avatar_default"
        android:layout_centerHorizontal="true"
        app:civ_border_color="@color/s3"
        app:civ_border_width="1.3dp"
        app:civ_fill_color="@color/s3"
        app:hm_civ_border_color_touch="@color/s30"/>
    <TextView
        android:textSize="11.3sp"
        android:textColor="@color/s2"
        android:gravity="center"
        android:id="@+id/user_list_item_name"
        android:layout_width="55dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_below="@+id/user_icon"/>
</RelativeLayout>
