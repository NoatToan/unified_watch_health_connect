<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/root_view"
    android:background="@color/s36"
    android:focusable="true"
    android:fitsSystemWindows="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/title_view"
        android:layout_width="match_parent"
        android:layout_height="48dp">
        <ImageButton
            android:id="@+id/ib_back"
            android:background="@null"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_arrow_back_20_2x"/>
        <TextView
            android:textSize="17sp"
            android:textColor="@color/s1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_choose_body_measure_mode"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <Button
        android:textColor="@color/s1"
        android:layout_gravity="center_horizontal"
        android:id="@+id/btn_normal_type"
        android:layout_width="215dp"
        android:layout_height="48dp"
        android:layout_marginTop="100dp"
        android:text="@string/text_normal_mode"
        style="?attr/buttonStyleGray_48_flat"/>
    <Button
        android:textColor="@color/s1"
        android:layout_gravity="center_horizontal"
        android:id="@+id/btn_sport_type"
        android:layout_width="215dp"
        android:layout_height="48dp"
        android:layout_marginTop="30dp"
        android:text="@string/text_sport_mode"
        style="?attr/buttonStyleGray_48_flat"/>
    <TextView
        android:textColor="@color/s2"
        android:gravity="bottom"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginTop="40dp"
        android:layout_marginBottom="60dp"
        android:text="@string/tips_choose_measure_body_mode_new"
        android:layout_weight="1"
        android:lineSpacingExtra="5dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"/>
</LinearLayout>
