<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s38"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_remove"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="29dp"
        android:layout_marginBottom="10dp"
        android:src="@drawable/ic_remove_20_p3"
        android:layout_marginStart="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/tv_name_value"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="13dp"
        app:layout_constraintBottom_toTopOf="@+id/v_line_name"
        app:layout_constraintEnd_toStartOf="@+id/tv_count_value"
        app:layout_constraintStart_toEndOf="@+id/iv_remove"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <View
        android:id="@+id/v_line_name"
        android:background="@color/s4"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/tv_name_value"
        app:layout_constraintStart_toStartOf="@+id/tv_name_value"/>
    <TextView
        android:textColor="@color/s1"
        android:gravity="center_horizontal"
        android:id="@+id/tv_count_value"
        android:layout_width="46dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_marginEnd="13dp"
        app:layout_constraintBottom_toTopOf="@+id/v_line_count"
        app:layout_constraintEnd_toStartOf="@+id/tv_weight_value"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <View
        android:id="@+id/v_line_count"
        android:background="@color/s4"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/tv_count_value"
        app:layout_constraintStart_toStartOf="@+id/tv_count_value"/>
    <TextView
        android:textColor="@color/s1"
        android:gravity="center_horizontal"
        android:id="@+id/tv_weight_value"
        android:layout_width="61dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_marginEnd="17dp"
        app:layout_constraintBottom_toTopOf="@+id/v_line_weight"
        app:layout_constraintEnd_toEndOf="parent"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <View
        android:id="@+id/v_line_weight"
        android:background="@color/s4"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/tv_weight_value"
        app:layout_constraintStart_toStartOf="@+id/tv_weight_value"/>
</androidx.constraintlayout.widget.ConstraintLayout>
