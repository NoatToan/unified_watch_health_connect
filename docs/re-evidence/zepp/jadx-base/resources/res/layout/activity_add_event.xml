<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.lib.rainbow.titlebar.RainbowTitleBar
        android:id="@+id/rainbowTitleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:menuText="@string/save"
        app:menuTint="@color/p4"
        app:navigationText="@string/cancel"
        app:navigationTint="@color/s2"/>
    <EditText
        android:textSize="14sp"
        android:textColor="@color/s1"
        android:textColorHint="@color/s3"
        android:gravity="start|top"
        android:id="@+id/remind_title_edit"
        android:background="@color/s38"
        android:paddingTop="@dimen/size_10dp"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_110dp"
        android:hint="@string/event_remind_input_title"
        android:maxLength="16"
        android:layout_below="@+id/rainbowTitleBar"
        android:textCursorDrawable="@null"
        android:paddingStart="@dimen/size_18dp"
        android:paddingEnd="@dimen/size_18dp"/>
    <RelativeLayout
        android:id="@+id/period_container"
        android:background="@color/s38"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_58dp"
        android:layout_marginTop="@dimen/size_8dp"
        android:layout_below="@+id/remind_title_edit">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/s1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/event_remind_period"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/size_18dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/s2"
            android:gravity="center"
            android:id="@+id/period_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/event_remind_once"
            android:drawablePadding="@dimen/size_6dp"
            android:layout_centerVertical="true"
            android:drawableEnd="@drawable/ic_arrow_right"
            android:layout_marginEnd="@dimen/size_18dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/s2"
        android:id="@+id/time_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size_9dp"
        android:layout_above="@+id/divider"
        android:layout_centerHorizontal="true"/>
    <View
        android:id="@+id/divider"
        android:background="@color/s4"
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider"
        android:layout_above="@+id/time_container"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/time_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_203dp"
        android:layout_alignParentBottom="true">
        <com.huami.widget.wheelview.WheelView
            android:id="@+id/date_wheel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <View
            android:id="@+id/divider_1"
            android:background="@color/s4"
            android:layout_width="@dimen/divider"
            android:layout_height="match_parent"/>
        <com.huami.widget.wheelview.WheelView
            android:id="@+id/ap_pm_wheel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <View
            android:background="@color/s4"
            android:layout_width="@dimen/divider"
            android:layout_height="match_parent"/>
        <com.huami.widget.wheelview.WheelView
            android:id="@+id/hour_wheel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <View
            android:background="@color/s4"
            android:layout_width="@dimen/divider"
            android:layout_height="match_parent"/>
        <com.huami.widget.wheelview.WheelView
            android:id="@+id/minute_wheel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
    </LinearLayout>
</RelativeLayout>
