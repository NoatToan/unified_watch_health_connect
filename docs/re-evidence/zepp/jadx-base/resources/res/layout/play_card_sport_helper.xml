<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include
        android:id="@+id/ll_title"
        layout="@layout/play_card_common_title"/>
    <TextView
        android:textSize="@dimen/play_sub_title_size"
        android:textColor="@color/play_sub_title_color"
        android:id="@+id/tv_sport_data"
        android:paddingBottom="20dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/play_sport_helper"
        android:layout_marginEnd="@dimen/play_margin_15dp"
        app:drawableEndCompat="@drawable/ic_tool_right_24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/ll_title"
        app:layout_constraintTop_toBottomOf="@+id/ll_title"/>
    <TextView
        android:textSize="@dimen/play_sub_title_size"
        android:textColor="@color/play_sub_title_color"
        android:id="@+id/tv_interval_training"
        android:paddingBottom="20dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/interval_training"
        android:layout_marginEnd="@dimen/play_margin_15dp"
        app:drawableEndCompat="@drawable/ic_tool_right_24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/ll_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_sport_data"/>
    <TextView
        android:textSize="@dimen/play_min_sub_title_size"
        android:textColor="@color/play_sub_title_color"
        android:ellipsize="end"
        android:id="@+id/tv_desc"
        android:paddingBottom="15dp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="2"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="@dimen/play_margin_15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/ll_title"
        app:layout_constraintTop_toBottomOf="@+id/ll_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
