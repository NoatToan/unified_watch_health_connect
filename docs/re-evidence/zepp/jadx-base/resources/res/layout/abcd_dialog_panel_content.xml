<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingTop="@dimen/size_30dp"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="@color/s1"
        android:layout_gravity="center_horizontal"
        android:id="@+id/dialog_content_title"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size_20dp"
        android:layout_marginStart="@dimen/d5"
        android:layout_marginEnd="@dimen/d5"
        style="@style/Rainbow.TextAppearance.Title2"/>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="horizontal"
        android:id="@+id/dialog_grid"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="75dp"
        app:layoutManager="GridLayoutManager"
        app:spanCount="1"/>
    <ScrollView
        android:id="@+id/dialog_content_scroll"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="@dimen/size_30dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:divider="@drawable/abcd_dialog_divider"
            android:showDividers="middle"
            android:paddingStart="@dimen/size_20dp"
            android:paddingEnd="@dimen/size_20dp">
            <EditText
                android:textAppearance="@style/Rainbow.TextAppearance.Body3"
                android:textColor="@color/s1"
                android:id="@+id/dialog_edittext"
                android:background="@drawable/bg_dialog_edittext"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:textDirection="locale"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"/>
            <FrameLayout
                android:layout_gravity="center"
                android:id="@+id/dialog_image_layout"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="center"
                    android:id="@+id/dialog_imageview"
                    android:visibility="gone"
                    android:layout_width="@dimen/icon_size"
                    android:layout_height="@dimen/icon_size"
                    android:src="@drawable/ic_done_44"
                    app:tint="#02af8d"/>
                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/dialog_loading"
                    android:visibility="gone"
                    android:layout_width="@dimen/icon_size"
                    android:layout_height="@dimen/icon_size"
                    app:lottie_loop="true"
                    app:lottie_rawRes="@raw/ic_loading_44_s5"/>
            </FrameLayout>
            <TextView
                android:textColor="@color/s1"
                android:gravity="center"
                android:id="@+id/dialog_subtitle"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                style="@style/Rainbow.TextAppearance.Title2"/>
            <TextView
                android:textColor="@color/s1"
                android:textColorLink="@color/s14"
                android:gravity="center"
                android:id="@+id/dialog_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Rainbow.TextAppearance.Body3"/>
            <TextView
                android:textColor="@color/s14"
                android:gravity="center"
                android:id="@+id/dialog_link"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Rainbow.TextAppearance.Body3"/>
            <androidx.appcompat.widget.AppCompatCheckBox
                android:textSize="12sp"
                android:textColor="@color/black60"
                android:id="@+id/dialog_checkbox"
                android:paddingLeft="4dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="40dp"
                style="@style/CheckboxStyle"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
