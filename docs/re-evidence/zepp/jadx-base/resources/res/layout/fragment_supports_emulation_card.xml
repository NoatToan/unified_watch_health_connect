<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/s36"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iv_simulation_failure"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_71dp"
        android:src="@drawable/ic_simulation_fragment_failure"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="@dimen/size_18sp"
        android:textColor="@color/s1"
        android:id="@+id/tv_simulation_failure"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_8dp"
        android:text="@string/access_door_detection_card_failure_tip"
        android:layout_below="@+id/iv_simulation_failure"
        android:layout_centerHorizontal="true"/>
    <Button
        android:gravity="center"
        android:id="@+id/tv_retry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_20dp"
        android:text="@string/access_door_retry"
        android:layout_below="@+id/tv_simulation_failure"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="98dp"
        android:layout_marginEnd="98dp"
        style="@style/Rainbow.Widget.Button.38.Circular"/>
    <TextView
        android:textSize="@dimen/size_14sp"
        android:textColor="@color/s3"
        android:gravity="center"
        android:id="@+id/tv_simulation_failure_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="62dp"
        android:text="@string/access_door_simulation_result_tip"
        android:layout_below="@+id/tv_retry"
        android:layout_centerHorizontal="true"
        android:lineSpacingMultiplier="1.2"
        android:layout_marginStart="43dp"
        android:layout_marginEnd="43dp"/>
    <Button
        android:gravity="center"
        android:id="@+id/tv_just_simulation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_10dp"
        android:text="@string/access_door_just_simulation"
        android:layout_below="@+id/tv_simulation_failure_tip"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="130dp"
        android:layout_marginEnd="130dp"
        style="@style/Rainbow.Widget.Button.Gray.38.Outline.Circular"/>
</RelativeLayout>
