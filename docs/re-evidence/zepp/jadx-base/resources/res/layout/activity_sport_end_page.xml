<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/sport_end_page_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="#fbfbfb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:background="@drawable/sport_end_page_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/sport_end_page_close_img"
                android:background="@drawable/sport_end_page_close"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="38dp"
                android:layout_marginEnd="16.7dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="25sp"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:id="@+id/sport_end_page_good_job_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="44dp"
                android:text="@string/sport_end_page_well_done"
                android:singleLine="true"
                android:fontFamily="lt-bold"
                android:layout_marginStart="24dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="18.3sp"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:id="@+id/sport_end_page_sport_times_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:singleLine="true"
                android:fontFamily="lt-bold"
                android:layout_marginStart="24dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/sport_end_page_good_job_tv"/>
            <ImageView
                android:id="@+id/sport_end_page_well_done_img"
                android:background="@drawable/well_done"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="41dp"
                android:layout_marginStart="24dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/sport_end_page_sport_times_tv"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="15sp"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:id="@+id/sport_end_page_show_to_friends_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="38dp"
                android:text="@string/sport_end_page_show_to_friends"
                android:singleLine="true"
                android:fontFamily="lt-bold"
                android:layout_marginStart="10dp"
                app:layout_constraintStart_toEndOf="@+id/sport_end_page_well_done_img"
                app:layout_constraintTop_toBottomOf="@+id/sport_end_page_sport_times_tv"/>
            <com.huami.moving.ui.view.card.EndCardOverView
                android:id="@+id/sport_end_page_end_card_over_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/sport_end_page_card_radius"
                app:cardPreventCornerOverlap="false"
                app:cardUseCompatPadding="false"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/sport_end_page_show_to_friends_tv"/>
            <FrameLayout
                android:id="@+id/sport_end_page_share_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/sport_end_page_end_card_over_view"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/sport_end_page_course_title_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:layout_marginStart="10dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/sport_end_page_share_card">
                <View
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/sport_end_promotion_head_tips"
                    android:layout_width="4dp"
                    android:layout_height="16.7dp"/>
                <com.huami.widget.typeface.TypefaceTextView
                    android:textSize="16sp"
                    android:textColor="@color/color_333333"
                    android:ellipsize="end"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/sport_end_page_course_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sport_end_page_courses_title"
                    android:singleLine="true"
                    android:fontFamily="lt"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>
            <FrameLayout
                android:id="@+id/sport_end_page_course"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/sport_end_page_course_title_layout"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/sport_end_page_activities_title_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:layout_marginStart="10dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/sport_end_page_course"
                app:layout_goneMarginTop="30dp">
                <View
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/sport_end_promotion_head_tips"
                    android:layout_width="4dp"
                    android:layout_height="16.7dp"/>
                <com.huami.widget.typeface.TypefaceTextView
                    android:textSize="16sp"
                    android:textColor="@color/color_333333"
                    android:ellipsize="end"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/sport_end_page_activities_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sport_end_page_activities_title"
                    android:singleLine="true"
                    android:fontFamily="lt"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/sport_end_page_activities"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/sport_end_page_activities_title_layout"/>
            <View
                android:layout_width="match_parent"
                android:layout_height="100dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <FrameLayout
        android:layout_gravity="end|bottom"
        android:id="@+id/sport_end_page_text_chain_layout"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="159dp"/>
</FrameLayout>
