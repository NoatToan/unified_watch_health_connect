<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/sport_icon"
        android:padding="5dp"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="13.4dp"
        android:layout_marginBottom="14.4dp"
        android:layout_marginStart="12.7dp"/>
    <TextView
        android:textColor="@color/s1"
        android:layout_gravity="center_vertical"
        android:id="@+id/sport_dis_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4.5dp"
        android:layout_marginEnd="14.2dp"
        app:drawableEndCompat="@drawable/ic_arrow_right"
        style="@style/Rainbow.TextAppearance.Body4"/>
</androidx.appcompat.widget.LinearLayoutCompat>
