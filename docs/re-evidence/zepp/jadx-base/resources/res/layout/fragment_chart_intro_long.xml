<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/card_corner_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/size_10"
    android:layout_marginEnd="@dimen/size_10">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container_chart_info_long"
        android:paddingBottom="@dimen/size_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_17"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/iv_info_long_item"
            android:layout_width="@dimen/size_10"
            android:layout_height="@dimen/size_10"
            android:layout_marginTop="@dimen/size_5"
            android:src="@drawable/blood_pressure_shape_sbp_circle"
            android:layout_marginStart="@dimen/size_13"
            app:layout_constraintEnd_toStartOf="@+id/tv_info_long_item1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textColor="@color/blood_pressure_s2"
            android:ellipsize="end"
            android:id="@+id/tv_info_long_item1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/blood_pressure_sbp"
            android:maxLines="2"
            android:paddingStart="@dimen/size_3"
            android:paddingEnd="@dimen/size_0"
            app:layout_constraintEnd_toStartOf="@+id/guideline_info_long"
            app:layout_constraintStart_toEndOf="@+id/iv_info_long_item"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Rainbow.TextAppearance.Body4"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/guideline_info_long"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintGuide_percent="0.5"
            app:layout_constraintStart_toStartOf="parent"/>
        <ImageView
            android:id="@+id/iv_info_long_item2"
            android:layout_width="@dimen/size_10"
            android:layout_height="@dimen/size_10"
            android:layout_marginTop="@dimen/size_5"
            android:src="@drawable/blood_pressure_shape_dbp_circle"
            android:layout_marginStart="@dimen/size_13"
            app:layout_constraintEnd_toStartOf="@+id/tv_info_long_item2"
            app:layout_constraintStart_toEndOf="@+id/guideline_info_long"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textColor="@color/blood_pressure_s2"
            android:ellipsize="end"
            android:id="@+id/tv_info_long_item2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/blood_pressure_dbp"
            android:maxLines="2"
            android:paddingStart="@dimen/size_3"
            android:paddingEnd="@dimen/size_10"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/iv_info_long_item2"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Rainbow.TextAppearance.Body4"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrier_long"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="tv_info_long_item1,tv_info_long_item2"/>
        <com.huami.lib.rainbow.widget.SwitchCompat
            android:id="@+id/switch_avg_line_long"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false"
            android:paddingEnd="@dimen/size_4"
            app:layout_constraintBottom_toBottomOf="@+id/tv_avg_line_long"
            app:layout_constraintEnd_toStartOf="@+id/tv_avg_line_long"
            app:layout_constraintTop_toTopOf="@+id/tv_avg_line_long"
            style="@style/Rainbow.Widget.Switch"/>
        <TextView
            android:textColor="@color/blood_pressure_s2"
            android:id="@+id/tv_avg_line_long"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_16"
            android:text="@string/blood_pressure_avg_line"
            android:maxLines="1"
            android:paddingEnd="@dimen/size_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/barrier_long"
            style="@style/Rainbow.TextAppearance.Body4"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
