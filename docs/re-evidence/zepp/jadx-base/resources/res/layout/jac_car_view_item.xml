<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textColor="@color/s2"
        android:gravity="center_vertical"
        android:id="@+id/car_item_title"
        android:background="@drawable/car_item_click_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/car_border_margin"
        android:paddingEnd="@dimen/car_border_margin"/>
    <ImageView
        android:gravity="center_vertical"
        android:id="@+id/car_item_arrow_right"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:src="@drawable/ic_arrow_forward_20_2x"
        android:layout_marginEnd="@dimen/car_border_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/s2"/>
    <View
        android:id="@+id/card_item_divider_top"
        android:background="@color/s4"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginLeft="@dimen/car_border_margin"
        android:layout_marginRight="@dimen/car_border_margin"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/card_item_divider_bottom"
        android:background="@color/s4"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginLeft="@dimen/car_border_margin"
        android:layout_marginRight="@dimen/car_border_margin"
        app:layout_constraintBottom_toBottomOf="@+id/car_item_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
