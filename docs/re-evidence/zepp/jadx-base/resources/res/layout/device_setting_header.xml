<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/transparent"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/top_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="32dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/vertical_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.52"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/horizontal_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/battery_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.6"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="50sp"
        android:id="@+id/tv_battery_level"
        android:layout_width="wrap_content"
        android:layout_height="70dp"
        android:text="100"
        app:layout_constraintBottom_toBottomOf="@+id/battery_line"
        app:layout_constraintStart_toStartOf="@+id/vertical_line"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="20sp"
        android:id="@+id/tv_percent"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_marginBottom="11dp"
        android:layout_marginStart="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_battery_level"
        app:layout_constraintStart_toEndOf="@+id/tv_battery_level"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="12sp"
        android:id="@+id/tv_low_battery"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="3dp"
        android:layout_marginEnd="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/vertical_line"
        app:layout_constraintTop_toBottomOf="@+id/battery_line"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_battery_info"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tv_battery_level,tv_percent,tv_low_battery"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_device_status"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tv_device_status,icon_state,tv_device_status_tips"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/s2"
        android:id="@+id/tv_device_status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/vertical_line"
        app:layout_constraintTop_toBottomOf="@+id/horizontal_line"
        style="@style/Rainbow.TextAppearance.Body3"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/s2"
        android:id="@+id/tv_device_status_tips"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/vertical_line"
        app:layout_constraintTop_toBottomOf="@+id/tv_device_status"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/weight_setting_chart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="fitCenter"
        app:layout_constraintEnd_toStartOf="@+id/vertical_line"
        app:layout_constraintTop_toBottomOf="@+id/top_line"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/icon_state"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_device_connecting"
        app:layout_constraintBottom_toBottomOf="@+id/tv_device_status"
        app:layout_constraintEnd_toStartOf="@+id/tv_device_status"
        app:layout_constraintTop_toTopOf="@+id/tv_device_status"/>
</androidx.constraintlayout.widget.ConstraintLayout>
