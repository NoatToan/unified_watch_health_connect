<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s38"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/s1"
            android:gravity="center_vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="50dp"
            android:text="@string/check_hr_during_exercise"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/s2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/wear_bracelet_hint"/>
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/iv_hr_uphand"
            android:layout_width="210dp"
            android:layout_height="210dp"
            android:layout_marginTop="9dp"
            android:layout_marginBottom="18dp"
            android:src="@drawable/img_heartrate_uphand_train"
            app:tint="@color/s1"/>
        <View style="@style/VerticalDivider"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/s1"
            android:gravity="center_vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="50dp"
            android:text="@string/exercise_hr_section"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/s2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hr_section_desc"/>
        <com.huami.view.weightfigure.WeightFigureView
            android:id="@+id/hr_section_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="25dp"
            app:type="unmoveable"/>
    </LinearLayout>
</ScrollView>
