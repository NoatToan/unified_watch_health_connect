<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="20dp"
        android:layout_marginStart="13.4dp"
        android:layout_marginEnd="12.7dp">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/s2"
            android:id="@+id/tv_records"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"/>
        <RadioGroup
            android:orientation="horizontal"
            android:id="@+id/segment_distance"
            android:background="@drawable/shape_rect_white_corner_13"
            android:layout_width="96dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true">
            <RadioButton
                android:textSize="12sp"
                android:textColor="@color/selector_distance_segment"
                android:gravity="center"
                android:id="@+id/one_distance"
                android:background="@drawable/selector_common_distance"
                android:layout_width="48dp"
                android:layout_height="24dp"
                android:button="@null"/>
            <RadioButton
                android:textSize="12sp"
                android:textColor="@color/selector_distance_segment"
                android:gravity="center"
                android:id="@+id/five_distance"
                android:background="@drawable/selector_common_distance"
                android:layout_width="48dp"
                android:layout_height="24dp"
                android:button="@null"/>
        </RadioGroup>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:layout_marginStart="13.4dp"
        android:layout_marginEnd="12.7dp">
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="12sp"
            android:textColor="@color/s2"
            android:layout_gravity="center_vertical"
            android:id="@+id/km_text_index"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/running_kilometer"
            android:fontFamily="din-med"
            android:layout_alignParentStart="true"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="12sp"
            android:textColor="@color/s2"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/pace_name_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/running_pace"
            android:fontFamily="din-med"
            android:layout_toStartOf="@+id/pace_time_title"
            android:layout_toEndOf="@+id/km_text_index"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="12sp"
            android:textColor="@color/s2"
            android:ellipsize="end"
            android:id="@+id/pace_time_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/km_segment_time_title"
            android:fontFamily="din-med"
            android:layout_marginEnd="33dp"
            android:layout_toStartOf="@+id/heart_rate_title"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="12sp"
            android:textColor="@color/s2"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/heart_rate_title"
            android:layout_width="30dp"
            android:layout_height="wrap_content"
            android:text="@string/segment_heartrate"
            android:fontFamily="din-med"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</LinearLayout>
