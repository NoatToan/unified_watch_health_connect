<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/icon"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:src="@drawable/app_icon_mijia"
        android:layout_centerHorizontal="true"/>
    <ImageView
        android:id="@+id/iv_delete"
        android:visibility="invisible"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:src="@drawable/icon_setting_delete"
        android:layout_toEndOf="@+id/icon"/>
    <TextView
        android:textSize="@dimen/app_setting_item_title_size"
        android:textColor="#80000000"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/title"
        android:paddingTop="4.8dp"
        android:paddingBottom="10.1dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="50dp"
        android:text="运动动动动动动动动动动动动动动动动动动动动动动动动"
        android:maxLines="2"
        android:layout_below="@+id/icon"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
