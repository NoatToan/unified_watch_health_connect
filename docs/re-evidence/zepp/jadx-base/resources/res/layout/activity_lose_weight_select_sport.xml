<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/s36"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:id="@+id/sl_select_sport"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="15dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:layout_width="match_parent"
                android:layout_height="28dp"/>
            <TextView
                android:textSize="22dp"
                android:textColor="@color/s1"
                android:id="@+id/tv_title_select_sport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/lose_weight_select_sport"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <TextView
                    android:textSize="12dp"
                    android:textColor="@color/s1"
                    android:id="@+id/tv_lose_weight_goal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lose_weight_goal_detail_without_unit"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="@color/s1"
                    android:id="@+id/tv_lose_weight_goal_unit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/unit_kg"/>
            </LinearLayout>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/s1"
                android:id="@+id/tv_lose_weight_period"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/lose_weight_period"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/s2"
                android:id="@+id/tv_lose_weight_sport_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/lose_weight_select_sport_detail"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/s1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="38dp"
                android:text="@string/lose_weight_basic_sport"/>
            <com.xiaomi.hm.health.bodyfat.view.CustomGridView
                android:id="@+id/gridview_basic_sport"
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:horizontalSpacing="10dp"
                android:verticalSpacing="10dp"
                android:numColumns="4"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/s1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="@string/lose_weight_sport_category_ball"/>
            <com.xiaomi.hm.health.bodyfat.view.CustomGridView
                android:id="@+id/gridview_ball_sport"
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:horizontalSpacing="10dp"
                android:verticalSpacing="10dp"
                android:numColumns="4"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/s1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="@string/lose_weight_sport_category_other"/>
            <com.xiaomi.hm.health.bodyfat.view.CustomGridView
                android:id="@+id/gridview_other_sport"
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:horizontalSpacing="10dp"
                android:verticalSpacing="10dp"
                android:numColumns="4"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="15sp"
                android:textColor="@color/s5"
                android:gravity="center"
                android:id="@+id/tv_lose_weight_sport_confirm"
                android:background="@drawable/btn_bg_login"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="15dp"
                android:text="@string/confirm"
                app:layout_constraintTop_toBottomOf="@+id/sl_select_sport"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
