<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.huami.lib.rainbow.titlebar.RainbowTitleBar
        android:id="@+id/rainbowTitleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/settings_item_hearing_health"/>
    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ViewStub
                android:id="@+id/viewstub_headset_hearing_health_on"
                android:layout="@layout/layout_headset_hearing_health_on"
                android:inflatedId="@+id/headset_hearing_health_on"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.huami.lib.rainbow.ListTile
                android:id="@+id/item_headset_settings_hearing_health"
                android:background="@drawable/shape_rect_white_corner_6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_15dp"
                android:minHeight="@dimen/size_64dp"
                android:layout_marginStart="@dimen/size_15dp"
                android:layout_marginEnd="@dimen/size_15dp"
                app:ltv_checked="false"
                app:ltv_title="@string/settings_item_hearing_health"/>
            <Space
                android:layout_width="match_parent"
                android:layout_height="34.4dp"/>
            <ViewStub
                android:id="@+id/viewstub_headset_hearing_health_off"
                android:layout="@layout/layout_headset_hearing_health_off"
                android:inflatedId="@+id/headset_hearing_health_off"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </ScrollView>
</LinearLayout>
