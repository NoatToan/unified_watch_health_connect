<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/s36"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:id="@+id/weight_value_ll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="50sp"
                android:textColor="@color/s1"
                android:gravity="center"
                android:id="@+id/weight_value_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/empty_value"
                android:fontFamily="km"/>
            <Space
                android:layout_width="6dp"
                android:layout_height="0dp"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/s2"
                android:id="@+id/weight_unit_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/empty_value"/>
        </LinearLayout>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/s2"
            android:gravity="center"
            android:id="@+id/tip_tv"
            android:paddingTop="9.7dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.huami.view.weightfigure.WeightFigureView
            android:layout_gravity="center"
            android:id="@+id/weight_figure_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="42dp"
            android:paddingStart="23dp"
            android:paddingEnd="23dp"/>
    </LinearLayout>
    <com.huami.lib.view.dim.DimPanelBottomBar xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_gravity="center_horizontal"
        android:id="@+id/bottom_bar"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="23.3dp"
        android:layout_marginStart="23.3dp"
        android:layout_marginEnd="23.3dp"
        app:left_text="@string/bodyfat_clear_weight_goal"
        app:left_text_color="@color/s1"
        app:right_text="@string/bodyfat_reset_weight_goal"
        app:right_text_color="@color/s1"
        app:show_style="separated"/>
    <TextView
        android:textSize="@dimen/login_btn_text_size"
        android:textColor="@color/s5"
        android:gravity="center"
        android:layout_gravity="bottom"
        android:id="@+id/confirm_btn"
        android:background="@drawable/btn_bg_login"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="@dimen/size_32dp"
        android:text="@string/confirm"
        android:layout_marginStart="@dimen/size_15dp"
        android:layout_marginEnd="@dimen/size_15dp"/>
</LinearLayout>
