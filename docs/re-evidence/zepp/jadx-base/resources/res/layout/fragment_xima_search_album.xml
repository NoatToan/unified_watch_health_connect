<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/xima_detail_title_size"
        android:textColor="@color/xima_graytext_color"
        android:gravity="center_vertical"
        android:id="@+id/nodata"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/xima_nodata"
        android:drawablePadding="16dp"
        android:layout_centerInParent="true"
        android:drawableStart="@drawable/ic_warning_tip"/>
    <ListView
        android:id="@+id/search_album"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@color/xima_listview_divider_color"
        android:dividerHeight="0.33dp"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"/>
</RelativeLayout>
