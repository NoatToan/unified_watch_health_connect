<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/error_container"
    android:paddingTop="80dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="12sp"
        android:textColor="@color/s2"
        android:layout_gravity="center"
        android:id="@+id/error_tips_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/discovery_status_retry"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/s29"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/refresh_tv"
        android:background="@drawable/shape_watch_skin_refresh"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="23dp"
        android:minWidth="80dp"
        android:minHeight="25dp"
        android:text="@string/tr_refresh"/>
</LinearLayout>
