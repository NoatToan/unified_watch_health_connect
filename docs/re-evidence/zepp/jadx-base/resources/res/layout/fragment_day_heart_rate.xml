<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pai_hr_parent"
    android:background="@drawable/bg_white_round_rect"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="15dp"
    android:layout_marginStart="15dp"
    android:layout_marginEnd="15dp">
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/pai_hreat_title_day"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/pai_value_get_today"
        android:layout_marginStart="15dp"
        style="@style/Rainbow.TextAppearance.Title3"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/pai_hreat_title_day_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="0PAI"
        android:layout_marginStart="5dp"
        android:layout_toEndOf="@+id/pai_hreat_title_day"
        style="@style/Rainbow.TextAppearance.Title3"/>
    <com.huami.pai.view.PaiDayHeartRateView
        android:id="@+id/pv_heart_rate_chart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:layout_below="@+id/pai_hreat_title_day"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:paddingBottom="19dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:weightSum="3"
        android:layout_below="@+id/pv_heart_rate_chart">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            android:layout_weight="1">
            <TextView
                android:textColor="@color/s1"
                android:id="@+id/tv_low_pai_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 PAI"
                style="@style/Rainbow.TextAppearance.Body4"/>
            <TextView
                android:textColor="@color/pai_low_hr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pai_progress_l"
                style="@style/Rainbow.TextAppearance.Body5"/>
        </LinearLayout>
        <View
            android:background="@color/pai_line_color"
            android:layout_width="1px"
            android:layout_height="30dp"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            android:layout_weight="1">
            <TextView
                android:textColor="@color/s1"
                android:id="@+id/tv_middle_pai_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 PAI"
                style="@style/Rainbow.TextAppearance.Body4"/>
            <TextView
                android:textColor="@color/pai_mid_hr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pai_progress_m"
                style="@style/Rainbow.TextAppearance.Body5"/>
        </LinearLayout>
        <View
            android:background="@color/pai_line_color"
            android:layout_width="1px"
            android:layout_height="30dp"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            android:layout_weight="1">
            <TextView
                android:textColor="@color/s1"
                android:id="@+id/tv_high_pai_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 PAI"/>
            <TextView
                android:textColor="@color/pai_high_hr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pai_progress_h"
                style="@style/Rainbow.TextAppearance.Body5"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
