<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/shape_bind_headset_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="end|top"
            android:id="@+id/bind_headset_device_cancel"
            android:background="@android:color/transparent"
            android:layout_width="@dimen/size_16dp"
            android:layout_height="@dimen/size_16dp"
            android:layout_marginTop="@dimen/size_21dp"
            android:src="@drawable/private_haydn_bind_headset_bg_empy_cancel"
            android:layout_marginEnd="@dimen/size_21dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/s1"/>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/animation_view"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/size_7dp"
            app:layout_constraintDimensionRatio="w,1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/bind_headset_device_cancel"
            app:layout_constraintWidth_percent="0.65"/>
        <com.google.android.material.button.MaterialButton
            android:textSize="@dimen/size_16sp"
            android:textColor="@color/s1"
            android:gravity="center_vertical"
            android:id="@+id/cervical_protection_audition"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/td_size_38dp"
            android:layout_marginTop="@dimen/size_22dp"
            android:text="@string/headset_hr_cervical_protection_hint_audition"
            android:drawablePadding="@dimen/dp_10"
            android:drawableStart="@drawable/private_haydn_audition_play"
            android:paddingStart="@dimen/size_19dp"
            android:paddingEnd="@dimen/size_19dp"
            android:stateListAnimator="@null"
            android:backgroundTint="@color/s38"
            app:cornerRadius="@dimen/size_19dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/animation_view"
            app:strokeColor="@color/s1"
            app:strokeWidth="0.5dp"/>
        <TextView
            android:textSize="@dimen/size_14sp"
            android:textColor="@color/s1"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/cervical_protection_calibration_hint"
            android:layout_width="@dimen/size_220dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_15dp"
            android:layout_marginBottom="@dimen/dp_10"
            android:text="@string/headset_cervical_protection_notification"
            android:lines="2"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cervical_protection_audition"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <include
        android:layout_gravity="center"
        android:id="@+id/headset_loading"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/loading_dialog_layout_dialog"/>
</FrameLayout>
