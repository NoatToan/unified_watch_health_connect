<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.watch.companion.ui.view.ActionbarLayout
        android:id="@+id/action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ImageView
        android:id="@+id/img"
        android:background="#f4f5f7"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:scaleType="centerInside"/>
    <androidx.core.widget.NestedScrollView
        android:background="#f4f5f7"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="#ffffff"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52.7dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">
                <TextView
                    android:textSize="14sp"
                    android:textColor="#e6000000"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/train_number"
                    android:layout_marginEnd="16dp"/>
                <com.huami.watch.companion.ui.view.ClearableEditText
                    android:textSize="12sp"
                    android:textColor="#e6000000"
                    android:textColorHint="#dc2b0b"
                    android:id="@+id/train_num"
                    android:background="#ffffff"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:hint="@string/ocr_event_hint"
                    android:layout_weight="1"
                    android:textCursorDrawable="@drawable/cursor_edit_box"/>
            </LinearLayout>
            <ImageView
                android:background="#14000000"
                android:layout_width="match_parent"
                android:layout_height="0.3dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="#ffffff"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52.7dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">
                <TextView
                    android:textSize="14sp"
                    android:textColor="#e6000000"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/train_starting_station"
                    android:layout_marginEnd="16dp"/>
                <com.huami.watch.companion.ui.view.ClearableEditText
                    android:textSize="12sp"
                    android:textColor="#e6000000"
                    android:textColorHint="#dc2b0b"
                    android:id="@+id/start_station"
                    android:background="#ffffff"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:hint="@string/ocr_event_hint"
                    android:layout_weight="1"
                    android:textCursorDrawable="@drawable/cursor_edit_box"/>
            </LinearLayout>
            <ImageView
                android:background="#14000000"
                android:layout_width="match_parent"
                android:layout_height="0.3dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="#ffffff"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52.7dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">
                <TextView
                    android:textSize="14sp"
                    android:textColor="#e6000000"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/train_arrive_station"
                    android:layout_marginEnd="16dp"/>
                <com.huami.watch.companion.ui.view.ClearableEditText
                    android:textSize="12sp"
                    android:textColor="#e6000000"
                    android:textColorHint="#dc2b0b"
                    android:id="@+id/dest_station"
                    android:background="#ffffff"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:hint="@string/ocr_event_hint"
                    android:layout_weight="1"
                    android:textCursorDrawable="@drawable/cursor_edit_box"/>
            </LinearLayout>
            <ImageView
                android:background="#14000000"
                android:layout_width="match_parent"
                android:layout_height="0.3dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="#ffffff"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52.7dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">
                <TextView
                    android:textSize="14sp"
                    android:textColor="#e6000000"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/train_departure_time"
                    android:layout_marginEnd="16dp"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#80000000"
                    android:gravity="end|center_vertical"
                    android:id="@+id/start_time"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:drawablePadding="10dp"
                    android:layout_weight="1"
                    android:onClick="selectEventTime"
                    android:drawableEnd="@drawable/ic_right_arrow"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="#ffffff"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:minHeight="52.7dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">
                <TextView
                    android:textSize="14sp"
                    android:textColor="#e6000000"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/remind"
                    android:layout_marginEnd="16dp"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#80000000"
                    android:gravity="end|center_vertical"
                    android:id="@+id/remind"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:drawablePadding="10dp"
                    android:layout_weight="1"
                    android:onClick="selectRemind"
                    android:drawableEnd="@drawable/ic_right_arrow"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
