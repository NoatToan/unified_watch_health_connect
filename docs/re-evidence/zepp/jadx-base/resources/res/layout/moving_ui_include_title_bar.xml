<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rl_title_bar"
    android:layout_width="match_parent"
    android:layout_height="48dp">
    <RelativeLayout
        android:id="@+id/rl_back"
        android:background="@drawable/shape_rect_white_corner_15"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_centerVertical="true"
        android:layout_marginStart="10dp">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="3dp"
            android:layout_alignParentEnd="true"
            app:srcCompat="@drawable/ic_arrow_back_20_2x"
            app:tint="@color/s1"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_title"
        android:background="@drawable/shape_rect_white_corner_15"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_centerInParent="true"
        android:paddingStart="22dp"
        android:paddingEnd="16dp">
        <TextView
            android:textColor="@color/s1"
            android:id="@+id/location_and_sport_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Rainbow.TextAppearance.Body4"/>
        <ImageView
            android:visibility="gone"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="@dimen/d1"
            app:srcCompat="@drawable/ic_edit_20"
            app:tint="@color/s1"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/rl_share"
        android:background="@drawable/shape_rect_white_corner_15"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_centerVertical="true"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_alignParentEnd="true">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            app:srcCompat="@drawable/ic_more_20_2x"
            app:tint="@color/s1"/>
    </RelativeLayout>
</RelativeLayout>
