<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/cl_ffedeff0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"/>
        <FrameLayout
            android:background="@android:color/white"
            android:layout_width="match_parent"
            android:layout_height="66dp"
            android:layout_alignParentBottom="true">
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="bottom"
                android:id="@+id/area_handle"
                android:background="@android:color/white"
                android:paddingTop="@dimen/size_8dp"
                android:paddingBottom="@dimen/size_6dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <Button
                    android:textSize="@dimen/size_9sp"
                    android:textColor="@color/cl_66000000"
                    android:gravity="center_horizontal"
                    android:id="@+id/world_clock_edit"
                    android:background="@android:color/transparent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="34dp"
                    android:minHeight="34dp"
                    android:text="@string/world_clock_edit"
                    android:drawableTop="@drawable/icon_world_clock_edit"
                    android:drawablePadding="3dp"
                    android:layout_marginEnd="@dimen/size_48dp"/>
                <Button
                    android:textSize="@dimen/size_9sp"
                    android:textColor="@color/cl_66000000"
                    android:gravity="center_horizontal"
                    android:id="@+id/world_clock_add"
                    android:background="@android:color/transparent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="34dp"
                    android:minHeight="34dp"
                    android:text="@string/world_clock_add"
                    android:drawableTop="@drawable/icon_worlc_clock_add"
                    android:drawablePadding="3dp"/>
            </LinearLayout>
            <Button
                android:textSize="@dimen/size_9sp"
                android:textColor="@color/cl_66000000"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/btn_complete"
                android:background="@android:color/transparent"
                android:paddingTop="@dimen/size_8dp"
                android:paddingBottom="@dimen/size_6dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="34dp"
                android:minHeight="34dp"
                android:text="@string/btn_complete"
                android:drawableTop="@drawable/mi_icon_world_clock_complete"
                android:drawablePadding="3dp"/>
        </FrameLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="66dp"
            android:layout_below="@+id/container">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:background="@android:color/white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_10dp"/>
            <TextView
                android:textSize="@dimen/size_12sp"
                android:textColor="#33000000"
                android:gravity="center_horizontal"
                android:layout_gravity="center"
                android:id="@+id/empty_hint"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/world_clock_empty_hint"
                android:drawableTop="@drawable/mi_icon_world_clock_empty_hint"
                android:drawablePadding="@dimen/size_3dp"/>
        </FrameLayout>
        <View
            android:id="@+id/mask_view"
            android:background="#77f7f7f7"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/container"/>
    </RelativeLayout>
</FrameLayout>
