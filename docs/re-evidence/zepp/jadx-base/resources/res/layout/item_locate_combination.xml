<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/select_img"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:src="@drawable/offline_voice_checked"
        android:layout_marginStart="14dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="15sp"
        android:textColor="#191919"
        android:id="@+id/title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginStart="43dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginStart="43dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_tv">
        <TextView
            android:textSize="12sp"
            android:textColor="#666666"
            android:id="@+id/accuracy_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ds_gps_accuracy"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#666666"
            android:id="@+id/consumption_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/ds_gps_power_consumption"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/accuracy_tv"/>
        <com.xiaomi.hm.health.device.setting.ui.subview.watchsetting.sportsetting.gpsdiy.LevelView
            android:id="@+id/accuracy_level_view"
            android:layout_width="75dp"
            android:layout_height="8dp"
            android:layout_marginStart="10dp"
            app:layout_constraintBottom_toBottomOf="@+id/accuracy_tv"
            app:layout_constraintStart_toEndOf="@+id/accuracy_tv"
            app:layout_constraintTop_toTopOf="@+id/accuracy_tv"/>
        <com.xiaomi.hm.health.device.setting.ui.subview.watchsetting.sportsetting.gpsdiy.LevelView
            android:id="@+id/consumption_level_view"
            android:layout_width="75dp"
            android:layout_height="8dp"
            android:layout_marginStart="10dp"
            app:layout_constraintBottom_toBottomOf="@+id/consumption_tv"
            app:layout_constraintStart_toEndOf="@+id/consumption_tv"
            app:layout_constraintTop_toTopOf="@+id/consumption_tv"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
