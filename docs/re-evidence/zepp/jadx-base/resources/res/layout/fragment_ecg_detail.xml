<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="165dp">
            <HorizontalScrollView
                android:scrollbarSize="0dp"
                android:layout_width="match_parent"
                android:layout_height="165dp"
                android:fillViewport="true"
                android:fadeScrollbars="false">
                <com.huami.ecg.chart.LineChartView
                    android:id="@+id/lv_line_chart"
                    android:background="@color/s36"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    app:gridColor="@color/s3"
                    app:heightSize="6"
                    app:isShowStandard="false"
                    app:lineColor="@color/s1"
                    app:maxCount="1.5"
                    app:minxCount="-1.5"
                    app:showTime="false"/>
            </HorizontalScrollView>
            <TextView
                android:textColor="@color/s20"
                android:id="@+id/tv_afib"
                android:padding="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginStart="20dp"
                style="@style/Rainbow.TextAppearance.Number8"/>
            <TextView
                android:textColor="@color/s36"
                android:id="@+id/tv_ecg_bioid"
                android:background="@drawable/bg_measure_self"
                android:padding="4dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:layout_alignParentBottom="true"
                android:layout_marginEnd="20dp"
                android:layout_alignParentEnd="true"
                style="@style/Rainbow.TextAppearance.Number8"/>
            <TextView
                android:textColor="@color/s15"
                android:gravity="center"
                android:paddingTop="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ecg_show_detail"
                android:onClick="toDetail"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:layout_alignParentEnd="true"
                style="@style/Rainbow.TextAppearance.Number8"/>
            <TextView
                android:textColor="@color/s3"
                android:id="@+id/ecg_heart_rate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="@string/ecg_hr_text"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="20dp"
                style="@style/Rainbow.TextAppearance.Number8"/>
        </RelativeLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/ecg_result_content"
            android:paddingTop="20dp"
            android:paddingBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="bottom"
                android:orientation="horizontal"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:onClick="toAFibWeb">
                <TextView
                    android:textSize="25sp"
                    android:textColor="@color/s1"
                    android:gravity="center"
                    android:id="@+id/afib_result"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:lineSpacingExtra="0.9sp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"/>
                <ImageView
                    android:id="@+id/ic_atrial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:src="@drawable/ic_problem"/>
            </LinearLayout>
            <TextView
                android:textColor="@color/s3"
                android:gravity="center"
                android:id="@+id/afib_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                style="@style/Rainbow.TextAppearance.Number8"/>
            <TextView
                android:textColor="@color/s15"
                android:id="@+id/operation"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                style="@style/Rainbow.TextAppearance.Number8"/>
        </LinearLayout>
        <View
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="0.3dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="42dp">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <com.huami.watch.companion.ui.view.HuaMiFontTextView
                    android:textSize="26sp"
                    android:textColor="@color/s1"
                    android:id="@+id/hr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textColor="@color/s3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/ecg_hr"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    style="@style/Rainbow.TextAppearance.Number8"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <com.huami.watch.companion.ui.view.HuaMiFontTextView
                    android:textSize="26sp"
                    android:textColor="@color/s1"
                    android:id="@+id/hrv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:onClick="toHrvDesc"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp">
                    <TextView
                        android:textColor="@color/s3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/ecg_hrv"
                        android:layout_weight="1"
                        style="@style/Rainbow.TextAppearance.Number8"/>
                    <ImageView
                        android:id="@+id/ic_hrv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_problem"
                        android:layout_marginStart="4dp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/tag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <View
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="0.3dp"
            android:layout_marginTop="20dp"/>
        <Button
            android:gravity="center"
            android:id="@+id/medong"
            android:padding="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:onClick="toMeDong"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            style="@style/Rainbow.Widget.Button.48"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
