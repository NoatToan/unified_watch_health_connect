<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s36"
    android:paddingTop="20dp"
    android:paddingBottom="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/s1"
        android:id="@+id/tv_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="lt"
        style="@style/TrainingTextSingleLineStyle"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_name">
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/s2"
            android:id="@+id/tv_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="lt"/>
        <View
            android:id="@+id/view_divider1"
            android:background="@color/tr_font_gray_light"
            android:layout_width="@dimen/tr_divider_height"
            android:layout_height="10dp"
            android:layout_marginStart="10dp"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/s2"
            android:id="@+id/tv_consumption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="lt"
            android:layout_marginStart="6dp"/>
        <View
            android:id="@+id/view_divider2"
            android:background="@color/s4"
            android:layout_width="@dimen/tr_divider_height"
            android:layout_height="10dp"
            android:layout_marginStart="10dp"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/s2"
            android:ellipsize="end"
            android:id="@+id/tv_study_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:fontFamily="lt"
            android:layout_marginStart="6dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
