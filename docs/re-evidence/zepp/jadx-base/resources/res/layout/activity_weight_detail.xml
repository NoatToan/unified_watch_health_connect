<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.xiaomi.hm.health.bodyfat.view.VerticalScrollView
        android:background="@color/s10"
        android:paddingBottom="66dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraint_layout"
            android:background="@color/s10"
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/weight_value_ll_picker"
                android:background="@drawable/scale_detail_header_bg"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <RelativeLayout
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/weight_rl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="38dp">
                    <com.huami.widget.typeface.TypefaceTextView
                        android:id="@+id/weight_value_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/empty_value"
                        style="@style/weightDetailValueStyle"/>
                    <com.huami.widget.typeface.TypefaceTextView
                        android:id="@+id/unitTV"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/empty_value"
                        android:layout_alignBaseline="@+id/weight_value_tv"
                        android:layout_marginStart="2dp"
                        android:layout_toEndOf="@+id/weight_value_tv"
                        style="@style/weightDetailUnitStyle"/>
                </RelativeLayout>
                <LinearLayout
                    android:layout_gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:id="@+id/bmi_ll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <com.huami.widget.typeface.TypefaceTextView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/bmi_value_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/empty_value"
                        style="@style/weightDetailBmiStyle"/>
                    <View
                        android:layout_gravity="center_vertical"
                        android:background="@color/s4"
                        android:layout_width="1dp"
                        android:layout_height="11dp"
                        android:layout_marginStart="6dp"
                        style="@style/bmiDividerStyle"/>
                    <com.huami.widget.typeface.TypefaceTextView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/bmi_value_tv_shape"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/empty_value"
                        android:layout_marginStart="6dp"
                        style="@style/weightDetailBmiDescStyle"/>
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/iv_bmi_arrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_arrow_right"
                        android:layout_marginStart="2dp"/>
                </LinearLayout>
                <RelativeLayout
                    android:gravity="center"
                    android:id="@+id/chart_container"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:layout_marginTop="20dp"/>
            </LinearLayout>
            <com.xiaomi.hm.health.bodyfat.view.WeightLoadingStatus
                android:id="@+id/loading_status"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <RelativeLayout
                android:id="@+id/user_picker_ll"
                android:background="@color/scale_detail_bg_end_color"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/weight_value_ll_picker">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="10dp"
                    android:src="@drawable/ic_triangle"
                    android:layout_centerHorizontal="true"/>
                <com.xiaomi.hm.health.bodyfat.view.WeightUserQuickPicker
                    android:id="@+id/user_picker"
                    android:background="@color/s38"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/weight_user_picker_content_height"
                    android:layout_marginTop="10dp"/>
                <View
                    android:id="@+id/divider"
                    android:background="@color/s4"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginTop="10dp"/>
            </RelativeLayout>
            <View
                android:id="@+id/line_split1"
                android:layout_width="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/user_picker_ll"
                style="@style/lineSplit1Style"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/weight_navi_rl"
                android:background="@color/s38"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/line_split1"
                style="@style/weightNaviRlStyle">
                <View
                    android:background="@color/s10"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    style="@style/activityWeightDetailSplitLineStyle"/>
                <com.huami.widget.typeface.TypefaceTextView
                    android:id="@+id/weight_change_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bf3_weight_change_mon"
                    style="@style/weightDetailChangeTitleStyle"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="75dp"
                        android:layout_weight="1">
                        <com.huami.lib.view.text.UnitTextView
                            android:layout_gravity="center_horizontal"
                            android:id="@+id/weight_change_last_uv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            style="@style/weightChangeLastStyle"/>
                        <com.huami.lib.view.text.TextViewDrawable
                            android:layout_gravity="center_horizontal"
                            android:id="@+id/weight_change_last_date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/compare_to_last_time"
                            android:drawablePadding="4dp"
                            android:drawableStart="@drawable/icon_arrow_down"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="12dp"
                            app:isAliganCenter="false"
                            style="@style/weightChangeLastDateStyle"/>
                    </LinearLayout>
                    <View
                        android:layout_gravity="center"
                        android:background="@color/s4"
                        android:layout_width="@dimen/divider"
                        android:layout_height="36dp"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="75dp"
                        android:layout_weight="1">
                        <com.huami.lib.view.text.UnitTextView
                            android:layout_gravity="center_horizontal"
                            android:id="@+id/weight_change_mon_uv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            style="@style/weightChangeLastStyle"/>
                        <com.huami.lib.view.text.TextViewDrawable
                            android:layout_gravity="center_horizontal"
                            android:id="@+id/weight_change_mon_nav_date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/bf3_mon_pre_title"
                            android:drawablePadding="4dp"
                            android:drawableStart="@drawable/icon_arrow_down"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="12dp"
                            app:isAliganCenter="false"
                            style="@style/weightChangeLastDateStyle"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <include
                android:orientation="vertical"
                android:id="@+id/weight_compare_ll"
                android:background="@color/s38"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:layout_marginTop="10dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/weight_navi_rl"
                layout="@layout/layout_weight_detail_compare"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/weight_body_type_ll"
                android:background="@color/s38"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/weight_compare_ll">
                <RelativeLayout
                    android:id="@+id/no_bmi_ll"
                    android:background="@color/s38"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="156dp">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/s2"
                        android:id="@+id/no_bmi_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/no_bmi_for_height"
                        android:drawableTop="@drawable/bf3_baby_error"
                        android:drawablePadding="3dp"
                        android:layout_centerInParent="true"/>
                </RelativeLayout>
                <include layout="@layout/ideal_weight"/>
            </LinearLayout>
            <include
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/weight_body_type_ll"
                layout="@layout/card_status_introduces"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.xiaomi.hm.health.bodyfat.view.VerticalScrollView>
    <include
        android:id="@+id/bottom_layout"
        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:layout_alignParentBottom="true"
        layout="@layout/layout_weight_detail_bottom"/>
</RelativeLayout>
