<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/s1"
        android:id="@+id/item_label_manager_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Rainbow.TextAppearance.Body3"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/sp_12"
        android:textColor="@color/s2"
        android:id="@+id/item_label_manager_msg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/health_label_manager_drag_msg"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/item_label_manager_title"
        app:layout_constraintStart_toEndOf="@+id/item_label_manager_title"
        app:layout_constraintTop_toTopOf="@+id/item_label_manager_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
