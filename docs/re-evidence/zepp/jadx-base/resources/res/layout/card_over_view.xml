<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@color/over_view_gradient_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="23.65dp">
        <TextView
            android:id="@+id/over_view_watermark"
            android:visibility="gone"
            android:layout_marginTop="10.6dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/OverviewWatermarkStyle"/>
        <TextView
            android:id="@+id/over_view_type"
            android:visibility="gone"
            android:layout_marginTop="33.9dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/OverviewWatermarkStyle"/>
        <TextView
            android:textSize="12.7sp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/over_view_nickname"
            android:layout_width="186.7dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32.2dp"
            android:singleLine="true"
            android:textDirection="locale"
            android:layout_marginStart="13.3dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="11.3sp"
            android:textColor="@color/white60"
            android:id="@+id/over_view_start_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4.3dp"
            app:layout_constraintStart_toStartOf="@+id/over_view_nickname"
            app:layout_constraintTop_toBottomOf="@+id/over_view_nickname"/>
        <TextView
            android:textSize="11.3sp"
            android:textColor="@color/white60"
            android:id="@+id/over_view_main_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28.1dp"
            android:layout_marginEnd="13.3dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/over_view_watermark"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="42sp"
            android:textColor="@color/white"
            android:id="@+id/over_view_main_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="km"
            app:layout_constraintBaseline_toBaselineOf="@+id/over_view_main_unit"
            app:layout_constraintEnd_toStartOf="@+id/over_view_main_unit"/>
        <com.huami.moving.ui.view.FastSlowGradientView
            android:id="@+id/over_view_gradient"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="19.7dp"
            app:endY="0"
            app:layout_constraintTop_toBottomOf="@+id/over_view_start_time"
            app:linearColors="@array/fast_slow_gradient_colors"
            app:linearPositions="@array/fast_slow_gradient_percents"/>
        <TextView
            android:textSize="10.7sp"
            android:textColor="@color/over_view_gradient_slow"
            android:id="@+id/over_view_slow"
            android:background="@color/over_view_gradient_bg"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="13.9dp"
            android:text="@string/over_view_gradient_slow"
            app:layout_constraintStart_toStartOf="@+id/over_view_start_time"
            app:layout_constraintTop_toBottomOf="@+id/over_view_start_time"/>
        <TextView
            android:textSize="10.7sp"
            android:textColor="@color/over_view_gradient_fast"
            android:id="@+id/over_view_fast"
            android:background="@color/over_view_gradient_bg"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="13.9dp"
            android:text="@string/over_view_gradient_fast"
            app:layout_constraintEnd_toEndOf="@+id/over_view_main_unit"
            app:layout_constraintTop_toBottomOf="@+id/over_view_start_time"/>
        <View
            android:id="@+id/over_view_replace"
            android:background="@color/over_view_divide_color"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="21.7dp"
            app:layout_constraintTop_toBottomOf="@+id/over_view_start_time"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/over_view_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22.7dp"
            android:listSelector="@android:color/transparent"
            android:numColumns="3"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/over_view_start_time"/>
        <ImageView
            android:id="@+id/over_view_info_more"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:src="@drawable/ic_over_view_info_down"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/over_view_info"/>
        <View
            android:id="@+id/over_view_divide"
            android:background="@color/over_view_divide_color"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="21.7dp"
            android:layout_marginStart="13.3dp"
            android:layout_marginEnd="13.3dp"
            app:layout_constraintTop_toBottomOf="@+id/over_view_info_more"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/over_view_data_source"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10.8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/over_view_divide"/>
        <TextView
            android:textSize="10.7sp"
            android:textColor="@color/white60"
            android:id="@+id/over_view_data_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="11.6dp"
            android:text="@string/over_view_data_title"
            app:layout_constraintEnd_toStartOf="@+id/over_view_data_source"
            app:layout_constraintTop_toBottomOf="@+id/over_view_divide"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:background="@drawable/user_avatar_ring_bg_thick"
        android:layout_width="47.3dp"
        android:layout_height="47.3dp"
        android:layout_marginStart="13.3dp"/>
    <ImageView
        android:id="@+id/over_view_avatar"
        android:layout_width="43.3dp"
        android:layout_height="43.3dp"
        android:layout_marginTop="2dp"
        android:src="@drawable/default_user_avatar"
        android:layout_marginStart="15.3dp"/>
</FrameLayout>
