<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s36"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/lose_weight_frame_container"
        android:paddingTop="28sp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <RelativeLayout
            android:id="@+id/rl_loading_weight_info"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ProgressBar
                android:layout_gravity="center_horizontal"
                android:id="@+id/loading"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:indeterminateDrawable="@drawable/loading_progress"
                android:indeterminateBehavior="repeat"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@+id/lose_weight_searcher_weight_info"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/s3"
                android:layout_gravity="center_horizontal"
                android:id="@+id/lose_weight_searcher_weight_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/lose_weight_weight_info_search"
                android:layout_centerInParent="true"
                android:paddingStart="20dp"/>
        </RelativeLayout>
    </FrameLayout>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/s3"
        android:id="@+id/lose_weight_weight_info_invalid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
