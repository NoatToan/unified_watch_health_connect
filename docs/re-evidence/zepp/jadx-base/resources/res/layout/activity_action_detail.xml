<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:background="@color/s36"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.google.android.exoplayer2.ui.PlayerView
                android:id="@+id/sfv_video"
                android:background="@color/pale_grey"
                android:layout_width="match_parent"
                android:layout_height="202dp"
                app:default_artwork="@drawable/icon_default_item_head"
                app:resize_mode="fill"
                app:surface_type="surface_view"
                app:use_controller="false"/>
            <com.xiaomi.hm.health.training.ui.widget.HtmlRichText
                android:textColor="@color/s2"
                android:id="@+id/wbv_content"
                android:padding="18dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_bottom"
        android:background="@color/orange100"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/imv_pre"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/ic_back_white"
            android:scaleType="centerInside"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="24sp"
            android:textColor="@color/white100"
            android:gravity="center"
            android:id="@+id/tx_page_index"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fontFamily="km"/>
        <ImageView
            android:id="@+id/imv_next"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/ic_arrow_next"
            android:scaleType="centerInside"/>
    </LinearLayout>
</LinearLayout>
