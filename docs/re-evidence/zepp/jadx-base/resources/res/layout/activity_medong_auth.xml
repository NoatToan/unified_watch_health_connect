<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.lib.rainbow.titlebar.RainbowTitleBar
        android:id="@+id/actionbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationIcon="@drawable/ic_arrow_back_20_2x"
        app:title="@string/start_medong"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@color/s36"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginTop="30dp"
            android:src="@drawable/ic_medong"
            android:scaleType="fitXY"/>
        <TextView
            android:textColor="@color/s1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/medong_app"
            style="@style/Rainbow.TextAppearance.Title3"/>
        <View
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="15dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"/>
        <TextView
            android:textColor="@color/s1"
            android:gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/to_medong_tip"
            style="@style/Rainbow.TextAppearance.Number8"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="30dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp">
            <ImageView
                android:id="@+id/avatar"
                android:layout_width="30dp"
                android:layout_height="30dp"/>
            <TextView
                android:textColor="@color/p3"
                android:ellipsize="end"
                android:id="@+id/username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="200dp"
                android:singleLine="true"
                android:layout_marginStart="7dp"
                style="@style/Rainbow.TextAppearance.Number6"/>
            <TextView
                android:textColor="@color/p3"
                android:id="@+id/login_by"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Rainbow.TextAppearance.Number6"/>
        </LinearLayout>
    </LinearLayout>
    <Button
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="45dp"
        android:text="@string/start_medong"
        android:onClick="toMeDong"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        style="@style/Rainbow.Widget.Button.48"/>
    <CheckBox
        android:textSize="12sp"
        android:textColor="@color/s3"
        android:id="@+id/no_auth_check"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:text="@string/do_not_to_medong"
        android:paddingStart="6dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        style="@style/WatchCheckBox"/>
</LinearLayout>
