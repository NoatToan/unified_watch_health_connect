<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@android:color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:background="@drawable/shape_success_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/share_dialog_success_margin_horizontal"
        android:layout_marginEnd="@dimen/share_dialog_success_margin_horizontal">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14sp"
            android:textColor="@color/s33"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/share_dialog_success_margin_vertical"
            android:layout_marginBottom="@dimen/share_dialog_success_margin_vertical"
            android:text="@string/share_success"
            android:drawableTop="@drawable/dialog_success"
            android:drawablePadding="1dp"/>
        <View
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/s1"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/go"
            android:background="@drawable/selector_button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/share_dialog_success_button_height"
            android:text="@string/share_mifit_success"/>
        <View
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/s1"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/close"
            android:background="@drawable/selector_bottom"
            android:layout_width="match_parent"
            android:layout_height="@dimen/share_dialog_success_button_height"
            android:text="@string/share_close"/>
    </LinearLayout>
</FrameLayout>
