<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/shape_bind_headset_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="26dp"
        android:layout_marginStart="@dimen/size_15dp"
        android:layout_marginEnd="@dimen/size_15dp">
        <ImageButton
            android:layout_gravity="end|top"
            android:id="@+id/bind_headset_device_cancel"
            android:layout_width="@dimen/size_24dp"
            android:layout_height="@dimen/size_24dp"
            android:layout_marginTop="21dp"
            android:src="@drawable/private_haydn_bind_headset_cancel"
            android:layout_marginEnd="21dp"/>
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/bind_headset_device_search_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:src="@drawable/private_haydn_hr_reminder"
            android:maxWidth="180dp"
            android:maxHeight="180dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#ff8d8d8d"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="@string/settings_item_high_hr_reminder_hint"
            android:layout_marginStart="@dimen/size_42dp"
            android:layout_marginEnd="41dp"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_24dp"
            android:layout_marginBottom="30dp">
            <ImageButton
                android:id="@+id/hr_reminder_audition"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/private_haydn_audition_play"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#ff3c88ff"
                android:layout_gravity="center_horizontal"
                android:id="@+id/hr_reminder_audition_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/headset_hr_cervical_protection_hint_audition"
                android:layout_marginStart="@dimen/size_10dp"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
