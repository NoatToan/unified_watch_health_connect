<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/container_titlebar"
        layout="@layout/titlebar_blood_pressure"/>
    <androidx.core.widget.NestedScrollView xmlns:app="http://schemas.android.com/apk/res-auto"
        android:background="@color/s38"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@color/s38"
            android:paddingBottom="@dimen/size_63"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/container_bp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_14"
                android:layout_marginStart="@dimen/size_26"
                android:layout_marginEnd="@dimen/size_26"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textColor="@color/blood_pressure_s1"
                    android:gravity="start|center_vertical"
                    android:id="@+id/tv_bp_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/blood_pressure"
                    android:textDirection="locale"
                    android:textAlignment="viewStart"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/Rainbow.TextAppearance.Title2"/>
                <TextView
                    android:textColor="@color/blood_pressure_s2"
                    android:gravity="start|center_vertical"
                    android:id="@+id/tv_bp_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_10"
                    android:text="@string/blood_pressure_desc"
                    android:textDirection="locale"
                    android:textAlignment="viewStart"
                    app:layout_constraintTop_toBottomOf="@+id/tv_bp_title"
                    style="@style/Rainbow.TextAppearance.Body4"/>
                <ImageView
                    android:id="@+id/ic_bp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_16"
                    android:src="@drawable/ic_blood_pressure"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_bp_desc"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/container_forbit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_49"
                android:layout_marginStart="@dimen/size_26"
                android:layout_marginEnd="@dimen/size_26"
                app:layout_constraintTop_toBottomOf="@+id/container_bp">
                <TextView
                    android:textColor="@color/blood_pressure_s1"
                    android:gravity="start|center_vertical"
                    android:id="@+id/tv_forbit_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/blood_pressure_forbit"
                    android:textDirection="locale"
                    android:textAlignment="viewStart"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/Rainbow.TextAppearance.Title2"/>
                <com.google.android.flexbox.FlexboxLayout
                    android:id="@+id/flex_forbit_ic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_21"
                    android:layout_marginStart="@dimen/size_6"
                    android:layout_marginEnd="@dimen/size_6"
                    app:flexDirection="row"
                    app:flexWrap="nowrap"
                    app:justifyContent="space_between"
                    app:layout_constraintTop_toBottomOf="@+id/tv_forbit_title">
                    <ImageView
                        android:src="@drawable/ic_bp_child"
                        style="@style/style_bp_intro_icon"/>
                    <ImageView
                        android:src="@drawable/ic_bp_pregnent"
                        style="@style/style_bp_intro_icon"/>
                    <ImageView
                        android:src="@drawable/ic_bp_heart"
                        style="@style/style_bp_intro_icon"/>
                    <ImageView
                        android:src="@drawable/ic_bp_aortic"
                        style="@style/style_bp_intro_icon"/>
                    <ImageView
                        android:src="@drawable/ic_bp_kidney"
                        style="@style/style_bp_intro_icon"/>
                </com.google.android.flexbox.FlexboxLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/flex_forbit_desc"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size_189"
                    android:layout_marginTop="@dimen/size_18"
                    android:minHeight="@dimen/size_189"
                    android:layout_marginStart="@dimen/size_4"
                    android:layout_marginEnd="@dimen/size_4"
                    app:layout_constraintTop_toBottomOf="@+id/flex_forbit_ic">
                    <TextView
                        app:layout_constraintEnd_toStartOf="@+id/tv_forbit_item1"
                        app:layout_constraintTop_toTopOf="@+id/tv_forbit_item1"
                        style="@style/style_bp_intro_item_icon"/>
                    <TextView
                        android:id="@+id/tv_forbit_item1"
                        android:text="@string/bp_child_desc"
                        android:layout_marginStart="@dimen/size_21"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/style_bp_intro_forbit_desc"/>
                    <TextView
                        app:layout_constraintEnd_toStartOf="@+id/tv_forbit_item2"
                        app:layout_constraintTop_toTopOf="@+id/tv_forbit_item2"
                        style="@style/style_bp_intro_item_icon"/>
                    <TextView
                        android:id="@+id/tv_forbit_item2"
                        android:layout_marginTop="@dimen/size_20"
                        android:text="@string/bp_pregnent_desc"
                        android:layout_marginStart="@dimen/size_21"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_forbit_item1"
                        style="@style/style_bp_intro_forbit_desc"/>
                    <TextView
                        app:layout_constraintEnd_toStartOf="@+id/tv_forbit_item3"
                        app:layout_constraintTop_toTopOf="@+id/tv_forbit_item3"
                        style="@style/style_bp_intro_item_icon"/>
                    <TextView
                        android:id="@+id/tv_forbit_item3"
                        android:layout_marginTop="@dimen/size_20"
                        android:text="@string/bp_heart_desc"
                        android:layout_marginStart="@dimen/size_21"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_forbit_item2"
                        style="@style/style_bp_intro_forbit_desc"/>
                    <TextView
                        app:layout_constraintEnd_toStartOf="@+id/tv_forbit_item4"
                        app:layout_constraintTop_toTopOf="@+id/tv_forbit_item4"
                        style="@style/style_bp_intro_item_icon"/>
                    <TextView
                        android:id="@+id/tv_forbit_item4"
                        android:layout_marginTop="@dimen/size_20"
                        android:text="@string/bp_aortic_desc"
                        android:layout_marginStart="@dimen/size_21"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_forbit_item3"
                        style="@style/style_bp_intro_forbit_desc"/>
                    <TextView
                        app:layout_constraintEnd_toStartOf="@+id/tv_forbit_item5"
                        app:layout_constraintTop_toTopOf="@+id/tv_forbit_item5"
                        style="@style/style_bp_intro_item_icon"/>
                    <TextView
                        android:id="@+id/tv_forbit_item5"
                        android:layout_marginTop="@dimen/size_20"
                        android:text="@string/bp_kidney_desc"
                        android:layout_marginStart="@dimen/size_21"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_forbit_item4"
                        style="@style/style_bp_intro_forbit_desc"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/container_watchout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_49"
                android:layout_marginStart="@dimen/size_26"
                android:layout_marginEnd="@dimen/size_26"
                app:layout_constraintTop_toBottomOf="@+id/container_forbit">
                <TextView
                    android:id="@+id/tv_watchout_title"
                    android:text="@string/blood_pressure_watchout"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/style_bp_intro_title"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/flex_watchout_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_10"
                    android:layout_marginStart="@dimen/size_4"
                    android:layout_marginEnd="@dimen/size_4"
                    app:layout_constraintTop_toBottomOf="@+id/tv_watchout_title">
                    <TextView
                        app:layout_constraintEnd_toStartOf="@+id/tv_watchout_item1"
                        app:layout_constraintTop_toTopOf="@+id/tv_watchout_item1"
                        style="@style/style_bp_intro_item_icon"/>
                    <TextView
                        android:id="@+id/tv_watchout_item1"
                        android:text="@string/bp_watchout_desc1"
                        android:layout_marginStart="@dimen/size_21"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/style_bp_intro_forbit_desc"/>
                    <TextView
                        app:layout_constraintEnd_toStartOf="@+id/tv_watchout_item2"
                        app:layout_constraintTop_toTopOf="@+id/tv_watchout_item2"
                        style="@style/style_bp_intro_item_icon"/>
                    <TextView
                        android:id="@+id/tv_watchout_item2"
                        android:layout_marginTop="@dimen/size_10"
                        android:text="@string/bp_watchout_desc2"
                        android:layout_marginStart="@dimen/size_21"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_watchout_item1"
                        style="@style/style_bp_intro_forbit_desc"/>
                    <TextView
                        app:layout_constraintEnd_toStartOf="@+id/tv_watchout_item3"
                        app:layout_constraintTop_toTopOf="@+id/tv_watchout_item3"
                        style="@style/style_bp_intro_item_icon"/>
                    <TextView
                        android:id="@+id/tv_watchout_item3"
                        android:layout_marginTop="@dimen/size_10"
                        android:text="@string/bp_watchout_desc3"
                        android:layout_marginStart="@dimen/size_21"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_watchout_item2"
                        style="@style/style_bp_intro_forbit_desc"/>
                    <TextView
                        app:layout_constraintEnd_toStartOf="@+id/tv_watchout_item4"
                        app:layout_constraintTop_toTopOf="@+id/tv_watchout_item4"
                        style="@style/style_bp_intro_item_icon"/>
                    <TextView
                        android:id="@+id/tv_watchout_item4"
                        android:layout_marginTop="@dimen/size_10"
                        android:text="@string/bp_watchout_desc4"
                        android:layout_marginStart="@dimen/size_21"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_watchout_item3"
                        style="@style/style_bp_intro_forbit_desc"/>
                    <TextView
                        app:layout_constraintEnd_toStartOf="@+id/tv_watchout_item5"
                        app:layout_constraintTop_toTopOf="@+id/tv_watchout_item5"
                        style="@style/style_bp_intro_item_icon"/>
                    <TextView
                        android:id="@+id/tv_watchout_item5"
                        android:layout_marginTop="@dimen/size_10"
                        android:text="@string/bp_watchout_desc5"
                        android:layout_marginStart="@dimen/size_21"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_watchout_item4"
                        style="@style/style_bp_intro_forbit_desc"/>
                    <TextView
                        app:layout_constraintEnd_toStartOf="@+id/tv_watchout_item6"
                        app:layout_constraintTop_toTopOf="@+id/tv_watchout_item6"
                        style="@style/style_bp_intro_item_icon"/>
                    <TextView
                        android:id="@+id/tv_watchout_item6"
                        android:layout_marginTop="@dimen/size_10"
                        android:text="@string/bp_watchout_desc6"
                        android:layout_marginStart="@dimen/size_21"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_watchout_item5"
                        style="@style/style_bp_intro_forbit_desc"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/container_use"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_49"
                android:layout_marginStart="@dimen/size_26"
                android:layout_marginEnd="@dimen/size_26"
                app:layout_constraintTop_toBottomOf="@+id/container_watchout">
                <TextView
                    android:id="@+id/tv_use_title"
                    android:text="@string/blood_pressure_use"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/style_bp_intro_title"/>
                <TextView
                    app:layout_constraintEnd_toStartOf="@+id/tv_use_desc"
                    app:layout_constraintTop_toTopOf="@+id/tv_use_desc"
                    style="@style/style_bp_intro_item_icon"/>
                <TextView
                    android:id="@+id/tv_use_desc"
                    android:layout_marginTop="@dimen/size_10"
                    android:text="@string/bp_use_desc"
                    android:layout_marginStart="@dimen/size_21"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_use_title"
                    style="@style/style_bp_intro_forbit_desc"/>
                <ImageView
                    android:id="@+id/iv_use"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_17"
                    android:src="@drawable/ic_bp_intro_use"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_use_desc"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
