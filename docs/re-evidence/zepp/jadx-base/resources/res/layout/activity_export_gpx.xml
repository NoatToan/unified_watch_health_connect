<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="15sp"
        android:textColor="@color/s1"
        android:id="@+id/tv_gpx_format"
        android:background="@drawable/shape_rect_white_corner_6"
        android:paddingTop="21dp"
        android:paddingBottom="21dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:text="@string/run_share_gpx_type"
        android:drawableEnd="@drawable/ic_arrow_forward_20_2x"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/s2"
        android:id="@+id/tv_gpx_path"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:text="@string/run_share_export_file_path"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_gpx_format"/>
</androidx.constraintlayout.widget.ConstraintLayout>
