<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/account_ui_trans"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/account_ui_dialog_empty_area"/>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/account_ui_dialog_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/account_ui_info_content_size"
            android:textColor="@color/s1"
            android:id="@+id/third_part_oauth_error_mainland_limit_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:layout_marginBottom="31dp"
            android:text="@string/account_ui_third_part_oauth_error_mainland_limit_login"
            android:layout_marginStart="@dimen/account_ui_dp_40"
            android:layout_marginEnd="@dimen/account_ui_dp_40"/>
        <View
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <LinearLayout
            android:orientation="horizontal"
            android:background="@color/account_ui_trans"
            android:layout_width="match_parent"
            android:layout_height="@dimen/account_ui_item_height_max">
            <TextView
                android:textSize="@dimen/account_ui_person_info_setting_text_size"
                android:textColor="@color/s1"
                android:gravity="center"
                android:id="@+id/third_part_oauth_error_mainland_limit_known"
                android:background="@drawable/account_ui_btn_bottom_radius"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/account_ui_i_know"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
