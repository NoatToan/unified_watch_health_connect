<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="12sp"
        android:textColor="@color/s3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/ecg_chart_add_ect_status_tag_desc"
        android:layout_marginStart="20dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">
        <TextView
            android:textColor="@color/s1"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv_ecg_string_tag"
            android:background="@drawable/btn_add_tag"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="38dp"
            android:maxLines="1"
            android:layout_weight="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginEnd="10dp"
            style="@style/Rainbow.TextAppearance.Number7"/>
        <com.huami.watch.companion.ecg.view.voice.DrawCenterTextView
            android:textColor="@color/add_tag_text_color"
            android:gravity="center"
            android:id="@+id/ecg_chart_btn_add_tag"
            android:background="@drawable/btn_add_tag"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="38dp"
            android:text="@string/ecg_chart_add_tag"
            android:drawablePadding="20dp"
            android:layout_weight="1"
            android:drawableEnd="@drawable/ic_add_20"
            android:layout_marginEnd="10dp"/>
        <com.huami.watch.companion.ecg.view.voice.SpeakButton
            android:textColor="@color/add_tag_text_color"
            android:gravity="center"
            android:id="@+id/ecg_chart_tv_press_to_record"
            android:background="@drawable/btn_add_tag"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:minHeight="38dp"
            android:text="@string/pressed_speak"
            android:drawablePadding="20dp"
            android:layout_weight="1"
            android:drawableEnd="@drawable/ic_recorder_24"/>
        <RelativeLayout
            android:id="@+id/ecg_chart_voice_view"
            android:background="@drawable/btn_add_tag"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="38dp"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/voice_play"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_voice_3"
                android:layout_centerVertical="true"
                android:layout_marginStart="15dp"/>
            <ProgressBar
                android:id="@+id/voice_loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="15dp"
                style="@android:style/Widget.ProgressBar.Small"/>
            <TextView
                android:textStyle="normal"
                android:textColor="@color/s1"
                android:id="@+id/tv_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="10dp"
                android:layout_toEndOf="@+id/voice_play"
                style="@style/Rainbow.TextAppearance.Number8"/>
            <ImageView
                android:id="@+id/btn_delete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_close_20_2x"
                android:layout_centerVertical="true"
                android:layout_marginEnd="10dp"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
