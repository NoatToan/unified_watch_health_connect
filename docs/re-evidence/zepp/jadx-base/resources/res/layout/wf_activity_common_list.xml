<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/wf_watch_face_detail_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.watchfacesstore.view.CommonTitleBar
        android:id="@+id/common_title_bar"
        style="@style/CommonTitleBar"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_local_watch_tip"
        android:background="@drawable/wf_item_common_bg"
        android:paddingTop="13dp"
        android:paddingBottom="13dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:src="@drawable/wf_ic_tips"
            android:layout_marginStart="15dp"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/wf_light_white"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="5dp"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="20dp"/>
    </LinearLayout>
    <com.huami.watchfacesstore.view.recycleview.LoadMoreRecyclerView
        android:id="@+id/rl_list"
        android:paddingTop="15dp"
        android:paddingBottom="5dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="15dp"
        android:paddingEnd="5dp"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="2"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/ll_delete"
        android:background="#000000"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="77dp"
        android:paddingStart="15dp"
        android:paddingEnd="15dp">
        <TextView
            android:textSize="15sp"
            android:textColor="#ff5353"
            android:gravity="center"
            android:id="@+id/tv_all_choose"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="@string/wf_all_choose"
            android:layout_weight="1"
            android:layout_marginEnd="15dp"/>
        <TextView
            android:textSize="15sp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/tv_delete"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="@string/wf_manager_item_delete"
            android:layout_weight="1"/>
    </LinearLayout>
    <include
        android:visibility="gone"
        layout="@layout/wf_error_layout"/>
</LinearLayout>
