<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/ruler_normal"
        android:background="@drawable/shape_cervical_protection_normal"
        android:layout_width="0dp"
        android:layout_height="@dimen/size_8dp"
        android:layout_marginTop="@dimen/size_24dp"
        android:alpha="0.3"
        android:layout_marginStart="@dimen/size_8dp"
        app:layout_constraintEnd_toStartOf="@+id/ruler_common"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/ruler_common"
        android:background="@color/cl_ffcd68"
        android:layout_width="0dp"
        android:layout_height="@dimen/size_8dp"
        android:alpha="0.3"
        android:layout_marginStart="@dimen/size_2dp"
        android:layout_marginEnd="@dimen/size_2dp"
        app:layout_constraintBottom_toBottomOf="@+id/ruler_normal"
        app:layout_constraintEnd_toStartOf="@+id/ruler_larger"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/ruler_normal"
        app:layout_constraintTop_toTopOf="@+id/ruler_normal"/>
    <View
        android:id="@+id/ruler_larger"
        android:background="@color/cl_ff8c46"
        android:layout_width="0dp"
        android:layout_height="@dimen/size_8dp"
        android:alpha="0.3"
        app:layout_constraintBottom_toBottomOf="@+id/ruler_common"
        app:layout_constraintEnd_toStartOf="@+id/ruler_too_big"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/ruler_common"
        app:layout_constraintTop_toTopOf="@+id/ruler_common"/>
    <View
        android:id="@+id/ruler_too_big"
        android:background="@drawable/shape_cervical_protection_high"
        android:layout_width="0dp"
        android:layout_height="@dimen/size_8dp"
        android:alpha="0.3"
        android:layout_marginStart="@dimen/size_2dp"
        android:layout_marginEnd="@dimen/size_8dp"
        app:layout_constraintBottom_toBottomOf="@+id/ruler_larger"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/ruler_larger"
        app:layout_constraintTop_toTopOf="@+id/ruler_larger"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/s2"
        android:id="@+id/angle_0"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size_2dp"
        app:layout_constraintBottom_toTopOf="@+id/ruler_normal"
        app:layout_constraintStart_toStartOf="@+id/ruler_normal"
        style="@style/Rainbow.TextAppearance.Number1"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/s2"
        android:id="@+id/angle_15"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size_2dp"
        app:layout_constraintBottom_toTopOf="@+id/ruler_common"
        app:layout_constraintEnd_toEndOf="@+id/ruler_common"
        app:layout_constraintStart_toStartOf="@+id/ruler_normal"
        style="@style/Rainbow.TextAppearance.Number1"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/s2"
        android:id="@+id/angle_30"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size_2dp"
        app:layout_constraintBottom_toTopOf="@+id/ruler_larger"
        app:layout_constraintEnd_toEndOf="@+id/ruler_larger"
        app:layout_constraintStart_toStartOf="@+id/ruler_common"
        style="@style/Rainbow.TextAppearance.Number1"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/s2"
        android:id="@+id/angle_45"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size_2dp"
        app:layout_constraintBottom_toTopOf="@+id/ruler_too_big"
        app:layout_constraintEnd_toEndOf="@+id/ruler_too_big"
        app:layout_constraintStart_toStartOf="@+id/ruler_larger"
        style="@style/Rainbow.TextAppearance.Number1"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/s2"
        android:id="@+id/angle_60"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size_2dp"
        app:layout_constraintBottom_toTopOf="@+id/ruler_too_big"
        app:layout_constraintEnd_toEndOf="@+id/ruler_too_big"
        style="@style/Rainbow.TextAppearance.Number1"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/s2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_12dp"
        android:text="@string/headset_cervical_protection_press_des_1"
        app:layout_constraintEnd_toEndOf="@+id/ruler_normal"
        app:layout_constraintStart_toStartOf="@+id/ruler_normal"
        app:layout_constraintTop_toBottomOf="@+id/ruler_normal"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/s2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_12dp"
        android:text="@string/headset_cervical_protection_press_des_2"
        app:layout_constraintEnd_toEndOf="@+id/ruler_common"
        app:layout_constraintStart_toStartOf="@+id/ruler_common"
        app:layout_constraintTop_toBottomOf="@+id/ruler_common"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/s2"
        android:layout_width="@dimen/size_26dp"
        android:layout_height="@dimen/size_17dp"
        android:layout_marginTop="@dimen/size_12dp"
        android:text="@string/headset_cervical_protection_press_des_3"
        app:layout_constraintEnd_toEndOf="@+id/ruler_larger"
        app:layout_constraintStart_toStartOf="@+id/ruler_larger"
        app:layout_constraintTop_toBottomOf="@+id/ruler_larger"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/s2"
        android:layout_width="@dimen/size_26dp"
        android:layout_height="@dimen/size_17dp"
        android:layout_marginTop="@dimen/size_12dp"
        android:text="@string/headset_cervical_protection_press_des_4"
        app:layout_constraintEnd_toEndOf="@+id/ruler_too_big"
        app:layout_constraintStart_toStartOf="@+id/ruler_too_big"
        app:layout_constraintTop_toBottomOf="@+id/ruler_too_big"/>
    <View
        android:id="@+id/cervical_cursor"
        android:background="@drawable/shape_triangle"
        android:layout_width="@dimen/size_14dp"
        android:layout_height="@dimen/size_14dp"
        android:layout_marginBottom="@dimen/size_2dp"
        app:layout_constraintBottom_toBottomOf="@+id/ruler_normal"
        app:layout_constraintStart_toStartOf="@+id/ruler_normal"
        app:layout_constraintTop_toTopOf="@+id/ruler_normal"/>
</androidx.constraintlayout.widget.ConstraintLayout>
