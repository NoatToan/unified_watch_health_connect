<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/s10"
    android:scrollbars="none"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/s36"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/size_18dp"
        android:paddingEnd="@dimen/size_18dp">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_58dp"
            android:minHeight="@dimen/size_58dp">
            <TextView
                android:id="@+id/tv_category_confirm"
                android:layout_width="@dimen/size_130dp"
                android:layout_height="@dimen/size_22dp"
                android:text="@string/wl_invoice_category"
                android:layout_centerVertical="true"
                style="@style/ConfirmInVoiceHeadStyle"/>
            <TextView
                android:gravity="start"
                android:id="@+id/tv_category_massage_confirm"
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/wl_invoice_type_name"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@+id/tv_category_confirm"
                style="@style/ConfirmInVoiceContentStyle"/>
            <View
                android:background="@color/s4"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_invoice_head_confirm_confirm"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_58dp"
            android:minHeight="@dimen/size_58dp">
            <TextView
                android:id="@+id/tv_invoice_head_confirm"
                android:layout_width="@dimen/size_130dp"
                android:layout_height="@dimen/size_22dp"
                android:text="@string/wl_invoice_head"
                android:layout_centerVertical="true"
                style="@style/ConfirmInVoiceHeadStyle"/>
            <TextView
                android:gravity="start"
                android:id="@+id/tv_invoice_type_confirm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@+id/tv_invoice_head_confirm"
                style="@style/ConfirmInVoiceContentStyle"/>
            <View
                android:background="@color/s4"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_tax_payer_number_confirm_confirm"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_58dp"
            android:minHeight="@dimen/size_58dp">
            <TextView
                android:id="@+id/tv_taxpayer_number_confirm"
                android:layout_width="@dimen/size_130dp"
                android:layout_height="@dimen/size_22dp"
                android:text="@string/wl_invoice_taxpayer_number"
                android:layout_centerVertical="true"
                style="@style/ConfirmInVoiceHeadStyle"/>
            <TextView
                android:gravity="start"
                android:id="@+id/tv_taxpayer_number_content_confirm"
                android:paddingTop="@dimen/size_10dp"
                android:paddingBottom="@dimen/size_10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@+id/tv_taxpayer_number_confirm"
                style="@style/ConfirmInVoiceContentStyle"/>
            <View
                android:background="@color/s4"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_58dp"
            android:minHeight="@dimen/size_58dp">
            <TextView
                android:id="@+id/tv_content_confirm"
                android:layout_width="@dimen/size_130dp"
                android:layout_height="@dimen/size_22dp"
                android:text="@string/wl_invoice_content"
                android:layout_centerVertical="true"
                style="@style/ConfirmInVoiceHeadStyle"/>
            <TextView
                android:gravity="start"
                android:id="@+id/tv_content_massage_confirm"
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/wl_invoice_recharge_fee"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@+id/tv_content_confirm"
                style="@style/ConfirmInVoiceContentStyle"/>
            <View
                android:background="@color/s4"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_58dp"
            android:minHeight="@dimen/size_58dp">
            <TextView
                android:id="@+id/tv_money_confirm"
                android:layout_width="@dimen/size_130dp"
                android:layout_height="@dimen/size_22dp"
                android:text="@string/wl_invoice_money"
                android:layout_centerVertical="true"
                style="@style/ConfirmInVoiceHeadStyle"/>
            <TextView
                android:gravity="start"
                android:id="@+id/tv_money_amount_confirm"
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@+id/tv_money_confirm"
                style="@style/ConfirmInVoiceContentStyle"/>
            <View
                android:background="@color/s4"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/phoneInfoArea"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_58dp"
            android:minHeight="@dimen/size_58dp">
            <TextView
                android:id="@+id/tv_phone_confirm"
                android:layout_width="@dimen/size_130dp"
                android:layout_height="@dimen/size_22dp"
                android:text="@string/wl_invoice_phone"
                android:layout_centerVertical="true"
                style="@style/ConfirmInVoiceHeadStyle"/>
            <TextView
                android:gravity="start"
                android:id="@+id/tv_phone_massage_confirm"
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/wl_invoice_not_set"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@+id/tv_phone_confirm"
                style="@style/ConfirmInVoiceContentStyle"/>
            <View
                android:background="@color/s4"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/emailInfoArea"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_58dp"
            android:minHeight="@dimen/size_58dp">
            <TextView
                android:id="@+id/tv_email_confirm"
                android:layout_width="@dimen/size_130dp"
                android:layout_height="@dimen/size_22dp"
                android:text="@string/wl_invoice_email"
                android:layout_centerVertical="true"
                style="@style/ConfirmInVoiceHeadStyle"/>
            <TextView
                android:gravity="start"
                android:id="@+id/tv_email_massage_confirm"
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/wl_invoice_not_set"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@+id/tv_email_confirm"
                style="@style/ConfirmInVoiceContentStyle"/>
            <View
                android:background="@color/s4"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
    </LinearLayout>
    <Button
        android:id="@+id/tv_submit_confirm_confirm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size_24dp"
        android:text="@string/wl_invoice_submit_confirm"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/size_18dp"
        android:layout_marginEnd="@dimen/size_18dp"
        style="@style/Rainbow.Widget.Button.44.Circular"/>
</RelativeLayout>
