<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/axis_line1"
        android:background="@color/s4"
        android:layout_width="1dp"
        android:layout_height="24.8dp"
        android:layout_marginStart="13.9dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/axis"
        android:background="@drawable/td_circle_shape"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginTop="5.8dp"
        app:layout_constraintEnd_toEndOf="@+id/axis_line1"
        app:layout_constraintStart_toStartOf="@+id/axis_line1"
        app:layout_constraintTop_toBottomOf="@+id/axis_line1"/>
    <View
        android:id="@+id/axis_line2"
        android:background="@color/s4"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_marginTop="6.1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/axis_line1"
        app:layout_constraintStart_toStartOf="@+id/axis_line1"
        app:layout_constraintTop_toBottomOf="@+id/axis"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/s1"
        android:id="@+id/king_date_ymd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="27.8dp"
        app:layout_constraintBottom_toBottomOf="@+id/axis"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/axis"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@color/s38"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10.6dp"
        android:layout_marginBottom="@dimen/td_size_5dp"
        android:layout_marginStart="29dp"
        android:layout_marginEnd="@dimen/td_size_14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/king_date_ymd">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/king_icon"
            android:layout_width="@dimen/td_size_28dp"
            android:layout_height="@dimen/td_size_28dp"
            android:layout_marginTop="18.7dp"
            android:scaleType="centerCrop"
            android:layout_marginStart="14.3dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:layout_gravity="center_horizontal"
            android:background="@drawable/td_avatar_ring"
            android:layout_width="@dimen/td_size_28dp"
            android:layout_height="@dimen/td_size_28dp"
            android:layout_marginTop="18.7dp"
            android:scaleType="centerCrop"
            android:layout_marginStart="14.3dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7.7dp"
            android:src="@drawable/td_crown"
            app:layout_constraintEnd_toEndOf="@+id/king_icon"
            app:layout_constraintStart_toStartOf="@+id/king_icon"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="15.4sp"
            android:textColor="@color/s1"
            android:ellipsize="end"
            android:id="@+id/king_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14.7dp"
            android:lines="1"
            android:layout_marginStart="@dimen/td_size_14dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toStartOf="@+id/king_dominating_time"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toEndOf="@+id/king_icon"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="11.5sp"
            android:textColor="@color/s2"
            android:id="@+id/king_multiplex"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1.3dp"
            android:layout_marginBottom="14.7dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/king_name"
            app:layout_constraintTop_toBottomOf="@+id/king_name"/>
        <TextView
            android:textSize="15.4sp"
            android:textColor="#ff5353"
            android:gravity="end"
            android:id="@+id/king_dominating_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/td_size_5dp"
            android:layout_marginEnd="14.7dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toEndOf="@+id/king_name"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
