<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:background="@drawable/phn_shape_card_common"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="30dp"
    android:layout_marginEnd="30dp">
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/phn_reminder_popup_tilte"
        style="@style/Rainbow.TextAppearance.Title2"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/tv_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/phn_reminder_popup_desc_modify"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        style="@style/Rainbow.TextAppearance.Body3"/>
    <TextView
        android:textColor="@color/s41"
        android:id="@+id/tv_content_link"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/phn_reminder_support_device_desc"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        style="@style/Rainbow.TextAppearance.Body3"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/s1"
        android:gravity="center_horizontal"
        android:id="@+id/tv_confirm"
        android:background="@drawable/phn_shape_corners_bottom_s4"
        android:paddingTop="17dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/phn_common_confirm"/>
</LinearLayout>
