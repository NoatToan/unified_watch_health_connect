<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/bg_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/split_line_width_match_parent"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="9dp"/>
    <include layout="@layout/split_line_width_match_parent"/>
    <LinearLayout
        android:orientation="horizontal"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="53dp">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/dark_grey_text"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/id"
            android:layout_marginStart="24dp"/>
        <EditText
            android:textSize="14sp"
            android:textColor="@color/black_text"
            android:textColorHint="@color/grey_text"
            android:gravity="start|center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/id_edit_box"
            android:background="@color/white"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:hint="@string/wifi_input_id"
            android:maxLines="1"
            android:layout_weight="1"
            android:textCursorDrawable="@drawable/cursor_edit_box"
            android:layout_marginStart="34dp"/>
    </LinearLayout>
    <View
        android:background="@drawable/divider_settings_item"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <LinearLayout
        android:orientation="horizontal"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="53dp">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/dark_grey_text"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/password"
            android:layout_marginStart="24dp"/>
        <EditText
            android:textSize="14sp"
            android:textColor="@color/black_text"
            android:textColorHint="@color/grey_text"
            android:gravity="start|center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/pwd_edit_box"
            android:background="@color/white"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:hint="@string/wifi_password_edit_hint"
            android:maxLines="1"
            android:layout_weight="1"
            android:inputType="textPassword"
            android:textCursorDrawable="@drawable/cursor_edit_box"
            android:layout_marginStart="34dp"/>
    </LinearLayout>
</LinearLayout>
