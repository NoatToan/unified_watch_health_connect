<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/iv_prev"
            android:padding="@dimen/size_10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_arrow_back_20"
            app:tint="@color/s1"/>
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/s1"
            android:id="@+id/tv_year_month"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/size_20dp"
            android:layout_marginEnd="@dimen/size_20dp"
            style="@style/Rainbow.TextAppearance.Title2"/>
        <ImageView
            android:id="@+id/iv_next"
            android:padding="@dimen/size_10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_arrow_forward_20"
            app:tint="@color/s1"/>
    </LinearLayout>
    <View
        android:id="@+id/divider"
        android:layout_marginTop="@dimen/size_10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_title"
        style="@style/VerticalDivider"/>
    <com.haibin.calendarview.CalendarView
        android:id="@+id/calendarView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:calendar_height="46dp"
        app:calendar_padding="10dp"
        app:current_month_text_color="@color/s1"
        app:day_text_size="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider"
        app:month_view="com.xiaomi.hm.health.baseui.calendar.MonthView"
        app:month_view_auto_select_day="last_select_day"
        app:month_view_show_mode="mode_only_current"
        app:selected_text_color="@color/s5"
        app:selected_theme_color="@color/p3"
        app:week_background="@android:color/transparent"
        app:week_start_with="sun"
        app:week_text_color="@color/s3"
        app:week_text_size="10sp"/>
    <com.huami.lib.rainbow.ListTile
        android:id="@+id/time_tile"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/calendarView"
        app:ltv_leading="@drawable/ic_time_20"
        app:ltv_leadingTint="@color/s1"
        app:ltv_tips="14:00"
        app:ltv_title="@string/time"
        app:ltv_trailing="@drawable/ic_arrow_forward_20_2x"/>
</androidx.constraintlayout.widget.ConstraintLayout>
