<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/shape_corners_device_setting"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size_15dp"
        android:layout_marginStart="@dimen/size_16dp"
        android:layout_marginEnd="@dimen/size_16dp">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/s1"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_20dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"/>
        <View
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_marginTop="@dimen/size_20dp"/>
        <com.huami.widget.wheelview.WheelView
            android:id="@+id/wheelView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/size_40dp"
            android:layout_marginEnd="@dimen/size_40dp"/>
        <View
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="horizontal"
            android:paddingTop="@dimen/size_18dp"
            android:paddingBottom="@dimen/size_18dp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            app:divider="@drawable/dividing_line_shape"
            app:showDividers="middle">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/s2"
                android:gravity="center"
                android:id="@+id/btn_cancel"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/size_24dp"
                android:text="@string/cancel"
                android:layout_weight="1"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/s1"
                android:gravity="center"
                android:id="@+id/btn_yes"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/size_24dp"
                android:text="@string/yes"
                android:layout_weight="1"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </LinearLayout>
</FrameLayout>
