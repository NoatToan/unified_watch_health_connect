<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s36"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ListView
        android:id="@+id/applet_js_log_list_view"
        android:paddingLeft="@dimen/account_ui_size_10dp"
        android:paddingRight="@dimen/account_ui_size_10dp"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:transcriptMode="alwaysScroll"
        android:divider="@color/account_ui_gray"
        android:dividerHeight="@dimen/account_ui_size_0.5dp"
        android:headerDividersEnabled="false"
        android:footerDividersEnabled="false"
        app:layout_constraintBottom_toTopOf="@+id/applet_clear_log"
        app:layout_constraintTop_toTopOf="parent"/>
    <Button
        android:textSize="@dimen/applet_12dp"
        android:gravity="center"
        android:id="@+id/applet_clear_log"
        android:layout_width="match_parent"
        android:layout_height="@dimen/applet_48dp"
        android:layout_marginLeft="@dimen/account_ui_size_10dp"
        android:layout_marginRight="@dimen/account_ui_size_10dp"
        android:text="@string/applet_clear_log"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/applet_js_log_list_view"
        style="@style/Rainbow.Widget.Button.48"/>
    <RelativeLayout
        android:id="@+id/applet_no_data_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textColor="@color/s2"
            android:id="@+id/applet_js_log_no_data"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/applet_log_no_data"
            android:layout_centerInParent="true"/>
        <ProgressBar
            android:id="@+id/applet_js_log_progress"
            android:layout_width="@dimen/applet_40dp"
            android:layout_height="@dimen/applet_40dp"
            android:progressDrawable="@drawable/applet_setting_refresh"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
