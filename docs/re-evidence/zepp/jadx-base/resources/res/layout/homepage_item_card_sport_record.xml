<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/sport_record_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/homepage_item_card_sport_record"
        android:layout_marginStart="15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Rainbow.TextAppearance.Body3"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/s2"
        android:gravity="center"
        android:id="@+id/middle_bg"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="75dp"
        android:layout_marginTop="15dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        app:layout_constraintTop_toBottomOf="@+id/sport_record_title"
        style="@style/Rainbow.TextAppearance.Body5"/>
    <Space
        android:id="@+id/space_below_middle_bg"
        android:layout_width="match_parent"
        android:layout_height="15dp"
        app:layout_constraintTop_toBottomOf="@+id/middle_bg"/>
    <View
        android:id="@+id/middle_line"
        android:background="@color/s3"
        android:layout_width="1dp"
        android:layout_height="40dp"
        android:alpha="0.4"
        app:layout_constraintBottom_toBottomOf="@+id/middle_bg"
        app:layout_constraintEnd_toEndOf="@+id/middle_bg"
        app:layout_constraintStart_toStartOf="@+id/middle_bg"
        app:layout_constraintTop_toTopOf="@+id/middle_bg"/>
    <TextView
        android:textColor="@color/s2"
        android:id="@+id/sport_count_last_7_days"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toTopOf="@+id/sport_count_last_7_days_tip"
        app:layout_constraintEnd_toEndOf="@+id/middle_line"
        app:layout_constraintStart_toStartOf="@+id/middle_bg"
        app:layout_constraintTop_toTopOf="@+id/middle_bg"
        style="@style/Rainbow.TextAppearance.Body5"/>
    <TextView
        android:textColor="@color/s2"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/sport_count_last_7_days_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="13dp"
        android:maxWidth="132dp"
        android:text="@string/homepage_item_card_sport_count_last_7_days"
        android:maxLines="2"
        app:layout_constraintBottom_toBottomOf="@+id/middle_bg"
        app:layout_constraintEnd_toEndOf="@+id/middle_line"
        app:layout_constraintStart_toStartOf="@+id/middle_bg"
        app:layout_constraintTop_toBottomOf="@+id/sport_count_last_7_days"
        style="@style/Rainbow.TextAppearance.Body5"/>
    <TextView
        android:textColor="@color/s2"
        android:id="@+id/sport_duration_last_7_days"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/sport_count_last_7_days"
        app:layout_constraintEnd_toEndOf="@+id/middle_bg"
        app:layout_constraintStart_toStartOf="@+id/middle_line"
        app:layout_constraintTop_toTopOf="@+id/sport_count_last_7_days"
        style="@style/Rainbow.TextAppearance.Body5"/>
    <TextView
        android:textColor="@color/s2"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/sport_duration_last_7_days_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-4dp"
        android:maxWidth="132dp"
        android:text="@string/homepage_item_card_sport_duration_last_7_days"
        android:maxLines="2"
        app:layout_constraintBottom_toBottomOf="@+id/sport_count_last_7_days_tip"
        app:layout_constraintEnd_toEndOf="@+id/middle_bg"
        app:layout_constraintStart_toEndOf="@+id/middle_line"
        app:layout_constraintTop_toTopOf="@+id/sport_count_last_7_days_tip"
        style="@style/Rainbow.TextAppearance.Body5"/>
    <include
        android:id="@+id/sport_record_1"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/middle_bg"
        app:layout_constraintStart_toStartOf="@+id/middle_bg"
        app:layout_constraintTop_toBottomOf="@+id/space_below_middle_bg"
        layout="@layout/homepage_item_card_sport_record_inner"/>
    <include
        android:id="@+id/sport_record_2"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        app:layout_constraintEnd_toEndOf="@+id/middle_bg"
        app:layout_constraintStart_toStartOf="@+id/middle_bg"
        app:layout_constraintTop_toBottomOf="@+id/sport_record_1"
        layout="@layout/homepage_item_card_sport_record_inner"/>
    <TextView
        android:textColor="@color/s2"
        android:id="@+id/view_more"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="16dp"
        android:text="@string/homepage_item_card_view_more"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sport_record_2"
        style="@style/Rainbow.TextAppearance.Body4"/>
</androidx.constraintlayout.widget.ConstraintLayout>
