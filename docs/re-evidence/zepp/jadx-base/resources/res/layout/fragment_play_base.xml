<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/status_bar"
        android:background="@color/s38"
        android:layout_width="match_parent"
        android:layout_height="20dp"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="17.3sp"
        android:textColor="@color/s1"
        android:gravity="center"
        android:id="@+id/title"
        android:background="@color/s38"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/widget_health"/>
    <FrameLayout
        android:id="@+id/container"
        android:background="@color/s10"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/size_15sp"
            android:textColor="@color/s2"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/play_empty_view"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/play_intelligence_no_data"
            android:drawableTop="@drawable/play_intelligence_no_data"
            android:drawablePadding="10dp"
            android:layout_marginStart="42dp"
            android:layout_marginEnd="42dp"/>
    </FrameLayout>
</LinearLayout>
