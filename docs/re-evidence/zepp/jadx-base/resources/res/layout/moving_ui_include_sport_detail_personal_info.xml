<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_user_info"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/iv_fold"
            android:layout_width="20dp"
            android:layout_height="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_expand_more_20"
            app:tint="@color/s3"/>
        <TextView
            android:textColor="@color/s1"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/over_view_nickname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="38.4dp"
            android:maxWidth="186.7dp"
            android:singleLine="true"
            android:layout_marginStart="13.4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Rainbow.TextAppearance.Body3"/>
        <TextView
            android:textColor="@color/s2"
            android:id="@+id/over_view_start_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:layout_constraintStart_toStartOf="@+id/over_view_nickname"
            app:layout_constraintTop_toBottomOf="@+id/over_view_nickname"
            style="@style/Rainbow.TextAppearance.Body5"/>
        <ImageView
            android:visibility="gone"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginEnd="2dp"
            app:layout_constraintBottom_toBottomOf="@+id/over_view_start_time"
            app:layout_constraintEnd_toStartOf="@+id/tv_lable_temperature"
            app:layout_constraintTop_toTopOf="@+id/over_view_start_time"
            app:srcCompat="@drawable/ic_cloudy_12_s2"/>
        <TextView
            android:textColor="@color/s2"
            android:id="@+id/tv_lable_temperature"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="20"
            android:layout_marginEnd="13dp"
            app:layout_constraintEnd_toStartOf="@+id/iv_humidity"
            app:layout_constraintTop_toTopOf="@+id/over_view_start_time"
            style="@style/Rainbow.TextAppearance.Body5"/>
        <ImageView
            android:id="@+id/iv_humidity"
            android:visibility="gone"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginEnd="2dp"
            app:layout_constraintBottom_toBottomOf="@+id/over_view_start_time"
            app:layout_constraintEnd_toStartOf="@+id/tv_lable_humidity"
            app:layout_constraintTop_toTopOf="@+id/over_view_start_time"
            app:srcCompat="@drawable/ic_humidity_12_s2"/>
        <TextView
            android:textColor="@color/s2"
            android:id="@+id/tv_lable_humidity"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="18%"
            android:layout_marginEnd="13dp"
            app:layout_constraintEnd_toStartOf="@+id/iv_speed"
            app:layout_constraintTop_toTopOf="@+id/over_view_start_time"
            style="@style/Rainbow.TextAppearance.Body5"/>
        <ImageView
            android:id="@+id/iv_speed"
            android:visibility="gone"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginEnd="2dp"
            app:layout_constraintBottom_toBottomOf="@+id/over_view_start_time"
            app:layout_constraintEnd_toStartOf="@+id/tv_lable_speed"
            app:layout_constraintTop_toTopOf="@+id/over_view_start_time"
            app:srcCompat="@drawable/ic_wind_northwest_12_s2"/>
        <TextView
            android:textColor="@color/s2"
            android:id="@+id/tv_lable_speed"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3km/h"
            android:layout_marginEnd="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/over_view_start_time"
            style="@style/Rainbow.TextAppearance.Body5"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="48sp"
            android:textColor="@color/s1"
            android:id="@+id/over_view_main_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:fontFamily="km"
            android:layout_marginEnd="6dp"
            app:layout_constraintEnd_toStartOf="@+id/over_view_main_unit"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textColor="@color/s1"
            android:id="@+id/over_view_main_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="13dp"
            app:layout_constraintBottom_toBottomOf="@+id/over_view_nickname"
            app:layout_constraintEnd_toEndOf="parent"
            style="@style/Rainbow.TextAppearance.Body3"/>
        <com.huami.moving.ui.view.FastSlowGradientView
            android:id="@+id/over_view_gradient"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="19.7dp"
            app:endY="0"
            app:layout_constraintTop_toBottomOf="@+id/over_view_start_time"
            app:linearColors="@array/fast_slow_gradient_colors"
            app:linearPositions="@array/fast_slow_gradient_percents"/>
        <TextView
            android:textColor="@color/s20"
            android:id="@+id/over_view_slow"
            android:background="#f6f7f8"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="13.9dp"
            android:text="@string/over_view_gradient_slow"
            app:layout_constraintStart_toStartOf="@+id/over_view_start_time"
            app:layout_constraintTop_toBottomOf="@+id/over_view_start_time"
            style="@style/Rainbow.TextAppearance.Body5"/>
        <TextView
            android:textColor="@color/p3"
            android:id="@+id/over_view_fast"
            android:background="#f6f7f8"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="13.9dp"
            android:text="@string/over_view_gradient_fast"
            app:layout_constraintEnd_toEndOf="@+id/over_view_main_unit"
            app:layout_constraintTop_toBottomOf="@+id/over_view_start_time"
            style="@style/Rainbow.TextAppearance.Body5"/>
        <View
            android:id="@+id/over_view_replace"
            android:background="@color/over_view_divide_color"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="21.7dp"
            app:layout_constraintTop_toBottomOf="@+id/over_view_start_time"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <RelativeLayout
        android:id="@+id/rl_sport_head_no_map"
        android:background="#f2f2f2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textColor="#ff8c46"
            android:id="@+id/sport_head_no_map"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sport_detail_no_gps_data"
            android:drawablePadding="2dp"
            android:layout_centerInParent="true"
            android:drawableEnd="@drawable/ic_tips_16_s31"
            style="@style/Rainbow.TextAppearance.Body4"/>
    </RelativeLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_user_info_no_gps"
        android:background="@drawable/moving_ui_sport_detail_no_gps"
        android:paddingBottom="15dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rl_sport_head_no_map">
        <ImageView
            android:id="@+id/over_view_avatar_no_gps"
            android:background="@drawable/user_avatar_ring_bg_thick"
            android:padding="2dp"
            android:layout_width="43.3dp"
            android:layout_height="43.3dp"
            android:layout_marginTop="13.4dp"
            android:src="@drawable/default_user_avatar"
            android:layout_marginStart="13.4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/iv_logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="13.4dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_sport_detail_logo"/>
        <TextView
            android:textColor="@color/s5"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/over_view_nickname_no_gps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:maxWidth="186.7dp"
            android:singleLine="true"
            android:layout_marginStart="13.4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/over_view_avatar_no_gps"
            style="@style/Rainbow.TextAppearance.Body3"/>
        <TextView
            android:textColor="@color/s5"
            android:id="@+id/over_view_start_time_no_gps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:layout_constraintStart_toStartOf="@+id/over_view_nickname_no_gps"
            app:layout_constraintTop_toBottomOf="@+id/over_view_nickname_no_gps"
            style="@style/Rainbow.TextAppearance.Body5"/>
        <TextView
            android:textColor="@color/s2"
            android:id="@+id/tv_label_temperature_no_gps"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="20"
            android:drawablePadding="2dp"
            android:layout_marginEnd="13dp"
            app:drawableStartCompat="@drawable/ic_cloudy_12_s2"
            app:layout_constraintEnd_toStartOf="@+id/tv_label_humidity_no_gps"
            app:layout_constraintTop_toTopOf="@+id/over_view_start_time_no_gps"
            style="@style/Rainbow.TextAppearance.Body5"/>
        <TextView
            android:textColor="@color/s2"
            android:id="@+id/tv_label_humidity_no_gps"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="18%"
            android:drawablePadding="2dp"
            android:layout_marginEnd="13dp"
            app:drawableStartCompat="@drawable/ic_humidity_12_s2"
            app:layout_constraintEnd_toStartOf="@+id/tv_label_speed_no_gps"
            app:layout_constraintTop_toTopOf="@+id/over_view_start_time_no_gps"
            style="@style/Rainbow.TextAppearance.Body5"/>
        <TextView
            android:textColor="@color/s2"
            android:id="@+id/tv_label_speed_no_gps"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3km/h"
            android:drawablePadding="2dp"
            android:layout_marginEnd="12dp"
            app:drawableStartCompat="@drawable/ic_wind_northwest_12_s2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/over_view_start_time_no_gps"
            style="@style/Rainbow.TextAppearance.Body5"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="48sp"
            android:textColor="@color/s5"
            android:id="@+id/over_view_main_value_no_gps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="km"
            android:layout_marginEnd="6dp"
            app:layout_constraintEnd_toStartOf="@+id/over_view_main_unit_no_gps"
            app:layout_constraintTop_toBottomOf="@+id/iv_logo"/>
        <TextView
            android:textColor="@color/s5"
            android:id="@+id/over_view_main_unit_no_gps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            app:layout_constraintBottom_toBottomOf="@+id/over_view_nickname_no_gps"
            app:layout_constraintEnd_toStartOf="@+id/iv_distance_verify"
            style="@style/Rainbow.TextAppearance.Body3"/>
        <ImageView
            android:id="@+id/iv_distance_verify"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="13.4dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/over_view_nickname_no_gps"
            app:layout_constraintEnd_toEndOf="parent"
            app:srcCompat="@drawable/ic_edit_20"
            app:tint="@color/s5"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
