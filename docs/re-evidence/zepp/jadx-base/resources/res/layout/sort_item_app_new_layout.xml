<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/s38"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:background="@color/s10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/s2"
            android:gravity="center_vertical"
            android:id="@+id/divider_item"
            android:background="@color/s10"
            android:paddingTop="15dp"
            android:paddingBottom="9dp"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sort_new_item"
            android:paddingStart="18dp"
            android:paddingEnd="0dp"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/sort_item_group"
        android:background="@color/s38"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/sort_icon"
            android:background="@color/s38"
            android:layout_width="46dp"
            android:layout_height="60dp"
            android:scaleType="centerInside"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/s1"
            android:gravity="start"
            android:id="@+id/sort_item_text"
            android:background="@color/s38"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/sort_item_drag_area"
            android:layout_toEndOf="@+id/sort_icon"/>
        <RelativeLayout
            android:id="@+id/sort_item_drag_area"
            android:background="@color/s38"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_alignParentEnd="true">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/sort_drag_item"
                android:background="@color/s38"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/sort_icon"
                android:tint="@color/s2"
                android:layout_centerVertical="true"
                android:layout_marginEnd="18dp"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </RelativeLayout>
</LinearLayout>
