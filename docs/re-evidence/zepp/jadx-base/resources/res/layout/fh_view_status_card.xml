<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iv_card_icon"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="30dp"
        android:src="@drawable/fh_card_icon"
        android:layout_marginStart="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/s1"
        android:id="@+id/tv_card_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="@string/fh_female_health"
        android:layout_marginStart="15dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_card_date"
        app:layout_constraintStart_toEndOf="@+id/iv_card_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#ff8d8d8d"
        android:ellipsize="end"
        android:id="@+id/tv_card_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:maxLines="1"
        android:singleLine="true"
        android:layout_marginStart="15dp"
        app:layout_constraintStart_toEndOf="@+id/iv_card_icon"
        app:layout_constraintTop_toBottomOf="@+id/tv_card_title"
        app:layout_constraintVertical_chainStyle="packed"/>
    <com.huami.femalehealth.uilib.widget.calendar.week.CalendarWeekLayout
        android:orientation="vertical"
        android:id="@+id/calendar_week_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        app:calendar_content_view_id="@+id/recyclerView"
        app:calendar_show_mode="only_week_view"
        app:default_status="shrink"
        app:layout_constraintBottom_toTopOf="@+id/tv_card_dur"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <com.huami.calendarview.CalendarView
            android:id="@+id/calendar_week"
            android:background="@color/s38"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:calendar_height="43.5dp"
            app:calendar_show_mode="only_week_view"
            app:current_month_lunar_text_color="#cfcfcf"
            app:current_month_text_color="@color/fh_current_month_text_color"
            app:default_status="shrink"
            app:month_view_show_mode="mode_fix"
            app:other_month_text_color="@color/fh_other_month_text_color"
            app:select_mode="single_mode"
            app:week_bar_height="0dp"
            app:week_start_with="sun"
            app:week_view="com.huami.femalehealth.uilib.widget.calendar.week.CalendarWeekView"
            app:week_view_scrollable="false"/>
    </com.huami.femalehealth.uilib.widget.calendar.week.CalendarWeekLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="#ff8d8d8d"
        android:id="@+id/tv_card_dur"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:layout_marginStart="23dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
