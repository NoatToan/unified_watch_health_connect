<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/item_view"
    android:layout_width="match_parent"
    android:layout_height="57dp">
    <TextView
        android:textSize="15sp"
        android:textColor="@color/black70"
        android:id="@+id/action_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="18sp"
        android:textColor="@color/black70"
        android:id="@+id/action_freq"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBaseline="@+id/action_name"
        android:layout_centerVertical="true"
        android:fontFamily="km"
        android:layout_marginStart="6dp"
        android:layout_toEndOf="@+id/action_name"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/black70"
        android:id="@+id/action_freq_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/times"
        android:layout_centerVertical="true"
        android:layout_marginStart="4dp"
        android:layout_toEndOf="@+id/action_freq"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="14sp"
        android:textColor="@color/black40"
        android:id="@+id/action_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:fontFamily="km"
        android:layout_alignParentEnd="true"/>
    <View
        android:layout_alignParentBottom="true"
        style="@style/VerticalDivider"/>
</RelativeLayout>
