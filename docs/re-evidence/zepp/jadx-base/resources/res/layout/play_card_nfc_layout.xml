<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include
        android:id="@+id/ll_title"
        layout="@layout/play_card_common_title"/>
    <TextView
        android:textSize="13sp"
        android:textColor="#666666"
        android:ellipsize="end"
        android:id="@+id/tv_desc"
        android:paddingBottom="15dp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="2"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="@dimen/play_margin_15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/ll_title"
        app:layout_constraintTop_toBottomOf="@+id/ll_title"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/play_title_size"
        android:textColor="@android:color/white"
        android:gravity="center_vertical"
        android:id="@+id/nfc_bus"
        android:background="@drawable/play_nfc_bus_bg"
        android:padding="10dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="15dp"
        android:text="@string/nfc_bus_card"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="7dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/nfc_door"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_title"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/play_title_size"
        android:textColor="@android:color/white"
        android:gravity="center_vertical"
        android:id="@+id/nfc_door"
        android:background="@drawable/play_nfc_door_bg"
        android:padding="10dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="15dp"
        android:text="@string/nfc_door_card"
        android:layout_marginStart="7dp"
        android:layout_marginEnd="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/nfc_bus"
        app:layout_constraintTop_toBottomOf="@+id/ll_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
