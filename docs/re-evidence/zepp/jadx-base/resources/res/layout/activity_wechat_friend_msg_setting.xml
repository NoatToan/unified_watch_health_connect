<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.watch.companion.ui.view.ActionbarLayout
        android:id="@+id/actionbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/bg_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/dark_red_border"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22.3dp"
            android:layout_marginBottom="10dp"
            android:text="@string/noti_wechat_top_tip"
            android:paddingStart="24dp"/>
        <View
            android:background="@drawable/divider_width_match_parent"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <LinearLayout
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_gravity="center_vertical"
                android:id="@+id/enable_filter_view"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="62.7dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@drawable/color_text_may_disable"
                    android:gravity="center_vertical"
                    android:layout_gravity="center"
                    android:duplicateParentState="true"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/noti_wechat_switch_tip"
                    android:layout_weight="1"/>
                <Switch
                    android:id="@+id/enable_filter_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:textOn=""
                    android:textOff=""
                    style="@style/WatchSwitch"/>
            </LinearLayout>
        </LinearLayout>
        <View
            android:background="@drawable/divider_width_match_parent"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/add_wechat_friend_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/grey_text"
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/noti_wechat_tip1"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/friend_list_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <View
                    android:background="@drawable/divider_width_match_parent"
                    android:layout_width="match_parent"
                    android:layout_height="1px"/>
                <ListView
                    android:id="@+id/friend_list"
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@color/divider_color"
                    android:dividerHeight="1px"/>
            </LinearLayout>
            <View
                android:background="@drawable/divider_width_match_parent"
                android:layout_width="match_parent"
                android:layout_height="1px"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/add_wechat_friend_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <EditText
                    android:textSize="14sp"
                    android:textColor="@color/black_text"
                    android:textColorHint="@color/dark_grey_text"
                    android:id="@+id/add_wechat_friend_et"
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="@string/noti_wechat_edit_hint"
                    android:singleLine="true"
                    android:textCursorDrawable="@drawable/cursor_edit_box"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"/>
                <View
                    android:background="@drawable/divider_width_match_parent"
                    android:layout_width="match_parent"
                    android:layout_height="1px"/>
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@drawable/color_text_red_black"
                    android:gravity="center"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/add_wechat_friend_btn"
                    android:background="@drawable/bg_big_btn_border"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="39dp"
                    android:layout_marginTop="14.7dp"
                    android:text="@string/noti_wechat_add"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="24dp"/>
            </LinearLayout>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/grey_text"
                android:layout_gravity="center_horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16.7dp"
                android:text="@string/noti_wechat_tip2"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
