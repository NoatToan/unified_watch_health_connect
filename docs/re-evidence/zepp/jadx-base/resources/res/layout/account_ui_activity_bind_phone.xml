<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/s36"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.lib.rainbow.titlebar.RainbowTitleBar
        android:id="@+id/bind_phone_title_bar"
        android:background="@color/account_ui_transparency"
        android:layout_width="match_parent"
        android:layout_height="@dimen/account_ui_size_50dp"
        app:title="@string/account_ui_account_bind_phone"/>
    <TextView
        android:textSize="@dimen/account_ui_size_12sp"
        android:textColor="@color/s2"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/account_ui_size_24dp"
        android:text="@string/account_ui_account_bind_phone_tip"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:background="@drawable/account_ui_bg_login_edit"
        android:layout_width="match_parent"
        android:layout_height="@dimen/account_ui_hm_email_input_height"
        android:layout_marginTop="11dp"
        android:layout_marginStart="@dimen/account_ui_hm_email_input_margin"
        android:layout_marginEnd="@dimen/account_ui_hm_email_input_margin">
        <TextView
            android:textSize="@dimen/account_ui_size_15sp"
            android:textColor="@color/s2"
            android:gravity="center_vertical"
            android:paddingBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/account_ui_hm_email_input_height"
            android:text="+86"
            android:layout_marginStart="@dimen/account_ui_size_15dp"
            android:layout_marginEnd="10dp"/>
        <View
            android:layout_gravity="center_vertical"
            android:background="@color/s4"
            android:layout_width="1dp"
            android:layout_height="26dp"/>
        <androidx.appcompat.widget.AppCompatEditText
            android:textSize="@dimen/account_ui_hm_email_text_size"
            android:textColor="@color/s1"
            android:textColorHint="@color/s3"
            android:id="@+id/input_phone_number"
            android:background="@color/account_ui_transparency"
            android:layout_width="match_parent"
            android:layout_height="@dimen/account_ui_hm_email_input_height"
            android:hint="@string/account_ui_account_input_phone"
            android:inputType="phone"
            android:textAlignment="viewStart"
            android:paddingStart="@dimen/account_ui_size_15dp"
            android:paddingEnd="@dimen/account_ui_size_15dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/hm_email_password"
        android:background="@drawable/account_ui_bg_login_edit"
        android:layout_width="match_parent"
        android:layout_height="@dimen/account_ui_hm_email_input_height"
        android:layout_marginTop="@dimen/account_ui_hm_email_password_margin_top"
        android:layout_marginStart="@dimen/account_ui_hm_email_input_margin"
        android:layout_marginEnd="@dimen/account_ui_hm_email_input_margin">
        <androidx.appcompat.widget.AppCompatEditText
            android:textSize="@dimen/account_ui_hm_email_text_size"
            android:textColor="@color/s1"
            android:textColorHint="@color/s3"
            android:id="@+id/input_password_text"
            android:background="@color/account_ui_trans"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:hint="@string/account_ui_account_input_password"
            android:layout_weight="1"
            android:inputType="textPassword"
            android:textAlignment="viewStart"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"/>
        <ImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/input_password_show"
            android:layout_width="@dimen/account_ui_hm_email_input_password_show_size"
            android:layout_height="@dimen/account_ui_hm_email_input_password_show_size"
            android:src="@drawable/account_ui_hm_email_eye_close"
            android:scaleType="centerInside"
            android:alpha="0.4"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/account_ui_size_12sp"
        android:textColor="@color/s2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/account_ui_size_12dp"
        android:layout_marginBottom="@dimen/account_ui_size_12dp"
        android:text="@string/account_ui_register_phone_set_password_tip"
        android:layout_marginStart="@dimen/account_ui_hm_email_input_margin"
        android:layout_marginEnd="@dimen/account_ui_hm_email_input_margin"/>
    <LinearLayout
        android:orientation="horizontal"
        android:background="@drawable/account_ui_bg_login_edit"
        android:layout_width="match_parent"
        android:layout_height="@dimen/account_ui_hm_email_input_height"
        android:layout_marginStart="@dimen/account_ui_hm_email_input_margin"
        android:layout_marginEnd="@dimen/account_ui_hm_email_input_margin">
        <androidx.appcompat.widget.AppCompatEditText
            android:textSize="@dimen/account_ui_hm_email_text_size"
            android:textColor="@color/s1"
            android:textColorHint="@color/s3"
            android:id="@+id/input_password_text_again"
            android:background="@color/account_ui_trans"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:hint="@string/account_ui_account_input_password_again"
            android:layout_weight="1"
            android:inputType="textPassword"
            android:textAlignment="viewStart"
            android:paddingStart="@dimen/account_ui_size_15dp"
            android:paddingEnd="@dimen/account_ui_size_15dp"/>
        <ImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/input_password_show_again"
            android:layout_width="@dimen/account_ui_hm_email_input_password_show_size"
            android:layout_height="@dimen/account_ui_hm_email_input_password_show_size"
            android:src="@drawable/account_ui_hm_email_eye_close"
            android:scaleType="centerInside"
            android:alpha="0.4"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/hm_email_verification_code_rl"
        android:layout_width="match_parent"
        android:layout_height="@dimen/account_ui_hm_email_input_height"
        android:layout_marginTop="@dimen/account_ui_hm_email_password_margin_top"
        android:layout_marginStart="@dimen/account_ui_hm_email_input_margin"
        android:layout_marginEnd="@dimen/account_ui_hm_email_input_margin">
        <androidx.appcompat.widget.AppCompatEditText
            android:textSize="@dimen/account_ui_hm_email_text_size"
            android:textColor="@color/s1"
            android:textColorHint="@color/s3"
            android:gravity="center_vertical"
            android:id="@+id/input_verification_code"
            android:background="@drawable/account_ui_bg_login_edit"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:hint="@string/account_ui_account_input_verify_code"
            android:maxEms="6"
            android:layout_weight="1"
            android:inputType="numberDecimal"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"/>
        <Space
            android:layout_width="@dimen/account_ui_size_10dp"
            android:layout_height="match_parent"/>
        <TextView
            android:id="@+id/send_verify_btn"
            android:text="@string/account_ui_account_get_verify_code"
            style="@style/AccountUiGetVerificationCodeButton"/>
    </LinearLayout>
    <TextView
        android:enabled="false"
        android:textSize="@dimen/account_ui_login_btn_text_size"
        android:textColor="@color/account_ui_select_alive_btn_txt_color"
        android:gravity="center"
        android:id="@+id/next_step_btn"
        android:background="@drawable/account_ui_btn_bg_login"
        android:layout_width="match_parent"
        android:layout_height="@dimen/account_ui_click_button_h"
        android:layout_marginTop="60dp"
        android:text="@string/account_ui_next_step"
        android:layout_marginStart="@dimen/account_ui_hm_email_input_margin"
        android:layout_marginEnd="@dimen/account_ui_hm_email_input_margin"/>
</LinearLayout>
