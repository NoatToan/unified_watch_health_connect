<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/shape_rect_radius_10_s5"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/s1"
        android:gravity="center"
        android:id="@+id/dialog_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="30dp"
        android:layout_marginRight="16dp"
        android:text="@string/health_label_manager_delete_title"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Rainbow.TextAppearance.Title3"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="15sp"
        android:textColor="@color/s1"
        android:gravity="start"
        android:id="@+id/dialog_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:text="@string/health_label_delete"
        android:lineSpacingExtra="8dp"
        android:layout_marginStart="33dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dialog_title"/>
    <View
        android:id="@+id/divider1"
        android:background="@color/s4"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="30dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dialog_content"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/s1"
        android:gravity="center"
        android:id="@+id/dialog_cancel"
        android:background="?android:attr/selectableItemBackground"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:text="@string/health_label_manager_cancel"
        app:layout_constraintEnd_toStartOf="@+id/divider2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider1"/>
    <View
        android:id="@+id/divider2"
        android:background="@color/s4"
        android:layout_width="1dp"
        android:layout_height="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/dialog_cancel"
        app:layout_constraintEnd_toStartOf="@+id/dialog_ok"
        app:layout_constraintStart_toEndOf="@+id/dialog_cancel"
        app:layout_constraintTop_toTopOf="@+id/dialog_cancel"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/health_label_text_red"
        android:gravity="center"
        android:id="@+id/dialog_ok"
        android:background="?android:attr/selectableItemBackground"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:text="@string/health_label_manager_delete"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/divider2"
        app:layout_constraintTop_toTopOf="@+id/dialog_cancel"/>
</androidx.constraintlayout.widget.ConstraintLayout>
