<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/s38"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_training_status"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textColor="@color/s2"
            android:id="@+id/tv_training_analysis_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:text="@string/phn_training_analysis_status"
            android:drawablePadding="4dp"
            android:drawableEnd="@drawable/phn_layer_list_tips_12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Rainbow.TextAppearance.Body4"/>
        <TextView
            android:textColor="@color/s1"
            android:id="@+id/tv_training_analysis_status_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="@+id/tv_training_analysis_status"
            app:layout_constraintStart_toStartOf="@+id/tv_training_analysis_status"
            app:layout_constraintTop_toBottomOf="@+id/tv_training_analysis_status"
            style="@style/Rainbow.TextAppearance.Number2"/>
        <TextView
            android:textColor="@color/s1"
            android:id="@+id/tv_training_analysis_status_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="9dp"
            app:layout_constraintBottom_toBottomOf="@+id/tv_training_analysis_status_value"
            app:layout_constraintStart_toEndOf="@+id/tv_training_analysis_status_value"
            style="@style/Rainbow.TextAppearance.Body4"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_fatigue_fitness"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textColor="@color/s2"
            android:id="@+id/tv_training_analysis_fatigue_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:text="@string/phn_training_analysis_fatigue_level"
            android:drawablePadding="4dp"
            android:drawableEnd="@drawable/phn_layer_list_tips_12"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="@+id/Guideline"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Rainbow.TextAppearance.Body4"/>
        <TextView
            android:textColor="@color/s1"
            android:id="@+id/tv_training_analysis_fatigue_level_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="@+id/tv_training_analysis_fatigue_level"
            app:layout_constraintStart_toStartOf="@+id/tv_training_analysis_fatigue_level"
            app:layout_constraintTop_toBottomOf="@+id/tv_training_analysis_fatigue_level"
            style="@style/Rainbow.TextAppearance.Number2"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/Guideline"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            app:layout_constraintGuide_percent="0.5"/>
        <TextView
            android:textColor="@color/s2"
            android:id="@+id/tv_training_analysis_fitness_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:text="@string/phn_training_analysis_fitness_level"
            android:drawablePadding="4dp"
            android:drawableEnd="@drawable/phn_layer_list_tips_12"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/Guideline"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Rainbow.TextAppearance.Body4"/>
        <TextView
            android:textColor="@color/s1"
            android:id="@+id/tv_training_analysis_fitness_level_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="@+id/tv_training_analysis_fitness_level"
            app:layout_constraintStart_toStartOf="@+id/tv_training_analysis_fitness_level"
            app:layout_constraintTop_toBottomOf="@+id/tv_training_analysis_fitness_level"
            style="@style/Rainbow.TextAppearance.Number2"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textColor="@color/s2"
        android:layout_gravity="center"
        android:id="@+id/tv_x_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/Rainbow.TextAppearance.Number8"/>
    <RelativeLayout
        android:id="@+id/rl_training_status_chart"
        android:layout_width="match_parent"
        android:layout_height="205dp"
        android:layout_marginTop="10dp"/>
</LinearLayout>
