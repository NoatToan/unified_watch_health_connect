<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/action_bar"
        android:background="@color/white"
        android:layout_width="0dp"
        android:layout_height="@dimen/size_48dp"
        android:paddingStart="@dimen/size_15dp"
        android:paddingEnd="@dimen/size_15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="16sp"
            android:textColor="#ff191919"
            android:gravity="center"
            android:id="@+id/tv_cancel"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/cancel"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#ff000000"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/btn_text_stupid_color"
            android:gravity="center"
            android:id="@+id/tv_connect"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/link"/>
    </LinearLayout>
    <com.huami.watch.companion.ui.view.PasswordEditText
        android:textSize="14sp"
        android:textColor="@color/black_text"
        android:textColorHint="@color/grey_text"
        android:gravity="start|center_vertical"
        android:id="@+id/wifi_pwd_edit_box"
        android:background="@color/white"
        android:layout_width="0dp"
        android:layout_height="@dimen/size_48dp"
        android:layout_margin="@dimen/td_size_30dp"
        android:hint="@string/wifi_password_edit_hint"
        android:inputType="textPassword"
        android:paddingStart="@dimen/td_size_5dp"
        android:paddingEnd="@dimen/td_size_5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_bar"/>
</androidx.constraintlayout.widget.ConstraintLayout>
