<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="22dp"
        android:paddingBottom="21dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/dialog_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_all_done_20_2x"
                android:layout_marginStart="@dimen/size_20dp"
                app:tint="@color/p4"/>
            <TextView
                android:textColor="@color/s1"
                android:gravity="center_vertical"
                android:id="@+id/dialog_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/size_45dp"
                style="@style/Rainbow.TextAppearance.Body3"/>
        </FrameLayout>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/s1"
            android:gravity="center_vertical"
            android:id="@+id/dialog_sub_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/size_45dp"
            style="@style/Rainbow.TextAppearance.Body3"/>
    </LinearLayout>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/dialog_divider"
        android:background="@color/divider"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider"/>
</merge>
