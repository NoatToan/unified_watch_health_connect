<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/size_62dp">
    <TextView
        android:id="@+id/world_clock_time_hourMinute"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/size_18dp"
        app:layout_constraintBottom_toTopOf="@+id/world_clock_mouthDay"
        app:layout_constraintEnd_toStartOf="@+id/drag_button"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_goneMarginEnd="@dimen/size_16dp"
        style="@style/world_clock_city"/>
    <TextView
        android:id="@+id/world_clock_mouthDay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/world_clock_time_hourMinute"
        app:layout_constraintTop_toBottomOf="@+id/world_clock_time_hourMinute"
        style="@style/world_clock_country"/>
    <ImageButton
        android:id="@+id/drag_button"
        android:background="@android:color/transparent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/mi_icon_world_clock_move"
        android:layout_marginEnd="@dimen/size_18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageButton
        android:id="@+id/world_clock_delete"
        android:background="@android:color/transparent"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/mi_icon_world_clock_delete"
        android:layout_marginStart="@dimen/size_18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/world_clock_city"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_18dp"
        app:layout_constraintBottom_toTopOf="@+id/jet_lag"
        app:layout_constraintStart_toEndOf="@+id/world_clock_delete"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintVertical_weight="1"
        app:layout_goneMarginStart="@dimen/size_16dp"
        style="@style/world_clock_city"/>
    <TextView
        android:id="@+id/jet_lag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/world_clock_city"
        app:layout_constraintTop_toBottomOf="@+id/world_clock_city"
        app:layout_constraintVertical_chainStyle="spread"
        style="@style/world_clock_country"/>
</androidx.constraintlayout.widget.ConstraintLayout>
