<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="70dp">
    <ImageView
        android:id="@+id/bf_score_ll_pre"
        android:background="@drawable/shape_circle_s4"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_bmi_24"
        android:scaleType="center"
        android:layout_centerVertical="true"
        android:layout_marginStart="20dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="10.3dp"
        android:layout_toEndOf="@+id/bf_score_ll_pre">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_bf3_params"
            android:layout_width="wrap_content"
            android:layout_height="26dp">
            <TextView
                android:textColor="@color/s1"
                android:layout_gravity="center"
                android:id="@+id/params_name_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Rainbow.TextAppearance.Body3"/>
            <com.huami.lib.view.text.UnitTextView
                android:textSize="16sp"
                android:textColor="@color/s1"
                android:layout_gravity="center"
                android:id="@+id/params_value_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:typeface="km"
                app:unitColor="@color/s1"
                app:unitSize="16sp"/>
        </LinearLayout>
        <TextView
            android:textColor="@color/s2"
            android:gravity="center"
            android:id="@+id/content_state_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            style="@style/Rainbow.TextAppearance.Body5"/>
    </LinearLayout>
    <View
        android:id="@+id/divider_bottom"
        android:background="@color/s4"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="20dp"/>
</RelativeLayout>
