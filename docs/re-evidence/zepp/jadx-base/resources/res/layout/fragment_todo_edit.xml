<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?android:attr/windowBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.lib.rainbow.titlebar.RainbowTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menuText="@string/save"
        app:menuTint="@color/rainbow_btn_stroke_text_color_selector"
        app:navigationText="@string/cancel"
        app:navigationTint="@color/rainbow_btn_gray_text_color_selector"
        app:title="@string/todo_list_add"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.huami.lib.rainbow.shapeable.ShapeableConstraintLayout
                android:background="?android:attr/colorBackground"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_200dp"
                android:layout_marginTop="@dimen/size_12dp"
                android:layout_marginStart="@dimen/size_10dp"
                android:layout_marginEnd="@dimen/size_10dp"
                app:shapeAppearance="@style/ShapeAppearance.App.Rounded">
                <androidx.appcompat.widget.AppCompatEditText
                    android:textColor="@color/s1"
                    android:gravity="start"
                    android:id="@+id/et_content"
                    android:background="@android:color/transparent"
                    android:paddingTop="@dimen/size_15dp"
                    android:paddingBottom="@dimen/size_15dp"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:textDirection="locale"
                    android:textAlignment="viewStart"
                    android:paddingStart="@dimen/size_15dp"
                    android:paddingEnd="@dimen/size_14dp"
                    app:layout_constraintEnd_toStartOf="@+id/tv_limit"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/Rainbow.TextAppearance.Body3"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textColor="@color/s3"
                    android:gravity="end"
                    android:id="@+id/tv_limit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_15dp"
                    android:minWidth="@dimen/size_21dp"
                    android:textDirection="locale"
                    android:textAlignment="viewEnd"
                    android:layout_marginEnd="@dimen/size_15dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/Rainbow.TextAppearance.Body4"/>
            </com.huami.lib.rainbow.shapeable.ShapeableConstraintLayout>
            <com.huami.lib.rainbow.shapeable.ShapeableLineLayout
                android:orientation="vertical"
                android:background="?android:attr/colorBackground"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_12dp"
                android:layout_marginStart="@dimen/size_10dp"
                android:layout_marginEnd="@dimen/size_10dp"
                app:shapeAppearance="@style/ShapeAppearance.App.Rounded">
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/date_tile"
                    android:background="@android:color/transparent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ltv_title="@string/todo_date"
                    app:ltv_trailing="@drawable/ic_arrow_forward_20_2x"/>
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/repeat_tile"
                    android:background="@android:color/transparent"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ltv_divider_padding="all"
                    app:ltv_title="@string/repeat"
                    app:ltv_trailing="@drawable/ic_arrow_forward_20_2x"/>
                <TextView
                    android:textColor="@color/rainbow_btn_stroke_text_color_selector"
                    android:gravity="center"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/delete_btn"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/size_10dp"
                    android:minHeight="@dimen/size_28dp"
                    android:text="@string/todo_delete_date"
                    style="@style/Rainbow.TextAppearance.Body4"/>
            </com.huami.lib.rainbow.shapeable.ShapeableLineLayout>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </ScrollView>
</androidx.appcompat.widget.LinearLayoutCompat>
