<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#fff6f7f8"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@color/color_white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">
        <View
            android:id="@+id/line1"
            android:background="@color/line_grey"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="21dp"
            app:layout_constraintTop_toBottomOf="@+id/tv_tips"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_icon"
            android:layout_width="126dp"
            android:layout_height="103dp"
            android:layout_marginTop="32dp"
            android:src="@drawable/set_now_time"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="12sp"
            android:textColor="@color/color_ff999999"
            android:gravity="center"
            android:id="@+id/tv_tips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="23dp"
            android:text="@string/now_time_set_tips"
            app:layout_constraintTop_toBottomOf="@+id/iv_icon"/>
        <com.xiaomi.hm.health.baseui.widget.ItemView
            android:id="@+id/item_enable"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            app:itemSwitch="true"
            app:itemTitle="@string/setting_now_time_title"
            app:layout_constraintTop_toBottomOf="@+id/line1"/>
        <com.xiaomi.hm.health.baseui.widget.ItemView
            android:id="@+id/item_start_time"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            app:itemEndArrow="true"
            app:itemTitle="@string/long_sit_alert_start"
            app:layout_constraintTop_toBottomOf="@+id/item_enable"/>
        <com.xiaomi.hm.health.baseui.widget.ItemView
            android:id="@+id/item_end_time"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            app:itemEndArrow="true"
            app:itemTitle="@string/long_sit_alert_stop"
            app:layout_constraintTop_toBottomOf="@+id/item_start_time"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
