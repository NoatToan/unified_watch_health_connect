<?xml version="1.0" encoding="utf-8"?>
<com.huami.hmchartui.ui.view.CommonCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_step_game"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="120dp"
    android:layout_marginTop="14dp"
    android:layout_marginStart="14dp"
    android:layout_marginEnd="14dp"
    app:cardCornerRadius="6dp"
    app:cardElevation="@dimen/common_card_elevation">
    <ImageView
        android:id="@+id/img_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bg_game_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintEnd_toStartOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="18sp"
                android:textColor="#ffffffff"
                android:ellipsize="end"
                android:id="@+id/step_sub_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/step_game_title"
                android:lines="1"
                android:shadowColor="#ff25bbb2"
                android:fontFamily="lt"
                app:layout_constraintBottom_toTopOf="@+id/step_tv_title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#ffffffff"
                android:ellipsize="end"
                android:id="@+id/step_tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/step_game_title"
                android:maxLines="2"
                android:shadowColor="#ff25bbb2"
                android:lineSpacingExtra="6dp"
                android:fontFamily="lt-bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/step_sub_title"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/step_pb_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/step_sub_title">
                <ProgressBar
                    android:id="@+id/step_pb"
                    android:layout_width="180dp"
                    android:layout_height="8dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/step_game_bg_pb"
                    android:progressTint="@color/black60"
                    android:progressBackgroundTint="@color/pale_grey_two"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="?android:attr/progressBarStyleHorizontal"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <com.huami.hmchartui.ui.view.CommonCardView
                android:layout_width="114dp"
                android:layout_height="32dp"
                android:layout_marginBottom="13dp"
                app:cardCornerRadius="6dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">
                <com.huami.widget.typeface.TypefaceTextView
                    android:textSize="13sp"
                    android:textColor="#ffffffff"
                    android:gravity="center"
                    android:id="@+id/step_tv_btn"
                    android:background="@drawable/bg_step_game_btn_v2"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:minWidth="114dp"
                    android:text="@string/step_unlock_step_game"
                    android:fontFamily="lt"/>
            </com.huami.hmchartui.ui.view.CommonCardView>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.huami.hmchartui.ui.view.CommonCardView>
