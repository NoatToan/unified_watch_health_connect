<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/tr_pager_bg"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.huami.training.ui.widget.CourseBanner
        android:id="@+id/entrance_banner"
        android:background="@color/tr_font_gray_light"
        android:layout_width="match_parent"
        android:layout_height="312dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/head_guide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="280dp"/>
    <net.lucode.hackware.magicindicator.MagicIndicator
        android:id="@+id/entrance_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@+id/king_zone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.huami.training.ui.widget.KingView
        android:id="@+id/king_zone"
        android:background="@drawable/tr_shape_corner_white_bg"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/head_guide"
        style="@style/TrainingCard"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/my_training_zone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/head_guide">
        <com.huami.training.ui.widget.CourseCardView
            android:id="@+id/card_my_training_both"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            app:cardBackgroundColor="@color/tr_white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TrainingCard">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <include
                    android:id="@+id/card_training_plan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="20dp"
                    layout="@layout/tr_layout_training_plan"/>
                <View
                    android:id="@+id/card_my_training_both_divider"
                    android:visibility="gone"
                    style="@style/TrainingHorizontalDivider"/>
                <include
                    android:id="@+id/joined_course"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="20dp"
                    layout="@layout/tr_layout_joined_courses"/>
            </LinearLayout>
        </com.huami.training.ui.widget.CourseCardView>
        <com.huami.training.ui.widget.CourseCardView
            android:id="@+id/card_training_plan_empty"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            app:layout_constraintBottom_toTopOf="@+id/card_joined_courses_separated"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TrainingCard.ColoredBg">
            <ImageView
                android:id="@+id/training_plan_empty_bg_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/tr_training_plan_bg"
                android:scaleType="centerCrop"/>
            <include layout="@layout/layout_training_plan_empty"/>
        </com.huami.training.ui.widget.CourseCardView>
        <com.huami.training.ui.widget.CourseCardView
            android:id="@+id/card_joined_courses_separated"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            app:cardBackgroundColor="@color/tr_white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/card_training_plan_empty"
            style="@style/TrainingCard">
            <include
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="20dp"
                layout="@layout/tr_layout_joined_courses"/>
        </com.huami.training.ui.widget.CourseCardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/subject_zone"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:layout_constraintTop_toBottomOf="@+id/my_training_zone">
        <com.huami.training.ui.widget.CourseCardView
            android:id="@+id/subject_top"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            app:cardBackgroundColor="@color/tr_white"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TrainingCard.ColoredBg">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:id="@+id/subject_img_top"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"/>
                <com.huami.widget.typeface.TypefaceTextView
                    android:id="@+id/subject_title_top"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/TrainingCourseSubjectTitleText"/>
                <com.huami.widget.typeface.TypefaceTextView
                    android:id="@+id/subject_subtitle_top"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/subject_title_top"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/TrainingCourseSubjectSubtitleText"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.huami.training.ui.widget.CourseCardView>
        <com.huami.training.ui.widget.CourseCardView
            android:id="@+id/subject_left"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="110dp"
            android:layout_marginTop="1dp"
            android:layout_marginBottom="5dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="2dp"
            app:cardBackgroundColor="@color/tr_white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/subject_right"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/subject_top"
            style="@style/TrainingCard.ColoredBg">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:id="@+id/subject_img_left"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"/>
                <com.huami.widget.typeface.TypefaceTextView
                    android:id="@+id/subject_title_left"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/TrainingCourseSubjectTitleText"/>
                <com.huami.widget.typeface.TypefaceTextView
                    android:id="@+id/subject_subtitle_left"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/subject_title_left"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/TrainingCourseSubjectSubtitleText"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.huami.training.ui.widget.CourseCardView>
        <com.huami.training.ui.widget.CourseCardView
            android:id="@+id/subject_right"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="110dp"
            android:layout_marginTop="1dp"
            android:layout_marginBottom="5dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="10dp"
            app:cardBackgroundColor="@color/tr_white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@+id/subject_left"
            app:layout_constraintTop_toBottomOf="@+id/subject_top"
            style="@style/TrainingCard.ColoredBg">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:id="@+id/subject_img_right"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"/>
                <com.huami.widget.typeface.TypefaceTextView
                    android:id="@+id/subject_title_right"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/TrainingCourseSubjectTitleText"/>
                <com.huami.widget.typeface.TypefaceTextView
                    android:id="@+id/subject_subtitle_right"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/subject_title_right"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/TrainingCourseSubjectSubtitleText"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.huami.training.ui.widget.CourseCardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/today_zone"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        app:layout_constraintTop_toBottomOf="@+id/subject_zone">
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="16sp"
            android:textColor="@color/tr_font_gray_dark"
            android:id="@+id/tv_today_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tr_today_training"
            android:fontFamily="lt"
            android:layout_marginStart="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/today_tag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_today_title"/>
        <com.huami.training.ui.widget.CourseCardView
            android:id="@+id/today_training"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            app:cardBackgroundColor="@color/tr_white"
            app:layout_constraintTop_toBottomOf="@+id/today_tag"
            style="@style/TrainingCard">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rcv_today_training"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </com.huami.training.ui.widget.CourseCardView>
        <com.huami.training.ui.widget.CourseCardView
            android:id="@+id/today_training_error"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="10dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            app:cardBackgroundColor="@color/tr_white"
            app:layout_constraintBottom_toBottomOf="@+id/today_zone"
            app:layout_constraintTop_toBottomOf="@+id/today_tag"
            style="@style/TrainingCard">
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="14sp"
                android:textColor="@color/tr_font_gray_light"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:text="@string/tr_search_error_tips"
                android:fontFamily="lt"/>
        </com.huami.training.ui.widget.CourseCardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="16sp"
        android:textColor="@color/tr_font_gray_dark"
        android:id="@+id/kankan_title"
        android:paddingBottom="7dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:text="@string/tr_look_around"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        app:layout_constraintTop_toBottomOf="@+id/today_zone"/>
</androidx.constraintlayout.widget.ConstraintLayout>
