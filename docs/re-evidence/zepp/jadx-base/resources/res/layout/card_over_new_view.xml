<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/card_over_container"
        android:background="@drawable/moving_ui_card_over_container_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include
            android:id="@+id/include_user_info"
            layout="@layout/moving_ui_include_sport_detail_personal_info"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/over_view_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:listSelector="@android:color/transparent"
            android:numColumns="3"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/include_user_info"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/over_view_info_more"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/over_view_info">
            <TextView
                android:textColor="@color/s2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/moving_ui_detailed_data_label"
                style="@style/Rainbow.TextAppearance.Body3"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="@drawable/ic_arrow_forward_16"
                app:tint="@color/s2"/>
        </LinearLayout>
        <View
            android:id="@+id/over_view_divide"
            android:background="@color/over_view_divide_color"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="21.7dp"
            android:layout_marginStart="13.3dp"
            android:layout_marginEnd="13.3dp"
            app:layout_constraintTop_toBottomOf="@+id/over_view_info_more"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/over_view_data_source"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/over_view_divide"/>
        <TextView
            android:textSize="10.7sp"
            android:textColor="@color/white60"
            android:id="@+id/over_view_data_title"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="11.6dp"
            android:text="@string/over_view_data_title"
            app:layout_constraintEnd_toStartOf="@+id/over_view_data_source"
            app:layout_constraintTop_toBottomOf="@+id/over_view_divide"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/over_view_avatar"
        android:background="@drawable/user_avatar_ring_bg_thick"
        android:padding="2dp"
        android:visibility="visible"
        android:layout_width="43.3dp"
        android:layout_height="43.3dp"
        android:layout_marginTop="2dp"
        android:src="@drawable/default_user_avatar"
        android:layout_marginStart="15.3dp"/>
</FrameLayout>
