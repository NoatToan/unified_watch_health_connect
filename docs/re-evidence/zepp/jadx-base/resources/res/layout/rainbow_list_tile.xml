<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="@dimen/d3"
    android:paddingBottom="@dimen/d3"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/rainbow_list_tile_min_height"
    android:paddingStart="@dimen/d4"
    android:paddingEnd="@dimen/d4">
    <ImageView
        android:id="@+id/rainbow_tile_delete"
        android:visibility="gone"
        android:layout_width="32dp"
        android:layout_height="20dp"
        android:scaleType="center"
        android:paddingEnd="@dimen/d3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_remove_20_p3"/>
    <ImageView
        android:id="@+id/rainbow_tile_leading"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="center"
        android:layout_marginEnd="@dimen/d2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/rainbow_tile_title"
        app:layout_constraintStart_toEndOf="@+id/rainbow_tile_delete"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="?android:attr/textColorPrimary"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/rainbow_tile_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:textDirection="locale"
        android:layout_marginEnd="@dimen/d5"
        app:layout_constraintBottom_toTopOf="@+id/rainbow_tile_subtitle"
        app:layout_constraintEnd_toStartOf="@+id/rainbow_barrier_title"
        app:layout_constraintStart_toEndOf="@+id/rainbow_tile_leading"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/Rainbow.TextAppearance.Body3"/>
    <TextView
        android:textColor="?android:attr/textColorSecondary"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/rainbow_tile_subtitle"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textDirection="locale"
        android:layout_marginEnd="@dimen/d5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/rainbow_barrier_subtitle"
        app:layout_constraintStart_toStartOf="@+id/rainbow_tile_title"
        app:layout_constraintTop_toBottomOf="@+id/rainbow_tile_title"
        style="@style/Rainbow.TextAppearance.Body5"/>
    <com.huami.lib.rainbow.widget.SwitchCompat
        android:id="@+id/rainbow_tile_switch"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/rainbow_tile_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/rainbow_tile_title"/>
    <TextView
        android:textColor="?android:attr/textColorSecondary"
        android:ellipsize="end"
        android:id="@+id/rainbow_tile_label"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="@dimen/list_tile_label_max_width"
        android:maxLines="2"
        android:layout_marginEnd="@dimen/d1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/rainbow_barrier_image"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <ImageView
        android:id="@+id/rainbow_tile_indicator"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:scaleType="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/rainbow_tile_trailing"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/rainbow_round_header_indicator"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/rainbow_tile_trailing"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.App.Rounded"/>
    <ImageView
        android:id="@+id/rainbow_tile_trailing"
        android:layout_width="@dimen/d4"
        android:layout_height="@dimen/d4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_arrow_forward_16"
        app:tint="?android:attr/textColorSecondary"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/rainbow_barrier_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:constraint_referenced_ids="rainbow_tile_switch,rainbow_tile_label,rainbow_tile_trailing"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/rainbow_barrier_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:constraint_referenced_ids="rainbow_tile_label,rainbow_tile_trailing"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/rainbow_barrier_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:constraint_referenced_ids="rainbow_tile_indicator,rainbow_round_header_indicator"/>
    <ViewStub
        android:id="@+id/rainbow_tile_stub"
        android:layout="@layout/rainbow_list_tile_slider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/d2"
        app:layout_constraintTop_toBottomOf="@+id/rainbow_tile_title"/>
</merge>
