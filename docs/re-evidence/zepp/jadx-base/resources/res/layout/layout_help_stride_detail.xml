<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="13.3sp"
        android:textColor="@color/run_white_50_percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/running_stride"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/run_white_30_percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="13.3dp"
        android:text="@string/running_help_stride_definition"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:background="@drawable/icon_running_help_stride_figure1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="26.7dp"/>
    <TextView
        android:textSize="13.3sp"
        android:textColor="@color/run_white_50_percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="@string/running_help_stride_nolarge"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/run_white_30_percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="13.3dp"
        android:text="@string/running_help_stride_nolarge_reason"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:background="@drawable/icon_running_help_stride_figure2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="26.7dp"/>
    <TextView
        android:textSize="13.3sp"
        android:textColor="@color/run_white_50_percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="@string/running_help_stride_for_you"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/run_white_30_percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="13.3dp"
        android:text="@string/running_help_stride_for_you_tips"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:background="@drawable/icon_running_help_stride_figure3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="26.7dp"/>
</LinearLayout>
