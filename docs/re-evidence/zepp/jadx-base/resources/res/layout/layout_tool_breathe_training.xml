<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="?attr/textAppearanceBody3"
        android:textColor="@color/s1"
        android:gravity="center_vertical"
        android:id="@+id/tool_breathe_training"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/size_15dp"
        android:text="@string/app_sort_breath_train"
        android:drawablePadding="10dp"
        android:drawableStart="@drawable/ic_tool_breathe_training_24"
        android:layout_marginStart="@dimen/size_15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="?attr/textAppearanceBody3"
        android:textColor="@color/s5"
        android:gravity="center_vertical"
        android:id="@+id/tool_breathe_training_sleep"
        android:background="@drawable/ic_tool_breathe_training_sleep"
        android:padding="@dimen/size_10dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_12dp"
        android:layout_marginBottom="@dimen/size_15dp"
        android:text="@string/small_tool_item_training_breathe_new"
        android:layout_marginStart="@dimen/size_15dp"
        android:layout_marginEnd="7dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tool_breathe_training_stress"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tool_breathe_training"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="?attr/textAppearanceBody3"
        android:textSize="@dimen/play_title_size"
        android:textColor="@color/s5"
        android:gravity="center_vertical"
        android:id="@+id/tool_breathe_training_stress"
        android:background="@drawable/ic_tool_breathe_training_stress"
        android:padding="@dimen/size_10dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_12dp"
        android:layout_marginBottom="@dimen/size_15dp"
        android:text="@string/stress_breathe_training"
        android:layout_marginStart="7dp"
        android:layout_marginEnd="@dimen/size_15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/tool_breathe_training_sleep"
        app:layout_constraintTop_toBottomOf="@+id/tool_breathe_training"/>
</androidx.constraintlayout.widget.ConstraintLayout>
