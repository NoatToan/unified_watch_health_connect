<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:gravity="center_vertical"
        android:id="@+id/search_box"
        android:background="@color/theme_window_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/xima_detail_title_size"
            android:textColor="@color/xima_category_title_color"
            android:id="@+id/back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="20dp"
            android:text="@string/ximalaya_cancel"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
        <RelativeLayout
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="7dp"
            android:layout_toLeftOf="@+id/back"
            android:layout_centerVertical="true">
            <EditText
                android:textSize="@dimen/xima_detail_title_size"
                android:textColor="@color/xima_category_title_color"
                android:textColorHint="@color/dark_grey_border"
                android:id="@+id/searching_program"
                android:background="@drawable/bg_edittext"
                android:layout_width="match_parent"
                android:layout_height="@dimen/xima_search_edittext_height_size"
                android:imeOptions="actionSearch"
                android:textCursorDrawable="@null"
                android:layout_marginStart="20dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginEnd="8dp"
                android:layout_alignEnd="@+id/searching_program">
                <ImageView
                    android:id="@+id/clear_btn"
                    android:background="@drawable/btn_edit_text_clear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <View
                    android:background="@color/xima_listview_divider_color"
                    android:layout_width="0.33dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="10dp"/>
                <ImageView
                    android:id="@+id/search_btn"
                    android:background="@drawable/et_ic_search_n"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"/>
            </LinearLayout>
        </RelativeLayout>
    </RelativeLayout>
    <ScrollView
        android:id="@+id/searching_result"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:layout_below="@+id/search_box">
        <RelativeLayout
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="@dimen/xima_detail_title_size"
                android:textColor="@color/xima_graytext_color"
                android:gravity="center_vertical"
                android:id="@+id/nodata"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="500dp"
                android:text="@string/xima_nodata"
                android:drawableTop="@drawable/ic_search_no_data"
                android:drawablePadding="16dp"
                android:layout_centerInParent="true"/>
            <RelativeLayout
                android:id="@+id/searching_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp">
                <TextView
                    android:textSize="@dimen/xima_detail_intruduce_size"
                    android:textColor="@color/xima_light_graytext_color"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/xima_search_history"
                    android:layout_alignParentStart="true"/>
                <TextView
                    android:textSize="@dimen/xima_detail_intruduce_size"
                    android:textColor="@color/xima_album_button_text_color"
                    android:id="@+id/searching_history_clear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/xima_clear"
                    android:layout_alignParentEnd="true"/>
                <com.huami.watch.companion.ximalaya.RadiogroupCL
                    android:id="@+id/searching_history_rg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_below="@+id/searching_history_clear"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/fragments_par"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <RelativeLayout
                    android:id="@+id/indicator_container"
                    android:background="@color/white"
                    android:paddingLeft="23.3dp"
                    android:paddingRight="23.3dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.huami.watch.companion.ui.view.PagerSlidingTabStrip
                        android:id="@+id/indicator"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        app:pstsIndicatorColor="@color/pink"
                        app:pstsIndicatorWidth="22dp"
                        app:pstsTabTextColor="@color/btn_text_grey_red"/>
                </RelativeLayout>
                <View
                    android:id="@+id/line"
                    android:layout_below="@+id/indicator_container"
                    style="@style/Line"/>
                <androidx.viewpager.widget.ViewPager
                    android:id="@+id/view_pager"
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_below="@+id/line"/>
            </RelativeLayout>
        </RelativeLayout>
    </ScrollView>
</RelativeLayout>
