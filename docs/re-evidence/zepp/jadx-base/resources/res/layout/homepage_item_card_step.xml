<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="185dp">
    <com.huami.module.homepage.cards.cardui.CardTitleBarView
        android:id="@+id/step_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:showExpandButton="true"
        app:titleText="@string/homepage_item_card_step"/>
    <com.huami.module.homepage.cards.cardui.ProgressRingView
        android:id="@+id/ring"
        android:layout_width="128dp"
        android:layout_height="128dp"
        android:layout_marginTop="11dp"
        android:layout_marginStart="15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/step_bar"
        app:layout_goneMarginStart="15dp"/>
    <Space
        android:id="@+id/spaceBelowRing"
        android:layout_width="match_parent"
        android:layout_height="22dp"
        app:layout_constraintTop_toBottomOf="@+id/ring"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/s1"
        android:gravity="center_horizontal"
        android:id="@+id/step_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawableTop="@drawable/item_card_step"
        app:layout_constraintBottom_toBottomOf="@+id/ring"
        app:layout_constraintEnd_toEndOf="@+id/ring"
        app:layout_constraintStart_toStartOf="@+id/ring"
        app:layout_constraintTop_toTopOf="@+id/ring"
        style="@style/Rainbow.TextAppearance.Number3"/>
    <TextView
        android:textColor="@color/s1"
        android:ellipsize="end"
        android:id="@+id/step_distance_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="69dp"
        android:maxLines="2"
        android:paddingStart="26dp"
        android:paddingEnd="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/ring"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <TextView
        android:textColor="@color/s1"
        android:ellipsize="end"
        android:id="@+id/step_consume_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="27dp"
        android:maxLines="2"
        android:paddingStart="26dp"
        android:paddingEnd="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/step_distance_title"
        app:layout_constraintTop_toBottomOf="@+id/step_distance_title"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/detail"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/spaceBelowRing">
        <TextView
            android:textColor="@color/s1"
            android:id="@+id/step_avg_step_last_7days"
            android:paddingLeft="15dp"
            android:paddingRight="15dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Rainbow.TextAppearance.Body4"/>
        <FrameLayout
            android:id="@+id/chart_container"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginTop="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/step_avg_step_last_7days"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
