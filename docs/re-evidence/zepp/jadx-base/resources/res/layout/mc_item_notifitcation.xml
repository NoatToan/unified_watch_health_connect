<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s38"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/mc_image_notification"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginTop="18dp"
        android:layout_marginStart="14dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="15sp"
        android:textColor="@color/s1"
        android:ellipsize="end"
        android:id="@+id/mc_tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="lt-bold"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintLeft_toRightOf="@+id/mc_image_notification"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/mc_image_notification"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/mc_lin"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintLeft_toRightOf="@+id/mc_image_notification"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mc_tv_title">
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="13sp"
            android:textColor="@color/s2"
            android:ellipsize="end"
            android:gravity="bottom"
            android:id="@+id/mc_notification_sub_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="lt"/>
    </LinearLayout>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="13sp"
        android:textColor="@color/s2"
        android:gravity="center"
        android:id="@+id/mc_notification_lable"
        android:background="@drawable/share_lable"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="12dp"
        android:maxLines="1"
        android:fontFamily="lt"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/mc_image_notification"
        app:layout_constraintTop_toBottomOf="@+id/mc_lin"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="13sp"
        android:textColor="@color/s2"
        android:ellipsize="end"
        android:id="@+id/mc_notitfitcation_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:fontFamily="lt"
        android:layout_marginEnd="14dp"
        app:layout_constraintBottom_toBottomOf="@+id/mc_notification_lable"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/mc_notification_lable"/>
</androidx.constraintlayout.widget.ConstraintLayout>
