<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/s36"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/part_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/not_standard_rl"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/not_to_standard_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="@plurals/bodyfat_3_not_up_to_standard"
                android:layout_marginStart="18dp"
                style="@style/bodyfatClassTitleStyle"/>
            <View
                android:id="@+id/lineview"
                android:background="@color/s4"
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider_slp_info"
                android:layout_marginTop="10dp"
                android:layout_below="@+id/not_to_standard_tv"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                style="@style/bodyfatClassDividerStyle"/>
            <com.xiaomi.hm.health.bodyfat.view.FillRecyclerView
                android:id="@+id/not_to_standard_listview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:listSelector="@color/trans"
                android:divider="@color/s2"
                android:dividerHeight="0dp"
                android:layout_below="@+id/lineview"/>
            <View
                android:background="@color/s36"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/need_attention_rl"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/attention_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="@plurals/bodyfat_3_need_attention"
                android:layout_marginStart="18dp"
                style="@style/bodyfatClassTitleStyle"/>
            <View
                android:id="@+id/lineview2"
                android:background="@color/s4"
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider_slp_info"
                android:layout_marginTop="10dp"
                android:layout_below="@+id/attention_tv"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                style="@style/bodyfatClassDividerStyle"/>
            <com.xiaomi.hm.health.bodyfat.view.FillRecyclerView
                android:id="@+id/need_attention_listview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:listSelector="@color/trans"
                android:divider="@color/s4"
                android:dividerHeight="0dp"
                android:layout_below="@+id/lineview2"/>
            <View
                android:background="@color/s36"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/health_rl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/health_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="@plurals/bodyfat_3_health"
                android:layout_marginStart="18dp"
                style="@style/bodyfatClassTitleStyle"/>
            <View
                android:id="@+id/lineview2_health"
                android:background="@color/s4"
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider_slp_info"
                android:layout_marginTop="10dp"
                android:layout_below="@+id/health_tv"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                style="@style/bodyfatClassDividerStyle"/>
            <com.xiaomi.hm.health.bodyfat.view.FillRecyclerView
                android:id="@+id/health_listview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:listSelector="@color/trans"
                android:divider="@color/s2"
                android:dividerHeight="0dp"
                android:layout_below="@+id/lineview2_health"/>
        </RelativeLayout>
    </LinearLayout>
    <View
        android:id="@+id/below_shape_iv"
        android:background="@color/s36"
        android:layout_width="match_parent"
        android:layout_height="8dp"/>
    <TextView
        android:id="@+id/other_indicators_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:text="@string/other_health_indicators"
        android:layout_marginStart="18dp"
        style="@style/bodyfatClassTitleStyle"/>
    <View
        android:background="@color/s4"
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider_slp_info"
        android:layout_marginTop="10dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        style="@style/bodyfatClassDividerStyle"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/body_age_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="58dp"
        android:paddingStart="19dp"
        android:paddingEnd="19dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="58dp">
            <ImageView
                android:id="@+id/body_age_icon_iv"
                android:src="@drawable/bf3_body_age_icon"
                style="@style/bodyfatIndexIconStyle"/>
            <TextView
                android:id="@+id/body_age_title_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/body_age"
                android:layout_marginStart="15dp"
                style="@style/bodyIndexTitleStyle"/>
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"
                style="@style/bodyIndexTitleBarPlaceHolderStyle"/>
            <com.huami.lib.view.text.UnitTextView
                android:id="@+id/params_ideal_age"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:unit="@string/years_old"
                style="@style/bodyIndexValueStyle"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="46dp"
            android:paddingEnd="0dp">
            <View
                android:id="@+id/adapter_divider_up"
                android:background="@color/s4"
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider"/>
            <TextView
                android:gravity="start"
                android:id="@+id/body_age_info_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/body_age_match"
                android:lineSpacingExtra="@dimen/body_params_linespace"
                style="@style/bodyIndexContentStyle"/>
        </LinearLayout>
        <View
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider_slp_info"
            android:layout_marginTop="18dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/body_ideal_weight_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="58dp"
        android:paddingStart="19dp"
        android:paddingEnd="19dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="58dp">
            <ImageView
                android:id="@+id/body_ideal_weight_icon_iv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/bf3_weight_icon"
                style="@style/bodyfatIndexIconStyle"/>
            <TextView
                android:id="@+id/body_ideal_weight_title_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ideal_body_weight"
                android:layout_marginStart="15dp"
                style="@style/bodyIndexTitleStyle"/>
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"
                style="@style/bodyIndexTitleBarPlaceHolderStyle"/>
            <com.huami.lib.view.text.UnitTextView
                android:id="@+id/params_ideal_weight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:unit="@string/unit_kg"
                style="@style/bodyIndexValueStyle"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="46dp"
            android:paddingEnd="0dp">
            <View
                android:background="@color/s4"
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider"/>
            <com.huami.view.weightfigure.WeightFigureView
                android:id="@+id/ideal_weight_figure_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:type="unmoveable"/>
        </LinearLayout>
        <View
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider_slp_info"
            android:layout_marginTop="18dp"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/shape_param_rl"
        android:layout_width="match_parent"
        android:layout_height="58dp">
        <ImageView
            android:id="@+id/shape_iv_pre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/bf3_figure"
            android:layout_centerVertical="true"
            android:layout_marginStart="19dp"
            style="@style/bodyfatIndexIconStyle"/>
        <TextView
            android:id="@+id/shape_iv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/weight_params_pre"
            android:layout_centerVertical="true"
            android:layout_marginStart="15dp"
            android:layout_toEndOf="@+id/shape_iv_pre"
            style="@style/bodyIndexTitleStyle"/>
        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_arrow_right"
            android:scaleType="centerInside"
            android:layout_centerVertical="true"
            android:layout_marginEnd="18dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</LinearLayout>
