<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/s36"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.huami.bloodoxygen.ui.view.BloodOxygenTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/bo_ui_spo2_intro_title"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:background="@color/s36"
            android:padding="@dimen/bo_ui_size_15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="@dimen/bo_ui_size_20sp"
                android:textStyle="bold"
                android:textColor="@color/s1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bo_ui_what_is_spo2"
                android:textDirection="locale"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="@dimen/bo_ui_size_16sp"
                android:textColor="@color/s1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_20dp"
                android:text="@string/bo_ui_spo2_define"
                android:lineSpacingExtra="@dimen/bo_ui_size_3dp"
                android:textDirection="locale"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="@dimen/bo_ui_size_16sp"
                android:textColor="@color/s1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_20dp"
                android:text="@string/bo_ui_spo2_define_level_new"
                android:lineSpacingExtra="@dimen/bo_ui_size_3dp"
                android:textDirection="locale"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="@dimen/bo_ui_size_20sp"
                android:textStyle="bold"
                android:textColor="@color/s1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/bo_ui_size_50dp"
                android:text="@string/bo_ui_spo2_measure_principle_title"
                android:textDirection="locale"/>
            <ImageView
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/bo_ui_size_30dp"
                android:src="@drawable/bo_ui_image_spo2_measure_principle"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="@dimen/bo_ui_size_13sp"
                android:textColor="@color/s2"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bo_ui_spo2_measure_principle_image_tips"
                android:textDirection="locale"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="@dimen/bo_ui_size_16sp"
                android:textColor="@color/s1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_20dp"
                android:text="@string/bo_ui_spo2_measure_principle_content"
                android:lineSpacingExtra="@dimen/bo_ui_size_3dp"
                android:textDirection="locale"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="@dimen/bo_ui_size_20sp"
                android:textStyle="bold"
                android:textColor="@color/s1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/bo_ui_size_50dp"
                android:text="@string/bo_ui_how_measure_spo2"
                android:textDirection="locale"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="@dimen/bo_ui_size_16sp"
                android:textColor="@color/s1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_20dp"
                android:text="@string/bo_ui_spo2_measure_step_one"
                android:lineSpacingExtra="@dimen/bo_ui_size_3dp"
                android:textDirection="locale"/>
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/step_one"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/bo_ui_size_20dp"
                android:src="@drawable/bo_ui_image_spo2_measure_step_one"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="@dimen/bo_ui_size_13sp"
                android:textColor="@color/s2"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bo_ui_spo2_measure_step_one_image_tips"
                android:textDirection="locale"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="@dimen/bo_ui_size_16sp"
                android:textColor="@color/s1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/bo_ui_size_50dp"
                android:text="@string/bo_ui_spo2_measure_step_two"
                android:lineSpacingExtra="@dimen/bo_ui_size_3dp"
                android:textDirection="locale"/>
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/step_two"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/bo_ui_size_20dp"
                android:src="@drawable/bo_ui_image_spo2_measure_step_two"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="@dimen/bo_ui_size_13sp"
                android:textColor="@color/s2"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bo_ui_spo2_measure_step_two_image_tips"
                android:textDirection="locale"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="@dimen/bo_ui_size_16sp"
                android:textColor="@color/s1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/bo_ui_size_50dp"
                android:text="@string/bo_ui_spo2_measure_step_three"
                android:lineSpacingExtra="@dimen/bo_ui_size_3dp"
                android:textDirection="locale"/>
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/step_three"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/bo_ui_size_20dp"
                android:src="@drawable/bo_ui_image_spo2_measure_step_three"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="@dimen/bo_ui_size_13sp"
                android:textColor="@color/s2"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bo_ui_spo2_measure_step_three_image_tips"
                android:textDirection="locale"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="@dimen/bo_ui_size_16sp"
                android:textColor="@color/s1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/bo_ui_size_50dp"
                android:text="@string/bo_ui_spo2_measure_step_four"
                android:lineSpacingExtra="@dimen/bo_ui_size_3dp"
                android:textDirection="locale"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="@dimen/bo_ui_size_20sp"
                android:textStyle="bold"
                android:textColor="@color/s1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/bo_ui_size_50dp"
                android:text="@string/bo_ui_spo2_measure_attention"
                android:textDirection="locale"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="@dimen/bo_ui_size_16sp"
                android:textColor="@color/s1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_20dp"
                android:text="@string/bo_ui_spo2_measure_tips_content_one"
                android:lineSpacingExtra="@dimen/bo_ui_size_3dp"
                android:textDirection="locale"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="@dimen/bo_ui_size_16sp"
                android:textColor="@color/s1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_20dp"
                android:text="@string/bo_ui_spo2_measure_tips_content_two"
                android:lineSpacingExtra="@dimen/bo_ui_size_3dp"
                android:textDirection="locale"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="@dimen/bo_ui_size_20sp"
                android:textStyle="bold"
                android:textColor="@color/s1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/bo_ui_size_50dp"
                android:text="@string/bo_ui_spo2_measure_article_title"
                android:textDirection="locale"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="@dimen/bo_ui_size_16sp"
                android:textColor="@color/s1"
                android:paddingBottom="@dimen/bo_ui_size_50dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_20dp"
                android:text="@string/bo_ui_spo2_measure_article_content"
                android:lineSpacingExtra="@dimen/bo_ui_size_3dp"
                android:textDirection="locale"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
