<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/main"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/topImg"
        android:background="@drawable/snore_list_header_bg"
        android:layout_width="match_parent"
        android:layout_height="100dp">
        <TextView
            android:textSize="25sp"
            android:textColor="@color/s5"
            android:id="@+id/topSnoreNum"
            android:paddingLeft="@dimen/snore_common_page_padding"
            android:paddingRight="@dimen/snore_common_page_padding"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="17sp"
            android:textColor="@color/s5"
            android:id="@+id/topTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/editLayout"
        android:background="@drawable/snore_top_corner_bg"
        android:paddingLeft="@dimen/snore_common_page_padding"
        android:paddingTop="20dp"
        android:paddingRight="@dimen/snore_common_page_padding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/snore_common_page_padding"
        android:layout_marginTop="@dimen/snore_common_page_divider"
        android:layout_marginRight="@dimen/snore_common_page_padding">
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/s1"
            android:id="@+id/audioText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/snore_audio"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/s51"
            android:id="@+id/delAllTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/snore_del_all_text"
            android:layout_marginEnd="19dp"
            android:layout_toStartOf="@+id/divider"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/divider"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/divider"
            android:background="@color/s4"
            android:layout_width="1dp"
            android:layout_height="18dp"
            android:layout_marginEnd="19dp"
            android:layout_toStartOf="@+id/editText"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/editText"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/s1"
            android:id="@+id/editText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/snore_edit"
            android:layout_alignParentEnd="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/group_edit"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="delAllTv,divider"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/snoreList"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/snore_common_page_padding"
        android:layout_marginRight="@dimen/snore_common_page_padding"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
</LinearLayout>
