<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/sls_back_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.sleepassistant.lib.widget.CustomSmartRefreshLayout
        android:id="@+id/sls_fragment_refresh"
        android:background="@color/sls_back_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/sls_fragment_music_recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.huami.sleepassistant.lib.widget.CustomSmartRefreshLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/sls_no_data"
        android:background="@color/sls_back_bg"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:background="@drawable/sls_fragment_live_music_no_data"
            android:layout_width="77dp"
            android:layout_height="77dp"
            android:layout_marginTop="72dp"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="13sp"
            android:textColor="@color/white100"
            android:ellipsize="end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="19dp"
            android:text="@string/sls_no_live_thing_to_add"
            android:fontFamily="lt"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="12sp"
            android:textColor="@color/sls_no_live_data"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/sls_add_collection"
            android:background="@drawable/sls_shape_add_data"
            android:layout_width="77dp"
            android:layout_height="24dp"
            android:layout_marginTop="19dp"
            android:text="@string/sls_to_add"
            android:fontFamily="lt"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
