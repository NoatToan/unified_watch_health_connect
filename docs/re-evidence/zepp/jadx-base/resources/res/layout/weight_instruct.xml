<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/instruction_weight_page_6"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/instruction_weight_page6_weight_floor_bottom"
            android:src="@drawable/instruction_weight_floor"/>
        <ImageView
            android:id="@+id/instruction_weight_flatwise"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="155dp"
            android:src="@drawable/img_instruct_scale_2_weighting"
            android:layout_centerHorizontal="true"/>
        <LinearLayout
            android:gravity="center"
            android:id="@+id/instruction_weight_page6_tips1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/instruction_weight_page6_txt1_top"
            android:layout_marginStart="@dimen/instruction_weight_page6_txt1_left">
            <TextView
                android:textSize="11.3sp"
                android:textColor="@color/s5"
                android:layout_width="73dp"
                android:layout_height="wrap_content"
                android:text="@string/instruction_weight_page6_t1"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/instruction_weight_l1"
                android:layout_marginStart="@dimen/instruction_weight_page6_l1_left"/>
        </LinearLayout>
        <RelativeLayout
            android:id="@+id/instruction_weight_page6_tips2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="11.3sp"
                android:textColor="@color/s5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/instruction_weight_page6_txt2_top"
                android:text="@string/instruction_weight_page6_t2"
                android:layout_marginStart="@dimen/instruction_weight_page6_txt2_left"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="293.1953dp"
                android:src="@drawable/instruction_weight_l2"
                android:layout_marginStart="218.8dp"/>
        </RelativeLayout>
        <LinearLayout
            android:gravity="center"
            android:id="@+id/instruction_weight_page6_tips3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/instruction_weight_page6_txt3_top"
            android:layout_marginStart="@dimen/instruction_weight_page6_txt3_left">
            <TextView
                android:textSize="11.3sp"
                android:textColor="@color/s5"
                android:layout_width="85dp"
                android:layout_height="wrap_content"
                android:text="@string/instruction_weight_page6_t3"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/instruction_weight_l3"
                android:layout_marginStart="@dimen/instruction_weight_page6_l3_left"/>
        </LinearLayout>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
