<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/topTip"
        android:background="@drawable/snore_bottom_corner_bg"
        android:paddingLeft="@dimen/snore_common_page_padding"
        android:paddingRight="@dimen/snore_common_page_padding"
        android:paddingBottom="@dimen/snore_common_page_padding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="@dimen/line"
            android:layout_marginTop="20dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/s3"
            android:id="@+id/tip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/snore_list_audio_tip"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/snore_corner_bg"
        android:padding="@dimen/snore_common_page_padding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/snore_common_page_divider">
        <TextView
            android:textSize="18sp"
            android:textColor="@color/s1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/snore_dream_talk_monitor_function"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/s1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/snore_common_page_divider"
            android:text="@string/snore_list_bottom_tip_desc"/>
    </LinearLayout>
</LinearLayout>
