<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/nps_layout_bg"
    android:paddingBottom="@dimen/size_16"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/size_15"
    android:layout_marginStart="@dimen/size_15"
    android:layout_marginEnd="@dimen/size_15">
    <ImageView
        android:id="@+id/ivNpsSmile"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_27"
        android:src="@drawable/nps_feedback_smile"
        android:contentDescription="@string/nps_str_tks"
        android:layout_marginStart="@dimen/size_14"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/s5"
        android:id="@+id/tvNpsTks"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/nps_str_tks"
        android:alpha="0.9"
        android:layout_marginStart="@dimen/size_8"
        app:layout_constraintBottom_toBottomOf="@+id/ivNpsSmile"
        app:layout_constraintStart_toEndOf="@+id/ivNpsSmile"
        app:layout_constraintTop_toTopOf="@+id/ivNpsSmile"
        style="@style/Rainbow.TextAppearance.Body3"/>
    <TextView
        android:textColor="@color/s5"
        android:id="@+id/tvNpsTksContent"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_10"
        android:text="@string/nps_str_tks_title"
        android:alpha="0.6"
        android:paddingEnd="@dimen/size_14"
        app:layout_constraintStart_toStartOf="@+id/ivNpsSmile"
        app:layout_constraintTop_toBottomOf="@+id/ivNpsSmile"
        style="@style/Rainbow.TextAppearance.Body5"/>
    <ImageView
        android:id="@+id/ivNpsClose"
        android:layout_width="@dimen/size_32"
        android:layout_height="@dimen/size_32"
        android:src="@drawable/nps_frag_close"
        android:scaleType="center"
        android:contentDescription="@string/app_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/s5"
        android:id="@+id/tvNpsRecommendTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_28"
        android:text="@string/nps_str_title"
        android:alpha="0.9"
        android:paddingStart="@dimen/size_14"
        android:paddingEnd="@dimen/size_14"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Rainbow.TextAppearance.Body3"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_nps_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_16"
        android:paddingStart="@dimen/size_10"
        android:paddingEnd="@dimen/size_10"
        app:layout_constraintTop_toBottomOf="@+id/tvNpsRecommendTitle">
        <CheckBox
            android:id="@+id/cb_0"
            android:text="0"
            app:layout_constraintEnd_toStartOf="@+id/cb_1"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/NpsButtonStyle"/>
        <CheckBox
            android:id="@+id/cb_1"
            android:text="1"
            app:layout_constraintEnd_toStartOf="@+id/cb_2"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/cb_0"
            app:layout_constraintTop_toTopOf="@+id/cb_0"
            style="@style/NpsButtonStyle"/>
        <CheckBox
            android:id="@+id/cb_2"
            android:text="2"
            app:layout_constraintEnd_toStartOf="@+id/cb_3"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/cb_1"
            app:layout_constraintTop_toTopOf="@+id/cb_0"
            style="@style/NpsButtonStyle"/>
        <CheckBox
            android:id="@+id/cb_3"
            android:text="3"
            app:layout_constraintEnd_toStartOf="@+id/cb_4"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/cb_2"
            app:layout_constraintTop_toTopOf="@+id/cb_0"
            style="@style/NpsButtonStyle"/>
        <CheckBox
            android:id="@+id/cb_4"
            android:text="4"
            app:layout_constraintEnd_toStartOf="@+id/cb_5"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/cb_3"
            app:layout_constraintTop_toTopOf="@+id/cb_0"
            style="@style/NpsButtonStyle"/>
        <CheckBox
            android:id="@+id/cb_5"
            android:text="5"
            app:layout_constraintEnd_toStartOf="@+id/cb_6"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/cb_4"
            app:layout_constraintTop_toTopOf="@+id/cb_0"
            style="@style/NpsButtonStyle"/>
        <CheckBox
            android:id="@+id/cb_6"
            android:text="6"
            app:layout_constraintEnd_toStartOf="@+id/cb_7"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/cb_5"
            app:layout_constraintTop_toTopOf="@+id/cb_0"
            style="@style/NpsButtonStyle"/>
        <CheckBox
            android:id="@+id/cb_7"
            android:text="7"
            app:layout_constraintEnd_toStartOf="@+id/cb_8"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/cb_6"
            app:layout_constraintTop_toTopOf="@+id/cb_0"
            style="@style/NpsButtonStyle"/>
        <CheckBox
            android:id="@+id/cb_8"
            android:text="8"
            app:layout_constraintEnd_toStartOf="@+id/cb_9"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/cb_7"
            app:layout_constraintTop_toTopOf="@+id/cb_0"
            style="@style/NpsButtonStyle"/>
        <CheckBox
            android:id="@+id/cb_9"
            android:text="9"
            app:layout_constraintEnd_toStartOf="@+id/cb_10"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/cb_8"
            app:layout_constraintTop_toTopOf="@+id/cb_0"
            style="@style/NpsButtonStyle"/>
        <CheckBox
            android:id="@+id/cb_10"
            android:text="10"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/cb_9"
            app:layout_constraintTop_toTopOf="@+id/cb_0"
            style="@style/NpsButtonStyle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textColor="@color/s5"
        android:id="@+id/tvNpsNotLike"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_10"
        android:text="@string/nps_str_unlike"
        android:alpha="0.6"
        android:layout_marginStart="@dimen/size_14"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_nps_box"
        style="@style/Rainbow.TextAppearance.Body5"/>
    <TextView
        android:textColor="@color/s5"
        android:id="@+id/tvNpsLike"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_10"
        android:layout_marginBottom="@dimen/size_16"
        android:text="@string/nps_str_like"
        android:alpha="0.6"
        android:layout_marginEnd="@dimen/size_14"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_nps_box"
        style="@style/Rainbow.TextAppearance.Body5"/>
</androidx.constraintlayout.widget.ConstraintLayout>
