<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/over_view_gradient_bg"
    android:layout_width="match_parent"
    android:layout_height="261dp">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="40dp">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/white"
            android:id="@+id/run_diagram_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="13.4dp"/>
        <ImageView
            android:id="@+id/run_diagram_chart"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:src="@drawable/running_land_scape_chart"
            android:layout_centerVertical="true"
            android:layout_marginStart="5dp"
            android:layout_toEndOf="@+id/run_diagram_title"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="12.7dp"
            android:layout_alignParentEnd="true">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/white"
                android:gravity="start"
                android:id="@+id/run_diagram_subtitle1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/white"
                android:gravity="start"
                android:id="@+id/run_diagram_subtitle2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </RelativeLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/theme_sporting_orange"
        android:id="@+id/run_diagram_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="13.4dp"
        android:layout_marginStart="13.4dp"/>
    <RelativeLayout
        android:id="@+id/run_diagram_container"
        android:layout_width="match_parent"
        android:layout_height="204.9dp"
        android:layout_marginEnd="12.7dp"/>
</LinearLayout>
