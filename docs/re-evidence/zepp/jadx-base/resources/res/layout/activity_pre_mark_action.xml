<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s14"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.lib.rainbow.titlebar.RainbowTitleBar
        android:id="@+id/tv_title_bar"
        android:background="@color/s14"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationIcon="@drawable/ic_arrow_back_20_2x"
        app:title="@string/action_mark"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/tv_title_bar">
        <View
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider"/>
        <ImageView
            android:id="@+id/imv_action_image"
            android:layout_width="match_parent"
            android:layout_height="176dp"
            android:layout_marginTop="30dp"
            android:src="@drawable/ic_sleep_big"
            android:scaleType="centerInside"/>
        <EditText
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/s5"
            android:textColorHint="@color/s2"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tx_action_name"
            android:background="@null"
            android:padding="5dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="@string/customize_action_name_please"
            android:maxLines="1"
            android:lines="1"
            android:maxLength="20"
            android:inputType="textPersonName"
            android:textCursorDrawable="@drawable/cursor_white_drawable"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/s41"
            android:gravity="center"
            android:id="@+id/lab_temperature_title"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="@string/lab_temperature_device_parts_title"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="15sp"
            android:textColor="@color/s5"
            android:gravity="center"
            android:id="@+id/lab_temperature_select"
            android:background="@drawable/shape_lab_temperature_button_bk"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:text="@string/lab_temperature_device_parts_hint"
            android:drawableEnd="@drawable/lab_ic_temperature_arrow_down"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:layout_marginStart="74dp"
            android:layout_marginEnd="74dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/s5"
            android:gravity="center"
            android:id="@+id/lab_temperature_msg"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="@string/lab_temperature_infrared_msg"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"/>
        <FrameLayout
            android:id="@+id/fl_main_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>
    <com.xiaomi.hm.health.lab.view.RevealFrameLayout
        android:id="@+id/fl_countdown_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</RelativeLayout>
