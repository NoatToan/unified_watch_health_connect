<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="64dp">
    <RelativeLayout
        android:orientation="horizontal"
        android:id="@+id/rl_item"
        android:background="@color/black70"
        android:layout_width="100dp"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/imv_background_item"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/item_video_small_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="10sp"
                android:textColor="@color/white100"
                android:id="@+id/tx_video_name"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="3dp"
                android:layout_weight="1"
                android:layout_marginStart="5dp"/>
            <TextView
                android:textSize="10sp"
                android:textColor="@color/white100"
                android:id="@+id/tx_repeat_times"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="3dp"
                android:layout_marginStart="5dp"/>
        </LinearLayout>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/ll_rest"
        android:background="#14000000"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        android:layout_marginStart="4dp">
        <TextView
            android:textSize="10sp"
            android:textColor="@color/black40"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:text="@string/rest"
            android:layout_weight="1"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/black40"
            android:id="@+id/tx_rest_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>
