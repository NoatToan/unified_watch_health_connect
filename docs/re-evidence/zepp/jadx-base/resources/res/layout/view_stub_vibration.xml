<?xml version="1.0" encoding="utf-8"?>
<RadioGroup xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/sound_strength_radio_group"
    android:background="@color/s38"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/size_16dp"
    android:paddingEnd="@dimen/size_16dp">
    <RadioButton
        android:textSize="@dimen/size_15sp"
        android:textColor="@color/s1"
        android:gravity="center_vertical"
        android:id="@+id/sound_strength_standard"
        android:layout_width="match_parent"
        android:layout_height="43.5dp"
        android:button="@null"
        android:text="@string/ds_sound_strength_standard"
        android:drawablePadding="@dimen/size_15dp"
        android:drawableStart="@drawable/sound_strength_selector"/>
    <RadioButton
        android:textSize="@dimen/size_15sp"
        android:textColor="@color/s1"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="43.5dp"
        android:button="@null"
        android:text="@string/ds_sound_strength_strong"
        android:drawablePadding="@dimen/size_15dp"
        android:drawableStart="@drawable/sound_strength_selector"/>
</RadioGroup>
