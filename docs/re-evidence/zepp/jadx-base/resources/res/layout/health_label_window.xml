<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/health_label_home_ll"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/health_label_home_cl"
        android:background="@drawable/health_label_bg"
        android:layout_width="match_parent"
        android:layout_height="275dp">
        <TextView
            android:textSize="15sp"
            android:textColor="#99ffffff"
            android:gravity="center"
            android:id="@+id/health_label_home_title"
            android:layout_width="120dp"
            android:layout_height="21dp"
            android:layout_marginTop="9dp"
            android:text="@string/health_label_home_title"
            android:layout_marginStart="15dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0"/>
        <ImageView
            android:id="@+id/health_label_home_edit"
            android:layout_width="20dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:layout_marginEnd="15dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0"
            app:srcCompat="@drawable/ic_home_health_edit"/>
        <ImageView
            android:id="@+id/health_label_home_record"
            android:layout_width="20dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="22dp"
            android:layout_marginStart="82dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="1"
            app:srcCompat="@drawable/ic_home_health_record"/>
        <ImageView
            android:id="@+id/health_label_home_close"
            android:layout_width="20dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="22dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="1"
            app:srcCompat="@drawable/ic_home_health_close"/>
        <ImageView
            android:id="@+id/health_label_home_add"
            android:layout_width="20dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="22dp"
            android:layout_marginEnd="82dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="1"
            app:srcCompat="@drawable/ic_home_health_add"/>
        <ScrollView
            android:orientation="horizontal"
            android:id="@+id/health_label_content_sv"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="165dp"
            app:layout_constraintBottom_toTopOf="@+id/health_label_home_close"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/health_label_home_title">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/home_health_label_rv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </ScrollView>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/health_label_loading_ll"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/health_label_loading_iv"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_loading"/>
            <TextView
                android:textSize="15sp"
                android:textColor="#99ffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/health_label_loading"
                android:layout_marginStart="3dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/health_label_retry_ll"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/health_label_white99"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/health_label_network_error"/>
            <Button
                android:textSize="15sp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/health_label_retry_bt"
                android:background="@drawable/shape_health_label_retry"
                android:layout_width="100dp"
                android:layout_height="38dp"
                android:layout_marginTop="20dp"
                android:text="@string/health_label_refresh"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/health_label_blur_iv"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/health_label_history_delete_ll"
        android:background="@drawable/shape_label_history_delete_bg"
        android:visibility="gone"
        android:layout_width="120dp"
        android:layout_height="120dp">
        <ImageView
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/health_label_history_delete_iv"
            android:layout_width="36dp"
            android:layout_height="36dp"
            app:srcCompat="@drawable/ic_loading_onequarter"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/health_label_white99"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7.5dp"
            android:text="@string/health_label_history_delete"/>
    </LinearLayout>
</LinearLayout>
