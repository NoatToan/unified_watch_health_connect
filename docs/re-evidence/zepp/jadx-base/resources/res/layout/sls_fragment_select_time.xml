<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/sls_dialog_empty_area"/>
    <RelativeLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.huami.widget.wheelview.WheelView
            android:id="@+id/sls_wheel_view"
            android:background="@color/sls_back_1a"
            android:layout_width="match_parent"
            android:layout_height="261dp"
            android:layout_marginTop="30dp"/>
        <RelativeLayout
            android:background="@drawable/sls_change_live_pop_bg"
            android:layout_width="match_parent"
            android:layout_height="49dp">
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="15sp"
                android:textColor="@color/white100"
                android:id="@+id/sls_cancel"
                android:paddingLeft="14dp"
                android:paddingTop="10dp"
                android:paddingRight="14dp"
                android:paddingBottom="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sls_cancel"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="15sp"
                android:textColor="@color/white100"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sls_set_play_time"
                android:layout_centerInParent="true"
                android:layout_marginStart="14dp"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="15sp"
                android:textColor="@color/white100"
                android:id="@+id/sls_sure"
                android:paddingLeft="14dp"
                android:paddingTop="10dp"
                android:paddingRight="14dp"
                android:paddingBottom="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sls_ok"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </RelativeLayout>
</LinearLayout>
