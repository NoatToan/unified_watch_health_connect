<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/layout"
    android:background="@color/white100"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/sls_notification_image"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:layout_weight="103"
        android:layout_centerVertical="true"
        android:contentDescription="@string/app_name"
        android:layout_alignParentStart="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="254"
        android:layout_centerVertical="true"
        android:layout_marginStart="0dp"
        android:layout_toEndOf="@+id/sls_notification_image">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/black100"
            android:ellipsize="end"
            android:gravity="bottom"
            android:id="@+id/sls_notification_title"
            android:fadingEdge="horizontal"
            android:fadingEdgeLength="10dp"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:singleLine="true"
            android:layout_weight="35"
            android:layout_marginStart="14dp"/>
        <TextView
            android:textSize="9sp"
            android:textColor="@color/black100"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/sls_notification_text"
            android:fadingEdge="horizontal"
            android:fadingEdgeLength="10dp"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:singleLine="true"
            android:layout_weight="16"
            android:layout_marginStart="14dp"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="48"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="20dp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/sls_notification_btn_collection"
                    android:padding="10dp"
                    android:layout_width="35dp"
                    android:layout_height="34dp"
                    android:src="@drawable/sls_notification_collection"
                    android:contentDescription="@string/app_name"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:padding="10dp"
                    android:layout_width="35dp"
                    android:layout_height="34dp"
                    android:src="@drawable/sls_notification_btn_prev"
                    android:contentDescription="@string/app_name"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/sls_notification_btn_pause"
                    android:padding="10dp"
                    android:layout_width="35dp"
                    android:layout_height="34dp"
                    android:src="@drawable/sls_notification_btn_pause"
                    android:contentDescription="@string/app_name"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:padding="10dp"
                    android:layout_width="35dp"
                    android:layout_height="34dp"
                    android:src="@drawable/sls_notification_btn_next"
                    android:contentDescription="@string/app_name"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
