<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/sls_lock_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@string/app_name"/>
    <View
        android:background="#70000000"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.huami.sleepassistant.lib.widget.SlidingFinishLayout
        android:orientation="vertical"
        android:id="@+id/sls_lock_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="40sp"
            android:textColor="@color/white100"
            android:id="@+id/sls_lock_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="62dp"
            android:layout_alignParentTop="true"
            android:layout_marginStart="29dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/white100"
            android:id="@+id/sls_lock_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_below="@+id/sls_lock_time"
            android:layout_alignStart="@+id/sls_lock_time"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/white100"
            android:id="@+id/sls_lock_music_artist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="19dp"
            android:layout_below="@+id/sls_lock_date"
            android:layout_alignStart="@+id/sls_lock_time"/>
        <TextView
            android:textColor="@color/white100"
            android:id="@+id/sls_lock_music_lrc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30dp"
            android:text=""
            android:layout_above="@+id/sls_lock_control"
            android:layout_centerHorizontal="true"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/sls_lock_control"
            android:layout_width="match_parent"
            android:layout_height="39dp"
            android:layout_marginBottom="28dp"
            android:layout_above="@+id/sls_lock_tip">
            <ImageView
                android:id="@+id/sls_lock_music_pre"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:src="@drawable/sls_lock_btn_prev"
                android:layout_weight="1"
                android:contentDescription="@string/app_name"/>
            <ImageView
                android:id="@+id/sls_lock_music_play"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:src="@drawable/sls_lock_btn_pause"
                android:layout_weight="1"
                android:contentDescription="@string/app_name"/>
            <ImageView
                android:id="@+id/sls_lock_music_next"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:src="@drawable/sls_lock_btn_next"
                android:layout_weight="1"
                android:contentDescription="@string/app_name"/>
            <ImageView
                android:id="@+id/sls_lock_music_fav"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:src="@drawable/sls_lock_btn_love"
                android:layout_weight="1"
                android:contentDescription="@string/app_name"/>
        </LinearLayout>
        <com.huami.sleepassistant.lib.widget.CustomTextView
            android:textSize="15sp"
            android:textColor="@color/white100"
            android:id="@+id/sls_lock_tip"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginBottom="30dp"
            android:text="@string/sls_slide_unlock"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"/>
    </com.huami.sleepassistant.lib.widget.SlidingFinishLayout>
</FrameLayout>
