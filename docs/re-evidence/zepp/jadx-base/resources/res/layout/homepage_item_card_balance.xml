<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="176dp">
    <com.huami.module.homepage.cards.cardui.PiecewiseLineView
        android:id="@+id/balance_state"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_marginTop="13dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/balance_description"/>
    <com.huami.module.homepage.cards.cardui.BackgroundTextView
        android:gravity="center"
        android:id="@+id/balance_mask"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/homepage_female_health_none_data"
        app:backgroundTintAlpha="0.92"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/balance_keep_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="46dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Rainbow.TextAppearance.Number2"/>
    <TextView
        android:textColor="@color/s2"
        android:id="@+id/balance_keep_time_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="3dp"
        app:layout_constraintBaseline_toBaselineOf="@+id/balance_keep_time"
        app:layout_constraintStart_toEndOf="@+id/balance_keep_time"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <TextView
        android:textColor="@color/s2"
        android:id="@+id/balance_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="3dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/balance_keep_time"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <com.huami.module.homepage.cards.cardui.CardTitleBarView
        android:id="@+id/balance_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:titleText="@string/homepage_item_card_balance"/>
</androidx.constraintlayout.widget.ConstraintLayout>
