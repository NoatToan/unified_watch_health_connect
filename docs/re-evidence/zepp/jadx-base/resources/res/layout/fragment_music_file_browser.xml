<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s10"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:orientation="vertical"
        android:id="@+id/toolbar"
        android:background="@color/s38"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/iv_back"
            android:padding="5dp"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/ic_arrow_back_20_2x"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:layout_alignParentStart="true"
            app:tint="?android:attr/textColorPrimary"/>
        <TextView
            android:textSize="17sp"
            android:textColor="@color/s1"
            android:id="@+id/tv_title"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/file_manager"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"/>
        <FrameLayout
            android:id="@+id/layout_transform_btn"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_centerVertical="true"
            android:layout_marginEnd="10dp"
            android:layout_alignParentEnd="true">
            <ImageView
                android:id="@+id/btn_trans"
                android:padding="5dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ftp_icon_transport_list_button"
                app:tint="@color/ftp_icon_transport_list_button_tint"/>
            <View
                android:layout_gravity="end|top"
                android:id="@+id/view_trans_point"
                android:background="@drawable/ftp_export_red_point"
                android:visibility="invisible"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_margin="3dp"
                android:backgroundTint="@color/p3"/>
        </FrameLayout>
    </RelativeLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/s2"
        android:id="@+id/tv_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:text="@string/record_sync_desc"
        android:drawablePadding="4dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        app:drawableStartCompat="@drawable/ic_alert_20"
        app:drawableTint="@color/p3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>
    <FrameLayout
        android:background="@drawable/ftp_file_list_bg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="15dp"
        app:layout_constraintBottom_toTopOf="@+id/view_bottom_line"
        app:layout_constraintTop_toBottomOf="@+id/tv_desc">
        <fragment
            android:name="com.huami.watch.musicupload.fragment.FileFragment"
            android:id="@+id/fragment_file_browser"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <View
        android:id="@+id/view_bottom_line"
        android:background="@color/s4"
        android:layout_width="match_parent"
        android:layout_height="0.03dp"
        app:layout_constraintBottom_toTopOf="@+id/layout_upload"
        app:layout_constraintStart_toStartOf="parent"/>
    <FrameLayout
        android:id="@+id/layout_upload"
        android:background="@color/s38"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:layout_alignParentBottom="true"
        app:layout_constraintBottom_toBottomOf="parent">
        <TextView
            android:enabled="false"
            android:textSize="12sp"
            android:textColor="@color/s2"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/btn_upload"
            android:padding="8dp"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/file_manager_upload"
            android:drawableTop="@drawable/ftp_ic_upload"
            app:drawableTint="@color/s2"/>
    </FrameLayout>
    <View
        android:id="@+id/fog_layer1"
        android:background="@color/s38"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:alpha="0.65"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>
    <View
        android:id="@+id/fog_layer2"
        android:background="@color/s38"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="54dp"
        android:layout_height="0dp"
        android:alpha="0.65"
        app:layout_constraintBottom_toBottomOf="@+id/toolbar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/back_fog_layer"
        android:background="@color/s38"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="54dp"
        android:layout_height="0dp"
        android:alpha="0.65"
        app:layout_constraintBottom_toBottomOf="@+id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
