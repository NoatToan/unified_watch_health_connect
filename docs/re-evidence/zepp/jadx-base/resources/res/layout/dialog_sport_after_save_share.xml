<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:background="@drawable/shape_rect_white_corner_10"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="30dp"
    android:layout_marginEnd="30dp">
    <ImageView
        android:id="@+id/iv_video_share_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:src="@drawable/running_track_video_close"
        android:layout_marginEnd="5dp"
        android:layout_alignParentEnd="true"/>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/color_333333"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/run_share_dialog_share_title"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_666666"
            android:gravity="center"
            android:id="@+id/tv_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="@string/run_share_dialog_share_content"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="30dp">
            <ImageView
                android:id="@+id/tv_share_wechat"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:src="@drawable/running_track_video_wechat"
                android:layout_weight="1"/>
            <ImageView
                android:id="@+id/tv_share_weibo"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:src="@drawable/running_track_video_weibo"
                android:layout_weight="1"/>
            <ImageView
                android:id="@+id/tv_share_qq"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:src="@drawable/running_track_video_qq"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
