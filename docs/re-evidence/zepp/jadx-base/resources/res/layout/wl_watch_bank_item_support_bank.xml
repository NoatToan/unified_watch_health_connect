<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="40dp">
    <TextView
        android:textSize="12sp"
        android:textColor="#e6000000"
        android:gravity="center"
        android:id="@+id/support_bank_name"
        android:background="@drawable/wl_watch_bank_list_bg_one"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2"
        android:lineSpacingExtra="6sp"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:background="@drawable/wl_watch_bank_list_bg_two"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <ImageView
            android:id="@+id/support_bank_debit"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/wl_watch_bank_support"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:background="@drawable/wl_watch_bank_list_bg_one"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <ImageView
            android:id="@+id/support_bank_credit"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/wl_watch_bank_support"/>
    </LinearLayout>
</LinearLayout>
