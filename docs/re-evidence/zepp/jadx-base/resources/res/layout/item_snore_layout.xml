<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/s38"
    android:paddingLeft="@dimen/snore_common_page_padding"
    android:paddingTop="@dimen/snore_common_page_padding"
    android:paddingRight="@dimen/snore_common_page_padding"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="12sp"
        android:textColor="@color/s1"
        android:id="@+id/startTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TextView"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_below="@+id/startTime">
        <ImageView
            android:id="@+id/start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/snore_common_page_padding"
            android:src="@drawable/snore_play_audio_icon"
            android:layout_centerVertical="true"/>
        <ImageView
            android:id="@+id/delete"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/snore_delete_icon"
            android:layout_alignTop="@+id/start"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
        <ImageView
            android:id="@+id/upload"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="18dp"
            android:src="@drawable/snore_ic_uploaded_cloud"
            android:layout_toLeftOf="@+id/delete"
            android:layout_alignTop="@+id/start"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/s3"
            android:gravity="right"
            android:id="@+id/duration"
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:layout_toLeftOf="@+id/upload"
            android:layout_centerVertical="true"
            android:layout_alignWithParentIfMissing="true"/>
        <ImageView
            android:id="@+id/playVoice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/snore_voice_play0"
            android:scaleType="fitXY"
            android:layout_toLeftOf="@+id/duration"
            android:layout_toRightOf="@+id/start"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
</LinearLayout>
