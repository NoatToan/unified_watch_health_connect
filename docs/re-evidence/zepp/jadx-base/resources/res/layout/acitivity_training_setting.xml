<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/s38"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.xiaomi.hm.health.baseui.widget.ItemView
            android:id="@+id/item_max_hr_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:itemDivider="normal"
            app:itemEndArrow="false"
            app:itemSummary="@string/max_hr_warning_desc"
            app:itemSwitch="true"
            app:itemTitle="@string/max_hr_warning"
            app:itemTitleTipIcon="@drawable/max_hr_help"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/seek_bar_container"
            android:paddingTop="20dp"
            android:paddingBottom="17dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/hr_value_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="24sp"
                    android:textColor="@color/orange100"
                    android:id="@+id/hr_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/s2"
                    android:layout_gravity="bottom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="1dp"
                    android:text="@string/unit_hr"
                    android:layout_marginStart="3dp"/>
            </LinearLayout>
            <com.xiaomi.hm.health.training.ui.widget.HeartRateSeekBar
                android:id="@+id/seek_bar_max_hr"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:layout_marginTop="9dp"
                app:hrsb_backgroundHeight="4dp"
                app:hrsb_max="220"
                app:hrsb_progress="0"
                app:hrsb_thumbSize="16dp"/>
            <LinearLayout
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/s2"
                    android:id="@+id/hr_section_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/s2"
                    android:id="@+id/hr_section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
