<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/scale_measuring_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:gravity="center"
        android:id="@+id/baby_weight_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="36.7dp"
        style="@style/babyWeightingTitleStyle"/>
    <TextView
        android:gravity="center"
        android:id="@+id/baby_weight_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_below="@+id/baby_weight_title"
        style="@style/babyWeightingSubTitleStyle"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/baby_weight_value_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_below="@+id/baby_weight_content">
        <com.huami.widget.typeface.TypefaceTextView
            android:gravity="bottom"
            android:id="@+id/baby_weight_value"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:fontFamily="din-med"
            style="@style/babyWeightingValueTextStyle"/>
        <TextView
            android:textSize="13.3sp"
            android:textColor="@color/weighting_unit_text_color"
            android:gravity="bottom"
            android:id="@+id/baby_weight_value_unit"
            android:paddingBottom="8dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="2dp"/>
    </LinearLayout>
    <TextView
        android:textSize="16.7sp"
        android:textColor="@color/baby_weighting_tip_text_color"
        android:gravity="center"
        android:id="@+id/tips_tv"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="23.3dp"
        android:text="@string/over_max_range_weight"
        android:layout_below="@+id/baby_weight_content"/>
    <RelativeLayout
        android:id="@+id/baby_weight_img_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="100dp"
        android:layout_below="@+id/baby_weight_content"
        android:layout_centerHorizontal="true">
        <ImageView
            android:id="@+id/baby_weight_img_body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <FrameLayout
        android:id="@+id/family_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</RelativeLayout>
