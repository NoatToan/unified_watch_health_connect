<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/pale_grey_two"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="20sp"
        android:textColor="@color/black80"
        android:gravity="center"
        android:id="@+id/title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/play_miband3_title_4"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/black60"
        android:gravity="center"
        android:id="@+id/sub_title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:text="@string/play_miband3_subtitle_4"
        android:layout_below="@+id/title_tv"
        android:layout_centerHorizontal="true"/>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp"
        android:src="@drawable/img_band_3"
        android:layout_below="@+id/sub_title_tv"
        android:layout_centerHorizontal="true"/>
    <FrameLayout
        android:id="@+id/finding_phone_img"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="117dp"
        android:layout_below="@+id/sub_title_tv"
        android:layout_centerHorizontal="true">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/img_band_3_finding_phone"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="10sp"
            android:textColor="@color/play_miband3_text_color"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/find_phone_tv"
            android:layout_width="47dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="43dp"
            android:text="@string/play_miband3_distance_heart_rate_find_phone"
            android:maxLines="1"
            android:fontFamily="km"/>
    </FrameLayout>
    <ImageView
        android:id="@+id/find_phone_img"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="120dp"
        android:src="@drawable/img_band_3_spread_1"
        android:layout_below="@+id/sub_title_tv"
        android:layout_centerHorizontal="true"/>
    <com.xiaomi.hm.health.ui.playmiband2.MovableImageView
        android:id="@+id/close_img"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="185dp"
        android:src="@drawable/img_band_3_close"
        android:layout_below="@+id/sub_title_tv"
        android:layout_centerHorizontal="true"/>
    <View
        android:id="@+id/center_view_small"
        android:background="@color/transparent"
        android:layout_width="70dp"
        android:layout_height="1px"
        android:layout_centerInParent="true"/>
    <com.xiaomi.hm.health.ui.playmiband2.MovableImageView
        android:id="@+id/hand_img"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="210dp"
        android:src="@drawable/img_hand"
        android:layout_below="@+id/sub_title_tv"
        android:alpha="0"
        android:layout_toEndOf="@+id/center_view_small"/>
    <View
        android:id="@+id/center_view"
        android:background="@color/transparent"
        android:layout_width="1px"
        android:layout_height="1px"
        android:layout_centerInParent="true"/>
    <com.xiaomi.hm.health.ui.playmiband2.MovableImageView
        android:id="@+id/hand_img_1"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="178dp"
        android:src="@drawable/img_hand"
        android:layout_below="@+id/sub_title_tv"
        android:layout_toEndOf="@+id/center_view"/>
</RelativeLayout>
