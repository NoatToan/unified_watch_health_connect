<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/dialog_empty_area"/>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/user_info_dialog_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/user_info_mili_normal_txt_size"
                android:textColor="@color/s1"
                android:gravity="center"
                android:id="@+id/select_image_camera_area"
                android:background="@drawable/user_info_btn_click_bg_round_top"
                android:layout_width="match_parent"
                android:layout_height="@dimen/user_info_item_height_small"
                android:text="@string/user_info_select_from_camera"/>
            <View
                android:background="@color/s4"
                android:layout_width="match_parent"
                android:layout_height="1px"/>
            <TextView
                android:textSize="@dimen/user_info_mili_normal_txt_size"
                android:textColor="@color/s1"
                android:gravity="center"
                android:id="@+id/select_image_local_area"
                android:background="@drawable/user_info_btn_click_bg_round_bottom"
                android:layout_width="match_parent"
                android:layout_height="@dimen/user_info_item_height_small"
                android:text="@string/user_info_select_from_local"/>
        </LinearLayout>
        <FrameLayout
            android:background="@drawable/user_info_dialog_bg"
            android:layout_width="match_parent"
            android:layout_height="@dimen/user_info_item_height_max"
            android:layout_marginTop="@dimen/user_info_item_margin">
            <TextView
                android:textSize="@dimen/click_button_text_size"
                android:textColor="@color/s2"
                android:gravity="center"
                android:id="@+id/select_image_cancel"
                android:background="@drawable/user_info_btn_click_bg_round_dialog"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/cancel"/>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
