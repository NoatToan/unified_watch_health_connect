<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/s38"
    android:layout_width="match_parent"
    android:layout_height="72dp">
    <ImageView
        android:id="@+id/icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_centerVertical="true"
        android:layout_marginStart="19dp"/>
    <CheckBox
        android:id="@+id/check"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:button="@drawable/checkbox_style"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/common_item_padding"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/s1"
        android:ellipsize="end"
        android:id="@+id/text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_centerVertical="true"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="13.3dp"
        android:layout_toStartOf="@+id/check"
        android:layout_toEndOf="@+id/icon"/>
    <View
        android:layout_gravity="bottom"
        android:background="@color/s4"
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/common_item_padding"
        android:layout_marginEnd="@dimen/common_item_padding"/>
</RelativeLayout>
