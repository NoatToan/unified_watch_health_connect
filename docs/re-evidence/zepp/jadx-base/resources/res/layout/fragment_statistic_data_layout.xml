<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/physical_growth_weight_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:textSize="18dp"
            android:textStyle="bold"
            android:textColor="@color/statistic_title_color"
            android:gravity="center"
            android:id="@+id/statistic_data_chart_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/statistic_sub_title_color"
            android:gravity="center"
            android:id="@+id/statistic_data_chart_sub_title"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_below="@+id/statistic_data_chart_title"/>
        <RelativeLayout
            android:id="@+id/statistic_data_chart"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="30dp"
            android:layout_below="@+id/statistic_data_chart_title"/>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
