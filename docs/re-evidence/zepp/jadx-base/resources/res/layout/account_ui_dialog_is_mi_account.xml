<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/s38"
    app:cardCornerRadius="@dimen/account_ui_size_10dp">
    <androidx.cardview.widget.CardView
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="241dp"
        android:layout_marginLeft="@dimen/account_ui_size_50dp"
        android:layout_marginRight="@dimen/account_ui_size_50dp"
        app:cardBackgroundColor="@color/s38"
        app:cardCornerRadius="@dimen/account_ui_size_10dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_horizontal"
            android:layout_width="65dp"
            android:layout_height="65dp"
            android:layout_marginTop="40dp"
            android:src="@drawable/account_ui_ic_logo_xiaomi"/>
        <TextView
            android:textColor="@color/s2"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="120.7dp"
            android:text="@string/account_ui_is_xiaomi_account"/>
        <View
            android:layout_gravity="bottom"
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="@dimen/account_ui_size_0.5dp"
            android:layout_marginTop="39.8dp"
            android:layout_marginBottom="54dp"/>
        <LinearLayout
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="54dp">
            <TextView
                android:textColor="@color/s2"
                android:gravity="center"
                android:id="@+id/tv_xiaomi_account_yes"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/account_ui_friend_unfollow_confirm_yes"
                android:layout_weight="1"/>
            <View
                android:background="@color/s4"
                android:layout_width="@dimen/account_ui_size_0.5dp"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/account_ui_size_15dp"
                android:layout_marginBottom="@dimen/account_ui_size_15dp"/>
            <TextView
                android:textColor="@color/s2"
                android:gravity="center"
                android:id="@+id/tv_xiaomi_account_no"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/account_ui_friend_unfollow_confirm_no"
                android:layout_weight="1"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>
