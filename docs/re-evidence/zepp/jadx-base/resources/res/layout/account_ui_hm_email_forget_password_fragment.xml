<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/s36"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatEditText
        android:textSize="@dimen/account_ui_hm_email_text_size"
        android:textColor="@color/s1"
        android:textColorHint="@color/s3"
        android:id="@+id/hm_email_input_email"
        android:background="@drawable/account_ui_bg_login_edit"
        android:layout_width="match_parent"
        android:layout_height="@dimen/account_ui_hm_email_input_height"
        android:layout_marginTop="@dimen/account_ui_hm_email_logo_margin"
        android:hint="@string/account_ui_input_email"
        android:inputType="textEmailAddress"
        android:paddingStart="@dimen/account_ui_hm_email_input_padding"
        android:paddingEnd="@dimen/account_ui_hm_email_input_padding"
        android:layout_marginStart="@dimen/account_ui_hm_email_input_margin"
        android:layout_marginEnd="@dimen/account_ui_hm_email_input_margin"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/hm_email_verification_code_rl"
        android:layout_width="match_parent"
        android:layout_height="@dimen/account_ui_hm_email_input_height"
        android:layout_marginTop="@dimen/account_ui_hm_email_password_margin_top"
        android:layout_below="@+id/hm_email_input_email"
        android:layout_marginStart="@dimen/account_ui_hm_email_input_margin"
        android:layout_marginEnd="@dimen/account_ui_hm_email_input_margin">
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <androidx.appcompat.widget.AppCompatEditText
                android:textSize="@dimen/account_ui_hm_email_text_size"
                android:textColor="@color/s1"
                android:id="@+id/hm_email_verification_code"
                android:background="@drawable/account_ui_bg_login_edit"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:inputType="text"
                android:paddingStart="@dimen/account_ui_hm_email_input_padding"
                android:paddingEnd="@dimen/account_ui_hm_email_input_padding"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/account_ui_hm_email_text_size"
                android:textColor="@color/s3"
                android:gravity="start|center_vertical"
                android:id="@+id/input_email_verification_code_hint"
                android:background="@drawable/account_ui_bg_login_edit"
                android:layout_width="match_parent"
                android:layout_height="@dimen/account_ui_hm_email_input_height"
                android:text="@string/account_ui_account_input_verify_code"
                android:maxLines="2"
                android:paddingStart="@dimen/account_ui_hm_email_input_padding"
                android:paddingEnd="@dimen/account_ui_hm_email_input_padding"
                app:autoSizeMaxTextSize="@dimen/account_ui_hm_email_text_size"
                app:autoSizeMinTextSize="10sp"
                app:autoSizeTextType="uniform"/>
        </FrameLayout>
        <Space
            android:layout_width="@dimen/account_ui_size_10dp"
            android:layout_height="match_parent"/>
        <androidx.cardview.widget.CardView
            android:layout_gravity="end|top"
            android:layout_width="@dimen/account_ui_hm_email_verification_code_image_width"
            android:layout_height="match_parent"
            android:layout_marginTop="3.3dp"
            app:cardBackgroundColor="@color/s36"
            app:cardCornerRadius="6dp"
            app:cardElevation="0dp">
            <com.huami.account.ui.view.VerificationCodeView
                android:id="@+id/hm_email_verification_code_image"
                android:layout_width="@dimen/account_ui_hm_email_verification_code_image_width"
                android:layout_height="match_parent"
                app:bg_color="@color/s4"
                app:case_sensitive="false"
                app:code_type="number"
                app:line_num="10"
                app:point_num="100"
                app:text_color="@color/s22"
                app:text_length="4"
                app:text_size="20sp"/>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/hm_email_error"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/account_ui_hm_email_password_margin_top"
        android:layout_below="@+id/hm_email_verification_code_rl"
        android:layout_centerHorizontal="true">
        <ImageView
            android:layout_width="@dimen/account_ui_hm_email_error_img_size"
            android:layout_height="@dimen/account_ui_hm_email_error_img_size"
            android:src="@drawable/account_ui_hm_email_error_img"
            android:scaleType="fitXY"
            app:tint="@color/account_ui_very_high_color"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/account_ui_very_high_color"
            android:gravity="center"
            android:id="@+id/hm_email_error_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/account_ui_hm_email_error_margin"/>
    </LinearLayout>
    <TextView
        android:enabled="false"
        android:textSize="@dimen/account_ui_login_btn_text_size"
        android:textColor="@drawable/account_ui_select_alive_btn_bg"
        android:gravity="center"
        android:id="@+id/hm_email_btn"
        android:background="@drawable/account_ui_btn_bg_login"
        android:layout_width="match_parent"
        android:layout_height="@dimen/account_ui_click_button_h"
        android:layout_marginTop="@dimen/account_ui_hm_email_register_btn_margin_top"
        android:text="@string/account_ui_login_email_forget_password_commit"
        android:layout_below="@+id/hm_email_verification_code_rl"
        android:layout_marginStart="@dimen/account_ui_hm_email_input_margin"
        android:layout_marginEnd="@dimen/account_ui_hm_email_input_margin"/>
</RelativeLayout>
