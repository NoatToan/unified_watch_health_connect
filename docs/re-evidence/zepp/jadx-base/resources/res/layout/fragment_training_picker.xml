<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="230dp">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/center_bg"
            android:background="@color/s36"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_centerInParent="true"/>
        <View
            android:background="@color/s4"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_below="@+id/center_bg"/>
        <View
            android:background="@color/s4"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_above="@+id/center_bg"/>
        <View
            android:id="@+id/vertical_line"
            android:background="@color/s4"
            android:visibility="gone"
            android:layout_width="1px"
            android:layout_height="match_parent"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <ViewStub
        android:id="@+id/stub_wheel_one"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout="@layout/view_wheel_one_1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ViewStub
        android:id="@+id/stub_wheel_two"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout="@layout/view_wheel_two_1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ViewStub
        android:id="@+id/stub_wheel_four"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout="@layout/view_wheel_four_1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
