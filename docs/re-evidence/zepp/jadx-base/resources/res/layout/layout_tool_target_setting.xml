<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="?attr/textAppearanceBody3"
        android:textColor="@color/s1"
        android:gravity="center_vertical"
        android:id="@+id/tool_target_setting"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_15dp"
        android:text="@string/small_tool_item_target_setting"
        android:drawablePadding="10dp"
        android:drawableStart="@drawable/ic_tool_target_setting_24"
        android:layout_marginStart="@dimen/size_15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tool_target_setting_step_layout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_40dp"
        android:layout_marginTop="@dimen/size_12dp"
        app:layout_constraintTop_toBottomOf="@+id/tool_target_setting">
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="?attr/textAppearanceBody4"
            android:textColor="@color/s2"
            android:gravity="center_vertical"
            android:id="@+id/tool_target_setting_step_title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/step_number"
            android:layout_marginStart="@dimen/size_15dp"
            app:layout_constraintEnd_toStartOf="@+id/tool_target_setting_step"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="?attr/textAppearanceNumber6"
            android:textColor="@color/s1"
            android:gravity="center_vertical"
            android:id="@+id/tool_target_setting_step"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/size_6dp"
            app:layout_constraintEnd_toStartOf="@+id/tool_target_setting_step_unit"
            app:layout_constraintStart_toEndOf="@+id/tool_target_setting_step_title"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="?attr/textAppearanceBody4"
            android:textSize="@dimen/play_sub_title_size"
            android:textColor="@color/s2"
            android:gravity="center_vertical"
            android:id="@+id/tool_target_setting_step_unit"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/size_4dp"
            app:layout_constraintEnd_toStartOf="@+id/tool_target_setting_step_right"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/tool_target_setting_step_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_tool_right_24"
            android:layout_marginEnd="@dimen/size_15dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tool_target_setting_weight_layout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_40dp"
        android:layout_marginTop="3dp"
        app:layout_constraintTop_toBottomOf="@+id/tool_target_setting_step_layout">
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="?attr/textAppearanceBody4"
            android:textColor="@color/s2"
            android:gravity="center_vertical"
            android:id="@+id/tool_target_setting_weight_title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/health_data_weight"
            android:layout_marginStart="@dimen/size_15dp"
            app:layout_constraintEnd_toStartOf="@+id/tool_target_setting_weight"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="?attr/textAppearanceNumber6"
            android:textColor="@color/s1"
            android:gravity="center_vertical"
            android:id="@+id/tool_target_setting_weight"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/size_6dp"
            app:layout_constraintEnd_toStartOf="@+id/tool_target_setting_weight_unit"
            app:layout_constraintStart_toEndOf="@+id/tool_target_setting_weight_title"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="?attr/textAppearanceBody4"
            android:textColor="@color/s2"
            android:gravity="center_vertical"
            android:id="@+id/tool_target_setting_weight_unit"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/size_4dp"
            app:layout_constraintEnd_toStartOf="@+id/tool_target_setting_weight_right"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/tool_target_setting_weight_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_tool_right_24"
            android:layout_marginEnd="@dimen/size_15dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tool_target_setting_kcal_layout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_40dp"
        android:layout_marginTop="3dp"
        app:layout_constraintTop_toBottomOf="@+id/tool_target_setting_weight_layout">
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="?attr/textAppearanceBody4"
            android:textColor="@color/s2"
            android:gravity="center_vertical"
            android:id="@+id/tool_target_setting_kcal_title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/active_calorie"
            android:layout_marginStart="@dimen/size_15dp"
            app:layout_constraintEnd_toStartOf="@+id/tool_target_setting_kcal"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="?attr/textAppearanceNumber6"
            android:textColor="@color/s1"
            android:gravity="center_vertical"
            android:id="@+id/tool_target_setting_kcal"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/size_6dp"
            app:layout_constraintEnd_toStartOf="@+id/tool_target_setting_kcal_unit"
            app:layout_constraintStart_toEndOf="@+id/tool_target_setting_kcal_title"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="?attr/textAppearanceBody4"
            android:textColor="@color/s2"
            android:gravity="center_vertical"
            android:id="@+id/tool_target_setting_kcal_unit"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/size_4dp"
            app:layout_constraintEnd_toStartOf="@+id/tool_target_setting_kcal_right"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/tool_target_setting_kcal_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_tool_right_24"
            android:layout_marginEnd="@dimen/size_15dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tool_target_setting_sleep_layout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_40dp"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="@dimen/size_6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tool_target_setting_kcal_layout">
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="?attr/textAppearanceBody4"
            android:textColor="@color/s2"
            android:gravity="center_vertical"
            android:id="@+id/tool_target_setting_sleep_title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/app_sort_sleep"
            android:layout_marginStart="@dimen/size_15dp"
            app:layout_constraintEnd_toStartOf="@+id/tool_target_setting_hour"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="?attr/textAppearanceNumber6"
            android:textColor="@color/s1"
            android:gravity="center_vertical"
            android:id="@+id/tool_target_setting_hour"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/size_6dp"
            app:layout_constraintEnd_toStartOf="@+id/tool_target_setting_hour_unit"
            app:layout_constraintStart_toEndOf="@+id/tool_target_setting_sleep_title"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="?attr/textAppearanceBody4"
            android:textColor="@color/s2"
            android:gravity="center_vertical"
            android:id="@+id/tool_target_setting_hour_unit"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/size_4dp"
            app:layout_constraintEnd_toStartOf="@+id/tool_target_setting_minute"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="?attr/textAppearanceNumber6"
            android:textColor="@color/s1"
            android:gravity="center_vertical"
            android:id="@+id/tool_target_setting_minute"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/size_6dp"
            app:layout_constraintEnd_toStartOf="@+id/tool_target_setting_minute_unit"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="?attr/textAppearanceBody4"
            android:textColor="@color/s2"
            android:gravity="center_vertical"
            android:id="@+id/tool_target_setting_minute_unit"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/size_4dp"
            app:layout_constraintEnd_toStartOf="@+id/tool_target_setting_sleep_right"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/tool_target_setting_sleep_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_tool_right_24"
            android:layout_marginEnd="@dimen/size_15dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
