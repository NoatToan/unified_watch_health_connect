<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.lib.rainbow.titlebar.RainbowTitleBar
        android:id="@+id/action_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/update_event"
        style="@style/Rainbow.TextAppearance.Title3"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guidelineLeft"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="15dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guidelineRight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="15dp"/>
    <FrameLayout
        android:id="@+id/item_auto_sync_system_calendar"
        android:background="@drawable/bg_dialog"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        app:layout_constraintEnd_toStartOf="@+id/guidelineRight"
        app:layout_constraintStart_toStartOf="@+id/guidelineLeft"
        app:layout_constraintTop_toBottomOf="@+id/action_bar">
        <TextView
            android:textColor="@color/s1"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:text="@string/mifit_system_schedule_sync"
            android:lines="1"
            style="@style/Rainbow.TextAppearance.Number6"/>
        <TextView
            android:textColor="@color/s2"
            android:id="@+id/sync_calendar_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="@string/mifit_schedule_read_system_summary"
            android:lineSpacingMultiplier="1.2"
            android:layout_marginEnd="45dp"
            style="@style/Rainbow.TextAppearance.Number8"/>
        <com.huami.lib.rainbow.widget.SwitchCompat
            android:layout_gravity="center"
            android:id="@+id/sw_sync_calendar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
