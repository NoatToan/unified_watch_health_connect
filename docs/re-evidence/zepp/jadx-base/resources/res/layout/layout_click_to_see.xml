<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/common_light_color"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true">
            <ImageView
                android:background="@drawable/time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/white_70_percent"
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="@string/time"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="180dp">
            <ImageView
                android:background="@drawable/step"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/white_70_percent"
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="@string/step_number"/>
        </LinearLayout>
    </RelativeLayout>
    <RelativeLayout
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60.7dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true">
            <ImageView
                android:background="@drawable/distance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/white_70_percent"
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="@string/distance"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="180dp">
            <ImageView
                android:background="@drawable/calorie"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/white_70_percent"
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="@string/heat"/>
        </LinearLayout>
    </RelativeLayout>
    <RelativeLayout
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60.7dp"
        android:layout_marginBottom="33dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true">
            <ImageView
                android:background="@drawable/hreat_rate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/white_70_percent"
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="@string/heart_rate"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="180dp">
            <ImageView
                android:background="@drawable/battery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/white_70_percent"
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="@string/battery"/>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
