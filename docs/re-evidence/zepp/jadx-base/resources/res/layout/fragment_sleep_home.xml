<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/s5"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <RadioGroup
        android:orientation="horizontal"
        android:id="@+id/tab_group"
        android:background="@drawable/shape_health_data_filter_tab_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/slp_size_15dp"
        android:layout_marginStart="@dimen/slp_size_15dp"
        android:layout_marginEnd="@dimen/slp_size_15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <RadioButton
            android:id="@+id/tab_day"
            android:background="@drawable/selector_sleep_data_tab_start"
            android:checked="true"
            android:text="@string/statistics_day"
            android:layout_weight="1"
            style="@style/SleepDataTab"/>
        <RadioButton
            android:id="@+id/tab_week"
            android:background="@drawable/selector_sleep_data_tab_normal"
            android:text="@string/radio_week"
            android:layout_weight="1"
            style="@style/SleepDataTab"/>
        <RadioButton
            android:id="@+id/tab_month"
            android:background="@drawable/selector_sleep_data_tab_normal"
            android:text="@string/month"
            android:layout_weight="1"
            style="@style/SleepDataTab"/>
        <RadioButton
            android:id="@+id/tab_year"
            android:background="@drawable/selector_sleep_data_tab_end"
            android:text="@string/year"
            android:layout_weight="1"
            style="@style/SleepDataTab"/>
    </RadioGroup>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="vertical"
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:id="@+id/container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <FrameLayout
                android:id="@+id/sleep_ad_container"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/sleep_main_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="30dp"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp">
                <TextView
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/s1"
                    android:id="@+id/card_status_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:text="@string/card_intro_sleep_title"
                    android:layout_marginStart="15dp"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/s2"
                    android:id="@+id/card_status_introduce"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="15dp"
                    android:text="@string/slp_intro"
                    android:lineSpacingExtra="5.3sp"
                    android:layout_marginStart="15dp"
                    android:layout_marginEnd="14dp"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
