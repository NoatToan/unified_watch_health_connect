<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:layout_width="match_parent"
    android:layout_height="230dp"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">
    <com.huami.widget.wheelview.WheelView
        android:id="@+id/start_hour"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#000000"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:layout_width="6dp"
        android:layout_height="wrap_content"
        android:text="@string/time_select_separate"/>
    <com.huami.widget.wheelview.WheelView
        android:id="@+id/start_minute"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#000000"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:layout_width="30dp"
        android:layout_height="wrap_content"
        android:text="@string/time_select_to"/>
    <com.huami.widget.wheelview.WheelView
        android:id="@+id/end_hour"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#000000"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:layout_width="6dp"
        android:layout_height="wrap_content"
        android:text="@string/time_select_separate"/>
    <com.huami.widget.wheelview.WheelView
        android:id="@+id/end_minute"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"/>
</LinearLayout>
