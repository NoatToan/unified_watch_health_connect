<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.huami.femalehealth.uilib.widget.calendar.CalendarTitleView
            android:id="@+id/calendar_title"
            android:layout_width="match_parent"
            android:layout_height="47dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/calendar_line"
            android:background="@color/s4"
            android:layout_width="wrap_content"
            android:layout_height="1px"
            app:layout_constraintEnd_toEndOf="@+id/calendar_title"
            app:layout_constraintStart_toStartOf="@+id/calendar_title"
            app:layout_constraintTop_toBottomOf="@+id/calendar_title"/>
        <com.huami.femalehealth.uilib.widget.calendar.RTLCalendarView
            android:id="@+id/calendar"
            android:background="@color/s38"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:calendar_height="43.5dp"
            app:current_month_lunar_text_color="#cfcfcf"
            app:current_month_text_color="@color/fh_current_month_text_color"
            app:layout_constraintEnd_toEndOf="@+id/calendar_title"
            app:layout_constraintStart_toStartOf="@+id/calendar_title"
            app:layout_constraintTop_toBottomOf="@+id/calendar_line"
            app:month_view="com.huami.femalehealth.uilib.widget.calendar.CalendarMonthView"
            app:month_view_show_mode="mode_fix"
            app:other_month_text_color="@color/fh_other_month_text_color"
            app:select_mode="single_mode"
            app:week_bar_height="34dp"
            app:week_bar_view="com.huami.femalehealth.uilib.widget.calendar.CalendarWeekBar"
            app:week_start_with="sun"/>
        <com.huami.femalehealth.uilib.widget.calendar.CalendarStateView
            android:id="@+id/calendar_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="@+id/calendar_title"
            app:layout_constraintStart_toStartOf="@+id/calendar_title"
            app:layout_constraintTop_toBottomOf="@+id/calendar"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
