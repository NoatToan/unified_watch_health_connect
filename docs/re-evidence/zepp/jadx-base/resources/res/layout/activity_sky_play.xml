<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/sky_play_bk_anim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        app:lottie_autoPlay="true"
        app:lottie_fileName="sky_music_bk.json"
        app:lottie_loop="true"/>
    <FrameLayout
        android:id="@+id/sky_play_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/sky_play_bk"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/sky_placeholder_bk"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"/>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/sky_play_anim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:lottie_loop="true"/>
    </FrameLayout>
    <com.huami.lib.rainbow.titlebar.RainbowTitleBar
        android:id="@+id/title_bar"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationTint="@color/s46"
        app:statusBarMode="dark"
        app:titleTextColor="@color/s46"
        style="@style/Rainbow.TextAppearance.Title2"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14sp"
        android:textColor="@color/s46"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/sky_device_status_tip"
        android:background="@drawable/sky_rect_radius_6_s45"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="2"
        android:paddingStart="12dp"
        android:paddingEnd="36dp"
        android:layout_marginStart="@dimen/size_10dp"
        android:layout_marginEnd="@dimen/size_10dp"
        app:layout_constraintTop_toBottomOf="@+id/title_bar"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/sky_device_status_close"
        android:layout_width="36dp"
        android:layout_height="44dp"
        android:src="@drawable/ic_close_12_s2"
        android:scaleType="center"
        android:layout_marginEnd="@dimen/size_10dp"
        app:layout_constraintBottom_toBottomOf="@+id/sky_device_status_tip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/sky_device_status_tip"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/sky_device_status_group"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="sky_device_status_tip, sky_device_status_close"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/sky_device_triangle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sky_device_status_layout"
        app:srcCompat="@drawable/ic_sky_triangle"
        app:tint="@color/s45"/>
    <include
        android:id="@+id/sky_device_not_connected"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_14dp"
        android:layout_marginEnd="@dimen/size_14dp"
        app:layout_constraintTop_toBottomOf="@+id/sky_device_triangle"
        layout="@layout/sky_layout_device_not_connected"/>
    <FrameLayout
        android:id="@+id/week_plan_progress"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/sky_seven_day_icon"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/sky_device_not_connected_group"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="sky_device_triangle, sky_device_not_connected"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/Rainbow.TextAppearance.Title2"
        android:textColor="@color/s46"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/sky_play_title"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="@string/sky_play_title"
        android:maxLines="2"
        android:layout_marginStart="94dp"
        android:layout_marginEnd="94dp"
        app:layout_constraintBottom_toBottomOf="@+id/sky_device_status_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/sky_device_status_layout"/>
    <com.huami.sky.ui.view.SevenDayIcon
        android:id="@+id/sky_seven_day_icon"
        android:visibility="gone"
        android:layout_width="42dp"
        android:layout_height="32dp"
        app:layout_constraintBottom_toBottomOf="@+id/sky_device_status_layout"
        app:layout_constraintEnd_toStartOf="@+id/sky_device_status_layout"
        app:layout_constraintTop_toTopOf="@+id/sky_device_status_layout"/>
    <FrameLayout
        android:id="@+id/sky_device_status_layout"
        android:layout_width="44dp"
        android:layout_height="32dp"
        android:scaleType="center"
        android:layout_marginEnd="@dimen/size_8dp"
        app:layout_constraintBottom_toBottomOf="@+id/title_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/sky_music_like"
        android:layout_width="@dimen/size_56dp"
        android:layout_height="@dimen/size_56dp"
        android:layout_marginEnd="@dimen/size_40dp"
        app:layout_constraintBottom_toBottomOf="@+id/sky_play"
        app:layout_constraintEnd_toStartOf="@+id/sky_play"
        app:layout_constraintTop_toTopOf="@+id/sky_play"
        app:lottie_fileName="sky_music_like.json"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/sky_play"
        android:layout_width="@dimen/size_80dp"
        android:layout_height="@dimen/size_80dp"
        android:layout_marginBottom="@dimen/size_30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/sky_music_skip"
        android:layout_width="@dimen/size_56dp"
        android:layout_height="@dimen/size_56dp"
        android:layout_marginStart="@dimen/size_40dp"
        app:layout_constraintBottom_toBottomOf="@+id/sky_play"
        app:layout_constraintStart_toEndOf="@+id/sky_play"
        app:layout_constraintTop_toTopOf="@+id/sky_play"
        app:lottie_fileName="sky_music_skip.json"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/sky_realtime"
        android:layout_width="@dimen/size_48dp"
        android:layout_height="@dimen/size_48dp"
        android:layout_marginBottom="@dimen/size_2dp"
        android:src="@drawable/ic_realtime_24"
        android:scaleType="center"
        app:layout_constraintBottom_toTopOf="@+id/sky_play"
        app:layout_constraintEnd_toStartOf="@+id/sky_music_preference"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/sky_music_preference"
        android:layout_width="@dimen/size_48dp"
        android:layout_height="@dimen/size_48dp"
        android:layout_marginBottom="@dimen/size_2dp"
        android:src="@drawable/ic_music_preference_24"
        android:scaleType="center"
        app:layout_constraintBottom_toTopOf="@+id/sky_play"
        app:layout_constraintEnd_toStartOf="@+id/sky_stop"
        app:layout_constraintStart_toEndOf="@+id/sky_realtime"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/sky_stop"
        android:layout_width="@dimen/size_48dp"
        android:layout_height="@dimen/size_48dp"
        android:layout_marginBottom="@dimen/size_2dp"
        android:src="@drawable/ic_stop_24"
        android:scaleType="center"
        app:layout_constraintBottom_toTopOf="@+id/sky_play"
        app:layout_constraintEnd_toStartOf="@+id/sky_setting"
        app:layout_constraintStart_toEndOf="@+id/sky_music_preference"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/sky_setting"
        android:layout_width="@dimen/size_48dp"
        android:layout_height="@dimen/size_48dp"
        android:layout_marginBottom="@dimen/size_2dp"
        android:src="@drawable/ic_settings_24"
        android:scaleType="center"
        app:layout_constraintBottom_toTopOf="@+id/sky_play"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/sky_stop"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/sky_func_button_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="sky_realtime, sky_music_preference, sky_stop, sky_setting"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/s46"
        android:gravity="center"
        android:id="@+id/sky_network_tip"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size_30dp"
        android:text="@string/sky_play_network_disconnect"
        android:layout_marginStart="@dimen/size_20dp"
        android:layout_marginEnd="@dimen/size_20dp"
        app:layout_constraintBottom_toTopOf="@+id/sky_play_retry"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/s46"
        android:gravity="center"
        android:id="@+id/sky_play_retry"
        android:background="@drawable/sky_shape_rect_radius_6"
        android:paddingTop="@dimen/size_10dp"
        android:paddingBottom="@dimen/size_10dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="90dp"
        android:text="@string/sky_play_retry"
        android:paddingStart="@dimen/size_10dp"
        android:paddingEnd="@dimen/size_10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_bar"/>
</androidx.constraintlayout.widget.ConstraintLayout>
