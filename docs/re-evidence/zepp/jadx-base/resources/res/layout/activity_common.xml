<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/title_bar"/>
    <RelativeLayout
        android:id="@+id/title_bar"
        android:background="@color/pale_grey"
        android:layout_width="match_parent"
        android:layout_height="46dp">
        <ImageButton
            android:id="@+id/back_button"
            android:background="?attr/clickableItemBackground"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:src="@drawable/ic_back"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textAppearance="@style/TextAppearance.MiFit.Title.Inverse"
            android:id="@+id/title_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:paddingStart="48dp"
            android:paddingEnd="48dp"/>
        <LinearLayout
            android:gravity="end"
            android:orientation="horizontal"
            android:id="@+id/end_buttons"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_toRightOf="@+id/title_text"
            android:layout_alignParentRight="true"
            android:layout_toEndOf="@+id/title_text"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</RelativeLayout>
