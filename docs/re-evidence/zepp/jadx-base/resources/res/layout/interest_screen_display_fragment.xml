<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/s38"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:background="@color/s10"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:background="@color/s38"
            android:layout_width="match_parent"
            android:layout_height="?android:attr/actionBarSize"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="start|center_vertical"
                android:id="@+id/btn_back"
                android:background="@null"
                android:layout_width="@dimen/size_29dp"
                android:layout_height="@dimen/size_27dp"
                android:src="@drawable/arrow_back_black"
                android:scaleType="center"
                android:tint="@color/s1"
                android:layout_marginStart="@dimen/size_10dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/top_line"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/s1"
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/size_24dp"
                android:text="@string/ds_interest_screen_display"/>
        </androidx.appcompat.widget.Toolbar>
        <FrameLayout
            android:id="@+id/container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/shape_corners_device_setting"
                android:paddingTop="@dimen/size_6dp"
                android:paddingBottom="@dimen/size_6dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_12dp"
                android:layout_marginStart="@dimen/size_15dp"
                android:layout_marginEnd="@dimen/size_15dp">
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/interest_dial"
                    android:background="@color/s38"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-4dp"
                    app:ltv_divider_color="@color/s4"
                    app:ltv_divider_padding="all"
                    app:ltv_title="@string/ds_interest_screen_display_dial_style"/>
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/interest_enable"
                    android:background="@color/s38"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-4dp"
                    app:ltv_divider_color="@color/s4"
                    app:ltv_divider_padding="all"
                    app:ltv_title="@string/ds_interest_screen_display_enabled"/>
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/schedule_start_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ltv_divider_color="@color/s4"
                    app:ltv_divider_padding="all"
                    app:ltv_title="@string/long_sit_alert_start"/>
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/schedule_stop_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ltv_title="@string/long_sit_alert_stop"/>
            </LinearLayout>
            <View
                android:id="@+id/mask_view"
                android:background="#77f7f7f7"
                android:focusable="true"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
    </androidx.appcompat.widget.LinearLayoutCompat>
</FrameLayout>
