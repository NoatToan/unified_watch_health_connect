<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="20sp"
        android:textColor="@color/black"
        android:gravity="center"
        android:id="@+id/title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="90dp"
        android:text="@string/unbind_alipay_title"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#999999"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/sub_title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:text="@string/unbind_alipay_tips"
        android:layout_below="@+id/title_tv"
        android:layout_centerHorizontal="true"/>
    <FrameLayout
        android:layout_width="227dp"
        android:layout_height="120dp"
        android:layout_centerInParent="true">
        <ImageView
            android:layout_gravity="center_vertical"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/alipay_icon"
            android:alpha="0.5"/>
        <ImageView
            android:layout_gravity="end"
            android:id="@+id/device_img"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/img_midong_watch_lite"
            android:alpha="0.5"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:layout_width="132dp"
            android:layout_height="44dp"
            android:src="@drawable/img_unbind"
            android:layout_marginStart="43dp"/>
    </FrameLayout>
    <TextView
        android:textColor="@color/black"
        android:gravity="center"
        android:id="@+id/got_it"
        android:background="@drawable/midong_common_corner_rect"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="24dp"
        android:text="@string/got_it"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="7dp"
        android:layout_marginEnd="7dp"/>
</RelativeLayout>
