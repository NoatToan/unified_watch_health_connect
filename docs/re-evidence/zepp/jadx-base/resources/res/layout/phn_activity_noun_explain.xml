<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/s36"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never">
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/s36"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">
        <TextView
            android:textColor="@color/s1"
            android:id="@+id/tv_non_explain_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="35dp"
            style="@style/Rainbow.TextAppearance.Title1"/>
        <TextView
            android:textColor="@color/s1"
            android:id="@+id/tv_non_explain_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            style="@style/Rainbow.TextAppearance.Body3"/>
        <com.huami.phn.coach.ui.view.PHNTrainingStatusView
            android:id="@+id/noun_training_status_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="20dp"/>
        <include
            android:id="@+id/include_ll_noun_explain_training_status"
            android:visibility="gone"
            layout="@layout/phn_noun_explain_training_status"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
