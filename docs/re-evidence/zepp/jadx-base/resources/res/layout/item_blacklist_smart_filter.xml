<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include layout="@layout/split_line_width_match_parent"/>
    <View
        android:background="@color/bg_main"
        android:layout_width="match_parent"
        android:layout_height="9dp"/>
    <include layout="@layout/split_line_width_match_parent"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/grey_text"
        android:gravity="center_vertical"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/smart_filter_tip"
        android:paddingStart="23dp"/>
    <include layout="@layout/split_line_with_margin"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="64dp">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/black_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/smart_filter_title"
            android:layout_weight="1"
            android:layout_marginStart="23dp"/>
        <FrameLayout
            android:layout_width="80dp"
            android:layout_height="match_parent">
            <Switch
                android:id="@+id/app_switch"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:textOn=""
                android:textOff=""
                style="@style/WatchSwitch"/>
            <View
                android:id="@+id/click_area"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
    </LinearLayout>
    <include layout="@layout/split_line_width_match_parent"/>
    <View
        android:background="@color/bg_main"
        android:layout_width="match_parent"
        android:layout_height="9dp"/>
</LinearLayout>
