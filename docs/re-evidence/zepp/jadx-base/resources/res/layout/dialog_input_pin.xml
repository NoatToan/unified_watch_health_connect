<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s39"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="18sp"
        android:textColor="@color/s1"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:text="@string/enter_epin_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <EditText
        android:textColor="@color/s1"
        android:id="@+id/et_input"
        android:background="@drawable/bg_input_pin_code_et"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:inputType="textPassword"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <ImageView
        android:id="@+id/iv_show_password"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_password_hide"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/et_input"
        app:layout_constraintEnd_toEndOf="@+id/et_input"
        app:layout_constraintTop_toTopOf="@+id/et_input"
        app:tint="@color/s1"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/s2"
        android:gravity="center"
        android:id="@+id/tv_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/enter_epin_desc"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/et_input"/>
    <LinearLayout
        android:orientation="horizontal"
        android:background="@drawable/pin_dialog_button"
        android:layout_width="match_parent"
        android:layout_height="53dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_desc">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/s2"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/dialog_btn_cancel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/btn_cancel"
            android:layout_weight="1"/>
        <View
            android:layout_gravity="center"
            android:background="#29000000"
            android:layout_width="1px"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/s1"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/dialog_btn_confirm"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/dialog_confirm"
            android:layout_weight="1"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
