<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.watch.companion.ui.view.ActionbarLayout
        android:id="@+id/actionbar_search"
        android:background="@color/xima_actionbar_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/xima_album_intruduce_bg_color"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ProgressBar
                android:id="@+id/album_watch_space_progress"
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:progressDrawable="@drawable/progressbar"
                style="?android:attr/progressBarStyleHorizontal"/>
            <TextView
                android:textSize="@dimen/xima_watchspace_size"
                android:textColor="@color/xima_light_graytext_color"
                android:gravity="center_horizontal"
                android:id="@+id/album_watch_space"
                android:background="@color/transparent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <View
                android:layout_gravity="bottom"
                android:background="@color/xima_listview_divider_color"
                android:layout_width="match_parent"
                android:layout_height="0.33dp"/>
        </FrameLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="27.33dp"
            android:paddingStart="23dp"
            android:layout_marginEnd="23dp">
            <ImageView
                android:id="@+id/album_largeicon"
                android:layout_width="@dimen/xima_album_ig_size"
                android:layout_height="@dimen/xima_album_ig_size"
                android:layout_centerVertical="true"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="13dp"
                android:layout_toEndOf="@+id/album_largeicon">
                <TextView
                    android:textSize="@dimen/xima_detail_title_size"
                    android:textColor="@color/xima_category_title_color"
                    android:id="@+id/album_introduce_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="@dimen/xima_detail_intruduce_size"
                    android:textColor="@color/xima_light_graytext_color"
                    android:id="@+id/album_introduce_author"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="@dimen/xima_detail_intruduce_size"
                    android:textColor="@color/xima_light_graytext_color"
                    android:id="@+id/album_introduce_times"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="@dimen/xima_detail_intruduce_size"
                    android:textColor="@color/xima_light_graytext_color"
                    android:id="@+id/album_introduce_update"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="@dimen/xima_detail_intruduce_size"
                    android:textColor="@color/xima_light_graytext_color"
                    android:id="@+id/album_introduce_category"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </RelativeLayout>
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:background="@color/xima_album_intruduce_bg_color"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="19dp"
            android:layout_marginBottom="24dp">
            <Button
                android:textSize="@dimen/xima_album_button_text_size"
                android:textColor="@color/xima_album_button_text_color"
                android:id="@+id/detail_introduce"
                android:background="@drawable/selector_button_background"
                android:paddingTop="8.6dp"
                android:paddingBottom="8.6dp"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/xima_album_button_height"
                android:text="@string/xima_detail_introduce"
                android:paddingStart="47dp"
                android:paddingEnd="47dp"
                android:stateListAnimator="@null"/>
            <Button
                android:textSize="@dimen/xima_album_button_text_size"
                android:textColor="@color/xima_album_button_text_color"
                android:id="@+id/pack_download"
                android:background="@drawable/selector_button_background"
                android:paddingTop="8.6dp"
                android:paddingBottom="8.6dp"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/xima_album_button_height"
                android:text="@string/xima_package_download"
                android:paddingStart="47dp"
                android:paddingEnd="47dp"
                android:layout_marginStart="20dp"
                android:stateListAnimator="@null"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/divider_par"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/searching_result_album">
            <View
                android:background="@color/xima_listview_divider_color"
                android:layout_width="match_parent"
                android:layout_height="0.33dp"/>
            <View
                android:background="@color/xima_category_edit_bg"
                android:layout_width="match_parent"
                android:layout_height="8dp"/>
            <View
                android:background="@color/xima_listview_divider_color"
                android:layout_width="match_parent"
                android:layout_height="0.33dp"/>
        </LinearLayout>
        <RelativeLayout
            android:background="@color/xima_album_intruduce_bg_color"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">
            <TextView
                android:textColor="@color/grey_text"
                android:id="@+id/album_totalcount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"/>
            <TextView
                android:textColor="@color/xima_category_title_color"
                android:id="@+id/album_order"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/xima_album_order_desc"
                android:layout_alignParentEnd="true"/>
            <View
                android:id="@+id/album_divider"
                android:background="@color/xima_listview_divider_color"
                android:layout_width="0.33dp"
                android:layout_height="10dp"
                android:layout_centerVertical="true"
                android:layout_marginEnd="14dp"
                android:layout_toStartOf="@+id/album_order"/>
            <TextView
                android:textColor="@color/xima_category_title_color"
                android:id="@+id/album_package"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/xima_album_package"
                android:layout_marginEnd="20dp"
                android:layout_toStartOf="@+id/album_divider"/>
        </RelativeLayout>
        <View
            android:background="@color/xima_listview_divider_color"
            android:layout_width="match_parent"
            android:layout_height="0.33dp"/>
        <FrameLayout
            android:background="@color/xima_listview_divider_color"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ListView
                android:id="@+id/album_list"
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@color/xima_listview_divider_color"
                android:dividerHeight="0.33dp"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"/>
            <ScrollView
                android:id="@+id/album_package_group_par"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.huami.watch.companion.ximalaya.RadiogroupCL
                    android:gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:id="@+id/album_package_group"
                    android:background="@color/xima_album_intruduce_bg_color"
                    android:paddingBottom="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="4dp"
                    android:paddingEnd="20dp"/>
            </ScrollView>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
