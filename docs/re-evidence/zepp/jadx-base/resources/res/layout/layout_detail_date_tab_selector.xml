<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s38"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">
    <RadioGroup
        android:orientation="horizontal"
        android:id="@+id/tab_group"
        android:background="@drawable/shape_health_data_filter_tab_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_15dp"
        android:layout_marginStart="@dimen/size_15dp"
        android:layout_marginEnd="@dimen/size_15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <RadioButton
            android:id="@+id/tab_day"
            android:background="@drawable/selector_health_data_tab_start"
            android:checked="true"
            android:text="@string/hm_common_chart_day"
            android:layout_weight="1"
            style="@style/HealthBaseDataTab"/>
        <RadioButton
            android:id="@+id/tab_week"
            android:background="@drawable/selector_health_data_tab_normal"
            android:text="@string/hm_common_chart_week"
            android:layout_weight="1"
            style="@style/HealthBaseDataTab"/>
        <RadioButton
            android:id="@+id/tab_month"
            android:background="@drawable/selector_health_data_tab_normal"
            android:text="@string/hm_common_chart_month"
            android:layout_weight="1"
            style="@style/HealthBaseDataTab"/>
        <RadioButton
            android:id="@+id/tab_year"
            android:background="@drawable/selector_health_data_tab_end"
            android:text="@string/hm_common_chart_year"
            android:layout_weight="1"
            style="@style/HealthBaseDataTab"/>
    </RadioGroup>
</androidx.constraintlayout.widget.ConstraintLayout>
