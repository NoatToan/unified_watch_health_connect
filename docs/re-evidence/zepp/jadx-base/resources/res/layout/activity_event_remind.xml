<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/tips_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:id="@+id/container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <View
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/size_12sp"
        android:textColor="@color/s2"
        android:gravity="center"
        android:id="@+id/empty_tv"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="180dp"
        android:text="@string/event_remind_no_data"
        android:drawableTop="@drawable/img_event_remind_nodata"
        android:drawablePadding="3dp"
        android:layout_below="@+id/tips_container"
        android:layout_centerHorizontal="true"/>
    <com.scwang.smartrefresh.layout.SmartRefreshLayout
        android:orientation="vertical"
        android:id="@+id/load_more_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/action_container"
        android:layout_below="@+id/tips_container">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/event_list"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"/>
    </com.scwang.smartrefresh.layout.SmartRefreshLayout>
    <FrameLayout
        android:id="@+id/action_container"
        android:background="@color/s38"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_66dp"
        android:layout_alignParentBottom="true">
        <View
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider"/>
        <LinearLayout
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="9sp"
                android:textColor="@color/s2"
                android:gravity="center"
                android:layout_gravity="start"
                android:id="@+id/vibrate_tv"
                android:focusable="true"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/custom_vibrate"
                android:drawableTop="@drawable/icon_vibrate_selector"
                android:drawablePadding="3dp"
                android:layout_marginEnd="@dimen/size_50dp"/>
            <TextView
                android:textSize="9sp"
                android:textColor="@color/s2"
                android:gravity="center"
                android:id="@+id/edit_event_tv"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/edit"
                android:drawableTop="@drawable/icon_edit_selector"
                android:drawablePadding="3dp"/>
            <TextView
                android:textSize="9sp"
                android:textColor="@color/s2"
                android:gravity="center"
                android:id="@+id/done_event_tv"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/smart_alarm_done"
                android:drawableTop="@drawable/layer_smart_alarm_done"
                android:drawablePadding="3dp"/>
            <TextView
                android:textSize="9sp"
                android:textColor="@color/s2"
                android:gravity="center"
                android:id="@+id/add_event_tv"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/smart_alarm_add"
                android:drawableTop="@drawable/icon_add_selector"
                android:drawablePadding="3dp"
                android:layout_marginStart="@dimen/size_50dp"/>
        </LinearLayout>
    </FrameLayout>
    <View
        android:id="@+id/mask_view"
        android:background="@color/cl_4d000000"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/tips_container"/>
</RelativeLayout>
