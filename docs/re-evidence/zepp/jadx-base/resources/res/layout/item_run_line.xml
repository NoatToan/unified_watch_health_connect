<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/td_size_15dp">
    <ImageView
        android:id="@+id/run_line_icon"
        android:layout_width="@dimen/td_size_100dp"
        android:layout_height="@dimen/td_size_100dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/s1"
        android:id="@+id/run_line_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="-0.6sp"
        android:layout_marginStart="@dimen/td_size_15dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintStart_toEndOf="@+id/run_line_icon"
        app:layout_constraintTop_toTopOf="@+id/run_line_icon"/>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/s1"
        android:id="@+id/run_line_dis"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/td_size_5dp"
        app:layout_constraintStart_toStartOf="@+id/run_line_title"
        app:layout_constraintTop_toBottomOf="@+id/run_line_title"/>
    <TextView
        android:textSize="11sp"
        android:textColor="@color/s1"
        android:id="@+id/run_line_area"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="120dp"
        android:singleLine="true"
        android:drawablePadding="@dimen/td_size_5dp"
        android:drawableStart="@drawable/td_location_map"
        android:layout_marginStart="@dimen/td_size_15dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/run_line_icon"
        app:layout_constraintStart_toEndOf="@+id/run_line_icon"/>
    <TextView
        android:textSize="11sp"
        android:textColor="@color/s1"
        android:id="@+id/run_line_man"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="120dp"
        android:singleLine="true"
        app:layout_constraintBottom_toBottomOf="@+id/run_line_icon"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
