<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/s10"
    android:scrollbars="none"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:background="@color/s36"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/size_18dp"
            android:paddingEnd="@dimen/size_18dp">
            <RelativeLayout
                android:id="@+id/rl_invoice_head"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/size_58dp">
                <TextView
                    android:id="@+id/tv_invoice_head"
                    android:layout_width="@dimen/size_130dp"
                    android:layout_height="@dimen/size_22dp"
                    android:text="@string/wl_invoice_head"
                    android:layout_centerVertical="true"
                    style="@style/InVoiceHeadStyle"/>
                <ImageView
                    android:id="@+id/iv_arrow_right"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/wl_card_arrow_right"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"/>
                <TextView
                    android:gravity="end"
                    android:id="@+id/tv_invoice_type"
                    android:background="@null"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/wl_invoice_type_name"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/size_6dp"
                    android:layout_toStartOf="@+id/iv_arrow_right"
                    android:layout_toEndOf="@+id/tv_invoice_head"
                    style="@style/InVoiceContentStyle"/>
                <View
                    android:background="@color/s4"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_alignParentBottom="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/size_58dp">
                <TextView
                    android:id="@+id/tv_content"
                    android:layout_width="@dimen/size_130dp"
                    android:layout_height="@dimen/size_22dp"
                    android:text="@string/wl_invoice_content"
                    android:layout_centerVertical="true"
                    style="@style/InVoiceHeadStyle"/>
                <TextView
                    android:gravity="end"
                    android:id="@+id/tv_content_massage"
                    android:background="@null"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/wl_invoice_recharge_fee"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@+id/tv_content"
                    style="@style/InVoiceContentStyle"/>
                <View
                    android:background="@color/s4"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_alignParentBottom="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rl_user_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/size_58dp">
                <TextView
                    android:id="@+id/tv_user"
                    android:layout_width="@dimen/size_130dp"
                    android:layout_height="@dimen/size_22dp"
                    android:text="@string/wl_invoice_user_name"
                    android:layout_centerVertical="true"
                    style="@style/InVoiceHeadStyle"/>
                <EditText
                    android:gravity="end"
                    android:id="@+id/et_user_name"
                    android:background="@null"
                    android:paddingTop="@dimen/size_10dp"
                    android:paddingBottom="@dimen/size_10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/wl_invoice_input_user_name"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@+id/tv_user"
                    style="@style/InVoiceContentStyle"/>
                <View
                    android:background="@color/s4"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_alignParentBottom="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rl_company_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/size_58dp">
                <TextView
                    android:id="@+id/tv_company"
                    android:layout_width="@dimen/size_130dp"
                    android:layout_height="@dimen/size_22dp"
                    android:text="@string/wl_invoice_company_name"
                    android:layout_centerVertical="true"
                    style="@style/InVoiceHeadStyle"/>
                <EditText
                    android:gravity="end"
                    android:id="@+id/et_company_name"
                    android:background="@null"
                    android:paddingTop="@dimen/size_10dp"
                    android:paddingBottom="@dimen/size_10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/wl_invoice_input_company_name"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@+id/tv_company"
                    style="@style/InVoiceContentStyle"/>
                <View
                    android:background="@color/s4"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_alignParentBottom="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rl_tax_payer_number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/size_58dp">
                <TextView
                    android:id="@+id/tv_taxpayer_number"
                    android:layout_width="@dimen/size_130dp"
                    android:layout_height="@dimen/size_22dp"
                    android:text="@string/wl_invoice_taxpayer_number"
                    android:layout_centerVertical="true"
                    style="@style/InVoiceHeadStyle"/>
                <EditText
                    android:gravity="end"
                    android:id="@+id/et_taxpayer_number"
                    android:background="@null"
                    android:paddingTop="@dimen/size_10dp"
                    android:paddingBottom="@dimen/size_10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/wl_invoice_input_taxpayer_number"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@+id/tv_taxpayer_number"
                    style="@style/InVoiceContentStyle"/>
                <View
                    android:background="@color/s4"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_alignParentBottom="true"/>
            </RelativeLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/size_58dp">
                <TextView
                    android:id="@+id/tv_receive_email"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/size_22dp"
                    android:text="@string/wl_invoice_email"
                    android:layout_weight="1"
                    android:layout_centerVertical="true"
                    style="@style/InVoiceHeadStyle"/>
                <EditText
                    android:gravity="top|right"
                    android:id="@+id/et_receive_email"
                    android:background="@null"
                    android:paddingTop="@dimen/size_10dp"
                    android:paddingBottom="@dimen/size_10dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:hint="@string/wl_invoice_input_receive_email"
                    android:maxLength="320"
                    android:layout_weight="2"
                    android:layout_centerVertical="true"
                    android:inputType="textMultiLine"
                    android:layout_toEndOf="@+id/tv_receive_email"
                    style="@style/InVoiceContentStyle"/>
            </LinearLayout>
            <View
                android:background="@color/s4"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_alignParentBottom="true"/>
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_8dp"/>
        <TextView
            android:textSize="@dimen/size_14sp"
            android:textColor="@color/s15"
            android:gravity="center_horizontal"
            android:id="@+id/tv_inVoice_tip"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_20dp"
            android:layout_marginTop="@dimen/size_42dp"
            android:text="@string/wl_invoice_user_known"/>
        <Button
            android:id="@+id/tv_submit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_24dp"
            android:layout_marginBottom="@dimen/size_24dp"
            android:text="@string/wl_invoice_submit"
            android:layout_marginStart="@dimen/size_18dp"
            android:layout_marginEnd="@dimen/size_18dp"
            style="@style/Rainbow.Widget.Button.44.Circular"/>
    </LinearLayout>
</ScrollView>
