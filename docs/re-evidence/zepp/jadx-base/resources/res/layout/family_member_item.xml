<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s36"
    android:layout_width="match_parent"
    android:layout_height="63dp">
    <com.huami.lib.view.image.HMCircleImageView
        android:id="@+id/member_icon"
        android:layout_width="33.3dp"
        android:layout_height="33.3dp"
        android:layout_marginTop="14.7dp"
        android:layout_marginBottom="14.3dp"
        android:src="@drawable/setting_avatar_default"
        android:layout_centerVertical="true"
        android:layout_marginStart="23.3dp"
        android:layout_alignParentStart="true"
        app:civ_border_color="@color/s3"
        app:civ_border_width="1.3dp"
        app:civ_fill_color="@color/s3"
        app:hm_civ_show_mask="true"/>
    <TextView
        android:textSize="14.7sp"
        android:textColor="@color/s1"
        android:id="@+id/member_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="23.3dp"
        android:layout_marginBottom="22.3dp"
        android:singleLine="true"
        android:textAlignment="viewStart"
        android:layout_marginStart="16.7dp"
        android:layout_toStartOf="@+id/member_content"
        android:layout_toEndOf="@+id/member_icon"/>
    <TextView
        android:textColor="@color/s3"
        android:id="@+id/member_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginEnd="13dp"
        android:layout_toStartOf="@+id/member_right_arrow"/>
    <ImageView
        android:id="@+id/member_right_arrow"
        android:layout_width="17.3dp"
        android:layout_height="17.3dp"
        android:layout_marginTop="22.7dp"
        android:layout_marginBottom="22.3dp"
        android:src="@drawable/ic_arrow_forward_20_2x"
        android:layout_marginEnd="23.3dp"
        android:layout_alignParentEnd="true"
        app:tint="@color/s1"/>
</RelativeLayout>
