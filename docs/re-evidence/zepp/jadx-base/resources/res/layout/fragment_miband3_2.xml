<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/pale_grey_two"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="20sp"
        android:textColor="@color/black80"
        android:gravity="center"
        android:id="@+id/title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/play_miband3_title_2"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/black60"
        android:gravity="center"
        android:id="@+id/sub_title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:text="@string/play_miband3_subtitle_2"
        android:layout_below="@+id/title_tv"
        android:layout_centerHorizontal="true"/>
    <View
        android:id="@+id/center_view"
        android:background="@color/transparent"
        android:layout_width="46dp"
        android:layout_height="1px"
        android:layout_centerInParent="true"/>
    <FrameLayout
        android:layout_width="92dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="121dp"
        android:layout_below="@+id/sub_title_tv"
        android:layout_alignStart="@+id/center_view">
        <FrameLayout
            android:id="@+id/frame_img_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/img_band_3_step_count"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="10sp"
                android:textColor="@color/play_miband3_text_color"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:layout_width="47dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="@string/play_miband3_step"
                android:maxLines="1"
                android:fontFamily="km"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="16sp"
                android:textColor="@color/play_miband3_text_color"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:layout_width="47dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="45dp"
                android:text="3614"
                android:fontFamily="km"/>
        </FrameLayout>
        <FrameLayout
            android:layout_gravity="end"
            android:id="@+id/frame_img_2"
            android:layout_width="47dp"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/img_band_3_distance"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="10sp"
                android:textColor="@color/play_miband3_text_color"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:layout_width="47dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="@string/play_miband3_distance"
                android:maxLines="1"
                android:fontFamily="km"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="15sp"
                android:textColor="@color/play_miband3_text_color"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="45dp"
                android:text="2.98"
                android:fontFamily="km"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="7sp"
                android:textColor="@color/play_miband3_text_color"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="52dp"
                android:text="@string/play_miband3_distance_unit"
                android:fontFamily="km"
                android:layout_marginStart="36dp"/>
        </FrameLayout>
        <FrameLayout
            android:layout_gravity="end"
            android:id="@+id/frame_img_3"
            android:layout_width="47dp"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/img_band_3_cal"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="10sp"
                android:textColor="@color/play_miband3_text_color"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:layout_width="47dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="@string/play_miband3_calorie"
                android:maxLines="1"
                android:fontFamily="km"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="15sp"
                android:textColor="@color/play_miband3_text_color"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="45dp"
                android:text="105"
                android:fontFamily="km"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="7sp"
                android:textColor="@color/play_miband3_text_color"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="52dp"
                android:text="@string/play_miband3_calorie_unit"
                android:fontFamily="km"
                android:layout_marginStart="35dp"/>
        </FrameLayout>
    </FrameLayout>
    <View
        android:background="@color/pale_grey_two"
        android:layout_width="157dp"
        android:layout_height="74dp"
        android:layout_marginTop="121dp"
        android:layout_below="@+id/sub_title_tv"
        android:layout_toEndOf="@+id/center_view"/>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp"
        android:src="@drawable/img_band_3"
        android:layout_below="@+id/sub_title_tv"
        android:layout_centerHorizontal="true"/>
    <FrameLayout
        android:id="@+id/indicator_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="192dp"
        android:layout_below="@+id/sub_title_tv"
        android:layout_centerHorizontal="true">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/img_band_3_bar"/>
        <ImageView
            android:id="@+id/indicator_img"
            android:layout_width="11dp"
            android:layout_height="1dp"
            android:src="@drawable/drawable_band_3_bar"/>
    </FrameLayout>
    <View
        android:id="@+id/center_view_small"
        android:background="@color/transparent"
        android:layout_width="1px"
        android:layout_height="1px"
        android:layout_centerInParent="true"/>
    <com.xiaomi.hm.health.ui.playmiband2.MovableImageView
        android:id="@+id/hand_img"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="140dp"
        android:src="@drawable/img_hand"
        android:layout_below="@+id/sub_title_tv"
        android:layout_marginStart="20dp"
        android:layout_toEndOf="@+id/center_view_small"/>
</RelativeLayout>
