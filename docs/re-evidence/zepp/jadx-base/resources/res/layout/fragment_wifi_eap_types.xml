<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="14sp"
        android:textColor="@drawable/selector_picker_text_color"
        android:gravity="start|center_vertical"
        android:id="@+id/type_peap"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="@string/peap"
        android:layout_marginStart="36dp"/>
    <include layout="@layout/split_line_width_match_parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@drawable/selector_picker_text_color"
        android:gravity="start|center_vertical"
        android:id="@+id/type_tls"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="@string/tls"
        android:layout_marginStart="36dp"/>
    <include layout="@layout/split_line_width_match_parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@drawable/selector_picker_text_color"
        android:gravity="start|center_vertical"
        android:id="@+id/type_ttls"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="@string/ttls"
        android:layout_marginStart="36dp"/>
    <include layout="@layout/split_line_width_match_parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@drawable/selector_picker_text_color"
        android:gravity="start|center_vertical"
        android:id="@+id/type_pwd"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="@string/pwd"
        android:layout_marginStart="36dp"/>
    <include layout="@layout/split_line_width_match_parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@drawable/selector_picker_text_color"
        android:gravity="start|center_vertical"
        android:id="@+id/type_sim"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="@string/sim"
        android:layout_marginStart="36dp"/>
    <include layout="@layout/split_line_width_match_parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@drawable/selector_picker_text_color"
        android:gravity="start|center_vertical"
        android:id="@+id/type_aka"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="@string/aka"
        android:layout_marginStart="36dp"/>
</LinearLayout>
