<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/s36"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/size_20sp"
        android:textColor="@color/s1"
        android:gravity="center_horizontal"
        android:id="@+id/tv_feature"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/access_door_stay_close"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="@dimen/size_18dp"
        android:layout_marginEnd="@dimen/size_18dp"/>
    <TextView
        android:textSize="@dimen/size_14sp"
        android:textColor="@color/s2"
        android:gravity="center"
        android:id="@+id/tv_feature_tip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:text="@string/access_door_stay_close_touch"
        android:layout_below="@+id/tv_feature"
        android:layout_centerHorizontal="true"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/size_100dp"
        android:layout_below="@+id/tv_feature_tip"
        android:layout_centerHorizontal="true">
        <ImageView
            android:id="@+id/iv_band"
            android:layout_width="186dp"
            android:layout_height="186dp"
            android:src="@drawable/ic_nfc_placeholder"
            android:scaleType="center"
            android:layout_centerInParent="true"
            android:paddingStart="@dimen/size_32dp"/>
        <ImageView
            android:id="@+id/iv_translation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_start_detection"
            android:scaleType="fitCenter"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/size_40dp"
            android:layout_marginEnd="@dimen/size_45dp"/>
    </RelativeLayout>
    <TextView
        android:textSize="@dimen/size_14sp"
        android:textColor="@color/s41"
        android:id="@+id/tv_support"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size_76dp"
        android:text="@string/access_door_support_tip"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
    <Button
        android:id="@+id/tv_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size_18dp"
        android:text="@string/access_door_start"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="@dimen/size_18dp"
        android:layout_marginEnd="@dimen/size_18dp"
        style="@style/Rainbow.Widget.Button.38.Circular"/>
</RelativeLayout>
