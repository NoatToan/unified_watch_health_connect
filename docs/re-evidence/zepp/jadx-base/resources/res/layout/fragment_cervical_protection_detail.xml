<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/s10"
    android:scrollbars="none"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="never">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cervical_protection_angle_group"
            android:background="@color/s38"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/cervical_protection_schematic_diagram"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:scaleType="center"
                android:layout_marginEnd="@dimen/td_size_10dp"
                app:layout_constraintDimensionRatio="h,10:11"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_percent="0.53"/>
            <TextView
                android:textSize="@dimen/size_12sp"
                android:textColor="@color/s2"
                android:gravity="center"
                android:id="@+id/cervical_protection_angle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_4dp"
                android:layout_marginBottom="@dimen/size_50dp"
                android:text="@string/headset_cervical_protection_head_down_angle"
                android:layout_marginStart="@dimen/size_35dp"
                android:layout_marginEnd="@dimen/size_8dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="@+id/cervical_protection_schematic_diagram"
                app:layout_constraintEnd_toStartOf="@+id/cervical_protection_schematic_diagram"
                app:layout_constraintStart_toStartOf="parent"/>
            <TextView
                android:textSize="48sp"
                android:textStyle="bold"
                android:textColor="@color/s1"
                android:id="@+id/cervical_protection_angle_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/size_4dp"
                app:layout_constraintBottom_toTopOf="@+id/cervical_protection_angle"
                app:layout_constraintEnd_toEndOf="@+id/cervical_protection_angle"
                app:layout_constraintStart_toStartOf="@+id/cervical_protection_angle"
                style="@style/Rainbow.TextAppearance.Number1"/>
            <TextView
                android:textSize="48sp"
                android:textStyle="bold"
                android:textColor="@color/s1"
                android:id="@+id/cervical_protection_angle_symbol"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/size_4dp"
                app:layout_constraintStart_toEndOf="@+id/cervical_protection_angle_value"
                app:layout_constraintTop_toTopOf="@+id/cervical_protection_angle_value"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/s1"
                android:id="@+id/cervical_protection_press_des"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_6dp"
                android:layout_marginStart="@dimen/size_26dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cervical_protection_schematic_diagram"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/s2"
                android:id="@+id/cervical_protection_press_detail_des"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_4dp"
                android:layout_marginEnd="@dimen/dp_10"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="@+id/cervical_protection_press_des"
                app:layout_constraintTop_toBottomOf="@+id/cervical_protection_press_des"/>
            <com.xiaomi.hm.health.device.headset.ui.CervicalRulerView
                android:id="@+id/cervical_protection_ruler_view"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_24dp"
                android:layout_marginStart="@dimen/td_size_21dp"
                android:layout_marginEnd="@dimen/size_18dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cervical_protection_press_detail_des"/>
            <TextView
                android:textSize="@dimen/size_13sp"
                android:textColor="@color/s2"
                android:id="@+id/cervical_protection_angle_des"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_24dp"
                android:layout_marginBottom="@dimen/size_24dp"
                android:text="@string/headset_cervical_protection_head_down_angle_detail_des"
                android:layout_marginStart="@dimen/size_27dp"
                android:layout_marginEnd="@dimen/size_26dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cervical_protection_ruler_view"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.huami.lib.rainbow.ListTile
            android:id="@+id/cervical_protection_relax_switch"
            android:background="@drawable/shape_rect_white_corner_6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_12dp"
            android:minHeight="@dimen/size_64dp"
            android:layout_marginStart="@dimen/size_10dp"
            android:layout_marginEnd="@dimen/size_10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cervical_protection_angle_group"
            app:ltv_subtitle="@string/settings_item_cervical_protection_summary"
            app:ltv_title="@string/settings_item_relaxation_reminder"/>
        <com.huami.lib.rainbow.ListTile
            android:id="@+id/cervical_protection_seated_calibration"
            android:background="@drawable/shape_rect_white_corner_6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_12dp"
            android:minHeight="@dimen/size_64dp"
            android:layout_marginStart="@dimen/size_10dp"
            android:layout_marginEnd="@dimen/size_10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cervical_protection_relax_switch"
            app:ltv_title="@string/headset_cervical_protection_seated_calibration"/>
        <com.huami.lib.rainbow.ListTile
            android:id="@+id/cervical_protection_switch"
            android:background="@drawable/shape_rect_white_corner_6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_12dp"
            android:layout_marginBottom="@dimen/size_10dp"
            android:minHeight="@dimen/size_64dp"
            android:layout_marginStart="@dimen/size_10dp"
            android:layout_marginEnd="@dimen/size_10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cervical_protection_seated_calibration"
            app:ltv_checked="false"
            app:ltv_title="@string/settings_item_cervical_protection"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
