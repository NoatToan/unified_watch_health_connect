<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingBottom="@dimen/bo_ui_size_50dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/head"
            android:background="@color/s36"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/value_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/bo_ui_size_30dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <com.huami.widget.typeface.TypefaceTextView
                    android:textSize="40sp"
                    android:textColor="@color/s1"
                    android:id="@+id/range_sign"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.huami.widget.typeface.TypefaceTextView
                    android:textSize="@dimen/bo_ui_size_40sp"
                    android:textColor="@color/s1"
                    android:id="@+id/range_start"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textDirection="locale"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/range_sign"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.huami.widget.typeface.TypefaceTextView
                    android:textSize="@dimen/bo_ui_size_40sp"
                    android:textColor="@color/s1"
                    android:id="@+id/range_end"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textDirection="locale"
                    android:layout_marginStart="@dimen/bo_ui_size_5dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/range_sign"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <RelativeLayout
                android:id="@+id/date_time_layout"
                android:paddingBottom="@dimen/bo_ui_size_5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/value_container">
                <TextView
                    android:textSize="@dimen/bo_ui_size_14sp"
                    android:textColor="@color/s2"
                    android:id="@+id/date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"/>
                <RelativeLayout
                    android:id="@+id/time_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/bo_ui_size_3dp"
                    android:layout_toEndOf="@+id/date">
                    <TextView
                        android:textSize="@dimen/bo_ui_size_14sp"
                        android:textColor="@color/s2"
                        android:id="@+id/time_start"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"/>
                    <TextView
                        android:textSize="@dimen/bo_ui_size_14sp"
                        android:textColor="@color/s2"
                        android:id="@+id/split"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bo_ui_split"
                        android:layout_toEndOf="@+id/time_start"/>
                    <TextView
                        android:textSize="@dimen/bo_ui_size_14sp"
                        android:textColor="@color/s2"
                        android:id="@+id/time_end"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@+id/split"/>
                </RelativeLayout>
            </RelativeLayout>
            <com.huami.bloodoxygen.ui.view.chart.StatisticsBarChart
                android:id="@+id/chart"
                android:background="@color/s38"
                android:layout_width="match_parent"
                android:layout_height="@dimen/bo_ui_size_220dp"
                android:layout_marginTop="@dimen/bo_ui_size_2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/date_time_layout"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.huami.bloodoxygen.ui.view.BloodOxygenStatisticsView
            android:id="@+id/statistics_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/bo_ui_size_10dp"
            android:layout_marginRight="@dimen/bo_ui_size_10dp"
            app:layout_constraintTop_toBottomOf="@+id/head"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/middle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/statistics_view">
            <com.huami.bloodoxygen.ui.view.BloodOxygenCardView
                android:id="@+id/add_data"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/bo_ui_size_60dp"
                android:layout_marginLeft="@dimen/bo_ui_size_10dp"
                android:layout_marginTop="@dimen/bo_ui_size_12dp"
                android:layout_marginRight="@dimen/bo_ui_size_10dp"
                android:paddingStart="@dimen/bo_ui_size_15dp"
                android:paddingEnd="@dimen/bo_ui_size_15dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <com.huami.lib.rainbow.ListTile
                    android:layout_gravity="center_vertical"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/bo_ui_size_60dp"
                    app:ltv_title="@string/bo_ui_add_data"
                    app:ltv_trailing="@drawable/ic_arrow_forward_20_2x"/>
            </com.huami.bloodoxygen.ui.view.BloodOxygenCardView>
            <com.huami.bloodoxygen.ui.view.BloodOxygenCardView
                android:id="@+id/history_data"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/bo_ui_size_60dp"
                android:layout_marginLeft="@dimen/bo_ui_size_10dp"
                android:layout_marginTop="@dimen/bo_ui_size_12dp"
                android:layout_marginRight="@dimen/bo_ui_size_10dp"
                android:paddingStart="@dimen/bo_ui_size_15dp"
                android:paddingEnd="@dimen/bo_ui_size_15dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/add_data">
                <com.huami.lib.rainbow.ListTile
                    android:layout_gravity="center_vertical"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/bo_ui_size_60dp"
                    app:ltv_title="@string/bo_ui_history_title"
                    app:ltv_trailing="@drawable/ic_arrow_forward_20_2x"/>
            </com.huami.bloodoxygen.ui.view.BloodOxygenCardView>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.huami.bloodoxygen.ui.view.BloodOxygenIntroView
            android:id="@+id/intro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/bo_ui_size_10dp"
            android:layout_marginTop="@dimen/bo_ui_size_12dp"
            android:layout_marginRight="@dimen/bo_ui_size_10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/middle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
