<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/sls_color_bg_color_item_live"
    android:layout_width="match_parent"
    android:layout_height="71dp">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/sls_item_lift"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="150dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.huami.sleepassistant.lib.widget.circleimageview.HMCircleImageView
        android:id="@+id/sls_img_live_music"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:contentDescription="@string/app_name"
        android:layout_marginStart="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="14sp"
        android:textColor="@color/white100"
        android:ellipsize="end"
        android:id="@+id/sls_item_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="100dp"
        android:singleLine="true"
        android:fontFamily="lt"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="100dp"
        app:layout_constraintLeft_toRightOf="@+id/sls_img_live_music"
        app:layout_constraintTop_toTopOf="@+id/sls_img_live_music"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="14sp"
        android:textColor="@color/white100"
        android:ellipsize="end"
        android:id="@+id/sls_item_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:fontFamily="lt"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="100dp"
        app:layout_constraintLeft_toRightOf="@+id/sls_item_title"
        app:layout_constraintTop_toTopOf="@+id/sls_img_live_music"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="12sp"
        android:textColor="@color/sls_back_8d"
        android:ellipsize="end"
        android:id="@+id/sls_item_group_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:fontFamily="lt"
        android:layout_marginStart="14dp"
        app:layout_constraintBottom_toBottomOf="@+id/sls_img_live_music"
        app:layout_constraintLeft_toRightOf="@+id/sls_img_live_music"/>
    <RelativeLayout
        android:id="@+id/sls_rl_item_play"
        android:visibility="gone"
        android:layout_width="33dp"
        android:layout_height="33dp"
        android:layout_marginEnd="7dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/sls_item_more"
        app:layout_constraintTop_toTopOf="parent">
        <com.huami.sleepassistant.lib.widget.CustomRoundProgressBar
            android:id="@+id/sls_item_live_custom_progress_bar"
            android:layout_width="23dp"
            android:layout_height="23dp"
            android:layout_centerInParent="true"
            android:layout_centerHorizontal="true"
            app:SlsRoundProgressBarProgressBgColor="#4cffffff"
            app:SlsRoundProgressBarProgressBgWidth="2dp"
            app:SlsRoundProgressBarProgressColor="#a23f16"
            app:SlsRoundProgressBarProgressWidth="2dp"
            app:SlsRoundProgressBarTotal="100"/>
        <ImageView
            android:id="@+id/sls_item_play_icon"
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:src="@drawable/sls_item_live_play_icon"
            android:layout_centerInParent="true"
            android:contentDescription="@string/app_name"/>
    </RelativeLayout>
    <ImageView
        android:id="@+id/sls_item_more"
        android:padding="7dp"
        android:visibility="gone"
        android:layout_width="37dp"
        android:layout_height="37dp"
        android:src="@drawable/sls_item_edit_icon"
        android:contentDescription="@string/app_name"
        android:layout_marginEnd="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/sls_sort_icon"
        android:visibility="gone"
        android:layout_width="19dp"
        android:layout_height="12dp"
        android:layout_marginTop="20dp"
        android:src="@drawable/sls_collection_sort_icon"
        android:contentDescription="@string/app_name"
        android:layout_marginEnd="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
