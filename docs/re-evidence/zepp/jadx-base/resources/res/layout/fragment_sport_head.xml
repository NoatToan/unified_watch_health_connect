<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_2b2b2b"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:background="@drawable/sport_details_head_bg"
        android:layout_width="wrap_content"
        android:layout_height="256dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/sport_details_content"
        android:layout_width="match_parent"
        android:layout_height="256dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="15.3sp"
                android:textColor="@color/white60"
                android:id="@+id/sport_head_main_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/sport_head_main_value"/>
            <TextView
                android:textSize="12.7sp"
                android:textColor="@color/white60"
                android:id="@+id/sport_head_no_map"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="23dp"
                android:text="@string/sport_detail_no_gps_data"
                android:drawablePadding="3.5dp"
                android:drawableEnd="@drawable/sport_details_head_alarm"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/sport_head_main_unit"/>
            <TextView
                android:textSize="12.7sp"
                android:textColor="@color/white60"
                android:gravity="center"
                android:id="@+id/sport_head_mileage_verify"
                android:background="@drawable/sport_details_head_ring"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginTop="19.6dp"
                android:text="@string/running_indoor_distance_verify"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/sport_head_main_unit"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="96.7sp"
                android:textColor="@color/white"
                android:id="@+id/sport_head_main_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="km"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
