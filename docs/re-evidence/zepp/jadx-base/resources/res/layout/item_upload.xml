<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/ftp_file_list_bg"
    android:layout_width="match_parent"
    android:layout_height="74dp"
    android:layout_marginStart="15dp"
    android:layout_marginEnd="15dp">
    <ImageView
        android:id="@+id/iv_task_symbol"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/ftp_icon_music"
        android:layout_marginStart="15dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:focusable="true"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/s1"
            android:ellipsize="middle"
            android:id="@+id/tv_task_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
        <ProgressBar
            android:id="@+id/pb_task_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:maxHeight="4dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/ftp_progress_horizontal"
            android:minHeight="4dp"
            style="?android:attr/progressBarStyleHorizontal"/>
    </LinearLayout>
    <View
        android:id="@+id/view_delete"
        android:background="@drawable/ic_delete_20"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginEnd="15dp"
        android:backgroundTint="@color/s1"/>
</LinearLayout>
