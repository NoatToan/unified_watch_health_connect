<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/pai_guide_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/guide_close_button"
            android:background="@null"
            android:padding="12dp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_close_20_2x"
            android:scaleType="fitXY"
            android:tint="@color/s2"
            android:layout_alignParentEnd="true"/>
        <com.huami.pai.view.PaiWrapContentHeightViewPager
            android:id="@+id/guide_vp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <RelativeLayout
            android:id="@+id/indicator_container"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/size_18dp"
            android:layout_marginBottom="20dp"
            android:layout_alignBottom="@+id/guide_vp"
            android:layout_centerHorizontal="true">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/guide_indicator_container"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/size_18dp"
                android:layout_alignParentStart="true"/>
            <ImageView
                android:id="@+id/guide_current_indicator"
                android:layout_width="@dimen/size_18dp"
                android:layout_height="@dimen/size_18dp"
                android:src="@drawable/pai_circle_6"
                android:scaleType="matrix"
                android:layout_alignParentStart="true"/>
        </RelativeLayout>
        <Button
            android:textColor="@color/s5"
            android:id="@+id/last_page_button"
            android:background="@drawable/pai_btn_circle_corner"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="@string/pai_guide_got_it"
            android:layout_alignBottom="@+id/guide_vp"
            android:layout_centerHorizontal="true"
            style="@style/Rainbow.TextAppearance.Body4"/>
    </RelativeLayout>
</FrameLayout>
