<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/running_primary_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="13.3sp"
        android:textColor="@color/run_white_50_percent"
        android:id="@+id/running_help_heart_rate_display_prompt"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <View
        android:background="@color/white10"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0.7dp"
        android:layout_marginTop="30dp"/>
    <TextView
        android:textSize="13.3sp"
        android:textColor="@color/run_white_50_percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/running_help_heart_rate_display_change_title"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/run_white_30_percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="13.3dp"
        android:text="@string/running_help_heart_rate_display_change_desc"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:background="@drawable/icon_running_help_heart_rate_figure1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="26.7dp"/>
    <TextView
        android:textSize="13.3sp"
        android:textColor="@color/run_white_50_percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="@string/running_help_heart_rate_range_title"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/run_white_30_percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="13.3dp"
        android:text="@string/running_help_heart_rate_range_desc"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/run_white_30_percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="26.7dp"
        android:text="@string/running_help_heart_rate_range_warm_up_relax"
        android:layout_marginStart="50dp"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_marginStart="50dp">
        <ImageView
            android:background="@drawable/icon_running_help_heart_rate_warmup_relax"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/run_white_30_percent"
            android:id="@+id/relax"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5.7dp"/>
    </LinearLayout>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/run_white_30_percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12.7dp"
        android:text="@string/running_help_heart_rate_range_fat_burning"
        android:layout_marginStart="50dp"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_marginStart="50dp">
        <ImageView
            android:background="@drawable/icon_running_help_heart_rate_fat_burning"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/run_white_30_percent"
            android:id="@+id/fatBurning"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5.7dp"/>
    </LinearLayout>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/run_white_30_percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12.7dp"
        android:text="@string/running_help_heart_rate_range_heart_lung_strengthen"
        android:layout_marginStart="50dp"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_marginStart="50dp">
        <ImageView
            android:background="@drawable/icon_running_help_heart_rate_heart_lung_strengthen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/run_white_30_percent"
            android:id="@+id/heartLungStrengthen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5.7dp"/>
    </LinearLayout>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/run_white_30_percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12.7dp"
        android:text="@string/running_help_heart_rate_range_stamina_strengthen"
        android:layout_marginStart="50dp"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_marginStart="50dp">
        <ImageView
            android:background="@drawable/icon_running_help_heart_rate_stamina_strengthen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/run_white_30_percent"
            android:id="@+id/staminaStrengthen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5.7dp"/>
    </LinearLayout>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/run_white_30_percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12.7dp"
        android:text="@string/running_help_heart_rate_range_anaerobic_limit"
        android:layout_marginStart="50dp"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_marginStart="50dp">
        <ImageView
            android:background="@drawable/icon_running_help_heart_rate_anaerobic_limit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/run_white_30_percent"
            android:id="@+id/anaerobicLimit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5.7dp"/>
    </LinearLayout>
</LinearLayout>
