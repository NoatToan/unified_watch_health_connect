<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardBackgroundColor="@color/s38"
    app:cardCornerRadius="9.6dp"
    app:cardPreventCornerOverlap="false"
    app:cardUseCompatPadding="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingBottom="13.3dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.huami.training.ui.widget.RoundImageView
            android:id="@+id/sport_advertise_image"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:scaleType="fitXY"
            app:layout_constraintDimensionRatio="340:115"
            app:layout_constraintTop_toTopOf="parent"
            app:up_radius="9.6dp"/>
        <TextView
            android:textSize="@dimen/size_14sp"
            android:textColor="@color/s1"
            android:id="@+id/sport_advertise_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6.7dp"
            android:layout_marginStart="18.7dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/sport_advertise_image"/>
        <TextView
            android:textSize="11.3sp"
            android:textColor="@color/s2"
            android:id="@+id/sport_advertise_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2.7dp"
            app:layout_constraintStart_toStartOf="@+id/sport_advertise_title"
            app:layout_constraintTop_toBottomOf="@+id/sport_advertise_title"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
