<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:background="@drawable/bg_guide_behavior"
    android:layout_width="295dp"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/s1"
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/lab_hint"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/s2"
        android:gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/lab_hint_info"
        android:lineSpacingExtra="10dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"/>
    <View
        android:background="@color/divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider"
        android:layout_marginTop="27dp"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/s2"
        android:gravity="center"
        android:id="@+id/tv_got_it"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="@string/gotit"/>
</LinearLayout>
