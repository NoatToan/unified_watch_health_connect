<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/s36"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/account_ui_bg_login_edit"
        android:layout_width="match_parent"
        android:layout_height="@dimen/account_ui_hm_email_input_height"
        android:layout_marginTop="12dp"
        android:layout_marginStart="@dimen/account_ui_hm_email_input_margin"
        android:layout_marginEnd="@dimen/account_ui_hm_email_input_margin">
        <TextView
            android:textSize="@dimen/account_ui_size_14sp"
            android:textColor="@color/s1"
            android:gravity="center_vertical"
            android:paddingBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/account_ui_hm_email_input_height"
            android:layout_marginLeft="@dimen/account_ui_size_15dp"
            android:layout_marginRight="@dimen/account_ui_size_15dp"
            android:text="+86"/>
        <View
            android:layout_gravity="center_vertical"
            android:background="@color/s4"
            android:layout_width="1dp"
            android:layout_height="26dp"/>
        <androidx.appcompat.widget.AppCompatEditText
            android:textSize="@dimen/account_ui_hm_email_text_size"
            android:textColor="@color/s1"
            android:textColorHint="@color/s3"
            android:gravity="start|center_vertical"
            android:id="@+id/input_phone_number"
            android:background="@color/account_ui_transparency"
            android:layout_width="match_parent"
            android:layout_height="@dimen/account_ui_hm_email_input_height"
            android:hint="@string/account_ui_account_input_phone"
            android:inputType="phone"
            android:textAlignment="viewStart"
            android:paddingStart="@dimen/account_ui_size_15dp"
            android:paddingEnd="@dimen/account_ui_size_15dp"/>
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/account_ui_hm_email_input_height"
        android:layout_marginTop="@dimen/account_ui_hm_email_password_margin_top"
        android:layout_marginStart="@dimen/account_ui_hm_email_input_margin"
        android:layout_marginEnd="@dimen/account_ui_hm_email_input_margin">
        <androidx.appcompat.widget.AppCompatEditText
            android:textSize="@dimen/account_ui_hm_email_text_size"
            android:textColor="@color/s1"
            android:textColorHint="@color/s3"
            android:gravity="start|center_vertical"
            android:id="@+id/input_password_text"
            android:background="@drawable/account_ui_bg_login_edit"
            android:layout_width="match_parent"
            android:layout_height="@dimen/account_ui_hm_email_input_height"
            android:hint="@string/account_ui_account_input_password"
            android:inputType="textPassword"
            android:textAlignment="viewStart"
            android:paddingStart="@dimen/account_ui_size_15dp"
            android:paddingEnd="@dimen/account_ui_size_15dp"/>
        <ImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/input_password_text_show"
            android:layout_width="@dimen/account_ui_hm_email_input_password_show_size"
            android:layout_height="@dimen/account_ui_hm_email_input_password_show_size"
            android:src="@drawable/account_ui_hm_email_eye_close"
            android:scaleType="centerInside"
            android:alpha="0.4"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="15dp"/>
    </FrameLayout>
    <TextView
        android:textSize="@dimen/account_ui_size_12sp"
        android:textColor="@color/s3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/account_ui_hm_email_input_margin"
        android:layout_marginTop="12dp"
        android:layout_marginRight="@dimen/account_ui_hm_email_input_margin"
        android:layout_marginBottom="12dp"
        android:text="@string/account_ui_register_phone_set_password_tip"/>
    <LinearLayout
        android:id="@+id/hm_email_verification_code_rl"
        android:layout_width="match_parent"
        android:layout_height="@dimen/account_ui_hm_email_input_height"
        android:layout_marginStart="@dimen/account_ui_hm_email_input_margin"
        android:layout_marginEnd="@dimen/account_ui_hm_email_input_margin">
        <androidx.appcompat.widget.AppCompatEditText
            android:textSize="@dimen/account_ui_hm_email_text_size"
            android:textColor="@color/s1"
            android:textColorHint="@color/s3"
            android:gravity="start|center_vertical"
            android:id="@+id/input_verification_code"
            android:background="@drawable/account_ui_bg_login_edit"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:hint="@string/account_ui_account_input_verify_code"
            android:maxEms="6"
            android:layout_weight="1"
            android:inputType="numberDecimal"
            android:paddingStart="@dimen/account_ui_size_15dp"
            android:paddingEnd="@dimen/account_ui_hm_email_verification_code_image_width"/>
        <Space
            android:layout_width="@dimen/account_ui_size_10dp"
            android:layout_height="match_parent"/>
        <TextView
            android:id="@+id/send_verify_btn"
            android:text="@string/account_ui_account_get_verify_code"
            style="@style/AccountUiGetVerificationCodeButton"/>
    </LinearLayout>
    <TextView
        android:enabled="false"
        android:textSize="@dimen/account_ui_login_btn_text_size"
        android:textColor="@color/account_ui_select_alive_btn_txt_color"
        android:gravity="center"
        android:id="@+id/register_now_btn"
        android:background="@drawable/account_ui_btn_bg_login"
        android:layout_width="match_parent"
        android:layout_height="@dimen/account_ui_click_button_h"
        android:layout_marginTop="@dimen/account_ui_size_60dp"
        android:text="@string/account_ui_account_register_now"
        android:layout_marginStart="@dimen/account_ui_hm_email_input_margin"
        android:layout_marginEnd="@dimen/account_ui_hm_email_input_margin"/>
    <com.huami.http.serverfault.widget.ServerFaultView
        android:id="@+id/server_fault_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_20dp"
        android:layout_marginStart="@dimen/account_ui_hm_email_input_margin"
        android:layout_marginEnd="@dimen/account_ui_hm_email_input_margin"/>
</LinearLayout>
