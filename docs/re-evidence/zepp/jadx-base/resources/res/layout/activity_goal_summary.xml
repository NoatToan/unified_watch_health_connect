<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:id="@+id/layout_goal_step"
        style="@style/GoalItemLayout">
        <TextView
            android:text="@string/goal_step_item"
            style="@style/GoalLabelText"/>
        <TextView
            android:textSize="@dimen/size_14sp"
            android:textColor="@color/s2"
            android:id="@+id/tv_goal_step"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/not_set"/>
        <Space
            android:layout_width="@dimen/size_10dp"
            android:layout_height="0dp"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:src="@drawable/arrow_right"
            style="@style/GoalLabelIcon"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/layout_goal_weight"
        style="@style/GoalItemLayout">
        <TextView
            android:text="@string/goal_weight_item"
            style="@style/GoalLabelText"/>
        <TextView
            android:textSize="@dimen/size_14sp"
            android:textColor="@color/s2"
            android:id="@+id/tv_goal_weight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/not_set"/>
        <Space
            android:layout_width="@dimen/size_10dp"
            android:layout_height="0dp"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:src="@drawable/arrow_right"
            style="@style/GoalLabelIcon"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/layout_goal_consume"
        style="@style/GoalItemLayout">
        <TextView
            android:text="@string/goal_calorie_item"
            style="@style/GoalLabelText"/>
        <TextView
            android:textSize="@dimen/size_14sp"
            android:textColor="@color/s2"
            android:id="@+id/tv_goal_consume"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/not_set"/>
        <Space
            android:layout_width="@dimen/size_10dp"
            android:layout_height="0dp"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:src="@drawable/arrow_right"
            style="@style/GoalLabelIcon"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/layout_goal_sleep"
        style="@style/GoalItemLayout">
        <TextView
            android:text="@string/goal_sleep_item"
            style="@style/GoalLabelText"/>
        <TextView
            android:textSize="@dimen/size_14sp"
            android:textColor="@color/s2"
            android:id="@+id/tv_goal_sleep"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/not_set"/>
        <Space
            android:layout_width="@dimen/size_10dp"
            android:layout_height="0dp"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:src="@drawable/arrow_right"
            style="@style/GoalLabelIcon"/>
    </LinearLayout>
</LinearLayout>
