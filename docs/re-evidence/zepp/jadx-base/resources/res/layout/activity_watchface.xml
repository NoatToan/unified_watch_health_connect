<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.watch.companion.ui.view.ActionbarLayout
        android:id="@+id/watchface_actionbar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#e6000000"
            android:gravity="center_horizontal"
            android:id="@+id/delete"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/delete"
            android:layout_centerVertical="true"
            android:layout_marginEnd="16dp"
            android:layout_alignParentEnd="true"/>
    </com.huami.watch.companion.ui.view.ActionbarLayout>
    <com.huami.watch.companion.ui.view.PagerSlidingTabStrip
        android:id="@+id/tab_indicator"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:pstsIndicatorHeight="2dp"
        app:pstsIndicatorWidth="22dp"
        app:pstsTabTextStyle="normal"/>
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/white"
        android:paddingBottom="27dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include layout="@layout/split_line_width_match_parent"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/grey_text"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/watch_face_load_bg_tip"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@drawable/color_text_red_black"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_big_btn_border"
            android:clickable="true"
            android:layout_width="313dp"
            android:layout_height="39dp"
            android:layout_marginTop="8dp"
            android:text="@string/watch_face_load_bg"/>
    </LinearLayout>
</LinearLayout>
