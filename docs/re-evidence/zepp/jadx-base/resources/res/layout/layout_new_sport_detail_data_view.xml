<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/chart_info_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RadioGroup
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/milestone_area"
            android:background="@drawable/shape_rect_corner_15_black19"
            android:visibility="gone"
            android:layout_width="258dp"
            android:layout_height="30dp"
            android:layout_marginBottom="22dp"/>
        <ImageView
            android:layout_gravity="end"
            android:id="@+id/image_play"
            android:background="@drawable/shape_sgin_bg"
            android:padding="5dp"
            android:visibility="gone"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_appear_20_play"
            android:layout_marginEnd="10dp"/>
        <com.huami.moving.sport.ui.view.card.OverViewCard
            android:id="@+id/overview_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/s10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/target_card_layout"
            android:background="@drawable/shape_rect_white_corner_6"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:paddingStart="13.4dp"
            android:paddingEnd="12.7dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp">
            <TextView
                android:textColor="@color/s1"
                android:id="@+id/sport_detail_target_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="@string/sport_detail_sport_target"
                android:layout_alignParentTop="true"
                android:layout_alignParentStart="true"
                style="@style/Rainbow.TextAppearance.Body3"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/target_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="20dp"
                android:listSelector="@android:color/transparent"
                android:numColumns="3"
                android:layout_below="@+id/sport_detail_target_title"/>
        </RelativeLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/moving_ui_chart_layout"
            android:background="@color/s10"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:id="@+id/triangle_multiple"
            android:background="@drawable/shape_rect_white_corner_6"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9.6dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/card_strength_training_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/segment_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/card_share_feedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/d4"
            android:layout_marginBottom="32dp">
            <TextView
                android:textColor="@color/s2"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="@string/moving_ui_feedback_has_question"
                style="@style/Rainbow.TextAppearance.Body4"/>
            <TextView
                android:textColor="@color/s15"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/moving_ui_sport_feedback"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="@string/moving_ui_feedback_to_us"
                style="@style/Rainbow.TextAppearance.Body4"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/card_share_end"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include layout="@layout/card_share_end"/>
    </LinearLayout>
</LinearLayout>
