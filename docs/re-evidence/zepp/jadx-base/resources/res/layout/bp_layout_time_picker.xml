<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:background="@drawable/card_corner_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size_15"
        android:layout_marginStart="@dimen/size_15"
        android:layout_marginEnd="@dimen/size_15">
        <androidx.appcompat.widget.AppCompatTextView
            android:gravity="center"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_20"
            android:textAlignment="center"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/body1s1"/>
        <View
            android:id="@+id/divider"
            android:background="@color/line_color"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_line"
            android:layout_marginTop="@dimen/size_20"
            app:layout_constraintTop_toBottomOf="@+id/title"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/wheel"
            android:layout_width="match_parent"
            android:layout_height="222dp"
            app:layout_constraintTop_toBottomOf="@+id/divider">
            <com.huami.widget.wheelview.WheelView
                android:id="@+id/wheel_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                app:layout_constraintEnd_toStartOf="@+id/wheel_2"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toStartOf="parent"/>
            <com.huami.widget.wheelview.WheelView
                android:id="@+id/wheel_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                app:layout_constraintEnd_toStartOf="@+id/wheel_3"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toEndOf="@+id/wheel_1"/>
            <com.huami.widget.wheelview.WheelView
                android:id="@+id/wheel_3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toEndOf="@+id/wheel_2"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:id="@+id/divider_2"
            android:background="#1a000000"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_line"
            android:layout_marginTop="@dimen/size_20"
            app:layout_constraintTop_toBottomOf="@+id/wheel"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:gravity="center"
            android:id="@+id/cancel"
            android:layout_width="0dp"
            android:layout_height="@dimen/size_60"
            android:text="@string/blood_pressure_cancel"
            android:textAlignment="center"
            app:layout_constraintEnd_toStartOf="@+id/divider_3"
            app:layout_constraintHorizontal_weight="171"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/divider_2"
            style="@style/body3s2"/>
        <View
            android:id="@+id/divider_3"
            android:background="#1a000000"
            android:layout_width="0dp"
            android:layout_height="@dimen/size_24"
            app:layout_constraintBottom_toBottomOf="@+id/cancel"
            app:layout_constraintEnd_toStartOf="@+id/confirm"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@+id/cancel"
            app:layout_constraintTop_toTopOf="@+id/cancel"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:gravity="center"
            android:id="@+id/confirm"
            android:layout_width="0dp"
            android:layout_height="@dimen/size_60"
            android:text="@string/blood_pressure_confirm"
            android:textAlignment="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="171"
            app:layout_constraintStart_toEndOf="@+id/divider_3"
            app:layout_constraintTop_toBottomOf="@+id/divider_2"
            style="@style/body3s1"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
