<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:layout_width="153.3dp"
    android:layout_height="153.3dp">
    <ImageView
        android:id="@+id/iv_watch_face"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/watch_face_edit_normal_bg"/>
    <com.huami.watch.companion.watchface.view.ClipImageView
        android:id="@+id/iv_left_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        app:clipStart="left_top"
        app:divideHeight="2"
        app:divideWidth="2"
        app:src="@drawable/xihu_watch_face_power_circle"/>
    <com.huami.watch.companion.watchface.view.ClipImageView
        android:id="@+id/iv_right_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        app:clipStart="right_top"
        app:divideHeight="2"
        app:divideWidth="2"
        app:src="@drawable/xihu_watch_face_power_circle"/>
    <com.huami.watch.companion.watchface.view.ClipImageView
        android:id="@+id/iv_left_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        app:clipStart="left_bottom"
        app:divideHeight="2"
        app:divideWidth="2"
        app:src="@drawable/xihu_watch_face_power_circle"/>
    <com.huami.watch.companion.watchface.view.ClipImageView
        android:id="@+id/iv_right_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        app:clipStart="right_bottom"
        app:divideHeight="2"
        app:divideWidth="2"
        app:src="@drawable/xihu_watch_face_power_circle"/>
    <ImageView
        android:id="@+id/iv_center_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28.2dp"
        android:src="@drawable/classics_weather"
        android:layout_centerHorizontal="true"/>
    <ImageView
        android:id="@+id/iv_center_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/classics_weather"
        android:layout_centerVertical="true"
        android:layout_marginStart="23.5dp"/>
    <ImageView
        android:id="@+id/iv_center_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/classics_weather"
        android:layout_centerVertical="true"
        android:layout_marginEnd="23.5dp"
        android:layout_alignParentEnd="true"/>
    <ImageView
        android:id="@+id/iv_center_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="22.2dp"
        android:src="@drawable/classics_weather"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
