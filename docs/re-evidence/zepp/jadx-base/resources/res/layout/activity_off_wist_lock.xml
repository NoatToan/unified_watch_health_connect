<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/anim_container"
        android:background="@color/s15"
        android:layout_width="match_parent"
        android:layout_height="251dp">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/off_wist_lock_img"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/img_lock_from_wrist"
            app:tint="@color/s38"/>
        <TextView
            android:textColor="@color/s36"
            android:gravity="center"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:text="@string/mili_setting_off_wist_lock_desc"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.huami.lib.rainbow.ListTile
        android:id="@+id/off_lock_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:onClick="onClick"
        app:ltv_tips="@string/mili_setting_off_wist_lock_not_setting"
        app:ltv_title="@string/mili_setting_off_wist_lock_password_title"/>
    <com.huami.lib.rainbow.ListTile
        android:id="@+id/off_lock_close_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:onClick="onClick"
        app:ltv_divider_padding="all"
        app:ltv_title="@string/mili_setting_off_wist_lock_close"/>
    <com.huami.lib.rainbow.ListTile
        android:id="@+id/off_lock_modify_password_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:onClick="onClick"
        app:ltv_title="@string/mili_setting_off_wist_lock_modify"/>
</LinearLayout>
