<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.lib.rainbow.ListTile
        android:id="@+id/enable_switch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:ltv_checked="true"
        app:ltv_title="@string/enable_long_sit_alert"/>
    <com.huami.lib.rainbow.ListTile
        android:id="@+id/vibrate_mode_iv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:ltv_tips="@string/custom_vibrate_mode_default"
        app:ltv_title="@string/custom_vibrate_mode"/>
    <com.huami.lib.rainbow.ListTile
        android:id="@+id/long_sit_alert_start_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:onClick="onClick"
        app:ltv_title="@string/long_sit_alert_start"/>
    <com.huami.lib.rainbow.ListTile
        android:id="@+id/long_sit_alert_stop_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:onClick="onClick"
        app:ltv_title="@string/long_sit_alert_stop"/>
    <com.huami.lib.rainbow.ListTile
        android:id="@+id/long_sit_no_alert_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:ltv_checked="true"
        app:ltv_subtitle="@string/long_sit_no_alert_tips"
        app:ltv_title="@string/long_sit_no_alert_title"/>
    <com.huami.lib.rainbow.ListTile
        android:id="@+id/dnd_start"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:onClick="onClick"
        app:ltv_title="@string/long_sit_alert_start"/>
    <com.huami.lib.rainbow.ListTile
        android:id="@+id/dnd_end"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:onClick="onClick"
        app:ltv_title="@string/long_sit_alert_stop"/>
</LinearLayout>
