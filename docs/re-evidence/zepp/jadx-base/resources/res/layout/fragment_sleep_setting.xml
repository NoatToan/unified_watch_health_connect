<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/actionbar"
        android:background="@color/white"
        android:fitsSystemWindows="true"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="start|center_vertical"
            android:id="@+id/btn_back"
            android:background="@null"
            android:layout_width="29dp"
            android:layout_height="27dp"
            android:src="@drawable/arrow_back_black"
            android:scaleType="center"
            android:layout_marginStart="@dimen/size_10dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/top_line"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#ff333333"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:text="@string/st_sleep_setting"/>
    </androidx.appcompat.widget.Toolbar>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/actionbar">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/linearLayout"
                android:background="@drawable/shape_corners_device_setting"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/size_15dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <com.huami.lib.rainbow.ListTile
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:itemSummary="@string/st_sleep_setting_smart_desc"
                    app:itemSwitch="true"
                    app:itemTopBottomStyle="true"
                    app:ltv_title="@string/st_sleep_setting_smart"/>
                <com.huami.lib.rainbow.ListTile
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:itemSwitch="true"
                    app:itemTitle="@string/st_sleep_setting_donot_disturb"
                    app:itemTopBottomStyle="true"
                    app:ltv_subtitle="@string/st_sleep_setting_donot_disturb_desc"/>
                <com.huami.lib.rainbow.ListTile
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:itemSwitch="true"
                    app:itemTitle="@string/st_sleep_setting_target"
                    app:itemTopBottomStyle="true"
                    app:ltv_subtitle="@string/st_sleep_setting_target_desc"/>
            </LinearLayout>
            <View
                android:id="@+id/sub_bg"
                android:background="@drawable/shape_corners_device_setting"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_margin="@dimen/size_15dp"
                android:layout_marginBottom="@dimen/td_size_30dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/linearLayout"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12sp"
                android:textColor="#ff999999"
                android:id="@+id/tv_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/size_15dp"
                android:text="@string/st_week_setting_title"
                app:layout_constraintEnd_toEndOf="@+id/sub_bg"
                app:layout_constraintStart_toStartOf="@+id/sub_bg"
                app:layout_constraintTop_toTopOf="@+id/sub_bg"/>
            <View
                android:id="@+id/gl_center"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12sp"
                android:textColor="@color/btn_text_color"
                android:gravity="center"
                android:id="@+id/tv_monday"
                android:background="@drawable/select_sleep_item"
                android:layout_width="@dimen/td_size_30dp"
                android:layout_height="@dimen/td_size_30dp"
                android:layout_marginTop="24dp"
                android:text="@string/st_week_monday"
                app:layout_constraintEnd_toStartOf="@+id/tv_tuesday"
                app:layout_constraintStart_toStartOf="@+id/tv_title"
                app:layout_constraintTop_toTopOf="@+id/gl_center"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12sp"
                android:textColor="@color/btn_text_color"
                android:gravity="center"
                android:id="@+id/tv_tuesday"
                android:background="@drawable/select_sleep_item"
                android:layout_width="@dimen/td_size_30dp"
                android:layout_height="@dimen/td_size_30dp"
                android:layout_marginTop="24dp"
                android:text="@string/st_week_tuesday"
                app:layout_constraintEnd_toStartOf="@+id/tv_wednesday"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/tv_monday"
                app:layout_constraintTop_toTopOf="@+id/gl_center"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12sp"
                android:textColor="#ffffffff"
                android:gravity="center"
                android:id="@+id/tv_wednesday"
                android:background="@drawable/select_sleep_item"
                android:layout_width="@dimen/td_size_30dp"
                android:layout_height="@dimen/td_size_30dp"
                android:layout_marginTop="24dp"
                android:text="@string/st_week_wednesday"
                app:layout_constraintEnd_toStartOf="@+id/tv_thursday"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/tv_tuesday"
                app:layout_constraintTop_toTopOf="@+id/gl_center"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12sp"
                android:textColor="@color/btn_text_color"
                android:gravity="center"
                android:id="@+id/tv_thursday"
                android:background="@drawable/select_sleep_item"
                android:layout_width="@dimen/td_size_30dp"
                android:layout_height="@dimen/td_size_30dp"
                android:layout_marginTop="24dp"
                android:text="@string/st_week_thursday"
                app:layout_constraintEnd_toStartOf="@+id/tv_friday"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/tv_wednesday"
                app:layout_constraintTop_toTopOf="@+id/gl_center"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12sp"
                android:textColor="@color/btn_text_color"
                android:gravity="center"
                android:id="@+id/tv_friday"
                android:background="@drawable/select_sleep_item"
                android:layout_width="@dimen/td_size_30dp"
                android:layout_height="@dimen/td_size_30dp"
                android:layout_marginTop="24dp"
                android:text="@string/st_week_friday"
                app:layout_constraintEnd_toStartOf="@+id/tv_saturday"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/tv_thursday"
                app:layout_constraintTop_toTopOf="@+id/gl_center"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12sp"
                android:textColor="@color/btn_text_color"
                android:gravity="center"
                android:id="@+id/tv_saturday"
                android:background="@drawable/select_sleep_item"
                android:layout_width="@dimen/td_size_30dp"
                android:layout_height="@dimen/td_size_30dp"
                android:layout_marginTop="24dp"
                android:text="@string/st_week_saturday"
                app:layout_constraintEnd_toStartOf="@+id/tv_sunday"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/tv_friday"
                app:layout_constraintTop_toTopOf="@+id/gl_center"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12sp"
                android:textColor="@color/btn_text_color"
                android:gravity="center"
                android:id="@+id/tv_sunday"
                android:background="@drawable/select_sleep_item"
                android:layout_width="@dimen/td_size_30dp"
                android:layout_height="@dimen/td_size_30dp"
                android:layout_marginTop="24dp"
                android:text="@string/st_week_sunday"
                app:layout_constraintEnd_toEndOf="@+id/tv_title"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/tv_saturday"
                app:layout_constraintTop_toTopOf="@+id/gl_center"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="16sp"
                android:textColor="#ff666666"
                android:id="@+id/tv_enter_sleep"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_76dp"
                android:text="@string/st_week_enter_sleep"
                app:layout_constraintEnd_toStartOf="@+id/tv_wake_up"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="16sp"
                android:textColor="#ff666666"
                android:id="@+id/tv_wake_up"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_76dp"
                android:text="@string/st_week_wednesday"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/tv_enter_sleep"
                app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="24sp"
                android:textColor="#ff000000"
                android:id="@+id/tv_enter_sleep_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toStartOf="@+id/tv_wake_up_time"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_enter_sleep"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="24sp"
                android:textColor="#ff000000"
                android:id="@+id/tv_wake_up_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/tv_enter_sleep_time"
                app:layout_constraintTop_toBottomOf="@+id/tv_enter_sleep"/>
            <com.huami.ui.widget.sleepdial.TimeDialView
                android:id="@+id/sleep_dial"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_24dp"
                android:layout_marginBottom="@dimen/size_48dp"
                app:layout_constraintBottom_toBottomOf="@+id/sub_bg"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_wake_up_time"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12sp"
                android:textColor="#ff999999"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="110dp"
                android:maxWidth="120dp"
                android:maxLines="1"
                app:layout_constraintEnd_toEndOf="@+id/sleep_dial"
                app:layout_constraintStart_toStartOf="@+id/sleep_dial"
                app:layout_constraintTop_toTopOf="@+id/sleep_dial"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="24sp"
                android:textColor="#ff000000"
                android:id="@+id/tv_hours"
                android:layout_width="30dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="80dp"
                app:layout_constraintBottom_toBottomOf="@+id/tv_minutes"
                app:layout_constraintEnd_toStartOf="@+id/tv_hours_desc"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12sp"
                android:textColor="#ff999999"
                android:id="@+id/tv_hours_desc"
                android:padding="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/unit_hour_long"
                app:layout_constraintBottom_toBottomOf="@+id/tv_hours"
                app:layout_constraintEnd_toStartOf="@+id/gl_3"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="24sp"
                android:textColor="#ff000000"
                android:id="@+id/tv_minutes"
                android:layout_width="30dp"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@+id/sleep_dial"
                app:layout_constraintStart_toEndOf="@+id/gl_3"
                app:layout_constraintTop_toTopOf="@+id/sleep_dial"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12sp"
                android:textColor="#ff999999"
                android:padding="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/minute_time"
                app:layout_constraintBottom_toBottomOf="@+id/tv_hours"
                app:layout_constraintStart_toEndOf="@+id/tv_minutes"/>
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/gl_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_percent="0.5"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
