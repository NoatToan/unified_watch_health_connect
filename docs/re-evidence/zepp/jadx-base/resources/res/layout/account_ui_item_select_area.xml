<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="17.5dp"
    android:paddingBottom="17.5dp"
    android:layout_width="match_parent"
    android:layout_height="58dp">
    <ImageView
        android:id="@+id/item_checked"
        android:visibility="invisible"
        android:layout_width="@dimen/size_16dp"
        android:layout_height="@dimen/size_16dp"
        android:src="@drawable/account_ui_check"
        android:scaleType="fitXY"
        android:layout_centerVertical="true"
        android:layout_toEndOf="@+id/item_area"
        app:tint="@color/s1"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/s1"
        android:gravity="start|center_vertical"
        android:id="@+id/item_area"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/size_6pd"
        android:layout_centerVertical="true"/>
</RelativeLayout>
