<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/pale_grey_two"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="20sp"
        android:textColor="@color/black80"
        android:gravity="center"
        android:id="@+id/title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/play_miband3_title_5"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/black60"
        android:gravity="center"
        android:id="@+id/sub_title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:text="@string/play_miband3_subtitle_5"
        android:layout_below="@+id/title_tv"
        android:layout_centerHorizontal="true"/>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp"
        android:src="@drawable/img_band_3"
        android:layout_below="@+id/sub_title_tv"
        android:layout_centerHorizontal="true"/>
    <FrameLayout
        android:id="@+id/frame_img"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="121dp"
        android:layout_below="@+id/sub_title_tv"
        android:layout_centerHorizontal="true">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/img_band_3_time"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="10sp"
            android:textColor="@color/play_miband3_text_color"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:layout_width="47dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="60dp"
            android:text="@string/play_miband3_date"
            android:maxLines="1"
            android:fontFamily="km"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/unlock_container"
        android:layout_width="46dp"
        android:layout_height="74dp"
        android:layout_marginTop="121dp"
        android:layout_below="@+id/sub_title_tv"
        android:layout_centerHorizontal="true">
        <ImageView
            android:id="@+id/unlock_img"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/img_band_3_unlock_1"/>
        <TextView
            android:textSize="10sp"
            android:textColor="#6cacec"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/play_miband3_unlock"/>
    </FrameLayout>
    <View
        android:id="@+id/center_view"
        android:background="@color/transparent"
        android:layout_width="1px"
        android:layout_height="1px"
        android:layout_centerInParent="true"/>
    <ImageView
        android:id="@+id/hand_img"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="300dp"
        android:src="@drawable/img_hand"
        android:layout_toEndOf="@+id/center_view"/>
</RelativeLayout>
