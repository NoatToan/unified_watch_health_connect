<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@android:color/white"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:background="@android:color/white"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="start|center_vertical"
            android:id="@+id/btn_back"
            android:background="@null"
            android:layout_width="29dp"
            android:layout_height="27dp"
            android:src="@drawable/arrow_back_black"
            android:scaleType="center"
            android:layout_marginStart="@dimen/size_10dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/top_line"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#ff333333"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:text="@string/device_ds_band_setting"/>
    </androidx.appcompat.widget.Toolbar>
    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.core.widget.NestedScrollView
            android:background="@color/cl_fff8f8f8"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="vertical"
                android:background="@drawable/shape_corners_device_setting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_15dp"
                android:layout_marginStart="@dimen/size_15dp"
                android:layout_marginEnd="@dimen/size_15dp">
                <com.xiaomi.hm.health.baseui.widget.ItemView
                    android:id="@+id/watch_language_wristband"
                    android:background="@color/white100"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:itemTitle="@string/watch_language_wristband"
                    app:itemTopBottomStyle="false"/>
                <com.xiaomi.hm.health.baseui.widget.ItemView
                    android:id="@+id/setting_peyto_apps_title_band"
                    android:background="@color/white100"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:itemSummary="@string/setting_tempo_apps_tips"
                    app:itemTitle="@string/setting_peyto_apps_title_band"
                    app:itemTopBottomStyle="false"/>
                <com.xiaomi.hm.health.baseui.widget.ItemView
                    android:id="@+id/setting_shotcut_apps_title"
                    android:background="@color/white100"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:itemSummary="@string/setting_shotcut_apps_tips"
                    app:itemTitle="@string/setting_shotcut_apps_title"
                    app:itemTopBottomStyle="false"/>
                <com.xiaomi.hm.health.baseui.widget.ItemView
                    android:id="@+id/device_sport_setting_title"
                    android:background="@color/white100"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:itemSummary="@string/device_sport_setting_summary"
                    app:itemTitle="@string/device_sport_setting_title"
                    app:itemTopBottomStyle="false"/>
                <com.xiaomi.hm.health.baseui.widget.ItemView
                    android:id="@+id/mili_setting_ges_screen"
                    android:background="@color/white100"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:itemTitle="@string/mili_setting_ges_screen_v2"
                    app:itemTopBottomStyle="false"/>
                <com.xiaomi.hm.health.baseui.widget.ItemView
                    android:id="@+id/mili_setting_off_wist_lock"
                    android:background="@color/white100"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:itemTitle="@string/mili_setting_off_wist_lock"
                    app:itemTopBottomStyle="false"/>
                <com.xiaomi.hm.health.baseui.widget.ItemView
                    android:id="@+id/night_mode"
                    android:background="@color/white100"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:itemTitle="@string/night_mode"
                    app:itemTopBottomStyle="false"/>
                <com.xiaomi.hm.health.baseui.widget.ItemView
                    android:id="@+id/mili_setting_set_wear"
                    android:background="@color/white100"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:itemTitle="@string/mili_setting_set_wear"
                    app:itemTopBottomStyle="false"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.core.widget.NestedScrollView>
        <View
            android:id="@+id/mask_view"
            android:background="#77f7f7f7"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
</androidx.appcompat.widget.LinearLayoutCompat>
