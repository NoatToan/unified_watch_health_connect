<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.huami.bloodoxygen.ui.view.BloodOxygenCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:padding="@dimen/bo_ui_size_15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="@dimen/bo_ui_size_16sp"
                android:textStyle="bold"
                android:textColor="@color/s1"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bo_ui_spo2_name"
                android:textDirection="locale"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="@dimen/bo_ui_size_14sp"
                android:textColor="@color/s2"
                android:id="@+id/intro_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/bo_ui_size_15dp"
                android:text="@string/bo_ui_spo2_intro_new"
                android:lineSpacingExtra="5.3sp"
                android:textDirection="locale"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/title"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/group_read_more"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="divider_read_more,read_more"/>
            <View
                android:id="@+id/divider_read_more"
                android:layout_marginTop="@dimen/bo_ui_size_15dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/intro_content"
                style="@style/bo_ui_Divider_Horizontal"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/read_more"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/bo_ui_size_12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/divider_read_more">
                <com.huami.widget.typeface.TypefaceTextView
                    android:textSize="@dimen/bo_ui_size_14sp"
                    android:textColor="@color/s2"
                    android:gravity="center"
                    android:layout_gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bo_ui_learn_about_more"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:layout_width="@dimen/bo_ui_size_15dp"
                    android:layout_height="@dimen/bo_ui_size_15dp"
                    android:src="@drawable/ic_arrow_forward_20_2x"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/divider_read_more"
                    app:tint="@color/s2"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.huami.bloodoxygen.ui.view.BloodOxygenCardView>
    <TextView
        android:textSize="@dimen/bo_ui_size_12sp"
        android:textColor="@color/s3"
        android:id="@+id/jp_hint_text"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/bo_ui_size_12dp"
        android:text="@string/bo_ui_japanese_hint"
        android:layout_marginStart="@dimen/bo_ui_size_25dp"
        android:layout_marginEnd="@dimen/bo_ui_size_25dp"/>
</LinearLayout>
