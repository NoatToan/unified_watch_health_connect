<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:background="#f4f5f7"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_width="62dp"
        android:layout_height="62dp"
        android:src="@drawable/wl_watch_bank_failure"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#80000000"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/wl_bank_page_loading_failure"/>
    <Button
        android:textSize="14sp"
        android:textColor="@color/wl_watch_bank_btn_text_color"
        android:id="@+id/wl_load_failure_retry"
        android:background="@drawable/wl_watch_bank_btn_bg"
        android:layout_width="154dp"
        android:layout_height="36dp"
        android:layout_marginTop="24dp"
        android:text="@string/wl_bank_retry"/>
</LinearLayout>
