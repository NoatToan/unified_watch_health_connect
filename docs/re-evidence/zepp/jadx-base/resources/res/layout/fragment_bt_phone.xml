<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.lib.rainbow.titlebar.RainbowTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/app_sort_phone"/>
    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.huami.lib.view.widget.TipComponent
        android:layout_gravity="start"
        android:id="@+id/permission_tips"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.huami.lib.rainbow.ListTile
        android:id="@+id/bt_phone_iv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginStart="@dimen/size_15dp"
        android:layout_marginEnd="@dimen/size_15dp"
        app:ltv_checked="false"
        app:ltv_radius_position="all"
        app:ltv_subtitle="@string/bt_phone_subtitle"
        app:ltv_title="@string/bt_phone_title"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/s2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="8dp"
        android:text="@string/bt_phone_setting_title"
        android:layout_marginStart="@dimen/size_15dp"
        android:layout_marginEnd="@dimen/size_15dp"/>
    <com.huami.lib.rainbow.ListTile
        android:id="@+id/delay_iv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_15dp"
        android:layout_marginEnd="@dimen/size_15dp"
        app:ltv_checked="false"
        app:ltv_divider_padding="all"
        app:ltv_radius_position="top"
        app:ltv_title="@string/bt_phone_delay"/>
    <com.huami.lib.rainbow.ListTile
        android:id="@+id/delay_time_iv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_15sp"
        android:layout_marginEnd="@dimen/size_15dp"
        app:ltv_radius_position="bottom"
        app:ltv_title="@string/delay_alert_time"/>
    <com.huami.lib.rainbow.ListTile
        android:id="@+id/contact_iv"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_15dp"
        android:layout_marginStart="@dimen/size_15dp"
        android:layout_marginEnd="@dimen/size_15dp"
        app:ltv_radius_position="all"
        app:ltv_title="@string/bt_contact_item"/>
</LinearLayout>
