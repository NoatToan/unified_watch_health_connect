<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/layout_contain"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.watch.companion.ui.view.ActionbarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <RelativeLayout
        android:id="@+id/layout_author"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="-46.3dp">
        <ImageView
            android:id="@+id/iv_watch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_bind_wechat_left"
            android:layout_centerVertical="true"
            android:layout_marginEnd="16.2dp"
            android:layout_toStartOf="@+id/iv_bind_point_left"/>
        <ImageView
            android:id="@+id/iv_bind_point_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_bind_wechat_point"
            android:layout_centerVertical="true"
            android:layout_marginEnd="5.2dp"
            android:layout_toStartOf="@+id/iv_bind"/>
        <ImageView
            android:id="@+id/iv_bind"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_bind_wechat_middle"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/iv_bind_point_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_bind_wechat_point"
            android:layout_centerVertical="true"
            android:layout_marginStart="5.2dp"
            android:layout_toEndOf="@+id/iv_bind"/>
        <ImageView
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:src="@drawable/ic_third_party_lvmi"
            android:layout_centerVertical="true"
            android:layout_marginStart="16.2dp"
            android:layout_toEndOf="@+id/iv_bind_point_right"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#e6000000"
            android:id="@+id/tv_author"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="24dp"
            android:layout_below="@+id/iv_watch"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/btn_text_black_red"
            android:gravity="center"
            android:background="@drawable/btn_save_border_selector"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginBottom="20dp"
            android:text="@string/remove_author"
            android:layout_alignParentBottom="true"
            android:onClick="unbindAuthor"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"/>
    </RelativeLayout>
    <WebView
        android:id="@+id/webview"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>
