<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:id="@+id/marker_other_info"
        android:background="@drawable/td_line_running_marker_other"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="20sp"
            android:textColor="@color/s2"
            android:gravity="center"
            android:id="@+id/marker_other_speed"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginBottom="3dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/s2"
            android:gravity="center"
            android:id="@+id/marker_other_speed_unit"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="3dp"
            android:layout_marginStart="5dp"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/marker_other_avatar"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="9dp"
        android:layout_below="@+id/marker_other_info"
        android:layout_marginStart="@dimen/td_size_38dp"/>
    <ImageView
        android:background="@drawable/td_avatar_ring_marker_other"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="9dp"
        android:layout_below="@+id/marker_other_info"
        android:layout_marginStart="@dimen/td_size_38dp"/>
</RelativeLayout>
