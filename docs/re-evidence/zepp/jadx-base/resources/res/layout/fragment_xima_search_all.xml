<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/searching_result_album"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="22dp"
            android:paddingEnd="22dp">
            <RelativeLayout
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="9dp">
                <View
                    android:id="@+id/album_red_line"
                    android:background="@color/xima_album_button_text_color"
                    android:layout_width="1.33dp"
                    android:layout_height="14dp"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true"/>
                <TextView
                    android:textSize="@dimen/xima_detail_title_size"
                    android:textColor="@color/xima_category_title_color"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/xima_album"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="4dp"
                    android:layout_toEndOf="@+id/album_red_line"/>
                <TextView
                    android:textSize="@dimen/xima_detail_title_size"
                    android:textColor="@color/xima_graytext_color"
                    android:id="@+id/more_album"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/xima_more"
                    android:drawablePadding="8.5dp"
                    android:layout_centerVertical="true"
                    android:drawableEnd="@drawable/ic_list_item_right_arrow"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/divider_par"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/searching_result_album">
            <View
                android:background="@color/xima_listview_divider_color"
                android:layout_width="match_parent"
                android:layout_height="0.33dp"/>
            <View
                android:id="@+id/divider"
                android:background="@color/xima_category_edit_bg"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="8dp"/>
            <View
                android:background="@color/xima_listview_divider_color"
                android:layout_width="match_parent"
                android:layout_height="0.33dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/searching_result_sound"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/divider_par"
            android:paddingStart="22dp"
            android:paddingEnd="22dp">
            <RelativeLayout
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="9dp">
                <View
                    android:id="@+id/sound_red_line"
                    android:background="@color/xima_album_button_text_color"
                    android:layout_width="1.33dp"
                    android:layout_height="14dp"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true"/>
                <TextView
                    android:textSize="@dimen/xima_detail_title_size"
                    android:textColor="@color/xima_category_title_color"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/xima_sound"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="4dp"
                    android:layout_toEndOf="@+id/sound_red_line"
                    android:layout_alignParentStart="true"/>
                <TextView
                    android:textSize="@dimen/xima_detail_title_size"
                    android:textColor="@color/xima_graytext_color"
                    android:id="@+id/more_sound"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/xima_more"
                    android:drawablePadding="8.5dp"
                    android:layout_centerVertical="true"
                    android:drawableEnd="@drawable/ic_list_item_right_arrow"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
        </LinearLayout>
    </RelativeLayout>
</ScrollView>
