<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s36"
    android:paddingTop="16dp"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="@dimen/tr_font_size_title"
        android:textColor="@color/s1"
        android:gravity="start"
        android:id="@+id/name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="lt-bold"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toStartOf="@+id/tv_end_top"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/TrainingTextSingleLineStyle"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="@dimen/tr_font_size_subtitle"
        android:textColor="@color/s2"
        android:gravity="start"
        android:id="@+id/number"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:fontFamily="lt-bold"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toStartOf="@+id/tv_end_bottom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/name"
        style="@style/TrainingTextSingleLineStyle"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="@dimen/tr_font_size_subtitle"
        android:textColor="@color/s1"
        android:id="@+id/tv_end_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:fontFamily="lt"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/name"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TrainingTextSingleLineStyle"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="@dimen/tr_font_size_subtitle"
        android:textColor="@color/s2"
        android:id="@+id/tv_end_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:fontFamily="lt"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/number"
        app:layout_constraintTop_toBottomOf="@+id/tv_end_top"
        style="@style/TrainingTextSingleLineStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
