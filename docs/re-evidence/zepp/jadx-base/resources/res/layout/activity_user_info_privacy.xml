<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.lib.rainbow.titlebar.RainbowTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/account_ui_person_info_security_and_privacy"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:id="@+id/items_layout"
        android:paddingTop="@dimen/account_ui_size_12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp">
        <com.huami.lib.rainbow.ListTile
            android:id="@+id/item_user_privacy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:ltv_radius_position="top"
            app:ltv_title="@string/user_privacy"/>
        <com.huami.lib.rainbow.ListTile
            android:id="@+id/item_user_agreement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:ltv_title="@string/user_agreement"/>
        <com.huami.lib.rainbow.ListTile
            android:id="@+id/item_user_health_data_agreement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:ltv_title="@string/account_ui_person_info_collection_notification"/>
        <com.huami.lib.rainbow.ListTile
            android:id="@+id/item_user_collected_data_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:ltv_title="@string/account_ui_person_info_collected_list"/>
        <com.huami.lib.rainbow.ListTile
            android:id="@+id/item_user_shared_data_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:ltv_title="@string/account_ui_person_info_shared_list"/>
        <com.huami.lib.rainbow.ListTile
            android:id="@+id/item_user_plan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:ltv_checked="false"
            app:ltv_subtitle="@string/user_plan_sub_title"
            app:ltv_title="@string/user_plan"/>
        <com.huami.lib.rainbow.ListTile
            android:id="@+id/item_exercising_user_rights"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:ltv_radius_position="bottom"
            app:ltv_subtitle="@string/user_data_right_summary"
            app:ltv_title="@string/user_data_right"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</LinearLayout>
