<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="17sp"
        android:textColor="@color/s1"
        android:id="@+id/tip_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="98dp"
        android:text="@string/bind_earbud"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/s2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:text="@string/bind_earbud_tip"
        android:layout_below="@+id/tip_title"
        android:layout_centerHorizontal="true"/>
    <com.xiaomi.hm.health.device.earbud.view.EarbudImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="48dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="21dp"
        android:layout_marginEnd="21dp">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/s1"
            android:gravity="center"
            android:background="@drawable/bg_bind_device_cancel"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:text="@string/parental_authorization_back"
            android:layout_weight="1"
            android:onClick="onBackClick"
            android:layout_marginEnd="21dp"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/p3"
            android:gravity="center"
            android:background="@drawable/bg_bind_device_cancel"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:text="@string/next_step"
            android:layout_weight="1"
            android:onClick="startBind"/>
    </LinearLayout>
</RelativeLayout>
