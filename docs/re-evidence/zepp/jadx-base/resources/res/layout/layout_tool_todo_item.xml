<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/shape_todo_bk"
    android:layout_width="match_parent"
    android:layout_height="68dp"
    android:paddingStart="2dp"
    android:paddingEnd="8dp">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/tool_todo_check"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:src="@drawable/play_todo_not_done"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tool_todo_check"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/play_title_size"
            android:textColor="@color/play_title_color"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/tool_todo_content"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:singleLine="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/play_sub_title_size"
            android:textColor="@color/play_sub_title_color"
            android:ellipsize="end"
            android:id="@+id/tool_todo_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:maxLines="2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/tool_todo_content"
            app:layout_constraintTop_toBottomOf="@+id/tool_todo_content"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
