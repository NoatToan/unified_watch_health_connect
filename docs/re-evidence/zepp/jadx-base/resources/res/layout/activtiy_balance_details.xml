<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:id="@+id/layout_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/ll_bottom"
        android:layout_alignParentTop="true">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <fragment
                android:name="com.xiaomi.hm.health.bodyfat.fragment.BalanceScoreFragment"
                android:id="@+id/score_fragment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <fragment
                android:name="com.xiaomi.hm.health.bodyfat.fragment.BalanceChartFragment"
                android:id="@+id/chart_fragment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <fragment
                android:name="com.xiaomi.hm.health.bodyfat.fragment.BalanceRankFragment"
                android:id="@+id/rank_fragment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"/>
            <include
                android:id="@+id/layout_intro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                layout="@layout/card_status_introduces"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/s2"
                android:gravity="center"
                android:id="@+id/tx_no_score"
                android:background="@color/s38"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="156dp"
                android:layout_marginTop="10dp"
                android:text="@string/oft_has_no_data"/>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/ll_bottom"
        android:background="@color/s38"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <RelativeLayout
            android:id="@+id/measure_ll"
            android:background="@color/s38"
            android:layout_width="wrap_content"
            android:layout_height="66dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">
            <ImageView
                android:id="@+id/measure_iv"
                android:layout_width="33.3dp"
                android:layout_height="33.3dp"
                android:layout_marginTop="11dp"
                android:src="@drawable/weight_detail_zoomout"
                android:scaleType="centerInside"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="9.3sp"
                android:textColor="@color/s2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4.7dp"
                android:text="@string/measure"
                android:layout_below="@+id/measure_iv"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/guest_ll"
            android:background="@color/s38"
            android:layout_width="wrap_content"
            android:layout_height="66dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">
            <ImageView
                android:id="@+id/guest_iv"
                android:layout_width="33.3dp"
                android:layout_height="33.3dp"
                android:layout_marginTop="11dp"
                android:src="@drawable/guest_selector"
                android:scaleType="centerInside"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="9.3sp"
                android:textColor="@color/s2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4.7dp"
                android:text="@string/guest"
                android:layout_below="@+id/guest_iv"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/delete_ll"
            android:background="@color/s38"
            android:layout_width="wrap_content"
            android:layout_height="66dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">
            <ImageView
                android:id="@+id/delete_iv"
                android:layout_width="33.3dp"
                android:layout_height="33.3dp"
                android:layout_marginTop="11dp"
                android:src="@drawable/delete_selector"
                android:scaleType="centerInside"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="9.3sp"
                android:textColor="@color/s2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4.7dp"
                android:text="@string/delete_weight"
                android:layout_below="@+id/delete_iv"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
    </LinearLayout>
</RelativeLayout>
