<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/constraintLayout"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/title_view"
        android:background="@color/s38"
        android:layout_width="match_parent"
        android:layout_height="48dp">
        <ImageButton
            android:id="@+id/ib_back"
            android:background="@null"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_arrow_back_20_2x"
            android:backgroundTint="@color/s1"/>
        <TextView
            android:textSize="17sp"
            android:textColor="@color/s1"
            android:id="@+id/text_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_choose_body_measure_mode"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <com.huami.lib.rainbow.ListTile
        android:id="@+id/iv_gender"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:ltv_divider_padding="all"
        app:ltv_tips="@string/user_add_guest_select"
        app:ltv_title="@string/person_info_key_gender"
        app:ltv_trailing="@drawable/ic_arrow_forward_20_2x"/>
    <com.huami.lib.rainbow.ListTile
        android:id="@+id/iv_height"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:ltv_divider_padding="all"
        app:ltv_tips="@string/user_add_guest_select"
        app:ltv_title="@string/person_info_key_height"
        app:ltv_trailing="@drawable/ic_arrow_forward_20_2x"/>
    <com.huami.lib.rainbow.ListTile
        android:id="@+id/iv_birth"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:ltv_divider_padding="all"
        app:ltv_tips="@string/user_add_guest_select"
        app:ltv_title="@string/person_info_key_birth"
        app:ltv_trailing="@drawable/ic_arrow_forward_20_2x"/>
    <com.huami.lib.rainbow.ListTile
        android:id="@+id/iv_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:ltv_divider_padding="all"
        app:ltv_tips="@string/user_add_guest_select"
        app:ltv_title="@string/title_choose_body_measure_mode"
        app:ltv_trailing="@drawable/ic_arrow_forward_20_2x"/>
    <View
        android:id="@+id/divider"
        style="@style/VerticalDivider"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/s2"
        android:id="@+id/label"
        android:paddingTop="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/please_input_guest_info_correct"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"/>
    <LinearLayout
        android:gravity="bottom|center_horizontal"
        android:id="@+id/bottom_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="24dp"
        android:layout_weight="1"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp">
        <TextView
            android:enabled="false"
            android:textSize="14sp"
            android:textColor="@drawable/round_btn_text_color_selector"
            android:gravity="center"
            android:id="@+id/tx_body_fat"
            android:background="@drawable/common_corner_rect"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginTop="4.7dp"
            android:text="@string/start_measure"
            android:lines="1"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
