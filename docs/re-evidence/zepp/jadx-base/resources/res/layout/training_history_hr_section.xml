<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/hr_heart_section_ll"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp">
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/black70"
        android:gravity="center_horizontal"
        android:paddingTop="23dp"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="@string/heart_section"/>
    <com.huami.widget.colorbar.ColorBarView
        android:id="@+id/hr_color_bar"
        android:layout_width="match_parent"
        android:layout_height="7dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"/>
    <com.huami.widget.hrsection.HeartRateSectionView
        android:id="@+id/hr_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
