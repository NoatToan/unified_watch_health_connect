<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.lib.rainbow.titlebar.RainbowTitleBar
        android:id="@+id/title_bar"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationTint="@color/s46"
        app:statusBarMode="dark"/>
    <ScrollView
        android:id="@+id/reminder_scroll_view"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/size_10dp"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@+id/reminder_save"
        app:layout_constraintTop_toBottomOf="@+id/title_bar"
        app:layout_constraintVertical_weight="1">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include
                android:id="@+id/reminder_notification"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/size_14dp"
                android:layout_marginEnd="@dimen/size_14dp"
                layout="@layout/sky_layout_reminder_notification"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="20sp"
                android:textColor="@color/s46"
                android:id="@+id/reminder_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_30dp"
                android:text="@string/sky_reminder_title"
                android:layout_marginStart="@dimen/size_20dp"
                android:layout_marginEnd="@dimen/size_20dp"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="14sp"
                android:id="@+id/reminder_sub_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_5dp"
                android:text="@string/sky_reminder_detail"
                android:layout_marginStart="@dimen/size_20dp"
                android:layout_marginEnd="@dimen/size_20dp"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="16sp"
                android:textColor="@color/s46"
                android:id="@+id/reminder_repeat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_20dp"
                android:text="@string/sky_reminder_repeat"
                android:layout_marginStart="@dimen/size_20dp"
                android:layout_marginEnd="@dimen/size_20dp"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/reminder_repeat_recycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_20dp"
                android:layout_marginStart="@dimen/size_20dp"
                android:layout_marginEnd="@dimen/size_20dp"/>
            <View
                android:background="@color/s45"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_1dp"
                android:layout_marginTop="@dimen/size_20dp"
                android:layout_marginStart="@dimen/size_20dp"
                android:layout_marginEnd="@dimen/size_20dp"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="16sp"
                android:textColor="@color/s46"
                android:id="@+id/reminder_select_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_20dp"
                android:text="@string/sky_reminder_timesetting"
                android:layout_marginStart="@dimen/size_20dp"
                android:layout_marginEnd="@dimen/size_20dp"/>
            <include
                android:id="@+id/reminder_select_time_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                layout="@layout/sky_layout_reminder_time"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </ScrollView>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="16sp"
        android:textColor="@color/s46"
        android:gravity="center"
        android:id="@+id/reminder_save"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_50dp"
        android:layout_marginBottom="@dimen/size_10dp"
        android:text="@string/sky_reminder_remind"
        android:layout_marginStart="@dimen/size_20dp"
        android:layout_marginEnd="@dimen/size_20dp"
        app:layout_constraintBottom_toTopOf="@+id/reminder_set_later"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="16sp"
        android:gravity="center"
        android:id="@+id/reminder_set_later"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_50dp"
        android:layout_marginBottom="@dimen/size_30dp"
        android:text="@string/sky_reminder_later"
        android:layout_marginStart="@dimen/size_20dp"
        android:layout_marginEnd="@dimen/size_20dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
