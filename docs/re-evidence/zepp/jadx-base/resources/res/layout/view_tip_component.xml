<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@color/s38"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:paddingStart="26dp"
        android:paddingEnd="@dimen/common_item_padding">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/tip_icon"
                android:visibility="gone"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginTop="17dp"
                android:layout_marginBottom="17dp"/>
            <FrameLayout
                android:id="@+id/loading_parent"
                android:background="@drawable/shape_loading_origin_bg"
                android:visibility="gone"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_marginTop="17dp"
                android:layout_marginBottom="17dp">
                <com.huami.lib.view.widget.LoadingView
                    android:layout_gravity="center"
                    android:id="@+id/loading_view"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    app:stroke="2dp"/>
            </FrameLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:layout_marginStart="10dp">
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/s31"
                    android:id="@+id/tip_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textDirection="locale"
                    android:textAlignment="gravity"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/s2"
                    android:gravity="start"
                    android:id="@+id/tip_sub_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2.7dp"
                    android:textDirection="locale"
                    android:textAlignment="gravity"
                    style="@style/dialogMessageStyle"/>
            </LinearLayout>
        </LinearLayout>
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="end|center_vertical"
                android:id="@+id/tip_action_icon"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <View
                android:layout_gravity="end|center_vertical"
                android:id="@+id/divider_vertical"
                android:background="@color/divide"
                android:visibility="visible"
                android:layout_width="@dimen/divider"
                android:layout_height="32dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="40dp"/>
        </FrameLayout>
    </LinearLayout>
    <View
        android:id="@+id/divider"
        android:background="#19000000"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider"/>
    <View
        android:id="@+id/bottom_area"
        android:background="@color/s38"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="8dp"/>
</LinearLayout>
