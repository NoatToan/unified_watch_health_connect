<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/share_sheet_item_width"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/share_icon"
            android:layout_width="@dimen/share_sheet_item_size"
            android:layout_height="@dimen/share_sheet_item_size"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/s1"
            android:layout_gravity="center_horizontal"
            android:id="@+id/share_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/share_sheet_item_margin_top"/>
    </LinearLayout>
</FrameLayout>
