<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/gps_signal_info_window_bg"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.huami.moving.ui.view.GpsSignalView
        android:layout_gravity="center"
        android:id="@+id/gps_signal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#fe5e17"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/gps_not_work_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/gps_no_permission"
        android:drawablePadding="5dp"
        android:drawableEnd="@drawable/ic_arrow_orange"/>
</FrameLayout>
