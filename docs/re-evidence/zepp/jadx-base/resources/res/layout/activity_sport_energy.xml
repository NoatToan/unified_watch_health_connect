<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#f8f8f8"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/sport_energy_radio_rl"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <RadioGroup
            android:orientation="horizontal"
            android:id="@+id/sport_energy_radio"
            android:background="@android:color/white"
            android:paddingBottom="7.9dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8.7dp"
            android:layout_centerHorizontal="true">
            <RadioButton
                android:id="@+id/sport_energy_day"
                android:checked="true"
                android:text="@string/statistics_day"
                android:drawableTop="@drawable/selector_sport_energy_day"
                style="@style/SportEnergyTab"/>
            <RadioButton
                android:id="@+id/sport_energy_week"
                android:layout_marginLeft="50dp"
                android:layout_marginRight="50dp"
                android:text="@string/statistics_week"
                android:drawableTop="@drawable/selector_sport_energy_week"
                android:layout_weight="1"
                style="@style/SportEnergyTab"/>
            <RadioButton
                android:id="@+id/sport_energy_month"
                android:text="@string/statistics_month"
                android:drawableTop="@drawable/selector_sport_energy_month"
                style="@style/SportEnergyTab"/>
        </RadioGroup>
    </RelativeLayout>
    <View
        android:id="@+id/sport_energy_divide"
        android:background="#eeeeee"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        app:layout_constraintBottom_toTopOf="@+id/sport_energy_radio_rl"/>
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/sport_energy_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/sport_energy_divide"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
