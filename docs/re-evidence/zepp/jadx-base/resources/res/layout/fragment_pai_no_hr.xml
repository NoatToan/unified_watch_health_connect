<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="15dp"
    android:layout_marginEnd="15dp">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/pai_value_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toStartOf="@+id/pai_progress_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.huami.widget.typeface.TypefaceTextView
            android:textColor="@color/pai_low_hr"
            android:gravity="start|center_vertical"
            android:id="@+id/pai_progress_value_l"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:text="@string/pai_progress_value"
            style="@style/Rainbow.TextAppearance.Body5"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textColor="@color/pai_mid_hr"
            android:gravity="start|center_vertical"
            android:id="@+id/pai_progress_value_m"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:text="@string/pai_progress_value"
            style="@style/Rainbow.TextAppearance.Body5"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textColor="@color/pai_high_hr"
            android:gravity="start|center_vertical"
            android:id="@+id/pai_progress_value_h"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:text="@string/pai_progress_value"
            style="@style/Rainbow.TextAppearance.Body5"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/pai_progress_container"
        android:layout_width="0dp"
        android:layout_height="90dp"
        android:minWidth="20dp"
        android:layout_marginStart="7dp"
        app:layout_constraintEnd_toStartOf="@+id/pai_hint_container"
        app:layout_constraintStart_toEndOf="@+id/pai_value_container"
        app:layout_constraintTop_toTopOf="parent">
        <ProgressBar
            android:id="@+id/pai_progress_l"
            android:layout_width="match_parent"
            android:layout_height="6.7dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:progress="20"
            android:progressDrawable="@drawable/pai_progress_l"
            android:layout_centerVertical="true"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"/>
        <ProgressBar
            android:id="@+id/pai_progress_m"
            android:layout_width="match_parent"
            android:layout_height="6.7dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:progress="30"
            android:progressDrawable="@drawable/pai_progress_m"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"/>
        <ProgressBar
            android:id="@+id/pai_progress_h"
            android:layout_width="match_parent"
            android:layout_height="6.7dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:progress="50"
            android:progressDrawable="@drawable/pai_progress_h"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/pai_hint_container"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="10dp"
        app:layout_constraintEnd_toStartOf="@+id/pai_time_container"
        app:layout_constraintStart_toEndOf="@+id/pai_progress_container"
        app:layout_constraintTop_toTopOf="parent">
        <com.huami.widget.typeface.TypefaceTextView
            android:textColor="@color/pai_low_hr"
            android:gravity="start|center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:text="@string/pai_progress_l"
            android:layout_toEndOf="@+id/pai_progress_l"
            app:layout_constraintEnd_toStartOf="@+id/pai_time_l"
            app:layout_constraintStart_toEndOf="@+id/pai_progress_l"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Rainbow.TextAppearance.Body5"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textColor="@color/pai_mid_hr"
            android:gravity="start|center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:text="@string/pai_progress_m"
            style="@style/Rainbow.TextAppearance.Body5"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textColor="@color/pai_high_hr"
            android:gravity="start|center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:text="@string/pai_progress_h"
            style="@style/Rainbow.TextAppearance.Body5"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/pai_time_container"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="29dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/pai_hint_container"
        app:layout_constraintTop_toTopOf="parent">
        <com.huami.widget.typeface.TypefaceTextView
            android:textColor="@color/s1"
            android:gravity="start|center_vertical"
            android:id="@+id/pai_time_l"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:text="0小时0分"
            style="@style/Rainbow.TextAppearance.Body5"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textColor="@color/s1"
            android:gravity="start|center_vertical"
            android:id="@+id/pai_time_m"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:text="0小时0分"
            style="@style/Rainbow.TextAppearance.Body5"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textColor="@color/s1"
            android:gravity="start|center_vertical"
            android:id="@+id/pai_time_h"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:text="0小时0分"
            style="@style/Rainbow.TextAppearance.Body5"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
