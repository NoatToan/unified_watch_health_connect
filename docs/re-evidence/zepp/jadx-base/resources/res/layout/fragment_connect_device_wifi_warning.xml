<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/s39"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="14sp"
        android:textColor="@color/s1"
        android:gravity="start"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="10dp"
        android:text="@string/file_manager_connect_ap_warning_content"
        android:paddingStart="23dp"
        android:paddingEnd="23dp"/>
    <CheckBox
        android:textSize="14sp"
        android:textColor="@color/s2"
        android:id="@+id/chkbox_block"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:checked="true"
        android:button="@drawable/ap_warning_checkbox_style"
        android:text="@string/file_manager_connect_ap_warning_block"
        android:paddingStart="5dp"
        android:layout_marginStart="23dp"
        android:buttonTint="@color/ftp_file_check_selectot_tint"/>
</LinearLayout>
