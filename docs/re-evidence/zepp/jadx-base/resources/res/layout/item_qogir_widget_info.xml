<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="64dp">
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/dot_or_menu"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_widget_menu"
        android:layout_centerVertical="true"
        android:layout_marginStart="23.3dp"/>
    <ImageView
        android:id="@+id/icon"
        android:background="@drawable/border_app_icon"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_centerVertical="true"
        android:layout_marginStart="21dp"
        android:layout_toEndOf="@+id/dot_or_menu"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#e6000000"
        android:id="@+id/text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="20.3dp"
        android:layout_toEndOf="@+id/icon"/>
    <Switch
        android:id="@+id/enable_widget"
        android:focusable="false"
        android:layout_width="wrap_content"
        android:layout_height="18.3dp"
        android:textOn=""
        android:textOff=""
        android:layout_centerVertical="true"
        android:layout_marginEnd="20.4dp"
        android:layout_alignParentEnd="true"
        style="@style/WatchSwitch"/>
    <View
        android:background="#14000000"
        android:layout_width="match_parent"
        android:layout_height="0.7dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="60dp"
        android:layout_marginEnd="20dp"/>
</RelativeLayout>
