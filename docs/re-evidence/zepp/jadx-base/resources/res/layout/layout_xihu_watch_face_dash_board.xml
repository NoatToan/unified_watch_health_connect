<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:layout_width="153dp"
    android:layout_height="153dp">
    <ImageView
        android:id="@+id/iv_watch_face"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/watch_face_edit_dash_board_bg"/>
    <com.huami.watch.companion.watchface.view.ClipImageView
        android:id="@+id/iv_left_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        app:clipStart="left_top"
        app:divideHeight="2"
        app:divideWidth="2"
        app:src="@drawable/xihu_watch_face_schedule_circle"/>
    <com.huami.watch.companion.watchface.view.ClipImageView
        android:id="@+id/iv_right_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        app:clipStart="right_top"
        app:divideHeight="2"
        app:divideWidth="2"
        app:src="@drawable/xihu_watch_face_schedule_circle"/>
    <TextView
        android:textSize="8sp"
        android:textColor="#fff"
        android:id="@+id/tv_center_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="29.7dp"
        android:text="研发部九点开会"
        android:layout_centerHorizontal="true"/>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="52.2dp"
        android:src="@drawable/xihu_watch_face_dash_board_weather"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
    <ImageView
        android:id="@+id/iv_left_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18.9dp"
        android:src="@drawable/xihu_watch_face_alarm"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="25.6dp"
        android:layout_alignParentStart="true"/>
    <ImageView
        android:id="@+id/iv_center_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8.8dp"
        android:src="@drawable/xihu_watch_face_alarm"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
    <ImageView
        android:id="@+id/iv_right_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18.9dp"
        android:src="@drawable/xihu_watch_face_alarm"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="25.6dp"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
