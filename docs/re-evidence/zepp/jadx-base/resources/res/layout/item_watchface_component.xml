<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/layout_expand"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="54.7dp"
        android:paddingStart="23dp"
        android:paddingEnd="23dp">
        <TextView
            android:textSize="13.4dp"
            android:textColor="#e6000000"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/tv_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="快捷组件-上"/>
        <TextView
            android:textSize="13.4dp"
            android:textColor="#191919"
            android:layout_gravity="end|center_vertical"
            android:id="@+id/tv_select_widget"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="天气"
            android:drawablePadding="5.6dp"
            android:layout_marginEnd="23dp"/>
        <ImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/iv_arrow"
            android:layout_width="17.3dp"
            android:layout_height="17.3dp"
            android:src="@drawable/arrow_down"/>
        <View
            android:layout_gravity="bottom"
            android:background="#f4f5f7"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/layout_widget"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="23dp"
        android:paddingEnd="23dp">
        <View
            android:layout_gravity="center_vertical"
            android:id="@+id/center_bg"
            android:background="#f4f4f4"
            android:layout_width="match_parent"
            android:layout_height="48dp"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.huami.widget.wheelview.WheelView
                android:id="@+id/left_wheel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <com.huami.widget.wheelview.WheelView
                android:id="@+id/right_wheel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
