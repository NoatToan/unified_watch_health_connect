<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:padding="15dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/hr_icon"
        android:layout_centerVertical="true"
        style="@style/HeartRateIconStyle"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="16sp"
        android:textColor="#000000"
        android:id="@+id/hr_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="km"
        android:layout_marginStart="15dp"
        android:layout_toEndOf="@+id/hr_icon"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#99000000"
        android:id="@+id/hr_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_below="@+id/hr_value"
        android:layout_alignStart="@+id/hr_value"/>
    <TextView
        android:textSize="16sp"
        android:textColor="#000000"
        android:id="@+id/hr_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/heart_rate_unit_hr"
        android:layout_alignBaseline="@+id/hr_value"
        android:layout_marginStart="3dp"
        android:layout_toEndOf="@+id/hr_value"/>
    <ImageView
        android:id="@+id/right_arrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_arrow_right"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
