<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <SurfaceView
        android:id="@+id/capture_preview_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.huami.android.zxing.ViewfinderView
        android:id="@+id/capture_find_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cornerColor="@color/color_primary"
        app:scannerColor="@color/color_primary"/>
    <TextView
        android:textSize="17sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/capture_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="41.5dp"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/capture_tips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4.2dp"
        android:layout_below="@+id/capture_title"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_no_qr_code"
        android:background="@drawable/capture_device_btn"
        android:clickable="true"
        android:layout_width="301.2969dp"
        android:layout_height="60dp"
        android:layout_marginBottom="72dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:paddingStart="50dp"
        android:paddingEnd="50dp"/>
    <RelativeLayout
        android:layout_width="301.2969dp"
        android:layout_height="60dp"
        android:layout_marginBottom="72dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true">
        <androidx.appcompat.widget.AppCompatImageView
            android:background="@drawable/qrcode_right_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tint="@color/white"
            android:layout_centerVertical="true"
            android:layout_marginEnd="18.3dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/white"
        android:id="@+id/capture_quit"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="36dp"
        android:text="@string/cancel"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
