<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_small_tool_sort_0"
    android:background="@color/s36"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/header"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="43dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageButton
            android:layout_gravity="start|center_vertical"
            android:id="@+id/btn_back"
            android:tag="binding_1"
            android:background="@null"
            android:padding="14dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_arrow_back_20"
            app:tint="@color/s1"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/s1"
            android:gravity="center"
            android:id="@+id/btn_cancel"
            android:tag="binding_2"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/cancel"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"/>
        <TextView
            android:textAppearance="@style/Rainbow.TextAppearance.Title3"
            android:textSize="16sp"
            android:textColor="@color/s1"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/small_tool_my_tools"
            android:transitionName="SmallToolTitle"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/s1"
            android:gravity="center_vertical"
            android:layout_gravity="end|center_vertical"
            android:id="@+id/btn_edit"
            android:tag="binding_3"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/edit"
            android:paddingStart="@dimen/size_14dp"
            android:paddingEnd="@dimen/size_14dp"
            app:drawableStartCompat="@drawable/ic_sort_20"
            app:drawableTint="@color/s1"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/p4"
            android:gravity="center"
            android:layout_gravity="end|center_vertical"
            android:id="@+id/btn_finish"
            android:tag="binding_4"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/done"
            android:layout_marginEnd="14dp"/>
    </FrameLayout>
    <View
        android:id="@+id/divider"
        android:background="@color/s4"
        android:layout_width="match_parent"
        android:layout_height="1px"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view"
        android:tag="binding_5"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider"/>
</androidx.constraintlayout.widget.ConstraintLayout>
