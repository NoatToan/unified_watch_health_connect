<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="18sp"
        android:textColor="@color/s1"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="@dimen/account_ui_startup_unify_title_height"
        android:text="@string/account_ui_startup_unify_title"/>
    <View
        android:background="@color/s4"
        android:layout_width="match_parent"
        android:layout_height="@dimen/account_ui_divider_width"/>
    <ScrollView
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="@dimen/account_ui_startup_scroller_height"
        android:overScrollMode="never"
        android:layout_marginStart="@dimen/account_ui_startup_unify_margin_horizontal"
        android:layout_marginEnd="@dimen/account_ui_startup_unify_margin_horizontal">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/s1"
            android:id="@+id/tv_agreement_unify_content"
            android:padding="@dimen/account_ui_startup_up_content_padding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/account_ui_startup_unify_content"
            android:lineSpacingExtra="2dp"/>
    </ScrollView>
    <View
        android:background="@color/s4"
        android:layout_width="match_parent"
        android:layout_height="@dimen/account_ui_divider_width"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/account_ui_white"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_agree"
        android:background="@drawable/account_ui_btn_bg_login"
        android:layout_width="match_parent"
        android:layout_height="@dimen/account_ui_startup_unify_btn_height"
        android:layout_marginTop="@dimen/account_ui_size_16dp"
        android:text="@string/account_ui_agree"
        android:layout_marginStart="@dimen/account_ui_startup_unify_btn_margin_horizontal"
        android:layout_marginEnd="@dimen/account_ui_startup_unify_btn_margin_horizontal"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/s1"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/tv_disagree"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/account_ui_size_16dp"
        android:layout_marginBottom="@dimen/size_20dp"
        android:text="@string/account_ui_startup_unify_disagree"/>
</LinearLayout>
