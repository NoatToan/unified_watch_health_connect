<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.huami.lib.rainbow.titlebar.RainbowTitleBar
        android:id="@+id/title_bar"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationTint="@color/s46"
        app:statusBarMode="dark"
        app:title="@string/sky_realtime_title"
        app:titleTextColor="@color/s46"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_bar"
        app:layout_constraintVertical_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/layout_sky_realtime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="18sp"
                android:textColor="@color/s46"
                android:id="@+id/sky_realtime_relax_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sky_realtimeData_relaxIndex"
                android:layout_marginStart="@dimen/size_20dp"
                android:layout_marginEnd="@dimen/size_20dp"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="40sp"
                android:textColor="@color/s46"
                android:gravity="center"
                android:id="@+id/sky_realtime_relax"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sky_realtimeData_empty"
                android:layout_marginStart="@dimen/size_20dp"
                android:layout_marginEnd="@dimen/size_20dp"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="14sp"
                android:textColor="@color/s46"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/sky_realtime_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginStart="@dimen/size_20dp"
                android:layout_marginEnd="@dimen/size_20dp"/>
            <FrameLayout
                android:id="@+id/sky_relax_chart_layout"
                android:layout_width="match_parent"
                android:layout_height="180dp"/>
            <include
                android:id="@+id/relax_chart_no_data_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                layout="@layout/sky_layout_realtime_chart_nodata"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="14sp"
                android:textColor="@color/s46"
                android:id="@+id/sky_realtime_tips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/sky_realtimeData_RIdetail"
                android:layout_marginStart="@dimen/size_20dp"
                android:layout_marginEnd="@dimen/size_20dp"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="18sp"
                android:textColor="@color/s46"
                android:id="@+id/sky_realtime_tag"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_45dp"
                android:text="@string/sky_realtimeData_playing"
                android:layout_marginStart="@dimen/size_20dp"
                android:layout_marginEnd="@dimen/size_20dp"/>
            <androidx.recyclerview.widget.RecyclerView
                android:layout_gravity="center"
                android:id="@+id/sky_realtime_tag_recycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_20dp"
                android:layout_marginStart="@dimen/size_20dp"
                android:layout_marginEnd="@dimen/size_20dp"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="14sp"
                android:textColor="@color/s46"
                android:id="@+id/sky_realtime_illustrate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_50dp"
                android:layout_marginBottom="@dimen/size_40dp"
                android:text="@string/sky_realtime_illustrate"
                android:layout_marginStart="@dimen/size_20dp"
                android:layout_marginEnd="@dimen/size_20dp"
                app:drawableTint="@color/s46"/>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
