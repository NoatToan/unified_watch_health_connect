<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.watch.companion.ui.view.ClipZoomImageView
        android:id="@+id/zoom_image"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.huami.watch.companion.ui.view.ClipCircleBorderView
        android:id="@+id/border_view"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/white_text"
        android:gravity="center"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="46.3dp"
        android:layout_marginTop="44dp"
        android:text="@string/move_and_clip"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:background="@color/bg_clip_btn"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="56dp">
        <TextView
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/cancel"
            android:background="@drawable/bg_clip_button"
            android:layout_width="90dp"
            android:layout_height="32dp"
            android:text="@string/btn_cancel"
            android:layout_marginStart="12dp"/>
        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <TextView
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/finish_clipping"
            android:background="@drawable/bg_clip_button"
            android:layout_width="90dp"
            android:layout_height="32dp"
            android:text="@string/watch_face_select"
            android:layout_marginEnd="12dp"/>
    </LinearLayout>
</merge>
