<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/card_status"
    android:background="@color/s38"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/card_status_dividing_line"
        android:background="@color/s4"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="10dp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/s1"
        android:id="@+id/card_status_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"/>
    <com.xiaomi.hm.health.bodyfat.view.SDAdaptiveTextView
        android:textSize="12sp"
        android:textColor="@color/s1"
        android:id="@+id/card_status_introduce"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15.3dp"
        android:layout_marginBottom="20dp"
        android:lineSpacingExtra="5.3sp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"/>
    <View
        android:background="@color/s4"
        android:layout_width="match_parent"
        android:layout_height="0dp"/>
</LinearLayout>
