<?xml version="1.0" encoding="utf-8"?>
<com.huami.lib.view.scroll.HMScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/blue_monkey_setting_scrollview"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:orientation="vertical"
        android:background="@color/view_base_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.huami.lib.view.scroll.HMExpandHeadView
            android:id="@+id/blue_monkey_setting_battery_rl"
            android:background="@drawable/img_blue_monkey_bg"
            android:layout_width="match_parent"
            android:layout_height="246dp">
            <RelativeLayout
                android:id="@+id/blue_monkey_setting_battery_chart_rl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="98dp">
                <ImageView
                    android:id="@+id/disconnected_img"
                    android:visibility="gone"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_marginTop="4dp"
                    android:src="@drawable/img_x"
                    android:layout_centerHorizontal="true"/>
                <ImageView
                    android:id="@+id/battery_img"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"/>
                <com.huami.widget.typeface.TypefaceTextView
                    android:textSize="15sp"
                    android:textColor="@color/white"
                    android:id="@+id/battery_level"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:fontFamily="din-med"/>
            </RelativeLayout>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/white"
                android:id="@+id/battery_tips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_below="@+id/blue_monkey_setting_battery_chart_rl"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="11.3sp"
                android:textColor="#99ffffff"
                android:id="@+id/low_battery_tips"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="@string/mili_setting_low_battery"
                android:layout_below="@+id/battery_tips"
                android:layout_centerHorizontal="true"/>
        </com.huami.lib.view.scroll.HMExpandHeadView>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/blue_monkey_setting_battery_rl">
            <FrameLayout
                android:id="@+id/container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <View
                android:background="@color/split_color"
                android:layout_width="match_parent"
                android:layout_height="1px"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/item_layout"
                android:background="@color/view_base_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.xiaomi.hm.health.baseui.widget.ItemView
                    android:id="@+id/fw_version"
                    android:background="@color/white100"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:itemEndArrow="false"
                    app:itemTitle="@string/mili_setting_fw_version"/>
                <com.xiaomi.hm.health.baseui.widget.ItemView
                    android:id="@+id/mac_address"
                    android:background="@color/white100"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:itemEndArrow="false"
                    app:itemTitle="@string/mili_setting_mac_address"/>
                <com.xiaomi.hm.health.baseui.widget.ItemView
                    android:id="@+id/bm_setting_firmware_upgrade"
                    android:background="@color/white100"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:itemDivider="gone"
                    app:itemEndArrow="true"
                    app:itemTitle="@string/setting_update"/>
                <View
                    android:background="@color/divide"
                    android:layout_width="match_parent"
                    android:layout_height="0.33dp"/>
            </LinearLayout>
        </LinearLayout>
        <Button
            android:id="@+id/unbind_btn"
            android:layout_width="match_parent"
            android:layout_marginBottom="24dp"
            android:text="@string/mili_setting_unbind"
            android:layout_alignParentBottom="true"
            style="@style/unbindDevicesStyle"/>
    </RelativeLayout>
</com.huami.lib.view.scroll.HMScrollView>
