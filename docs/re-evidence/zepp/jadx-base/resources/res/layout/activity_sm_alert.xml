<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:huami="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.huami.lib.view.widget.TipComponent
        android:id="@+id/tip_sms_per"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.huami.lib.rainbow.ListTile
        android:id="@+id/sm_enable"
        android:background="@color/s10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        huami:ltv_checked="true"
        huami:ltv_subtitle="@string/enable_sm_alert_tips"
        huami:ltv_title="@string/enable_sm_alert"/>
    <com.huami.lib.rainbow.ListTile
        android:id="@+id/vibrate_mode_iv"
        android:background="@color/s10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        huami:ltv_tips="@string/custom_vibrate_mode_default"
        huami:ltv_title="@string/custom_vibrate_mode"/>
    <com.huami.lib.rainbow.ListTile
        android:id="@+id/sm_strange"
        android:background="@color/s10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        huami:ltv_checked="true"
        huami:ltv_title="@string/strange_number_tips"/>
    <com.huami.lib.rainbow.ListTile
        android:id="@+id/sm_contact"
        android:background="@color/s10"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        huami:ltv_checked="true"
        huami:ltv_subtitle="@string/show_sms_info_summary"
        huami:ltv_title="@string/show_contact_info_tips"/>
</LinearLayout>
