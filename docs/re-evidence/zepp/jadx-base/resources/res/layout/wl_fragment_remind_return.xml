<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="start"
    android:orientation="vertical"
    android:background="@color/s36"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:paddingStart="@dimen/common_item_padding"
        android:paddingEnd="@dimen/common_item_padding">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="@color/s2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_18dp"
                android:text="@string/wl_return_card_notice"
                style="@style/TextAppearance.MiFit.Title3.Inverse"/>
            <TextView
                android:textColor="@color/s2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_18dp"
                android:text="@string/wl_return_card_notice_info"
                style="@style/TextAppearance.MiFit.Title.Inverse"/>
            <View
                android:background="@color/s4"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_0.5dp"
                android:layout_marginTop="@dimen/size_18dp"/>
            <TextView
                android:textColor="@color/s2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_18dp"
                android:text="@string/wl_return_card_reason"
                style="@style/TextAppearance.MiFit.Title3.Inverse"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/return_reason_radio_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_18dp"
                android:layout_marginStart="@dimen/size_36dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
        </LinearLayout>
    </ScrollView>
    <Button
        android:enabled="false"
        android:id="@+id/return_card_button"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="18dp"
        android:text="@string/wl_return_card"
        android:layout_marginStart="@dimen/wl_border_margin"
        android:layout_marginEnd="@dimen/wl_border_margin"
        style="@style/Rainbow.Widget.Button.44.Circular"/>
</LinearLayout>
