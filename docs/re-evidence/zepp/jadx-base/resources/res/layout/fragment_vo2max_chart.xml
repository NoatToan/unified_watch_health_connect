<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/vo2max_status_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">
        <TextView
            android:textColor="@color/s1"
            android:gravity="bottom|center_horizontal"
            android:id="@+id/status_info"
            android:paddingBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            style="@style/Rainbow.TextAppearance.Body4"/>
        <com.huami.watch.companion.ui.view.HuaMiFontTextView
            android:textSize="24sp"
            android:textColor="@color/s1"
            android:gravity="center"
            android:id="@+id/status_value"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"/>
        <TextView
            android:textColor="@color/s2"
            android:gravity="bottom|center_horizontal"
            android:paddingBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/vo2max_unit"
            android:layout_marginStart="4dp"
            style="@style/Rainbow.TextAppearance.Body5"/>
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="200dp">
        <com.huami.watch.dataflow.chart.StatisticChartView
            android:id="@+id/chart"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"/>
        <TextView
            android:textColor="@color/s3"
            android:layout_gravity="center"
            android:id="@+id/tv_no_data"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="@string/wl_no_data"
            style="@style/Rainbow.TextAppearance.Body5"/>
    </FrameLayout>
</LinearLayout>
