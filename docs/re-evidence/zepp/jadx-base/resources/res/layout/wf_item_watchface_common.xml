<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/wf_item_common_bg"
    android:layout_width="130dp"
    android:layout_height="177dp"
    android:layout_marginEnd="10dp">
    <ImageView
        android:id="@+id/thumbnail_img_shadow"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_marginTop="10dp"
        android:src="@drawable/wf_watch_face_circle_shadow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/thumbnail_img"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="@+id/thumbnail_img_shadow"
        app:layout_constraintEnd_toEndOf="@+id/thumbnail_img_shadow"
        app:layout_constraintStart_toStartOf="@+id/thumbnail_img_shadow"
        app:layout_constraintTop_toTopOf="@+id/thumbnail_img_shadow"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/wf_text_light_white"
        android:gravity="center"
        android:id="@+id/tv_new_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:singleLine="true"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/thumbnail_img"/>
    <TextView
        android:textColor="@color/wf_color_price"
        android:id="@+id/price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_new_name"/>
    <RatingBar
        android:id="@+id/rating_bar"
        android:layout_marginTop="5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_new_name"
        style="@style/WFRatingBar"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/wf_light_white"
        android:id="@+id/tv_update"
        android:background="@drawable/wf_update_bg"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/wf_has_update"
        android:paddingStart="7dp"
        android:paddingEnd="7dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
