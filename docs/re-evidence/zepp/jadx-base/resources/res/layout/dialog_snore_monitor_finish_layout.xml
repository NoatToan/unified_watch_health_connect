<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        app:layout_constraintBottom_toTopOf="@+id/imageView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/imageView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"
        app:srcCompat="@drawable/snore_finish_dialog_bg"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/imageView"
        app:layout_constraintGuide_percent="0.5"
        app:layout_constraintTop_toTopOf="@+id/imageView"/>
    <TextView
        android:textSize="35sp"
        android:textColor="@color/s25"
        android:id="@+id/monitorTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/guideline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/imageView"
        app:layout_constraintVertical_bias="1"/>
    <TextView
        android:textSize="@dimen/snore_common_text_size"
        android:textColor="@color/s25"
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/snore_monitor_total_time"
        app:layout_constraintBottom_toBottomOf="@+id/imageView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/guideline"
        app:layout_constraintVertical_bias="0"/>
    <View
        android:id="@+id/line"
        android:background="@color/s4"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginTop="28dp"
        app:layout_constraintTop_toBottomOf="@+id/imageView"/>
    <TextView
        android:textSize="@dimen/snore_common_text_size"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:gravity="center"
        android:id="@+id/bottomReport"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:text="@string/snore_see_report"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/guideline2"
        app:layout_constraintTop_toTopOf="@+id/line"/>
    <TextView
        android:textSize="@dimen/snore_common_text_size"
        android:textStyle="bold"
        android:textColor="#b2b2b2"
        android:gravity="center"
        android:id="@+id/bottomCancel"
        android:layout_width="0dp"
        android:layout_height="46dp"
        android:text="@string/snore_cancel"
        app:layout_constraintBottom_toBottomOf="@+id/bottomReport"
        app:layout_constraintEnd_toStartOf="@+id/guideline2"
        app:layout_constraintHorizontal_bias="0.455"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/bottomReport"/>
    <View
        android:background="@color/s4"
        android:layout_width="@dimen/line"
        android:layout_height="30dp"
        app:layout_constraintBottom_toBottomOf="@+id/bottomCancel"
        app:layout_constraintRight_toLeftOf="@+id/guideline2"
        app:layout_constraintRight_toRightOf="@+id/guideline2"
        app:layout_constraintTop_toTopOf="@+id/bottomCancel"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5012"/>
</androidx.constraintlayout.widget.ConstraintLayout>
