<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:id="@+id/card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/size_18dp"
        android:layout_marginEnd="@dimen/size_18dp"
        app:cardCornerRadius="@dimen/size_16dp"
        app:cardPreventCornerOverlap="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="324:205"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/card_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/wl_placeholder_image"
                android:scaleType="centerCrop"/>
            <TextView
                android:textSize="@dimen/size_18sp"
                android:textColor="@color/s5"
                android:id="@+id/tv_card_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_14dp"
                android:text="@string/access_card_family_name"
                android:layout_alignParentTop="true"
                android:layout_marginStart="@dimen/size_20dp"
                android:layout_alignParentStart="true"/>
            <TextView
                android:textSize="@dimen/t3"
                android:textColor="@color/s5"
                android:id="@+id/tv_list_encryption_card_tip"
                android:background="@drawable/wl_solid_semicircle_shape_gray"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/size_10dp"
                android:text="@string/access_door_emulation_card_tip"
                android:drawablePadding="@dimen/size_2dp"
                android:layout_alignParentBottom="true"
                android:drawableStart="@drawable/ic_access_door_key"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:layout_marginStart="@dimen/size_10dp"
                android:layout_alignParentStart="true"/>
        </RelativeLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
