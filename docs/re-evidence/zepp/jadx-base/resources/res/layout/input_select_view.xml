<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.huami.healthlabel.ui.custom.CircleView
        android:id="@+id/input_item_green"
        android:layout_width="26dp"
        android:layout_height="26dp"
        app:circleColor="#009e7a"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:select="true"/>
    <com.huami.healthlabel.ui.custom.CircleView
        android:id="@+id/input_item_blue"
        android:layout_width="26dp"
        android:layout_height="26dp"
        app:circleColor="#008fc5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/input_item_green"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.huami.healthlabel.ui.custom.CircleView
        android:id="@+id/input_item_red"
        android:layout_width="26dp"
        android:layout_height="26dp"
        app:circleColor="#ff5850"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/input_item_green"
        app:layout_constraintStart_toEndOf="@+id/input_item_blue"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.huami.healthlabel.ui.custom.CircleView
        android:id="@+id/input_item_purple"
        android:layout_width="26dp"
        android:layout_height="26dp"
        app:circleColor="#985ffc"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toEndOf="@+id/input_item_green"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.huami.healthlabel.ui.custom.CircleView
        android:id="@+id/input_item_orange"
        android:layout_width="26dp"
        android:layout_height="26dp"
        app:circleColor="#f66a15"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/input_item_purple"
        app:layout_constraintStart_toEndOf="@+id/input_item_green"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
