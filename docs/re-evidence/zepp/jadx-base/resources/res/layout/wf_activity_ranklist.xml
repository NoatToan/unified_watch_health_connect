<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/wf_watch_face_detail_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center_horizontal"
        android:layout_width="231dp"
        android:layout_height="181dp"
        android:src="@drawable/wf_rank_light"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@android:color/transparent"
        android:paddingBottom="25dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.huami.watchfacesstore.view.CommonTitleBar
            android:id="@+id/common_title_bar"
            app:titleText="@string/wf_home_item_rank_title"
            style="@style/CommonTitleBar"/>
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.huami.watchfacesstore.view.banner.Banner
                    android:id="@+id/rank_banner"
                    android:layout_width="match_parent"
                    android:layout_height="301dp"
                    android:layout_marginTop="12dp"/>
                <com.huami.watchfacesstore.view.recycleview.LoadMoreRecyclerView
                    android:orientation="vertical"
                    android:id="@+id/rl_other_list"
                    android:background="@drawable/wf_item_common_bg"
                    android:paddingTop="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-10dp"
                    android:layout_marginStart="15dp"
                    android:layout_marginEnd="15dp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/error_container"
        android:paddingTop="180dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="16sp"
            android:textColor="#ffffff"
            android:layout_gravity="center"
            android:id="@+id/error_tips_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wf_network_unconnected"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/refresh_tv"
            android:background="@drawable/wf_refresh_btn_bg"
            android:layout_width="100dp"
            android:layout_height="35dp"
            android:layout_marginTop="23dp"
            android:text="@string/wf_error_refresh"/>
    </LinearLayout>
</FrameLayout>
