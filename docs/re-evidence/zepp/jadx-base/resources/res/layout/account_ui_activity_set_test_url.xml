<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#f4f5f5"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textColor="#0000ff"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/account_ui_mili_margin"
        android:text="@string/account_ui_business_server"/>
    <include
        android:id="@+id/set_business_url"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        layout="@layout/account_ui_layout_set_url_item"/>
    <TextView
        android:textColor="#0000ff"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/account_ui_mili_margin"
        android:text="@string/account_ui_account_server"/>
    <include
        android:id="@+id/set_account_url"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        layout="@layout/account_ui_layout_set_url_item"/>
    <TextView
        android:textSize="@dimen/account_ui_click_button_text_size"
        android:textColor="@color/account_ui_change_sport_goal_confirm_txt"
        android:gravity="center"
        android:id="@+id/set_test_url_commit"
        android:background="@drawable/account_ui_change_sport_goal_button"
        android:layout_width="match_parent"
        android:layout_height="@dimen/account_ui_click_button_h"
        android:layout_margin="@dimen/account_ui_mili_margin"
        android:text="@string/account_ui_change_sport_goal_confirm"/>
</LinearLayout>
