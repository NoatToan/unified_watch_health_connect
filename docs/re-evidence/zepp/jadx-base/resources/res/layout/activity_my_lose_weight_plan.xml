<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s36"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.lib.view.image.HMCircleImageView
        android:id="@+id/my_lose_weight_person_info_avatar"
        android:layout_width="75dp"
        android:layout_height="75dp"
        android:layout_marginTop="40dp"
        android:src="@drawable/setting_avatar_default"
        app:civ_border_color="@color/s3"
        app:civ_border_width="1.3dp"
        app:civ_fill_color="@color/s3"
        app:hm_civ_border_color_touch="@color/s30"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="14sp"
        android:textColor="@color/s1"
        android:id="@+id/my_lose_weight_person_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/my_lose_weight_person_info_avatar"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/my_lose_weight_person_name">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp">
                <TextView
                    android:textSize="12dp"
                    android:textColor="@color/s3"
                    android:gravity="end"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/lose_weight_goal"
                    android:layout_weight="1"
                    android:paddingEnd="52dp"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="42dp"
                        android:textColor="@color/s1"
                        android:gravity="start"
                        android:id="@+id/my_lose_weight_plan_goal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1dp"
                        android:fontFamily="km"/>
                    <TextView
                        android:textSize="15dp"
                        android:textColor="@color/s1"
                        android:gravity="start"
                        android:id="@+id/my_lose_weight_plan_goal_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/unit_kg"
                        android:layout_marginStart="10dp"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">
                <TextView
                    android:textSize="12dp"
                    android:textColor="@color/s3"
                    android:gravity="end"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/lose_weight_duration"
                    android:layout_weight="1"
                    android:paddingEnd="52dp"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="42dp"
                        android:textColor="@color/s1"
                        android:gravity="start"
                        android:id="@+id/my_lose_weight_plan_period"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1dp"
                        android:fontFamily="km"/>
                    <TextView
                        android:textSize="15dp"
                        android:textColor="@color/s1"
                        android:gravity="start"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/lose_weight_sport_month"
                        android:layout_marginStart="10dp"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">
                <TextView
                    android:textSize="12dp"
                    android:textColor="@color/s3"
                    android:gravity="end"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/lose_weight_sport_type"
                    android:layout_weight="1"
                    android:paddingEnd="52dp"/>
                <TextView
                    android:textSize="22dp"
                    android:textColor="@color/s1"
                    android:id="@+id/my_lose_weight_plan_sport_type"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="dd"
                    android:layout_weight="1"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">
                <TextView
                    android:textSize="12dp"
                    android:textColor="@color/s3"
                    android:gravity="end"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/lose_weight_sport_daily_time"
                    android:layout_weight="1"
                    android:paddingEnd="52dp"/>
                <LinearLayout
                    android:layout_gravity="start"
                    android:orientation="horizontal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="42dp"
                        android:textColor="@color/s1"
                        android:gravity="start"
                        android:id="@+id/my_lose_weight_plan_sport_time_day"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="faf"
                        android:fontFamily="km"/>
                    <TextView
                        android:textSize="15dp"
                        android:textColor="@color/s1"
                        android:gravity="start"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/lose_weight_sport_minute_unit"
                        android:layout_marginStart="10dp"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">
                <TextView
                    android:textSize="12dp"
                    android:textColor="@color/s3"
                    android:gravity="end"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/lose_weight_sport_week_time"
                    android:layout_weight="1"
                    android:paddingEnd="52dp"/>
                <LinearLayout
                    android:layout_gravity="start"
                    android:orientation="horizontal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="42dp"
                        android:textColor="@color/s1"
                        android:gravity="start"
                        android:id="@+id/my_lose_weight_plan_sport_time_week"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1dp"
                        android:fontFamily="km"/>
                    <TextView
                        android:textSize="15dp"
                        android:textColor="@color/s1"
                        android:gravity="start"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/lose_weight_sport_minute_unit"
                        android:layout_marginStart="10dp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/lose_weight_decoration"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
