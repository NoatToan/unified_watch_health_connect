<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:overScrollMode="never">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/head"
        android:background="@color/s38"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/avg_area"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:paddingStart="@dimen/size_10dp"
            android:paddingEnd="@dimen/size_10dp"
            android:layout_marginStart="5dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="40sp"
                android:textColor="@color/s1"
                android:id="@+id/chart_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/value_invalid"
                android:textDirection="locale"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="@dimen/size_14sp"
                android:textColor="@color/s2"
                android:id="@+id/unit"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/size_4dp"
                app:layout_constraintBaseline_toBaselineOf="@+id/chart_value"
                app:layout_constraintStart_toEndOf="@+id/chart_value"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="@dimen/size_12sp"
                android:textColor="@color/s2"
                android:id="@+id/time"
                android:paddingBottom="@dimen/size_4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_10dp"
                android:textDirection="locale"
                app:layout_constraintStart_toStartOf="@+id/chart_value"
                app:layout_constraintTop_toBottomOf="@+id/unit"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/blood_pressure_area"
            android:background="@color/s38"
            android:paddingTop="@dimen/size_4dp"
            android:paddingBottom="@dimen/size_4dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:paddingStart="@dimen/size_10dp"
            android:paddingEnd="@dimen/size_10dp"
            android:layout_marginStart="5dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="@dimen/size_12sp"
                android:textColor="@color/s2"
                android:ellipsize="end"
                android:id="@+id/dbp_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="120dp"
                android:text="@string/card_dbp"
                android:maxLines="2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="24sp"
                android:textColor="@color/s1"
                android:id="@+id/dbp_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_4dp"
                android:text="@string/value_invalid"
                android:textDirection="locale"
                android:layout_marginEnd="5dp"
                app:layout_constraintStart_toStartOf="@+id/dbp_title"
                app:layout_constraintTop_toBottomOf="@+id/dbp_title"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="@dimen/size_14sp"
                android:textColor="@color/s2"
                android:id="@+id/dbp_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/unit_bp"
                android:textDirection="locale"
                android:layout_marginStart="5dp"
                app:layout_constraintBaseline_toBaselineOf="@+id/dbp_value"
                app:layout_constraintStart_toEndOf="@+id/dbp_value"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/barrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="end"
                app:constraint_referenced_ids="dbp_title,dbp_unit"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="@dimen/size_12sp"
                android:textColor="@color/s2"
                android:ellipsize="end"
                android:id="@+id/sbp_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="120dp"
                android:text="@string/card_sbp"
                android:maxLines="2"
                android:layout_marginStart="@dimen/size_20dp"
                app:layout_constraintStart_toEndOf="@+id/barrier"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="24sp"
                android:textColor="@color/s1"
                android:id="@+id/sbp_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_4dp"
                android:text="@string/value_invalid"
                android:textDirection="locale"
                android:layout_marginEnd="5dp"
                app:layout_constraintStart_toStartOf="@+id/sbp_title"
                app:layout_constraintTop_toBottomOf="@+id/sbp_title"
                app:layout_goneMarginEnd="@dimen/size_50dp"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="@dimen/size_14sp"
                android:textColor="@color/s2"
                android:id="@+id/sbp_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/unit_bp"
                android:textDirection="locale"
                android:layout_marginStart="5dp"
                app:layout_constraintBaseline_toBaselineOf="@+id/sbp_value"
                app:layout_constraintStart_toEndOf="@+id/sbp_value"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="@dimen/size_12sp"
                android:textColor="@color/s2"
                android:id="@+id/bp_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_10dp"
                android:textDirection="locale"
                app:layout_constraintStart_toStartOf="@+id/dbp_value"
                app:layout_constraintTop_toBottomOf="@+id/dbp_value"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <FrameLayout
            android:id="@+id/chart_container"
            android:background="@color/s38"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/head"/>
        <View
            android:id="@+id/bp_sign_divider"
            android:background="@color/s4"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <com.google.android.flexbox.FlexboxLayout
            android:orientation="horizontal"
            android:id="@+id/bp_sign"
            android:background="@color/s38"
            android:paddingBottom="@dimen/size_15dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            app:alignContent="flex_start"
            app:alignItems="flex_start"
            app:flexWrap="wrap"
            app:justifyContent="flex_start"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/head">
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="14sp"
                android:textColor="@color/s2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_6dp"
                android:text="@string/card_dbp"
                android:drawablePadding="6dp"
                android:drawableStart="@drawable/shape_circle_dbp"
                android:layout_marginStart="15dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/dbp_value"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="14sp"
                android:textColor="@color/s2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_6dp"
                android:text="@string/card_sbp"
                android:drawablePadding="6dp"
                android:drawableStart="@drawable/shape_circle_sbp"
                android:layout_marginStart="15dp"/>
        </com.google.android.flexbox.FlexboxLayout>
    </LinearLayout>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="@dimen/size_16sp"
        android:textColor="@color/s1"
        android:gravity="center_vertical"
        android:id="@+id/add_data"
        android:background="@drawable/shape_rect_corner_white"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="@dimen/size_15dp"
        android:text="@string/health_data_add"
        android:textDirection="locale"
        android:paddingStart="@dimen/size_15dp"
        android:paddingEnd="@dimen/size_15dp"
        android:layout_marginStart="@dimen/size_15dp"
        android:layout_marginEnd="@dimen/size_15dp"
        app:drawableTint="@color/s2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/intro_container"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="@dimen/size_16sp"
        android:textColor="@color/s1"
        android:gravity="center_vertical"
        android:id="@+id/history_data"
        android:background="@drawable/shape_rect_corner_white"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="@dimen/size_15dp"
        android:text="@string/health_data_history"
        android:textDirection="locale"
        android:paddingStart="@dimen/size_15dp"
        android:paddingEnd="@dimen/size_15dp"
        android:layout_marginStart="@dimen/size_15dp"
        android:layout_marginEnd="@dimen/size_15dp"
        app:drawableTint="@color/s2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/add_data"/>
    <FrameLayout
        android:id="@+id/intro_container"
        android:background="@drawable/shape_rect_corner_white"
        android:paddingTop="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_15dp"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        android:layout_marginStart="@dimen/size_15dp"
        android:layout_marginEnd="@dimen/size_15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/head"/>
    <FrameLayout
        android:id="@+id/extra_container"
        android:background="@drawable/shape_rect_corner_white"
        android:padding="@dimen/size_15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_15dp"
        android:layout_marginStart="@dimen/size_15dp"
        android:layout_marginEnd="@dimen/size_15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/history_data"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="12sp"
        android:textColor="@color/s3"
        android:id="@+id/jp_hint_text"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/health_detail_jp_hint"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="25dp"
        app:layout_constraintTop_toBottomOf="@+id/extra_container"/>
</androidx.constraintlayout.widget.ConstraintLayout>
