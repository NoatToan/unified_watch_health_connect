<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/brief_layout"
        android:layout_width="wrap_content"
        android:layout_height="70dp">
        <View
            android:id="@+id/divider_bottom"
            android:background="@color/s4"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider_slp_info"
            android:layout_alignParentTop="true"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"/>
        <ImageView
            android:id="@+id/body_index_icon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/bf3_b_m_i"
            android:layout_centerVertical="true"
            android:layout_marginStart="19dp"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ll_bf3_params"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_marginTop="14dp"
            android:layout_marginStart="15dp"
            android:layout_toEndOf="@+id/body_index_icon">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/s1"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/body_index_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <com.huami.lib.view.text.UnitTextView
                android:textSize="15sp"
                android:textColor="@color/s1"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/body_index_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:typeface="km"
                app:unitColor="@color/s1"
                app:unitSize="15sp"/>
        </LinearLayout>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/s2"
            android:id="@+id/body_index_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-3dp"
            android:layout_below="@+id/ll_bf3_params"
            android:layout_marginStart="15dp"
            android:layout_toEndOf="@+id/body_index_icon"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/s2"
            android:id="@+id/text_view_details"
            android:background="@drawable/bodyfat_bg_view_details"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/text_view_details"
            android:layout_alignTop="@+id/body_index_desc"
            android:paddingStart="3dp"
            android:paddingEnd="3dp"
            android:layout_marginStart="5dp"
            android:layout_toEndOf="@+id/body_index_desc"/>
        <ImageView
            android:id="@+id/arrow_iv"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/arrow_down"
            android:scaleType="centerInside"
            android:layout_centerVertical="true"
            android:layout_marginEnd="18dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/detail_layout"
        android:paddingBottom="18dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/brief_layout"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="46dp">
            <View
                android:id="@+id/adapter_divider_up"
                android:background="@color/s4"
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/s1"
                android:gravity="start"
                android:id="@+id/info_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:lineSpacingExtra="@dimen/body_params_linespace"/>
            <com.huami.view.weightfigure.WeightFigureView
                android:id="@+id/params_figure_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:type="unmoveable"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
