<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/s36"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:background="@color/s36"
            android:layout_width="match_parent"
            android:layout_height="10dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/s1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/ecg_simple"
            android:layout_marginStart="20dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/s1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="20dp"
            android:text="@string/ecg_desc_simple"
            android:lineSpacingExtra="5.3sp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"/>
    </LinearLayout>
    <TextView
        android:textColor="@color/s3"
        android:id="@+id/ecg_jp_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/ecg_jp_desc"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        style="@style/Rainbow.TextAppearance.Number8"/>
</LinearLayout>
