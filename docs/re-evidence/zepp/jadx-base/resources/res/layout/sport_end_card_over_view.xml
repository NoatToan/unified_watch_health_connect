<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="14sp"
        android:textColor="#8d8d8d"
        android:id="@+id/end_card_view_sport_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16.6dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/end_card_view_blow_line"
        android:background="@color/black06"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="11dp"
        app:layout_constraintTop_toBottomOf="@+id/end_card_view_sport_type"/>
    <ImageView
        android:id="@+id/end_card_view_avatar"
        android:layout_width="43.3dp"
        android:layout_height="43.3dp"
        android:layout_marginTop="14.4dp"
        android:src="@drawable/default_user_avatar"
        android:layout_marginStart="13.3dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/end_card_view_blow_line"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="12.7sp"
        android:textColor="@color/color_333333"
        android:ellipsize="end"
        android:id="@+id/end_card_view_nick_name"
        android:layout_width="186.7dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="19.2dp"
        android:singleLine="true"
        android:fontFamily="lt"
        android:layout_marginStart="4.7dp"
        app:layout_constraintStart_toEndOf="@+id/end_card_view_avatar"
        app:layout_constraintTop_toBottomOf="@+id/end_card_view_blow_line"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="12sp"
        android:textColor="@color/color_333333"
        android:id="@+id/end_card_view_start_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="lt"
        android:layout_marginStart="4.7dp"
        app:layout_constraintStart_toEndOf="@+id/end_card_view_avatar"
        app:layout_constraintTop_toBottomOf="@+id/end_card_view_nick_name"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="11.7sp"
        android:textColor="#99333333"
        android:id="@+id/end_card_view_main_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="lt"
        android:layout_marginEnd="13.3dp"
        app:layout_constraintBottom_toBottomOf="@+id/end_card_view_start_time"
        app:layout_constraintEnd_toEndOf="parent"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="38.3sp"
        android:textColor="@color/color_333333"
        android:id="@+id/end_card_view_main_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_alignBaseline="@+id/over_view_main_unit"
        android:fontFamily="ow"
        app:layout_constraintEnd_toStartOf="@+id/end_card_view_main_unit"
        app:layout_constraintTop_toBottomOf="@+id/end_card_view_blow_line"/>
    <com.huami.moving.ui.view.FastSlowGradientView
        android:id="@+id/end_card_view_gradient"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="21dp"
        app:endY="0"
        app:layout_constraintTop_toBottomOf="@+id/end_card_view_start_time"
        app:linearColors="@array/fast_slow_gradient_colors"
        app:linearPositions="@array/fast_slow_gradient_percents"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/end_card_view_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:listSelector="@android:color/transparent"
        android:numColumns="3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/end_card_view_start_time"/>
    <Space
        android:layout_width="match_parent"
        android:layout_height="38dp"
        app:layout_constraintTop_toBottomOf="@+id/end_card_view_info"/>
</androidx.constraintlayout.widget.ConstraintLayout>
