<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:background="@drawable/shape_rect_white_corner_6"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="30dp"
    android:layout_marginEnd="30dp">
    <TextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/s1"
        android:gravity="center"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="@string/moving_ui_no_gps_title"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/s1"
        android:gravity="center"
        android:id="@+id/tv_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/moving_ui_no_gps_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/s1"
        android:gravity="center_horizontal"
        android:id="@+id/tv_confirm"
        android:background="@drawable/shape_rect_white_corner_6_bottom"
        android:paddingTop="17dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="@string/running_tip_known"/>
</LinearLayout>
