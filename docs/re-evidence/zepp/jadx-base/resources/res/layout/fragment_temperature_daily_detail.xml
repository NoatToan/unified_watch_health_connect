<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/head"
        android:background="@color/s38"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/value_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:paddingStart="@dimen/size_10dp"
            android:paddingEnd="@dimen/size_10dp"
            android:layout_marginStart="5dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="40sp"
                android:textColor="@color/s1"
                android:id="@+id/value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textDirection="locale"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="14sp"
                android:textColor="@color/s2"
                android:id="@+id/unit"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/unit_temp"
                android:layout_marginStart="@dimen/size_4dp"
                app:layout_constraintBaseline_toBaselineOf="@+id/value"
                app:layout_constraintStart_toEndOf="@+id/value"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="@dimen/size_12sp"
                android:textColor="@color/s2"
                android:id="@+id/time"
                android:paddingBottom="@dimen/size_4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_10dp"
                android:textDirection="locale"
                app:layout_constraintStart_toStartOf="@+id/value"
                app:layout_constraintTop_toBottomOf="@+id/unit"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <FrameLayout
            android:id="@+id/chart_container"
            android:background="@color/s38"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="@dimen/size_2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/value_container"/>
        <View
            android:id="@+id/divider_line"
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="@dimen/size_2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/chart_container"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="14sp"
            android:textColor="@color/s2"
            android:id="@+id/normal_logo"
            android:padding="@dimen/size_15dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/temperature_standard"
            android:drawablePadding="5dp"
            android:drawableStart="@drawable/shape_circle_spo2_normal"
            android:textDirection="locale"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/divider_line"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="14sp"
            android:textColor="@color/s2"
            android:padding="@dimen/size_15dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/temperature_fever"
            android:drawablePadding="5dp"
            android:drawableStart="@drawable/shape_circle_spo2_abnormal"
            android:textDirection="locale"
            app:layout_constraintStart_toEndOf="@+id/normal_logo"
            app:layout_constraintTop_toBottomOf="@+id/divider_line"/>
        <View
            android:id="@+id/divider_line_statistic"
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="@dimen/size_2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/normal_logo"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/statistics_zone"
            android:padding="30dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/divider_line_statistic">
            <com.xiaomi.hm.health.training.ui.widget.UpDownTextItem
                android:id="@+id/statistics_max"
                android:layout_width="@dimen/size_0.5dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:downText="@string/temperature_max"
                app:downTextColor="@color/s2"
                app:downTextSize="@dimen/size_12sp"
                app:textPadding="5dp"
                app:upTextColor="@color/s1"
                app:upTextSize="24sp"/>
            <com.xiaomi.hm.health.training.ui.widget.UpDownTextItem
                android:id="@+id/statistics_min"
                android:layout_width="@dimen/size_0.5dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:downText="@string/temperature_min"
                app:downTextColor="@color/s2"
                app:downTextSize="@dimen/size_12sp"
                app:textPadding="5dp"
                app:upTextColor="@color/s1"
                app:upTextSize="24sp"/>
            <com.xiaomi.hm.health.training.ui.widget.UpDownTextItem
                android:id="@+id/statistics_avg"
                android:layout_width="@dimen/size_0.5dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:downText="@string/temperature_avg"
                app:downTextColor="@color/s2"
                app:downTextSize="@dimen/size_12sp"
                app:textPadding="5dp"
                app:upTextColor="@color/s1"
                app:upTextSize="24sp"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="@dimen/size_16sp"
        android:textColor="@color/s1"
        android:gravity="center_vertical"
        android:id="@+id/add_data"
        android:background="@drawable/shape_rect_corner_white"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="@dimen/size_15dp"
        android:text="@string/health_data_add"
        android:textDirection="locale"
        android:paddingStart="@dimen/size_15dp"
        android:paddingEnd="@dimen/size_15dp"
        android:layout_marginStart="@dimen/size_15dp"
        android:layout_marginEnd="@dimen/size_15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/head"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="@dimen/size_16sp"
        android:textColor="@color/s1"
        android:gravity="center_vertical"
        android:id="@+id/history_data"
        android:background="@drawable/shape_rect_corner_white"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="@dimen/size_15dp"
        android:text="@string/health_data_history"
        android:textDirection="locale"
        android:paddingStart="@dimen/size_15dp"
        android:paddingEnd="@dimen/size_15dp"
        android:layout_marginStart="@dimen/size_15dp"
        android:layout_marginEnd="@dimen/size_15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/add_data"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/intro"
        android:background="@drawable/shape_rect_corner_white"
        android:padding="@dimen/size_15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/size_15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/history_data">
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/s1"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/health_data_temperature"
            android:textDirection="locale"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="@dimen/size_12sp"
            android:textColor="@color/s2"
            android:id="@+id/intro_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_15dp"
            android:text="@string/temperature_intro"
            android:textDirection="locale"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="@dimen/size_12sp"
            android:textColor="@color/s2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_15dp"
            android:text="@string/temperature_device_measure_range"
            android:textDirection="locale"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/intro_content"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
