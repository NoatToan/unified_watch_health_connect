<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/s36"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/card_in_use"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/size_12sp"
                    android:textColor="@color/s2"
                    android:id="@+id/title_default_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_18dp"
                    android:text="@string/access_door_default_card_use"
                    android:paddingStart="@dimen/size_18dp"
                    android:paddingEnd="@dimen/size_18dp"/>
                <View
                    android:background="@color/s3"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size_0.5dp"
                    android:layout_marginTop="@dimen/size_8dp"
                    android:layout_marginStart="@dimen/size_18dp"
                    android:layout_marginEnd="@dimen/size_18dp"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="@dimen/size_10dp">
                    <androidx.cardview.widget.CardView
                        android:id="@+id/card"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_marginStart="@dimen/size_18dp"
                        android:layout_marginEnd="@dimen/size_18dp"
                        app:cardCornerRadius="@dimen/size_13dp"
                        app:cardPreventCornerOverlap="false"
                        app:layout_constraintDimensionRatio="324:205"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent">
                        <ImageView
                            android:id="@+id/card_image_default"
                            android:focusable="true"
                            android:clickable="true"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/wl_placeholder_image"
                            android:scaleType="centerCrop"/>
                        <TextView
                            android:textSize="@dimen/size_18sp"
                            android:textColor="@color/s5"
                            android:id="@+id/tv_card_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/size_14dp"
                            android:text=""
                            android:layout_alignParentTop="true"
                            android:layout_marginStart="@dimen/size_20dp"
                            android:layout_alignParentStart="true"/>
                    </androidx.cardview.widget.CardView>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/cards_no_use"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_10dp">
                <TextView
                    android:textSize="@dimen/size_12sp"
                    android:textColor="@color/s2"
                    android:id="@+id/title_idle_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_15dp"
                    android:text="@string/access_door_default_card_not_use"
                    android:paddingStart="@dimen/size_18dp"
                    android:paddingEnd="@dimen/size_18dp"/>
                <View
                    android:background="@color/s3"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size_0.5dp"
                    android:layout_marginTop="@dimen/size_10dp"
                    android:layout_marginStart="@dimen/size_18dp"
                    android:layout_marginEnd="@dimen/size_8dp"/>
                <com.loopeer.cardstack.CardStackView
                    android:id="@+id/card_stack"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_10dp"
                    app:stackNumBottomShow="3"
                    app:stackOverlapGaps="60dp"
                    app:stackOverlapGapsCollapse="40dp"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
