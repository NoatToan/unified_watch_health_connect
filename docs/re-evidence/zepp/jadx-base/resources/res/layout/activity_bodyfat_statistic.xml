<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/s36"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <RelativeLayout
                android:id="@+id/weight_info_layout"
                android:layout_width="match_parent"
                android:layout_height="108dp">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/s1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/your_weight"
                    android:layout_above="@+id/weight_value"
                    android:layout_centerHorizontal="true"/>
                <com.huami.widget.typeface.TypefaceTextView
                    android:textSize="30sp"
                    android:textColor="@color/s21"
                    android:id="@+id/weight_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"
                    android:fontFamily="km"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/s2"
                    android:id="@+id/weight_unit"
                    android:paddingBottom="3.3dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:layout_alignParentBottom="true"
                    android:layout_marginStart="3.3dp"
                    android:layout_toEndOf="@+id/weight_value"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/weight_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@+id/weight_info_layout"/>
        </RelativeLayout>
        <View
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider_slp_info"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="5dp">
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/s2"
                android:id="@+id/weight_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:fontFamily="din-med"/>
        </RelativeLayout>
    </LinearLayout>
    <View
        android:background="@color/s36"
        android:layout_width="match_parent"
        android:layout_height="8dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <TextView
                android:textSize="12.7sp"
                android:textColor="@color/s2"
                android:gravity="center"
                android:id="@+id/bfat_no_info"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_body_fat_info"
                android:layout_centerInParent="true"/>
            <RelativeLayout
                android:id="@+id/bfat_info_layout"
                android:layout_width="match_parent"
                android:layout_height="108dp">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/s1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/body_fat"
                    android:layout_above="@+id/bfat_value"
                    android:layout_centerHorizontal="true"/>
                <com.huami.widget.typeface.TypefaceTextView
                    android:textSize="30sp"
                    android:textColor="@color/s33"
                    android:id="@+id/bfat_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"
                    android:fontFamily="km"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/s33"
                    android:paddingBottom="3.3dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="%"
                    android:layout_alignParentBottom="true"
                    android:layout_marginStart="3.3dp"
                    android:layout_toEndOf="@+id/bfat_value"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/bfat_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@+id/bfat_info_layout"/>
        </RelativeLayout>
        <View
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider_slp_info"/>
        <RelativeLayout
            android:id="@+id/bfat_time_layout"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="5dp">
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/s2"
                android:id="@+id/bfat_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:fontFamily="din-med"/>
        </RelativeLayout>
        <View
            android:id="@+id/divider_line"
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider_slp_info"/>
    </LinearLayout>
    <RelativeLayout
        android:gravity="center"
        android:background="@color/s38"
        android:layout_width="match_parent"
        android:layout_height="66.7dp">
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp">
            <RelativeLayout
                android:id="@+id/weight_btm_left_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageButton
                    android:id="@+id/weight_zoom_in"
                    android:background="@drawable/icon_zoom_in"
                    android:layout_width="32dp"
                    android:layout_height="32dp"/>
                <TextView
                    android:textSize="9.3sp"
                    android:textColor="@color/s2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/zoom_in"
                    android:layout_below="@+id/weight_zoom_in"
                    android:layout_centerHorizontal="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="50dp"
                android:layout_toEndOf="@+id/weight_btm_left_layout">
                <ImageButton
                    android:id="@+id/weight_zoom_out"
                    android:background="@drawable/icon_zoom_out"
                    android:layout_width="32dp"
                    android:layout_height="32dp"/>
                <TextView
                    android:textSize="9.3sp"
                    android:textColor="@color/s2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/zoom_out"
                    android:layout_below="@+id/weight_zoom_out"
                    android:layout_centerHorizontal="true"/>
            </RelativeLayout>
        </RelativeLayout>
    </RelativeLayout>
</LinearLayout>
