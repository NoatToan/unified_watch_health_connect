<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <ImageView
        android:layout_gravity="start|center_vertical"
        android:id="@+id/start_arrow"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/dialog_choice_arrow"
        android:layout_marginStart="3dp"
        app:tint="@color/p3"/>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:layout_marginStart="@dimen/common_item_padding"
        android:layout_marginEnd="@dimen/common_item_padding">
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/tex_layout"
            android:paddingTop="13dp"
            android:paddingBottom="13dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:layout_weight="1"
            android:paddingStart="0dp"
            android:paddingEnd="14dp">
            <TextView
                android:textSize="@dimen/item_title_size"
                android:textColor="@color/s1"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="10.7sp"
                android:textColor="@color/s2"
                android:id="@+id/summary"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"/>
        </LinearLayout>
    </LinearLayout>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/bottom_divider"
        android:background="@color/s4"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider"
        android:layout_marginStart="@dimen/common_item_padding"
        android:layout_marginEnd="@dimen/common_item_padding"/>
</merge>
