<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/s36"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/rl_inVoice_wait"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/size_130dp">
        <ImageView
            android:id="@+id/iv_submit_wait"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/wl_ic_invoice_address_wait"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/s1"
            android:id="@+id/tv_submit_wait"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_8dp"
            android:text="@string/wl_invoice_submit_success"
            android:layout_below="@+id/iv_submit_wait"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="@dimen/size_14.5sp"
            android:textColor="@color/s3"
            android:gravity="center_horizontal"
            android:id="@+id/tv_submit_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_10dp"
            android:text="@string/wl_invoice_submit_success_tip"
            android:layout_below="@+id/tv_submit_wait"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_inVoice_success"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/size_130dp">
        <ImageView
            android:id="@+id/iv_submit_success"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/wl_ic_invoice_success"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/s1"
            android:gravity="center_horizontal"
            android:id="@+id/tv_submit_success"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_8dp"
            android:text="@string/wl_invoice_has_complete"
            android:layout_below="@+id/iv_submit_success"
            android:layout_centerHorizontal="true"/>
        <Button
            android:gravity="center"
            android:id="@+id/tv_click_download"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/size_24dp"
            android:text="@string/wl_invoice_click_download"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/size_18dp"
            android:layout_marginEnd="@dimen/size_18dp"
            style="@style/Rainbow.Widget.Button.44.Circular"/>
    </RelativeLayout>
</RelativeLayout>
