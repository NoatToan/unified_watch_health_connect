<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/support_bank_head"
        android:layout_width="match_parent"
        android:layout_height="40dp">
        <TextView
            android:textSize="12sp"
            android:textColor="#e6000000"
            android:gravity="center"
            android:background="@drawable/wl_watch_bank_list_bg_one"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/wl_support_bank_name"
            android:layout_weight="2"
            android:lineSpacingExtra="6sp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#e6000000"
            android:gravity="center"
            android:background="@drawable/wl_watch_bank_list_bg_two"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/wl_support_bank_debit"
            android:layout_weight="1"
            android:lineSpacingExtra="6sp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#e6000000"
            android:gravity="center"
            android:background="@drawable/wl_watch_bank_list_bg_one"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/wl_support_bank_credit"
            android:layout_weight="1"
            android:lineSpacingExtra="6sp"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/support_bank_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/support_bank_tip"
        android:layout_below="@+id/support_bank_head"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#4c000000"
        android:id="@+id/support_bank_tip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:text="@string/wl_support_bank_tip"
        android:layout_alignParentBottom="true"
        android:lineSpacingExtra="6sp"/>
    <include
        android:id="@+id/error_view"
        android:visibility="gone"
        layout="@layout/wl_watch_bank_loading_error"/>
</RelativeLayout>
