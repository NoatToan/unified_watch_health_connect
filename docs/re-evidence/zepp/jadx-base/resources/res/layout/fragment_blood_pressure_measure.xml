<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/s1"
        android:gravity="center"
        android:id="@+id/measure_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/s2"
        android:gravity="center"
        android:id="@+id/measure_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="100dp"
        android:layout_weight="1"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp">
        <ImageView
            android:id="@+id/measure_img"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="centerInside"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.huami.device.feature.health.ui.view.BloodPressureMeasureProgress
            android:id="@+id/rest_progress"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/measure_img"
            app:layout_constraintEnd_toEndOf="@+id/measure_img"
            app:layout_constraintStart_toStartOf="@+id/measure_img"
            app:layout_constraintTop_toTopOf="@+id/measure_img"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="20sp"
        android:textColor="@color/s1"
        android:id="@+id/rest_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="165dp"
        android:layout_marginTop="56dp">
        <Button
            android:enabled="false"
            android:id="@+id/btn_start"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/blood_pressure_start_measure"
            android:layout_marginStart="22dp"
            android:layout_marginEnd="22dp"
            style="@style/Rainbow.Widget.Button.48"/>
        <Button
            android:id="@+id/btn_record"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/blood_pressure_record_measure_result"
            android:layout_marginStart="22dp"
            android:layout_marginEnd="22dp"
            style="@style/Rainbow.Widget.Button.48"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/s15"
            android:id="@+id/btn_skip_rest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="77dp"
            android:text="@string/blood_pressure_skip_rest"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"/>
    </RelativeLayout>
</LinearLayout>
