<?xml version="1.0" encoding="utf-8"?>
<com.huami.hmchartui.ui.view.CommonCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="15dp"
    android:layout_marginBottom="14dp"
    android:layout_marginStart="14dp"
    android:layout_marginEnd="14dp"
    app:cardCornerRadius="@dimen/common_card_radius"
    app:cardElevation="@dimen/common_card_elevation">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@color/s38"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/s1"
            android:gravity="start|center_vertical"
            android:id="@+id/step_info_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/step_info_title"
            android:lines="1"
            android:fontFamily="lt-bold"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="14sp"
            android:textColor="@color/s2"
            android:paddingBottom="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/step_info_desc"
            android:lineSpacingExtra="2dp"
            android:fontFamily="lt"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/step_info_title"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.huami.hmchartui.ui.view.CommonCardView>
