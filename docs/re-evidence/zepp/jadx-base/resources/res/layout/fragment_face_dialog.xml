<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/pb_tip_dialog_shape"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minHeight="372dp">
    <RelativeLayout
        android:paddingTop="14dp"
        android:layout_width="284dp"
        android:layout_height="wrap_content"
        android:minHeight="60dp">
        <TextView
            android:textSize="@dimen/facestore_face_name_size"
            android:textStyle="bold"
            android:textColor="@color/facestore_install_name_color"
            android:ellipsize="end"
            android:id="@+id/face_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="240dp"
            android:text="你好你好"
            android:maxLines="2"
            android:layout_centerHorizontal="true"/>
        <ImageButton
            android:id="@+id/face_close"
            android:background="@drawable/ic_dialog_pb_delete"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="10dp"
            android:layout_alignParentEnd="true"/>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_below="@+id/face_name"
            android:layout_centerHorizontal="true">
            <TextView
                android:textSize="@dimen/facestore_face_param_size"
                android:textColor="@color/facestore_install_param_color"
                android:id="@+id/size_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="@dimen/facestore_face_param_size"
                android:textColor="@color/facestore_install_param_color"
                android:id="@+id/time_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"/>
        </LinearLayout>
    </RelativeLayout>
    <View
        android:background="@color/facestore_install_line_color"
        android:layout_width="match_parent"
        android:layout_height="0.3dp"/>
    <RelativeLayout
        android:layout_width="284dp"
        android:layout_height="262dp"
        android:minHeight="262dp">
        <TextView
            android:textSize="10sp"
            android:textColor="#fff"
            android:gravity="center"
            android:id="@+id/tv_tips"
            android:background="@drawable/watch_face_tips_bg"
            android:layout_width="66dp"
            android:layout_height="22dp"
            android:layout_marginTop="15dp"/>
        <ImageView
            android:id="@+id/face_image_bg"
            android:background="@drawable/pop_img_watch"
            android:layout_width="222dp"
            android:layout_height="222dp"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/face_image"
            android:layout_width="106.7dp"
            android:layout_height="106.7dp"
            android:scaleType="center"
            android:layout_centerInParent="true"/>
        <TextView
            android:textSize="10sp"
            android:textColor="#4c000000"
            android:id="@+id/progress_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="9dp"
            android:text="@string/watch_face_detail_tips"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/progress_bg"
        android:background="@drawable/watch_face_dialog_btn_shape"
        android:layout_width="match_parent"
        android:layout_height="50dp">
        <ProgressBar
            android:id="@+id/progressbar_updown"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/progress_bg"
            style="?android:attr/progressBarStyleHorizontal"/>
        <TextView
            android:textSize="@dimen/facestore_face_button_size"
            android:textStyle="bold"
            android:textColor="@color/facestore_install_button_color"
            android:gravity="center_horizontal"
            android:layout_gravity="center"
            android:id="@+id/face_confirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/facestore_install_button_confirm"/>
        <TextView
            android:textSize="@dimen/facestore_face_button_size"
            android:textStyle="bold"
            android:textColor="@color/facestore_install_button_color"
            android:gravity="center_horizontal"
            android:layout_gravity="center"
            android:id="@+id/face_complete"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/facestore_install_progress_complete"/>
        <View
            android:layout_gravity="start"
            android:id="@+id/line"
            android:background="@drawable/progress_bar"
            android:layout_width="60dp"
            android:layout_height="50dp"
            android:layout_marginStart="-60dp"/>
    </FrameLayout>
</LinearLayout>
