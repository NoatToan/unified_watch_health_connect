<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/s36"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/size_20dp"
    android:paddingEnd="@dimen/size_20dp">
    <androidx.appcompat.widget.AppCompatEditText
        android:textSize="@dimen/account_ui_register_phone_password_text_size"
        android:typeface="monospace"
        android:textColor="@color/s1"
        android:textColorHint="@color/s3"
        android:gravity="start|center_vertical"
        android:id="@+id/ev_password"
        android:background="@drawable/account_ui_bg_login_edit"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="46.7dp"
        android:hint="@string/account_ui_account_input_new_password"
        android:inputType="textPassword"
        android:textAlignment="viewStart"
        android:paddingStart="@dimen/account_ui_size_15dp"
        android:paddingEnd="@dimen/account_ui_size_15dp"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="@dimen/account_ui_size_12sp"
        android:textColor="@color/s2"
        android:id="@+id/set_password_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/account_ui_size_12dp"
        android:layout_marginBottom="@dimen/account_ui_size_12dp"
        android:text="@string/account_ui_register_phone_set_password_tip"/>
    <androidx.appcompat.widget.AppCompatEditText
        android:textSize="@dimen/account_ui_register_phone_password_text_size"
        android:typeface="monospace"
        android:textColor="@color/s1"
        android:textColorHint="@color/s3"
        android:gravity="start|center_vertical"
        android:id="@+id/ev_password_confirm"
        android:background="@drawable/account_ui_bg_login_edit"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:hint="@string/account_ui_account_input_new_password_again"
        android:inputType="textPassword"
        android:textAlignment="viewStart"
        android:paddingStart="@dimen/account_ui_size_15dp"
        android:paddingEnd="@dimen/account_ui_size_15dp"/>
    <TextView
        android:enabled="false"
        android:textSize="@dimen/account_ui_login_btn_text_size"
        android:textColor="@color/account_ui_select_alive_btn_txt_color"
        android:gravity="center"
        android:id="@+id/hm_phone_post_register_btn"
        android:background="@drawable/account_ui_btn_bg_login"
        android:layout_width="match_parent"
        android:layout_height="@dimen/account_ui_click_button_h"
        android:layout_marginTop="60dp"
        android:text="@string/account_ui_btn_confirm"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:id="@+id/phone_login_title"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15.7dp"
        android:text="@string/account_ui_register_phone_set_password_title"
        style="@style/AccountUiPhoneLoginTitle"/>
</LinearLayout>
