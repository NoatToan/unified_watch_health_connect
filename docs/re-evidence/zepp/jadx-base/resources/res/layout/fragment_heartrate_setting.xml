<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pai_hr_warning"
    android:background="@color/s38"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="63.8dp">
    <ImageView
        android:id="@+id/icon_hr_warning"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/pai_icon_hr_warning"
        android:layout_marginStart="20.7dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/s38"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="11.3dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/icon_hr_divide"
        app:layout_constraintStart_toEndOf="@+id/icon_hr_warning"
        app:layout_constraintTop_toTopOf="parent">
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="15sp"
            android:textColor="@color/s1"
            android:gravity="start|bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pai_warning_info1"
            android:fontFamily="lt"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="12sp"
            android:textColor="@color/s2"
            android:gravity="start|top"
            android:id="@+id/pai_hr_warning_info_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pai_warning_info2"
            android:fontFamily="lt"/>
    </LinearLayout>
    <View
        android:id="@+id/icon_hr_divide"
        android:background="@color/pai_line_color"
        android:layout_width="1px"
        android:layout_height="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/icon_hr_open"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:background="@color/pai_line_color"
        android:layout_width="match_parent"
        android:layout_height="1px"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="15.3sp"
        android:textColor="@color/p4"
        android:gravity="center"
        android:id="@+id/icon_hr_open"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="97dp"
        android:minWidth="57dp"
        android:text="@string/open"
        android:fontFamily="lt"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
