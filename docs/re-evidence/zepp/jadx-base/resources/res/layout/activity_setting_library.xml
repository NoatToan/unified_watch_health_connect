<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.huami.lib.rainbow.ListTile
        android:id="@+id/mi_laptop_item"
        android:background="@color/s10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/container"
        app:ltv_checked="true"
        app:ltv_title="@string/mi_laptop_unlock"/>
    <com.huami.lib.rainbow.ListTile
        android:id="@+id/take_pic"
        android:background="@color/s10"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/mi_laptop_item"
        app:ltv_tips="@string/bracelet_desc_take_pic"
        app:ltv_title="@string/title_take_pic"/>
    <com.huami.lib.rainbow.ListTile
        android:id="@+id/mili_setting_off_wrist_lock_ll"
        android:background="@color/s10"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/take_pic"
        android:onClick="onClick"
        app:ltv_tips="@string/off_wrist_tips"
        app:ltv_title="@string/mili_setting_off_wist_lock"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/s15"
        android:id="@+id/click_for_help"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:text="@string/click_for_help"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
