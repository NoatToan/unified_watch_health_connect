<?xml version="1.0" encoding="utf-8"?>
<com.huami.lib.rainbow.shapeable.ShapeableConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s45"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:shapeAppearance="@style/ShapeAppearance.App.Rounded">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/header_image"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dialog_header_image_height"
        android:scaleType="center"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/s46"
        android:gravity="center"
        android:id="@+id/title"
        android:paddingTop="@dimen/size_30dp"
        android:paddingBottom="@dimen/size_20dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/size_20dp"
        android:paddingEnd="@dimen/size_20dp"
        app:layout_constraintTop_toBottomOf="@+id/header_image"
        style="@style/Rainbow.TextAppearance.Title2"/>
    <TextView
        android:textColor="@color/s46"
        android:id="@+id/content"
        android:paddingBottom="@dimen/size_30dp"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="15"
        android:paddingStart="@dimen/size_20dp"
        android:paddingEnd="@dimen/size_20dp"
        app:layout_constraintBottom_toTopOf="@+id/divider"
        app:layout_constraintTop_toBottomOf="@+id/title"
        app:layout_goneMarginTop="@dimen/size_30dp"
        style="@style/Rainbow.TextAppearance.Body3"/>
    <View
        android:id="@+id/divider"
        android:background="@color/s46"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="@dimen/size_56dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <TextView
        android:textColor="@color/s46"
        android:gravity="center"
        android:id="@+id/negative_button"
        android:layout_width="0dp"
        android:layout_height="55dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/positive_button"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/Rainbow.TextAppearance.Body3"/>
    <TextView
        android:textColor="@color/s46"
        android:gravity="center"
        android:id="@+id/positive_button"
        android:layout_width="0dp"
        android:layout_height="55dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/negative_button"
        style="@style/Rainbow.TextAppearance.Body3"/>
</com.huami.lib.rainbow.shapeable.ShapeableConstraintLayout>
