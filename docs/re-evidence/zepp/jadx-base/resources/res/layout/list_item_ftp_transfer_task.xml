<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:focusable="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:gravity="center_vertical"
        android:id="@+id/task_item_head"
        android:background="@color/s38"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="48dp">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/s2"
            android:gravity="start|center_vertical"
            android:id="@+id/task_item_head_title"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:minWidth="70dp"
            android:singleLine="true"
            android:layout_marginStart="20dp"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/s2"
            android:gravity="center"
            android:id="@+id/task_item_head_retry_btn"
            android:background="@drawable/retry_upload_botton"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:minWidth="86dp"
            android:text="@string/file_manager_retry_all"
            android:layout_marginEnd="20dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/ftp_file_list_bg"
        android:layout_width="match_parent"
        android:layout_height="74dp"
        android:layout_marginTop="7dp"
        android:layout_marginBottom="7dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp">
        <ImageView
            android:id="@+id/task_item_img"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="15dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:focusable="true"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/s1"
                android:ellipsize="middle"
                android:id="@+id/task_item_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"/>
            <ProgressBar
                android:id="@+id/task_item_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:maxHeight="4dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/ftp_progress_horizontal"
                android:minHeight="4dp"
                style="?android:attr/progressBarStyleHorizontal"/>
        </LinearLayout>
        <View
            android:id="@+id/task_item_retry_btn"
            android:background="@drawable/ftp_icon_retry_button"
            android:visibility="gone"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="15dp"
            android:backgroundTint="@color/ftp_icon_transport_list_button_tint"/>
        <View
            android:id="@+id/task_item_remove_btn"
            android:background="@drawable/ic_delete_20"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="15dp"
            android:backgroundTint="@color/ftp_icon_transport_list_button_tint"/>
    </LinearLayout>
</LinearLayout>
