<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/header_bg"
        android:background="@color/s36"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/extra_msg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/order_state"
        app:layout_constraintVertical_bias="0"/>
    <TextView
        android:textSize="@dimen/t5.5"
        android:textColor="@color/s2"
        android:gravity="center_horizontal"
        android:id="@+id/order_state"
        android:paddingTop="@dimen/size_36dp"
        android:paddingBottom="@dimen/size_36dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:drawablePadding="8dp"
        android:paddingStart="@dimen/size_18dp"
        android:paddingEnd="@dimen/size_18dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/t4"
        android:textColor="@color/s3"
        android:gravity="center_horizontal"
        android:id="@+id/extra_msg"
        android:paddingTop="@dimen/size_10dp"
        android:paddingBottom="@dimen/size_36dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/size_18dp"
        android:paddingEnd="@dimen/size_18dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/order_state"/>
    <Space
        android:id="@+id/space"
        android:layout_width="match_parent"
        android:layout_height="@dimen/wl_item_spacing"
        app:layout_constraintTop_toBottomOf="@+id/extra_msg"/>
    <View
        android:id="@+id/header_divider1"
        android:background="@color/s4"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/extra_msg"/>
    <View
        android:id="@+id/header_divider2"
        android:background="@color/s4"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/space"/>
</androidx.constraintlayout.widget.ConstraintLayout>
