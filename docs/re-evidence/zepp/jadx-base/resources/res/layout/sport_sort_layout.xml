<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/pale_grey_two"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/black40"
        android:gravity="center_vertical"
        android:id="@+id/sort_top_label"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:text="@string/sort_top_label"
        android:layout_below="@+id/container"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"/>
    <View
        android:id="@+id/sort_top_divider"
        android:background="@color/black20"
        android:layout_width="match_parent"
        android:layout_height="0.33dp"
        android:layout_below="@+id/sort_top_label"/>
    <com.xiaomi.hm.health.view.dslv.DragSortListView xmlns:dslv="http://schemas.android.com/apk/res-auto"
        android:id="@+id/sort_listview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@color/black20"
        android:dividerHeight="0.33dp"
        android:layout_below="@+id/sort_top_divider"
        android:footerDividersEnabled="false"
        dslv:collapsed_height="2dp"
        dslv:drag_enabled="true"
        dslv:drag_scroll_start="0.33"
        dslv:float_alpha="0.6"
        dslv:max_drag_scroll_speed="0.5"
        dslv:slide_shuffle_speed="0.3"
        dslv:use_default_controller="false"/>
    <View
        android:id="@+id/mask_view"
        android:background="#77f7f7f7"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/container"/>
</RelativeLayout>
