<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/heartRateRestLayout"
        android:paddingLeft="@dimen/heart_rate_size_15dp"
        android:paddingTop="@dimen/heart_rate_size_21dp"
        android:paddingRight="@dimen/heart_rate_size_15dp"
        android:paddingBottom="@dimen/heart_rate_size_21dp"
        android:layout_marginLeft="@dimen/heart_rate_size_15dp"
        android:layout_marginTop="0dp"
        android:layout_marginRight="@dimen/heart_rate_size_15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/HeartRateDetailContainerStyle">
        <TextView
            android:textColor="@color/s1"
            android:id="@+id/hr_whole_day_rest_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/heart_rate_rest"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/hr_whole_day_rest"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_weight="1"
            style="@style/Rainbow.TextAppearance.Body3"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="15sp"
            android:textColor="@color/s2"
            android:gravity="end"
            android:id="@+id/hr_whole_day_rest"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            app:drawableTint="@color/s2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/hr_whole_day_rest_info"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="wrap"
            app:layout_constraintWidth_percent="0.4"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/abnormalHeartBeatLayout"
        android:paddingLeft="@dimen/heart_rate_size_15dp"
        android:paddingTop="@dimen/heart_rate_size_21dp"
        android:paddingRight="@dimen/heart_rate_size_15dp"
        android:paddingBottom="@dimen/heart_rate_size_21dp"
        android:visibility="gone"
        android:layout_marginLeft="@dimen/heart_rate_size_15dp"
        android:layout_marginRight="@dimen/heart_rate_size_15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/heartRateRestLayout"
        style="@style/HeartRateDetailContainerStyle">
        <TextView
            android:textColor="@color/s1"
            android:id="@+id/tvAbnormalHeartBeatInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/heart_rate_abnormal_heart_beat"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tvAbnormalHeartBeat"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_weight="1"
            style="@style/Rainbow.TextAppearance.Body3"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="15sp"
            android:textColor="@color/s2"
            android:gravity="end"
            android:id="@+id/tvAbnormalHeartBeat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            app:drawableTint="@color/s2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tvAbnormalHeartBeatInfo"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="wrap"
            app:layout_constraintWidth_percent="0.4"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/heartRateValuesInfoLayout"
        android:padding="@dimen/heart_rate_size_15dp"
        android:layout_marginLeft="@dimen/heart_rate_size_15dp"
        android:layout_marginRight="@dimen/heart_rate_size_15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/abnormalHeartBeatLayout"
        style="@style/HeartRateDetailContainerStyle">
        <com.huami.heartrate.ui.StatisticsView
            android:id="@+id/statisticsView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/heartRateInfoLayout"
        android:paddingLeft="@dimen/heart_rate_size_15dp"
        android:paddingTop="12dp"
        android:paddingRight="@dimen/heart_rate_size_15dp"
        android:paddingBottom="10dp"
        android:visibility="gone"
        android:layout_marginLeft="@dimen/heart_rate_size_15dp"
        android:layout_marginRight="@dimen/heart_rate_size_15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/heartRateValuesInfoLayout"
        style="@style/HeartRateDetailContainerStyle">
        <com.huami.widget.typeface.TypefaceTextView
            android:textColor="@color/s1"
            android:id="@+id/textHeartRateRange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/heart_rate_range"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Rainbow.TextAppearance.Title2"/>
        <com.huami.widget.colorbar.ColorBarView
            android:id="@+id/hr_whole_day_section"
            android:layout_width="match_parent"
            android:layout_height="7dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            app:colorBarCapType="round"
            app:layout_constraintBottom_toTopOf="@+id/hr_section"
            app:layout_constraintTop_toBottomOf="@+id/textHeartRateRange"/>
        <com.huami.heartrate.view.HeartRateSectionView
            android:id="@+id/hr_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/hr_whole_day_section"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/measureResultLayout"
        android:paddingLeft="@dimen/heart_rate_size_15dp"
        android:paddingTop="@dimen/heart_rate_size_21dp"
        android:paddingRight="@dimen/heart_rate_size_15dp"
        android:paddingBottom="@dimen/heart_rate_size_21dp"
        android:layout_marginLeft="@dimen/heart_rate_size_15dp"
        android:layout_marginRight="@dimen/heart_rate_size_15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/heartRateInfoLayout"
        style="@style/HeartRateDetailContainerStyle">
        <com.huami.widget.typeface.TypefaceTextView
            android:textColor="@color/s1"
            android:gravity="start"
            android:id="@+id/tvMeasureResultInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/heart_rate_manual_measure_value"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Rainbow.TextAppearance.Body3"/>
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_arrow_forward_20"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/s2"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/heartRateExplainLayout"
        android:padding="@dimen/heart_rate_size_15dp"
        android:layout_marginLeft="@dimen/heart_rate_size_15dp"
        android:layout_marginRight="@dimen/heart_rate_size_15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/measureResultLayout"
        style="@style/HeartRateDetailContainerStyle">
        <com.huami.widget.typeface.TypefaceTextView
            android:textColor="@color/s1"
            android:id="@+id/tvHeartRateExplainTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/heart_rate_name"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Rainbow.TextAppearance.Title2"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/s2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/heart_rate_card_intro_heart_rate_info"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvHeartRateExplainTitle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="@dimen/sp_12"
        android:textColor="@color/s3"
        android:id="@+id/tvDeviceSupportDesc"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/heart_rate_size_25dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="@dimen/heart_rate_size_25dp"
        android:text="この機能は、一部のデバイスでのみサポートされています"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/heartRateExplainLayout"/>
</androidx.constraintlayout.widget.ConstraintLayout>
