<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.lib.rainbow.titlebar.RainbowTitleBar
        android:id="@+id/tv_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_arrow_back_20_2x"
        app:title="@string/fh_period_setting"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/mine_hmscrollview"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="13sp"
                android:textColor="@color/s1"
                android:layout_gravity="start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="@string/fh_no_record_add"
                android:layout_marginStart="@dimen/fh_setting_item_horizontal_margin"/>
            <androidx.cardview.widget.CardView
                android:id="@+id/fh_card_layout_first"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="-6dp"
                android:layout_marginStart="@dimen/fh_setting_item_horizontal_margin"
                android:layout_marginEnd="@dimen/fh_setting_item_horizontal_margin"
                app:cardBackgroundColor="@color/s38"
                app:cardCornerRadius="@dimen/fh_setting_item_corner_radius"
                app:cardElevation="@dimen/fh_setting_item_card_elevation"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_goals_first"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <com.huami.lib.rainbow.ListTile
                        android:id="@+id/item_fh_period_long"
                        android:layout_width="match_parent"
                        android:layout_height="67dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:ltv_subtitle="@string/fh_item_fh_period_long_summary"
                        app:ltv_title="@string/fh_item_fh_period_long"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:id="@+id/fh_card_layout_second"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-6dp"
                android:layout_marginBottom="-6dp"
                android:layout_marginStart="@dimen/fh_setting_item_horizontal_margin"
                android:layout_marginEnd="@dimen/fh_setting_item_horizontal_margin"
                app:cardBackgroundColor="@color/s38"
                app:cardCornerRadius="@dimen/fh_setting_item_corner_radius"
                app:cardElevation="@dimen/fh_setting_item_card_elevation"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_goals_second"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <com.huami.lib.rainbow.ListTile
                        android:id="@+id/item_fh_physiological_long"
                        android:layout_width="match_parent"
                        android:layout_height="70dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:ltv_subtitle="@string/fh_item_physiological_long_summary"
                        app:ltv_title="@string/fh_item_physiological_long"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:id="@+id/fh_card_layout_third"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-6dp"
                android:layout_marginStart="@dimen/fh_setting_item_horizontal_margin"
                android:layout_marginEnd="@dimen/fh_setting_item_horizontal_margin"
                app:cardBackgroundColor="@color/s38"
                app:cardCornerRadius="@dimen/fh_setting_item_corner_radius"
                app:cardElevation="@dimen/fh_setting_item_card_elevation"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_goals_third"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <com.huami.lib.rainbow.ListTile
                        android:id="@+id/item_fh_period_last_time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toTopOf="parent"
                        app:ltv_subtitle="@string/fh_item_physiological_last_time"
                        app:ltv_title="@string/fh_item_last_period_time"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:id="@+id/fh_layout_fourth"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="15dp"
                android:layout_marginStart="@dimen/fh_setting_item_horizontal_margin"
                android:layout_marginEnd="@dimen/fh_setting_item_horizontal_margin"
                app:cardBackgroundColor="@color/s38"
                app:cardCornerRadius="@dimen/fh_setting_item_corner_radius"
                app:cardElevation="@dimen/fh_setting_item_card_elevation"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/fh_layout_first">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_goals_fourth"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <com.huami.lib.rainbow.ListTile
                        android:id="@+id/item_card_forecast"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toTopOf="parent"
                        app:ltv_checked="true"/>
                    <com.huami.widget.typeface.TypefaceTextView
                        android:textSize="13sp"
                        android:textColor="@color/s1"
                        android:gravity="center_vertical"
                        android:id="@+id/tv_card_forecast"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/fh_layout_second"
                        android:layout_marginStart="@dimen/fh_setting_item_horizontal_margin"
                        app:layout_constraintBottom_toBottomOf="@+id/item_card_forecast"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/item_card_forecast"/>
                    <ImageView
                        android:id="@+id/iv_forecast_icon"
                        android:padding="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toBottomOf="@+id/tv_card_forecast"
                        app:layout_constraintStart_toEndOf="@+id/tv_card_forecast"
                        app:layout_constraintTop_toTopOf="@+id/tv_card_forecast"
                        app:srcCompat="@drawable/fh_help"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>
            <Button
                android:enabled="false"
                android:id="@+id/btn_complete"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="270dp"
                android:text="@string/fh_btn_finish"
                android:layout_marginStart="@dimen/fh_btn_horizontal_margin"
                android:layout_marginEnd="@dimen/fh_btn_horizontal_margin"
                style="@style/Rainbow.Widget.Button.44"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
