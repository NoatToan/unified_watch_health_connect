<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <fragment
        android:name="com.xiaomi.hm.health.bodyfat.fragment.BalanceScoreFragment"
        android:id="@+id/score_fragment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <fragment
        android:name="com.xiaomi.hm.health.bodyfat.fragment.BalanceRankFragment"
        android:id="@+id/rank_fragment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@+id/score_fragment"/>
    <include
        android:id="@+id/layout_intro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@+id/rank_fragment"
        layout="@layout/card_status_introduces"/>
</androidx.constraintlayout.widget.ConstraintLayout>
