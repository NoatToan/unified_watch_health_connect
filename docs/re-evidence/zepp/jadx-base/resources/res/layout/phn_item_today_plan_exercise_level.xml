<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/tv_item_exercise_level_title"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:layout_marginBottom="30dp"
        android:text="@string/phn_tasks_low_intensity_exercise"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Rainbow.TextAppearance.Body3"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/tv_item_average_heart_rate_data"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginStart="22dp"
        app:layout_constraintStart_toEndOf="@+id/tv_item_exercise_level_title"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Rainbow.TextAppearance.Number4"/>
    <TextView
        android:textColor="@color/s3"
        android:id="@+id/tv_item_average_heart_rate_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/phn_average_heart_rate_unit"
        android:layout_marginStart="5dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_item_average_heart_rate_data"
        app:layout_constraintStart_toEndOf="@+id/tv_item_average_heart_rate_data"
        app:layout_constraintTop_toTopOf="@+id/tv_item_average_heart_rate_data"
        style="@style/Rainbow.TextAppearance.Body5"/>
    <TextView
        android:textColor="@color/s2"
        android:id="@+id/tv_item_average_heart_rate_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="100dp"
        android:text="@string/phn_average_heart_rate"
        app:layout_constraintEnd_toEndOf="@+id/tv_item_average_heart_rate_data"
        app:layout_constraintStart_toStartOf="@+id/tv_item_average_heart_rate_data"
        app:layout_constraintTop_toBottomOf="@+id/tv_item_average_heart_rate_data"
        style="@style/Rainbow.TextAppearance.Body5"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/tv_item_exercise_time_data"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginStart="43dp"
        app:layout_constraintStart_toEndOf="@+id/tv_item_average_heart_rate_unit"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Rainbow.TextAppearance.Number4"/>
    <TextView
        android:textColor="@color/s3"
        android:id="@+id/tv_item_exercise_time_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_item_exercise_time_data"
        app:layout_constraintStart_toEndOf="@+id/tv_item_exercise_time_data"
        app:layout_constraintTop_toTopOf="@+id/tv_item_exercise_time_data"
        style="@style/Rainbow.TextAppearance.Body5"/>
    <TextView
        android:textColor="@color/s2"
        android:id="@+id/tv_item_exercise_time_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="100dp"
        android:text="@string/phn_exercise_time"
        app:layout_constraintEnd_toEndOf="@+id/tv_item_exercise_time_data"
        app:layout_constraintStart_toStartOf="@+id/tv_item_exercise_time_data"
        app:layout_constraintTop_toBottomOf="@+id/tv_item_exercise_time_data"
        style="@style/Rainbow.TextAppearance.Body5"/>
    <View
        android:id="@+id/v_line_level"
        android:background="@color/s4"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="138dp"
        android:layout_marginEnd="17dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
