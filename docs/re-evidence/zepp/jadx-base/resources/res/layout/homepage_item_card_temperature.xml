<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="185dp">
    <com.huami.module.homepage.cards.cardui.CardTitleBarView
        android:id="@+id/temperature_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:titleText="@string/homepage_item_card_temperature"/>
    <com.huami.module.homepage.cards.cardui.PairCircleView
        android:id="@+id/pairCircleView"
        android:layout_width="130dp"
        android:layout_height="130dp"
        android:layout_marginBottom="15dp"
        android:layout_marginStart="19dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1"/>
    <ImageView
        android:id="@+id/icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginTop="30dp"
        android:src="@drawable/ic_temperature_28_s20"
        app:layout_constraintEnd_toEndOf="@+id/pairCircleView"
        app:layout_constraintStart_toStartOf="@+id/pairCircleView"
        app:layout_constraintTop_toTopOf="@+id/pairCircleView"/>
    <com.huami.module.homepage.cards.cardui.PiecewiseLineView
        android:id="@+id/piecewiseLineView"
        android:layout_width="0dp"
        android:layout_height="20dp"
        android:layout_marginBottom="68dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toEndOf="@+id/pairCircleView"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/temperature_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:layout_marginStart="5dp"
        app:layout_constraintBottom_toTopOf="@+id/piecewiseLineView"
        app:layout_constraintStart_toStartOf="@+id/piecewiseLineView"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toEndOf="@+id/pairCircleView"
        app:layout_constraintTop_toBottomOf="@+id/piecewiseLineView"
        app:layout_constraintVertical_bias="0">
        <com.huami.module.homepage.cards.cardui.I18nNumberView
            android:textColor="@color/s2"
            android:id="@+id/temperature_none"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            app:numberText="@string/homepage_temperature_low_c"
            app:unitText="@string/homepage_temperature_unit_c"
            style="@style/Rainbow.TextAppearance.Body4"/>
        <com.huami.module.homepage.cards.cardui.I18nNumberView
            android:textColor="@color/s2"
            android:id="@+id/temperature_normal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            app:numberText="@string/homepage_temperature_middle_c"
            app:unitText="@string/homepage_temperature_unit_c"
            style="@style/Rainbow.TextAppearance.Body4"/>
        <com.huami.module.homepage.cards.cardui.I18nNumberView
            android:textColor="@color/s2"
            android:id="@+id/temperature_abnormal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            app:numberText="@string/homepage_temperature_high_c"
            app:unitText="@string/homepage_temperature_unit_c"
            style="@style/Rainbow.TextAppearance.Body4"/>
    </RelativeLayout>
    <com.huami.module.homepage.cards.cardui.BackgroundTextView
        android:textColor="@color/s1"
        android:gravity="center"
        android:id="@+id/mask"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:text="@string/homepage_item_card_no_temperature_data"
        app:backgroundTintAlpha="0.92"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/temperature_bar"
        style="@style/Rainbow.TextAppearance.Body4"/>
</androidx.constraintlayout.widget.ConstraintLayout>
