<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:background="@drawable/divider_settings_item"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <LinearLayout
        android:orientation="horizontal"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="53dp">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/dark_grey_text"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/password"
            android:layout_marginStart="24dp"/>
        <com.huami.watch.companion.ui.view.PasswordEditText
            android:textSize="14sp"
            android:textColor="@color/black_text"
            android:textColorHint="@color/grey_text"
            android:gravity="start|center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/wifi_pwd_edit_box"
            android:background="@color/white"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:hint="@string/wifi_password_edit_hint"
            android:maxLines="1"
            android:layout_weight="1"
            android:inputType="textPassword"
            android:textCursorDrawable="@drawable/cursor_edit_box"
            android:layout_marginStart="34dp"
            android:layout_marginEnd="16dp"/>
    </LinearLayout>
</LinearLayout>
