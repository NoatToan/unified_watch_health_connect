<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.watch.companion.ui.view.ActionbarLayout
        android:id="@+id/action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ImageView
        android:id="@+id/img"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:src="@drawable/bg_ocr_tip"
        android:layout_below="@+id/action_bar"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#80000000"
        android:id="@+id/tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/ocr_tip_smart"
        android:layout_below="@+id/img"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:background="#ffffff"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_gallery_text"
            android:gravity="center"
            android:background="@drawable/bg_gallery"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:text="@string/ocr_gallery"
            android:layout_weight="1"
            android:onClick="gallery"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_capture_text"
            android:gravity="center"
            android:background="@drawable/bg_capture"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:text="@string/ocr_capture"
            android:layout_weight="1"
            android:onClick="capture"
            android:layout_marginStart="12dp"/>
    </LinearLayout>
</RelativeLayout>
