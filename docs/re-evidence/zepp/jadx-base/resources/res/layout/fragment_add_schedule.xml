<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.lib.rainbow.titlebar.RainbowTitleBar
        android:id="@+id/action_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Rainbow.TextAppearance.Title3"/>
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/schedule_delete"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_bar">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_15dp"
            android:layout_marginStart="@dimen/size_15dp"
            android:layout_marginEnd="@dimen/size_15dp">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_show"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@drawable/bg_white_round_corner"
                    android:paddingTop="21dp"
                    android:paddingBottom="21dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp">
                    <TextView
                        android:textSize="20sp"
                        android:textColor="@color/s1"
                        android:id="@+id/show_schedule_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp">
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/s2"
                            android:id="@+id/show_schedule_start"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/s2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="5dp"
                            android:layout_marginRight="5dp"
                            android:text="-"/>
                        <TextView
                            android:textColor="@color/s2"
                            android:id="@+id/show_schedule_end"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Rainbow.TextAppearance.Number7"/>
                    </LinearLayout>
                    <TextView
                        android:textColor="@color/s1"
                        android:id="@+id/show_reminder_desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        style="@style/Rainbow.TextAppearance.Number7"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/s2"
                        android:id="@+id/show_schedule_address"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@drawable/bg_white_round_corner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:layout_width="match_parent"
                        android:layout_height="64dp">
                        <TextView
                            android:textColor="@color/s1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/repeat"
                            style="@style/Rainbow.TextAppearance.Number6"/>
                        <TextView
                            android:textColor="@color/s2"
                            android:ellipsize="middle"
                            android:gravity="end"
                            android:id="@+id/show_schedule_reminder_type"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:layout_marginStart="15dp"
                            style="@style/Rainbow.TextAppearance.Number7"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:layout_width="match_parent"
                        android:layout_height="64dp">
                        <TextView
                            android:textColor="@color/s1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/remind"
                            style="@style/Rainbow.TextAppearance.Number6"/>
                        <TextView
                            android:textColor="@color/s2"
                            android:ellipsize="end"
                            android:gravity="end"
                            android:id="@+id/show_schedule_reminder_min"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:layout_marginStart="15dp"
                            style="@style/Rainbow.TextAppearance.Number7"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_edit"
                android:background="@drawable/bg_dialog"
                android:focusableInTouchMode="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <EditText
                    android:textColorHint="@color/s2"
                    android:id="@+id/et_schedule_title"
                    android:background="@drawable/bg_edittext_new"
                    android:padding="@dimen/size_9dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_13dp"
                    android:layout_marginBottom="@dimen/size_11dp"
                    android:minHeight="@dimen/size_64dp"
                    android:hint="@string/schedule_title"
                    android:maxLength="60"
                    android:layout_marginStart="@dimen/d4"
                    android:layout_marginEnd="@dimen/d4"
                    style="@style/ScheduleEditTextStyle"/>
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/reminder_all_day"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ltv_checked="false"
                    app:ltv_title="@string/all_day_event"/>
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/tv_schedule_start"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ltv_title="@string/start_time"/>
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/tv_schedule_end"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ltv_title="@string/end_time"/>
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/tv_schedule_reminder_type"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ltv_title="@string/repeat"/>
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/tv_schedule_reminder_min"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ltv_tips="@string/repeat_never"
                    app:ltv_title="@string/remind"/>
                <EditText
                    android:textColorHint="@color/s2"
                    android:gravity="top"
                    android:layout_gravity="top"
                    android:id="@+id/reminder_desc"
                    android:background="@drawable/bg_edittext_new"
                    android:padding="@dimen/size_9dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_12dp"
                    android:minHeight="@dimen/size_110dp"
                    android:hint="@string/desc"
                    android:maxLength="200"
                    android:layout_marginStart="@dimen/d4"
                    android:layout_marginEnd="@dimen/d4"
                    style="@style/ScheduleEditTextStyle"/>
                <EditText
                    android:textColorHint="@color/s2"
                    android:id="@+id/et_schedule_address"
                    android:background="@drawable/bg_edittext_new"
                    android:paddingLeft="@dimen/size_9dp"
                    android:paddingRight="@dimen/size_9dp"
                    android:layout_width="match_parent"
                    android:layout_marginTop="@dimen/size_12dp"
                    android:layout_marginBottom="@dimen/size_12dp"
                    android:minHeight="@dimen/size_64dp"
                    android:hint="@string/schedule_address"
                    android:maxLength="60"
                    android:layout_marginStart="@dimen/d4"
                    android:layout_marginEnd="@dimen/d4"
                    style="@style/ScheduleEditTextStyle"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <Button
        android:id="@+id/schedule_delete"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size_15dp"
        android:text="@string/delete"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/Rainbow.Widget.Button.48"/>
</androidx.constraintlayout.widget.ConstraintLayout>
