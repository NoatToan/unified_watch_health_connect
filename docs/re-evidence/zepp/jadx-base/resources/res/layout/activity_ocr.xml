<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.watch.companion.ui.view.ActionbarLayout
        android:id="@+id/action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ImageView
        android:id="@+id/pic"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:scaleType="centerInside"/>
    <androidx.core.widget.NestedScrollView
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:background="#ffffff"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="horizontal"
                    android:paddingTop="20dp"
                    android:paddingBottom="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp">
                    <TextView
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#e6000000"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:text="@string/ocr_event_title"/>
                    <com.huami.watch.companion.ui.view.ClearableEditText
                        android:textSize="12sp"
                        android:textColor="#e6000000"
                        android:textColorHint="#dc2b0b"
                        android:id="@+id/ocr_title"
                        android:background="#ffffff"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/ocr_event_hint"
                        android:maxLength="30"
                        android:textCursorDrawable="@drawable/cursor_edit_box"/>
                </LinearLayout>
                <View
                    android:background="@drawable/divider_line_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:background="?attr/selectableItemBackground"
                    android:paddingTop="20dp"
                    android:paddingBottom="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:onClick="selectEventTime"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp">
                    <TextView
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#e6000000"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:text="@string/ocr_event_time"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#80000000"
                        android:textColorHint="#dc2b0b"
                        android:gravity="end|center_vertical"
                        android:id="@+id/ocr_time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/ocr_event_hint"
                        android:drawablePadding="10dp"
                        android:drawableEnd="@drawable/ic_right_arrow"/>
                </LinearLayout>
                <View
                    android:background="@drawable/divider_line_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:paddingTop="20dp"
                    android:paddingBottom="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp">
                    <TextView
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#e6000000"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:text="@string/ocr_event_desc"/>
                    <com.huami.watch.companion.ui.view.ClearableEditText
                        android:textSize="12sp"
                        android:textColor="#e6000000"
                        android:textColorHint="#dc2b0b"
                        android:id="@+id/ocr_desc"
                        android:background="#ffffff"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/ocr_event_hint"
                        android:maxLength="150"
                        android:textCursorDrawable="@drawable/cursor_edit_box"/>
                </LinearLayout>
                <View
                    android:background="@drawable/divider_line_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:background="#ffffff"
                android:padding="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:onClick="selectReminder">
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#e6000000"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="@string/remind"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#80000000"
                    android:gravity="end|center_vertical"
                    android:id="@+id/ocr_reminder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="10dp"
                    android:drawableEnd="@drawable/ic_right_arrow"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
