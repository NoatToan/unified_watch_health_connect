<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/s10"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/title_container"
        android:background="@color/s38"
        android:layout_width="match_parent"
        android:layout_height="46dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/title_back_img"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/arrow_back_black"
            android:scaleType="centerInside"
            android:tint="@color/s1"
            android:layout_centerVertical="true"
            android:layout_marginStart="11dp"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textStyle="bold"
            android:textColor="@color/s1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/select_city_title"
            android:layout_centerInParent="true"
            style="@style/CommonToolbarTitleStyleBlack"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/search_title_container"
        android:background="@color/s38"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="46dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/back_img"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/arrow_back_black"
            android:scaleType="centerInside"
            android:tint="@color/s1"
            android:layout_marginStart="11dp"/>
        <FrameLayout
            android:layout_gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="18dp">
            <EditText
                android:textSize="12sp"
                android:textColor="@color/s1"
                android:textColorHint="@color/s3"
                android:id="@+id/city_edit"
                android:background="@drawable/edit_text_bg"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:hint="@string/input_city_name"
                android:maxLines="1"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:textCursorDrawable="@drawable/edittext_cursor"
                android:paddingStart="8dp"
                android:paddingEnd="68dp"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="end|center_vertical"
                android:id="@+id/close_img"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/img_close"
                android:scaleType="centerInside"
                android:tint="@color/s1"
                android:layout_marginEnd="46dp"/>
            <View
                android:layout_gravity="end|center_vertical"
                android:background="@color/s4"
                android:layout_width="0.5dp"
                android:layout_height="20dp"
                android:layout_marginEnd="39.5dp"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="end|center_vertical"
                android:id="@+id/edit_search_img"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/warn_search"
                android:scaleType="centerInside"
                android:tint="@color/s1"
                android:layout_marginEnd="9dp"/>
        </FrameLayout>
    </LinearLayout>
    <ScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.huami.lib.rainbow.ListTile
                android:id="@+id/auto_locate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ltv_checked="true"
                app:ltv_title="@string/auto_locate"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/search_city_edit"
                android:background="@color/s38"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/warn_search"
                    android:tint="@color/s1"
                    android:layout_marginStart="18dp"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/s3"
                    android:gravity="center_vertical"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/input_city_name"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/s1"
                android:id="@+id/current_selected_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="@string/current_selected"
                android:layout_marginStart="18dp"/>
            <TextView
                android:textColor="@color/dark_sky_blue_three"
                android:ellipsize="none"
                android:gravity="center"
                android:id="@+id/selected_city_tv"
                android:background="@drawable/text_rect_bg_blue"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:layout_width="96dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:maxLines="5"
                android:singleLine="false"
                android:layout_marginStart="18dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/quick_select_container"
                android:layout_width="match_parent"
                android:layout_height="394dp">
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/s1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:text="@string/quick_select"
                    android:layout_marginStart="18dp"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/quick_select_list"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:overScrollMode="never"/>
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/search_result_list"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never"/>
            <FrameLayout
                android:id="@+id/no_result_container"
                android:background="@color/s38"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="9dp">
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/s2"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/no_result_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="120dp"
                    android:text="@string/no_match_city"/>
            </FrameLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
