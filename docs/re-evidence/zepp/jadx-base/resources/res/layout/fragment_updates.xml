<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#f4f5f7"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.watch.companion.ui.view.ActionbarLayout
        android:id="@+id/actionbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/layout_dynamic_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/actionbar">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_no_event"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#999999"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/no_updates"
            android:lineSpacingExtra="0sp"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_update"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="55dp"
        android:layout_below="@+id/actionbar"/>
    <com.oubowu.stickyitemdecoration.StickyHeadContainer
        android:id="@+id/stick_head_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/actionbar">
        <com.huami.assistant.ui.widget.DateInfoView
            android:gravity="center_vertical"
            android:id="@+id/tv_top_date"
            android:background="#f8f8f8"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_centerVertical="true"
            android:paddingStart="20dp"/>
    </com.oubowu.stickyitemdecoration.StickyHeadContainer>
    <RelativeLayout
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="54.6dp"
        android:layout_alignParentBottom="true"
        android:elevation="15dp">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">
            <TextView
                android:textSize="10sp"
                android:textColor="#e6000000"
                android:gravity="center_horizontal"
                android:id="@+id/iv_add"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/smart_add"
                android:drawableTop="@drawable/ic_smart_add"
                android:drawablePadding="2dp"
                android:layout_marginEnd="69dp"/>
            <TextView
                android:textSize="10sp"
                android:textColor="#e6000000"
                android:gravity="center_horizontal"
                android:id="@+id/iv_more"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/smart_setting"
                android:drawableTop="@drawable/ic_smart_setting"
                android:drawablePadding="2dp"/>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
