<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s36"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/size_18dp"
    android:paddingEnd="@dimen/size_18dp">
    <TextView
        android:textSize="@dimen/size_18sp"
        android:textColor="@color/s1"
        android:id="@+id/tv_community"
        android:layout_width="match_parent"
        android:layout_height="25dp"
        android:layout_marginTop="@dimen/size_15dp"
        android:text="@string/access_door_community_name"
        app:layout_constraintTop_toTopOf="parent"/>
    <EditText
        android:textColor="@color/s2"
        android:id="@+id/et_community"
        android:background="@null"
        android:focusable="false"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="9dp"
        android:text=""
        android:hint="@string/access_door_click_search_support_community"
        android:inputType="text"
        android:paddingEnd="8dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_community"/>
    <View
        android:id="@+id/view_community"
        android:background="@color/s4"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintTop_toBottomOf="@+id/et_community"/>
    <TextView
        android:textSize="@dimen/size_18sp"
        android:textColor="@color/s1"
        android:id="@+id/tv_phone"
        android:layout_width="match_parent"
        android:layout_height="25dp"
        android:layout_marginTop="@dimen/size_15dp"
        android:text="@string/access_door_phone_number"
        app:layout_constraintTop_toBottomOf="@+id/view_community"
        app:layout_goneMarginTop="5dp"/>
    <EditText
        android:textColor="@color/s2"
        android:id="@+id/et_phone"
        android:background="@null"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="9dp"
        android:text=""
        android:hint="@string/access_door_click_input_phone_number"
        android:maxLength="11"
        android:inputType="number"
        android:paddingEnd="8dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_phone"/>
    <View
        android:id="@+id/view_phone"
        android:background="@color/s4"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintTop_toBottomOf="@+id/et_phone"/>
    <TextView
        android:textSize="@dimen/size_12sp"
        android:textColor="@color/s2"
        android:id="@+id/tv_open_card_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_19dp"
        android:text="@string/access_door_open_card_tip"
        android:lineSpacingMultiplier="1.2"
        app:layout_constraintTop_toBottomOf="@+id/view_phone"/>
    <TextView
        android:textSize="@dimen/size_14sp"
        android:textColor="@color/s41"
        android:id="@+id/tv_support"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size_76dp"
        android:text="@string/access_door_support_tip"
        android:layout_centerHorizontal="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <Button
        android:gravity="center"
        android:id="@+id/tv_next_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size_18dp"
        android:text="@string/access_card_next_step"
        app:layout_constraintBottom_toBottomOf="parent"
        style="@style/Rainbow.Widget.Button.38.Circular"/>
</androidx.constraintlayout.widget.ConstraintLayout>
