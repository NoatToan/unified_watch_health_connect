<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/wl_shift_out_bg"
        android:background="@color/s15"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottom_space"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_weight="464"/>
    <ImageView
        android:id="@+id/wl_shift_out_iv"
        android:layout_width="484dp"
        android:layout_height="340dp"
        android:layout_marginTop="@dimen/size_71dp"
        android:layout_marginBottom="8dp"
        android:src="@drawable/ic_nfc_placeholder"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toBottomOf="@+id/wl_shift_out_bg"
        app:layout_constraintEnd_toEndOf="@+id/wl_shift_out_bg"
        app:layout_constraintStart_toStartOf="@+id/wl_shift_out_bg"
        app:layout_constraintTop_toTopOf="@+id/wl_shift_out_bg"/>
    <View
        android:id="@+id/bottom_space"
        android:background="@color/s36"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/wl_shift_out_bg"
        app:layout_constraintVertical_weight="110"/>
    <TextView
        android:textAppearance="@style/TextAppearance.MiFit.Title2"
        android:gravity="center"
        android:id="@+id/wl_shift_out_progress_tv_tips"
        android:paddingLeft="@dimen/size_40dp"
        android:paddingRight="@dimen/size_40dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size_36dp"
        android:text="@string/wl_r_shift_out_progress_tips"
        app:layout_constraintBottom_toBottomOf="@+id/wl_shift_out_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textAppearance="@style/TextAppearance.MiFit.Title.Dim.Inverse"
        android:textColor="@color/s2"
        android:gravity="center"
        android:id="@+id/wl_shift_out_progress_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp"
        android:text="@string/wl_r_shift_out_progress_wait_r"
        app:layout_constraintBottom_toTopOf="@+id/wl_shift_progress_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/bottom_space"
        app:layout_constraintVertical_chainStyle="packed"/>
    <ProgressBar
        android:id="@+id/wl_shift_progress_bar"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="5dp"
        android:max="100"
        android:indeterminateOnly="false"
        android:progressDrawable="@drawable/wl_progress_bar"
        android:layout_marginStart="46dp"
        android:layout_marginEnd="46dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/wl_shift_out_progress_text"
        app:layout_constraintVertical_chainStyle="packed"/>
</androidx.constraintlayout.widget.ConstraintLayout>
