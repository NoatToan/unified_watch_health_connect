                android:layout_height="1dp"
                android:layout_marginStart="@dimen/wl_border_margin"
                android:layout_marginEnd="@dimen/wl_border_margin"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ll_xiaomi_refund"
                android:background="@color/s36"
                android:focusable="true"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/size_58dp"
