                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="@dimen/wl_border_margin"
                android:layout_marginEnd="@dimen/wl_border_margin"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ll_apply_refund"
                android:background="@drawable/wl_clickable_item_background"
                android:focusable="true"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/size_58dp"
                app:layout_constraintTop_toBottomOf="@+id/ll_revert_card">
                <LinearLayout
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/wl_border_margin"
                    android:paddingEnd="@dimen/wl_border_margin">
                    <TextView
                        android:textColor="@color/s2"
                        android:id="@+id/apply_for_refund_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/wl_return_open_card_money"/>
                    <TextView
                        android:textSize="@dimen/sp_12"
                        android:textColor="@color/s3"
                        android:id="@+id/apply_for_refund_tip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/wl_return_open_card_money_tip"/>
                </LinearLayout>
            </LinearLayout>
            <View
                android:id="@+id/ll_apply_refund_divider"
                android:background="@color/s4"
