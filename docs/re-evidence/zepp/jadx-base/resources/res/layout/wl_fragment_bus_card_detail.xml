            android:layout_width="match_parent"
            android:layout_height="@dimen/size_52dp"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.huami.wallet.ui.view.MyTextView
            android:ellipsize="marquee"
            android:id="@+id/wl_tv_detail_xiaomi_notice"
            android:background="@color/s36"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_42dp"
            android:text=""
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:marqueeRepeatLimit="marquee_forever"
            android:paddingStart="@dimen/wl_border_margin"
            android:paddingEnd="@dimen/wl_border_margin"
            app:layout_constraintTop_toBottomOf="@+id/wl_noticebar_view"
