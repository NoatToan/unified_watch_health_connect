                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="@dimen/wl_border_margin"
                android:layout_marginEnd="@dimen/wl_border_margin"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ll_revert_card"
                android:background="@drawable/wl_clickable_item_background"
                android:focusable="true"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/size_58dp"
                app:layout_constraintTop_toBottomOf="@+id/ll_xiaomi_return_card">
                <LinearLayout
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/wl_border_margin"
                    android:paddingEnd="@dimen/wl_border_margin">
                    <TextView
                        android:textAppearance="@style/TextAppearance.MiFit.Title2.Inverse"
                        android:textColor="@color/s2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/wl_return_card"/>
                    <TextView
                        android:textAppearance="@style/TextAppearance.MiFit.Caption.Inverse"
