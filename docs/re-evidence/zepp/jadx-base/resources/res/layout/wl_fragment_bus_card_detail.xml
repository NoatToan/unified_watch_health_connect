                android:paddingStart="@dimen/wl_border_margin"
                android:paddingEnd="@dimen/wl_border_margin"/>
            <View
                android:background="@color/s4"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="@dimen/wl_border_margin"
                android:layout_marginEnd="@dimen/wl_border_margin"/>
            <TextView
