<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.lib.rainbow.titlebar.RainbowTitleBar
        android:id="@+id/tv_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/bolt_eq_title"/>
    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/frame_switch"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="@dimen/size_14sp"
                android:textColor="@color/s1"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_current_equalizer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_14dp"
                android:layout_marginBottom="@dimen/size_13dp"
                android:text="@string/current_equalizer"
                android:layout_marginStart="@dimen/size_17dp"/>
            <androidx.appcompat.widget.SwitchCompat
                android:layout_gravity="end|center_vertical"
                android:id="@+id/eq_switch"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_14dp"
                android:layout_marginBottom="@dimen/size_14dp"
                android:layout_marginEnd="@dimen/size_20dp"
                style="@style/Rainbow.Widget.Switch"/>
        </FrameLayout>
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.9"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/frame_switch">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:weightSum="13.2">
                <com.xiaomi.hm.health.device.view.EqView
                    android:id="@+id/eq_view"
                    android:background="@drawable/shape_rect_white_corner_6"
                    android:paddingTop="@dimen/size_18dp"
                    android:paddingBottom="@dimen/size_18dp"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="7.1"
                    android:layout_marginStart="@dimen/size_15dp"
                    android:layout_marginEnd="@dimen/size_15dp"/>
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="0.2"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_eq"
                    android:scrollbars="none"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="3.5"
                    android:overScrollMode="never"
                    android:layout_marginStart="@dimen/size_15dp"
                    android:layout_marginEnd="@dimen/size_15dp"
                    app:layoutManager="com.google.android.flexbox.FlexboxLayoutManager"/>
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="0.4"/>
                <Button
                    android:textColor="@color/color_selector_reset_btn_txt"
                    android:id="@+id/btn_reset"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size_50dp"
                    android:maxHeight="@dimen/size_50dp"
                    android:text="@string/reset_heart"
                    android:layout_marginStart="@dimen/size_15dp"
                    android:layout_marginEnd="@dimen/size_15dp"
                    android:backgroundTint="@color/s38"/>
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>
            </LinearLayout>
            <View
                android:id="@+id/enable_view"
                android:background="@color/s10"
                android:focusable="true"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.6"/>
        </FrameLayout>
        <View
            android:id="@+id/mask_view"
            android:background="@color/cl_4d000000"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
