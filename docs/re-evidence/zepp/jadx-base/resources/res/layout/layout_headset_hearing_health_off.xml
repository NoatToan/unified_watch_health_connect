<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/headset_hearing_health_off"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true"
    android:paddingStart="@dimen/td_size_31dp"
    android:paddingEnd="@dimen/td_size_38dp">
    <TextView
        android:textSize="@dimen/size_15sp"
        android:textColor="@color/s1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_item_hearing_health_status_off_title"/>
    <TextView
        android:textSize="@dimen/size_14sp"
        android:textColor="@color/s2"
        android:id="@+id/headset_hearing_health_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_11dp"/>
</androidx.appcompat.widget.LinearLayoutCompat>
