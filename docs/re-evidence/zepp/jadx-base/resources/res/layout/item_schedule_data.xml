<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s39"
    android:paddingTop="7.5dp"
    android:paddingBottom="7.5dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="15dp"
    android:paddingEnd="19dp">
    <View
        android:id="@+id/item_color"
        android:background="@color/p3"
        android:layout_width="2dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textStyle="bold"
        android:textColor="@color/s1"
        android:ellipsize="end"
        android:id="@+id/card_reminder_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="6sp"
        android:layout_marginStart="11dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Rainbow.TextAppearance.Number6"/>
    <TextView
        android:textColor="@color/s2"
        android:id="@+id/card_item_time"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/card_reminder_title"
        app:layout_constraintTop_toBottomOf="@+id/card_reminder_title"
        style="@style/Rainbow.TextAppearance.Number7"/>
    <TextView
        android:textColor="@color/s2"
        android:id="@+id/card_reminder_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:lineSpacingExtra="6sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/card_reminder_title"
        app:layout_constraintTop_toBottomOf="@+id/card_item_time"
        style="@style/Rainbow.TextAppearance.Number7"/>
</androidx.constraintlayout.widget.ConstraintLayout>
