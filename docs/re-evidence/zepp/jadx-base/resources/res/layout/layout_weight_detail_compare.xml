<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/s38"
    android:paddingBottom="20dp"
    android:layout_width="match_parent"
    android:layout_height="220dp">
    <TextView
        android:textSize="14sp"
        android:textColor="@color/s1"
        android:id="@+id/tv_compare_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="20dp"
        android:text="@string/weight_compare_to_same_class"/>
    <TextView
        android:textSize="11.5sp"
        android:textColor="@color/s2"
        android:id="@+id/tv_compare_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="4dp"
        android:text="@string/bf3_weight_compare_subtitle"
        android:layout_below="@+id/tv_compare_title"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/s21"
        android:id="@+id/weight_compare_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="26.2dp"
        android:layout_below="@+id/tv_compare_subtitle"
        android:layout_centerHorizontal="true"/>
    <RelativeLayout
        android:id="@+id/weight_compare_chart"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginLeft="18dp"
        android:layout_marginRight="18dp"
        android:layout_below="@+id/weight_compare_title"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
