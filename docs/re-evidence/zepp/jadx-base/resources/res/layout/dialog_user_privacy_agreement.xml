<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/dlg_empty_area_btn"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/access_door_dialog_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/size_14sp"
                android:textColor="@color/s1"
                android:id="@+id/user_agreement_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:layout_marginStart="42dp"
                android:layout_marginEnd="42dp"/>
            <TextView
                android:textSize="@dimen/size_14sp"
                android:textColor="@color/s2"
                android:id="@+id/user_agreement_tip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_14dp"
                android:text="@string/access_card_message_tip"
                android:lineSpacingMultiplier="1.2"
                android:layout_marginStart="@dimen/size_40dp"
                android:layout_marginEnd="@dimen/size_40dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="15dp"
                android:layout_marginStart="40dp"
                android:layout_marginEnd="40dp">
                <CheckBox
                    android:layout_gravity="top"
                    android:id="@+id/check_user_privacy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:button="?android:attr/listChoiceIndicatorMultiple"/>
                <TextView
                    android:textSize="@dimen/size_14sp"
                    android:textColor="@color/s2"
                    android:gravity="start"
                    android:layout_gravity="start|center_vertical"
                    android:id="@+id/tv_user_privacy_agree"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/access_door_user_agree"
                    android:layout_marginStart="5dp"/>
                <TextView
                    android:textSize="@dimen/size_14sp"
                    android:textColor="@color/s2"
                    android:gravity="start"
                    android:layout_gravity="start|center_vertical"
                    android:id="@+id/tv_user_privacy_link"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"/>
            </LinearLayout>
        </LinearLayout>
        <View
            android:background="@color/s3"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <LinearLayout
            android:orientation="horizontal"
            android:background="@color/trans"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_52dp">
            <TextView
                android:textSize="@dimen/size_14sp"
                android:textColor="@color/s2"
                android:gravity="center"
                android:id="@+id/tv_cancel"
                android:background="@drawable/btn_click_bg_round_dialog_bottom_left"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/access_door_user_disagree"
                android:layout_weight="1"/>
            <View
                android:background="@color/s3"
                android:layout_width="1px"
                android:layout_height="match_parent"/>
            <TextView
                android:textSize="@dimen/size_14sp"
                android:textColor="@color/s1"
                android:gravity="center"
                android:id="@+id/tv_confirm"
                android:background="@drawable/btn_click_bg_round_dialog_bottom_right"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/access_door_user_agree"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
