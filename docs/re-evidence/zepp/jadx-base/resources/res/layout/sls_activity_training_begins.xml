<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/sls_training_begin_bg"
        android:background="@drawable/sls_breathe_training_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerInside"
        android:contentDescription="@string/app_name"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/back"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:layout_width="29dp"
        android:layout_height="36dp"
        android:layout_marginTop="22dp"
        android:src="@drawable/sls_back_white"
        android:scaleType="center"
        android:contentDescription="@string/app_name"
        android:layout_marginStart="5dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="15sp"
        android:textColor="@color/white100"
        android:ellipsize="end"
        android:id="@+id/user_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="31dp"
        android:maxWidth="200dp"
        android:text="@string/sls_breathe_training"
        android:maxLines="1"
        android:fontFamily="lt-bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/sls_breathe_ready"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="71dp"
        android:layout_marginTop="135dp"
        android:layout_marginRight="71dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:background="@drawable/sls_breathe_line"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:contentDescription="@string/app_name"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="30sp"
            android:textColor="@color/white100"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sls_breathe_training"
            android:fontFamily="lt-bold"
            app:layout_constraintBottom_toTopOf="@+id/guideline1"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@+id/guideline1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.55"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="13sp"
            android:textColor="@color/white100"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/sls_breathe_training_count"
            android:fontFamily="lt"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/guideline1"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="15sp"
        android:gravity="center"
        android:id="@+id/sls_btn_start"
        android:background="@drawable/sls_shape_background_start_btn"
        android:paddingLeft="39dp"
        android:paddingRight="39dp"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="57dp"
        android:text="@string/sls_breathe_training_start"
        android:fontFamily="lt"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guideline2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.32"/>
    <com.huami.sleepassistant.lib.widget.HollowTextView
        android:textSize="30sp"
        android:gravity="center"
        android:id="@+id/sls_tv_time"
        android:visibility="gone"
        android:layout_width="2dp"
        android:layout_height="2dp"
        android:text="1"
        app:layout_constraintBottom_toBottomOf="@+id/guideline2"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/guideline2"
        app:sls_background_color="@color/white100"
        app:sls_corner_radius="77dp"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="15sp"
        android:textColor="@color/white100"
        android:id="@+id/sls_tv_1"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="81dp"
        android:text="@string/sls_relax_breathing"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/guideline2"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="15sp"
        android:textColor="@color/white100"
        android:id="@+id/sls_tv_2"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="@string/sls_ready_to_start"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sls_tv_1"/>
    <com.huami.sleepassistant.lib.widget.BubbleMaskView
        android:id="@+id/sls_bubble_mask_view"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="15sp"
        android:textColor="@color/sls_white"
        android:gravity="center"
        android:id="@+id/sls_over_training"
        android:background="@drawable/sls_shape_background_breathe"
        android:visibility="gone"
        android:layout_width="108dp"
        android:layout_height="48dp"
        android:layout_marginBottom="58dp"
        android:text="@string/sls_over_text"
        android:fontFamily="lt-bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
