<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/s38"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RadioGroup
        android:orientation="horizontal"
        android:id="@+id/sleepTabGroup"
        android:background="@drawable/shape_health_data_filter_tab_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/slp_size_15dp"
        android:layout_marginStart="@dimen/slp_size_15dp"
        android:layout_marginEnd="@dimen/slp_size_15dp">
        <RadioButton
            android:id="@+id/tabDay"
            android:background="@drawable/selector_sleep_data_tab_start"
            android:checked="true"
            android:text="@string/hm_common_chart_day"
            android:layout_weight="1"
            style="@style/SleepDataTab"/>
        <RadioButton
            android:id="@+id/tabWeek"
            android:background="@drawable/selector_sleep_data_tab_normal"
            android:text="@string/hm_common_chart_week"
            android:layout_weight="1"
            style="@style/SleepDataTab"/>
        <RadioButton
            android:id="@+id/tabMonth"
            android:background="@drawable/selector_sleep_data_tab_normal"
            android:text="@string/hm_common_chart_month"
            android:layout_weight="1"
            style="@style/SleepDataTab"/>
        <RadioButton
            android:id="@+id/tabYear"
            android:background="@drawable/selector_sleep_data_tab_end"
            android:text="@string/hm_common_chart_year"
            android:layout_weight="1"
            style="@style/SleepDataTab"/>
    </RadioGroup>
</LinearLayout>
