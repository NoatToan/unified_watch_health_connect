<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bm_detail_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.cardview.widget.CardView
        android:id="@+id/head_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/bm_common_cardView_chart">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/head"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/value_container"
                android:padding="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginStart="15dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <com.huami.widget.typeface.TypefaceTextView
                    android:textSize="40sp"
                    android:textColor="#000000"
                    android:id="@+id/value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bm_temperature_value_invalid"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.huami.widget.typeface.TypefaceTextView
                    android:textSize="14sp"
                    android:textColor="#99000000"
                    android:id="@+id/unit"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bm_temperature_unit_c"
                    android:layout_marginStart="5dp"
                    app:layout_constraintBaseline_toBaselineOf="@+id/value"
                    app:layout_constraintStart_toEndOf="@+id/value"/>
                <com.huami.widget.typeface.TypefaceTextView
                    android:textSize="@dimen/bm_detail_size_12sp"
                    android:textColor="#666666"
                    android:id="@+id/timeTv"
                    android:paddingBottom="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/bm_detail_size_10dp"
                    app:layout_constraintStart_toStartOf="@+id/value"
                    app:layout_constraintTop_toBottomOf="@+id/value"
                    style="@style/bm_common_TextStyle_Rtl"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <FrameLayout
                android:id="@+id/chart_container"
                android:background="@color/bm_detail_white"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="@dimen/bm_detail_size_2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/value_container"/>
            <View
                android:id="@+id/divider_line"
                android:background="#f2f2f2"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginTop="3dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/chart_container"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="14sp"
                android:textColor="#666666"
                android:id="@+id/normal_logo"
                android:padding="@dimen/bm_detail_size_15dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bm_temperature_standard"
                android:drawablePadding="5dp"
                android:drawableStart="@drawable/bm_temperature_shape_normal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/divider_line"
                style="@style/bm_common_TextStyle_Rtl"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="14sp"
                android:textColor="#666666"
                android:padding="@dimen/bm_detail_size_15dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bm_temperature_fever"
                android:drawablePadding="5dp"
                android:drawableStart="@drawable/bm_temperature_shape_abnormal"
                app:layout_constraintStart_toEndOf="@+id/normal_logo"
                app:layout_constraintTop_toBottomOf="@+id/divider_line"
                style="@style/bm_common_TextStyle_Rtl"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView
        android:id="@+id/statistics_container_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/head_card"
        style="@style/bm_common_cardView_common">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/statistics_container"
            android:paddingBottom="13dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#e6000000"
                android:id="@+id/statistics_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/bm_common_TextStyle_Rtl"/>
            <View
                android:id="@+id/divider_1"
                android:layout_marginTop="15dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/statistics_title"
                style="@style/bm_detail_Divider_Horizontal"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="14sp"
                android:textColor="#e6000000"
                android:id="@+id/max_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="21dp"
                android:text="@string/bm_temperature_max"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/divider_1"
                style="@style/bm_common_TextStyle_Rtl"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#e6000000"
                android:id="@+id/statistics_max"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="21dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/divider_1"
                style="@style/bm_common_TextStyle_Rtl"/>
            <View
                android:id="@+id/divider_2"
                android:layout_marginTop="15dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/max_title"
                style="@style/bm_detail_Divider_Horizontal"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="14sp"
                android:textColor="#e6000000"
                android:id="@+id/min_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="21dp"
                android:text="@string/bm_temperature_min"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/divider_2"
                style="@style/bm_common_TextStyle_Rtl"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#e6000000"
                android:id="@+id/statistics_min"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="21dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/divider_2"
                style="@style/bm_common_TextStyle_Rtl"/>
            <View
                android:id="@+id/divider_3"
                android:layout_marginTop="15dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/min_title"
                style="@style/bm_detail_Divider_Horizontal"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="14sp"
                android:textColor="#e6000000"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="21dp"
                android:text="@string/bm_temperature_avg"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/divider_3"
                style="@style/bm_common_TextStyle_Rtl"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#e6000000"
                android:id="@+id/statistics_avg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="21dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/divider_3"
                style="@style/bm_common_TextStyle_Rtl"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
