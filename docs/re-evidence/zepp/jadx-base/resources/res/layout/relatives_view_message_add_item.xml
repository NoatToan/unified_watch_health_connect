<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:background="@color/s36"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/relatives_size_15dp">
        <ImageView
            android:id="@+id/icon"
            android:layout_width="@dimen/relatives_size_44dp"
            android:layout_height="@dimen/relatives_size_44dp"
            android:layout_marginTop="@dimen/relatives_size_20dp"
            android:scaleType="centerCrop"
            android:layout_marginStart="@dimen/relatives_size_16dp"/>
        <RelativeLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/relatives_size_19dp"
            android:layout_marginBottom="@dimen/relatives_size_20dp"
            android:layout_marginStart="@dimen/relatives_size_68dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/delete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/relatives_ic_delete_message"
                android:layout_alignParentTop="true"
                android:layout_marginStart="@dimen/relatives_size_16dp"
                android:layout_marginEnd="@dimen/relatives_size_16dp"
                android:layout_alignParentEnd="true"
                app:tint="@color/s1"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/s1"
                android:id="@+id/username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/relatives_data_zero"
                android:lineSpacingExtra="-1sp"
                android:layout_toStartOf="@+id/delete"
                android:layout_alignParentStart="true"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/s2"
                android:id="@+id/notice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/relatives_size_6dp"
                android:layout_below="@+id/username"
                android:lineSpacingExtra="3sp"
                android:layout_alignParentStart="true"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/s2"
                android:id="@+id/notice_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/relatives_size_6dp"
                android:layout_below="@+id/username"
                android:lineSpacingExtra="3sp"
                android:layout_marginStart="@dimen/relatives_size_10dp"
                android:layout_marginEnd="12.7dp"
                android:layout_toEndOf="@+id/notice"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/action_panel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/relatives_size_14dp"
                android:layout_below="@+id/notice">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/relatives_common_light_color"
                        android:gravity="center"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/ok_button"
                        android:background="@drawable/relatives_msg_friend_corner_rect"
                        android:paddingTop="@dimen/relatives_size_6dp"
                        android:paddingBottom="@dimen/relatives_size_6dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/relatives_friends_agree"
                        android:lineSpacingExtra="4sp"
                        android:paddingStart="@dimen/relatives_size_12dp"
                        android:paddingEnd="@dimen/relatives_size_12dp"
                        android:layout_marginEnd="@dimen/relatives_item_padding_horizontal"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/s2"
                        android:gravity="center"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/refuse_button"
                        android:background="@drawable/relatives_msg_reject_friend_corner_rect"
                        android:paddingTop="@dimen/relatives_size_6dp"
                        android:paddingBottom="@dimen/relatives_size_6dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/relatives_label_refuse"
                        android:lineSpacingExtra="4sp"
                        android:paddingStart="@dimen/relatives_size_15dp"
                        android:paddingEnd="@dimen/relatives_size_12dp"
                        android:layout_marginEnd="@dimen/relatives_item_padding_horizontal"/>
                </LinearLayout>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/s2"
                    android:ellipsize="end"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/refuse_and_ignore_button"
                    android:background="@drawable/relatives_msg_reject_friend_corner_rect"
                    android:paddingTop="@dimen/relatives_size_6dp"
                    android:paddingBottom="@dimen/relatives_size_6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/relatives_item_padding_horizontal"
                    android:text="@string/relatives_label_refuse_and_ignore"
                    android:maxLines="2"
                    android:paddingStart="@dimen/relatives_size_12dp"
                    android:paddingEnd="@dimen/relatives_size_12dp"
                    android:layout_marginEnd="@dimen/relatives_common_item_padding"/>
            </LinearLayout>
            <TextView
                android:enabled="false"
                android:textSize="12sp"
                android:textColor="@color/s2"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/agree_flag"
                android:background="@drawable/relatives_msg_reject_friend_corner_rect"
                android:paddingTop="@dimen/relatives_size_6dp"
                android:paddingBottom="@dimen/relatives_size_6dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/relatives_size_14dp"
                android:text="@string/relatives_label_accepted"
                android:layout_below="@+id/notice"
                android:lineSpacingExtra="4sp"
                android:paddingStart="@dimen/relatives_size_12dp"
                android:paddingEnd="@dimen/relatives_size_12dp"/>
        </RelativeLayout>
    </FrameLayout>
</FrameLayout>
