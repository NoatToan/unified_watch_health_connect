<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/dialog_bg"
        android:layout_width="300dp"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/s1"
            android:layout_gravity="center_horizontal"
            android:id="@+id/title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/s2"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tips_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"/>
        <View
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider"
            android:layout_marginTop="7dp"/>
        <FrameLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/pyh_container"
            android:visibility="gone"
            android:layout_width="148dp"
            android:layout_height="211dp"
            android:layout_marginTop="19dp">
            <ImageView
                android:layout_width="148dp"
                android:layout_height="211dp"
                android:src="@drawable/img_pyh_dial_bg"/>
            <com.xiaomi.hm.health.baseui.GifMovieView
                android:layout_gravity="center_horizontal"
                android:id="@+id/pyh_gif_view"
                android:background="@color/s3"
                android:visibility="gone"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginTop="43dp"/>
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/pyh_thumbnail_img"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginTop="43dp"
                android:scaleType="fitXY"/>
        </FrameLayout>
        <FrameLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/gtr_container"
            android:visibility="gone"
            android:layout_width="152dp"
            android:layout_height="207dp"
            android:layout_marginTop="19dp">
            <ImageView
                android:id="@+id/gtr_bg"
                android:layout_width="152dp"
                android:layout_height="207dp"
                android:src="@drawable/img_pyh_dial_bg"/>
            <com.xiaomi.hm.health.baseui.GifMovieView
                android:layout_gravity="center_horizontal"
                android:id="@+id/gtr_gif_view"
                android:background="@color/s3"
                android:visibility="gone"
                android:layout_width="118dp"
                android:layout_height="118dp"
                android:layout_marginTop="40dp"/>
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/gtr_thumbnail_img"
                android:layout_width="118dp"
                android:layout_height="118dp"
                android:layout_marginTop="40dp"
                android:scaleType="fitXY"/>
        </FrameLayout>
        <FrameLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/venice_container"
            android:visibility="gone"
            android:layout_width="192dp"
            android:layout_height="230dp"
            android:layout_marginTop="28dp">
            <ImageView
                android:layout_width="192dp"
                android:layout_height="230dp"
                android:src="@drawable/img_venice_dial_bg"/>
            <com.xiaomi.hm.health.baseui.GifMovieView
                android:layout_gravity="center"
                android:id="@+id/venice_gif_view"
                android:background="@color/s3"
                android:visibility="gone"
                android:layout_width="58dp"
                android:layout_height="179dp"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/venice_thumbnail_img"
                android:layout_width="58dp"
                android:layout_height="179dp"
                android:scaleType="fitXY"/>
        </FrameLayout>
        <FrameLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/cinco_container"
            android:visibility="gone"
            android:layout_width="130dp"
            android:layout_height="223dp"
            android:layout_marginTop="16.5dp">
            <ImageView
                android:layout_width="130dp"
                android:layout_height="223dp"
                android:src="@drawable/img_cinco_bg"/>
            <com.xiaomi.hm.health.baseui.GifMovieView
                android:layout_gravity="center_horizontal"
                android:id="@+id/cinco_gif_view"
                android:background="@color/s3"
                android:visibility="gone"
                android:layout_width="44dp"
                android:layout_height="88dp"
                android:layout_marginTop="57.5dp"/>
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/cinco_thumbnail_img"
                android:background="@color/s3"
                android:layout_width="44dp"
                android:layout_height="88dp"
                android:layout_marginTop="57.5dp"
                android:scaleType="fitXY"/>
        </FrameLayout>
        <FrameLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/athens_container"
            android:visibility="gone"
            android:layout_width="120dp"
            android:layout_height="206dp"
            android:layout_marginTop="23dp">
            <ImageView
                android:layout_width="120dp"
                android:layout_height="206dp"/>
            <com.xiaomi.hm.health.baseui.GifMovieView
                android:layout_gravity="center_horizontal"
                android:id="@+id/athens_gif_view"
                android:background="@color/s3"
                android:visibility="gone"
                android:layout_width="40dp"
                android:layout_height="80dp"
                android:layout_marginTop="54dp"/>
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/athens_thumbnail_img"
                android:background="@color/s3"
                android:layout_width="40dp"
                android:layout_height="80dp"
                android:layout_marginTop="54dp"
                android:scaleType="fitXY"/>
        </FrameLayout>
        <FrameLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/kestrel_container"
            android:visibility="gone"
            android:layout_width="136dp"
            android:layout_height="233dp"
            android:layout_marginTop="23dp">
            <ImageView
                android:layout_width="136dp"
                android:layout_height="233dp"
                android:src="@drawable/img_kestrel_dial_bg"/>
            <com.xiaomi.hm.health.baseui.GifMovieView
                android:layout_gravity="center_vertical"
                android:id="@+id/kestrel_gif_view"
                android:background="@color/s3"
                android:visibility="gone"
                android:layout_width="90dp"
                android:layout_height="115dp"
                android:layout_marginStart="20dp"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/kestrel_thumbnail_img"
                android:background="@color/s3"
                android:layout_width="90dp"
                android:layout_height="115dp"
                android:scaleType="fitXY"
                android:layout_marginStart="20dp"/>
        </FrameLayout>
        <FrameLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/peyto_container"
            android:layout_width="136dp"
            android:layout_height="233dp"
            android:layout_marginTop="25dp">
            <ImageView
                android:layout_width="136dp"
                android:layout_height="233dp"
                android:src="@drawable/img_amazfit_watch_bg"/>
            <com.xiaomi.hm.health.baseui.GifMovieView
                android:id="@+id/gif_view"
                android:background="@color/s3"
                android:visibility="gone"
                android:layout_width="87dp"
                android:layout_height="87dp"
                android:layout_marginTop="69dp"
                android:layout_marginStart="21dp"/>
            <ImageView
                android:id="@+id/thumbnail_img"
                android:background="@color/s3"
                android:layout_width="87dp"
                android:layout_height="87dp"
                android:layout_marginTop="69dp"
                android:scaleType="fitXY"
                android:layout_marginStart="21dp"/>
        </FrameLayout>
        <FrameLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/tempo_container"
            android:visibility="gone"
            android:layout_width="90dp"
            android:layout_height="157dp"
            android:layout_marginTop="29dp">
            <ImageView
                android:layout_width="90dp"
                android:layout_height="157dp"
                android:src="@drawable/img_temp_bg"/>
            <com.xiaomi.hm.health.baseui.GifMovieView
                android:layout_gravity="center_horizontal"
                android:id="@+id/tempo_gif_view"
                android:background="@color/s3"
                android:visibility="gone"
                android:layout_width="40dp"
                android:layout_height="80dp"
                android:layout_marginTop="34dp"/>
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/tempo_thumbnail_img"
                android:background="@color/s3"
                android:layout_width="40dp"
                android:layout_height="80dp"
                android:layout_marginTop="34dp"
                android:scaleType="fitXY"/>
        </FrameLayout>
        <FrameLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/beats_container"
            android:visibility="gone"
            android:layout_width="100dp"
            android:layout_height="175dp"
            android:layout_marginTop="29dp">
            <ImageView
                android:layout_width="100dp"
                android:layout_height="175dp"
                android:src="@drawable/img_beats_bg"/>
            <com.xiaomi.hm.health.baseui.GifMovieView
                android:layout_gravity="center_horizontal"
                android:id="@+id/beats_gif_view"
                android:background="@color/s3"
                android:visibility="gone"
                android:layout_width="40dp"
                android:layout_height="80dp"
                android:layout_marginTop="34dp"/>
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/beats_thumbnail_img"
                android:background="@color/s3"
                android:layout_width="40dp"
                android:layout_height="80dp"
                android:layout_marginTop="34dp"
                android:scaleType="fitXY"/>
        </FrameLayout>
        <FrameLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/vulture_container"
            android:visibility="gone"
            android:layout_width="200dp"
            android:layout_height="240dp"
            android:layout_marginTop="19dp">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/vulture_bg"
                android:layout_width="168dp"
                android:layout_height="201.6dp"
                android:scaleType="fitXY"/>
            <com.xiaomi.hm.health.baseui.GifMovieView
                android:layout_gravity="center"
                android:id="@+id/vulture_gif_view"
                android:background="@color/s3"
                android:visibility="gone"
                android:layout_width="120dp"
                android:layout_height="120dp"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/vulture_thumbnail_img"
                android:padding="@dimen/size_10dp"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:scaleType="fitXY"/>
        </FrameLayout>
        <FrameLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/aneto_container"
            android:visibility="gone"
            android:layout_width="148dp"
            android:layout_height="211dp"
            android:layout_marginTop="19dp">
            <ImageView
                android:layout_width="148dp"
                android:layout_height="211dp"
                android:src="@drawable/img_aneto_dial_bg"/>
            <com.xiaomi.hm.health.baseui.GifMovieView
                android:layout_gravity="center"
                android:id="@+id/aneto_gif_view"
                android:background="@color/s3"
                android:visibility="gone"
                android:layout_width="120dp"
                android:layout_height="120dp"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/aneto_thumbnail_img"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:scaleType="fitXY"/>
        </FrameLayout>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/s2"
            android:layout_gravity="center_horizontal"
            android:id="@+id/error_tips_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"/>
        <com.xiaomi.hm.health.device.watch_skin.WatchSkinProgressView
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="52dp"/>
    </LinearLayout>
</FrameLayout>
