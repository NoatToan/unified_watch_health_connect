<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/s36"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iv_simulation_failure"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_71dp"
        android:src="@drawable/ic_simulation_fragment_failure"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="@dimen/size_18sp"
        android:textColor="@color/s1"
        android:id="@+id/tv_simulation_failure_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_8dp"
        android:text="@string/access_card_simulation_failure"
        android:layout_below="@+id/iv_simulation_failure"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="@dimen/size_18sp"
        android:textColor="@color/s1"
        android:id="@+id/tv_simulation_failure_code"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_8dp"
        android:text=""
        android:layout_below="@+id/tv_simulation_failure_tip"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="@dimen/size_18sp"
        android:textColor="@color/s1"
        android:gravity="center"
        android:id="@+id/tv_simulation_failure_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_8dp"
        android:text=""
        android:layout_below="@+id/tv_simulation_failure_code"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="@dimen/size_29dp"
        android:layout_marginEnd="@dimen/size_29dp"/>
    <TextView
        android:textSize="@dimen/size_14sp"
        android:textColor="@color/s41"
        android:id="@+id/tv_simulation_result_fail_tips"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="100dp"
        android:text="@string/access_door_simulation_result_fail_tips"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
    <Button
        android:gravity="center"
        android:id="@+id/tv_simulation_failure"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size_18dp"
        android:text="@string/access_door_retry"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="@dimen/size_18dp"
        android:layout_marginEnd="@dimen/size_18dp"
        style="@style/Rainbow.Widget.Button.38.Circular"/>
</RelativeLayout>
