<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.lib.rainbow.titlebar.RainbowTitleBar
        android:id="@+id/tv_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationIcon="@drawable/ic_arrow_back_20_2x"/>
    <FrameLayout
        android:id="@+id/status_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tv_title_bar"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/status_content">
        <TextView
            android:textSize="13sp"
            android:textColor="@color/s2"
            android:id="@+id/alarm_tip"
            android:background="@color/s38"
            android:paddingTop="@dimen/size_15dp"
            android:paddingBottom="@dimen/size_10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/earbud_alarm_tip"
            android:paddingStart="@dimen/size_20dp"
            android:paddingEnd="@dimen/size_20dp"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/alarm_list"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:overScrollMode="never"/>
        <ImageView
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_0.5dp"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:background="@color/s38"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_70dp">
            <TextView
                android:textSize="@dimen/size_9sp"
                android:textColor="@color/s2"
                android:gravity="center"
                android:id="@+id/alarm_edit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/edit"
                android:drawableTop="@drawable/icon_edit_selector"
                android:drawablePadding="3dp"
                android:layout_marginEnd="@dimen/size_50dp"/>
            <TextView
                android:textSize="@dimen/size_9sp"
                android:textColor="@color/s2"
                android:gravity="center"
                android:id="@+id/alarm_add"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/smart_alarm_add"
                android:drawableTop="@drawable/icon_add_selector"
                android:drawablePadding="3dp"/>
            <TextView
                android:textSize="@dimen/size_9sp"
                android:textColor="@color/s2"
                android:gravity="center"
                android:id="@+id/alarm_done"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/smart_alarm_done"
                android:drawableTop="@drawable/smart_alarm_done"
                android:drawablePadding="4.7dp"/>
        </LinearLayout>
    </LinearLayout>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/mask_view"
        android:background="@color/s4"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/status_content"
        android:alpha="0.7"/>
</RelativeLayout>
