<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s38"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/divider"
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.huami.sleep.view.UnitTextView
            android:textSize="40sp"
            android:textColor="@color/s1"
            android:id="@+id/detailIntoSleepValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="29dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/divider"
            app:typeface="km"
            app:unitColor="@color/s2"
            app:unitSize="14sp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/s2"
            android:id="@+id/detailIntoSleepChange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/detailIntoSleepValue"/>
        <ImageView
            android:id="@+id/detailIntoSleepChangeImg"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/detailIntoSleepChange"
            app:layout_constraintStart_toEndOf="@+id/detailIntoSleepChange"
            app:layout_constraintTop_toTopOf="@+id/detailIntoSleepChange"/>
        <TextView
            android:id="@+id/detailIntoSleepRefs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/detailIntoSleepChange"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/s1"
            android:id="@+id/detailIntoSleepWhatTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="49dp"
            android:text="@string/sleep_into_sleep_title"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/detailIntoSleepRefs"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/s2"
            android:id="@+id/detailIntoSleepWhatTitleDesc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/sleep_into_sleep_title_desc"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/detailIntoSleepWhatTitle"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/s1"
            android:id="@+id/detailIntoSleepUpdateTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="38dp"
            android:text="@string/sleep_into_sleep_tips_title"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/detailIntoSleepWhatTitleDesc"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/s2"
            android:id="@+id/detailIntoSleepUpdateOne"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/sleep_into_sleep_tips_one"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/detailIntoSleepUpdateTitle"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/s2"
            android:id="@+id/detailIntoSleepUpdateOnePlus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/sleep_into_sleep_tips_one_plus"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/detailIntoSleepUpdateOne"/>
        <ImageView
            android:id="@+id/detailIntoSleepSkyImg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:src="@drawable/ic_sleep_tonality_sky_bg"
            android:scaleType="fitXY"
            app:layout_constraintEnd_toEndOf="@+id/detailIntoSleepUpdateOnePlus"
            app:layout_constraintStart_toStartOf="@+id/detailIntoSleepUpdateOnePlus"
            app:layout_constraintTop_toBottomOf="@+id/detailIntoSleepUpdateOnePlus"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/s5"
            android:id="@+id/detailIntoSleepSkyImgName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/sleep_tonality_title"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toStartOf="@+id/detailIntoSleepSkyImg"
            app:layout_constraintTop_toTopOf="@+id/detailIntoSleepSkyImg"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/s5"
            android:gravity="center"
            android:id="@+id/detailIntoSleepSkyImgBeta"
            android:background="@drawable/sleep_sky_img_txt_bg"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_marginTop="1dp"
            android:layout_marginBottom="1dp"
            android:text="Beta"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:layout_marginStart="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/detailIntoSleepSkyImgName"
            app:layout_constraintStart_toEndOf="@+id/detailIntoSleepSkyImgName"
            app:layout_constraintTop_toTopOf="@+id/detailIntoSleepSkyImgName"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/s5"
            android:gravity="center"
            android:id="@+id/detailIntoSleepSkyImgFreeSign"
            android:background="@drawable/sleep_sky_img_txt_bg"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_marginTop="1dp"
            android:layout_marginBottom="1dp"
            android:text="@string/sleep_tonality_free"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:layout_marginStart="5dp"
            app:layout_constraintBottom_toBottomOf="@+id/detailIntoSleepSkyImgName"
            app:layout_constraintStart_toEndOf="@+id/detailIntoSleepSkyImgBeta"
            app:layout_constraintTop_toTopOf="@+id/detailIntoSleepSkyImgName"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/s5"
            android:gravity="center"
            android:id="@+id/detailIntoSleepSkyImgBetaForeign"
            android:background="@drawable/sleep_sky_img_txt_bg"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Beta"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            app:layout_constraintStart_toStartOf="@+id/detailIntoSleepSkyImgName"
            app:layout_constraintTop_toBottomOf="@+id/detailIntoSleepSkyImgName"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/s5"
            android:gravity="center"
            android:id="@+id/detailIntoSleepSkyImgFreeSignForeign"
            android:background="@drawable/sleep_sky_img_txt_bg"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/sleep_tonality_free"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:layout_marginStart="5dp"
            app:layout_constraintStart_toEndOf="@+id/detailIntoSleepSkyImgBetaForeign"
            app:layout_constraintTop_toBottomOf="@+id/detailIntoSleepSkyImgName"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/detailIntoSleepChinaTagGroup"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="detailIntoSleepSkyImgBeta,detailIntoSleepSkyImgFreeSign"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/detailIntoSleepForeignTagGroup"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="detailIntoSleepSkyImgBetaForeign,detailIntoSleepSkyImgFreeSignForeign"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/detailIntoSleepGroup"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="detailIntoSleepUpdateOnePlus,detailIntoSleepSkyImg,detailIntoSleepSkyImgName"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/s2"
            android:id="@+id/detailIntoSleepUpdateTwo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/sleep_into_sleep_tips_two"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/detailIntoSleepSkyImg"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/s2"
            android:id="@+id/detailIntoSleepUpdateThree"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/sleep_into_sleep_tips_three"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/detailIntoSleepUpdateTwo"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/s2"
            android:id="@+id/detailIntoSleepUpdateFour"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/sleep_into_sleep_tips_four"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/detailIntoSleepUpdateThree"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/s1"
            android:id="@+id/detailIntoSleepAdviceTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="38dp"
            android:text="@string/sleep_into_sleep_tips_title"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/detailIntoSleepUpdateFour"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/s2"
            android:id="@+id/detailIntoSleepAdviceOne"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/sleep_into_sleep_tips_one"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/detailIntoSleepAdviceTitle"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/s2"
            android:id="@+id/detailIntoSleepAdviceTwo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/sleep_into_sleep_tips_two"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/detailIntoSleepAdviceOne"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/s2"
            android:id="@+id/detailIntoSleepAdviceThree"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/sleep_into_sleep_tips_three"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/detailIntoSleepAdviceTwo"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/s2"
            android:layout_gravity="center_horizontal"
            android:id="@+id/sleep_reference_documents"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="@string/sleep_reference_documents"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/detailIntoSleepAdviceThree"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/s2"
            android:layout_gravity="center_horizontal"
            android:id="@+id/sleep_reference_documents_info"
            android:paddingBottom="30dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/sleep_into_reference"
            android:lineSpacingExtra="10dp"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"
            app:layout_constraintTop_toBottomOf="@+id/sleep_reference_documents"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
