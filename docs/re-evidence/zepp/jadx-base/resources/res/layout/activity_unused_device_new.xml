<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/un_used_vertical_line_1"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:layout_constraintGuide_percent="0.52"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/un_used_vertical_line_2"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:layout_constraintGuide_percent="0.5"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/fl_watch_picture"
        android:background="@color/transparent"
        android:layout_width="160dp"
        android:layout_height="186dp"
        android:layout_marginTop="30dp"
        app:layout_constraintEnd_toStartOf="@+id/un_used_vertical_line_1"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_device_shadow"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:src="@drawable/img_device_shadow"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="160:24"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_skin"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="7dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintBottom_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_dial"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/iv_skin"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/iv_skin"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_device_transparent"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:src="@android:color/transparent"
            app:layout_constraintBottom_toBottomOf="@+id/iv_skin"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/iv_skin"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_default_device"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/img_default_watch_skin"
            app:cardCornerRadius="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="13sp"
        android:textColor="@color/s2"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:text="@string/device_unuse"
        android:layout_marginStart="28dp"
        app:drawableStartCompat="@drawable/icon_unused"
        app:layout_constraintBottom_toBottomOf="@+id/fl_watch_picture"
        app:layout_constraintStart_toEndOf="@+id/un_used_vertical_line_2"
        app:layout_constraintTop_toTopOf="@+id/fl_watch_picture"/>
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        app:cardBackgroundColor="@color/s10"
        app:cardCornerRadius="6dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@+id/fl_watch_picture">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.huami.lib.rainbow.ListTile
                android:id="@+id/firmware_version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ltv_title="@string/shoes_setting_fw_version"
                app:ltv_trailing="@color/transparency"/>
            <com.huami.lib.rainbow.ListTile
                android:id="@+id/mac_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ltv_title="@string/mili_setting_mac_address"
                app:ltv_trailing="@color/transparency"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <androidx.appcompat.widget.AppCompatButton
        android:textColor="@color/tangerine"
        android:gravity="center"
        android:id="@+id/use_device"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginBottom="24dp"
        android:text="@string/use_device"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        app:layout_constraintBottom_toTopOf="@+id/unused_unbind_tv"
        app:layout_goneMarginBottom="15dp"
        style="?attr/buttonStyleGray_48_flat"/>
    <androidx.appcompat.widget.AppCompatButton
        android:textSize="15sp"
        android:textColor="@color/s1"
        android:gravity="center"
        android:id="@+id/unused_unbind_tv"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginBottom="30dp"
        android:text="@string/mili_setting_unbind"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        style="?attr/buttonStyleGray_48_flat"/>
</androidx.constraintlayout.widget.ConstraintLayout>
