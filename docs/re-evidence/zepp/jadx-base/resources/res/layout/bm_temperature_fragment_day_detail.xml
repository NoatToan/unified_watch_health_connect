<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bm_detail_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.cardview.widget.CardView
        android:id="@+id/head_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/bm_common_cardView_chart">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/value_container"
                android:padding="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginStart="15dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <com.huami.widget.typeface.TypefaceTextView
                    android:textSize="40sp"
                    android:textColor="#000000"
                    android:id="@+id/value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/bm_common_TextStyle_Rtl"/>
                <com.huami.widget.typeface.TypefaceTextView
                    android:textSize="14sp"
                    android:textColor="#666666"
                    android:id="@+id/unit"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bm_temperature_unit_c"
                    android:layout_marginStart="4dp"
                    app:layout_constraintBaseline_toBaselineOf="@+id/value"
                    app:layout_constraintStart_toEndOf="@+id/value"/>
                <com.huami.widget.typeface.TypefaceTextView
                    android:textSize="12sp"
                    android:textColor="#666666"
                    android:id="@+id/timeTv"
                    android:paddingBottom="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:layout_constraintStart_toStartOf="@+id/value"
                    app:layout_constraintTop_toBottomOf="@+id/unit"
                    style="@style/bm_common_TextStyle_Rtl"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <FrameLayout
                android:id="@+id/chart_container"
                android:background="@color/bm_detail_white"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/value_container"/>
            <View
                android:id="@+id/divider_line"
                android:background="#f2f2f2"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginTop="3dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/chart_container"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="14sp"
                android:textColor="#666666"
                android:id="@+id/normal_logo"
                android:padding="15dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bm_temperature_standard"
                android:drawablePadding="5dp"
                android:drawableStart="@drawable/bm_temperature_shape_normal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/divider_line"
                style="@style/bm_common_TextStyle_Rtl"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="14sp"
                android:textColor="#666666"
                android:padding="15dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bm_temperature_fever"
                android:drawablePadding="5dp"
                android:drawableStart="@drawable/bm_temperature_shape_abnormal"
                app:layout_constraintStart_toEndOf="@+id/normal_logo"
                app:layout_constraintTop_toBottomOf="@+id/divider_line"
                style="@style/bm_common_TextStyle_Rtl"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/group_statistics_zone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="divider_line_statistic,statistics_zone"/>
            <View
                android:id="@+id/divider_line_statistic"
                android:background="#f2f2f2"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginTop="2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/normal_logo"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/statistics_zone"
                android:paddingTop="15dp"
                android:paddingBottom="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/divider_line_statistic">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <com.huami.widget.typeface.TypefaceTextView
                        android:textSize="24sp"
                        android:textColor="#333333"
                        android:id="@+id/statistics_max"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <com.huami.widget.typeface.TypefaceTextView
                        android:textSize="14sp"
                        android:textColor="#99000000"
                        android:id="@+id/statistics_max_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        app:layout_constraintBaseline_toBaselineOf="@+id/statistics_max"
                        app:layout_constraintStart_toEndOf="@+id/statistics_max"/>
                    <com.huami.widget.typeface.TypefaceTextView
                        android:textSize="14sp"
                        android:textColor="#99000000"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="@string/bm_temperature_max"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/statistics_max"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <com.huami.widget.typeface.TypefaceTextView
                        android:textSize="24sp"
                        android:textColor="#333333"
                        android:id="@+id/statistics_min"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <com.huami.widget.typeface.TypefaceTextView
                        android:textSize="14sp"
                        android:textColor="#99000000"
                        android:id="@+id/statistics_min_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        app:layout_constraintBaseline_toBaselineOf="@+id/statistics_min"
                        app:layout_constraintStart_toEndOf="@+id/statistics_min"/>
                    <com.huami.widget.typeface.TypefaceTextView
                        android:textSize="14sp"
                        android:textColor="#99000000"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="@string/bm_temperature_min"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/statistics_min"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <com.huami.widget.typeface.TypefaceTextView
                        android:textSize="24sp"
                        android:textColor="#333333"
                        android:id="@+id/statistics_avg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <com.huami.widget.typeface.TypefaceTextView
                        android:textSize="14sp"
                        android:textColor="#99000000"
                        android:id="@+id/statistics_avg_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        app:layout_constraintBaseline_toBaselineOf="@+id/statistics_avg"
                        app:layout_constraintStart_toEndOf="@+id/statistics_avg"/>
                    <com.huami.widget.typeface.TypefaceTextView
                        android:textSize="14sp"
                        android:textColor="#99000000"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="@string/bm_temperature_avg"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/statistics_avg"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView
        android:id="@+id/add_data_card"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/head_card"
        style="@style/bm_common_cardView_common">
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="16sp"
            android:textColor="#e6000000"
            android:gravity="center_vertical"
            android:layout_gravity="center"
            android:id="@+id/add_data"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/bm_common_add_data"
            style="@style/bm_common_TextStyle_Rtl"/>
    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView
        android:id="@+id/history_data_card"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/add_data_card"
        style="@style/bm_common_cardView_common">
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="16sp"
            android:textColor="#e6000000"
            android:gravity="center_vertical"
            android:layout_gravity="center"
            android:id="@+id/history_data"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/bm_common_history_data"
            style="@style/bm_common_TextStyle_Rtl"/>
    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView
        android:id="@+id/intro_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/history_data_card"
        style="@style/bm_common_cardView_common">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/intro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#e6000000"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bm_temperature_name"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/bm_common_TextStyle_Rtl"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="12sp"
                android:textColor="#e6000000"
                android:id="@+id/intro_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="@string/bm_temperature_intro"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/title"
                style="@style/bm_common_TextStyle_Rtl"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="12sp"
                android:textColor="#e6000000"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="@string/bm_temperature_device_measure_range"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/intro_content"
                style="@style/bm_common_TextStyle_Rtl"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="12sp"
        android:textColor="#b2b2b2"
        android:id="@+id/jp_hint_text"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="このデータはユーザーが手動で入力する必要があります"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="25dp"
        app:layout_constraintTop_toBottomOf="@+id/intro_card"/>
</androidx.constraintlayout.widget.ConstraintLayout>
