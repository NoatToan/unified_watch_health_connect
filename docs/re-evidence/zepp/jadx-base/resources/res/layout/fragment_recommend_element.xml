<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="18sp"
        android:textColor="@color/s46"
        android:id="@+id/tv_recommond_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/recommend_elements"
        android:maxLines="2"
        android:layout_marginStart="@dimen/size_18dp"
        android:layout_marginEnd="@dimen/size_18dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:background="@drawable/bg_recommend_element"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/container_elements"
        app:layout_constraintEnd_toEndOf="@+id/container_elements"
        app:layout_constraintStart_toStartOf="@+id/container_elements"
        app:layout_constraintTop_toTopOf="@+id/container_elements"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container_elements"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_18dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_recommond_title">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/container_sleep_element"
            android:background="@drawable/bg_top_left_recommend"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="@dimen/size_18dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.25">
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/s46"
                android:gravity="center"
                android:id="@+id/tv_sleep_element_value"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/size_3dp"
                android:text="@string/sky_realtimeData_empty"
                android:lines="1"
                android:layout_marginStart="@dimen/size_5dp"
                android:layout_marginEnd="@dimen/size_5dp"
                app:layout_constraintBottom_toTopOf="@+id/tv_sleep_element_title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"
                style="@style/Rainbow.TextAppearance.Body3"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/s46"
                android:gravity="center"
                android:id="@+id/tv_sleep_element_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/recommend_sleep"
                android:maxLines="3"
                android:layout_marginStart="@dimen/size_5dp"
                android:layout_marginEnd="@dimen/size_5dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_sleep_element_value"
                style="@style/Rainbow.TextAppearance.Body4"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <Space
            android:id="@+id/space_start"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="@dimen/size_18dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/container_sleep_element"
            app:layout_constraintWidth_percent="0.0875"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/container_step_element"
            android:background="@drawable/bg_bottom_left_recommend"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="@dimen/size_18dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/space_start"
            app:layout_constraintWidth_percent="0.25">
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/s46"
                android:gravity="center"
                android:id="@+id/tv_step_element_value"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/size_3dp"
                android:text="@string/sky_realtimeData_empty"
                android:lines="1"
                android:layout_marginStart="@dimen/size_5dp"
                android:layout_marginEnd="@dimen/size_5dp"
                app:layout_constraintBottom_toTopOf="@+id/tv_step_element_title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"
                style="@style/Rainbow.TextAppearance.Body3"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/s46"
                android:gravity="center"
                android:id="@+id/tv_step_element_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/recommend_step"
                android:maxLines="3"
                android:layout_marginStart="@dimen/size_5dp"
                android:layout_marginEnd="@dimen/size_5dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_step_element_value"
                style="@style/Rainbow.TextAppearance.Body3"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/container_wakeup_element"
            android:background="@drawable/bg_top_right_recommend"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginEnd="@dimen/size_18dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.25">
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/s46"
                android:gravity="center"
                android:id="@+id/tv_wakeup_element_value"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/size_3dp"
                android:text="@string/sky_realtimeData_empty"
                android:lines="1"
                android:layout_marginStart="@dimen/size_5dp"
                android:layout_marginEnd="@dimen/size_5dp"
                app:layout_constraintBottom_toTopOf="@+id/tv_wakeup_element_title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"
                style="@style/Rainbow.TextAppearance.Body3"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/s46"
                android:gravity="center"
                android:id="@+id/tv_wakeup_element_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/recommend_wakeup"
                android:maxLines="3"
                android:layout_marginStart="@dimen/size_5dp"
                android:layout_marginEnd="@dimen/size_5dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_wakeup_element_value"
                style="@style/Rainbow.TextAppearance.Body4"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <Space
            android:id="@+id/space_end"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginEnd="@dimen/size_18dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/container_wakeup_element"
            app:layout_constraintWidth_percent="0.0875"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/container_resthr_element"
            android:background="@drawable/bg_bottom_right_recommend"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginEnd="@dimen/size_18dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/space_end"
            app:layout_constraintWidth_percent="0.25">
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/s46"
                android:gravity="center"
                android:id="@+id/tv_resthr_element_value"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/size_3dp"
                android:text="@string/sky_realtimeData_empty"
                android:lines="1"
                android:layout_marginStart="@dimen/size_5dp"
                android:layout_marginEnd="@dimen/size_5dp"
                app:layout_constraintBottom_toTopOf="@+id/tv_resthr_element_title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"
                style="@style/Rainbow.TextAppearance.Body3"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/s46"
                android:gravity="center"
                android:id="@+id/tv_resthr_element_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/recommend_resthr"
                android:maxLines="3"
                android:layout_marginStart="@dimen/size_5dp"
                android:layout_marginEnd="@dimen/size_5dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_resthr_element_value"
                style="@style/Rainbow.TextAppearance.Body3"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
