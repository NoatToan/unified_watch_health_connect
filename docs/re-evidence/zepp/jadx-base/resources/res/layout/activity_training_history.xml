<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/share_header"
        android:background="@color/white100"
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:paddingStart="18dp">
        <com.huami.lib.view.image.HMCircleImageView
            android:id="@+id/imv_user_avatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/default_user_avatar"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/black70"
            android:id="@+id/tv_user_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_alignTop="@+id/imv_user_avatar"
            android:layout_marginStart="12dp"
            android:layout_toEndOf="@+id/imv_user_avatar"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/black40"
            android:id="@+id/tv_exercise_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="2dp"
            android:layout_alignBottom="@+id/imv_user_avatar"
            android:layout_alignStart="@+id/tv_user_name"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/right_area"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true">
            <ImageView
                android:id="@+id/icon_training"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginTop="3dp"
                android:src="@drawable/icon_training_course"/>
            <TextView
                android:textSize="10sp"
                android:textColor="@color/black40"
                android:gravity="center"
                android:id="@+id/exercise_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:maxWidth="80dp"
                android:text="@string/sport_type_train"/>
        </LinearLayout>
        <View
            android:layout_height="32dp"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/right_area"
            style="@style/HorizontalDivider"/>
    </RelativeLayout>
    <com.xiaomi.hm.health.training.ui.widget.StickHeaderLayout
        android:orientation="vertical"
        android:id="@+id/stick_layout"
        android:background="@color/pale_grey"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include layout="@layout/layout_image_header"/>
        <com.xiaomi.hm.health.training.ui.widget.StickHeaderChildScrollView
            android:id="@+id/nsv_bottom"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:overScrollMode="never">
            <LinearLayout
                android:orientation="vertical"
                android:background="@color/pale_grey"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <include layout="@layout/training_history_hr_section"/>
                <include layout="@layout/training_history_detail_chart_section"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/action_list_container"
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/black40"
                        android:gravity="center_vertical"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:text="@string/action_list"/>
                    <View style="@style/VerticalDivider"/>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/action_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>
        </com.xiaomi.hm.health.training.ui.widget.StickHeaderChildScrollView>
    </com.xiaomi.hm.health.training.ui.widget.StickHeaderLayout>
</FrameLayout>
