<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.xiaomi.hm.health.bodyfat.view.SlidingConflictScrollView
        android:id="@+id/scroll_view_bodyfat"
        android:background="@color/s10"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottom_layout">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:id="@+id/bodyfat_content"
            android:background="@color/s10"
            android:paddingBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:id="@+id/bodyfat_header"
                android:background="@drawable/scale_detail_header_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:id="@+id/chart_bg_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <RelativeLayout
                    android:id="@+id/body_fat_rl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="38dp">
                    <com.huami.widget.typeface.TypefaceTextView
                        android:id="@+id/score_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="@string/body_score_desc"
                        android:layout_centerHorizontal="true"
                        style="@style/bodyfatScoreDescStyle"/>
                    <com.huami.lib.view.text.UnitTextView
                        android:id="@+id/score_value_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/score_desc"
                        android:layout_centerHorizontal="true"
                        style="@style/bodyfatScoreStyle"/>
                    <com.huami.widget.typeface.TypefaceTextView
                        android:id="@+id/mid_data_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:layout_below="@+id/score_value_tv"
                        android:layout_centerHorizontal="true"
                        android:drawableEnd="@drawable/icon_right_arrow_normal"
                        style="@style/bodyfatWeightStyle"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/chart_container"
                    android:layout_width="match_parent"
                    android:layout_height="109dp"
                    android:layout_below="@+id/body_fat_rl"/>
                <com.xiaomi.hm.health.bodyfat.view.WeightLoadingStatus
                    android:id="@+id/loading_status"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </RelativeLayout>
            <View
                android:id="@+id/view_alpha"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:alpha="0"
                app:layout_constraintBottom_toBottomOf="@+id/bodyfat_header"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <RelativeLayout
                android:id="@+id/user_picker_ll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/view_alpha">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="10dp"
                    android:src="@drawable/ic_triangle"
                    android:layout_centerHorizontal="true"/>
                <com.xiaomi.hm.health.bodyfat.view.WeightUserQuickPicker
                    android:id="@+id/user_picker"
                    android:background="@color/s38"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginTop="10dp"/>
                <View
                    android:id="@+id/divider"
                    android:background="@color/s4"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginTop="10dp"/>
            </RelativeLayout>
            <View
                android:id="@+id/divider1"
                android:background="@color/s4"
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider_slp_info"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/user_picker_ll"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/layout_body_params_all_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/divider1">
                <FrameLayout
                    android:id="@+id/hr_pressure_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <FrameLayout
                    android:id="@+id/body_index_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <FrameLayout
                    android:id="@+id/weight_change_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <FrameLayout
                    android:id="@+id/bodyfat_change_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <FrameLayout
                    android:id="@+id/muscle_change_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <ImageView
                    android:id="@+id/body_fat_char_ad_view"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"/>
            </LinearLayout>
            <RelativeLayout
                android:id="@+id/bf_empty_rl"
                android:background="@color/s36"
                android:layout_width="match_parent"
                android:layout_height="156dp"
                android:layout_marginTop="10dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/layout_body_params_all_id">
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/s2"
                    android:gravity="center"
                    android:id="@+id/bf_empty_tv"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableTop="@drawable/bf3_baby_error"
                    android:drawablePadding="12dp"
                    android:layout_centerInParent="true"/>
            </RelativeLayout>
            <include
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/bf_empty_rl"
                layout="@layout/card_status_introduces"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="12sp"
                android:textColor="@color/s3"
                android:id="@+id/jp_body_fat_hint_text"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="このデータは、Amazfit/Zeppブランドの体組成計製品でのみ表示できます"
                android:layout_marginStart="25dp"
                android:layout_marginEnd="25dp"
                app:layout_constraintTop_toBottomOf="@+id/card_status"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.xiaomi.hm.health.bodyfat.view.SlidingConflictScrollView>
    <include
        android:id="@+id/bottom_layout"
        android:layout_width="match_parent"
        android:layout_height="67dp"
        android:layout_alignParentBottom="true"
        layout="@layout/layout_weight_detail_bottom"/>
</RelativeLayout>
