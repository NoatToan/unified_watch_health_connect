<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:background="@color/bg_color_white"
    android:layout_width="match_parent"
    android:layout_height="64dp">
    <ImageView
        android:id="@+id/hr_icon"
        android:layout_centerVertical="true"
        android:layout_marginStart="19dp"
        style="@style/hrIconStyle"/>
    <TextView
        android:id="@+id/hr_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:layout_marginStart="15dp"
        android:layout_toEndOf="@+id/hr_icon"
        style="@style/hrDateTStyle"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:id="@+id/hr_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_below="@+id/hr_date"
        android:fontFamily="km"
        android:layout_alignStart="@+id/hr_date"
        style="@style/hrValueStyle"/>
    <TextView
        android:id="@+id/hr_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/unit_hr"
        android:layout_alignBaseline="@+id/hr_value"
        android:layout_marginStart="3dp"
        android:layout_toEndOf="@+id/hr_value"
        style="@style/hrUnitStyle"/>
    <TextView
        android:id="@+id/hr_mark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBaseline="@+id/hr_unit"
        android:layout_marginStart="6dp"
        android:layout_toEndOf="@+id/hr_unit"
        style="@style/hrUnitStyle"/>
    <ImageView
        android:id="@+id/right_arrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/default_end_arrow"
        android:layout_centerVertical="true"
        android:layout_marginEnd="19dp"
        android:layout_alignParentEnd="true"/>
    <View
        android:id="@+id/divider"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        style="@style/itemHeartRateDividerStyle"/>
</RelativeLayout>
