<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s36"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textAppearance="@style/TextAppearance.MiFit.Title.Inverse"
        android:textColor="@color/s1"
        android:gravity="center"
        android:id="@+id/dialog_title"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/wl_pay_order"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="@style/TextAppearance.MiFit.Title2.Inverse"
        android:textColor="@color/s2"
        android:gravity="center_vertical"
        android:id="@+id/dialog_message"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/size_58dp"
        android:layout_marginStart="@dimen/wl_border_margin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dialog_title"/>
    <TextView
        android:textAppearance="@style/TextAppearance.MiFit.Title2.Blue"
        android:textColor="@color/s41"
        android:gravity="center_vertical"
        android:id="@+id/recharge_money"
        android:layout_width="wrap_content"
        android:layout_height="58dp"
        android:layout_marginEnd="@dimen/wl_border_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dialog_title"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/payment_mode_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/dialog_message"/>
    <Button
        android:id="@+id/pay_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_18dp"
        android:layout_marginBottom="18dp"
        android:text="@string/wl_pay"
        android:layout_marginStart="@dimen/wl_border_margin"
        android:layout_marginEnd="@dimen/wl_border_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/payment_mode_list"
        style="@style/Rainbow.Widget.Button.44.Circular"/>
    <View
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dialog_title"
        style="@style/HorizontalLine.Dim"/>
    <View
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/payment_mode_list"
        style="@style/HorizontalLine.Dim"/>
    <View
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/payment_mode_list"
        style="@style/HorizontalLine.Dim"/>
</androidx.constraintlayout.widget.ConstraintLayout>
