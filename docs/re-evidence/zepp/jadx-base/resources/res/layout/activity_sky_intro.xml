<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true">
    <com.huami.lib.rainbow.titlebar.RainbowTitleBar
        android:id="@+id/title_bar"
        android:background="@android:color/transparent"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:statusBarMode="dark"
        style="@style/Rainbow.TextAppearance.Title3"/>
    <com.airbnb.lottie.LottieAnimationView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.3"
        app:lottie_autoPlay="true"
        app:lottie_fileName="sky_main_bg.json"
        app:lottie_loop="true"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_bar">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/head_Animation_View"
                android:layout_width="wrap_content"
                android:layout_height="200dp"
                app:lottie_fileName="sky_intro_head.json"/>
            <TextView
                android:textColor="@color/s46"
                android:id="@+id/intro_content"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/sky_intro_content"
                android:lineSpacingExtra="8dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                style="@style/Rainbow.TextAppearance.Body3"/>
            <com.google.android.material.button.MaterialButton
                android:textSize="16sp"
                android:textColor="@color/s46"
                android:id="@+id/enter"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="40dp"
                android:text="@string/sky_intro_enter"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:backgroundTint="@color/s45"
                style="?attr/buttonStyleGray_44_flat_circular"/>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
