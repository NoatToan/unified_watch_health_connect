<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.huami.training.ui.widget.RoundImageView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:bottom_radius="@dimen/tr_kankan_item_radius"
        app:layout_constraintDimensionRatio="h,320:120"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:up_radius="@dimen/tr_kankan_item_radius"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="16sp"
        android:textColor="#ffffff"
        android:gravity="start"
        android:id="@+id/name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:fontFamily="lt-bold"
        android:layout_marginStart="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/image"
        app:layout_constraintStart_toStartOf="@+id/image"
        style="@style/TrainingTextSingleLineStyle"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="11.3sp"
        android:textColor="@color/tr_white"
        android:id="@+id/level"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="15dp"
        android:fontFamily="lt"
        android:layout_marginStart="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <View
        android:id="@+id/level_number_divider"
        android:background="@color/tr_divider_v"
        android:layout_width="0.3dp"
        android:layout_height="9.3dp"
        android:layout_marginBottom="17.7dp"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/level"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="11.3sp"
        android:textColor="@color/tr_white"
        android:id="@+id/number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="lt"
        android:layout_marginStart="4dp"
        app:layout_constraintBaseline_toBaselineOf="@+id/level"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/level_number_divider"/>
    <View
        android:id="@+id/number_calorie_divider"
        android:background="@color/tr_divider_v"
        android:layout_width="0.3dp"
        android:layout_height="9.3dp"
        android:layout_marginBottom="17.7dp"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/number"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="11.3sp"
        android:textColor="@color/tr_white"
        android:id="@+id/calorie"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="lt"
        android:layout_marginStart="4dp"
        app:layout_constraintBaseline_toBaselineOf="@+id/number"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/number_calorie_divider"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="11.3sp"
        android:textColor="@color/tr_white"
        android:id="@+id/participants"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="15dp"
        android:fontFamily="lt"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="10.7sp"
        android:textColor="@color/tr_white"
        android:gravity="center"
        android:id="@+id/label"
        android:background="@drawable/tr_shape_corner_label_v2"
        android:padding="2dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="lt"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
