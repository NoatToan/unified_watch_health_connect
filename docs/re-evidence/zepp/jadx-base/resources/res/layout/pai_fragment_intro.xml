<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingBottom="19dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_pai_question"
        android:background="@drawable/bg_white_round_rect"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_marginTop="15dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp">
        <TextView
            android:textColor="@color/s5"
            android:background="@drawable/bg_pb_red"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Q&amp;A"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:layout_marginStart="15dp"
            style="@style/Rainbow.TextAppearance.Body4"/>
        <TextView
            android:textColor="@color/s1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/pai_questions_and_answers"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            style="@style/Rainbow.TextAppearance.Body4"/>
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_arrow_forward_20_2x"
            android:layout_marginEnd="15dp"
            app:tint="@color/s1"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/bg_white_round_rect"
        android:paddingBottom="19dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp">
        <com.huami.widget.typeface.TypefaceTextView
            android:textColor="@color/s1"
            android:gravity="start|center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/pai_pai_info"
            android:layout_marginStart="20dp"
            style="@style/Rainbow.TextAppearance.Title3"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textColor="@color/s1"
            android:gravity="start|center_vertical"
            android:id="@+id/tv_paiinfo_info1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/pai_detail_desc"
            android:lineSpacingExtra="4dp"
            android:textDirection="locale"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="21.1dp"
            style="@style/Rainbow.TextAppearance.Body5"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textColor="@color/s1"
            android:gravity="start|center_vertical"
            android:id="@+id/tv_paiinfo_info2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:lineSpacingExtra="4dp"
            android:textDirection="locale"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="21.1dp"
            style="@style/Rainbow.TextAppearance.Body5"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textColor="@color/s2"
            android:gravity="start|center_vertical"
            android:id="@+id/tv_paiinfo_info3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:lineSpacingExtra="4dp"
            android:textDirection="locale"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="21.1dp"
            style="@style/Rainbow.TextAppearance.Body5"/>
    </LinearLayout>
</LinearLayout>
