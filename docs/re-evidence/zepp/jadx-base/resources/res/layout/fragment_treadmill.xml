<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s38"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/td_head"
        android:background="@color/s38"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:id="@+id/status_binding"
            android:background="@color/s38"
            android:paddingTop="@dimen/td_size_20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/td_size_14dp"
            android:paddingEnd="@dimen/td_size_10dp"
            app:divider="@drawable/td_head_info_divider"
            app:dividerPadding="@dimen/td_size_6dp"
            app:showDividers="middle">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/s1"
                android:id="@+id/td_line_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/td_size_10dp"
                android:text="@string/amazfit_airrun"
                android:layout_marginStart="@dimen/td_size_6dp"
                android:letterSpacing="0.02"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:paddingTop="0dp"
                android:paddingBottom="@dimen/td_size_19dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.constraintlayout.widget.Guideline
                    android:orientation="vertical"
                    android:id="@+id/begin_guide_line"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintGuide_begin="60dp"/>
                <androidx.constraintlayout.widget.Guideline
                    android:orientation="vertical"
                    android:id="@+id/end_guide_line"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintGuide_percent="0.85"/>
                <androidx.constraintlayout.widget.Guideline
                    android:orientation="vertical"
                    android:id="@+id/middle_guide_line"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintGuide_percent="0.5"/>
                <com.huami.widget.typeface.TypefaceTextView
                    android:textSize="20sp"
                    android:textColor="@color/s1"
                    android:id="@+id/cumulative_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="ow"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="@+id/begin_guide_line"
                    app:layout_constraintStart_toStartOf="@+id/begin_guide_line"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.huami.widget.typeface.TypefaceTextView
                    android:textSize="20sp"
                    android:textColor="@color/s1"
                    android:id="@+id/calories"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="ow"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="@+id/middle_guide_line"
                    app:layout_constraintStart_toStartOf="@+id/middle_guide_line"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.huami.widget.typeface.TypefaceTextView
                    android:textSize="20sp"
                    android:textColor="@color/s1"
                    android:id="@+id/total_dis"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="ow"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="@+id/end_guide_line"
                    app:layout_constraintStart_toStartOf="@+id/end_guide_line"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.huami.widget.typeface.TypefaceTextView
                    android:textSize="@dimen/td_size_11sp"
                    android:textColor="@color/s2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/td_size_6dp"
                    android:text="@string/tdmill_cumulative_number"
                    android:fontFamily="lt"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="@+id/begin_guide_line"
                    app:layout_constraintStart_toStartOf="@+id/begin_guide_line"
                    app:layout_constraintTop_toBottomOf="@+id/cumulative_number"/>
                <com.huami.widget.typeface.TypefaceTextView
                    android:textSize="@dimen/td_size_11sp"
                    android:textColor="@color/s2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/td_size_6dp"
                    android:text="@string/tdmill_cost_calories"
                    android:fontFamily="lt"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="@+id/middle_guide_line"
                    app:layout_constraintStart_toStartOf="@+id/middle_guide_line"
                    app:layout_constraintTop_toBottomOf="@+id/calories"/>
                <com.huami.widget.typeface.TypefaceTextView
                    android:textSize="@dimen/td_size_11sp"
                    android:textColor="@color/s2"
                    android:id="@+id/total_dis_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/td_size_6dp"
                    android:text="@string/td_total_dis_kilometer"
                    android:fontFamily="lt"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="@+id/end_guide_line"
                    app:layout_constraintStart_toStartOf="@+id/end_guide_line"
                    app:layout_constraintTop_toBottomOf="@+id/total_dis"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/cl_ff5353"
                android:gravity="center_vertical"
                android:id="@+id/not_uploaded"
                android:paddingTop="@dimen/td_size_19dp"
                android:paddingBottom="@dimen/td_size_19dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="@dimen/td_size_10dp"
                android:lineSpacingExtra="1.4sp"
                android:drawableStart="@drawable/info_notification"
                android:drawableEnd="@drawable/info_notification_arrow"
                android:paddingStart="@dimen/td_size_19dp"
                android:paddingEnd="@dimen/td_size_19dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/cl_ff5353"
                android:gravity="center_vertical"
                android:id="@+id/maintain_tip"
                android:paddingTop="@dimen/td_size_19dp"
                android:paddingBottom="@dimen/td_size_19dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/td_add_oil_tip"
                android:drawablePadding="@dimen/td_size_10dp"
                android:lineSpacingExtra="1.4sp"
                android:drawableStart="@drawable/info_notification"
                android:drawableEnd="@drawable/info_notification_arrow"
                android:paddingStart="@dimen/td_size_19dp"
                android:paddingEnd="@dimen/td_size_19dp"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/status_unbinding"
            android:background="@drawable/td_unbinding_shape"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/td_size_14dp"
            android:layout_marginEnd="@dimen/td_size_14dp">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/s5"
                android:paddingBottom="@dimen/td_size_16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/td_size_19dp"
                android:text="@string/tdmill_unbind_info"
                android:maxLines="10"
                android:lineSpacingExtra="6.2sp"
                android:paddingStart="@dimen/td_size_18dp"
                android:paddingEnd="@dimen/td_size_18dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/cl_ff5353"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/btn_detail"
                android:background="@drawable/td_origin_stroke_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/td_size_19dp"
                android:layout_marginBottom="@dimen/td_size_19dp"
                android:text="@string/btn_look_detail"
                android:height="@dimen/td_size_24dp"
                android:paddingStart="@dimen/td_size_14dp"
                android:paddingEnd="@dimen/td_size_14dp"/>
        </LinearLayout>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:id="@+id/td_lines"
        android:background="@color/s38"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/td_size_10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/td_head">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/s1"
            android:id="@+id/td_lines_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/td_size_20dp"
            android:text="@string/tdmill_run_line_recommend_title"
            android:layout_marginStart="@dimen/td_size_20dp"
            android:letterSpacing="0.02"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/s2"
            android:id="@+id/btn_look_more"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tdmill_look_more"
            android:layout_marginEnd="@dimen/td_size_20dp"
            android:letterSpacing="0.03"
            app:layout_constraintBottom_toBottomOf="@+id/td_lines_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/td_lines_title"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view"
            android:paddingBottom="@dimen/td_size_20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/td_size_10dp"
            android:layout_marginStart="@dimen/td_size_20dp"
            android:layout_marginEnd="@dimen/td_size_20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/td_lines_title"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
