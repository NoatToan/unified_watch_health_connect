<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/s36"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="46.3dp">
        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_arrow_back_20_2x"
            android:scaleType="centerInside"
            android:layout_centerVertical="true"
            android:onClick="onBackClick"
            android:layout_marginStart="10dp"
            app:tint="@color/s1"/>
        <TextView
            android:textColor="@color/s1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ecg_detail"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@+id/btn_back"
            style="@style/Rainbow.TextAppearance.Title3"/>
        <TextView
            android:textColor="@color/s1"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            style="@style/Rainbow.TextAppearance.Title3"/>
        <TextView
            android:textStyle="bold"
            android:textColor="@color/p3"
            android:id="@+id/export"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ecg_export_simple"
            android:layout_centerVertical="true"
            android:onClick="export"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_alignParentEnd="true"
            style="@style/Rainbow.TextAppearance.Number7"/>
        <ImageView
            android:id="@+id/showRaw"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_ecg_hrv_on"
            android:scaleType="centerInside"
            android:layout_centerVertical="true"
            android:onClick="showRaw"
            android:layout_marginStart="10dp"
            android:layout_toStartOf="@+id/export"
            app:tint="@color/s1"/>
        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_ecg_filter_turn"
            android:scaleType="centerInside"
            android:layout_centerVertical="true"
            android:onClick="rotateFilter"
            android:layout_toStartOf="@+id/showRaw"
            app:tint="@color/s1"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <com.huami.watch.companion.ecg.view.SeekHorizontalScrollView
            android:id="@+id/scroll"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <com.huami.ecg.chart.LineChartView
                android:id="@+id/lv_line_chart"
                android:background="@color/s36"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                app:gridColor="@color/s3"
                app:heightSize="10"
                app:isShowStandard="false"
                app:lineColor="@color/s1"
                app:showAbnormalOverlay="true"
                app:showTime="true"/>
        </com.huami.watch.companion.ecg.view.SeekHorizontalScrollView>
        <ImageView
            android:id="@+id/label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:src="@drawable/ic_ecg_wtf"
            android:layout_marginStart="8dp"/>
        <TextView
            android:textColor="@color/s20"
            android:id="@+id/tv_afib"
            android:padding="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:layout_toEndOf="@+id/label"
            style="@style/Rainbow.TextAppearance.Number8"/>
        <TextView
            android:textColor="@color/s36"
            android:id="@+id/tv_ecg_owner"
            android:background="@drawable/bg_measure_self"
            android:padding="2dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="20dp"
            android:layout_alignParentEnd="true"
            style="@style/Rainbow.TextAppearance.Number8"/>
        <TextView
            android:textColor="@color/s1"
            android:id="@+id/avg_hr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="20dp"
            style="@style/Rainbow.TextAppearance.Number7"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="20dp"
            android:layout_alignParentEnd="true">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/s1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ecg_gain"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/s20"
                android:id="@+id/gain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="10dp"
                android:onClick="setGain"
                android:drawableEnd="@drawable/ic_arrow_down"
                android:layout_marginStart="5dp"/>
            <TextView
                android:textColor="@color/s1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ecg_speed"
                android:layout_marginStart="10dp"
                style="@style/Rainbow.TextAppearance.Number8"/>
            <TextView
                android:textColor="@color/s20"
                android:id="@+id/speed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="10dp"
                android:onClick="setSpeed"
                android:drawableEnd="@drawable/ic_arrow_down"
                android:layout_marginStart="5dp"
                style="@style/Rainbow.TextAppearance.Number8"/>
        </LinearLayout>
    </RelativeLayout>
    <androidx.appcompat.widget.AppCompatSeekBar
        android:id="@+id/seek_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:indeterminateOnly="false"
        android:progressDrawable="@drawable/scrollbar_bg"
        android:thumb="@drawable/ic_scrollbar"
        android:splitTrack="false"/>
</LinearLayout>
