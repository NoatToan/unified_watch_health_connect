<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/s36"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/account_ui_size_12sp"
        android:textColor="@color/s2"
        android:id="@+id/tv_bind_new_phone_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/account_ui_size_16dp"
        android:layout_marginBottom="@dimen/account_ui_size_16dp"
        android:text="@string/account_ui_account_bind_phone_desc"
        android:layout_marginStart="@dimen/account_ui_hm_email_input_margin"
        android:layout_marginEnd="@dimen/account_ui_hm_email_input_margin"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_change_bind_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/account_ui_size_14dp"
        android:layout_marginBottom="@dimen/account_ui_size_12dp">
        <TextView
            android:textSize="@dimen/account_ui_size_14sp"
            android:textColor="@color/s2"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/account_ui_account_change_bind_phone_tip"
            android:layout_marginStart="@dimen/account_ui_hm_email_input_margin"
            android:layout_marginEnd="@dimen/account_ui_hm_email_input_margin"/>
        <TextView
            android:textSize="@dimen/account_ui_size_14sp"
            android:textColor="@color/s2"
            android:gravity="center_vertical"
            android:id="@+id/tv_current_phone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/account_ui_size_29dp"
            android:text="@string/account_ui_account_current_phone_tip"
            android:layout_marginStart="@dimen/account_ui_hm_email_input_margin"
            android:layout_marginEnd="@dimen/account_ui_hm_email_input_margin"/>
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/account_ui_hm_email_input_height"
        android:layout_marginStart="@dimen/account_ui_hm_email_input_margin"
        android:layout_marginEnd="@dimen/account_ui_hm_email_input_margin">
        <TextView
            android:textSize="@dimen/account_ui_size_14sp"
            android:textColor="@color/s2"
            android:gravity="center_vertical"
            android:paddingBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/account_ui_hm_email_input_height"
            android:text="+86"/>
        <androidx.appcompat.widget.AppCompatEditText
            android:textSize="@dimen/account_ui_hm_email_text_size"
            android:textColor="@color/s1"
            android:textColorHint="@color/s3"
            android:gravity="center_vertical"
            android:id="@+id/input_phone_number"
            android:background="@drawable/account_ui_account_input_text_bg"
            android:paddingLeft="@dimen/account_ui_size_32dp"
            android:paddingRight="@dimen/account_ui_hm_email_input_margin"
            android:layout_width="match_parent"
            android:layout_height="@dimen/account_ui_hm_email_input_height"
            android:hint="@string/account_ui_account_input_phone"
            android:inputType="phone"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/hm_email_verification_code_rl"
        android:background="@drawable/account_ui_account_input_text_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/account_ui_hm_email_input_height"
        android:layout_marginTop="@dimen/account_ui_hm_email_password_margin_top"
        android:layout_marginStart="@dimen/account_ui_hm_email_input_margin"
        android:layout_marginEnd="@dimen/account_ui_hm_email_input_margin">
        <androidx.appcompat.widget.AppCompatEditText
            android:textSize="@dimen/account_ui_hm_email_text_size"
            android:textColor="@color/s1"
            android:textColorHint="@color/s3"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/input_verification_code"
            android:background="@color/account_ui_trans"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:hint="@string/account_ui_account_input_verify_code"
            android:maxEms="6"
            android:layout_weight="1"
            android:inputType="numberDecimal"/>
        <TextView
            android:layout_gravity="end|top"
            android:id="@+id/send_verify_btn"
            android:layout_height="match_parent"
            android:layout_marginTop="3.3dp"
            android:layout_marginBottom="3.3dp"
            android:text="@string/account_ui_account_get_verify_code"
            style="@style/AccountUiGetVerificationCodeButton"/>
    </LinearLayout>
    <TextView
        android:enabled="false"
        android:textSize="@dimen/account_ui_login_btn_text_size"
        android:textColor="@color/account_ui_select_alive_btn_txt_color"
        android:gravity="center"
        android:id="@+id/confirm_btn"
        android:background="@drawable/account_ui_btn_bg_login"
        android:layout_width="match_parent"
        android:layout_height="@dimen/account_ui_click_button_h"
        android:layout_marginTop="@dimen/account_ui_hm_email_register_btn_margin_top"
        android:text="@string/account_ui_login_email_forget_password_commit"
        android:layout_marginStart="@dimen/account_ui_hm_email_input_margin"
        android:layout_marginEnd="@dimen/account_ui_hm_email_input_margin"/>
</LinearLayout>
