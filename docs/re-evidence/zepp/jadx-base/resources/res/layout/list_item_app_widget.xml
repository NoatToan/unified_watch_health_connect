<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:layout_marginBottom="1px">
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/dot_or_menu"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:paddingStart="24dp"
        android:paddingEnd="20dp"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/icon"
        android:background="@drawable/border_app_icon"
        android:padding="1px"
        android:layout_width="38dp"
        android:layout_height="38dp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#e6000000"
        android:layout_gravity="center_vertical"
        android:id="@+id/text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="13dp"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/watch_app_setting_img"
        android:focusable="false"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"/>
    <FrameLayout
        android:id="@+id/enable_widget_view"
        android:visibility="gone"
        android:layout_width="60dp"
        android:layout_height="match_parent">
        <Switch
            android:layout_gravity="start|center_vertical"
            android:id="@+id/enable_widget"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:textOn=""
            android:textOff=""
            style="@style/WatchSwitch"/>
        <View
            android:id="@+id/click_area"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
</LinearLayout>
