<?xml version="1.0" encoding="utf-8"?>
<com.huami.bloodoxygen.ui.view.BloodOxygenCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bo_ui_size_55dp">
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <View
                android:layout_gravity="center_vertical"
                android:background="@drawable/bo_ui_shape_circle_normal"
                android:layout_width="@dimen/bo_ui_size_10dp"
                android:layout_height="@dimen/bo_ui_size_10dp"
                android:layout_marginStart="@dimen/bo_ui_size_15dp"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="@dimen/bo_ui_size_14sp"
                android:textColor="@color/s2"
                android:layout_gravity="center_vertical"
                android:id="@+id/normal_start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/bo_ui_size_5dp"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="@dimen/bo_ui_size_14sp"
                android:textColor="@color/s2"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bo_ui_split"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="@dimen/bo_ui_size_14sp"
                android:textColor="@color/s2"
                android:layout_gravity="center_vertical"
                android:id="@+id/normal_end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/bo_ui_size_55dp">
            <View
                android:layout_gravity="center_vertical"
                android:background="@drawable/bo_ui_shape_circle_abnormal"
                android:layout_width="@dimen/bo_ui_size_10dp"
                android:layout_height="@dimen/bo_ui_size_10dp"
                android:layout_marginStart="@dimen/bo_ui_size_15dp"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="@dimen/bo_ui_size_14sp"
                android:textColor="@color/s2"
                android:layout_gravity="center_vertical"
                android:id="@+id/abnormal_start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/bo_ui_size_5dp"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="@dimen/bo_ui_size_14sp"
                android:textColor="@color/s2"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bo_ui_split"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="@dimen/bo_ui_size_14sp"
                android:textColor="@color/s2"
                android:layout_gravity="center_vertical"
                android:id="@+id/abnormal_end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
</com.huami.bloodoxygen.ui.view.BloodOxygenCardView>
