<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="15.4sp"
        android:textColor="@color/s1"
        android:id="@+id/td_run_dis"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/td_size_19dp"
        android:layout_marginStart="@dimen/td_size_31dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/td_user_time"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/s2"
        android:id="@+id/td_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/td_size_2dp"
        android:layout_marginBottom="@dimen/td_size_17dp"
        android:layout_marginStart="@dimen/td_size_31dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/td_run_dis"/>
    <TextView
        android:textSize="11.7sp"
        android:textColor="@color/s1"
        android:gravity="end"
        android:id="@+id/td_user_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/td_size_3dp"
        app:layout_constraintBottom_toBottomOf="@+id/td_run_dis"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toEndOf="@+id/td_run_dis"/>
    <FrameLayout
        android:id="@+id/checkbox_area"
        android:focusable="true"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/td_run_dis"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <CheckBox
            android:layout_gravity="center_vertical"
            android:id="@+id/td_checkbox"
            android:background="@drawable/td_check_box_selector"
            android:clickable="false"
            android:layout_width="@dimen/td_size_17dp"
            android:layout_height="@dimen/td_size_17dp"
            android:button="@null"
            android:layout_marginStart="@dimen/td_size_4dp"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
