<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="@color/s2"
        android:id="@+id/sport_energy_no_data"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/health_data_no_data"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Rainbow.TextAppearance.Body5"/>
    <com.xiaomi.hm.health.ui.sportfitness.view.ExerciseXAxisView
        android:id="@+id/sport_energy_x_axis"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="@+id/sport_energy_chart_area"
        app:layout_constraintRight_toRightOf="@+id/sport_energy_chart_area"
        app:layout_constraintTop_toBottomOf="@+id/sport_energy_chart_area"/>
    <View
        android:id="@+id/first_line"
        android:background="@color/s4"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginEnd="31dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/sport_energy_chart_area"/>
    <TextView
        android:textColor="@color/s3"
        android:id="@+id/first_value"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/zero_value"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/first_line"
        app:layout_constraintLeft_toRightOf="@+id/first_line"
        app:layout_constraintTop_toTopOf="@+id/first_line"
        style="@style/Rainbow.TextAppearance.Number8"/>
    <View
        android:id="@+id/sec_line"
        android:background="@color/s4"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="50dp"
        android:layout_marginEnd="31dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/first_line"/>
    <TextView
        android:textColor="@color/s3"
        android:id="@+id/sec_value"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/zero_value"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/sec_line"
        app:layout_constraintLeft_toRightOf="@+id/sec_line"
        app:layout_constraintTop_toTopOf="@+id/sec_line"
        style="@style/Rainbow.TextAppearance.Number8"/>
    <View
        android:id="@+id/tri_line"
        android:background="@color/s4"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginBottom="50dp"
        android:layout_marginEnd="31dp"
        app:layout_constraintBottom_toTopOf="@+id/bottom_line"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <TextView
        android:textColor="@color/s3"
        android:id="@+id/tri_value"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/zero_value"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/tri_line"
        app:layout_constraintLeft_toRightOf="@+id/tri_line"
        app:layout_constraintTop_toTopOf="@+id/tri_line"
        style="@style/Rainbow.TextAppearance.Number8"/>
    <View
        android:id="@+id/bottom_line"
        android:background="@color/s4"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginEnd="31dp"
        app:layout_constraintBottom_toBottomOf="@+id/sport_energy_chart_area"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <TextView
        android:textColor="@color/s3"
        android:id="@+id/bottom_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/zero_value"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/bottom_line"
        app:layout_constraintLeft_toRightOf="@+id/bottom_line"
        app:layout_constraintTop_toTopOf="@+id/bottom_line"
        style="@style/Rainbow.TextAppearance.Number8"/>
    <View
        android:id="@+id/mid_line"
        android:background="@color/s4"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginEnd="31dp"
        app:layout_constraintBottom_toBottomOf="@+id/sport_energy_chart_area"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/sport_energy_chart_area"/>
    <TextView
        android:textColor="@color/s3"
        android:id="@+id/mid_value"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/zero_value"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/mid_line"
        app:layout_constraintLeft_toRightOf="@+id/mid_line"
        app:layout_constraintTop_toTopOf="@+id/mid_line"
        style="@style/Rainbow.TextAppearance.Number8"/>
    <FrameLayout
        android:id="@+id/sport_energy_chart_area"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_marginTop="@dimen/size_24dp"
        android:layout_marginEnd="31dp"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
