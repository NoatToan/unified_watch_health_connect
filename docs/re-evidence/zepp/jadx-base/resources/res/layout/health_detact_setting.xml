<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#f8f8f8"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/status_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="4dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/title_hr"
                android:paddingTop="20dp"
                android:paddingBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="18sp"
                    android:textColor="#e6000000"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/health_data_heart_rate"
                    android:layout_weight="1"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="12sp"
                    android:textColor="#ff999999"
                    android:gravity="center"
                    android:id="@+id/hr_learn_more"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_analysis_know_more"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/health_disk_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:showDividers="middle">
                <com.xiaomi.hm.health.device.view.GreyItemView
                    android:id="@+id/item_all_day_heart_rate_setting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:contentPaddingEnd="16dp"
                    app:contentPaddingStart="16dp"
                    app:disableMaskColor="@color/transparent"
                    app:itemDivider="gone"
                    app:itemEndArrow="true"
                    app:itemSummary="@string/health_detect_allday_hr_summary"
                    app:itemTitle="@string/health_detect_allday_hr_title"/>
                <com.xiaomi.hm.health.device.view.GreyItemView
                    android:id="@+id/item_hr_warning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:contentPaddingEnd="16dp"
                    app:contentPaddingStart="16dp"
                    app:disableMaskColor="@color/transparent"
                    app:itemDivider="gone"
                    app:itemEndArrow="true"
                    app:itemSummary="@string/health_detect_hr_warn_summary"
                    app:itemTitle="@string/device_health_detect_hr_warn_title"/>
                <com.xiaomi.hm.health.device.view.GreyItemView
                    android:id="@+id/item_activity_detect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:contentPaddingEnd="16dp"
                    app:contentPaddingStart="16dp"
                    app:disableMaskColor="@color/transparent"
                    app:itemDivider="gone"
                    app:itemEndArrow="true"
                    app:itemSummary="@string/health_detect_activity_hr_summary"
                    app:itemSwitch="true"
                    app:itemTitle="@string/health_detect_activity_hr_title"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/title_atrial_fib"
                android:paddingTop="20dp"
                android:paddingBottom="10dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="18sp"
                    android:textColor="#e6000000"
                    android:id="@+id/atrial_fib_title_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/abnormal_heart_beat"
                    android:layout_weight="1"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="12sp"
                    android:textColor="#ff999999"
                    android:gravity="center"
                    android:id="@+id/atrial_learn_more"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_analysis_know_more"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/health_disk_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:showDividers="middle">
                <com.xiaomi.hm.health.device.view.GreyItemView
                    android:id="@+id/item_atrial_fib_detect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:contentPaddingEnd="16dp"
                    app:contentPaddingStart="16dp"
                    app:disableMaskColor="@color/transparent"
                    app:itemDivider="gone"
                    app:itemEndArrow="true"
                    app:itemSummary="@string/health_detect_atrial_fib_summary"
                    app:itemSwitch="true"
                    app:itemTitle="@string/setting_heartrate_detect_atrial_fib"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/title_sleep"
                android:paddingTop="20dp"
                android:paddingBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="18sp"
                    android:textColor="#e6000000"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/health_data_sleep"
                    android:layout_weight="1"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="12sp"
                    android:textColor="#ff999999"
                    android:gravity="center"
                    android:id="@+id/sleep_learn_more"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_analysis_know_more"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/health_disk_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:showDividers="middle">
                <com.xiaomi.hm.health.device.view.GreyItemView
                    android:id="@+id/item_sleep_assitant"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:contentPaddingEnd="16dp"
                    app:contentPaddingStart="16dp"
                    app:disableMaskColor="@color/transparent"
                    app:itemDivider="gone"
                    app:itemEndArrow="true"
                    app:itemSummary="@string/health_detect_sleep_assist_summary"
                    app:itemSwitch="true"
                    app:itemTitle="@string/health_detect_sleep_assist_title"/>
                <com.xiaomi.hm.health.device.view.GreyItemView
                    android:id="@+id/item_sleep_osa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:contentPaddingEnd="16dp"
                    app:contentPaddingStart="16dp"
                    app:disableMaskColor="@color/transparent"
                    app:itemDivider="gone"
                    app:itemEndArrow="true"
                    app:itemSummary="@string/sleep_spo2_detect_summary_no_osa"
                    app:itemSwitch="true"
                    app:itemTitle="@string/sleep_spo2_detect_no_osa"
                    app:itemTitleTipIcon="@drawable/ic_sleep_spo2_beat"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/title_pressure"
                android:paddingTop="20dp"
                android:paddingBottom="10dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="18sp"
                    android:textColor="#e6000000"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/stress"
                    android:layout_weight="1"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="12sp"
                    android:textColor="#ff999999"
                    android:gravity="center"
                    android:id="@+id/pressure_learn_more"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_analysis_know_more"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/health_disk_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:showDividers="middle">
                <com.xiaomi.hm.health.device.view.GreyItemView
                    android:id="@+id/item_sleep_pressure"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:contentPaddingEnd="16dp"
                    app:contentPaddingStart="16dp"
                    app:disableMaskColor="@color/transparent"
                    app:itemDivider="gone"
                    app:itemEndArrow="true"
                    app:itemSummary="@string/all_day_pressure_summary"
                    app:itemSwitch="true"
                    app:itemTitle="@string/all_day_pressure_detect"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
