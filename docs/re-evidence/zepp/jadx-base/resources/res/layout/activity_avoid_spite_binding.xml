<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.lib.rainbow.ListTile
        android:id="@+id/enable_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:ltv_title="@string/avoid_spite_binding_title"
        style="@style/Rainbow.TextAppearance.Title1"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/s2"
        android:id="@+id/tips_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/avoid_spite_binding_tips_2"
        android:layout_marginStart="18.5dp"/>
</LinearLayout>
