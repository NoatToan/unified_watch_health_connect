<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/pale_grey_two"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="20sp"
        android:textColor="@color/black80"
        android:gravity="center"
        android:id="@+id/title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/play_miband3_title_1"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/black60"
        android:gravity="center"
        android:id="@+id/sub_title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:text="@string/play_miband3_subtitle_1"
        android:layout_below="@+id/title_tv"
        android:layout_centerHorizontal="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="46dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="121dp"
        android:layout_below="@+id/sub_title_tv"
        android:layout_centerHorizontal="true">
        <FrameLayout
            android:id="@+id/frame_img_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/img_band_3_time"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="10sp"
                android:textColor="@color/play_miband3_text_color"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:layout_width="47dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="60dp"
                android:text="@string/play_miband3_date"
                android:maxLines="1"
                android:fontFamily="km"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/frame_img_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/img_band_3_step_count"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="10sp"
                android:textColor="@color/play_miband3_text_color"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:layout_width="47dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="@string/play_miband3_step"
                android:maxLines="1"
                android:fontFamily="km"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="16sp"
                android:textColor="@color/play_miband3_text_color"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:layout_width="47dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="45dp"
                android:text="3614"
                android:fontFamily="km"/>
            <FrameLayout
                android:layout_gravity="bottom|center_horizontal"
                android:id="@+id/indicator_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/img_band_3_bar"/>
                <ImageView
                    android:id="@+id/indicator_img"
                    android:layout_width="11dp"
                    android:layout_height="1dp"
                    android:src="@drawable/img_band_3_bar_block"/>
            </FrameLayout>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/frame_img_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/img_band_3_heart_rate"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="10sp"
                android:textColor="@color/play_miband3_text_color"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:layout_width="47dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="38dp"
                android:text="@string/play_miband3_distance_heart_rate"
                android:maxLines="1"
                android:fontFamily="km"/>
        </FrameLayout>
    </LinearLayout>
    <View
        android:background="@color/pale_grey_two"
        android:layout_width="match_parent"
        android:layout_height="148dp"
        android:layout_marginTop="195dp"
        android:layout_below="@+id/sub_title_tv"
        android:layout_centerHorizontal="true"/>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp"
        android:src="@drawable/img_band_3"
        android:layout_below="@+id/sub_title_tv"
        android:layout_centerHorizontal="true"/>
    <View
        android:id="@+id/center_view"
        android:background="@color/transparent"
        android:layout_width="1px"
        android:layout_height="1px"
        android:layout_centerInParent="true"/>
    <ImageView
        android:id="@+id/hand_img"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="300dp"
        android:src="@drawable/img_hand"
        android:layout_toEndOf="@+id/center_view"/>
</RelativeLayout>
