<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container_view"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.amap.api.maps.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:id="@+id/map_image"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.huami.moving.ui.view.LinearGradientView
        android:id="@+id/map_top"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/guideline"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.33"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guideline1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.66"/>
    <com.huami.moving.ui.view.LinearGradientView
        android:id="@+id/map_bottom"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/guideline1"/>
    <RelativeLayout
        android:id="@+id/share_linear"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="33dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/white"
            android:id="@+id/tv_track_video_save"
            android:background="@drawable/shape_rect_orange_corner_23"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/run_share_track_video_save"
            android:drawablePadding="5dp"
            android:drawableStart="@drawable/running_track_video_save"
            android:paddingStart="38dp"
            android:paddingEnd="38dp"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/white"
            android:id="@+id/tv_track_video_share"
            android:background="@drawable/shape_rect_orange_corner_23"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/run_share_track_video_share"
            android:drawablePadding="5dp"
            android:drawableStart="@drawable/running_track_video_share"
            android:paddingStart="38dp"
            android:paddingEnd="38dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <ImageView
        android:id="@+id/back"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:layout_width="29dp"
        android:layout_height="36dp"
        android:layout_marginTop="32dp"
        android:src="@drawable/back_white"
        android:scaleType="center"
        android:contentDescription="@string/app_name"
        android:layout_marginStart="15dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/user_avatar"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_marginTop="30dp"
        android:src="@drawable/default_user_avatar"
        android:layout_marginStart="16dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/back"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:id="@+id/user_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:maxEms="10"
        android:layout_marginStart="2dp"
        android:layout_toEndOf="@+id/user_avatar"
        app:layout_constraintLeft_toRightOf="@+id/user_avatar"
        app:layout_constraintTop_toTopOf="@+id/user_avatar"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/white"
        android:id="@+id/track_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/user_avatar"
        app:layout_constraintLeft_toRightOf="@+id/user_avatar"/>
    <ImageView
        android:id="@+id/iv_water_mark"
        android:background="@drawable/ic_sport_detail_logo_have_gps"
        android:layout_width="96dp"
        android:layout_height="19dp"
        android:layout_marginEnd="14dp"
        app:layout_constraintBottom_toBottomOf="@+id/user_avatar"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/user_avatar"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/linear_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="19dp"
        app:layout_constraintBottom_toTopOf="@+id/share_linear">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                android:background="@drawable/share_time"
                android:layout_width="17dp"
                android:layout_height="17dp"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="17sp"
                android:textColor="@color/white"
                android:id="@+id/share_start_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="ow"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
        <TextView
            android:background="@color/white"
            android:layout_width="1dp"
            android:layout_height="17dp"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/lable_image_2"
                android:layout_width="17dp"
                android:layout_height="17dp"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="17sp"
                android:textColor="@color/white"
                android:id="@+id/run_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="ow"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
        <TextView
            android:background="@color/white"
            android:layout_width="1dp"
            android:layout_height="17dp"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                android:background="@drawable/share_calories"
                android:layout_width="17dp"
                android:layout_height="17dp"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="17sp"
                android:textColor="@color/white"
                android:id="@+id/run_calories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="ow"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
    </LinearLayout>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="58sp"
        android:textColor="@color/white"
        android:id="@+id/run_distance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="ow"
        android:layout_marginStart="14dp"
        app:layout_constraintBottom_toTopOf="@+id/linear_message"
        app:layout_constraintLeft_toLeftOf="parent"/>
    <TextView
        android:textSize="17sp"
        android:textColor="@color/white"
        android:id="@+id/lable_speed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:text="@string/running_kilometers"
        app:layout_constraintBottom_toTopOf="@+id/linear_message"
        app:layout_constraintLeft_toRightOf="@+id/run_distance"/>
    <ImageView
        android:id="@+id/image_icon"
        android:layout_width="17dp"
        android:layout_height="17dp"
        android:tint="#ffffff"
        app:layout_constraintBottom_toTopOf="@+id/lable_speed"
        app:layout_constraintLeft_toRightOf="@+id/run_distance"/>
    <ImageView
        android:id="@+id/image_play"
        android:background="@drawable/track_play"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
