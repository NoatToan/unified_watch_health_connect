<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/s38"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/size_18dp"
                android:paddingEnd="@dimen/size_18dp">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/size_58dp">
                    <TextView
                        android:id="@+id/tv_content"
                        android:layout_width="@dimen/size_130dp"
                        android:layout_height="@dimen/size_22dp"
                        android:text="@string/wl_invoice_content"
                        android:layout_centerVertical="true"
                        style="@style/ConfirmInVoiceHeadStyle"/>
                    <TextView
                        android:gravity="start"
                        android:id="@+id/tv_content_check"
                        android:background="@null"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/wl_invoice_recharge_fee"
                        android:layout_centerVertical="true"
                        android:layout_toEndOf="@+id/tv_content"
                        style="@style/ConfirmInVoiceContentStyle"/>
                    <View
                        android:background="@color/s4"
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_alignParentBottom="true"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/rl_invoice_head_check"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/size_58dp">
                    <TextView
                        android:id="@+id/tv_invoice_head"
                        android:layout_width="@dimen/size_130dp"
                        android:layout_height="@dimen/size_22dp"
                        android:text="@string/wl_invoice_head"
                        android:layout_centerVertical="true"
                        style="@style/ConfirmInVoiceHeadStyle"/>
                    <TextView
                        android:gravity="start"
                        android:id="@+id/tv_invoice_type_check"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/wl_invoice_type_name"
                        android:layout_centerVertical="true"
                        android:layout_toEndOf="@+id/tv_invoice_head"
                        style="@style/ConfirmInVoiceContentStyle"/>
                    <View
                        android:background="@color/s4"
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_alignParentBottom="true"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/rl_company_name_check"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/size_58dp">
                    <TextView
                        android:id="@+id/tv_company"
                        android:layout_width="@dimen/size_130dp"
                        android:layout_height="@dimen/size_22dp"
                        android:text="@string/wl_invoice_company_name"
                        android:layout_centerVertical="true"
                        style="@style/ConfirmInVoiceHeadStyle"/>
                    <TextView
                        android:gravity="start"
                        android:id="@+id/tv_company_name_check"
                        android:paddingTop="@dimen/size_10dp"
                        android:paddingBottom="@dimen/size_10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_toEndOf="@+id/tv_company"
                        style="@style/ConfirmInVoiceContentStyle"/>
                    <View
                        android:background="@color/s4"
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_alignParentBottom="true"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/rl_tax_payer_number_check"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/size_58dp">
                    <TextView
                        android:id="@+id/tv_taxpayer_number"
                        android:layout_width="@dimen/size_130dp"
                        android:layout_height="@dimen/size_22dp"
                        android:text="@string/wl_invoice_taxpayer_number"
                        android:layout_centerVertical="true"
                        style="@style/ConfirmInVoiceHeadStyle"/>
                    <TextView
                        android:gravity="start"
                        android:id="@+id/tv_taxpayer_number_check"
                        android:paddingTop="@dimen/size_10dp"
                        android:paddingBottom="@dimen/size_10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_toEndOf="@+id/tv_taxpayer_number"
                        style="@style/ConfirmInVoiceContentStyle"/>
                    <View
                        android:background="@color/s4"
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_alignParentBottom="true"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/rl_new_email_version_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/size_58dp">
                    <TextView
                        android:id="@+id/tv_receive_email"
                        android:layout_width="@dimen/size_130dp"
                        android:layout_height="@dimen/size_22dp"
                        android:text="@string/wl_invoice_email"
                        android:layout_centerVertical="true"
                        style="@style/ConfirmInVoiceHeadStyle"/>
                    <TextView
                        android:gravity="start"
                        android:id="@+id/tv_receive_email_check"
                        android:paddingTop="@dimen/size_10dp"
                        android:paddingBottom="@dimen/size_10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_toEndOf="@+id/tv_receive_email"
                        style="@style/ConfirmInVoiceContentStyle"/>
                    <View
                        android:background="@color/s4"
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_alignParentBottom="true"/>
                </RelativeLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_paper_version_view"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_18dp"
                android:paddingStart="@dimen/size_18dp"
                android:paddingEnd="@dimen/size_18dp">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size_42dp">
                    <TextView
                        android:textSize="@dimen/size_12sp"
                        android:textColor="@color/s2"
                        android:layout_width="@dimen/size_130dp"
                        android:layout_height="wrap_content"
                        android:text="@string/wl_invoice_receive_style"
                        android:layout_centerVertical="true"/>
                    <View
                        android:background="@color/s4"
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_alignParentBottom="true"/>
                </RelativeLayout>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/size_58dp">
                    <TextView
                        android:id="@+id/tv_receive_name"
                        android:layout_width="@dimen/size_130dp"
                        android:layout_height="@dimen/size_22dp"
                        android:text="@string/wl_invoice_name"
                        android:layout_centerVertical="true"
                        style="@style/ConfirmInVoiceHeadStyle"/>
                    <TextView
                        android:gravity="start"
                        android:id="@+id/tv_receive_name_check"
                        android:paddingTop="@dimen/size_10dp"
                        android:paddingBottom="@dimen/size_10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_toEndOf="@+id/tv_receive_name"
                        style="@style/ConfirmInVoiceContentStyle"/>
                    <View
                        android:background="@color/s4"
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_alignParentBottom="true"/>
                </RelativeLayout>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/size_58dp">
                    <TextView
                        android:id="@+id/tv_receive_number"
                        android:layout_width="@dimen/size_130dp"
                        android:layout_height="@dimen/size_22dp"
                        android:text="@string/wl_invoice_phone"
                        android:layout_centerVertical="true"
                        style="@style/ConfirmInVoiceHeadStyle"/>
                    <TextView
                        android:gravity="start"
                        android:id="@+id/tv_receive_number_check"
                        android:paddingTop="@dimen/size_10dp"
                        android:paddingBottom="@dimen/size_10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_toEndOf="@+id/tv_receive_number"
                        style="@style/ConfirmInVoiceContentStyle"/>
                    <View
                        android:background="@color/s4"
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_alignParentBottom="true"/>
                </RelativeLayout>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/size_58dp">
                    <TextView
                        android:id="@+id/tv_receive_address"
                        android:layout_width="@dimen/size_130dp"
                        android:layout_height="@dimen/size_22dp"
                        android:text="@string/wl_invoice_address"
                        android:layout_centerVertical="true"
                        style="@style/ConfirmInVoiceHeadStyle"/>
                    <TextView
                        android:gravity="start"
                        android:id="@+id/tv_receive_address_check"
                        android:paddingTop="@dimen/size_10dp"
                        android:paddingBottom="@dimen/size_10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_toEndOf="@+id/tv_receive_address"
                        style="@style/ConfirmInVoiceContentStyle"/>
                    <View
                        android:background="@color/s4"
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_alignParentBottom="true"/>
                </RelativeLayout>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/size_12sp"
                android:textColor="@color/s2"
                android:id="@+id/tv_invoice_tip"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_36dp"
                android:layout_marginTop="@dimen/size_6dp"
                android:text="@string/wl_invoice_message_tip"
                android:layout_marginStart="@dimen/size_18dp"
                android:layout_marginEnd="@dimen/size_18dp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
