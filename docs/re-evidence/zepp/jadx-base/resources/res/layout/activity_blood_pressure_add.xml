<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/container_titlebar"
        layout="@layout/titlebar_blood_pressure"/>
    <androidx.core.widget.NestedScrollView xmlns:app="http://schemas.android.com/apk/res-auto"
        android:background="@color/blood_pressure_s10"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/data_edit"
                android:background="@drawable/card_corner_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_20"
                android:maxHeight="260dp"
                android:layout_marginStart="@dimen/size_10"
                android:layout_marginEnd="@dimen/size_10"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/date_item"
                    android:background="@android:color/transparent"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size_64"
                    android:paddingStart="@dimen/size_16"
                    android:paddingEnd="@dimen/size_16"
                    app:layout_constraintTop_toTopOf="parent">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/date_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/blood_pressure_date"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/date"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/body3s1"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:gravity="end"
                        android:id="@+id/date"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:drawableEnd="@drawable/ic_arrow_forward_20_2x"
                        android:textAlignment="viewEnd"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/date_text"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/num7s1"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/time_item"
                    android:background="@android:color/transparent"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size_64"
                    android:paddingStart="@dimen/size_16"
                    android:paddingEnd="@dimen/size_16"
                    app:layout_constraintTop_toBottomOf="@+id/date_item">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/time_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/blood_pressure_time"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/time"
                        app:layout_constraintHorizontal_weight="2"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/body3s1"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:gravity="end"
                        android:id="@+id/time"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:drawableEnd="@drawable/ic_arrow_forward_20_2x"
                        android:textAlignment="viewEnd"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_weight="1"
                        app:layout_constraintStart_toEndOf="@+id/time_text"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/num7s1"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/data_item"
                    android:background="@android:color/transparent"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size_64"
                    android:paddingStart="@dimen/size_16"
                    android:paddingEnd="@dimen/size_16"
                    app:layout_constraintTop_toBottomOf="@+id/time_item">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/data_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/blood_pressure_sbp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/editText"
                        app:layout_constraintHorizontal_weight="2"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/body3s1"/>
                    <EditText
                        android:textColorHint="@color/blood_pressure_s2"
                        android:gravity="end"
                        android:id="@+id/editText"
                        android:background="@null"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:hint="@string/blood_pressure_unit"
                        android:inputType="numberDecimal"
                        android:textCursorDrawable="@drawable/cursor_edit_box"
                        android:drawableEnd="@drawable/ic_arrow_forward_20_2x"
                        android:textAlignment="viewEnd"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_weight="1"
                        app:layout_constraintStart_toEndOf="@+id/data_text"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/num7s1"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/extra_data_item"
                    android:background="@android:color/transparent"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size_64"
                    android:paddingStart="@dimen/size_16"
                    android:paddingEnd="@dimen/size_16"
                    app:layout_constraintTop_toBottomOf="@+id/data_item">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/extra_data_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/blood_pressure_dbp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/extra_editText"
                        app:layout_constraintHorizontal_weight="2"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/body3s1"/>
                    <EditText
                        android:textColorHint="@color/blood_pressure_s2"
                        android:gravity="end"
                        android:id="@+id/extra_editText"
                        android:background="@null"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:hint="@string/blood_pressure_unit"
                        android:inputType="numberDecimal"
                        android:textCursorDrawable="@drawable/cursor_edit_box"
                        android:drawableEnd="@drawable/ic_arrow_forward_20_2x"
                        android:textAlignment="viewEnd"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_weight="1"
                        app:layout_constraintStart_toEndOf="@+id/extra_data_text"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/num7s1"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <Button
                android:enabled="false"
                android:gravity="center"
                android:id="@+id/save"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_48"
                android:layout_marginTop="@dimen/size_20"
                android:text="@string/blood_pressure_save"
                android:textAlignment="center"
                android:layout_marginStart="@dimen/size_11"
                android:layout_marginEnd="@dimen/size_11"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/data_edit"
                style="@style/Rainbow.Widget.Button.44"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
