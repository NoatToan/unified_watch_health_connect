<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/head"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/value_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:paddingStart="@dimen/size_10dp"
            android:paddingEnd="@dimen/size_10dp"
            android:layout_marginStart="5dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="40sp"
                android:textColor="#000000"
                android:id="@+id/value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/value_invalid"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="14sp"
                android:textColor="#99000000"
                android:id="@+id/unit"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/unit_temp"
                android:layout_marginStart="5dp"
                app:layout_constraintBaseline_toBaselineOf="@+id/value"
                app:layout_constraintStart_toEndOf="@+id/value"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="@dimen/size_12sp"
                android:textColor="#666666"
                android:id="@+id/time"
                android:paddingBottom="@dimen/size_4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_10dp"
                android:textDirection="locale"
                app:layout_constraintStart_toStartOf="@+id/value"
                app:layout_constraintTop_toBottomOf="@+id/value"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <FrameLayout
            android:id="@+id/chart_container"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="@dimen/size_2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/value_container"/>
        <View
            android:id="@+id/divider_line"
            android:background="#f2f2f2"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="@dimen/size_2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/chart_container"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="14sp"
            android:textColor="#666666"
            android:id="@+id/normal_logo"
            android:padding="@dimen/size_15dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/temperature_standard"
            android:drawablePadding="5dp"
            android:drawableStart="@drawable/shape_circle_spo2_normal"
            android:textDirection="locale"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/divider_line"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="14sp"
            android:textColor="#666666"
            android:padding="@dimen/size_15dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/temperature_fever"
            android:drawablePadding="5dp"
            android:drawableStart="@drawable/shape_circle_spo2_abnormal"
            android:textDirection="locale"
            app:layout_constraintStart_toEndOf="@+id/normal_logo"
            app:layout_constraintTop_toBottomOf="@+id/divider_line"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/statistics_container"
        android:background="@drawable/shape_rect_corner_white"
        android:paddingTop="@dimen/size_18dp"
        android:paddingBottom="@dimen/size_28dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/size_15dp"
        android:paddingStart="@dimen/size_15dp"
        android:paddingEnd="@dimen/size_15dp"
        app:layout_constraintTop_toBottomOf="@+id/head">
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#e6000000"
            android:id="@+id/statistics_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textDirection="locale"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/divider_1"
            android:layout_marginTop="@dimen/size_15dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/statistics_title"
            style="@style/VerticalDivider"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="14sp"
            android:textColor="#e6000000"
            android:id="@+id/max_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="21dp"
            android:text="@string/temperature_max"
            android:textDirection="locale"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/divider_1"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#e6000000"
            android:id="@+id/statistics_max"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="21dp"
            android:textDirection="locale"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/divider_1"/>
        <View
            android:id="@+id/divider_2"
            android:layout_marginTop="@dimen/size_15dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/max_title"
            style="@style/VerticalDivider"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="14sp"
            android:textColor="#e6000000"
            android:id="@+id/min_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="21dp"
            android:text="@string/temperature_min"
            android:textDirection="locale"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/divider_2"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#e6000000"
            android:id="@+id/statistics_min"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="21dp"
            android:textDirection="locale"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/divider_2"/>
        <View
            android:id="@+id/divider_3"
            android:layout_marginTop="@dimen/size_15dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/min_title"
            style="@style/VerticalDivider"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="14sp"
            android:textColor="#e6000000"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="21dp"
            android:text="@string/temperature_avg"
            android:textDirection="locale"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/divider_3"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#e6000000"
            android:id="@+id/statistics_avg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="21dp"
            android:textDirection="locale"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/divider_3"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
