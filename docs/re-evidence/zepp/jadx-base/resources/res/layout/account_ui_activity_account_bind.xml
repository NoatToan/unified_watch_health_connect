<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.lib.rainbow.ListTile
        android:id="@+id/account_bind_phone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:ltv_divider_padding="all"
        app:ltv_leading="@drawable/account_ui_account_bind_phone"
        app:ltv_title="@string/account_ui_login_phone"
        app:ltv_trailing="@drawable/ic_arrow_forward_20_2x"/>
    <com.huami.lib.rainbow.ListTile
        android:id="@+id/account_bind_facebook"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:ltv_divider_padding="all"
        app:ltv_leading="@drawable/account_ui_account_bind_facebook"
        app:ltv_title="@string/account_ui_account_bind_facebook"
        app:ltv_trailing="@drawable/ic_arrow_forward_20_2x"/>
    <com.huami.lib.rainbow.ListTile
        android:id="@+id/account_bind_google"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:ltv_divider_padding="all"
        app:ltv_leading="@drawable/account_ui_account_bind_google"
        app:ltv_title="@string/account_ui_account_bind_google"
        app:ltv_trailing="@drawable/ic_arrow_forward_20_2x"/>
    <com.huami.lib.rainbow.ListTile
        android:id="@+id/account_bind_mi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:ltv_divider_padding="all"
        app:ltv_leading="@drawable/account_ui_account_bind_mi"
        app:ltv_title="@string/account_ui_account_bind_mi"
        app:ltv_trailing="@drawable/ic_arrow_forward_20_2x"/>
    <com.huami.lib.rainbow.ListTile
        android:id="@+id/account_bind_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:ltv_divider_padding="all"
        app:ltv_leading="@drawable/account_ui_account_bind_line"
        app:ltv_title="@string/account_ui_account_bind_line"
        app:ltv_trailing="@drawable/ic_arrow_forward_20_2x"/>
    <com.huami.lib.rainbow.ListTile
        android:id="@+id/account_bind_wechat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:ltv_divider_padding="all"
        app:ltv_leading="@drawable/account_ui_account_bind_wechat"
        app:ltv_title="@string/account_ui_account_bind_wechat"
        app:ltv_trailing="@drawable/ic_arrow_forward_20_2x"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.google.android.flexbox.FlexboxLayout
            android:layout_gravity="bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="44dp"
            android:layout_marginStart="@dimen/account_ui_login_margin_side"
            android:layout_marginEnd="@dimen/account_ui_login_margin_side"
            app:flexDirection="row"
            app:flexWrap="wrap"
            app:justifyContent="center">
            <TextView
                android:textSize="@dimen/account_ui_size_14sp"
                android:textColor="@color/s2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/account_ui_account_destroy_account_tip"/>
            <TextView
                android:textSize="@dimen/account_ui_size_14sp"
                android:textColor="@color/s41"
                android:id="@+id/tv_destroy_account"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/account_ui_account_destroy_account"/>
        </com.google.android.flexbox.FlexboxLayout>
    </FrameLayout>
</LinearLayout>
