<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fl_container"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="20sp"
            android:textColor="@color/s1"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_98dp"
            android:text="@string/bind_headset_bind_paired"
            android:layout_centerHorizontal="true"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14sp"
            android:textColor="@color/s1"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_9dp"
            android:text="@string/bind_headset_bind_paired_tips"
            android:layout_centerHorizontal="true"
            android:layout_marginStart="@dimen/size_40dp"
            android:layout_marginEnd="@dimen/size_40dp"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/device_container"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/size_26dp"
            android:layout_marginBottom="@dimen/size_26dp"
            android:layout_weight="1"
            android:overScrollMode="never"
            android:layout_marginStart="@dimen/size_16dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_48dp"
            android:layout_marginBottom="@dimen/size_20dp"
            android:layout_marginStart="@dimen/size_20dp"
            android:layout_marginEnd="@dimen/size_20dp">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/s1"
                android:gravity="center"
                android:id="@+id/tv_cancel"
                android:background="@drawable/bg_bind_device_cancel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/not_bind_now"
                android:layout_weight="1"/>
            <Space
                android:layout_width="@dimen/size_21dp"
                android:layout_height="0dp"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/s1"
                android:gravity="center"
                android:id="@+id/tv_search_bind"
                android:background="@drawable/bg_bind_device_cancel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/bind_headset_search_bind"
                android:layout_weight="1"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>
</FrameLayout>
