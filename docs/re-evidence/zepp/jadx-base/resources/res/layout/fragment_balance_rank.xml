<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:weight="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/s38"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="14sp"
        android:id="@+id/tx_score_level"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="23dp"
        android:text="@string/one_foot_score_level"
        style="@style/oneFootDetailLevelTitleStyle"/>
    <com.huami.view.weightfigure.WeightFigureView
        android:layout_gravity="center"
        android:id="@+id/balance_figure_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="31dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        weight:type="unmoveable"/>
</LinearLayout>
