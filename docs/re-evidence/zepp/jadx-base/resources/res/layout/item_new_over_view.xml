<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="19sp"
        android:textColor="@color/s1"
        android:gravity="center_horizontal"
        android:id="@+id/over_view_item_content"
        android:paddingTop="11dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="din-med"/>
    <TextView
        android:textColor="@color/s2"
        android:gravity="center_horizontal"
        android:id="@+id/over_view_item_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        style="@style/Rainbow.TextAppearance.Body5"/>
</LinearLayout>
