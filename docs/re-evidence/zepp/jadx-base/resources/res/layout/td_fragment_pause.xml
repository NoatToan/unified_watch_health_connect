<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:c="http://schemas.android.com/apk/res-auto"
    android:background="@color/s44"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/td_unsave_btn"
        android:background="@drawable/td_pause_unsave_btn_bg"
        android:layout_width="157dp"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:layout_marginStart="10dp">
        <ImageView
            android:id="@+id/unsave_icon"
            android:background="@drawable/td_pause_unsave_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:layout_marginStart="10dp"
            android:layout_alignParentStart="true"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="15sp"
            android:textColor="@color/s2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/td_pause_unsave_tips"
            android:layout_toRightOf="@+id/unsave_icon"
            android:fontFamily="lt"
            android:layout_marginStart="4dp"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/td_pause"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageButton
            android:id="@+id/td_pause_continue_btn"
            android:background="@drawable/td_pause_continue_btn_bg"
            android:layout_width="@dimen/td_size_154dp"
            android:layout_height="@dimen/td_size_154dp"/>
        <com.huami.treadmill.ui.component.CustomRoundProgressBar
            android:id="@+id/td_pause_finish_btn"
            android:background="@drawable/td_pause_finish_btn_bg"
            android:layout_width="@dimen/td_size_154dp"
            android:layout_height="@dimen/td_size_154dp"
            android:layout_toRightOf="@+id/td_pause_continue_btn"
            android:layout_marginStart="68dp"
            c:RoundProgressBarProgressBgColor="#4cffffff"
            c:RoundProgressBarProgressBgWidth="2dp"
            c:RoundProgressBarProgressColor="@color/s5"
            c:RoundProgressBarProgressWidth="2dp"
            c:RoundProgressBarTotal="1000"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="10.7sp"
            android:textColor="@color/s5"
            android:id="@+id/continue_tx"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="200dp"
            android:text="@string/td_pause_continue_tips"
            android:fontFamily="lt"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="10.7sp"
            android:textColor="@color/s5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="200dp"
            android:text="@string/td_pause_finish_tips"
            android:layout_toRightOf="@+id/continue_tx"
            android:fontFamily="lt"
            android:layout_marginStart="185dp"/>
    </RelativeLayout>
</FrameLayout>
