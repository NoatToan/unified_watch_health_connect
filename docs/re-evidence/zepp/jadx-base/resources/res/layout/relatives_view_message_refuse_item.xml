<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="@dimen/relatives_size_124dp">
    <FrameLayout
        android:background="@color/s36"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/relatives_size_15dp">
        <ImageView
            android:id="@+id/icon"
            android:layout_width="@dimen/relatives_size_44dp"
            android:layout_height="@dimen/relatives_size_44dp"
            android:layout_marginTop="@dimen/relatives_size_20dp"
            android:layout_marginBottom="@dimen/relatives_size_60dp"
            android:layout_marginStart="@dimen/relatives_size_16dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/relatives_size_19dp"
            android:layout_marginStart="@dimen/relatives_size_68dp">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/s1"
                android:id="@+id/username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/relatives_data_zero"
                android:lineSpacingExtra="-1sp"
                android:layout_marginEnd="@dimen/relatives_size_2dp"/>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/relatives_size_6dp">
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/s2"
                    android:id="@+id/notice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="3sp"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/s2"
                    android:id="@+id/notice_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="3sp"
                    android:layout_marginStart="@dimen/relatives_size_10dp"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
