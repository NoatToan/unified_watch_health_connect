<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/size_18sp"
        android:textColor="@color/s1"
        android:id="@+id/tv_search_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="55dp"
        android:text="@string/bind_searching_nearby_watch"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/size_14sp"
        android:textColor="@color/s2"
        android:id="@+id/tv_search_sub_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="@string/bind_watch_search_tip"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_search_title"/>
    <com.huami.watch.companion.ui.view.ScanView
        android:id="@+id/loadingView"
        android:background="@drawable/img_scan_bg"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_marginTop="113dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_search_sub_title"
        app:scanSweep="@drawable/img_scan"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="@dimen/size_15dp"
        android:layout_marginTop="@dimen/dp_40"
        android:layout_marginRight="@dimen/size_15dp"
        android:layout_marginBottom="@dimen/dp_40"
        app:layout_constraintBottom_toTopOf="@+id/tv_put_aside"
        app:layout_constraintTop_toBottomOf="@+id/tv_search_sub_title">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvNearbyDevice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <Button
        android:id="@+id/tv_put_aside"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/size_15dp"
        android:layout_marginRight="@dimen/size_15dp"
        android:layout_marginBottom="@dimen/size_29dp"
        android:text="@string/bind_later"
        app:layout_constraintBottom_toBottomOf="parent"
        style="?attr/buttonStyleGray_48_flat"/>
</androidx.constraintlayout.widget.ConstraintLayout>
