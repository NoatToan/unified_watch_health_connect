<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/s3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="9dp"
            android:text="@string/sleep_edit"
            android:layout_marginStart="@dimen/slp_item_padding"/>
        <View
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="@dimen/slp_divider"
            android:layout_marginStart="@dimen/slp_item_padding"
            android:layout_marginEnd="@dimen/slp_item_padding"/>
        <com.huami.android.design.dialog.choice.ChoiceView
            android:id="@+id/select"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="14.7sp"
            android:textColor="@color/s3"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/time_tip"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="13.3dp"/>
    </LinearLayout>
</FrameLayout>
