<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s10"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/layout_toolbar"/>
    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/dnd_container"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>
    <FrameLayout
        android:id="@+id/dnd_container"
        android:background="@color/s10"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/container">
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            app:cardBackgroundColor="@color/s38"
            app:cardCornerRadius="6dp"
            app:cardElevation="0dp"
            app:layout_constraintTop_toBottomOf="@+id/toolbar">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/dnd_mode_iv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ltv_title="@string/ds_dnd_start_auto"
                    app:ltv_trailing="@drawable/ic_arrow_forward_20_2x"/>
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/dnd_start_time_iv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ltv_title="@string/ds_dnd_start_time"
                    app:ltv_trailing="@drawable/ic_arrow_forward_20_2x"/>
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/dnd_stop_time_iv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ltv_title="@string/ds_dnd_end_time"
                    app:ltv_trailing="@drawable/ic_arrow_forward_20_2x"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <View
            android:id="@+id/mask_view"
            android:background="@color/cl_4d000000"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
