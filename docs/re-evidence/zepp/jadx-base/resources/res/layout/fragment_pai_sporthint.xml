<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rl_paisport"
    android:background="@drawable/bg_white_round_rect"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="15dp"
    android:layout_marginStart="15dp"
    android:layout_marginEnd="15dp">
    <com.huami.widget.typeface.TypefaceTextView
        android:textColor="@color/s1"
        android:gravity="start|center_vertical"
        android:id="@+id/pai_hint_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/pai_guide_feat_produce_title_modify"
        android:lines="1"
        android:layout_marginStart="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Rainbow.TextAppearance.Title3"/>
    <com.huami.pai.view.PaiSectionPartView
        android:id="@+id/pai_hint_progress"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pai_hint_title"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/pai_hint_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="19dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pai_hint_progress"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/pai_hint_get_contain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pai_hint_hint">
        <TextView
            android:textColor="@color/s1"
            android:gravity="start|center_vertical"
            android:id="@+id/pai_hint_get_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Rainbow.TextAppearance.Body4"/>
        <com.huami.pai.view.PaiWrapContentHeightViewPager
            android:id="@+id/pai_hint_viewpager"
            android:background="@drawable/bg_pai_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:overScrollMode="never"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/pai_hint_get_title"/>
        <com.huami.pai.view.PaiViewPagerIndicator
            android:id="@+id/pai_hint_vp_indicator"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            app:layout_constraintBottom_toBottomOf="@+id/pai_hint_viewpager"
            app:layout_constraintEnd_toEndOf="@+id/pai_hint_viewpager"
            app:layout_constraintStart_toStartOf="@+id/pai_hint_viewpager"
            app:ppi_default_color="@color/s4"
            app:ppi_distance="20dp"
            app:ppi_distanceType="BY_DISTANCE"
            app:ppi_height="4dp"
            app:ppi_indicatorType="LINE"
            app:ppi_length="14dp"
            app:ppi_radius="2dp"
            app:ppi_radius_selected="3dp"
            app:ppi_selected_color="@color/p3"
            app:ppi_unselected_length="6dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
