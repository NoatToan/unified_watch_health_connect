<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.huami.utils.easypermission.MaxHeightScrollView
        android:id="@+id/scroll_view"
        android:paddingTop="30dp"
        android:paddingBottom="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:maxHeight="360dp">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/s1"
            android:id="@+id/tv_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"/>
    </com.huami.utils.easypermission.MaxHeightScrollView>
    <RelativeLayout
        android:background="@drawable/easypermission_permission_center_shape_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/scroll_view">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/s2"
            android:gravity="center"
            android:id="@+id/btn_text_link"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/easypermission_permission_detail"
            android:layout_toStartOf="@+id/view_button_divider"
            android:layout_alignParentStart="true"/>
        <View
            android:id="@+id/view_button_divider"
            android:background="@color/s4"
            android:layout_width="0.5dp"
            android:layout_height="24dp"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="15dp"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/s1"
            android:gravity="center"
            android:id="@+id/btn_positive"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/easypermission_permission_dialog_know"
            android:layout_toEndOf="@+id/view_button_divider"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</RelativeLayout>
