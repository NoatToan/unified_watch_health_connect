<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:constraint="http://schemas.android.com/apk/res-auto"
    android:background="@color/pale_grey"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tr_training_filter_bar_height">
        <com.xiaomi.hm.health.training.ui.widget.CustomSpinnerTab
            android:id="@+id/difficulty_button"
            android:background="?attr/trainingClickableItemBackground"
            android:layout_width="0dp"
            android:layout_height="@dimen/tr_training_filter_bar_height"
            android:layout_weight="1"
            constraint:drawablePadding="@dimen/tr_training_filter_text_icon_padding"
            constraint:icon="@drawable/tr_ic_dropdown"
            constraint:normalIconColor="@color/black20"
            constraint:selectedIconColor="@color/pumpkin_orange"
            constraint:text="@string/not_limit_difficulity"
            constraint:textAppearance="@style/TextAppearance.MiFit.Caption.Inverse3"/>
        <View
            android:layout_gravity="center"
            android:layout_height="@dimen/tr_training_filter_divider_height"
            style="@style/VerticalLine"/>
        <com.xiaomi.hm.health.training.ui.widget.CustomSpinnerTab
            android:id="@+id/body_part_button"
            android:background="?attr/trainingClickableItemBackground"
            android:layout_width="0dp"
            android:layout_height="@dimen/tr_training_filter_bar_height"
            android:layout_weight="1"
            constraint:drawablePadding="@dimen/tr_training_filter_text_icon_padding"
            constraint:icon="@drawable/tr_ic_dropdown"
            constraint:normalIconColor="@color/black20"
            constraint:selectedIconColor="@color/pumpkin_orange"
            constraint:text="@string/not_limit_body_part"
            constraint:textAppearance="@style/TextAppearance.MiFit.Caption.Inverse3"/>
        <View
            android:layout_gravity="center"
            android:layout_height="@dimen/tr_training_filter_divider_height"
            style="@style/VerticalLine"/>
        <com.xiaomi.hm.health.training.ui.widget.CustomSpinnerTab
            android:id="@+id/instrument_button"
            android:background="?attr/trainingClickableItemBackground"
            android:layout_width="0dp"
            android:layout_height="@dimen/tr_training_filter_bar_height"
            android:layout_weight="1"
            constraint:drawablePadding="@dimen/tr_training_filter_text_icon_padding"
            constraint:icon="@drawable/tr_ic_dropdown"
            constraint:normalIconColor="@color/black20"
            constraint:selectedIconColor="@color/pumpkin_orange"
            constraint:text="@string/not_limit_instrument"
            constraint:textAppearance="@style/TextAppearance.MiFit.Caption.Inverse3"/>
    </LinearLayout>
    <View style="@style/VerticalLine"/>
    <com.xiaomi.hm.health.training.ui.widget.CustomSmartRefreshLayout
        android:id="@+id/refresh_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/tr_training_filter_bar_height"
        constraint:layout_constraintTop_toTopOf="parent">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/training_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.xiaomi.hm.health.training.ui.widget.CustomSmartRefreshLayout>
    <View
        android:id="@+id/mask_layer"
        android:background="@color/black_60"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/tr_training_filter_bar_height"
        android:alpha="0"/>
    <FrameLayout
        android:id="@+id/options_list_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/tr_training_filter_bar_height"
        android:scaleY="0"
        constraint:layout_constraintTop_toTopOf="parent">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/options_list"
            android:background="#f5f5f5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
