<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/homepage_bk_tool_sleep_assistant"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="?attr/textAppearanceBody3"
        android:textColor="@color/s5"
        android:gravity="center_vertical"
        android:id="@+id/tool_sleep_assistant"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/homepage_size_15dp"
        android:text="@string/homepage_play_music_sleep"
        android:drawablePadding="10dp"
        android:layout_marginStart="@dimen/homepage_size_15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="?attr/textAppearanceBody3"
        android:textColor="@color/s5"
        android:id="@+id/tool_sleep_assistant_prompt"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/homepage_play_tool_sleep_assistant_prompt"
        android:layout_marginStart="@dimen/homepage_size_15dp"
        app:layout_constraintBottom_toBottomOf="@+id/tool_sleep_assistant_play"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tool_sleep_assistant_play"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="?attr/textAppearanceBody3"
        android:textColor="@color/s5"
        android:ellipsize="end"
        android:id="@+id/tool_sleep_assistant_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:maxLines="1"
        android:layout_marginStart="@dimen/homepage_size_15dp"
        android:layout_marginEnd="@dimen/homepage_size_15dp"
        app:layout_constraintEnd_toStartOf="@+id/tool_sleep_assistant_play"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tool_sleep_assistant"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="?attr/textAppearanceBody4"
        android:textColor="@color/s4"
        android:id="@+id/tool_sleep_assistant_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="@dimen/homepage_size_15dp"
        android:layout_marginStart="@dimen/homepage_size_15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tool_sleep_assistant_title"/>
    <com.huami.module.homepage.cards.view.ScheduleView
        android:id="@+id/tool_sleep_assistant_anim"
        android:layout_width="20dp"
        android:layout_height="8dp"
        android:layout_marginStart="8dp"
        app:Sls_bar_color="#80ffffff"
        app:Sls_bar_num="3"
        app:Sls_bar_space="4"
        app:layout_constraintBottom_toBottomOf="@+id/tool_sleep_assistant_status"
        app:layout_constraintStart_toEndOf="@+id/tool_sleep_assistant_status"
        app:layout_constraintTop_toTopOf="@+id/tool_sleep_assistant_status"/>
    <Button
        android:textAppearance="?attr/textAppearanceBody3"
        android:textColor="@color/s5"
        android:gravity="center"
        android:id="@+id/tool_sleep_assistant_play"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:layout_marginEnd="@dimen/homepage_size_15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tool_sleep_assistant"
        style="?attr/buttonStyleGray_38_flat_circular"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/tool_sleep_assistant_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/tool_sleep_assistant_play"
        app:layout_constraintEnd_toEndOf="@+id/tool_sleep_assistant_play"
        app:layout_constraintStart_toStartOf="@+id/tool_sleep_assistant_play"
        app:layout_constraintTop_toTopOf="@+id/tool_sleep_assistant_play"/>
</androidx.constraintlayout.widget.ConstraintLayout>
