<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/pai_pop_bg_round_daily_max"
    android:layout_width="260dp"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/pai_pop_close"
        android:padding="10.3dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:src="@drawable/pai_close_black"
        android:contentDescription="@string/app_name"
        android:layout_marginEnd="5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="16sp"
        android:textColor="#333333"
        android:id="@+id/pai_pop_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="33.7dp"
        android:text="@string/pai_v2_pop_title"
        android:fontFamily="lt"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="12sp"
        android:textColor="#333333"
        android:id="@+id/pai_pop_title_sub"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/pai_v2_pop_msg"
        android:fontFamily="lt"
        android:layout_marginStart="26.5dp"
        android:layout_marginEnd="26.5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pai_pop_title"/>
    <ImageView
        android:id="@+id/pai_pop_circle_img"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20.2dp"
        android:layout_marginBottom="30dp"
        android:src="@drawable/pai_science"
        android:contentDescription="@string/app_name"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pai_pop_title_sub"/>
</androidx.constraintlayout.widget.ConstraintLayout>
