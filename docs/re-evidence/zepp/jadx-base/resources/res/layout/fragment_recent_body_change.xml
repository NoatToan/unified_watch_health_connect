<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/layout_root_view"
    android:background="@color/s38"
    android:layout_width="match_parent"
    android:layout_height="250dp">
    <View
        android:background="@color/s36"
        android:layout_width="match_parent"
        android:layout_height="8dp"/>
    <TextView
        android:id="@+id/title_body_change"
        android:text="@string/bf3_weight_change_mon"
        style="@style/recentChangeFragmentTitleStyle"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="75dp"
            android:layout_weight="1">
            <com.huami.lib.view.text.UnitTextView
                android:layout_gravity="center_horizontal"
                android:id="@+id/body_change_last_uv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                style="@style/weightChangeLastStyle"/>
            <com.huami.lib.view.text.TextViewDrawable
                android:layout_gravity="center_horizontal"
                android:id="@+id/body_change_last_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="4dp"
                android:drawableStart="@drawable/icon_arrow_down"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                app:isAliganCenter="false"
                style="@style/weightChangeLastDateStyle"/>
        </LinearLayout>
        <View
            android:layout_gravity="center"
            android:background="@color/s4"
            android:layout_width="@dimen/divider_slp_info"
            android:layout_height="36dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="75dp"
            android:layout_weight="1">
            <com.huami.lib.view.text.UnitTextView
                android:layout_gravity="center_horizontal"
                android:id="@+id/body_change_mon_uv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                style="@style/weightChangeLastStyle"/>
            <com.huami.lib.view.text.TextViewDrawable
                android:layout_gravity="center_horizontal"
                android:id="@+id/body_change_mon_nav_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bf3_mon_pre_title"
                android:drawablePadding="4dp"
                android:drawableStart="@drawable/icon_arrow_down"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                app:isAliganCenter="false"
                style="@style/weightChangeLastDateStyle"/>
        </LinearLayout>
    </LinearLayout>
    <RelativeLayout
        android:gravity="center"
        android:id="@+id/body_change_chart_container"
        android:layout_width="match_parent"
        android:layout_height="54.2dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp">
        <View
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider_slp_info"
            android:layout_alignParentTop="true"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="11sp"
            android:textColor="@color/s2"
            android:id="@+id/body_chart_start_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_alignParentTop="true"
            android:fontFamily="km"
            android:layout_alignParentStart="true"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="11sp"
            android:textColor="@color/s2"
            android:id="@+id/body_chart_end_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_alignParentTop="true"
            android:fontFamily="km"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</LinearLayout>
