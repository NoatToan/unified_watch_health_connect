<?xml version="1.0" encoding="utf-8"?>
<com.xiaomi.hm.health.training.ui.widget.StickHeaderLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/layout_image_header"/>
    <com.xiaomi.hm.health.training.ui.widget.StickHeaderChildScrollView
        android:id="@+id/nsv_bottom"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="top"
                android:orientation="horizontal"
                android:id="@+id/ll_coach_info"
                android:background="@color/s36"
                android:padding="14dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/imv_coach_header"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:scaleType="centerCrop"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp">
                    <TextView
                        android:textSize="15sp"
                        android:textColor="@color/s2"
                        android:id="@+id/tx_coach_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <com.xiaomi.hm.health.training.ui.widget.ReadMoreTextView
                        android:textSize="12sp"
                        android:textColor="@color/s1"
                        android:id="@+id/tx_coach_introduce"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:colorClickableText="@color/more_blue"
                        app:showTrimExpandedText="true"
                        app:trimCollapsedText="@string/read_more"
                        app:trimExpandedText="@string/read_less"
                        app:trimLines="1"/>
                </LinearLayout>
            </LinearLayout>
            <include
                android:id="@+id/divider_coach"
                layout="@layout/view_space"/>
            <com.xiaomi.hm.health.training.ui.widget.ReadMoreTextView
                android:textSize="14sp"
                android:textColor="@color/s1"
                android:id="@+id/tx_introduction"
                android:background="@color/s36"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                app:colorClickableText="@color/more_blue"
                app:showTrimExpandedText="true"
                app:trimCollapsedText="@string/read_more"
                app:trimExpandedText="@string/read_less"
                app:trimLines="2"/>
            <View style="@style/VerticalDivider"/>
            <View
                android:id="@+id/action_list_top_divider"
                android:visibility="gone"
                android:layout_marginTop="8dp"
                style="@style/VerticalDivider"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_training_list"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <View
                android:id="@+id/action_list_bottom_divider"
                android:visibility="gone"
                style="@style/VerticalDivider"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/s1"
                android:gravity="center_vertical"
                android:background="@color/s36"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/they_also_training_this"
                android:drawableEnd="@drawable/ic_arrow_right"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rcv_joined_tranner"
                android:background="@color/s36"
                android:paddingBottom="8dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"/>
        </LinearLayout>
    </com.xiaomi.hm.health.training.ui.widget.StickHeaderChildScrollView>
    <RelativeLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/rl_bottom"
        android:background="@color/orange100"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_below="@+id/progress_layout_name"
        android:layout_alignStart="@+id/progress_layout_name">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/white100"
            android:gravity="center"
            android:id="@+id/tx_join"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="@string/join_training"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_download_progress"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RelativeLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp">
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/white"
                    android:id="@+id/tx_downloading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/downloading"/>
                <com.huami.widget.typeface.TypefaceTextView
                    android:textSize="15sp"
                    android:textColor="@color/white"
                    android:id="@+id/tx_download_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_toEndOf="@+id/tx_downloading"/>
                <ProgressBar
                    android:layout_gravity="center_vertical"
                    android:id="@+id/cpv_download_progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:layout_below="@+id/tx_downloading"
                    style="@style/WhiteHorizontalProgressBarStyle"/>
            </RelativeLayout>
            <View
                android:background="@color/white40"
                android:layout_width="@dimen/divider"
                android:layout_height="32dp"
                android:layout_marginStart="18dp"/>
            <ImageView
                android:id="@+id/imv_close_download"
                android:layout_width="54dp"
                android:layout_height="match_parent"
                android:src="@drawable/ic_close_white"
                android:scaleType="centerInside"/>
        </LinearLayout>
    </RelativeLayout>
</com.xiaomi.hm.health.training.ui.widget.StickHeaderLayout>
