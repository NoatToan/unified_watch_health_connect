<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/size_18dp"
    android:paddingEnd="@dimen/size_18dp">
    <TextView
        android:textSize="@dimen/size_12sp"
        android:textColor="@color/s2"
        android:id="@+id/tv_card_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_15dp"
        android:text="@string/access_card_name"/>
    <EditText
        android:textColor="@color/s1"
        android:textColorHint="@color/s3"
        android:id="@+id/et_card_name"
        android:background="@color/s4"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="20dp"
        android:text="@string/access_card_family_name"
        android:layout_below="@+id/tv_card_name"
        android:inputType="text"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_tags"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_33dp"
        android:layout_marginTop="@dimen/size_15dp"
        android:layout_below="@+id/et_card_name">
        <TextView
            android:textSize="@dimen/size_15sp"
            android:textColor="@color/s1"
            android:gravity="center"
            android:id="@+id/tv_family"
            android:background="@color/s4"
            android:layout_width="@dimen/size_96dp"
            android:layout_height="@dimen/size_33dp"
            android:text="@string/access_card_family_name"/>
        <View
            android:id="@+id/view1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <TextView
            android:textSize="@dimen/size_15sp"
            android:textColor="@color/s1"
            android:gravity="center"
            android:id="@+id/tv_company"
            android:background="@color/s4"
            android:layout_width="@dimen/size_96dp"
            android:layout_height="@dimen/size_33dp"
            android:text="@string/access_card_company_name"
            android:layout_marginStart="@dimen/size_18dp"/>
        <View
            android:id="@+id/view2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <TextView
            android:textSize="@dimen/size_15sp"
            android:textColor="@color/s1"
            android:gravity="center"
            android:id="@+id/tv_school"
            android:background="@color/s4"
            android:layout_width="@dimen/size_96dp"
            android:layout_height="@dimen/size_33dp"
            android:text="@string/access_card_school_name"
            android:layout_marginStart="@dimen/size_18dp"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/iv_success"
        android:layout_width="@dimen/size_84dp"
        android:layout_height="@dimen/size_84dp"
        android:layout_marginTop="@dimen/size_58dp"
        android:src="@drawable/ic_access_success"
        android:layout_below="@+id/ll_tags"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="@dimen/size_18sp"
        android:textColor="@color/s1"
        android:id="@+id/tv_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_8dp"
        android:text="@string/access_card_simulation_success"
        android:layout_below="@+id/iv_success"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="@dimen/size_14sp"
        android:textColor="@color/s2"
        android:id="@+id/tv_white_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_10dp"
        android:text="@string/access_door_white_message"
        android:layout_below="@+id/tv_tip"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="@dimen/size_14sp"
        android:textColor="@color/s3"
        android:id="@+id/tv_emulation_tip"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="31dp"
        android:text="@string/access_door_open_success_tip"
        android:layout_below="@+id/tv_white_message"
        android:layout_centerHorizontal="true"
        android:lineSpacingMultiplier="1.2"/>
    <Button
        android:id="@+id/tv_finish"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size_24dp"
        android:text="@string/access_card_finish"
        android:layout_alignParentBottom="true"
        app:layout_constraintBottom_toBottomOf="parent"
        style="@style/Rainbow.Widget.Button.38.Circular"/>
</RelativeLayout>
