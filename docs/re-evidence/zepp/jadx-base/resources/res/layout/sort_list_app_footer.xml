<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/invisible_item_divider"
        android:background="@color/black20"
        android:layout_width="match_parent"
        android:layout_height="0.33dp"/>
    <RelativeLayout
        android:id="@+id/invisible_item_area"
        android:layout_width="match_parent"
        android:layout_height="150dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/invisible_item_img"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="50dp"
            android:src="@drawable/img_invisible"
            android:tint="@color/s2"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textColor="@color/s3"
            android:id="@+id/footer_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="70dp"
            android:layout_below="@+id/invisible_item_img"
            android:layout_centerHorizontal="true"
            style="@style/Rainbow.TextAppearance.Body5"/>
    </RelativeLayout>
    <View
        android:id="@+id/invisible_item_space_area"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_36dp"/>
</LinearLayout>
