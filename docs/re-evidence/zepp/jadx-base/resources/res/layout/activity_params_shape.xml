<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/contain_layout"
    android:background="@color/s36"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/up_layout"
        android:layout_width="match_parent"
        android:layout_height="292dp">
        <RelativeLayout
            android:id="@+id/no_shape_ll"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true">
                <com.huami.widget.typeface.TypefaceTextView
                    android:textSize="20.7sp"
                    android:textColor="@color/s3"
                    android:id="@+id/cannot_analyze_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cannot_analyze"
                    android:layout_centerHorizontal="true"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/s3"
                    android:gravity="center"
                    android:id="@+id/reason_tv"
                    android:paddingTop="9.7dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/cannot_analyze_tv"
                    android:layout_centerHorizontal="true"/>
            </RelativeLayout>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/has_shape_ll"
            android:background="@color/s36"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true">
                <ImageView
                    android:id="@+id/shape_iv"
                    android:layout_width="48dp"
                    android:layout_height="76dp"
                    android:layout_centerHorizontal="true"/>
                <TextView
                    android:textSize="20sp"
                    android:textColor="@color/s1"
                    android:gravity="center"
                    android:id="@+id/shape_type_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_below="@+id/shape_iv"
                    android:layout_centerHorizontal="true"/>
            </RelativeLayout>
        </RelativeLayout>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/shape_rl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="42dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="18dp">
        <RelativeLayout
            android:background="@drawable/body_shape_hor_line_color"
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:layout_alignBottom="@+id/left_line_rl"
            android:layout_marginStart="7dp"
            android:layout_marginEnd="18dp">
            <ImageView
                android:background="@drawable/shape_higher_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/s2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:text="@string/muscle_rate"
            android:layout_alignBottom="@+id/left_line_rl"
            android:layout_centerHorizontal="true"/>
        <RelativeLayout
            android:id="@+id/left_line_rl"
            android:background="@drawable/body_shape_hor_line_color"
            android:layout_width="18dp"
            android:layout_height="240dp">
            <ImageView
                android:background="@drawable/shape_higher_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"/>
            <ImageView
                android:background="@drawable/shape_lower_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/s2"
            android:gravity="center"
            android:id="@+id/en_radio_tv"
            android:visibility="gone"
            android:layout_width="190dp"
            android:layout_height="wrap_content"
            android:text="@string/body_fat_rate"
            android:layout_alignBottom="@+id/left_line_rl"
            android:layout_marginStart="1dp"
            android:layout_marginEnd="17dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/s2"
            android:id="@+id/zh_radio_tv"
            android:visibility="visible"
            android:layout_width="11.3dp"
            android:layout_height="wrap_content"
            android:text="@string/body_fat_rate"
            android:layout_centerVertical="true"
            android:layout_marginStart="3dp"
            android:layout_alignParentStart="true"/>
        <GridView
            android:id="@+id/gridview"
            android:scrollbars="none"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:listSelector="@null"
            android:numColumns="3"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="36dp"
            android:layout_toEndOf="@+id/left_line_rl"/>
    </RelativeLayout>
</RelativeLayout>
