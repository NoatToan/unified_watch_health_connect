<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/ll_calendar_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="12sp"
        android:textColor="@color/s2"
        android:gravity="center"
        android:id="@+id/tx_month"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/calender_month_size"/>
    <RelativeLayout
        android:orientation="vertical"
        android:layout_width="@dimen/calender_item_size"
        android:layout_height="@dimen/calender_item_size">
        <CheckBox
            android:textSize="15sp"
            android:textColor="@color/s1"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/cbx_date"
            android:clickable="false"
            android:layout_width="@dimen/calender_day_size"
            android:layout_height="@dimen/calender_day_size"
            android:button="@null"
            android:layout_centerHorizontal="true"/>
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/imv_point"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="4dp"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</LinearLayout>
