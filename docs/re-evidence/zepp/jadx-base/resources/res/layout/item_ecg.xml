<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/s36"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp">
        <com.huami.watch.companion.ecg.view.MidongEcgGridView
            android:orientation="vertical"
            android:id="@+id/ev_ecg_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:mGridShow="true"
            app:mGridX="65"
            app:mGridY="30"
            app:mLineColor="@color/s1"/>
        <TextView
            android:gravity="center"
            android:id="@+id/tv_afib"
            android:padding="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="3.4sp"
            android:layout_marginStart="8dp"
            style="@style/Rainbow.TextAppearance.Number8"/>
        <TextView
            android:textColor="@color/s36"
            android:gravity="center"
            android:id="@+id/tv_is_self"
            android:background="@drawable/bg_measure_self"
            android:padding="4dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:layout_alignBottom="@+id/ev_ecg_item"
            android:layout_marginEnd="8dp"
            android:layout_alignParentEnd="true"
            style="@style/Rainbow.TextAppearance.Number8"/>
        <TextView
            android:textColor="@color/s2"
            android:id="@+id/tv_measure_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="1.4sp"
            android:layout_marginEnd="8dp"
            android:layout_alignParentEnd="true"
            style="@style/Rainbow.TextAppearance.Number8"/>
    </RelativeLayout>
    <RelativeLayout
        android:paddingTop="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">
        <TextView
            android:textColor="@color/s2"
            android:id="@+id/hr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_toStartOf="@+id/center_split"
            android:layout_alignParentStart="true"
            style="@style/Rainbow.TextAppearance.Number7"/>
        <View
            android:id="@+id/center_split"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:layout_centerInParent="true"/>
        <RelativeLayout
            android:id="@+id/hrv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:layout_toEndOf="@+id/center_split"
            android:layout_alignParentEnd="true">
            <TextView
                android:textColor="@color/s2"
                android:id="@+id/hrv_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@+id/hrv_faq"
                style="@style/Rainbow.TextAppearance.Number7"/>
            <ImageView
                android:id="@+id/hrv_faq"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_problem"
                android:layout_centerVertical="true"
                android:layout_marginStart="10dp"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp">
        <ImageView
            android:id="@+id/measure_voice"
            android:background="@drawable/bg_voice"
            android:padding="4dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_voice_3"
            android:layout_marginEnd="6dp"/>
        <TextView
            android:textColor="#8d8d8d"
            android:id="@+id/measure_status_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ecg_measure_no_status"
            android:lineSpacingExtra="-0.6sp"
            android:layout_marginEnd="8dp"
            style="@style/Rainbow.TextAppearance.Number7"/>
        <TextView
            android:textColor="#8d8d8d"
            android:ellipsize="end"
            android:id="@+id/measure_status"
            android:padding="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxEms="8"
            android:singleLine="true"
            android:lineSpacingExtra="-0.6sp"
            style="@style/Rainbow.TextAppearance.Number7"/>
    </LinearLayout>
    <View
        android:background="@color/s4"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
</LinearLayout>
