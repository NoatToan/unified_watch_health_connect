<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:id="@+id/fl_camera"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:background="#0000"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"
        android:layout_alignParentRight="true"
        layout="@layout/layout_watermark_tag"/>
    <RelativeLayout
        android:id="@+id/rl_drag_line_area"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:gravity="center"
            android:id="@+id/rl_drag_line"
            android:padding="@dimen/watermark_line_thumbnail_padding_r"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.xiaomi.hm.health.watermarkcamera.ui.widget.CustomWatermarkView
                android:id="@+id/custom_markview"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </RelativeLayout>
    </RelativeLayout>
</RelativeLayout>
