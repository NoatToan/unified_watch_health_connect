<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/s10"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.huami.lib.rainbow.titlebar.RainbowTitleBar
            android:id="@+id/titleBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:navigationIcon="@drawable/ic_arrow_back_20_2x"
            app:title="@string/ds_wearing_method"/>
        <FrameLayout
            android:id="@+id/container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="vertical"
                    android:background="@drawable/shape_corners_device_setting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_15dp"
                    android:layout_marginStart="@dimen/size_15dp"
                    android:layout_marginEnd="@dimen/size_15dp">
                    <com.huami.lib.rainbow.ListTile
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:ltv_title="@string/ds_wear_mode"
                        app:ltv_trailing="@drawable/transparent_shape"/>
                    <RadioGroup
                        android:orientation="vertical"
                        android:id="@+id/ds_wearing_method_hand"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="@dimen/size_16dp"
                        android:paddingEnd="@dimen/size_16dp"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="vertical"
                    android:background="@drawable/shape_corners_device_setting"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_14dp"
                    android:layout_marginStart="@dimen/size_15dp"
                    android:layout_marginEnd="@dimen/size_15dp">
                    <com.huami.lib.rainbow.ListTile
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:ltv_title="@string/ds_wear_key_position"
                        app:ltv_trailing="@drawable/transparent_shape"/>
                    <RadioGroup
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="@dimen/size_16dp"
                        android:paddingEnd="@dimen/size_16dp">
                        <RadioButton
                            android:textSize="@dimen/size_15sp"
                            android:textColor="@color/s1"
                            android:gravity="center_vertical"
                            android:layout_width="match_parent"
                            android:layout_height="43.5dp"
                            android:checked="true"
                            android:button="@null"
                            android:text="@string/ds_wear_key_position_left"
                            android:drawablePadding="@dimen/size_15dp"
                            android:drawableStart="@drawable/sound_strength_selector"/>
                        <RadioButton
                            android:textSize="@dimen/size_15sp"
                            android:textColor="@color/s1"
                            android:gravity="center_vertical"
                            android:layout_width="match_parent"
                            android:layout_height="43.5dp"
                            android:button="@null"
                            android:text="@string/ds_wear_key_position_right"
                            android:drawablePadding="@dimen/size_15dp"
                            android:drawableStart="@drawable/sound_strength_selector"/>
                    </RadioGroup>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="vertical"
                    android:id="@+id/wear_direction_container"
                    android:background="@drawable/shape_corners_device_setting"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_14dp"
                    android:layout_marginStart="@dimen/size_15dp"
                    android:layout_marginEnd="@dimen/size_15dp">
                    <com.huami.lib.rainbow.ListTile
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:ltv_title="@string/ds_wear_direction"
                        app:ltv_trailing="@drawable/transparent_shape"/>
                    <RadioGroup
                        android:orientation="vertical"
                        android:id="@+id/wear_direction_radio_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="@dimen/size_16dp"
                        android:paddingEnd="@dimen/size_16dp"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
            </LinearLayout>
            <View
                android:id="@+id/mask_view"
                android:background="@color/s38"
                android:focusable="true"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.85"/>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
