<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.lib.rainbow.titlebar.RainbowTitleBar
        android:id="@+id/tv_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationIcon="@drawable/ic_arrow_back_20_2x"/>
    <FrameLayout
        android:id="@+id/status_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tv_title_bar"/>
    <com.huami.lib.rainbow.ListTile
        android:id="@+id/repeat_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/status_content"
        app:ltv_title="@string/alarm_clock_repeat"/>
    <com.huami.lib.rainbow.ListTile
        android:id="@+id/lazy_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/repeat_item"
        app:ltv_checked="true"
        app:ltv_subtitle="@string/earbud_alarm_lazy_summary"
        app:ltv_title="@string/alarm_clock_lazy_title"/>
    <LinearLayout
        android:id="@+id/alarm_time"
        android:background="@color/s38"
        android:layout_width="match_parent"
        android:layout_height="@dimen/alarm_wheel_hight"
        android:layout_alignParentBottom="true">
        <com.huami.widget.wheelview.WheelView
            android:id="@+id/ampm_wheel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <View
            android:background="@color/s4"
            android:layout_width="@dimen/round_bg_stroke"
            android:layout_height="match_parent"/>
        <com.huami.widget.wheelview.WheelView
            android:id="@+id/hour_wheel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <View
            android:background="@color/s4"
            android:layout_width="@dimen/round_bg_stroke"
            android:layout_height="match_parent"/>
        <com.huami.widget.wheelview.WheelView
            android:id="@+id/min_wheel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
    </LinearLayout>
    <TextView
        android:textSize="11.3sp"
        android:textColor="@color/s2"
        android:gravity="top|center_horizontal"
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/alarm_delay_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="13.3dp"
        android:layout_marginBottom="10dp"
        android:layout_above="@+id/alarm_time"
        android:layout_centerHorizontal="true"/>
    <View
        android:id="@+id/mask_view"
        android:background="@color/change_sport_goal_mask"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/status_content"/>
</RelativeLayout>
