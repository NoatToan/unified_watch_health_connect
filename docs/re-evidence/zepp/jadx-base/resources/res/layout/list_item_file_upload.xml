<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:paddingEnd="15dp">
    <ImageView
        android:id="@+id/file_item_img"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="15dp"/>
    <View
        android:id="@+id/file_item_text_check"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="12dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_weight="1"
        android:layout_marginStart="12dp">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/s1"
            android:ellipsize="middle"
            android:id="@+id/file_item_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/s2"
            android:id="@+id/file_item_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lines="1"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/file_item_arrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_arrow_forward_20_2x"
        app:tint="@color/s3"/>
</LinearLayout>
