<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/common_item_padding"
            android:paddingEnd="@dimen/common_item_padding">
            <TextView
                android:textColor="@color/s1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_20dp"
                android:text="@string/wl_return_card_input_tips_name"
                style="@style/TextAppearance.MiFit.Title3.Inverse"/>
            <EditText
                android:textAppearance="@style/TextAppearance.MiFit.Title.Inverse"
                android:textColor="@color/s1"
                android:textColorHint="@color/s3"
                android:id="@+id/wl_return_card_input_name"
                android:background="@color/s36"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="20dp"
                android:hint="@string/wl_return_card_input_et_hint"
                android:inputType="text"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"/>
            <TextView
                android:textColor="@color/s1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_20dp"
                android:text="@string/wl_return_card_input_tips_alipay"
                style="@style/TextAppearance.MiFit.Title3.Inverse"/>
            <EditText
                android:textAppearance="@style/TextAppearance.MiFit.Title.Inverse"
                android:textColor="@color/s1"
                android:textColorHint="@color/s3"
                android:id="@+id/wl_return_card_input_alipay"
                android:background="@color/s36"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="20dp"
                android:hint="@string/wl_return_card_input_et_hint"
                android:inputType="text"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"/>
            <TextView
                android:textColor="@color/s1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_20dp"
                android:text="@string/wl_return_card_input_tips_mobile"
                style="@style/TextAppearance.MiFit.Title3.Inverse"/>
            <EditText
                android:textAppearance="@style/TextAppearance.MiFit.Title.Inverse"
                android:textColor="@color/s1"
                android:textColorHint="@color/s3"
                android:id="@+id/wl_return_card_input_mobile"
                android:background="@color/s36"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="20dp"
                android:hint="@string/wl_return_card_input_et_hint"
                android:inputType="text"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"/>
            <TextView
                android:textColor="@color/s1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_18dp"
                android:text="@string/wl_return_card_alipay_auth_notice_title"
                style="@style/TextAppearance.MiFit.Title3.Inverse"/>
            <TextView
                android:textColor="@color/s2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_18dp"
                android:text="@string/wl_return_card_user_auth_notice_content"
                style="@style/TextAppearance.MiFit.Title.Inverse"/>
        </LinearLayout>
    </ScrollView>
    <Button
        android:enabled="true"
        android:gravity="center"
        android:id="@+id/wl_return_card_input_sure_button"
        android:focusable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/wl_border_margin"
        android:layout_marginBottom="@dimen/wl_border_margin"
        android:text="@string/wl_return_card_notice_confirm"
        android:layout_marginStart="@dimen/wl_border_margin"
        android:layout_marginEnd="@dimen/wl_border_margin"
        style="@style/Rainbow.Widget.Button.44.Circular"/>
</LinearLayout>
