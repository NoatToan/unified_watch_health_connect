<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="20dp"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_img"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:src="@drawable/tr_ic_all_courses"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="10.7sp"
        android:textColor="@color/tr_white"
        android:gravity="center"
        android:id="@+id/tv_lable"
        android:background="@drawable/tr_shape_corner_label_v2"
        android:padding="2dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="lt"
        app:layout_constraintEnd_toEndOf="@+id/iv_img"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="@dimen/tr_font_size_title"
        android:textColor="@color/s1"
        android:id="@+id/tv_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:fontFamily="lt-bold"
        android:layout_marginStart="15dp"
        app:layout_constraintStart_toEndOf="@+id/iv_img"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TrainingTextSingleLineStyle"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="@dimen/tr_font_size_subtitle"
        android:textColor="@color/s2"
        android:id="@+id/tv_rank_and_coursecount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:fontFamily="lt"
        android:layout_marginStart="15dp"
        app:layout_constraintStart_toEndOf="@+id/iv_img"
        app:layout_constraintTop_toBottomOf="@+id/tv_name"
        style="@style/TrainingTextSingleLineStyle"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="@dimen/tr_font_size_subtitle"
        android:textColor="@color/s2"
        android:id="@+id/tv_cal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:fontFamily="lt"
        android:layout_marginStart="15dp"
        app:layout_constraintStart_toEndOf="@+id/tv_rank_and_coursecount"
        app:layout_constraintTop_toBottomOf="@+id/tv_name"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="@dimen/tr_font_size_subtitle"
        android:textColor="@color/s2"
        android:id="@+id/tv_study_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:fontFamily="lt"
        android:layout_marginStart="15dp"
        app:layout_constraintStart_toEndOf="@+id/iv_img"
        app:layout_constraintTop_toBottomOf="@+id/tv_rank_and_coursecount"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="12sp"
        android:textColor="@color/s5"
        android:id="@+id/tv_join_course"
        android:background="@drawable/tr_shape_corner_orange_bg_v2"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="@string/tr_join_course"
        android:fontFamily="lt"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:layout_marginStart="15dp"
        app:layout_constraintStart_toEndOf="@+id/iv_img"
        app:layout_constraintTop_toBottomOf="@+id/tv_study_number"
        style="@style/TrainingTextSingleLineStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
