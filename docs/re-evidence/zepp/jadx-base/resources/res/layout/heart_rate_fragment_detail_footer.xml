<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.cardview.widget.CardView
        android:id="@+id/statisticsCard"
        android:paddingLeft="15dp"
        android:paddingRight="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        app:cardBackgroundColor="@color/s38"
        app:cardCornerRadius="6dp"
        app:cardElevation="0dp"
        app:contentPaddingBottom="20dp"
        app:contentPaddingLeft="@dimen/heart_rate_size_15dp"
        app:contentPaddingRight="@dimen/heart_rate_size_15dp"
        app:contentPaddingTop="12dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.huami.heartrate.ui.StatisticsView
            android:id="@+id/statisticsView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </androidx.cardview.widget.CardView>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/measureResultLayout"
        android:paddingLeft="@dimen/heart_rate_size_15dp"
        android:paddingTop="@dimen/heart_rate_size_21dp"
        android:paddingRight="@dimen/heart_rate_size_15dp"
        android:paddingBottom="@dimen/heart_rate_size_21dp"
        android:layout_marginLeft="@dimen/heart_rate_size_15dp"
        android:layout_marginRight="@dimen/heart_rate_size_15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/statisticsCard"
        style="@style/HeartRateDetailContainerStyle">
        <com.huami.widget.typeface.TypefaceTextView
            android:textColor="@color/s1"
            android:gravity="start"
            android:id="@+id/tvMeasureResultInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/heart_rate_manual_measure_value"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Rainbow.TextAppearance.Body3"/>
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_arrow_forward_20"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/s2"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/heartRateExplainLayout"
        android:padding="@dimen/heart_rate_size_15dp"
        android:layout_marginLeft="@dimen/heart_rate_size_15dp"
        android:layout_marginRight="@dimen/heart_rate_size_15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/measureResultLayout"
        style="@style/HeartRateDetailContainerStyle">
        <com.huami.widget.typeface.TypefaceTextView
            android:textColor="@color/s1"
            android:id="@+id/tvHeartRateExplainTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/heart_rate_name"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Rainbow.TextAppearance.Title2"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/s2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/heart_rate_card_intro_heart_rate_info"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvHeartRateExplainTitle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
