<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:src="@drawable/td_line_running_rank_me_bg"/>
    <ImageView
        android:layout_gravity="start"
        android:id="@+id/td_line_runing_rank_avatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="26dp"/>
    <ImageView
        android:layout_gravity="start"
        android:background="@drawable/td_avatar_ring_marker_me"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="26dp"/>
    <LinearLayout
        android:layout_gravity="end"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:layout_marginEnd="10dp">
        <TextView
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/s5"
            android:gravity="center"
            android:id="@+id/td_line_runing_rank_distance"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/s5"
            android:id="@+id/td_line_runing_rank_distance_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="km"
            android:layout_marginStart="5dp"/>
    </LinearLayout>
</FrameLayout>
