<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.watch.companion.ui.view.ActionbarLayout
        android:id="@+id/actionbar"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <FrameLayout
                    android:layout_gravity="bottom"
                    android:id="@+id/watch_face_area"
                    android:layout_width="wrap_content"
                    android:layout_height="140dp"
                    android:layout_marginBottom="4dp"
                    android:layout_marginStart="28dp"
                    android:layout_marginEnd="20dp">
                    <ImageView
                        android:id="@+id/device_watch_bg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/device_watch_bg"
                        android:scaleType="fitStart"
                        android:adjustViewBounds="true"/>
                    <ImageView
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/watch_face"
                        android:layout_width="79dp"
                        android:layout_height="79dp"
                        android:layout_marginTop="40dp"/>
                    <ImageView
                        android:layout_gravity="center_horizontal"
                        android:layout_width="79dp"
                        android:layout_height="79dp"
                        android:layout_marginTop="40dp"
                        android:src="@drawable/device_watch_highlight_main"/>
                    <ImageView
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/watch_face_transparent"
                        android:visibility="gone"
                        android:layout_width="79dp"
                        android:layout_height="79dp"
                        android:layout_marginTop="40dp"/>
                </FrameLayout>
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#e6000000"
                    android:id="@+id/connect_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="@string/connect_status_disconnect"
                    android:layout_toEndOf="@+id/watch_face_area"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#80000000"
                    android:id="@+id/version_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:text=""
                    android:layout_below="@+id/connect_state"
                    android:layout_toEndOf="@+id/watch_face_area"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#80000000"
                    android:id="@+id/storage_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_below="@+id/version_info"
                    android:layout_toEndOf="@+id/watch_face_area"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#80000000"
                    android:gravity="center_vertical"
                    android:id="@+id/find_watch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="@string/xihu_find_my_watch"
                    android:onClick="findMyWatch"
                    android:drawableEnd="@drawable/ic_list_item_right_arrow_selector"
                    android:layout_toEndOf="@+id/watch_face_area"/>
            </RelativeLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <include layout="@layout/view_battery_info"/>
                    <com.huami.watch.companion.ui.view.SettingItemView
                        android:onClick="toWatchFaceManager"
                        app:icon="@drawable/ic_setting_item_device_watchface"
                        app:title="@string/xihu_watch_face_manager"
                        style="@style/SettingItemStyle"/>
                    <com.huami.watch.companion.ui.view.SettingItemView
                        android:id="@+id/setting_watchface"
                        app:icon="@drawable/ic_setting_item_device_watchface"
                        app:title="@string/choose_watch_face"
                        style="@style/SettingItemStyle"/>
                </LinearLayout>
                <View
                    android:id="@+id/mask_view_top"
                    android:background="#77f7f7f7"
                    android:visibility="gone"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </FrameLayout>
            <TextView
                android:textSize="12sp"
                android:textColor="#80000000"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:text="@string/watch_setting"
                android:layout_marginStart="20dp"/>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.huami.watch.companion.ui.view.SettingItemView
                        android:id="@+id/setting_widget_order"
                        android:visibility="gone"
                        app:icon="@drawable/ic_setting_item_device_widget"
                        app:title="@string/widget_only_title"
                        style="@style/SettingItemStyle"/>
                    <com.huami.watch.companion.ui.view.SettingItemView
                        android:id="@+id/setting_sim"
                        app:icon="@drawable/ic_setting_item_esim"
                        app:title="@string/widget_sim"
                        style="@style/SettingItemStyle"/>
                    <com.huami.watch.companion.ui.view.SettingItemView
                        android:id="@+id/setting_screen_unlock"
                        app:icon="@drawable/ic_setting_item_device_unlock"
                        app:title="@string/unlock_screen"
                        style="@style/SettingItemStyle"/>
                    <com.huami.watch.companion.ui.view.SettingItemView
                        android:onClick="onClickFileManager"
                        app:icon="@drawable/ic_setting_item_file_manager"
                        app:title="@string/file_manager"
                        style="@style/SettingItemStyle"/>
                </LinearLayout>
                <View
                    android:layout_gravity="bottom"
                    android:id="@+id/mask_view_bottom"
                    android:background="#77f7f7f7"
                    android:visibility="gone"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </FrameLayout>
            <com.huami.watch.companion.ui.view.SettingItemView
                android:id="@+id/setting_notification"
                app:title="@string/notification_setting"
                style="@style/SettingItemStyle"/>
            <com.huami.watch.companion.ui.view.SettingItemView
                android:id="@+id/setting_faq"
                android:visibility="gone"
                app:title="@string/help_item_common_problem"
                style="@style/SettingItemStyle"/>
            <com.huami.watch.companion.ui.view.SettingItemView
                android:id="@+id/setting_more"
                android:background="@color/white"
                app:icon="@drawable/ic_setting_item_more"
                app:show_divider="true"
                app:title="@string/xihu_more_settings"
                style="@style/SettingItemStyle"/>
            <FrameLayout
                android:id="@+id/layout_widget_setting"
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.huami.watch.companion.ui.view.SettingItemView
                    android:clickable="false"
                    app:icon="@drawable/ic_setting_item_device_app"
                    app:show_arrow="false"
                    app:show_divider="false"
                    app:title="@string/xihu_widget_setting"
                    style="@style/SettingItemStyle"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#80000000"
                    android:gravity="center_vertical"
                    android:layout_gravity="end"
                    android:id="@+id/tv_edit"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/edit"
                    android:onClick="onClickEdit"
                    android:layout_marginEnd="23.1dp"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/layout_recycle"
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="12sp"
                    android:textColor="#80000000"
                    android:gravity="center"
                    android:id="@+id/tv_load"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:minHeight="200dp"
                    android:text="@string/xihu_load_app_data"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginStart="60dp"
                    android:layout_marginEnd="20dp"/>
            </FrameLayout>
            <View
                android:id="@+id/divider"
                android:background="#14000000"
                android:layout_width="match_parent"
                android:layout_height="0.33dp"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@drawable/clickable_text_color_selector"
                android:gravity="center"
                android:id="@+id/setting_main_device"
                android:background="#ffffffff"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:text="@string/change_main_device"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
