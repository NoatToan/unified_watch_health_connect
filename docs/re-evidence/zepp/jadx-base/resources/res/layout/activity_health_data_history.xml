<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/history_data"
        android:background="@drawable/shape_rect_corner_white"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/size_15dp"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="@dimen/size_14sp"
        android:textColor="@color/s2"
        android:layout_gravity="center"
        android:id="@+id/no_data"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_50dp"
        android:text="@string/health_data_no_data"/>
</LinearLayout>
