<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/account_ui_trans"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/account_ui_dialog_empty_area"/>
    <androidx.cardview.widget.CardView
        android:layout_gravity="bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/s39"
        app:cardCornerRadius="4dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/web_container"
                android:layout_width="match_parent"
                android:layout_height="400dp"/>
            <TextView
                android:textColor="@color/s1"
                android:gravity="center"
                android:id="@+id/tv_countdown"
                android:padding="@dimen/account_ui_size_12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <View
                android:background="@color/s4"
                android:layout_width="match_parent"
                android:layout_height="1px"/>
            <LinearLayout
                android:orientation="horizontal"
                android:background="@color/account_ui_trans"
                android:layout_width="match_parent"
                android:layout_height="@dimen/account_ui_item_height_max">
                <TextView
                    android:textSize="@dimen/account_ui_person_info_setting_text_size"
                    android:textColor="@color/account_ui_select_agreement_continue"
                    android:gravity="center"
                    android:id="@+id/useragreement_btn_cancel"
                    android:background="@drawable/account_ui_btn_click_bg_round_dialog_bottom_left"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/account_ui_exit_app"
                    android:layout_weight="1"/>
                <View
                    android:background="@color/s4"
                    android:layout_width="1px"
                    android:layout_height="match_parent"/>
                <TextView
                    android:enabled="false"
                    android:textSize="@dimen/account_ui_person_info_setting_text_size"
                    android:textColor="@color/account_ui_select_agreement_continue"
                    android:gravity="center"
                    android:id="@+id/useragreement_btn_agree"
                    android:background="@drawable/account_ui_btn_click_bg_round_dialog_bottom_right"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/account_ui_startup_agree_continue"
                    android:layout_weight="1"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
