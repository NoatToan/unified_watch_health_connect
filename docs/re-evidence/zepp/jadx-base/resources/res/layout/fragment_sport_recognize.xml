<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/s10"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/layout_toolbar"/>
    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:background="@color/s10"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            app:cardBackgroundColor="@color/s38"
            app:cardCornerRadius="6dp"
            app:cardElevation="0.5dp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/type_container"
                    android:layout_width="match_parent"
                    android:layout_height="61dp">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/s1"
                        android:id="@+id/type_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ds_sport_recognize_type"
                        android:layout_marginStart="16dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/question_img"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/type_tv"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@drawable/device_setting_descriptio_smart_on"/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="@dimen/d4"
                        android:layout_height="@dimen/d4"
                        android:tint="@color/s2"
                        android:layout_marginEnd="14dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@drawable/ic_arrow_forward_20_2x"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/alert_lt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ltv_checked="true"
                    app:ltv_subtitle="@string/ds_sport_recognize_alert_tips"
                    app:ltv_title="@string/ds_sport_recognize_alert"/>
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/sensitive_lt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ltv_title="@string/ds_sport_recognize_sensitivity"
                    app:ltv_trailing="@drawable/ic_arrow_forward_20_2x"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </FrameLayout>
</LinearLayout>
