<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/sls_bg_dialog_confirm"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="15sp"
        android:textColor="@color/s2"
        android:gravity="center"
        android:id="@+id/dialog_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="50dp"
        android:layout_marginRight="16dp"
        android:text="@string/sls_breathe_training_done_early"
        android:fontFamily="lt"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/divider1"
        android:background="@color/s4"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="39dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dialog_content"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="15sp"
        android:textColor="@color/s2"
        android:gravity="center"
        android:id="@+id/dialog_ok"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:text="@string/sls_breathe_training_continue"
        android:fontFamily="lt"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/divider2"
        app:layout_constraintTop_toTopOf="@+id/dialog_cancel"/>
    <View
        android:id="@+id/divider2"
        android:background="@color/s4"
        android:layout_width="1dp"
        android:layout_height="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/dialog_cancel"
        app:layout_constraintLeft_toRightOf="@+id/dialog_cancel"
        app:layout_constraintRight_toLeftOf="@+id/dialog_ok"
        app:layout_constraintTop_toTopOf="@+id/dialog_cancel"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="15sp"
        android:textColor="@color/s2"
        android:gravity="center"
        android:id="@+id/dialog_cancel"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:text="@string/sls_over_text"
        android:fontFamily="lt"
        app:layout_constraintLeft_toRightOf="@+id/divider2"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider1"/>
</androidx.constraintlayout.widget.ConstraintLayout>
