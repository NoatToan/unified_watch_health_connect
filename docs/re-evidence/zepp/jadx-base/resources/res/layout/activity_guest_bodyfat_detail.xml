<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.xiaomi.hm.health.bodyfat.view.SlidingConflictScrollView
        android:id="@+id/guestBodyFatScroll"
        android:background="@color/s10"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RelativeLayout
                android:id="@+id/body_fat_rl"
                android:background="@drawable/scale_detail_header_bg"
                android:paddingTop="38dp"
                android:paddingBottom="38dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.huami.widget.typeface.TypefaceTextView
                    android:id="@+id/score_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="@string/body_score_desc"
                    android:layout_centerHorizontal="true"
                    style="@style/bodyfatScoreDescStyle"/>
                <com.huami.lib.view.text.UnitTextView
                    android:id="@+id/scoreValueTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/score_desc"
                    android:layout_centerHorizontal="true"
                    style="@style/bodyfatScoreStyle"/>
                <com.huami.widget.typeface.TypefaceTextView
                    android:id="@+id/scoreSubValueTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:layout_below="@+id/scoreValueTv"
                    android:layout_centerHorizontal="true"
                    style="@style/bodyfatWeightStyle"/>
            </RelativeLayout>
            <View
                android:background="@color/s4"
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider_slp_info"/>
            <FrameLayout
                android:id="@+id/hr_pressure_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <FrameLayout
                android:id="@+id/body_index_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </LinearLayout>
    </com.xiaomi.hm.health.bodyfat.view.SlidingConflictScrollView>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/s2"
        android:id="@+id/bodyFatEmptyTv"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="153dp"
        android:drawableTop="@drawable/bf3_baby_error"
        android:drawablePadding="12dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
