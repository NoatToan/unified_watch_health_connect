<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s36"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="20sp"
        android:textColor="@color/s1"
        android:gravity="center"
        android:id="@+id/keep_alive_tips_describe"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="98dp"
        android:text="@string/keep_alive_tips_describe"
        android:layout_centerHorizontal="true"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:layout_marginTop="112dp"
        android:layout_below="@+id/keep_alive_tips_describe">
        <ImageView
            android:id="@+id/keep_alive_tips_dev"
            android:layout_width="120dp"
            android:layout_height="match_parent"
            android:src="@drawable/img_miband"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <ImageView
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:src="@drawable/keep_alive_tips"
            android:translationX="5dp"
            app:layout_constraintEnd_toEndOf="@+id/keep_alive_tips_dev"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/s2"
        android:gravity="center"
        android:id="@+id/keep_alive_tips_cancel"
        android:layout_width="144dp"
        android:layout_height="92dp"
        android:text="@string/got_it"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/s16"
        android:gravity="center"
        android:id="@+id/keep_alive_tips_setting"
        android:layout_width="144dp"
        android:layout_height="92dp"
        android:text="@string/per_go_setting"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
