<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.cardview.widget.CardView
        android:id="@+id/sport_map_card"
        android:layout_width="match_parent"
        android:layout_height="336dp"
        android:foreground="?android:attr/selectableItemBackground"
        app:cardBackgroundColor="@color/s38"
        app:cardCornerRadius="0dp"
        app:cardElevation="0dp"
        app:cardPreventCornerOverlap="false"
        app:cardUseCompatPadding="true"
        app:contentPadding="0dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/sport_map_bg"
            android:background="@drawable/ic_sport_indoor_run_bg"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"/>
        <ImageView
            android:id="@+id/sport_map_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/sport_map_default"
            android:scaleType="centerCrop"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp">
            <ImageView
                android:id="@+id/sport_map_settings"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/btn_sport_prepare_settings"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
            <com.xiaomi.hm.health.ui.sportfitness.view.SportDeviceView
                android:id="@+id/sport_map_device"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"/>
        </RelativeLayout>
        <RadioGroup
            android:gravity="center_horizontal"
            android:layout_gravity="end|bottom"
            android:id="@+id/sport_map_radio"
            android:background="@drawable/round_rectangle_bg"
            android:padding="@dimen/size_15dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:layout_marginEnd="10dp">
            <RadioButton
                android:id="@+id/sport_map_radio_indoor_run_btn"
                android:background="@drawable/sport_switch_indoor_run_bg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:button="@null"/>
            <RadioButton
                android:id="@+id/sport_map_radio_outdoor_run_btn"
                android:background="@drawable/sport_switch_outdoor_run_bg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:checked="true"
                android:button="@null"/>
            <RadioButton
                android:id="@+id/sport_map_radio_treadmill_btn"
                android:background="@drawable/sport_switch_treadmill_bg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:button="@null"/>
        </RadioGroup>
        <ImageView
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/sport_map_start"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginBottom="19.3dp"
            android:src="@drawable/btn_sport_go"
            android:scaleType="centerInside"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/amazfit_treadmill_title"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="10dp">
            <TextView
                android:textSize="23sp"
                android:textColor="@color/s1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/amazfit_airrun"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/s2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/amazfit_treadmill_intro"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>
