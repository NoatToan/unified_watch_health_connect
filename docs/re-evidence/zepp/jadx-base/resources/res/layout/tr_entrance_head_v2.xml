<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s10"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/head_guide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <com.huami.training.ui.widget.KingView
        android:id="@+id/king_zone"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="99dp"
        app:layout_constraintBottom_toBottomOf="@+id/head_guide"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/my_training_zone"
        android:background="@drawable/tr_common_content_card_bg"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/head_guide">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/card_my_training_both_v"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <include
                android:id="@+id/card_training_plan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="20dp"
                layout="@layout/tr_layout_training_plan_v2"/>
            <View
                android:id="@+id/card_my_training_both_divider"
                android:visibility="gone"
                android:layout_marginBottom="20dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                style="@style/TrainingHorizontalDividerV"/>
            <include
                android:id="@+id/joined_course"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:layout_marginBottom="20dp"
                layout="@layout/tr_layout_joined_courses_v2"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/card_training_plan_empty"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/card_joined_courses_separated"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <include layout="@layout/layout_training_plan_empty_v2"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/card_joined_courses_separated"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/card_training_plan_empty">
            <include
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="20dp"
                layout="@layout/tr_layout_joined_courses_v2"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/subject_zone"
        android:background="@color/s10"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        app:layout_constraintTop_toBottomOf="@+id/my_training_zone">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/subject_top"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            app:layout_constraintTop_toTopOf="parent">
            <com.huami.training.ui.widget.RoundImageView
                android:id="@+id/subject_img_top"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                app:bottom_radius="@dimen/tr_card_radius_v"
                app:layout_constraintDimensionRatio="h,320:102"
                app:up_radius="@dimen/tr_card_radius_v"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:id="@+id/subject_title_top"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TrainingCourseSubjectTitleText"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:id="@+id/subject_subtitle_top"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/subject_title_top"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TrainingCourseSubjectSubtitleText"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/subject_left"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="95dp"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="15dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/subject_right"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/subject_top">
            <com.huami.training.ui.widget.RoundImageView
                android:id="@+id/subject_img_left"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                app:bottom_radius="@dimen/tr_card_radius_v"
                app:layout_constraintDimensionRatio="h,156:95"
                app:up_radius="@dimen/tr_card_radius_v"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:id="@+id/subject_title_left"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TrainingCourseSubjectTitleText"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:id="@+id/subject_subtitle_left"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/subject_title_left"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TrainingCourseSubjectSubtitleText"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/subject_right"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="95dp"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="15dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@+id/subject_left"
            app:layout_constraintTop_toBottomOf="@+id/subject_top">
            <com.huami.training.ui.widget.RoundImageView
                android:id="@+id/subject_img_right"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                app:bottom_radius="@dimen/tr_card_radius_v"
                app:layout_constraintDimensionRatio="h,156:95"
                app:up_radius="@dimen/tr_card_radius_v"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:id="@+id/subject_title_right"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TrainingCourseSubjectTitleText"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:id="@+id/subject_subtitle_right"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/subject_title_right"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TrainingCourseSubjectSubtitleText"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/today_zone"
        android:background="@drawable/tr_common_content_card_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        app:layout_constraintTop_toBottomOf="@+id/subject_zone">
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="16sp"
            android:textColor="@color/s1"
            android:id="@+id/tv_today_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/tr_today_training"
            android:fontFamily="lt"
            android:layout_marginStart="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/today_tag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7.7dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_today_title"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcv_today_training"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@+id/today_tag"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="14sp"
            android:textColor="@color/s2"
            android:gravity="center"
            android:id="@+id/today_training_error"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="16dp"
            android:text="@string/tr_search_error_tips"
            android:fontFamily="lt"
            android:layout_marginEnd="10dp"
            app:layout_constraintBottom_toBottomOf="@+id/today_zone"
            app:layout_constraintTop_toBottomOf="@+id/today_tag"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/kankan_header"
        android:background="@color/s10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@+id/today_zone">
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="16sp"
            android:textColor="@color/s1"
            android:id="@+id/kankan_title"
            android:paddingBottom="9.7dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/tr_look_around"
            android:paddingStart="20dp"
            android:paddingEnd="22dp"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
