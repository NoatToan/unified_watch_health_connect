<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:background="#000000"
        android:layout_width="match_parent"
        android:layout_height="46.3dp">
        <ImageView
            android:padding="6dp"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_ocr_back"
            android:scaleType="centerInside"
            android:layout_centerVertical="true"
            android:onClick="onBackClick"
            android:layout_marginStart="11dp"/>
    </RelativeLayout>
    <com.huami.assistant.ocr.camera.CameraView
        android:id="@+id/camera_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:background="#000000"
        android:layout_width="match_parent"
        android:layout_height="122dp">
        <TextView
            android:textSize="12sp"
            android:textColor="#c1c5cb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/take_pic_tip"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/album_button"
                android:padding="18dp"
                android:layout_width="60dp"
                android:layout_height="54dp"
                android:src="@drawable/bd_ocr_gallery"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/camera_left_margin"/>
            <ImageView
                android:id="@+id/take_photo_button"
                android:background="@drawable/bd_ocr_take_photo_selector"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
