<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/s36"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center_horizontal"
        android:layout_width="93.3dp"
        android:layout_height="93.3dp"
        android:layout_marginTop="55dp"
        android:src="@drawable/account_ui_ic_reset_password_by_phone_success"/>
    <TextView
        android:textSize="@dimen/account_ui_size_20sp"
        android:textColor="@color/s1"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="33.7dp"
        android:text="@string/account_ui_account_set_new_pwd_success"/>
    <TextView
        android:textColor="@color/s2"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        android:text="@string/account_ui_account_set_new_pwd_login_tip"/>
    <TextView
        android:textSize="@dimen/account_ui_size_15sp"
        android:textColor="@color/account_ui_select_alive_btn_txt_color"
        android:gravity="center"
        android:id="@+id/reset_success_go_to_login_btn"
        android:background="@drawable/account_ui_btn_bg_login"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="51.3dp"
        android:text="@string/account_ui_account_go_to_login"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"/>
</LinearLayout>
