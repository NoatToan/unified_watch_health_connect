<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:background="@color/s38"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="42.3dp">
        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_arrow_back_20_2x"
            android:scaleType="centerInside"
            android:layout_centerVertical="true"
            android:layout_marginStart="11dp"
            app:tint="?android:attr/textColorPrimary"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/s1"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_centerInParent="true"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_toStartOf="@+id/right_text"
            android:layout_toEndOf="@+id/btn_back"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@drawable/watch_common_text_color_selector"
            android:gravity="center"
            android:id="@+id/right_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/esim_save"
            android:layout_centerVertical="true"
            android:layout_marginEnd="16dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:gravity="center"
        android:id="@+id/esim_info"
        android:background="@color/s38"
        android:layout_width="match_parent"
        android:layout_height="54.7dp">
        <TextView
            android:textSize="14.7sp"
            android:textColor="@color/s1"
            android:ellipsize="end"
            android:id="@+id/esim_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:drawablePadding="6dp"
            android:layout_centerVertical="true"
            android:drawableEnd="@drawable/ic_esim_name_edit"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="80dp"/>
        <com.huami.lib.rainbow.widget.SwitchCompat
            android:layout_gravity="start|center_vertical"
            android:id="@+id/esim_state"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:textOn=""
            android:textOff=""
            android:layout_centerVertical="true"
            android:layout_marginEnd="20dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <com.huami.watch.companion.ui.view.ClearableEditText
        android:textSize="14.7sp"
        android:textColor="@color/s1"
        android:textColorHint="@color/s2"
        android:gravity="center_vertical"
        android:id="@+id/esim_name_edit"
        android:background="@color/s38"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="54.7dp"
        android:inputType="text"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"/>
    <TextView
        android:textSize="13.3sp"
        android:textStyle="bold"
        android:textColor="@drawable/esim_text_color_selector"
        android:gravity="center"
        android:id="@+id/delete"
        android:background="@color/s38"
        android:layout_width="match_parent"
        android:layout_height="54.7dp"
        android:layout_marginTop="10.3dp"
        android:text="@string/esim_delete_account"
        android:lineSpacingExtra="0sp"/>
</LinearLayout>
