<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s38"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/title_rl"
        android:background="@color/s38"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/share_dialog_grid_long_margin_top">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/s1"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/share_long_title"
            android:lines="1"
            android:layout_centerInParent="true"
            android:paddingStart="@dimen/share_dialog_grid_text_margin_vertical"
            android:paddingEnd="@dimen/share_dialog_grid_text_margin_vertical"/>
        <ImageView
            android:id="@+id/close_long_dg"
            android:layout_width="@dimen/share_dialog_grid_icon_size"
            android:layout_height="@dimen/share_dialog_grid_icon_size"
            android:src="@drawable/ic_close_20_s1"
            android:scaleType="centerInside"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/share_dialog_grid_icon_margin_end"
            android:layout_alignParentEnd="true"
            app:tint="@color/s1"/>
    </RelativeLayout>
    <net.lucode.hackware.magicindicator.MagicIndicator
        android:id="@+id/magicindicator"
        android:background="@color/s38"
        android:layout_width="match_parent"
        android:layout_height="43.2dp"
        android:layout_below="@+id/title_rl"/>
    <RelativeLayout
        android:background="@color/s10"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="78.2dp"
        android:layout_below="@+id/magicindicator"
        android:paddingStart="37dp"
        android:paddingEnd="37dp">
        <androidx.viewpager.widget.ViewPager
            android:id="@+id/share_long_viewpage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/share_long_scroll_tips"
        android:background="@drawable/shape_long_dialog_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="78.2dp"
        android:layout_marginBottom="-1dp"
        android:layout_above="@+id/ll_recycler">
        <ImageView
            android:id="@+id/scroll_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/share_down"
            android:layout_centerInParent="true"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/s5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="13.8dp"
            android:text="@string/share_long_scroll_tips"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:id="@+id/ll_recycler"
        android:background="@color/s38"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="78.2dp"
            android:overScrollMode="never"/>
    </LinearLayout>
</RelativeLayout>
