<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.lib.rainbow.titlebar.RainbowTitleBar
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/ds_sound_buzzer_scenes"/>
    <com.huami.lib.rainbow.ListTile
        android:id="@+id/sportSceneItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_12dp"
        android:layout_marginStart="@dimen/size_15dp"
        android:layout_marginEnd="@dimen/size_15dp"
        app:ltv_radius_position="top"
        app:ltv_title="@string/ds_sound_buzzer_scenes_sport"/>
    <com.huami.lib.rainbow.ListTile
        android:id="@+id/otherSceneItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_15dp"
        android:layout_marginEnd="@dimen/size_15dp"
        app:ltv_radius_position="bottom"
        app:ltv_title="@string/ds_sound_buzzer_scenes_others"/>
</LinearLayout>
