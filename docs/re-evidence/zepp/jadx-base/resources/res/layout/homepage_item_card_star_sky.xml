<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="195dp">
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/homepage_lottie_main"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:lottie_autoPlay="true"
        app:lottie_fileName="homepage_star_sky_all.json"
        app:lottie_loop="true"
        app:lottie_speed="0.5"/>
    <TextView
        android:textColor="@color/s5"
        android:id="@+id/homepage_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/homepage_item_card_star_sky"
        android:layout_marginStart="15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Rainbow.TextAppearance.Body3"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/s5"
        android:gravity="center"
        android:id="@+id/homepage_beta"
        android:background="@drawable/homepage_tag_background_stroke"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="15dp"
        android:layout_marginStart="6dp"
        app:layout_constraintBaseline_toBaselineOf="@+id/homepage_title"
        app:layout_constraintStart_toEndOf="@+id/homepage_title"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/s5"
        android:gravity="center"
        android:id="@+id/homepage_free"
        android:background="@drawable/homepage_tag_background_stroke"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="15dp"
        android:layout_marginStart="6dp"
        app:layout_constraintBaseline_toBaselineOf="@+id/homepage_beta"
        app:layout_constraintStart_toEndOf="@+id/homepage_beta"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/homepage_play_bg"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginBottom="16dp"
        android:src="@drawable/ic_play_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/homepage_play_state"
        android:layout_width="30dp"
        android:layout_height="30dp"
        app:layout_constraintBottom_toBottomOf="@+id/homepage_play_bg"
        app:layout_constraintEnd_toEndOf="@+id/homepage_play_bg"
        app:layout_constraintStart_toStartOf="@+id/homepage_play_bg"
        app:layout_constraintTop_toTopOf="@+id/homepage_play_bg"
        app:srcCompat="@drawable/ic_play_30_s5"/>
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/homepage_like"
        android:background="@color/s40"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:scaleType="center"
        app:layout_constraintBottom_toBottomOf="@+id/homepage_play_bg"
        app:layout_constraintEnd_toStartOf="@+id/homepage_play_bg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/homepage_play_bg"
        app:shapeAppearance="@style/ShapeAppearance.App.Circular"
        app:srcCompat="@drawable/ic_like_30_s5"/>
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/homepage_unlike"
        android:background="@color/s40"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:scaleType="center"
        app:layout_constraintBottom_toBottomOf="@+id/homepage_play_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/homepage_play_bg"
        app:layout_constraintTop_toTopOf="@+id/homepage_play_bg"
        app:shapeAppearance="@style/ShapeAppearance.App.Circular"
        app:srcCompat="@drawable/ic_play_next_30_s5"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/homepage_loading"
        android:visibility="gone"
        android:layout_width="30dp"
        android:layout_height="30dp"
        app:layout_constraintBottom_toBottomOf="@+id/homepage_play_state"
        app:layout_constraintEnd_toEndOf="@+id/homepage_play_state"
        app:layout_constraintStart_toStartOf="@+id/homepage_play_state"
        app:layout_constraintTop_toTopOf="@+id/homepage_play_state"
        app:lottie_fileName="homepage_star_sky_loading.json"
        app:lottie_loop="true"/>
</androidx.constraintlayout.widget.ConstraintLayout>
