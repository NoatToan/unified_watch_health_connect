<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:scrollbars="none"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/sls_breathing_training_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/title"
            android:background="#ffffff"
            android:layout_width="match_parent"
            android:layout_height="44dp">
            <ImageView
                android:id="@+id/back"
                android:layout_width="26dp"
                android:layout_height="0dp"
                android:src="@drawable/sls_back"
                android:scaleType="center"
                android:contentDescription="@string/app_name"
                android:layout_marginStart="2dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="27:36"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="17sp"
                android:textColor="@color/sls_333333"
                android:ellipsize="end"
                android:id="@+id/user_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="200dp"
                android:text="@string/sls_breathe_training"
                android:maxLines="1"
                android:fontFamily="lt-bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:layout_marginStart="19dp"
            android:layout_marginEnd="17dp">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:src="@drawable/sls_share_icon_point"
                android:scaleType="center"
                android:contentDescription="@string/app_name"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="13sp"
                android:textColor="@color/sls_back_8d"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sls_breathe_training_label1"
                android:fontFamily="lt"
                android:layout_marginStart="10dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginStart="19dp"
            android:layout_marginEnd="17dp">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:src="@drawable/sls_share_icon_point"
                android:scaleType="center"
                android:contentDescription="@string/app_name"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="13sp"
                android:textColor="@color/sls_back_8d"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sls_breathe_training_label2"
                android:fontFamily="lt"
                android:layout_marginStart="10dp"/>
        </LinearLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@drawable/sls_breathing_training_item1_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="17dp"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp">
            <ImageView
                android:id="@+id/sls_training_img_label1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/app_name"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="15sp"
                android:textColor="@color/sls_333333"
                android:id="@+id/sls_tv_training_card_title1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="21dp"
                android:text="@string/sls_training_card_title1"
                android:fontFamily="lt-bold"
                android:layout_marginStart="96dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="12sp"
                android:textColor="@color/sls_back_8d"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="20dp"
                android:text="@string/sls_training_card_label1"
                android:fontFamily="lt"
                android:layout_marginStart="96dp"
                android:layout_marginEnd="23dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/sls_tv_training_card_title1"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@drawable/sls_breathing_training_item2_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="5dp"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp">
            <ImageView
                android:id="@+id/sls_training_img_label2"
                android:layout_width="wrap_content"
                android:layout_height="115dp"
                android:contentDescription="@string/app_name"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="15sp"
                android:textColor="@color/sls_333333"
                android:id="@+id/sls_tv_training_card_title2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="21dp"
                android:text="@string/sls_training_card_title2"
                android:fontFamily="lt-bold"
                android:layout_marginStart="96dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="12sp"
                android:textColor="@color/sls_back_8d"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/sls_training_card_label2"
                android:fontFamily="lt"
                android:layout_marginStart="96dp"
                android:layout_marginEnd="23dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/sls_tv_training_card_title2"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <Button
            android:textSize="13sp"
            android:textColor="@color/white100"
            android:gravity="center"
            android:id="@+id/sls_btn_start_training"
            android:background="@drawable/sls_select_background"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginLeft="19dp"
            android:layout_marginTop="40dp"
            android:layout_marginRight="19dp"
            android:text="@string/sls_training_start"
            android:fontFamily="lt-bold"/>
    </LinearLayout>
</ScrollView>
