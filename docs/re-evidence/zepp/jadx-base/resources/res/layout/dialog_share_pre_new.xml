<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/shape_rect_white_corner_6"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="15dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/s1"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/run_share_type"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/line_top"
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@+id/title"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_share_option"
            android:paddingTop="20dp"
            android:paddingBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/line_top">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/s1"
                android:gravity="center"
                android:id="@+id/run_share_long_img"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/run_share_type_img"
                android:drawableTop="@drawable/run_share_long_img_zepp"
                android:drawablePadding="4dp"
                android:layout_weight="1"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/s1"
                android:gravity="center"
                android:id="@+id/run_share_long_cam"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/run_share_type_cam"
                android:drawableTop="@drawable/run_share_long_cam_zepp"
                android:drawablePadding="4dp"
                android:layout_weight="1"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/s1"
                android:gravity="center"
                android:id="@+id/run_share_video"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/run_share_type_track"
                android:drawableTop="@drawable/run_share_track_video"
                android:drawablePadding="4dp"
                android:layout_weight="1"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/s1"
                android:gravity="center"
                android:id="@+id/run_share_export"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/run_share_type_gpx"
                android:drawableTop="@drawable/run_share_export_zepp"
                android:drawablePadding="4dp"
                android:layout_weight="1"/>
        </LinearLayout>
        <View
            android:id="@+id/line_bottom"
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            app:layout_constraintTop_toBottomOf="@+id/ll_share_option"/>
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/s1"
            android:gravity="center"
            android:id="@+id/cancel_tv"
            android:paddingTop="15dp"
            android:paddingBottom="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cancel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/line_bottom"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
