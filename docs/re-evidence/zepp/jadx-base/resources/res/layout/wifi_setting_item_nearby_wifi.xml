<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="62dp">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="15sp"
        android:textColor="@color/s1"
        android:ellipsize="end"
        android:id="@+id/tv_wifi_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="100dp"
        android:text="AHHM"
        android:maxLines="1"
        android:layout_centerVertical="true"
        android:layout_marginStart="15dp"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="12sp"
        android:textColor="@color/p3"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_flag_current"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="21dp"
        android:maxWidth="200dp"
        android:text="@string/wifi_current_wifi"
        android:maxLines="1"
        android:layout_centerVertical="true"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:layout_marginStart="8dp"
        android:layout_toEndOf="@+id/tv_wifi_name"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_wifi_lock"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@mipmap/wifi_setting_icon_wifi_lock"
        android:layout_centerVertical="true"
        android:layout_marginEnd="6dp"
        android:layout_toStartOf="@+id/iv_wifi_icon"
        app:tint="@color/s1"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_wifi_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@mipmap/wifi_setting_icon_wifi"
        android:layout_centerVertical="true"
        android:layout_marginEnd="15dp"
        android:layout_alignParentEnd="true"
        app:tint="@color/s1"/>
</RelativeLayout>
