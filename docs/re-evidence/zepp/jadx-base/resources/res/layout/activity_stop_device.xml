<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="20sp"
        android:textColor="@color/s1"
        android:gravity="center"
        android:id="@+id/title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="78dp"
        android:text="@string/stop_device_now"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/s2"
        android:gravity="center"
        android:id="@+id/stop_device_sub_title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:layout_below="@+id/title_tv"
        android:layout_centerHorizontal="true"/>
    <RelativeLayout
        android:id="@+id/work_rl"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_marginTop="82dp"
        android:layout_below="@+id/stop_device_sub_title_tv"
        android:layout_centerHorizontal="true">
        <com.xiaomi.hm.health.device.view.HMLoadingView
            android:id="@+id/loading_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ImageView
            android:id="@+id/device_img"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/img_miband"
            android:scaleType="centerInside"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/bt_disable_rl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="82dp"
        android:layout_below="@+id/stop_device_sub_title_tv">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/img_phone"
            android:layout_centerInParent="true"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/img_bluetooth"
            android:tint="@color/bluetooth_tint_color"
            android:layout_centerInParent="true"/>
        <View
            android:id="@+id/center_view"
            android:background="@color/trans"
            android:layout_width="1px"
            android:layout_height="1px"
            android:layout_centerInParent="true"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:src="@drawable/img_use_success"
            android:layout_marginStart="12dp"
            android:layout_toEndOf="@+id/center_view"/>
    </RelativeLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/start_success_rl"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="168dp"
        android:layout_marginTop="88dp"
        android:layout_below="@+id/stop_device_sub_title_tv"
        android:layout_centerHorizontal="true">
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.5"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/device_success_img"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/img_miband"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/use_success_img"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/img_use_success"
            app:layout_constraintStart_toStartOf="@+id/guideline"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/s2"
        android:gravity="center"
        android:id="@+id/stop_and_use_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="@string/stop_and_use"
        android:layout_below="@+id/work_rl"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:id="@+id/switch_confirm"
        android:visibility="gone"
        android:text="@string/confirm"
        style="@style/BindBottomTextStyle"/>
    <TextView
        android:id="@+id/bt_cancel_tv"
        android:visibility="gone"
        android:text="@string/cancel"
        android:layout_marginStart="37dp"
        style="@style/BindLeftTextStyle"/>
    <TextView
        android:id="@+id/bt_enable_tv"
        android:visibility="gone"
        android:text="@string/open"
        android:layout_marginEnd="37dp"
        style="@style/BindRightTextStyle"/>
    <FrameLayout
        android:id="@+id/choose_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</RelativeLayout>
