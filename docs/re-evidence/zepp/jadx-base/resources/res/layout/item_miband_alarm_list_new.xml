<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@drawable/alarm_item_bg"
    android:paddingBottom="@dimen/size_15dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/size_15dp"
    android:paddingEnd="@dimen/size_15dp">
    <FrameLayout
        android:id="@+id/delete_layout"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/alarm_delete"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_bt_contact_delete"
            app:tint="@color/p4"/>
    </FrameLayout>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="24sp"
        android:textColor="@color/s1"
        android:id="@+id/miband_alarm_time_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="km"
        android:layout_marginStart="@dimen/size_15dp"
        app:layout_constraintStart_toEndOf="@+id/delete_layout"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginStart="0dp"/>
    <TextView
        android:textSize="@dimen/size_14sp"
        android:textColor="@color/s2"
        android:id="@+id/miband_alarm_ampm_text"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_6dp"
        app:layout_constraintBottom_toBottomOf="@+id/miband_alarm_time_text"
        app:layout_constraintStart_toEndOf="@+id/miband_alarm_time_text"
        app:layout_constraintTop_toTopOf="@+id/miband_alarm_time_text"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_7dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/miband_alarm_time_text"
        app:layout_constraintTop_toBottomOf="@+id/miband_alarm_time_text">
        <TextView
            android:textSize="@dimen/size_14sp"
            android:textColor="@color/s2"
            android:gravity="center"
            android:id="@+id/miband_alarm_repeat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/miband_alarm_switch"
        android:focusable="false"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/miband_alarm_time_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/miband_alarm_time_text"
        style="@style/Rainbow.Widget.Switch"/>
</androidx.constraintlayout.widget.ConstraintLayout>
