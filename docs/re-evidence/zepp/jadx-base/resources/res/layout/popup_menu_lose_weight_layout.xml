<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <View
        android:layout_gravity="end"
        android:id="@+id/v_arrow"
        android:layout_width="16dp"
        android:layout_height="10dp"
        android:layout_marginEnd="12dp"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/popup_menu_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:divider="@drawable/popup_menu_divider"
        android:showDividers="middle">
        <TextView
            android:textSize="12dp"
            android:id="@+id/modify_goal"
            android:padding="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/lose_weight_modify_plan"/>
        <TextView
            android:textSize="12dp"
            android:id="@+id/modify_sport_type"
            android:padding="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/lose_weight_modify_sport"/>
        <TextView
            android:textSize="12dp"
            android:id="@+id/modify_sport_time"
            android:padding="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/lose_weight_modify_time"/>
    </LinearLayout>
</LinearLayout>
