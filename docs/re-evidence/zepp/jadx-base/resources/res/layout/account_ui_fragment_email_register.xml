<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/s36"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatEditText
        android:textSize="@dimen/account_ui_hm_email_text_size"
        android:textColor="@color/s1"
        android:textColorHint="@color/s3"
        android:gravity="start|center_vertical"
        android:id="@+id/hm_email_input_email"
        android:background="@drawable/account_ui_bg_login_edit"
        android:layout_width="match_parent"
        android:layout_height="@dimen/account_ui_hm_email_input_height"
        android:layout_marginTop="12dp"
        android:hint="@string/account_ui_input_email"
        android:inputType="textEmailAddress"
        android:paddingStart="@dimen/account_ui_size_15dp"
        android:paddingEnd="@dimen/account_ui_size_15dp"
        android:layout_marginStart="@dimen/account_ui_hm_email_input_margin"
        android:layout_marginEnd="@dimen/account_ui_hm_email_input_margin"/>
    <FrameLayout
        android:id="@+id/hm_email_password"
        android:layout_width="match_parent"
        android:layout_height="@dimen/account_ui_hm_email_input_height"
        android:layout_marginTop="@dimen/account_ui_hm_email_password_margin_top"
        android:layout_marginStart="@dimen/account_ui_hm_email_input_margin"
        android:layout_marginEnd="@dimen/account_ui_hm_email_input_margin">
        <androidx.appcompat.widget.AppCompatEditText
            android:textSize="@dimen/account_ui_hm_email_text_size"
            android:textColor="@color/s1"
            android:textColorHint="@color/s3"
            android:gravity="start|center_vertical"
            android:id="@+id/hm_email_input_password"
            android:background="@drawable/account_ui_bg_login_edit"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="@string/account_ui_account_input_password"
            android:inputType="textPassword"
            android:textAlignment="viewStart"
            android:paddingStart="@dimen/account_ui_size_15dp"
            android:paddingEnd="39dp"/>
        <ImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/hm_email_input_password_show"
            android:layout_width="@dimen/account_ui_hm_email_input_password_show_size"
            android:layout_height="@dimen/account_ui_hm_email_input_password_show_size"
            android:src="@drawable/account_ui_hm_email_eye_close"
            android:scaleType="centerInside"
            android:alpha="0.4"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="15dp"/>
    </FrameLayout>
    <TextView
        android:textSize="@dimen/account_ui_size_12sp"
        android:textColor="@color/s2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/account_ui_hm_email_input_margin"
        android:layout_marginTop="12dp"
        android:layout_marginRight="@dimen/account_ui_hm_email_input_margin"
        android:layout_marginBottom="12dp"
        android:text="@string/account_ui_register_phone_set_password_tip"/>
    <LinearLayout
        android:id="@+id/hm_email_verification_code_rl"
        android:layout_width="match_parent"
        android:layout_height="@dimen/account_ui_hm_email_input_height"
        android:layout_marginStart="@dimen/account_ui_hm_email_input_margin"
        android:layout_marginEnd="@dimen/account_ui_hm_email_input_margin">
        <androidx.appcompat.widget.AppCompatEditText
            android:textSize="@dimen/account_ui_hm_email_text_size"
            android:textColor="@color/s1"
            android:textColorHint="@color/s4"
            android:id="@+id/hm_email_verification_code"
            android:background="@drawable/account_ui_bg_login_edit"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:hint="@string/account_ui_account_input_verify_code"
            android:layout_weight="1"
            android:inputType="text"
            android:paddingStart="@dimen/account_ui_size_15dp"
            android:paddingEnd="@dimen/account_ui_size_15dp"/>
        <Space
            android:layout_width="@dimen/account_ui_size_10dp"
            android:layout_height="match_parent"/>
        <androidx.cardview.widget.CardView
            android:layout_gravity="end|top"
            android:layout_width="@dimen/account_ui_hm_email_verification_code_image_width"
            android:layout_height="match_parent"
            app:cardBackgroundColor="@color/s36"
            app:cardCornerRadius="6dp"
            app:cardElevation="0dp">
            <com.huami.account.ui.view.VerificationCodeView
                android:id="@+id/hm_email_verification_code_image"
                android:layout_width="@dimen/account_ui_hm_email_verification_code_image_width"
                android:layout_height="match_parent"
                app:bg_color="@color/s4"
                app:case_sensitive="false"
                app:code_type="number"
                app:line_num="10"
                app:point_num="100"
                app:text_color="@color/s22"
                app:text_length="4"
                app:text_size="20sp"/>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/hm_email_error"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="30dp"
        android:layout_marginTop="@dimen/account_ui_hm_email_password_margin_top"
        android:layout_marginRight="30dp">
        <ImageView
            android:layout_width="@dimen/account_ui_hm_email_error_img_size"
            android:layout_height="@dimen/account_ui_hm_email_error_img_size"
            android:src="@drawable/account_ui_hm_email_error_img"
            android:scaleType="fitXY"
            app:tint="@color/account_ui_very_high_color"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/account_ui_very_high_color"
            android:gravity="center"
            android:id="@+id/hm_email_error_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/account_ui_hm_email_error_margin"/>
    </LinearLayout>
    <TextView
        android:enabled="false"
        android:textSize="@dimen/account_ui_login_btn_text_size"
        android:textColor="@color/account_ui_select_alive_btn_txt_color"
        android:gravity="center"
        android:id="@+id/hm_email_btn"
        android:background="@drawable/account_ui_btn_bg_login"
        android:layout_width="match_parent"
        android:layout_height="@dimen/account_ui_click_button_h"
        android:layout_marginTop="@dimen/account_ui_size_60dp"
        android:text="@string/account_ui_account_register_now"
        android:layout_marginStart="@dimen/account_ui_hm_email_input_margin"
        android:layout_marginEnd="@dimen/account_ui_hm_email_input_margin"/>
    <com.huami.http.serverfault.widget.ServerFaultView
        android:id="@+id/server_fault_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_20dp"
        android:layout_marginStart="@dimen/account_ui_hm_email_input_margin"
        android:layout_marginEnd="@dimen/account_ui_hm_email_input_margin"/>
</LinearLayout>
