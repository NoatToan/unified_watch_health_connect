<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bind_introduce_container"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/h5_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <TextView
        android:textSize="17sp"
        android:textColor="@color/s1"
        android:id="@+id/web_intro_title"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="89dp"
        android:text="@string/intro_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.xiaomi.hm.health.device.introduce.webintro.WebIntroLoadingView
        android:id="@+id/loading_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="36dp"
        android:layout_marginEnd="36dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="17sp"
        android:textColor="@color/s1"
        android:gravity="center"
        android:id="@+id/intro_title_tv"
        android:background="@color/s38"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:text="@string/intro_title"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/view_pager_container"
        android:background="@color/s38"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottom_container"
        app:layout_constraintTop_toBottomOf="@+id/intro_title_tv">
        <androidx.viewpager.widget.ViewPager
            android:id="@+id/bind_introduce_view_pager"
            android:background="@color/s38"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.xiaomi.hm.health.device.introduce.IntroduceIndicator
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/introduce_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="38dp"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/bottom_container"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@+id/status_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/status_icon"
                android:layout_width="48dp"
                android:layout_height="58dp"
                android:scaleType="centerInside"/>
            <TextView
                android:textColor="@color/s2"
                android:layout_gravity="center_vertical"
                android:id="@+id/status_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"/>
        </LinearLayout>
        <Button
            android:textColor="@color/p3"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/start_use_btn"
            android:visibility="gone"
            android:layout_width="331dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="58dp"
            android:text="@string/intro_start_use"
            style="?attr/buttonStyleGray_48_flat"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/choose_restore_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
