<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/pai_pop_bg_round"
    android:layout_width="260dp"
    android:layout_height="393.2969dp">
    <ImageView
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/pai_pop_bg_75"
        android:scaleType="fitXY"
        android:contentDescription="@string/app_name"/>
    <ImageView
        android:id="@+id/pai_pop_close"
        android:padding="10.3dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:src="@drawable/sport_end_page_close"
        android:contentDescription="@string/app_name"
        android:layout_marginEnd="5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="16sp"
        android:textColor="@android:color/white"
        android:id="@+id/pai_pop_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="33.7dp"
        android:text="@string/pai_v2_pop_title"
        android:fontFamily="lt"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/pai_pop_div"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="11.3dp"
        android:src="@drawable/pai_pop_div"
        android:contentDescription="@string/app_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pai_pop_title"/>
    <ImageView
        android:id="@+id/pai_pop_circle_img"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="19.3dp"
        android:src="@drawable/pop_low_circle"
        android:contentDescription="@string/app_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pai_pop_div"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="25sp"
        android:textColor="#00d6ff"
        android:id="@+id/pai_circle_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14.5dp"
        android:fontFamily="ow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/pai_pop_circle_img"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="10sp"
        android:textColor="#00d6ff"
        android:id="@+id/pai_circle_text_sub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/pai_pai_unit"
        android:fontFamily="lt-bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pai_circle_text"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="12sp"
        android:textColor="@android:color/white"
        android:id="@+id/pai_circle_msg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="19.3dp"
        android:text="@string/pai_v2_pop_keep_msg"
        android:fontFamily="lt"
        android:layout_marginStart="33dp"
        android:layout_marginEnd="33dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pai_pop_circle_img"/>
    <ProgressBar
        android:id="@+id/pai_pop_progress"
        android:layout_width="0dp"
        android:layout_height="4.8dp"
        android:max="70"
        android:progress="40"
        android:progressDrawable="@drawable/pai_progress_bg"
        app:layout_constraintBottom_toBottomOf="@+id/pai_low_text"
        app:layout_constraintEnd_toStartOf="@+id/pai_high_text"
        app:layout_constraintStart_toEndOf="@+id/pai_low_text"
        app:layout_constraintTop_toTopOf="@+id/pai_low_text"
        style="@android:style/Widget.ProgressBar.Horizontal"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="12sp"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/pai_low_text"
        android:background="@drawable/pai_text_bg_round_light"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="lt"
        android:layout_marginStart="33dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pai_circle_msg"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="12sp"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/pai_med_text"
        android:background="@drawable/pai_text_bg_round_light"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="lt"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pai_circle_msg"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="12sp"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/pai_high_text"
        android:background="@drawable/pai_text_bg_round_light"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="lt"
        android:layout_marginEnd="32.3dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pai_circle_msg"/>
    <androidx.appcompat.widget.AppCompatCheckBox
        android:id="@+id/pai_pop_check"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="34.1dp"
        android:layout_marginBottom="34.2dp"
        android:checked="false"
        android:layout_marginStart="32.2dp"
        app:buttonTint="#b3ffffff"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pai_low_text"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="12sp"
        android:textColor="@android:color/white"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/never_reminder"
        android:fontFamily="lt"
        android:layout_marginStart="1.3dp"
        app:layout_constraintBottom_toBottomOf="@+id/pai_pop_check"
        app:layout_constraintStart_toEndOf="@+id/pai_pop_check"
        app:layout_constraintTop_toTopOf="@+id/pai_pop_check"/>
</androidx.constraintlayout.widget.ConstraintLayout>
