<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s36"
    android:paddingTop="15dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/wl_border_margin"
    android:paddingEnd="@dimen/wl_border_margin">
    <TextView
        android:textAppearance="@style/TextAppearance.MiFit.Caption.Inverse"
        android:textColor="@color/s3"
        android:id="@+id/description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/wl_bind_phone_description"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <EditText
        android:textAppearance="@style/TextAppearance.MiFit.Title.Inverse"
        android:textColor="@color/s1"
        android:textColorHint="@color/s3"
        android:id="@+id/input_phone_number"
        android:background="@color/s36"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_36dp"
        android:layout_marginTop="@dimen/size_20dp"
        android:hint="@string/wl_enter_phone_number"
        android:maxLength="11"
        android:inputType="phone"
        android:paddingStart="@dimen/size_8dp"
        android:paddingEnd="@dimen/size_8dp"
        app:layout_constraintTop_toBottomOf="@+id/description"/>
    <EditText
        android:textAppearance="@style/TextAppearance.MiFit.Title.Inverse"
        android:textColor="@color/s1"
        android:textColorHint="@color/s3"
        android:id="@+id/input_image_captcha"
        android:background="@color/s36"
        android:layout_width="0dp"
        android:layout_height="@dimen/size_36dp"
        android:layout_marginTop="@dimen/size_14dp"
        android:hint="@string/wl_captcha"
        android:maxLength="@integer/wl_image_captcha_length"
        android:inputType="text"
        android:paddingStart="@dimen/size_8dp"
        android:paddingEnd="@dimen/size_8dp"
        app:layout_constraintEnd_toStartOf="@+id/image_captcha"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/input_phone_number"/>
    <com.huami.widget.captcha.CaptchaView
        android:id="@+id/image_captcha"
        android:layout_width="@dimen/size_88dp"
        android:layout_height="@dimen/size_36dp"
        android:layout_marginStart="@dimen/size_5dp"
        app:captcha_bg_color="@color/s36"
        app:captcha_case_sensitive="false"
        app:captcha_code_type="mixed"
        app:captcha_line_num="5"
        app:captcha_point_num="50"
        app:captcha_text_color="@color/p5"
        app:captcha_text_length="@integer/wl_image_captcha_length"
        app:captcha_text_size="@dimen/size_15sp"
        app:layout_constraintBottom_toBottomOf="@+id/input_image_captcha"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/input_image_captcha"
        app:layout_constraintTop_toTopOf="@+id/input_image_captcha"/>
    <EditText
        android:textAppearance="@style/TextAppearance.MiFit.Title.Inverse"
        android:textColor="@color/s1"
        android:textColorHint="@color/s3"
        android:id="@+id/input_sms_captcha"
        android:background="@color/s36"
        android:layout_width="0dp"
        android:layout_height="@dimen/size_36dp"
        android:layout_marginTop="@dimen/size_14dp"
        android:hint="@string/wl_sms_captcha"
        android:maxLength="@integer/wl_sms_captcha_length"
        android:inputType="numberSigned"
        android:paddingStart="@dimen/size_8dp"
        android:paddingEnd="@dimen/size_8dp"
        app:layout_constraintEnd_toStartOf="@+id/get_sms_captcha_button"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/input_image_captcha"/>
    <Button
        android:gravity="center"
        android:id="@+id/get_sms_captcha_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/size_88dp"
        android:text="@string/wl_get_captcha"
        android:layout_marginStart="@dimen/size_5dp"
        app:layout_constraintBottom_toBottomOf="@+id/input_sms_captcha"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/input_sms_captcha"
        app:layout_constraintTop_toTopOf="@+id/input_sms_captcha"
        style="?attr/buttonStyleGray_38_flat"/>
    <TextView
        android:textAppearance="@style/TextAppearance.MiFit.Caption.OrangePink"
        android:id="@+id/tips"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_16dp"
        android:drawablePadding="@dimen/size_8dp"
        android:drawableStart="@drawable/ic_alert_44"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/input_sms_captcha"/>
    <Button
        android:id="@+id/next_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/wl_border_margin"
        android:layout_marginBottom="@dimen/wl_border_margin"
        android:text="@string/wl_next_step"
        app:layout_constraintBottom_toBottomOf="parent"
        style="@style/Rainbow.Widget.Button.44.Circular"/>
</androidx.constraintlayout.widget.ConstraintLayout>
