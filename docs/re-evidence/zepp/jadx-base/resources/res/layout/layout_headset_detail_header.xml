<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_headset_container"
    android:layout_width="match_parent"
    android:layout_height="202dp">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_headset"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_35dp"
        android:src="@drawable/img_headset_settings_mozart"
        android:layout_marginStart="@dimen/td_size_25dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_21dp"
        android:src="@drawable/ic_headset_settings_left"
        android:layout_marginEnd="@dimen/size_19dp"
        app:layout_constraintEnd_toStartOf="@+id/tv_left_battery"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toEndOf="@+id/iv_headset"
        app:layout_constraintTop_toTopOf="@+id/iv_headset"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="32sp"
        android:textColor="@color/setting_battery_low_text_color"
        android:id="@+id/tv_left_battery"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-4dp"
        android:layout_marginStart="@dimen/size_63dp"
        app:layout_constraintStart_toEndOf="@+id/iv_headset"
        app:layout_constraintTop_toTopOf="@+id/iv_headset"
        style="@style/Rainbow.TextAppearance.Number1"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="15sp"
        android:textColor="@color/setting_battery_low_text_color"
        android:id="@+id/tv_left_battery_percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/percent"
        android:layout_marginStart="@dimen/td_size_3dp"
        app:layout_constraintBaseline_toBaselineOf="@+id/tv_left_battery"
        app:layout_constraintStart_toEndOf="@+id/tv_left_battery"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_left_charge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:src="@drawable/headset_charging_icon"
        android:layout_marginStart="9dp"
        app:layout_constraintStart_toEndOf="@+id/tv_left_battery_percent"
        app:layout_constraintTop_toTopOf="@+id/tv_left_battery_percent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size_11dp"
        android:src="@drawable/ic_headset_settings_right"
        android:layout_marginEnd="@dimen/size_19dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_right_battery"
        app:layout_constraintEnd_toStartOf="@+id/tv_right_battery"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toEndOf="@+id/iv_headset"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="32sp"
        android:textColor="@color/setting_battery_text_color"
        android:id="@+id/tv_right_battery"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_63dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_headset"
        app:layout_constraintStart_toEndOf="@+id/iv_headset"
        app:layout_constraintTop_toTopOf="@+id/iv_headset"
        style="@style/Rainbow.TextAppearance.Number1"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="15sp"
        android:textColor="@color/setting_battery_text_color"
        android:id="@+id/tv_right_battery_percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/percent"
        android:layout_marginStart="@dimen/size_3dp"
        app:layout_constraintBaseline_toBaselineOf="@+id/tv_right_battery"
        app:layout_constraintStart_toEndOf="@+id/tv_right_battery"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_right_charge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_7dp"
        android:src="@drawable/headset_charging_icon"
        android:layout_marginStart="@dimen/size_9dp"
        app:layout_constraintStart_toEndOf="@+id/tv_right_battery_percent"
        app:layout_constraintTop_toTopOf="@+id/tv_right_battery_percent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_box"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size_18dp"
        android:src="@drawable/ic_headset_settings_box"
        android:layout_marginEnd="@dimen/size_19dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_box_battery"
        app:layout_constraintEnd_toStartOf="@+id/tv_box_battery"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toEndOf="@+id/iv_headset"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="32sp"
        android:textColor="@color/setting_battery_invalid_text_color"
        android:id="@+id/tv_box_battery"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_63dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_headset"
        app:layout_constraintStart_toEndOf="@+id/iv_headset"
        style="@style/Rainbow.TextAppearance.Number1"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="15sp"
        android:textColor="@color/setting_battery_text_color"
        android:id="@+id/tv_box_battery_percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/percent"
        android:layout_marginStart="@dimen/size_3dp"
        app:layout_constraintBaseline_toBaselineOf="@+id/tv_box_battery"
        app:layout_constraintStart_toEndOf="@+id/tv_box_battery"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_box_charge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_7dp"
        android:src="@drawable/headset_charging_icon"
        android:layout_marginStart="@dimen/size_9dp"
        app:layout_constraintStart_toEndOf="@+id/tv_box_battery_percent"
        app:layout_constraintTop_toTopOf="@+id/tv_box_battery_percent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
