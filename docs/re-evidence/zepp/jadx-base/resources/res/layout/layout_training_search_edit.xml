<?xml version="1.0" encoding="utf-8"?>
<EditText xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:textSize="13.3sp"
    android:textColor="@color/tr_font_gray_dark"
    android:textColorHint="@color/tr_font_gray_light"
    android:gravity="center_vertical"
    android:id="@+id/edit_query"
    android:background="@null"
    android:layout_width="0dp"
    android:layout_height="30dp"
    android:hint="@string/tr_search_training"
    android:drawablePadding="10dp"
    android:inputType="textNoSuggestions"
    android:imeOptions="actionSearch"
    android:textCursorDrawable="@drawable/tr_selector_cursor_color"
    android:drawableStart="@drawable/tr_ic_search_small"
    android:fontFamily="lt"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toStartOf="@+id/delete"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent"/>
