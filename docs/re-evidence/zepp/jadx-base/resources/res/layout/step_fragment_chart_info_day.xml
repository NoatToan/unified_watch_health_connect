<?xml version="1.0" encoding="utf-8"?>
<com.huami.hmchartui.ui.view.CommonCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="14dp"
    android:layout_marginStart="14dp"
    android:layout_marginEnd="14dp"
    app:cardCornerRadius="@dimen/common_card_radius"
    app:cardElevation="@dimen/common_card_elevation">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/step_stage_content"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="18sp"
            android:textColor="@color/s1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="@string/step_day_activity"
            android:layout_marginStart="18dp"/>
        <ListView
            android:id="@+id/list_view"
            android:focusable="false"
            android:scrollbars="none"
            android:clickable="false"
            android:animationCache="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp"
            android:listSelector="@android:color/transparent"
            android:scrollingCache="false"
            android:divider="@null"
            android:smoothScrollbar="true"
            android:overScrollMode="never"/>
        <RelativeLayout
            android:id="@+id/check_all_rl"
            android:layout_width="match_parent"
            android:layout_height="50dp">
            <View
                android:background="@color/s4"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="14sp"
                android:textColor="@color/black40"
                android:gravity="center"
                android:id="@+id/tv_check_all_status"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:text="@string/step_check_all"
                android:drawablePadding="4dp"
                android:layout_centerInParent="true"
                android:drawableEnd="@drawable/step_arrow_down"
                android:fontFamily="lt"/>
        </RelativeLayout>
    </LinearLayout>
</com.huami.hmchartui.ui.view.CommonCardView>
