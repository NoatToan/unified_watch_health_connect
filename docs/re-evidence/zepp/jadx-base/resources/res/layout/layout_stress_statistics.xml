<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/shape_rect_corner_white"
    android:padding="@dimen/size_15dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="@dimen/size_16sp"
        android:textColor="@color/s1"
        android:id="@+id/statistics_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textDirection="locale"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.xiaomi.hm.health.training.ui.widget.UpDownTextItem
        android:id="@+id/statistics_avg"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:downText="@string/stress_avg"
        app:downTextColor="@color/s2"
        app:downTextSize="14sp"
        app:layout_constraintBottom_toBottomOf="@+id/divider_top"
        app:layout_constraintEnd_toStartOf="@+id/divider_top"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/divider_top"
        app:textPadding="7dp"
        app:upText="0"
        app:upTextColor="@color/s52"
        app:upTextSize="24sp"/>
    <View
        android:id="@+id/divider_top"
        android:background="@color/s4"
        android:layout_width="1dp"
        android:layout_height="110dp"
        android:layout_marginTop="@dimen/size_10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/statistics_title"/>
    <com.xiaomi.hm.health.training.ui.widget.UpDownTextItem
        android:id="@+id/statistics_single_times"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:downText="@string/stress_single"
        app:downTextColor="@color/s2"
        app:downTextSize="14sp"
        app:layout_constraintBottom_toBottomOf="@+id/divider_top"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/divider_top"
        app:layout_constraintTop_toTopOf="@+id/divider_top"
        app:textPadding="7dp"
        app:upText="0"
        app:upTextColor="@color/s25"
        app:upTextSize="24sp"/>
    <View
        android:id="@+id/divider_middle"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="11dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider_top"
        style="@style/VerticalDivider"/>
    <View
        android:id="@+id/divider_bottom"
        android:background="@color/s4"
        android:layout_width="1dp"
        android:layout_height="110dp"
        android:layout_marginTop="11dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider_middle"/>
    <com.xiaomi.hm.health.training.ui.widget.UpDownTextItem
        android:id="@+id/statistics_max"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:downText="@string/stress_max"
        app:downTextColor="@color/s2"
        app:downTextSize="14sp"
        app:layout_constraintBottom_toBottomOf="@+id/divider_bottom"
        app:layout_constraintEnd_toStartOf="@+id/divider_bottom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/divider_bottom"
        app:textPadding="7dp"
        app:upText="0"
        app:upTextColor="@color/s15"
        app:upTextSize="24sp"/>
    <com.xiaomi.hm.health.training.ui.widget.UpDownTextItem
        android:id="@+id/statistics_min"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:downText="@string/stress_min"
        app:downTextColor="@color/s2"
        app:downTextSize="14sp"
        app:layout_constraintBottom_toBottomOf="@+id/divider_bottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/divider_bottom"
        app:layout_constraintTop_toTopOf="@+id/divider_bottom"
        app:textPadding="7dp"
        app:upText="0"
        app:upTextColor="@color/s30"
        app:upTextSize="24sp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
