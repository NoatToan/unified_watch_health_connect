<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/chart_bg_round"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/sport_energy_container"
        android:paddingTop="9dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:minWidth="174dp"
        android:paddingStart="10dp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textColor="@color/s1"
            android:id="@+id/sport_energy_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Rainbow.TextAppearance.Body5"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textColor="@color/s1"
            android:id="@+id/sport_energy_main_data"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:layout_marginBottom="9dp"
            android:text="@string/sport_energy_main"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/sport_energy_title"
            style="@style/sportEnergyMainDataStyle"/>
        <TextView
            android:textColor="@color/s1"
            android:id="@+id/sport_energy_data_unit"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="9dp"
            android:text="@string/unit_kc"
            android:layout_marginStart="5dp"
            app:layout_constraintBottom_toBottomOf="@+id/sport_energy_main_data"
            app:layout_constraintStart_toEndOf="@+id/sport_energy_main_data"
            style="@style/Rainbow.TextAppearance.Body5"/>
        <TextView
            android:textColor="@color/s2"
            android:id="@+id/sport_energy_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="@+id/sport_energy_main_data"
            app:layout_constraintTop_toBottomOf="@+id/sport_energy_main_data"
            style="@style/Rainbow.TextAppearance.Body5"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/fl_chart_xy_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@+id/sport_energy_container">
        <include
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/chart_x_y"/>
    </FrameLayout>
    <View
        android:id="@+id/divider"
        android:background="@color/s10"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        app:layout_constraintBottom_toTopOf="@+id/main_activity_title"
        app:layout_constraintTop_toBottomOf="@+id/fl_chart_xy_container"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/main_activity_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="15dp"
        android:text="@string/main_activities"
        android:layout_marginStart="18dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fl_chart_xy_container"
        style="@style/Rainbow.TextAppearance.Title3"/>
</androidx.constraintlayout.widget.ConstraintLayout>
