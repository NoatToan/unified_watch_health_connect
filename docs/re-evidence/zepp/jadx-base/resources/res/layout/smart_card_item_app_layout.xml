<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/content"
        android:background="@color/s38"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_15dp"
        android:layout_marginEnd="@dimen/size_15dp">
        <ImageView
            android:id="@+id/sort_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="18dp"
            android:layout_alignParentStart="true"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/sort_item_drag_area"
            android:layout_toEndOf="@+id/sort_icon">
            <TextView
                android:textColor="@color/s1"
                android:gravity="start"
                android:id="@+id/sort_item_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                style="@style/Rainbow.TextAppearance.Body3"/>
            <TextView
                android:textColor="@color/s1"
                android:gravity="start"
                android:id="@+id/sort_item_sub_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                style="@style/Rainbow.TextAppearance.Body5"/>
        </LinearLayout>
        <RelativeLayout
            android:id="@+id/sort_item_drag_area"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true">
            <ImageView
                android:id="@+id/sort_drag_item"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/sort_icon"
                android:layout_centerVertical="true"
                android:layout_marginEnd="18dp"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </RelativeLayout>
</FrameLayout>
