<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@drawable/sport_open_device_tip_dialog_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="320dp">
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/sport_analysis_dialog_close"
        android:background="@drawable/icon_sport_analysis_dialog_close"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"/>
    <ImageView
        android:background="@drawable/icon_sport_open_device_support_hr_analysis"
        android:layout_width="51dp"
        android:layout_height="51dp"
        android:layout_marginTop="-6dp"/>
    <TextView
        android:textSize="17sp"
        android:textColor="@color/s1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:text="@string/heart_rate_analyze"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/s2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/sport_open_device_hr_analysis_summary_section_one"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/s2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/sport_open_device_hr_analysis_summary_section_two"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/s2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/sport_open_device_hr_analysis_summary_section_three"/>
    </LinearLayout>
</LinearLayout>
