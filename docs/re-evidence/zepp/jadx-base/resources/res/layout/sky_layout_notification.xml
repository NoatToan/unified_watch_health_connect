<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:background="@android:color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/sky_music_image"
        android:layout_width="94dp"
        android:layout_height="match_parent"
        android:src="@drawable/ic_sky_notification"
        android:scaleType="centerInside"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <TextView
            android:textSize="16sp"
            android:ellipsize="end"
            android:gravity="bottom"
            android:id="@+id/sky_music_title"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:text="@string/sky_play_title"
            android:maxLines="1"
            android:layout_weight="37"
            android:layout_marginStart="@dimen/size_14dp"
            android:layout_marginEnd="@dimen/size_14dp"
            style="@style/TextAppearance.Compat.Notification.Title"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="57">
            <ImageView
                android:id="@+id/sky_music_like"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginTop="@dimen/size_5dp"
                android:src="@drawable/ic_sky_notification_like"
                android:scaleType="centerInside"/>
            <ImageView
                android:id="@+id/sky_music_play"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:src="@drawable/ic_sky_notification_pause"
                android:scaleType="centerInside"
                android:layout_alignTop="@+id/sky_music_like"
                android:layout_toEndOf="@+id/sky_music_like"/>
            <ImageView
                android:id="@+id/sky_music_not_like"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:src="@drawable/ic_sky_notification_skip"
                android:scaleType="centerInside"
                android:layout_alignTop="@+id/sky_music_like"
                android:layout_toEndOf="@+id/sky_music_play"/>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
