<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:background="@color/s38"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="@color/s2"
        android:id="@+id/hr_abnormal_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginStart="15dp"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/hr_abnormal_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBaseline="@+id/hr_abnormal_title"
        android:layout_marginStart="3dp"
        android:layout_toEndOf="@+id/hr_abnormal_title"
        style="@style/Rainbow.TextAppearance.Body3"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/hr_abnormal_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxWidth="340dp"
        android:text="@string/abnormal_heart_beat"
        android:layout_below="@+id/hr_abnormal_time"
        android:layout_alignStart="@+id/hr_abnormal_time"
        style="@style/Rainbow.TextAppearance.Body3"/>
    <Space
        android:id="@+id/lastSpace"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="14dp"
        android:layout_below="@+id/hr_abnormal_title"/>
</RelativeLayout>
