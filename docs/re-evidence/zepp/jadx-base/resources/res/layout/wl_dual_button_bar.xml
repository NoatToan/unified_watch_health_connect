<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dual_button_bar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <Button
        android:id="@+id/btn_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Rainbow.Widget.Button.44.Circular"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <TextView
        android:textColor="@color/s5"
        android:gravity="center"
        android:id="@+id/left_button"
        android:background="@null"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/btn_bg"
        app:layout_constraintEnd_toStartOf="@+id/guideline"
        app:layout_constraintStart_toStartOf="@+id/btn_bg"
        app:layout_constraintTop_toTopOf="@+id/btn_bg"/>
    <View
        android:background="@color/s4"
        android:layout_width="0.5dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/btn_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btn_bg"/>
    <TextView
        android:textColor="@color/s5"
        android:gravity="center"
        android:id="@+id/right_button"
        android:background="@null"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/btn_bg"
        app:layout_constraintEnd_toEndOf="@+id/btn_bg"
        app:layout_constraintStart_toEndOf="@+id/guideline"
        app:layout_constraintTop_toTopOf="@+id/btn_bg"/>
</androidx.constraintlayout.widget.ConstraintLayout>
