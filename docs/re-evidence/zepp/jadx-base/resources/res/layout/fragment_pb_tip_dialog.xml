<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/pb_tip_dialog_shape"
    android:paddingTop="23dp"
    android:paddingBottom="24.3dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingStart="23dp"
    android:paddingEnd="16dp">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/iv_pb"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_dialog_pb"/>
        <TextView
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/black90"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pb_tip_title"
            android:lineSpacingExtra="4sp"
            android:layout_marginStart="8dp"
            android:layout_toEndOf="@+id/iv_pb"/>
        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_dialog_pb_delete"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/black50"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/pb_tip_info"
        android:lineSpacingExtra="7sp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@drawable/btn_black_red_text_color_selector"
        android:gravity="center"
        android:id="@+id/tv_known"
        android:background="@drawable/btn_black_red_border_selector"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="24dp"
        android:text="@string/btn_known"
        android:layout_marginEnd="7dp"/>
</LinearLayout>
