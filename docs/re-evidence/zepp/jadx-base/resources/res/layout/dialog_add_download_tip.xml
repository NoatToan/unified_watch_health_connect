<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/dialog_empty_area"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/dialog_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="17sp"
            android:textColor="@color/s1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/earbud_download_tip_title"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/s2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/earbud_download_tip_one"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/s1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="35dp"
            android:layout_marginBottom="40dp"
            android:text="@string/earbud_download_tip_two"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp"/>
        <View
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="7dp"
            android:layout_marginEnd="7dp"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/s1"
            android:gravity="center"
            android:id="@+id/btn_know"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="@string/i_know"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp"/>
    </LinearLayout>
</LinearLayout>
