<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="160dp">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/homepage_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <View
        android:background="@color/s4"
        android:layout_width="0.5dp"
        android:layout_height="90dp"
        android:layout_marginTop="50dp"
        app:layout_constraintEnd_toEndOf="@+id/homepage_guideline"
        app:layout_constraintStart_toStartOf="@+id/homepage_guideline"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/blood_pressure_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        app:layout_constraintEnd_toEndOf="@+id/homepage_guideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/signs_state_title"
        app:srcCompat="@drawable/ic_card_icon_blood_pressure_30_p3"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/blood_sugar_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="30dp"
        android:layout_marginTop="15dp"
        android:layout_marginRight="30dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/homepage_guideline"
        app:layout_constraintTop_toBottomOf="@+id/signs_state_title"
        app:srcCompat="@drawable/ic_card_icon_blood_sugar_30_p3"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/blood_pressure_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="19dp"
        android:text="@string/homepage_item_card_blood_pressure_unit"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/homepage_guideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_bias="1"
        style="@style/Rainbow.TextAppearance.Body5"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/blood_sugar_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="19dp"
        android:text="@string/homepage_item_card_blood_sugar_unit"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/homepage_guideline"
        app:layout_constraintVertical_bias="1"
        style="@style/Rainbow.TextAppearance.Body5"/>
    <com.huami.module.homepage.cards.cardui.BackgroundTextView
        android:id="@+id/blood_pressure_mask"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:backgroundTintAlpha="0.92"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/homepage_guideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.huami.module.homepage.cards.cardui.BackgroundTextView
        android:id="@+id/blood_sugar_mask"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/homepage_guideline"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.huami.module.homepage.cards.cardui.CardTitleBarView
        android:id="@+id/signs_state_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:secondTitleText="@string/homepage_item_card_blood_sugar"
        app:timeWarpRules="calculate"
        app:titleText="@string/homepage_item_card_blood_pressure"/>
    <TextView
        android:textColor="@color/s1"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/blood_pressure_value"
        android:paddingLeft="15dp"
        android:paddingRight="15dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        app:layout_constraintBottom_toTopOf="@+id/blood_pressure_unit"
        app:layout_constraintEnd_toEndOf="@+id/homepage_guideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/blood_pressure_tv"
        app:layout_constraintVertical_bias="1"
        style="@style/Rainbow.TextAppearance.Number2"/>
    <TextView
        android:textColor="@color/s1"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/blood_sugar_value"
        android:paddingLeft="15dp"
        android:paddingRight="15dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        app:layout_constraintBottom_toTopOf="@+id/blood_sugar_unit"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/homepage_guideline"
        app:layout_constraintTop_toBottomOf="@+id/blood_sugar_tv"
        app:layout_constraintVertical_bias="1"
        style="@style/Rainbow.TextAppearance.Number2"/>
    <TextView
        android:textColor="@color/s1"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/blood_pressure_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="124dp"
        android:maxLines="2"
        app:layout_constraintBottom_toTopOf="@+id/blood_pressure_unit"
        app:layout_constraintEnd_toEndOf="@+id/homepage_guideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/blood_pressure_tv"
        app:layout_constraintVertical_bias="0"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <TextView
        android:textColor="@color/s1"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/blood_sugar_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="124dp"
        android:maxLines="2"
        app:layout_constraintBottom_toTopOf="@+id/blood_sugar_unit"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/homepage_guideline"
        app:layout_constraintTop_toBottomOf="@+id/blood_sugar_tv"
        app:layout_constraintVertical_bias="0"
        style="@style/Rainbow.TextAppearance.Body4"/>
</androidx.constraintlayout.widget.ConstraintLayout>
