<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/play_status_card_bg"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:layout_width="220dp"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/play_sub_title_size"
        android:textColor="@color/s2"
        android:gravity="center_vertical"
        android:id="@+id/tool_popup_scan"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/play_tool_friends_scan"
        android:drawablePadding="8dp"
        android:drawableStart="@drawable/ic_tool_friends_scan_24"
        android:paddingStart="@dimen/size_15dp"
        android:paddingEnd="@dimen/size_15dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/play_sub_title_size"
        android:textColor="@color/s2"
        android:gravity="center_vertical"
        android:id="@+id/tool_popup_qrcode"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/play_tool_friends_qrcode"
        android:drawablePadding="8dp"
        android:drawableStart="@drawable/ic_tool_friends_qrcode_24"
        android:paddingStart="@dimen/size_15dp"
        android:paddingEnd="@dimen/size_15dp"
        app:layout_constraintTop_toBottomOf="@+id/tool_popup_scan"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/play_sub_title_size"
        android:textColor="@color/s2"
        android:gravity="center_vertical"
        android:id="@+id/tool_popup_invite"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/play_tool_friends_invite"
        android:drawablePadding="8dp"
        android:drawableStart="@drawable/ic_tool_friends_invite_24"
        android:paddingStart="@dimen/size_15dp"
        android:paddingEnd="@dimen/size_15dp"
        app:layout_constraintTop_toBottomOf="@+id/tool_popup_qrcode"/>
</androidx.constraintlayout.widget.ConstraintLayout>
