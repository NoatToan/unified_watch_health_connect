<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.watch.companion.ui.view.ActionbarLayout
        android:id="@+id/actionbar_screen_unlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ScrollView
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:background="@color/bg_main"
                android:layout_width="match_parent"
                android:layout_height="336dp">
                <FrameLayout
                    android:id="@+id/container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/unlock_bind_reset_tips_view"
                    android:background="@drawable/romupdate_tips_bg"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_centerHorizontal="true"
                    android:layout_marginStart="13dp"
                    android:layout_marginEnd="13dp">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/white_text"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/unlock_bind_reset_tips"
                        android:layout_weight="1"
                        android:paddingStart="9dp"/>
                    <ImageView
                        android:id="@+id/unlock_bind_reset_tips_clear"
                        android:padding="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:src="@drawable/selector_romupdate_tips_delete_icon"/>
                </LinearLayout>
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="108dp"
                    android:layout_centerHorizontal="true">
                    <ImageView
                        android:layout_gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/unlock_icon_image"
                        android:layout_marginStart="2dp"/>
                </FrameLayout>
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#e6000000"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="32.7dp"
                    android:text="@string/unlock_tips"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"/>
            </RelativeLayout>
            <View
                android:background="@color/divider_color"
                android:layout_width="match_parent"
                android:layout_height="0.3dp"/>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/unlock_screen_set_layout"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <FrameLayout
                            android:clickable="false"
                            android:layout_width="match_parent"
                            android:layout_height="46.3dp"
                            android:paddingStart="@dimen/common_item_padding"
                            android:paddingEnd="@dimen/common_item_padding">
                            <TextView
                                android:textSize="12sp"
                                android:textColor="@color/grey_text"
                                android:layout_gravity="center_vertical"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/first_set_lock_screen_pw"/>
                        </FrameLayout>
                        <FrameLayout
                            android:id="@+id/set_unlock_screen_password_layout"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:layout_width="match_parent"
                            android:layout_height="51dp"
                            android:paddingStart="@dimen/common_item_padding"
                            android:paddingEnd="@dimen/common_item_padding">
                            <include layout="@layout/split_line_width_match_parent"/>
                            <TextView
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@drawable/color_text_may_disable"
                                android:gravity="center_vertical"
                                android:id="@+id/set_unlock_screen_password_text"
                                android:clickable="false"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:maxWidth="270dp"
                                android:text="@string/lock_screen_first_step"/>
                            <ImageView
                                android:layout_gravity="end|center_vertical"
                                android:id="@+id/set_unlock_screen_password_icon"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@drawable/ic_list_item_right_arrow_selector"/>
                            <TextView
                                android:textSize="14sp"
                                android:textColor="@color/grey_text"
                                android:layout_gravity="end|center_vertical"
                                android:id="@+id/set_unlock_screen_password_text_tip"
                                android:visibility="gone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/screen_lock_text_tip"/>
                            <View
                                android:layout_gravity="bottom"
                                android:background="#77f7f7f7"
                                android:visibility="gone"
                                android:clickable="true"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"/>
                        </FrameLayout>
                        <include layout="@layout/split_line_width_match_parent"/>
                        <View
                            android:background="@color/bg_main"
                            android:layout_width="match_parent"
                            android:layout_height="10dp"/>
                        <View
                            android:background="@color/divider_color"
                            android:layout_width="match_parent"
                            android:layout_height="1px"/>
                        <FrameLayout
                            android:clickable="false"
                            android:layout_width="match_parent"
                            android:layout_height="46.3dp"
                            android:paddingStart="@dimen/common_item_padding"
                            android:paddingEnd="@dimen/common_item_padding">
                            <TextView
                                android:textSize="12sp"
                                android:textColor="@color/grey_text"
                                android:layout_gravity="center_vertical"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/check_lock_screen_pw"/>
                        </FrameLayout>
                        <FrameLayout
                            android:id="@+id/set_watch_unlock_layout"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:layout_width="match_parent"
                            android:layout_height="51dp"
                            android:paddingStart="@dimen/common_item_padding"
                            android:paddingEnd="@dimen/common_item_padding">
                            <include layout="@layout/split_line_width_match_parent"/>
                            <TextView
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@drawable/color_text_may_disable"
                                android:gravity="center_vertical"
                                android:id="@+id/set_watch_unlock_text"
                                android:clickable="false"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:maxWidth="270dp"
                                android:text="@string/watch_lock_screen_second_step"/>
                            <ImageView
                                android:layout_gravity="end|center_vertical"
                                android:id="@+id/set_watch_unlock_icon"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@drawable/ic_list_item_right_arrow_selector"/>
                            <View
                                android:layout_gravity="bottom"
                                android:background="#77f7f7f7"
                                android:visibility="gone"
                                android:clickable="true"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"/>
                        </FrameLayout>
                        <include layout="@layout/split_line_width_match_parent"/>
                    </LinearLayout>
                    <include layout="@layout/watch_unlock_distance_layout"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/has_unlock_with_bracelet_ll"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <LinearLayout
                            android:layout_gravity="center_vertical"
                            android:id="@+id/unlock_enable_setting"
                            android:visibility="gone"
                            android:clickable="true"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:paddingStart="23.3dp"
                            android:paddingEnd="23.3dp">
                            <LinearLayout
                                android:layout_gravity="center_vertical"
                                android:orientation="vertical"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1">
                                <TextView
                                    android:textSize="14.7sp"
                                    android:textColor="@color/black_text"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/unlock_screen_switch"/>
                            </LinearLayout>
                            <Switch
                                android:id="@+id/enable_watch_unlock"
                                android:layout_width="wrap_content"
                                android:layout_height="18dp"
                                android:textOn=""
                                android:textOff=""
                                style="@style/WatchSwitch"/>
                        </LinearLayout>
                        <include layout="@layout/split_line_width_match_parent"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/dark_grey_text"
                            android:gravity="center"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="53.3dp"
                            android:text="@string/unlock_screen_modify_unlock_v6"/>
                        <TextView
                            android:textColor="@color/black_text"
                            android:gravity="center"
                            android:id="@+id/unlock_screen_invalid_tv"
                            android:clickable="true"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="50dp"
                            android:layout_marginBottom="23dp"
                            android:text="@string/unlock_screen_invalid"/>
                    </LinearLayout>
                </LinearLayout>
                <View
                    android:layout_gravity="bottom"
                    android:id="@+id/miui_mask_view"
                    android:background="#77f7f7f7"
                    android:visibility="gone"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </FrameLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
