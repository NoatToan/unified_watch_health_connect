<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:visibility="visible"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="10dp"
    android:layout_marginRight="10dp">
    <ImageView
        android:id="@+id/homepage_service_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="12dp"
        android:src="@drawable/ic_alert_20"
        android:layout_marginStart="15dp"
        android:layout_alignParentStart="true"
        app:tint="@color/s1"/>
    <TextView
        android:textColor="@color/s1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:text="@string/server_fault_message_500"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="40dp"
        android:layout_toEndOf="@+id/homepage_service_icon"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <ImageView
        android:id="@+id/homepage_service_close"
        android:padding="7dp"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="8dp"
        android:src="@drawable/ic_close_20"
        android:layout_marginEnd="8dp"
        android:layout_alignParentEnd="true"
        app:tint="@color/s2"/>
</RelativeLayout>
