<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/wf_home_list_padding"
    android:paddingEnd="@dimen/wf_home_list_padding">
    <TextView
        android:textSize="16sp"
        android:textColor="#ffffff"
        android:gravity="center_vertical"
        android:id="@+id/titleTv"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/bgIv"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        app:layout_constraintDimensionRatio="h,345:417"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleTv"
        app:shapeAppearance="@style/WFTodayRecommendIv"/>
    <TextView
        android:textSize="28sp"
        android:textColor="@color/white100"
        android:id="@+id/recommendTitleTv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginStart="22dp"
        app:layout_constraintEnd_toEndOf="@+id/bgIv"
        app:layout_constraintStart_toStartOf="@+id/bgIv"
        app:layout_constraintTop_toTopOf="@+id/bgIv"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/infoLayout"
        android:background="@drawable/wf_today_recommend_info_bg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="h,345:85">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/watchIv"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginStart="@dimen/wf_home_list_padding"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@+id/guideline"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintGuide_percent="0.5"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#ffffff"
            android:id="@+id/watchNameTv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            android:singleLine="true"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toTopOf="@+id/guideline"
            app:layout_constraintEnd_toStartOf="@+id/feeBtn"
            app:layout_constraintStart_toEndOf="@+id/watchIv"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#66ffffff"
            android:id="@+id/watchAuthorTv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:singleLine="true"
            android:layout_marginStart="16dp"
            app:layout_constraintEnd_toStartOf="@+id/feeBtn"
            app:layout_constraintStart_toEndOf="@+id/watchIv"
            app:layout_constraintTop_toBottomOf="@+id/guideline"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/wf_color_btn_pay"
            android:id="@+id/feeBtn"
            android:background="@drawable/wf_buy_btn_bg"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:layout_marginEnd="@dimen/wf_home_list_padding"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
