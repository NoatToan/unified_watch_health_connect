<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#f8f8f8"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.watch.companion.ui.view.ActionbarLayout
        android:id="@+id/action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.huami.watch.companion.ui.view.LiveEditText
                android:id="@+id/et_schedule_title"
                android:minHeight="50dp"
                android:hint="@string/schedule_title"
                style="@style/EditItemStyle"/>
            <LinearLayout
                android:orientation="vertical"
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <RelativeLayout
                    android:layout_marginTop="10dp"
                    style="@style/ItemStyle">
                    <TextView
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/all_day_event"
                        android:layout_centerVertical="true"
                        style="@style/InfoText"/>
                    <Switch
                        android:id="@+id/reminder_all_day"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_alignParentEnd="true"
                        style="@style/WatchSwitch"/>
                </RelativeLayout>
                <View style="@style/DividerWithMargin"/>
                <RelativeLayout
                    android:onClick="onClickScheduleStartTime"
                    style="@style/ItemStyle">
                    <TextView
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/start_time"
                        android:layout_centerVertical="true"
                        style="@style/InfoText"/>
                    <TextView
                        android:textColor="#80000000"
                        android:id="@+id/tv_schedule_start"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_toStartOf="@+id/schedule_start_arrow"
                        style="@style/InfoText"/>
                    <ImageView
                        android:id="@+id/schedule_start_arrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_arrow_right_small"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="10dp"
                        android:layout_alignParentEnd="true"/>
                </RelativeLayout>
                <View style="@style/DividerWithMargin"/>
                <RelativeLayout
                    android:onClick="onClickScheduleEndTime"
                    style="@style/ItemStyle">
                    <TextView
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/end_time"
                        android:layout_centerVertical="true"
                        style="@style/InfoText"/>
                    <TextView
                        android:textColor="#80000000"
                        android:id="@+id/tv_schedule_end"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_toStartOf="@+id/schedule_end_arrow"
                        style="@style/InfoText"/>
                    <ImageView
                        android:id="@+id/schedule_end_arrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_arrow_right_small"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="10dp"
                        android:layout_alignParentEnd="true"/>
                </RelativeLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <RelativeLayout
                    android:id="@+id/view_reminder_repeat"
                    android:onClick="onClickScheduleReminderType"
                    style="@style/ItemStyle">
                    <TextView
                        android:textStyle="bold"
                        android:id="@+id/reminder_repeat_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/repeat"
                        android:layout_centerVertical="true"
                        style="@style/InfoText"/>
                    <TextView
                        android:textColor="#80000000"
                        android:ellipsize="middle"
                        android:gravity="end"
                        android:id="@+id/tv_schedule_reminder_type"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="15dp"
                        android:layout_toStartOf="@+id/reminder_repeat_arrow"
                        android:layout_toEndOf="@+id/reminder_repeat_text"
                        style="@style/InfoText"/>
                    <ImageView
                        android:id="@+id/reminder_repeat_arrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_arrow_right_small"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="10dp"
                        android:layout_alignParentEnd="true"/>
                </RelativeLayout>
                <View style="@style/DividerWithMargin"/>
                <RelativeLayout
                    android:id="@+id/view_reminder_minute"
                    android:onClick="onClickScheduleReminderMinutes"
                    style="@style/ItemStyle">
                    <TextView
                        android:textStyle="bold"
                        android:id="@+id/reminder_remind_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/remind"
                        android:layout_centerVertical="true"
                        style="@style/InfoText"/>
                    <TextView
                        android:textColor="#80000000"
                        android:ellipsize="end"
                        android:gravity="end"
                        android:id="@+id/tv_schedule_reminder_min"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:layout_centerVertical="true"
                        android:layout_toStartOf="@+id/reminder_remind_arrow"
                        android:layout_toEndOf="@+id/reminder_remind_text"
                        style="@style/InfoText"/>
                    <ImageView
                        android:id="@+id/reminder_remind_arrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_arrow_right_small"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="10dp"
                        android:layout_alignParentEnd="true"/>
                </RelativeLayout>
            </LinearLayout>
            <com.huami.watch.companion.ui.view.LiveEditText
                android:gravity="start"
                android:id="@+id/reminder_desc"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:minHeight="200dp"
                android:hint="@string/desc"
                style="@style/EditItemStyle"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
