<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:huami="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/s38"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/space_view"
        android:background="@color/s10"
        android:layout_width="match_parent"
        android:layout_height="@dimen/relatives_size_15dp"/>
    <FrameLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/relatives_size_78dp">
        <RelativeLayout
            android:layout_gravity="start|center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/relatives_size_16dp">
            <ImageView
                android:layout_gravity="start|center_vertical"
                android:id="@+id/icon"
                android:layout_width="@dimen/relatives_size_34dp"
                android:layout_height="@dimen/relatives_size_34dp"
                android:layout_alignTop="@+id/username"
                android:layout_alignBottom="@+id/care_icon"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/s1"
                android:ellipsize="end"
                android:id="@+id/username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="@dimen/relatives_size_160dp"
                android:maxLines="1"
                android:lineSpacingExtra="-1sp"
                android:textAlignment="viewStart"
                android:layout_marginStart="@dimen/relatives_size_10dp"
                android:layout_marginEnd="@dimen/relatives_size_2dp"
                android:layout_toStartOf="@+id/last_update_time"
                android:layout_toEndOf="@+id/icon"/>
            <ImageView
                android:id="@+id/care_icon"
                android:layout_width="@dimen/relatives_size_18dp"
                android:layout_height="@dimen/relatives_size_18dp"
                android:src="@drawable/relatives_ic_red_heart"
                android:layout_below="@+id/username"
                android:layout_toEndOf="@+id/icon"
                android:layout_alignStart="@+id/username"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/s2"
                android:gravity="center"
                android:id="@+id/careByMe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:layout_alignTop="@+id/care_icon"
                android:layout_alignBottom="@+id/care_icon"
                android:lineSpacingExtra="3sp"
                android:layout_marginStart="@dimen/relatives_size_2dp"
                android:layout_toEndOf="@+id/care_icon"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/s2"
                android:gravity="center"
                android:id="@+id/last_update_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignTop="@+id/username"
                android:layout_alignBottom="@+id/username"
                android:lineSpacingExtra="3sp"
                android:layout_marginEnd="@dimen/relatives_size_16dp"
                android:layout_alignParentEnd="true"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/s2"
                android:id="@+id/last_update_tz"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignTop="@+id/care_icon"
                android:layout_alignBottom="@+id/care_icon"
                android:lineSpacingExtra="3sp"
                android:textDirection="locale"
                android:textAlignment="viewStart"
                android:layout_marginEnd="@dimen/relatives_size_16dp"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </FrameLayout>
    <View
        android:background="@color/s4"
        android:layout_width="match_parent"
        android:layout_height="@dimen/relatives_size_1dp"
        android:layout_marginStart="16sp"
        android:layout_marginEnd="16sp"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/relatives_size_78dp">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="24sp"
                android:textColor="@color/s1"
                android:id="@+id/step"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="-3sp"
                android:fontFamily="km"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/s2"
                android:gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/relatives_size_6dp"
                android:text="@string/relatives_label_activity"/>
        </LinearLayout>
        <View
            android:background="@color/s4"
            android:layout_width="@dimen/relatives_size_1dp"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/relatives_size_17dp"
            android:layout_marginBottom="@dimen/relatives_size_17dp"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <com.xiaomi.hm.health.relation.copy.UnitTextView
                android:textSize="24sp"
                android:textColor="@color/s1"
                android:id="@+id/sleep"
                android:paddingTop="@dimen/relatives_size_3dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                huami:relatives_typeface="km"
                huami:relatives_unitColor="@color/s2"
                huami:relatives_unitSize="9sp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/s2"
                android:gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/relatives_size_6dp"
                android:text="@string/relatives_label_sleep"/>
        </LinearLayout>
        <View
            android:background="@color/s4"
            android:layout_width="@dimen/relatives_size_1dp"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/relatives_size_17dp"
            android:layout_marginBottom="@dimen/relatives_size_17dp"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="24sp"
                android:textColor="@color/s1"
                android:gravity="center_horizontal"
                android:id="@+id/weight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="-3sp"
                android:fontFamily="km"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/s2"
                android:gravity="center_horizontal"
                android:id="@+id/weight_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/relatives_size_6dp"
                android:text="@string/relatives_label_weight"
                android:lineSpacingExtra="3sp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
