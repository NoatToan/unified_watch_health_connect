<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/loading_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="52dp"
        android:src="@drawable/ic_weight_data_load"
        android:layout_centerHorizontal="true"/>
    <ImageView
        android:id="@+id/loading_failure"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/slp_empty_warning"
        android:layout_alignTop="@+id/loading_view"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/weight_detail_loading_text_color"
        android:id="@+id/loading_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        android:layout_below="@+id/loading_view"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
