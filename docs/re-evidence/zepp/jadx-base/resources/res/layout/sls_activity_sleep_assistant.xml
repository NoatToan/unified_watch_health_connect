<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/back"
        android:layout_width="26dp"
        android:layout_height="0dp"
        android:layout_marginTop="7dp"
        android:src="@drawable/sls_back"
        android:scaleType="center"
        android:contentDescription="@string/app_name"
        android:layout_marginStart="6dp"
        app:layout_constraintDimensionRatio="26:35"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="23sp"
        android:textColor="@color/sls_color_black"
        android:ellipsize="end"
        android:id="@+id/sls_sleep_assistant_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="23dp"
        android:singleLine="true"
        android:fontFamily="lt-bold"
        android:layout_marginStart="29dp"
        android:layout_marginEnd="100dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/back"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="16sp"
        android:textColor="@color/sls_back_8d"
        android:ellipsize="end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/sls_sleep_assistant_welcome"
        android:fontFamily="lt"
        android:layout_marginStart="29dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sls_sleep_assistant_label"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/sleep_assistant_recycler"
        android:layout_width="0dp"
        android:layout_height="326dp"
        android:layout_marginBottom="64dp"
        android:layout_marginStart="21dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
