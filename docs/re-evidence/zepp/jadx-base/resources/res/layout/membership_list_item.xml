<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/membership_shape_list_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/size_12dp"
    android:minHeight="@dimen/size_90dp"
    android:layout_marginStart="@dimen/size_10dp"
    android:layout_marginEnd="@dimen/size_10dp">
    <ImageView
        android:id="@+id/membership_remove"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_remove_20"
        android:layout_marginStart="@dimen/size_14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/s10"/>
    <TextView
        android:textSize="@dimen/size_18sp"
        android:textColor="@color/s10"
        android:id="@+id/membership_card_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_18dp"
        android:lines="1"
        android:layout_marginStart="@dimen/size_20dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/membership_arrow"
        app:layout_constraintStart_toEndOf="@+id/membership_remove"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="@dimen/size_20dp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/s10"
        android:id="@+id/membership_card_number"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size_17dp"
        android:lines="1"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/membership_arrow"
        app:layout_constraintStart_toStartOf="@+id/membership_card_name"
        app:layout_goneMarginEnd="@dimen/size_20dp"/>
    <ImageView
        android:id="@+id/membership_card_drag"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_drag_20"
        android:layout_marginEnd="@dimen/size_14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/s10"/>
    <ImageView
        android:id="@+id/membership_arrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_arrow_forward_16"
        android:layout_marginEnd="@dimen/size_20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/s10"/>
</androidx.constraintlayout.widget.ConstraintLayout>
