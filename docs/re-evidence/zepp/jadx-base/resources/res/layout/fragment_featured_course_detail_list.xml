<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/s36"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/recommended_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:background="@color/s10"
            android:layout_width="match_parent"
            android:layout_height="10dp"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/s3"
            android:id="@+id/tv_more_courses"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tr_recommendation_related"
            android:drawableEnd="@drawable/ic_arrow_right"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"/>
        <com.xiaomi.hm.health.training.ui.widget.FeaturedCourseListView
            android:id="@+id/recommended_courses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"/>
    </LinearLayout>
</LinearLayout>
