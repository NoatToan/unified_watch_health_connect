<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minHeight="185dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/heart_head"
        android:layout_width="match_parent"
        android:layout_height="185dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.huami.module.homepage.cards.cardui.CardTitleBarView
            android:id="@+id/pai_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:showExpandButton="true"
            app:titleText="@string/homepage_item_card_pai"/>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/pai_animation"
            android:layout_width="128dp"
            android:layout_height="128dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp"
            android:layout_marginStart="15dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/pai_bar"
            app:lottie_fileName="homepage_pai_blue.json"/>
        <TextView
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/all_pai"
            android:layout_width="124dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="34dp"
            app:layout_constraintBottom_toBottomOf="@+id/pai_animation"
            app:layout_constraintEnd_toEndOf="@+id/pai_animation"
            app:layout_constraintStart_toStartOf="@+id/pai_animation"
            app:layout_constraintTop_toTopOf="@+id/pai_animation"
            style="@style/Rainbow.TextAppearance.Body4"/>
        <com.huami.module.homepage.cards.business.pai.PaiExtView
            android:id="@+id/pai_ext_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="15dp"
            app:layout_constraintBottom_toBottomOf="@+id/pai_animation"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/pai_animation"
            app:layout_constraintTop_toTopOf="@+id/pai_animation"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/homepage_guideline_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.04"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/homepage_guideline_animation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.39"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/homepage_guideline_middle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.45"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="185dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textColor="@color/s1"
            android:id="@+id/pai_latest_seven"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/homepage_item_card_pai_latest_seven"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Rainbow.TextAppearance.Body4"/>
        <com.huami.module.homepage.cards.cardui.I18nNumberView
            android:textColor="@color/s2"
            android:id="@+id/pai_seven_goal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="14dp"
            app:layout_constraintBottom_toBottomOf="@+id/pai_latest_seven"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/pai_latest_seven"
            app:numberText="@string/homepage_item_card_pai_100"
            app:unitText="@string/homepage_item_card_pai"
            style="@style/Rainbow.TextAppearance.Body5"/>
        <com.huami.module.homepage.cards.business.pai.PaiStraightGraphView
            android:id="@+id/pai_container"
            android:paddingBottom="12dp"
            android:layout_width="0dp"
            android:layout_height="90dp"
            android:layout_marginTop="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/pai_latest_seven"/>
        <com.huami.module.homepage.cards.cardui.BackgroundTextView
            android:id="@+id/pai_seven_none"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:backgroundTintAlpha="0.92"
            app:cornerDirection="bottom"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <Button
            android:id="@+id/open_hr_detect_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/homepage_item_card_open_pai_detect"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="?attr/buttonStyleRed_38_outline"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
