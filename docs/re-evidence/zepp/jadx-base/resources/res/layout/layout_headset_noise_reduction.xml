<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/viewgroup_headset_noise"
    android:background="@color/s38"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/size_15dp"
    android:layout_marginStart="@dimen/size_15dp"
    android:layout_marginEnd="@dimen/size_15dp"
    app:cardBackgroundColor="@color/s38"
    app:cardCornerRadius="6dp"
    app:cardElevation="0px"
    app:cardUseCompatPadding="false">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraint_noise_control"
        android:background="@color/s38"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/s1"
            android:id="@+id/item_headset_settings_noise_control_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_21dp"
            android:text="@string/settings_item_noise_control"
            android:layout_marginStart="@dimen/size_20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <RadioGroup
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/noise_control_type"
            android:paddingBottom="@dimen/size_17dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_20dp"
            android:weightSum="3"
            android:paddingStart="@dimen/bm_detail_size_5dp"
            android:paddingEnd="@dimen/bm_detail_size_5dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/item_headset_settings_noise_control_title">
            <RadioButton
                android:textColor="@drawable/selector_noise_reduction_text"
                android:gravity="center"
                android:id="@+id/noise_control_penetrate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:button="@null"
                android:text="@string/noise_control_mode_penetrate"
                android:drawableTop="@drawable/selector_noise_control_penetrate"
                android:drawablePadding="@dimen/size_10dp"
                android:layout_weight="1"/>
            <RadioButton
                android:textColor="@drawable/selector_noise_reduction_text"
                android:gravity="center"
                android:id="@+id/noise_control_close"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:button="@null"
                android:text="@string/noise_control_mode_close"
                android:drawableTop="@drawable/selector_noise_control_close"
                android:drawablePadding="@dimen/size_10dp"
                android:layout_weight="1"/>
            <RadioButton
                android:textColor="@drawable/selector_noise_reduction_text"
                android:gravity="center"
                android:id="@+id/noise_control_reduction"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:button="@null"
                android:text="@string/settings_item_noise_reduction"
                android:drawableTop="@drawable/selector_noise_control_reduction"
                android:drawablePadding="@dimen/size_10dp"
                android:layout_weight="1"/>
        </RadioGroup>
        <View
            android:id="@+id/divider"
            android:background="@color/s4"
            android:layout_width="0dp"
            android:layout_height="0.5dp"
            android:layout_marginStart="@dimen/size_20dp"
            android:layout_marginEnd="@dimen/size_15dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/noise_control_type"/>
        <com.huami.lib.rainbow.ListTile
            android:id="@+id/item_headset_settings_noise_reduction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/size_64dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/divider"
            app:ltv_title="@string/noise_reduction_mode"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/noise_reduction_group"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="item_headset_settings_noise_reduction,divider"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
