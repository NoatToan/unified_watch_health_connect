<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:background="@color/s36"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/head_top_divider"
        android:background="@color/s4"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_10"/>
    <View
        android:id="@+id/head_top_line"
        android:background="@color/s3"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/s2"
        android:gravity="center_vertical"
        android:id="@+id/head_title"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/size_36dp"
        android:lines="1"
        android:paddingStart="@dimen/size_18dp"
        android:paddingEnd="@dimen/size_18dp"/>
</LinearLayout>
