<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/root"
    android:background="#f8f8f8"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:src="@drawable/eid_id_card"
        android:layout_centerHorizontal="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/open_card_info"
        android:background="#ffffff"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_below="@+id/card"
        android:paddingStart="23dp"
        android:paddingEnd="23dp">
        <TextView
            android:textSize="13.4sp"
            android:textStyle="bold"
            android:textColor="#e6000000"
            android:paddingTop="20dp"
            android:paddingBottom="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/eid_tips_for_open"/>
        <TextView
            android:textSize="13.4sp"
            android:textColor="#dc2b0b"
            android:id="@+id/see_more"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/eid_available_scenes"/>
        <View
            android:background="#14000000"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="13dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="56dp">
            <CheckBox
                android:id="@+id/agreement_checkbox"
                android:background="@android:color/transparent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:button="@drawable/eid_checkbox"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#8d8d8d"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/eid_agree"
                android:layout_marginStart="12dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#dc2b0b"
                android:id="@+id/protocol"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/eid_protocol"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:background="#ffffff"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_alignParentBottom="true">
        <TextView
            android:textSize="13.4sp"
            android:textStyle="bold"
            android:textColor="@drawable/eid_text_color_selector"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/open_card"
            android:background="@drawable/eid_border_selector"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/eid_available_scenes"
            android:layout_marginStart="23dp"
            android:layout_marginEnd="23dp"/>
    </LinearLayout>
    <TextView
        android:textSize="13.4sp"
        android:textColor="#000000"
        android:id="@+id/tips"
        android:background="#ffffff"
        android:paddingTop="18dp"
        android:paddingBottom="18dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="17dp"
        android:text="@string/eid_tips"
        android:layout_below="@+id/card"
        android:lineSpacingExtra="8.3sp"
        android:paddingStart="23dp"
        android:paddingEnd="23dp"/>
</RelativeLayout>
