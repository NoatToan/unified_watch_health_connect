<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:background="@color/s36"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/size_20sp"
        android:textColor="@color/s2"
        android:gravity="center"
        android:id="@+id/activity_fw_upgrade_success_info_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="98dp"
        android:text="@string/activity_fw_upgrade_success_info_1"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/s3"
        android:gravity="center"
        android:id="@+id/activity_fw_upgrade_success_info_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:layout_below="@+id/activity_fw_upgrade_success_info_1"/>
    <RelativeLayout
        android:layout_width="140dp"
        android:layout_height="128dp"
        android:layout_marginTop="108dp"
        android:layout_below="@+id/activity_fw_upgrade_success_info_2"
        android:layout_centerHorizontal="true">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/activity_fw_upgrade_success_img"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/img_miband"
            android:scaleType="fitCenter"
            android:layout_centerInParent="true"
            android:contentDescription="@string/app_name"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/fw_upgrade_success"
            android:layout_alignParentTop="true"
            android:contentDescription="@string/app_name"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</RelativeLayout>
