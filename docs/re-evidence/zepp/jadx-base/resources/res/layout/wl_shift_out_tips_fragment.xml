<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s36"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.cardview.widget.CardView
        android:id="@+id/wl_card_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/wl_border_margin"
        android:layout_marginStart="@dimen/wl_border_margin"
        android:layout_marginEnd="@dimen/wl_border_margin"
        app:cardCornerRadius="@dimen/wl_image_round_rect_radius"
        app:cardPreventCornerOverlap="false"
        app:layout_constraintDimensionRatio="324:205"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/wl_card_image_detail"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/wl_placeholder_image"
            android:scaleType="centerCrop"/>
    </androidx.cardview.widget.CardView>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/s2"
        android:gravity="center"
        android:id="@+id/wl_tv_shift_out_info_tiny"
        android:padding="@dimen/size_22dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/wl_r_shift_out_tips"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/wl_card_view"
        style="@style/TextAppearance.MiFit.Title2.Inverse"/>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/ll_agree"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size_22dp"
        app:layout_constraintBottom_toTopOf="@+id/wl_bt_shift_out"
        app:layout_constraintStart_toStartOf="parent">
        <CheckBox
            android:id="@+id/wl_agreement_checkbox"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false"
            android:button="?android:attr/listChoiceIndicatorMultiple"
            android:layout_marginStart="8dp"/>
        <TextView
            android:textAppearance="@style/TextAppearance.MiFit.Caption.Inverse"
            android:textColor="@color/s2"
            android:id="@+id/wl_shift_out_agree"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wl_format_agree_x"
            android:layout_marginStart="@dimen/size_6dp"
            android:layout_marginEnd="@dimen/size_8dp"/>
    </LinearLayout>
    <Button
        android:enabled="false"
        android:id="@+id/wl_bt_shift_out"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_20dp"
        android:layout_marginBottom="@dimen/size_18dp"
        android:text="@string/wl_r_shift_out_sure"
        android:layout_marginStart="@dimen/wl_border_margin"
        android:layout_marginEnd="@dimen/wl_border_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        style="@style/Rainbow.Widget.Button.44.Circular"/>
</androidx.constraintlayout.widget.ConstraintLayout>
