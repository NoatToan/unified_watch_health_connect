<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.huami.widget.wheelview.WheelView
        android:id="@+id/reminder_time_am_pm"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/reminder_time_hour"
        app:layout_constraintEnd_toStartOf="@+id/reminder_time_hour"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/reminder_time_hour"/>
    <com.huami.widget.wheelview.WheelView
        android:id="@+id/reminder_time_hour"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toStartOf="@+id/reminder_time_minute"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/reminder_time_am_pm"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.huami.widget.wheelview.WheelView
        android:id="@+id/reminder_time_minute"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/reminder_time_hour"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/divider_1"
        android:background="@drawable/sky_shape_wheel_divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_1dp"
        android:layout_marginTop="@dimen/size_45dp"
        android:layout_marginStart="@dimen/size_20dp"
        android:layout_marginEnd="@dimen/size_20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/divider_2"
        android:background="@drawable/sky_shape_wheel_divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_1dp"
        android:layout_marginBottom="@dimen/size_45dp"
        android:layout_marginStart="@dimen/size_20dp"
        android:layout_marginEnd="@dimen/size_20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
