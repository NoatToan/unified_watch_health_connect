<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.lib.rainbow.ListTile
        android:id="@+id/lazy_item"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:ltv_divider_color="@color/s4"
        app:ltv_divider_padding="none"
        app:ltv_subtitle="@string/alarm_clock_lazy_summary"
        app:ltv_title="@string/alarm_clock_lazy_title"/>
    <com.huami.lib.rainbow.ListTile
        android:id="@+id/smart_item"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/lazy_item"
        app:ltv_divider_color="@color/transparent"
        app:ltv_subtitle="@string/alarm_clock_smart_summary"
        app:ltv_title="@string/alarm_clock_smart_title"/>
    <View
        android:id="@+id/divider"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_8dp"
        android:layout_below="@+id/smart_item"/>
    <com.huami.lib.rainbow.ListTile
        android:id="@+id/repeat_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/divider"
        app:ltv_divider_color="@color/transparent"
        app:ltv_title="@string/alarm_clock_repeat"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/alarm_time"
        android:background="@color/s10"
        android:layout_width="match_parent"
        android:layout_height="@dimen/alarm_wheel_hight"
        android:layout_alignParentBottom="true">
        <com.huami.widget.wheelview.WheelView
            android:id="@+id/ampm_wheel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <View
            android:background="@color/s4"
            android:layout_width="@dimen/round_bg_stroke"
            android:layout_height="match_parent"/>
        <com.huami.widget.wheelview.WheelView
            android:id="@+id/hour_wheel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <View
            android:background="@color/s4"
            android:layout_width="@dimen/round_bg_stroke"
            android:layout_height="match_parent"/>
        <com.huami.widget.wheelview.WheelView
            android:id="@+id/min_wheel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/td_size_11sp"
        android:textColor="@color/s2"
        android:gravity="top|center_horizontal"
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/alarm_delay_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_13dp"
        android:layout_marginBottom="@dimen/size_10dp"
        android:layout_above="@+id/alarm_time"
        android:layout_centerHorizontal="true"/>
    <View
        android:background="@color/s4"
        android:layout_width="match_parent"
        android:layout_height="@dimen/round_bg_stroke"
        android:layout_above="@+id/alarm_time"/>
</RelativeLayout>
