<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="15dp"
    android:paddingBottom="15dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/sport_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/sport_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        app:layout_constraintStart_toEndOf="@+id/sport_icon"
        app:layout_constraintTop_toTopOf="@+id/sport_icon"
        style="?attr/textAppearanceBody3"/>
    <TextView
        android:textColor="@color/s2"
        android:id="@+id/sport_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        app:layout_constraintEnd_toStartOf="@+id/sport_jump"
        app:layout_constraintStart_toStartOf="@+id/sport_title"
        app:layout_constraintTop_toBottomOf="@+id/sport_title"
        style="?attr/textAppearanceBody4"/>
    <Button
        android:textAppearance="?attr/textAppearanceBody4"
        android:textColor="@color/s1"
        android:gravity="center"
        android:id="@+id/sport_jump"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/sport_desc"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/sport_title"
        style="?attr/buttonStyleGray_38_flat_circular"/>
    <TextView
        android:textColor="@color/s5"
        android:gravity="center"
        android:id="@+id/tv_distance_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="21dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:layout_marginStart="30dp"
        app:layout_constraintEnd_toStartOf="@+id/tv_pace_value"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sport_desc"
        style="?attr/textAppearanceNumber6"/>
    <TextView
        android:textColor="#80ffffff"
        android:id="@+id/tv_distance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/unit_km"
        app:layout_constraintEnd_toEndOf="@+id/tv_distance_value"
        app:layout_constraintStart_toStartOf="@+id/tv_distance_value"
        app:layout_constraintTop_toBottomOf="@+id/tv_distance_value"
        style="?attr/textAppearanceBody4"/>
    <TextView
        android:textColor="@color/s5"
        android:gravity="center"
        android:id="@+id/tv_pace_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="21dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        app:layout_constraintEnd_toStartOf="@+id/tv_time_value"
        app:layout_constraintStart_toEndOf="@+id/tv_distance_value"
        app:layout_constraintTop_toBottomOf="@+id/sport_desc"
        style="?attr/textAppearanceNumber6"/>
    <TextView
        android:textColor="#80ffffff"
        android:id="@+id/tv_pace"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/pace"
        app:layout_constraintEnd_toEndOf="@+id/tv_pace_value"
        app:layout_constraintStart_toStartOf="@+id/tv_pace_value"
        app:layout_constraintTop_toBottomOf="@+id/tv_pace_value"
        style="?attr/textAppearanceBody4"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/s5"
        android:gravity="center"
        android:id="@+id/tv_time_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="21dp"
        android:layout_marginEnd="25dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_pace_value"
        app:layout_constraintTop_toBottomOf="@+id/sport_desc"
        style="?attr/textAppearanceNumber6"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#80ffffff"
        android:id="@+id/tv_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/running_time_desc"
        app:layout_constraintEnd_toEndOf="@+id/tv_time_value"
        app:layout_constraintStart_toStartOf="@+id/tv_time_value"
        app:layout_constraintTop_toBottomOf="@+id/tv_time_value"
        style="?attr/textAppearanceBody4"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_today_detail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tv_distance,tv_distance_value,tv_pace,tv_pace_value,tv_time,tv_time_value"/>
</androidx.constraintlayout.widget.ConstraintLayout>
