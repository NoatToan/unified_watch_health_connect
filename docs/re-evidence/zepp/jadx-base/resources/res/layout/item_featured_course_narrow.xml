<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_view"
    android:background="@color/s10"
    android:layout_width="@dimen/free_training_item_narrow_width"
    android:layout_height="@dimen/free_training_item_height">
    <ImageView
        android:id="@+id/iv_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <View
        android:id="@+id/view_bg"
        android:background="@drawable/item_clickable_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:maxLines="1"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/white100"
        android:gravity="center"
        android:id="@+id/badge_end"
        android:background="@drawable/ic_tr_label_bg"
        android:visibility="gone"
        android:layout_width="30dp"
        android:layout_height="16dp"
        android:layout_marginTop="4dp"
        android:layout_alignParentEnd="true"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="12sp"
        android:textColor="@color/white"
        android:id="@+id/tv_course_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:lines="1"
        android:layout_below="@+id/tv_title"
        android:layout_alignStart="@+id/tv_title"/>
    <RatingBar
        android:id="@+id/rb_difficulty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:numStars="3"
        android:rating="0"
        android:isIndicator="true"
        android:layout_below="@+id/tv_title"
        android:layout_alignStart="@+id/tv_title"
        style="@style/RatingStyle"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="12sp"
        android:textColor="@color/white60"
        android:id="@+id/tv_learn_times"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:lines="1"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="18dp"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="12sp"
        android:textColor="@color/white60"
        android:id="@+id/tv_learn_time_remain"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:lines="1"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="18dp"/>
</RelativeLayout>
