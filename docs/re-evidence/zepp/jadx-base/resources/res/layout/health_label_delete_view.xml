<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:id="@+id/health_label_history_delete_ll"
    android:background="@drawable/shape_label_history_delete_bg"
    android:layout_width="120dp"
    android:layout_height="120dp">
    <ImageView
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/health_label_history_delete_iv"
        android:layout_width="36dp"
        android:layout_height="36dp"
        app:srcCompat="@drawable/ic_loading_onequarter"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/s3"
        android:gravity="center"
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7.5dp"
        android:text="@string/health_label_history_delete"/>
</LinearLayout>
