<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.watch.companion.ui.view.ActionbarLayout
        android:id="@+id/actionbar"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RelativeLayout
                android:background="#ffffff"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <FrameLayout
                    android:layout_gravity="bottom"
                    android:id="@+id/watch_face_area"
                    android:layout_width="wrap_content"
                    android:layout_height="140dp"
                    android:layout_marginBottom="4dp"
                    android:layout_marginStart="28dp">
                    <ImageView
                        android:id="@+id/device_watch_bg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/device_watch_bg"
                        android:scaleType="fitStart"
                        android:adjustViewBounds="true"/>
                    <ImageView
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/watch_face"
                        android:layout_width="79dp"
                        android:layout_height="79dp"
                        android:layout_marginTop="40dp"/>
                    <ImageView
                        android:layout_gravity="center_horizontal"
                        android:layout_width="79dp"
                        android:layout_height="79dp"
                        android:layout_marginTop="40dp"
                        android:src="@drawable/device_watch_highlight_main"/>
                </FrameLayout>
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#e6000000"
                    android:id="@+id/connect_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:layout_marginStart="20dp"
                    android:layout_toEndOf="@+id/watch_face_area"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#999999"
                    android:id="@+id/version_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_below="@+id/connect_state"
                    android:layout_marginStart="20dp"
                    android:layout_toEndOf="@+id/watch_face_area"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#999999"
                    android:id="@+id/storage_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_below="@+id/version_info"
                    android:layout_marginStart="20dp"
                    android:layout_toEndOf="@+id/watch_face_area"/>
            </RelativeLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <View
                        android:background="#f2f2f2"
                        android:layout_width="match_parent"
                        android:layout_height="0.3dp"
                        android:layout_marginStart="20dp"
                        android:layout_marginEnd="20dp"/>
                    <include layout="@layout/view_battery_info"/>
                    <com.huami.watch.companion.ui.view.SettingItemView
                        android:id="@+id/setting_watchface"
                        app:title="@string/choose_watch_face"
                        style="@style/SettingItemStyle"/>
                </LinearLayout>
                <View
                    android:id="@+id/mask_view_top"
                    android:background="#77f7f7f7"
                    android:visibility="gone"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </FrameLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.huami.watch.companion.ui.view.SettingItemView
                        android:clickable="false"
                        app:show_arrow="false"
                        app:show_divider="false"
                        app:title="@string/widget_setting"
                        style="@style/SettingItemStyle"/>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recycler_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="60dp"
                        android:layout_marginEnd="20dp"/>
                    <View
                        android:id="@+id/divider"
                        android:background="#f2f2f2"
                        android:layout_width="match_parent"
                        android:layout_height="0.33dp"
                        android:layout_alignParentBottom="true"
                        android:layout_marginStart="20dp"
                        android:layout_marginEnd="20dp"/>
                    <com.huami.watch.companion.ui.view.SettingItemView
                        android:id="@+id/setting_widget_order"
                        app:title="@string/widget_order_hide"
                        style="@style/SettingItemStyle"/>
                    <com.huami.watch.companion.ui.view.SettingItemView
                        android:id="@+id/setting_sim"
                        app:title="@string/widget_sim"
                        style="@style/SettingItemStyle"/>
                    <com.huami.watch.companion.ui.view.SettingItemView
                        android:id="@+id/setting_screen_unlock"
                        app:title="@string/unlock_screen"
                        style="@style/SettingItemStyle"/>
                    <com.huami.watch.companion.ui.view.SettingItemView
                        android:id="@+id/setting_notification"
                        app:title="@string/notification_setting"
                        style="@style/SettingItemStyle"/>
                    <com.huami.watch.companion.ui.view.SettingItemView
                        android:id="@+id/setting_faq"
                        android:visibility="gone"
                        app:title="@string/help_item_common_problem"
                        style="@style/SettingItemStyle"/>
                    <com.huami.watch.companion.ui.view.SettingItemView
                        android:id="@+id/setting_more"
                        app:title="@string/more_settings"
                        style="@style/SettingItemStyle"/>
                </LinearLayout>
                <View
                    android:layout_gravity="bottom"
                    android:id="@+id/mask_view_bottom"
                    android:background="#77f7f7f7"
                    android:visibility="gone"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="128dp"/>
            </FrameLayout>
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:gravity="center"
                android:id="@+id/setting_main_device"
                android:background="@drawable/watch_common_corner_white_rect"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp"
                android:text="@string/change_main_device"
                android:layout_marginStart="13dp"
                android:layout_marginEnd="13dp"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
