<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/sleep_main_bg"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="15dp"
    android:layout_marginTop="15dp"
    android:layout_marginRight="15dp">
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/tonalityTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:maxWidth="270dp"
        android:text="@string/sleep_tonality_title"
        android:layout_marginStart="15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Rainbow.TextAppearance.Title2"/>
    <ImageView
        android:id="@+id/tonalityQuestion"
        android:padding="3dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/tonalityTitle"
        app:layout_constraintStart_toEndOf="@+id/tonalityTitle"
        app:layout_constraintTop_toTopOf="@+id/tonalityTitle"
        app:srcCompat="@drawable/ic_tips_20"
        app:tint="@color/s3"/>
    <TextView
        android:textColor="@color/s2"
        android:id="@+id/tonalityContinueDays"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tonalityTitle"
        style="@style/Rainbow.TextAppearance.Body5"/>
    <FrameLayout
        android:id="@+id/tonalityRelaxChart"
        android:layout_width="match_parent"
        android:layout_height="95dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@+id/tonalityContinueDays"/>
    <TextView
        android:textColor="@color/s2"
        android:id="@+id/tonalityRelaxStartTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tonalityRelaxChart"
        style="@style/Rainbow.TextAppearance.Body5"/>
    <TextView
        android:textColor="@color/s2"
        android:id="@+id/tonalityRelaxEndTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="54dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tonalityRelaxChart"
        style="@style/Rainbow.TextAppearance.Body5"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/tonalityInfoLinear"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        app:layout_constraintTop_toBottomOf="@+id/tonalityRelaxStartTime">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/tonalityListenLinear"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <com.huami.sleep.view.UnitTextView
                android:textSize="20sp"
                android:textColor="@color/s1"
                android:id="@+id/tonalityListenCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:typeface="lt_bold"
                app:unitColor="@color/s2"
                app:unitSize="12dp"/>
            <TextView
                android:textColor="@color/s2"
                android:gravity="center"
                android:id="@+id/tonalityIntoSleepTimeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/sleep_sky_listen_count"
                style="@style/Rainbow.TextAppearance.Body5"/>
        </LinearLayout>
        <View
            android:id="@+id/tonalityInfoLinearDivide"
            android:background="@color/s4"
            android:visibility="gone"
            android:layout_width="2dp"
            android:layout_height="28dp"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/tonalityPlayLinear"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <com.huami.sleep.view.UnitTextView
                android:textSize="20sp"
                android:textColor="@color/s1"
                android:id="@+id/tonalityPlayCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:typeface="lt_bold"
                app:unitColor="@color/s2"
                app:unitSize="12dp"/>
            <TextView
                android:textColor="@color/s2"
                android:gravity="center"
                android:id="@+id/tonalitySleepCountTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/sleep_sky_play_count"
                style="@style/Rainbow.TextAppearance.Body5"/>
        </LinearLayout>
    </LinearLayout>
    <Space
        android:id="@+id/tonalityNoRatingSpace"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="13dp"
        app:layout_constraintTop_toBottomOf="@+id/tonalityInfoLinear"/>
    <View
        android:id="@+id/tonalityDivide"
        android:background="@color/s4"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        app:layout_constraintTop_toBottomOf="@+id/tonalityInfoLinear"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/tonalityVocation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:text="@string/sleep_sky_vocation"
        android:drawablePadding="2dp"
        android:drawableEnd="@drawable/ic_sleep_arrow_forward_s2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tonalityDivide"
        style="@style/Rainbow.TextAppearance.Body3"/>
    <Space
        android:id="@+id/tonalityBottomSpace"
        android:layout_width="match_parent"
        android:layout_height="13dp"
        app:layout_constraintTop_toBottomOf="@+id/tonalityVocation"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/tonalityVocationGroup"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tonalityVocation,tonalityBottomSpace"/>
    <TextView
        android:textColor="@color/s1"
        android:gravity="center"
        android:id="@+id/tonalityCommentTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/sleep_sky_comment_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tonalityDivide"
        style="@style/Rainbow.TextAppearance.Body3"/>
    <TextView
        android:textColor="@color/s3"
        android:id="@+id/tonalityCommentTips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tonalityCommentTitle"
        style="@style/Rainbow.TextAppearance.Body5"/>
    <per.wsj.library.AndRatingBar
        android:id="@+id/tonalityCommentRatingBar"
        android:layout_width="wrap_content"
        android:layout_height="26dp"
        android:layout_marginTop="8dp"
        android:rating="0"
        android:stepSize="1"
        app:bgDrawable="@drawable/ic_rating_star_s3_half"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tonalityCommentTips"
        app:starColor="@color/s33"
        app:starDrawable="@drawable/ic_rating_star_s33"
        app:starSpacing="14dp"/>
    <Space
        android:id="@+id/tonalityBottomStarSpace"
        android:layout_width="match_parent"
        android:layout_height="15dp"
        app:layout_constraintTop_toBottomOf="@+id/tonalityCommentRatingBar"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/tonalityRatingGroup"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tonalityCommentTitle,tonalityCommentTips,tonalityCommentRatingBar,tonalityBottomStarSpace"/>
</androidx.constraintlayout.widget.ConstraintLayout>
