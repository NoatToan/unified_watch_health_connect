<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:c="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.sleepassistant.lib.widget.circleimageview.HMCircleImageView
        android:id="@+id/load_image"
        android:layout_width="59dp"
        android:layout_height="59dp"
        android:layout_centerHorizontal="true"
        android:contentDescription="@string/app_name"/>
    <com.huami.sleepassistant.lib.widget.CustomRoundProgressBar
        android:id="@+id/sls_item_custom_progress_bar"
        android:layout_width="59dp"
        android:layout_height="59dp"
        android:layout_centerHorizontal="true"
        c:SlsRoundProgressBarProgressBgColor="#4cffffff"
        c:SlsRoundProgressBarProgressBgWidth="2dp"
        c:SlsRoundProgressBarProgressColor="#ff5353"
        c:SlsRoundProgressBarProgressWidth="2dp"
        c:SlsRoundProgressBarTotal="100"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/white100"
        android:id="@+id/sls_tv_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:layout_below="@+id/sls_item_custom_progress_bar"
        android:layout_centerHorizontal="true"/>
    <ImageView
        android:id="@+id/sls_play_music_time_out"
        android:visibility="invisible"
        android:layout_width="12dp"
        android:layout_height="13dp"
        android:layout_marginTop="22dp"
        android:src="@drawable/sls_item_play_icon"
        android:layout_centerHorizontal="true"
        android:contentDescription="@string/app_name"/>
    <com.huami.sleepassistant.lib.widget.ScheduleView
        android:id="@+id/sls_play_music_play"
        android:visibility="invisible"
        android:layout_width="13dp"
        android:layout_height="13dp"
        android:layout_marginTop="22dp"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:id="@+id/sls_down_and_play_bg"
        android:background="@color/sls_back_top"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <TextView
        android:id="@+id/sls_down_load_views"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</RelativeLayout>
