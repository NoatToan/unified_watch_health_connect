<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.watch.companion.ui.view.ActionbarLayout
        android:id="@+id/edit_repeat_actionbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="#ffffff"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/repeat_never"
            android:layout_marginTop="10dp"
            android:onClick="onSelectRepeat"
            style="@style/ItemStyle">
            <TextView
                android:textSize="14sp"
                android:textColor="#333333"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/repeat_never"
                android:layout_centerVertical="true"/>
            <RadioButton
                android:id="@+id/repeat_never_check"
                android:clickable="false"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                style="@style/WatchRadio"/>
        </RelativeLayout>
        <View style="@style/DividerWithMargin"/>
        <RelativeLayout
            android:id="@+id/repeat_every_day"
            android:onClick="onSelectRepeat"
            style="@style/ItemStyle">
            <TextView
                android:textSize="14sp"
                android:textColor="#333333"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/repeat_every_day"
                android:layout_centerVertical="true"/>
            <RadioButton
                android:id="@+id/repeat_every_day_check"
                android:clickable="false"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                style="@style/WatchRadio"/>
        </RelativeLayout>
        <View style="@style/DividerWithMargin"/>
        <RelativeLayout
            android:id="@+id/repeat_every_work_day"
            android:onClick="onSelectRepeat"
            style="@style/ItemStyle">
            <TextView
                android:textSize="14sp"
                android:textColor="#333333"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/repeat_every_workday"
                android:layout_centerVertical="true"/>
            <RadioButton
                android:id="@+id/repeat_every_work_day_check"
                android:clickable="false"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                style="@style/WatchRadio"/>
        </RelativeLayout>
        <View style="@style/DividerWithMargin"/>
        <RelativeLayout
            android:id="@+id/repeat_every_week"
            android:onClick="onSelectRepeat"
            style="@style/ItemStyle">
            <TextView
                android:textSize="14sp"
                android:textColor="#333333"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/repeat_every_week"
                android:layout_centerVertical="true"/>
            <RadioButton
                android:id="@+id/repeat_every_week_check"
                android:clickable="false"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                style="@style/WatchRadio"/>
        </RelativeLayout>
        <View style="@style/DividerWithMargin"/>
        <RelativeLayout
            android:id="@+id/repeat_every_two_week"
            android:onClick="onSelectRepeat"
            style="@style/ItemStyle">
            <TextView
                android:textSize="14sp"
                android:textColor="#333333"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/repeat_every_two_week"
                android:layout_centerVertical="true"/>
            <RadioButton
                android:id="@+id/repeat_every_two_week_check"
                android:clickable="false"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                style="@style/WatchRadio"/>
        </RelativeLayout>
        <View style="@style/DividerWithMargin"/>
        <RelativeLayout
            android:id="@+id/repeat_every_month"
            android:onClick="onSelectRepeat"
            style="@style/ItemStyle">
            <TextView
                android:textSize="14sp"
                android:textColor="#333333"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/repeat_every_month"
                android:layout_centerVertical="true"/>
            <RadioButton
                android:id="@+id/repeat_every_month_check"
                android:clickable="false"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                style="@style/WatchRadio"/>
        </RelativeLayout>
        <View style="@style/DividerWithMargin"/>
        <RelativeLayout
            android:id="@+id/repeat_every_year"
            android:onClick="onSelectRepeat"
            style="@style/ItemStyle">
            <TextView
                android:textSize="14sp"
                android:textColor="#333333"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/repeat_every_year"
                android:layout_centerVertical="true"/>
            <RadioButton
                android:id="@+id/repeat_every_year_check"
                android:clickable="false"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                style="@style/WatchRadio"/>
        </RelativeLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="#ffffff"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">
        <RelativeLayout
            android:onClick="onSelectRepeat"
            style="@style/ItemStyle">
            <TextView
                android:textSize="14sp"
                android:textColor="#333333"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/repeat_custom"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#80000000"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginEnd="12dp"
                android:layout_toStartOf="@+id/repeat_custom_arrow"/>
            <ImageView
                android:id="@+id/repeat_custom_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_arrow_right_small"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <View style="@style/DividerWithMargin"/>
    </LinearLayout>
</LinearLayout>
