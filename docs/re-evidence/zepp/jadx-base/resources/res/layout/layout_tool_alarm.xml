<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/play_title_size"
        android:textColor="@color/play_title_color"
        android:gravity="center_vertical"
        android:id="@+id/tool_alarm"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/play_margin_15dp"
        android:text="@string/small_tool_item_alarm"
        android:drawablePadding="6dp"
        android:drawableStart="@drawable/play_icon_alarm_clock"
        android:layout_marginStart="@dimen/play_margin_15dp"
        app:layout_constraintEnd_toStartOf="@+id/tool_alarm_add"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/play_min_sub_title_size"
        android:textColor="@color/play_sub_title_color"
        android:gravity="start"
        android:id="@+id/tool_alarm_sub_title"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_4dp"
        android:layout_marginBottom="@dimen/size_15dp"
        android:text="@string/play_tool_alarm_subtitle"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="@dimen/size_15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="@+id/tool_alarm"
        app:layout_constraintTop_toBottomOf="@+id/tool_alarm"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tool_alarm_add"
        android:background="@drawable/shape_tool_friends"
        android:layout_width="56dp"
        android:layout_height="34dp"
        android:layout_marginEnd="@dimen/play_margin_15dp"
        app:layout_constraintBottom_toBottomOf="@+id/tool_alarm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tool_alarm"
        app:layout_constraintTop_toTopOf="@+id/tool_alarm"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/tool_alarm_add_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_tool_friends_add_24"
        app:layout_constraintBottom_toBottomOf="@+id/tool_alarm_add"
        app:layout_constraintEnd_toEndOf="@+id/tool_alarm_add"
        app:layout_constraintStart_toStartOf="@+id/tool_alarm_add"
        app:layout_constraintTop_toTopOf="@+id/tool_alarm_add"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/play_sub_title_size"
        android:textColor="#b2b2b2"
        android:gravity="center"
        android:id="@+id/tool_no_alarm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_24dp"
        android:layout_marginBottom="@dimen/size_24dp"
        android:text="@string/play_tool_no_alarm"
        android:drawablePadding="8dp"
        android:drawableStart="@drawable/ic_tool_no_content"
        android:layout_marginStart="@dimen/play_margin_15dp"
        android:layout_marginEnd="@dimen/play_margin_15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tool_alarm"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/play_sub_title_size"
        android:textColor="@color/play_sub_title_color"
        android:gravity="center"
        android:id="@+id/tool_alarm_not_active"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_24dp"
        android:layout_marginBottom="@dimen/size_24dp"
        android:text="@string/play_device_not_active"
        android:layout_marginStart="@dimen/play_margin_15dp"
        android:layout_marginEnd="@dimen/play_margin_15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tool_alarm"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/tool_alarm_recycler"
        android:paddingBottom="5dp"
        android:visibility="gone"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        app:layout_constraintTop_toBottomOf="@+id/tool_alarm"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tool_alarm_more"
        android:background="@drawable/bg_item"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tool_alarm_recycler">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/play_sub_title_size"
            android:textColor="@color/play_sub_title_color"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/play_tool_view_all"
            android:drawableEnd="@drawable/ic_tool_right_24"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
