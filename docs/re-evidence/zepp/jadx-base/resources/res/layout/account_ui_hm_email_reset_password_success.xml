<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/account_ui_trans"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/account_ui_dialog_empty_area"/>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@color/s39"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="31dp">
            <TextView
                android:textSize="@dimen/account_ui_main_ui_dialog_title_size"
                android:textColor="@color/s1"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="@string/account_ui_login_email_forget_password_email_send_content"/>
            <TextView
                android:textSize="@dimen/account_ui_info_content_size"
                android:textColor="@color/s2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/account_ui_login_email_forget_password_email_send_to"
                android:layout_marginStart="40dp"/>
            <TextView
                android:textSize="@dimen/account_ui_info_content_size"
                android:textColor="@color/s14"
                android:id="@+id/hm_email_send_to"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="40dp"/>
            <TextView
                android:textSize="@dimen/account_ui_info_content_size"
                android:textColor="@color/s2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/account_ui_login_email_forget_password_reset"
                android:layout_marginStart="40dp"/>
        </LinearLayout>
        <View
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <LinearLayout
            android:orientation="horizontal"
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="@dimen/account_ui_item_height_max">
            <TextView
                android:textSize="@dimen/account_ui_person_info_setting_text_size"
                android:textColor="@color/s1"
                android:gravity="center"
                android:id="@+id/hm_email_known"
                android:background="@color/s4"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/account_ui_i_know"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
