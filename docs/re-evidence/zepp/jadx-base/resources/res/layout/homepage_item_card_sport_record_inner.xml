<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/sport_icon"
        android:layout_width="30dp"
        android:layout_height="30dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/s1"
        android:ellipsize="end"
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lines="1"
        android:layout_marginStart="10dp"
        app:layout_constraintStart_toEndOf="@+id/sport_icon"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/distance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        app:layout_constraintStart_toEndOf="@+id/name"
        app:layout_constraintTop_toTopOf="@+id/name"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/s2"
        android:gravity="center_vertical"
        android:id="@+id/sport_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:drawablePadding="2dp"
        android:drawableStart="@drawable/ic_time_14_s2"
        android:fontFamily="@font/maisonneue"
        android:layout_marginStart="10dp"
        app:layout_constraintStart_toEndOf="@+id/sport_icon"
        app:layout_constraintTop_toBottomOf="@+id/name"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <TextView
        android:textColor="@color/s2"
        android:gravity="center_vertical"
        android:id="@+id/sub_data"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawablePadding="2dp"
        android:fontFamily="@font/maisonneue"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/sport_duration"
        app:layout_constraintStart_toEndOf="@+id/sport_duration"
        app:layout_constraintTop_toTopOf="@+id/sport_duration"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <TextView
        android:textColor="@color/s2"
        android:id="@+id/time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/maisonneue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Rainbow.TextAppearance.Body5"/>
</androidx.constraintlayout.widget.ConstraintLayout>
