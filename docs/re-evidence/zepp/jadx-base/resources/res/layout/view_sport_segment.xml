<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/running_detail_shape_rect_white_corner_6"
    android:paddingBottom="30dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="10dp"
    android:layout_marginEnd="10dp">
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        app:tabIndicatorColor="@color/p3"
        app:tabIndicatorFullWidth="false"
        app:tabMode="fixed"
        app:tabSelectedTextColor="@color/p3"
        app:tabTextAppearance="@style/Rainbow.TextAppearance.Body3"
        app:tabTextColor="@color/s1"/>
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/edit_segment"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="15dp"
        android:src="@drawable/ic_edit_20"
        android:layout_marginEnd="15dp"
        app:tint="@color/s1"/>
    <com.huami.moving.ui.view.NestViewPager
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"/>
</FrameLayout>
