<?xml version="1.0" encoding="utf-8"?>
<com.huami.watch.companion.battery.BatteryInfoView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/battery_info_root_layout"
    android:layout_width="wrap_content"
    android:layout_height="64dp">
    <ImageView
        android:id="@+id/battery_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_title_icon_power_none"
        android:layout_centerVertical="true"
        android:layout_marginStart="20dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/battery_info_area"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="16dp"
        android:layout_toEndOf="@+id/battery_icon">
        <TextView
            android:id="@+id/available_battery_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/battery_available"
            style="@style/BatteryInfo"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#80000000"
            android:id="@+id/last_charging_days_counter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3.67dp"
            android:text="@string/battery_charging_since_last_charge"/>
    </LinearLayout>
    <TextView
        android:id="@+id/battery_info_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/battery_info_loading"
        android:layout_centerVertical="true"
        android:layout_marginStart="16dp"
        android:layout_toEndOf="@+id/battery_icon"
        style="@style/BatteryInfo"/>
    <View
        android:background="#f2f2f2"
        android:layout_width="match_parent"
        android:layout_height="0.3dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
</com.huami.watch.companion.battery.BatteryInfoView>
