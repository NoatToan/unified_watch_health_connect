<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/one_foot_waiting_measuring_bg_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <RelativeLayout
            android:layout_gravity="center"
            android:id="@+id/device_bind_rl"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="20sp"
                android:gravity="center"
                android:id="@+id/title_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/one_foot_stand_one_weight"
                android:layout_centerHorizontal="true"
                style="@style/oneFootWaitingTitleStyle"/>
            <TextView
                android:textSize="14sp"
                android:id="@+id/sub_title_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="@string/close_eye_and_stand_center"
                android:layout_below="@+id/title_tv"
                android:layout_centerHorizontal="true"
                android:layout_marginStart="47dp"
                android:layout_marginEnd="47dp"
                style="@style/oneFootWaitingTipStyle"/>
            <ImageView
                android:id="@+id/device_img"
                android:layout_width="144dp"
                android:layout_height="210dp"
                android:layout_marginTop="31dp"
                android:src="@drawable/img_bodyfat_one_foot"
                android:layout_below="@+id/sub_title_tv"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="14sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="14dp"
                android:text="@string/one_foot_warning"
                android:layout_below="@+id/device_img"
                android:layout_marginStart="47dp"
                android:layout_marginEnd="47dp"
                style="@style/oneFootWaitingTipStyle"/>
        </RelativeLayout>
    </androidx.core.widget.NestedScrollView>
    <TextView
        android:textSize="14sp"
        android:gravity="center"
        android:id="@+id/btn_cancel_one_foot_measure"
        android:padding="@dimen/bottom_button_padding"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="8dp"
        android:text="@string/cancel"
        app:layout_constraintBottom_toBottomOf="parent"
        style="@style/oneFootWaitingBottomCanCenButtonStyle"/>
</LinearLayout>
