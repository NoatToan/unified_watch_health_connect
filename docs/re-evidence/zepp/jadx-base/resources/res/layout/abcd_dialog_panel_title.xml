<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:layout_gravity="center"
        android:id="@+id/dialog_title"
        android:paddingTop="@dimen/size_20dp"
        android:paddingBottom="@dimen/size_20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/size_30dp"
        android:paddingEnd="@dimen/size_30dp"
        style="@style/DialogTitleStyle"/>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/header_dividing_line"
        android:background="@color/s4"
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider"/>
</FrameLayout>
