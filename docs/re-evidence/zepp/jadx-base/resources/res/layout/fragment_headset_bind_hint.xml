<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:background="@drawable/shape_bind_headset_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/size_18sp"
            android:textColor="@color/s1"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/size_14sp"
            android:textColor="@color/s2"
            android:id="@+id/msg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_8dp"
            android:layout_marginStart="@dimen/size_10dp"
            android:layout_marginEnd="@dimen/size_10dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title"/>
        <FrameLayout
            android:id="@+id/frame_headset_img"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/size_15dp"
            android:layout_marginBottom="@dimen/size_82dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="h,1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/msg"
            app:layout_constraintWidth_percent="0.46">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:id="@+id/headset_img"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerInside"/>
        </FrameLayout>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottie_btn"
            android:layout_width="@dimen/size_40dp"
            android:layout_height="@dimen/size_40dp"
            android:layout_marginBottom="@dimen/td_size_31dp"
            android:scaleType="centerCrop"
            android:layout_marginStart="1.8dp"
            app:layout_constraintBottom_toBottomOf="@+id/frame_headset_img"
            app:layout_constraintEnd_toEndOf="@+id/frame_headset_img"
            app:layout_constraintStart_toStartOf="@+id/frame_headset_img"
            app:lottie_autoPlay="false"
            app:lottie_fileName="anim_mozart_tap_box_btn.json"
            app:lottie_loop="true"/>
        <Button
            android:textSize="16sp"
            android:textColor="@color/s3"
            android:id="@+id/negative_btn"
            android:layout_width="0dp"
            android:layout_height="@dimen/size_62dp"
            android:text="@string/headset_bind_btn_text_no_light"
            android:backgroundTint="@color/s2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/positive_btn"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintStart_toStartOf="parent"
            style="?android:attr/borderlessButtonStyle"/>
        <Button
            android:textSize="16sp"
            android:textColor="@color/s1"
            android:id="@+id/positive_btn"
            android:layout_width="0dp"
            android:layout_height="@dimen/size_62dp"
            android:text="@string/headset_bind_btn_text_yes"
            android:backgroundTint="@color/s2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/negative_btn"
            style="?android:attr/borderlessButtonStyle"/>
        <Button
            android:textSize="16sp"
            android:textColor="@color/s1"
            android:gravity="center"
            android:id="@+id/done"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_62dp"
            android:layout_marginTop="@dimen/size_16dp"
            android:text="@string/complete"
            android:paddingStart="@dimen/size_20dp"
            android:paddingEnd="@dimen/size_20dp"
            android:backgroundTint="@color/s2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="?android:attr/borderlessButtonStyle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
