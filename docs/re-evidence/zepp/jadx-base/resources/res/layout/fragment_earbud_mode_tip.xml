<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/line_start"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.05"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/line_end"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.95"/>
    <HorizontalScrollView
        android:scrollbars="none"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/line_end"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/line_start">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <RelativeLayout
                android:id="@+id/rest_card"
                android:background="@drawable/bg_rest_small"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="30dp"
                app:layout_constraintDimensionRatio="W,2:3"
                app:layout_constraintStart_toStartOf="parent">
                <TextView
                    android:textSize="22sp"
                    android:textColor="#ffffffff"
                    android:id="@+id/xiaoqi_card_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/earbud_rest"
                    android:layout_marginStart="20dp"/>
                <View
                    android:id="@+id/xiaoqi_card_spilt"
                    android:background="#ffffffff"
                    android:layout_width="17dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="4dp"
                    android:layout_below="@+id/xiaoqi_card_title"
                    android:layout_marginStart="20dp"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textColor="#ffffffff"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="10dp"
                    android:text="@string/earbud_rest_tip"
                    android:layout_above="@+id/start_rest"
                    android:layout_below="@+id/xiaoqi_card_spilt"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    app:autoSizeMaxTextSize="14sp"
                    app:autoSizeMinTextSize="8sp"
                    app:autoSizeStepGranularity="1sp"
                    app:autoSizeTextType="uniform"/>
                <ImageView
                    android:id="@+id/start_rest"
                    android:padding="20dp"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/icon_earbud_mode_start"
                    android:scaleType="centerInside"
                    android:layout_alignParentBottom="true"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:background="@drawable/bg_tomato_small"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="30dp"
                android:layout_marginEnd="30dp"
                app:layout_constraintDimensionRatio="W,2:3"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/rest_card">
                <TextView
                    android:textSize="22sp"
                    android:textColor="#ffffffff"
                    android:id="@+id/tomato_card_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/earbud_tomato"
                    android:layout_marginStart="20dp"/>
                <View
                    android:id="@+id/tomato_card_spilt"
                    android:background="#ffffffff"
                    android:layout_width="17dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="4dp"
                    android:layout_below="@+id/tomato_card_title"
                    android:layout_marginStart="20dp"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textColor="#ffffffff"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="10dp"
                    android:text="@string/earbud_tomato_tip"
                    android:layout_above="@+id/start_tomato"
                    android:layout_below="@+id/tomato_card_spilt"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    app:autoSizeMaxTextSize="14sp"
                    app:autoSizeMinTextSize="8sp"
                    app:autoSizeStepGranularity="1sp"
                    app:autoSizeTextType="uniform"/>
                <ImageView
                    android:id="@+id/start_tomato"
                    android:padding="20dp"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/icon_earbud_mode_start"
                    android:scaleType="centerInside"
                    android:layout_alignParentBottom="true"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </HorizontalScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
