<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s10"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/bg_rect_white_corner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="15dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/s1"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/text_title"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:text="@string/scale_select_member_tip_title"/>
        <View
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/s1"
            android:layout_gravity="center_horizontal"
            android:id="@+id/text_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/scale_select_member_tip_desc"/>
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/iv_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"/>
        <View
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="10dp"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/s1"
            android:gravity="center"
            android:id="@+id/text_close"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="@string/close"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
