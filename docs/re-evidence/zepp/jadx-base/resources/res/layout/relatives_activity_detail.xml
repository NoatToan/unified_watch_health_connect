<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:huami="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mine_hmscrollview"
    android:fitsSystemWindows="true"
    android:scrollbars="none"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.xiaomi.hm.health.relation.copy.HMScrollView
        android:id="@+id/scroll_view"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:background="@color/s38"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.xiaomi.hm.health.relation.copy.HMExpandHeadView
                    android:orientation="vertical"
                    android:id="@+id/header_view"
                    android:background="@color/s38"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/relatives_size_194dp">
                    <com.xiaomi.hm.health.relation.copy.RelativesHMCircleImageView
                        android:id="@+id/detail_icon"
                        android:layout_width="@dimen/relatives_size_90dp"
                        android:layout_height="@dimen/relatives_size_90dp"
                        android:layout_marginTop="@dimen/relatives_size_19dp"
                        android:src="@drawable/relatives_setting_avatar_default"
                        android:layout_centerHorizontal="true"
                        huami:relatives_civ_border_color="@color/relatives_white_60"
                        huami:relatives_civ_border_width="1.3dp"
                        huami:relatives_civ_fill_color="@color/relatives_white60"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/relatives_size_33dp"
                        android:layout_below="@+id/detail_icon">
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">
                            <com.huami.widget.typeface.TypefaceTextView
                                android:textSize="24sp"
                                android:textColor="@color/s1"
                                android:gravity="center_horizontal"
                                android:id="@+id/step"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:lineSpacingExtra="-3sp"
                                android:fontFamily="km"/>
                            <TextView
                                android:textSize="12sp"
                                android:textColor="@color/s2"
                                android:gravity="center_horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/relatives_size_4dp"
                                android:text="@string/relatives_label_activity"
                                android:lineSpacingExtra="3sp"/>
                        </LinearLayout>
                        <View
                            android:background="@color/s4"
                            android:layout_width="@dimen/relatives_divider"
                            android:layout_height="match_parent"
                            android:layout_marginTop="@dimen/relatives_size_5dp"
                            android:layout_marginBottom="@dimen/relatives_size_5dp"/>
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">
                            <com.xiaomi.hm.health.relation.copy.UnitTextView
                                android:textSize="24sp"
                                android:textColor="@color/s1"
                                android:id="@+id/sleep"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                huami:relatives_typeface="km"
                                huami:relatives_unitColor="@color/s2"
                                huami:relatives_unitSize="9sp"/>
                            <TextView
                                android:textSize="12sp"
                                android:textColor="@color/s2"
                                android:gravity="center_horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/relatives_size_4dp"
                                android:text="@string/relatives_label_sleep"
                                android:lineSpacingExtra="3sp"/>
                        </LinearLayout>
                        <View
                            android:background="@color/s4"
                            android:layout_width="@dimen/relatives_divider"
                            android:layout_height="match_parent"
                            android:layout_marginTop="@dimen/relatives_size_5dp"
                            android:layout_marginBottom="@dimen/relatives_size_5dp"/>
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">
                            <com.huami.widget.typeface.TypefaceTextView
                                android:textSize="24sp"
                                android:textColor="@color/s1"
                                android:gravity="center_horizontal"
                                android:id="@+id/weight"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:lineSpacingExtra="-3sp"
                                android:fontFamily="km"/>
                            <TextView
                                android:textSize="12sp"
                                android:textColor="@color/s2"
                                android:gravity="center_horizontal"
                                android:id="@+id/weight_title"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/relatives_size_4dp"
                                android:text="@string/relatives_label_weight"
                                android:lineSpacingExtra="3sp"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.xiaomi.hm.health.relation.copy.HMExpandHeadView>
                <View
                    android:background="@color/s10"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/relatives_size_10dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@color/s38"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/relatives_size_60dp"
                        android:layout_marginTop="@dimen/relatives_size_8dp">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/step_icon"
                            android:src="@drawable/relatives_icon_friend_step"
                            style="@style/RelativesFriendDetailIcon"/>
                        <TextView
                            android:textSize="15sp"
                            android:textColor="@color/s1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/relatives_size_11dp"
                            android:text="@string/relatives_label_activity"
                            android:layout_marginStart="@dimen/relatives_size_11dp"
                            android:layout_toEndOf="@+id/step_icon"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/s2"
                            android:id="@+id/activity_date"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/relatives_size_11dp"
                            android:text="@string/relatives_date_today"
                            android:layout_alignParentBottom="true"
                            android:textDirection="locale"
                            android:layout_marginStart="@dimen/relatives_size_11dp"
                            android:layout_toEndOf="@+id/step_icon"/>
                    </RelativeLayout>
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <FrameLayout
                            android:id="@+id/step_chart_container"
                            android:background="@color/s38"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/relatives_size_118dp"/>
                        <View
                            android:layout_gravity="bottom"
                            android:background="@color/s4"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/relatives_size_1dp"
                            android:layout_marginBottom="@dimen/relatives_size_21dp"/>
                        <View
                            android:layout_gravity="bottom"
                            android:background="@color/s4"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/relatives_size_1dp"/>
                    </FrameLayout>
                    <LinearLayout
                        android:gravity="center"
                        android:paddingTop="@dimen/relatives_size_10dp"
                        android:paddingBottom="@dimen/relatives_size_10dp"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/relatives_size_79dp">
                        <LinearLayout
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">
                            <com.huami.widget.typeface.TypefaceTextView
                                android:textSize="24sp"
                                android:textColor="@color/s1"
                                android:id="@+id/day_step"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/relatives_data_zero"
                                android:fontFamily="km"/>
                            <TextView
                                android:textSize="12sp"
                                android:textColor="@color/s2"
                                android:gravity="center_horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/relatives_size_4dp"
                                android:text="@string/relatives_label_step"/>
                        </LinearLayout>
                        <View
                            android:background="@color/s4"
                            android:layout_width="@dimen/relatives_divider"
                            android:layout_height="match_parent"
                            android:layout_marginTop="@dimen/relatives_size_5dp"
                            android:layout_marginBottom="@dimen/relatives_size_5dp"/>
                        <LinearLayout
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">
                            <com.huami.widget.typeface.TypefaceTextView
                                android:textSize="24sp"
                                android:textColor="@color/s1"
                                android:id="@+id/day_mileage"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/relatives_data_zero"
                                android:fontFamily="km"/>
                            <TextView
                                android:textSize="12sp"
                                android:textColor="@color/s2"
                                android:gravity="center_horizontal"
                                android:id="@+id/distance_title"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/relatives_size_4dp"
                                android:text="@string/relatives_label_mileage"/>
                        </LinearLayout>
                        <View
                            android:background="@color/s4"
                            android:layout_width="@dimen/relatives_divider"
                            android:layout_height="match_parent"
                            android:layout_marginTop="@dimen/relatives_size_5dp"
                            android:layout_marginBottom="@dimen/relatives_size_5dp"/>
                        <LinearLayout
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">
                            <com.huami.widget.typeface.TypefaceTextView
                                android:textSize="24sp"
                                android:textColor="@color/s1"
                                android:id="@+id/day_heat"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/relatives_data_zero"
                                android:fontFamily="km"/>
                            <TextView
                                android:textSize="12sp"
                                android:textColor="@color/s2"
                                android:gravity="center_horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/relatives_size_4dp"
                                android:text="@string/relatives_label_calorie"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <View
                    android:background="@color/s10"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/relatives_size_10dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@color/s38"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/relatives_size_60dp"
                        android:layout_marginTop="@dimen/relatives_size_8dp">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/sleep_icon"
                            android:src="@drawable/relatives_icon_friend_sleep"
                            style="@style/RelativesFriendDetailIcon"/>
                        <TextView
                            android:textSize="15sp"
                            android:textColor="@color/s1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/relatives_size_11dp"
                            android:text="@string/relatives_sleep_title"
                            android:layout_marginStart="@dimen/relatives_size_11dp"
                            android:layout_toEndOf="@+id/sleep_icon"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/s2"
                            android:id="@+id/sleep_date"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/relatives_size_11dp"
                            android:layout_alignParentBottom="true"
                            android:textDirection="locale"
                            android:layout_marginStart="@dimen/relatives_size_11dp"
                            android:layout_toEndOf="@+id/sleep_icon"/>
                    </RelativeLayout>
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <FrameLayout
                            android:id="@+id/sleep_chart_container"
                            android:background="@color/s38"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/relatives_size_118dp"/>
                        <View
                            android:layout_gravity="bottom"
                            android:background="@color/s4"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/relatives_size_1dp"
                            android:layout_marginBottom="@dimen/relatives_size_21dp"/>
                        <View
                            android:layout_gravity="bottom"
                            android:background="@color/s4"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/relatives_size_1dp"/>
                    </FrameLayout>
                    <LinearLayout
                        android:gravity="center"
                        android:paddingTop="@dimen/relatives_size_10dp"
                        android:paddingBottom="@dimen/relatives_size_10dp"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/relatives_size_79dp">
                        <LinearLayout
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">
                            <com.huami.widget.typeface.TypefaceTextView
                                android:textSize="24sp"
                                android:textColor="@color/s1"
                                android:id="@+id/day_sleep_start"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/relatives_data_zero"
                                android:fontFamily="km"/>
                            <TextView
                                android:textSize="12sp"
                                android:textColor="@color/s2"
                                android:gravity="center_horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/relatives_size_4dp"
                                android:text="@string/relatives_label_sleep_start_time"/>
                        </LinearLayout>
                        <View
                            android:background="@color/s4"
                            android:layout_width="@dimen/relatives_divider"
                            android:layout_height="match_parent"
                            android:layout_marginTop="@dimen/relatives_size_5dp"
                            android:layout_marginBottom="@dimen/relatives_size_5dp"/>
                        <LinearLayout
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">
                            <com.xiaomi.hm.health.relation.copy.UnitTextView
                                android:textSize="24sp"
                                android:textColor="@color/s1"
                                android:id="@+id/day_sleep"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                huami:relatives_typeface="km"
                                huami:relatives_unitColor="@color/s2"
                                huami:relatives_unitSize="9sp"/>
                            <TextView
                                android:textSize="12sp"
                                android:textColor="@color/s2"
                                android:gravity="center_horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/relatives_size_4dp"
                                android:text="@string/relatives_stat_sleep"/>
                        </LinearLayout>
                        <View
                            android:background="@color/s4"
                            android:layout_width="@dimen/relatives_divider"
                            android:layout_height="match_parent"
                            android:layout_marginTop="@dimen/relatives_size_5dp"
                            android:layout_marginBottom="@dimen/relatives_size_5dp"/>
                        <LinearLayout
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">
                            <com.huami.widget.typeface.TypefaceTextView
                                android:textSize="24sp"
                                android:textColor="@color/s1"
                                android:id="@+id/get_up_time"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/relatives_data_zero"
                                android:fontFamily="km"/>
                            <TextView
                                android:textSize="12sp"
                                android:textColor="@color/s2"
                                android:gravity="center_horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/relatives_size_4dp"
                                android:text="@string/relatives_label_get_up_time"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <View
                    android:background="@color/s10"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/relatives_detail_dividing_line"/>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/relatives_font_size_f3"
                android:textColor="@color/s5"
                android:gravity="center"
                android:layout_gravity="top"
                android:id="@+id/toast_view"
                android:background="@color/relatives_color_aa2086b4"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/relatives_size_36dp"
                android:text="@string/relatives_label_message_too_busy"/>
        </FrameLayout>
    </com.xiaomi.hm.health.relation.copy.HMScrollView>
    <com.xiaomi.hm.health.relation.view.CareButton
        android:gravity="center"
        android:layout_gravity="end|bottom"
        android:id="@+id/care_button"
        android:background="@drawable/relatives_btn_red_bg"
        android:visibility="visible"
        android:layout_width="@dimen/relatives_size_56dp"
        android:layout_height="@dimen/relatives_size_56dp"
        android:layout_marginBottom="@dimen/relatives_size_210dp"
        android:text="@string/relatives_button_send_care"
        android:layout_marginEnd="@dimen/relatives_size_16dp"/>
</FrameLayout>
