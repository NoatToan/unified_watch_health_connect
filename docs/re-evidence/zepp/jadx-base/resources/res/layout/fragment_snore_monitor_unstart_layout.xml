<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/back"
        android:paddingLeft="@dimen/snore_common_page_padding"
        android:paddingTop="20dp"
        android:paddingRight="@dimen/snore_common_page_padding"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/arrow_back"/>
    <ImageView
        android:id="@+id/report"
        android:paddingTop="20dp"
        android:paddingRight="@dimen/snore_common_page_padding"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/snore_report_icon"
        android:layout_alignParentRight="true"/>
    <TextView
        android:textSize="30sp"
        android:textColor="@color/s27"
        android:gravity="center"
        android:id="@+id/text1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="88dp"
        android:text="@string/snore_dream_talk_monitor"
        android:layout_below="@+id/back"
        android:layout_centerHorizontal="true"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/s27"
        android:gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="@string/snore_dream_monitor_top_tip"
        android:layout_below="@+id/text1"
        android:layout_centerHorizontal="true"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"/>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/snore_zzz_icon"
        android:layout_centerInParent="true"/>
    <TextView
        android:textSize="@dimen/snore_common_text_size"
        android:textColor="@color/s5"
        android:id="@+id/stop"
        android:padding="@dimen/snore_common_page_padding"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="93dp"
        android:text="@string/snore_cancel"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="@dimen/snore_common_text_size"
        android:textColor="@color/s5"
        android:gravity="center"
        android:id="@+id/start"
        android:background="@drawable/start_btn_bg"
        android:layout_marginBottom="36dp"
        android:text="@string/snore_start_monitor"
        android:layout_above="@+id/stop"
        android:layout_centerHorizontal="true"
        style="@style/activitySnoreMonitorButtonStyle"/>
</RelativeLayout>
