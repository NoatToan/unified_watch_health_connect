<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s38"
    android:paddingTop="@dimen/size_8dp"
    android:paddingBottom="@dimen/size_8dp"
    android:layout_width="match_parent"
    android:layout_height="@dimen/size_76dp"
    android:paddingStart="@dimen/size_10dp"
    android:paddingEnd="@dimen/size_10dp">
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/world_clock_time_hourMinute"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/size_16dp"
        app:layout_constraintBottom_toTopOf="@+id/world_clock_mouthDay"
        app:layout_constraintEnd_toStartOf="@+id/drag_button"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_goneMarginEnd="@dimen/size_16dp"
        style="@style/Rainbow.TextAppearance.Title1"/>
    <TextView
        android:textSize="@dimen/size_14sp"
        android:textColor="@color/s3"
        android:id="@+id/world_clock_mouthDay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/world_clock_time_hourMinute"
        app:layout_constraintTop_toBottomOf="@+id/world_clock_time_hourMinute"/>
    <ImageButton
        android:id="@+id/drag_button"
        android:background="@android:color/transparent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_world_clock_move"
        android:tint="@color/s3"
        android:layout_marginEnd="@dimen/size_16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageButton
        android:id="@+id/world_clock_delete"
        android:background="@android:color/transparent"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_world_clock_delete"
        android:layout_marginStart="@dimen/size_16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/world_clock_city"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_16dp"
        app:layout_constraintBottom_toTopOf="@+id/jet_lag"
        app:layout_constraintStart_toEndOf="@+id/world_clock_delete"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintVertical_weight="1"
        app:layout_goneMarginStart="@dimen/size_16dp"
        style="@style/Rainbow.TextAppearance.Title1"/>
    <TextView
        android:textSize="@dimen/size_14sp"
        android:textColor="@color/s3"
        android:id="@+id/jet_lag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/world_clock_city"
        app:layout_constraintTop_toBottomOf="@+id/world_clock_city"
        app:layout_constraintVertical_chainStyle="spread"/>
</androidx.constraintlayout.widget.ConstraintLayout>
