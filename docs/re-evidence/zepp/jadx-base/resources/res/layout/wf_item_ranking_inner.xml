<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="5dp">
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/wf_text_light_white"
        android:gravity="end"
        android:id="@+id/tv_rank_num"
        android:layout_width="30dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_rank_img_shadow"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/wf_watch_face_circle_shadow"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_rank_num"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_rank_img"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="@+id/iv_rank_img_shadow"
        app:layout_constraintEnd_toEndOf="@+id/iv_rank_img_shadow"
        app:layout_constraintStart_toStartOf="@+id/iv_rank_img_shadow"
        app:layout_constraintTop_toTopOf="@+id/iv_rank_img_shadow"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/wf_text_light_white"
        android:gravity="start"
        android:id="@+id/tv_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:includeFontPadding="false"
        android:textDirection="locale"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toStartOf="@+id/sync_apply_btn"
        app:layout_constraintStart_toEndOf="@+id/iv_rank_img"
        app:layout_constraintTop_toTopOf="@+id/sync_apply_btn"/>
    <RatingBar
        android:id="@+id/rating_bar"
        android:layout_marginTop="5dp"
        app:layout_constraintStart_toStartOf="@+id/tv_name"
        app:layout_constraintTop_toBottomOf="@+id/tv_name"
        app:layout_goneMarginTop="5dp"
        style="@style/WFRatingBar"/>
    <TextView
        android:textSize="@dimen/dimen_detail_btn_size"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/sync_apply_btn"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:text="@string/wf_detail_watch_face"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginEnd="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
