<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="@color/s1"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="63dp"
        android:text="@string/select_schedule_repeat"
        style="@style/Rainbow.TextAppearance.Title2"/>
    <RelativeLayout
        android:id="@+id/repeat_once"
        android:background="?android:attr/selectableItemBackground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="50dp">
        <TextView
            android:textColor="@color/s1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/repeat_once"
            android:layout_centerVertical="true"
            android:layout_marginStart="45dp"
            style="@style/Rainbow.TextAppearance.Number7"/>
        <ImageView
            android:id="@+id/repeat_never_check"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/device_setting_sound_strength_selected"
            android:layout_centerVertical="true"
            android:layout_marginStart="15dp"/>
    </RelativeLayout>
    <View style="@style/DividerWithMargin"/>
    <RelativeLayout
        android:id="@+id/repeat_every_day"
        android:background="?android:attr/selectableItemBackground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="50dp">
        <TextView
            android:textColor="@color/s1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/repeat_every_day"
            android:layout_centerVertical="true"
            android:layout_marginStart="45dp"
            style="@style/Rainbow.TextAppearance.Number7"/>
        <ImageView
            android:id="@+id/repeat_every_day_check"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/device_setting_sound_strength_selected"
            android:layout_centerVertical="true"
            android:layout_marginStart="15dp"/>
    </RelativeLayout>
    <View style="@style/DividerWithMargin"/>
    <RelativeLayout
        android:id="@+id/repeat_every_work_day"
        android:background="?android:attr/selectableItemBackground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="50dp">
        <TextView
            android:textColor="@color/s1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/repeat_every_workday"
            android:layout_centerVertical="true"
            android:layout_marginStart="45dp"
            style="@style/Rainbow.TextAppearance.Number7"/>
        <ImageView
            android:id="@+id/repeat_every_work_day_check"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/device_setting_sound_strength_selected"
            android:layout_centerVertical="true"
            android:layout_marginStart="15dp"/>
    </RelativeLayout>
    <View style="@style/DividerWithMargin"/>
    <RelativeLayout
        android:id="@+id/repeat_every_weekend"
        android:background="?android:attr/selectableItemBackground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="50dp">
        <TextView
            android:textColor="@color/s1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/repeat_every_weekend"
            android:layout_centerVertical="true"
            android:layout_marginStart="45dp"
            style="@style/Rainbow.TextAppearance.Number7"/>
        <ImageView
            android:id="@+id/repeat_every_weekend_check"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/device_setting_sound_strength_selected"
            android:layout_centerVertical="true"
            android:layout_marginStart="15dp"/>
    </RelativeLayout>
    <View style="@style/DividerWithMargin"/>
    <RelativeLayout
        android:id="@+id/repeat_every_week"
        android:background="?android:attr/selectableItemBackground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="50dp">
        <TextView
            android:textColor="@color/s1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/repeat_every_week"
            android:layout_centerVertical="true"
            android:layout_marginStart="45dp"
            style="@style/Rainbow.TextAppearance.Number7"/>
        <ImageView
            android:id="@+id/repeat_every_week_check"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/device_setting_sound_strength_selected"
            android:layout_centerVertical="true"
            android:layout_marginStart="15dp"/>
    </RelativeLayout>
    <View style="@style/DividerWithMargin"/>
    <RelativeLayout
        android:id="@+id/repeat_every_two_week"
        android:background="?android:attr/selectableItemBackground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="50dp">
        <TextView
            android:textColor="@color/s1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/repeat_every_two_week"
            android:layout_centerVertical="true"
            android:layout_marginStart="45dp"
            style="@style/Rainbow.TextAppearance.Number7"/>
        <ImageView
            android:id="@+id/repeat_every_two_week_check"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/device_setting_sound_strength_selected"
            android:layout_centerVertical="true"
            android:layout_marginStart="15dp"/>
    </RelativeLayout>
    <View style="@style/DividerWithMargin"/>
    <RelativeLayout
        android:id="@+id/repeat_every_month"
        android:background="?android:attr/selectableItemBackground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="50dp">
        <TextView
            android:textColor="@color/s1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/repeat_every_month"
            android:layout_centerVertical="true"
            android:layout_marginStart="45dp"
            style="@style/Rainbow.TextAppearance.Number7"/>
        <ImageView
            android:id="@+id/repeat_every_month_check"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/device_setting_sound_strength_selected"
            android:layout_centerVertical="true"
            android:layout_marginStart="15dp"/>
    </RelativeLayout>
    <View style="@style/DividerWithMargin"/>
    <RelativeLayout
        android:id="@+id/repeat_every_year"
        android:background="?android:attr/selectableItemBackground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="50dp">
        <TextView
            android:textColor="@color/s1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/repeat_every_year"
            android:layout_centerVertical="true"
            android:layout_marginStart="45dp"
            style="@style/Rainbow.TextAppearance.Number7"/>
        <ImageView
            android:id="@+id/repeat_every_year_check"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/device_setting_sound_strength_selected"
            android:layout_centerVertical="true"
            android:layout_marginStart="15dp"/>
    </RelativeLayout>
    <View style="@style/DividerWithMargin"/>
    <RelativeLayout
        android:id="@+id/repeat_custom"
        android:background="?android:attr/selectableItemBackground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="50dp">
        <TextView
            android:textColor="@color/s1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/repeat_custom"
            android:layout_centerVertical="true"
            android:layout_marginStart="45dp"
            style="@style/Rainbow.TextAppearance.Number7"/>
        <TextView
            android:textColor="@color/s2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="12dp"
            android:layout_toStartOf="@+id/repeat_custom_arrow"
            style="@style/Rainbow.TextAppearance.Number8"/>
        <ImageView
            android:id="@+id/repeat_custom_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_arrow_forward_20_2x"
            android:layout_centerVertical="true"
            android:layout_marginEnd="15dp"
            android:layout_alignParentEnd="true"
            app:tint="@color/s2"/>
    </RelativeLayout>
    <View style="@style/DividerWithMargin"/>
</LinearLayout>
