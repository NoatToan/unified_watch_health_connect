<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/content_download"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true">
        <ImageView
            android:id="@+id/content_download_ig"
            android:background="@drawable/download"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <TextView
        android:textSize="@dimen/xima_detail_title_size"
        android:textColor="@color/xima_category_title_color"
        android:id="@+id/content_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toStartOf="@+id/content_download"
        android:layout_alignParentStart="true"/>
    <CheckBox
        android:id="@+id/down_check"
        android:focusable="false"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBottom="@+id/content_download"
        android:layout_toStartOf="@+id/content_download"/>
    <TextView
        android:textSize="@dimen/xima_detail_intruduce_size"
        android:textColor="@color/xima_light_graytext_color"
        android:id="@+id/content_size"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:drawablePadding="2dp"
        android:layout_below="@+id/content_title"
        android:drawableStart="@drawable/play"/>
    <TextView
        android:textSize="@dimen/xima_detail_intruduce_size"
        android:textColor="@color/xima_light_graytext_color"
        android:id="@+id/content_long"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawablePadding="2dp"
        android:layout_alignBottom="@+id/content_size"
        android:drawableStart="@drawable/xima_time"
        android:layout_marginStart="11dp"
        android:layout_toEndOf="@+id/content_size"/>
</RelativeLayout>
