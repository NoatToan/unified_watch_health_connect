<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="@dimen/size_18sp"
        android:textStyle="bold"
        android:textColor="@color/s1"
        android:gravity="start"
        android:id="@+id/data_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="lt"
        android:textDirection="locale"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="@dimen/size_14sp"
        android:textColor="@color/s33"
        android:gravity="start"
        android:id="@+id/data_level"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="lt-bold"
        android:textDirection="locale"
        android:layout_marginStart="@dimen/size_8dp"
        app:layout_constraintBaseline_toBaselineOf="@+id/data_name"
        app:layout_constraintStart_toEndOf="@+id/data_name"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="@dimen/size_13sp"
        android:textColor="@color/s2"
        android:gravity="start"
        android:id="@+id/intro_text"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_15dp"
        android:fontFamily="lt"
        android:textDirection="locale"
        android:textAlignment="viewStart"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/data_name"/>
    <ImageView
        android:id="@+id/intro_image"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/size_15dp"
        android:scaleType="centerCrop"
        app:layout_constraintDimensionRatio="h,315:90"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/intro_text"/>
    <com.xiaomi.hm.health.healthdata.ui.view.ColoredProgressBar
        android:id="@+id/coloredProgressBar"
        android:paddingTop="14dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/intro_text"
        app:progress_color_position="OUTER"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="@dimen/size_12sp"
        android:textColor="@color/s2"
        android:gravity="center"
        android:id="@+id/error_tips"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_22dp"
        android:drawablePadding="@dimen/size_4dp"
        android:drawableStart="@drawable/ic_alert_20"
        app:drawableTint="@color/s2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/intro_text"/>
</androidx.constraintlayout.widget.ConstraintLayout>
