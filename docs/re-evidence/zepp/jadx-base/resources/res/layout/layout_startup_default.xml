<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:baseui="http://schemas.android.com/apk/res-auto"
    android:background="#ff171b27"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/start_animation"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="50dp"
        android:layout_marginBottom="180dp"
        baseui:layout_constraintBottom_toBottomOf="parent"
        baseui:layout_constraintEnd_toEndOf="parent"
        baseui:layout_constraintStart_toStartOf="parent"
        baseui:layout_constraintTop_toTopOf="parent"
        baseui:lottie_autoPlay="true"
        baseui:lottie_fileName="start_animation.json"
        baseui:lottie_loop="true"/>
    <LinearLayout
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="107dp"
        baseui:layout_constraintBottom_toBottomOf="parent"
        baseui:layout_constraintEnd_toEndOf="parent"
        baseui:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/start_logo"
            android:scaleType="centerCrop"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
