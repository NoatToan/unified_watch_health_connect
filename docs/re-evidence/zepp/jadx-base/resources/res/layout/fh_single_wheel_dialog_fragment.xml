<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardBackgroundColor="@color/s38"
    app:cardCornerRadius="@dimen/fh_select_dialog_card_radio"
    app:cardElevation="0dp">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="16sp"
            android:textColor="@color/fh_calendar_title_text_color"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="@dimen/fh_calendar_dialog_title_height"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cons_root"
            android:background="@drawable/fh_bg_rect_transprent"
            android:layout_width="match_parent"
            android:layout_height="@dimen/fh_select_dialog_content_height">
            <View
                android:id="@+id/ftView2"
                android:background="@drawable/fh_bg_rect"
                android:layout_width="match_parent"
                android:layout_height="50.7dp"
                android:layout_centerVertical="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/ftLinearlayout3"
                android:background="@color/fh_verify_distance_accent2"
                android:layout_width="5.5dp"
                android:layout_height="match_parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/ftLinearlayout4"
                android:background="@color/fh_verify_distance_accent"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="@+id/ftView2"
                app:layout_constraintEnd_toEndOf="@+id/ftLinearlayout3"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/ftView2"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_year"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                app:layout_constraintEnd_toStartOf="@+id/cl_month"
                app:layout_constraintStart_toStartOf="parent">
                <androidx.constraintlayout.widget.Guideline
                    android:orientation="vertical"
                    android:id="@+id/ftGuidelineYear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintGuide_percent="0.55"/>
                <androidx.constraintlayout.widget.Guideline
                    android:orientation="vertical"
                    android:id="@+id/ftGuideline3Year2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintGuide_percent="0.45"/>
                <com.huami.widget.typeface.TypefaceTextView
                    android:textSize="12sp"
                    android:textColor="@color/fh_verify_distance_accent"
                    android:id="@+id/tv_subfix_year"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="@+id/wv_verify_year"
                    app:layout_constraintStart_toStartOf="@+id/ftGuidelineYear"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.huami.widget.typeface.TypefaceTextView
                    android:textSize="12sp"
                    android:textColor="@color/fh_verify_distance_accent"
                    android:id="@+id/tv_prefix_year"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="@+id/wv_verify_year"
                    app:layout_constraintEnd_toStartOf="@+id/ftGuideline3Year2"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.huami.widget.wheelview.WheelView
                    android:id="@+id/wv_verify_year"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <View
                    android:background="@color/s52"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/fh_select_dialog_select_line_height"
                    android:layout_marginBottom="@dimen/fh_select_dialog_select_line_margin"
                    android:layout_marginStart="@dimen/fh_select_dialog_select_line_side_margin"
                    android:layout_marginEnd="@dimen/fh_select_dialog_select_line_side_margin"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_max="@dimen/fh_select_dialog_select_line_max_width"/>
                <View
                    android:background="@color/s52"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/fh_select_dialog_select_line_height"
                    android:layout_marginTop="@dimen/fh_select_dialog_select_line_margin"
                    android:layout_marginStart="@dimen/fh_select_dialog_select_line_side_margin"
                    android:layout_marginEnd="@dimen/fh_select_dialog_select_line_side_margin"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_max="@dimen/fh_select_dialog_select_line_max_width"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_month"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                app:layout_constraintEnd_toStartOf="@+id/cl_day"
                app:layout_constraintStart_toEndOf="@+id/cl_year">
                <androidx.constraintlayout.widget.Guideline
                    android:orientation="vertical"
                    android:id="@+id/ftGuidelineMonth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintGuide_percent="0.65"/>
                <androidx.constraintlayout.widget.Guideline
                    android:orientation="vertical"
                    android:id="@+id/ftGuidelineMonth2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintGuide_percent="0.35"/>
                <com.huami.widget.typeface.TypefaceTextView
                    android:textSize="12sp"
                    android:textColor="@color/fh_verify_distance_accent"
                    android:id="@+id/tv_subfix_month"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="@+id/wv_verify_month"
                    app:layout_constraintStart_toStartOf="@+id/ftGuidelineMonth"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.huami.widget.typeface.TypefaceTextView
                    android:textSize="12sp"
                    android:textColor="@color/fh_verify_distance_accent"
                    android:id="@+id/tv_prefix_month"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="@+id/wv_verify_month"
                    app:layout_constraintEnd_toStartOf="@+id/ftGuidelineMonth2"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.huami.widget.wheelview.WheelView
                    android:id="@+id/wv_verify_month"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <View
                    android:background="@color/s52"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/fh_select_dialog_select_line_height"
                    android:layout_marginBottom="@dimen/fh_select_dialog_select_line_margin"
                    android:layout_marginStart="@dimen/fh_select_dialog_select_line_side_margin"
                    android:layout_marginEnd="@dimen/fh_select_dialog_select_line_side_margin"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_max="@dimen/fh_select_dialog_select_line_max_width"/>
                <View
                    android:background="@color/s52"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/fh_select_dialog_select_line_height"
                    android:layout_marginTop="@dimen/fh_select_dialog_select_line_margin"
                    android:layout_marginStart="@dimen/fh_select_dialog_select_line_side_margin"
                    android:layout_marginEnd="@dimen/fh_select_dialog_select_line_side_margin"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_max="@dimen/fh_select_dialog_select_line_max_width"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_day"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/cl_month">
                <androidx.constraintlayout.widget.Guideline
                    android:orientation="vertical"
                    android:id="@+id/ftGuidelineDay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintGuide_percent="0.65"/>
                <androidx.constraintlayout.widget.Guideline
                    android:orientation="vertical"
                    android:id="@+id/ftGuidelineDay2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintGuide_percent="0.35"/>
                <com.huami.widget.typeface.TypefaceTextView
                    android:textSize="12sp"
                    android:textColor="@color/fh_verify_distance_accent"
                    android:id="@+id/tv_subfix_day"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="@+id/wv_verify_day"
                    app:layout_constraintStart_toStartOf="@+id/ftGuidelineDay"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.huami.widget.typeface.TypefaceTextView
                    android:textSize="12sp"
                    android:textColor="@color/fh_verify_distance_accent"
                    android:id="@+id/tv_prefix_day"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="@+id/wv_verify_day"
                    app:layout_constraintEnd_toStartOf="@+id/ftGuidelineDay2"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.huami.widget.wheelview.WheelView
                    android:id="@+id/wv_verify_day"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <View
                    android:background="@color/s52"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/fh_select_dialog_select_line_height"
                    android:layout_marginBottom="@dimen/fh_select_dialog_select_line_margin"
                    android:layout_marginStart="@dimen/fh_select_dialog_select_line_side_margin"
                    android:layout_marginEnd="@dimen/fh_select_dialog_select_line_side_margin"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_max="@dimen/fh_select_dialog_select_line_max_width"/>
                <View
                    android:background="@color/s52"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/fh_select_dialog_select_line_height"
                    android:layout_marginTop="@dimen/fh_select_dialog_select_line_margin"
                    android:layout_marginStart="@dimen/fh_select_dialog_select_line_side_margin"
                    android:layout_marginEnd="@dimen/fh_select_dialog_select_line_side_margin"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_max="@dimen/fh_select_dialog_select_line_max_width"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
