<?xml version="1.0" encoding="utf-8"?>
<com.huami.sleep.view.VerticalScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:scrollbars="none"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="never">
    <LinearLayout
        android:orientation="vertical"
        android:descendantFocusability="blocksDescendants"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:background="@color/s38"
            android:paddingTop="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/tipLayout"
                android:padding="7dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp">
                <com.huami.widget.typeface.TypefaceTextView
                    android:textSize="12sp"
                    android:textColor="@color/s2"
                    android:id="@+id/sleep_time_lable"
                    android:visibility="invisible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/daily_sleep_duration"/>
                <com.huami.sleep.view.UnitTextView
                    android:textSize="40sp"
                    android:textColor="@color/s1"
                    android:id="@+id/active_daily_average"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    app:typeface="km"
                    app:unitColor="@color/s2"
                    app:unitSize="13sp"/>
                <com.huami.widget.typeface.TypefaceTextView
                    android:textSize="12sp"
                    android:textColor="@color/s2"
                    android:id="@+id/sleep_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"/>
            </LinearLayout>
            <FrameLayout
                android:id="@+id/chart_container"
                android:layout_width="match_parent"
                android:layout_height="174dp"
                android:layout_below="@+id/tipLayout"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/s1"
                android:gravity="center"
                android:id="@+id/noDataView"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="174dp"
                android:text="@string/no_sleep_data"
                android:layout_below="@+id/tipLayout"/>
            <View
                android:id="@+id/chart_bottom_line"
                android:background="@color/s4"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="2dp"
                android:layout_below="@+id/chart_container"/>
            <include
                android:id="@+id/sleep_statistics_chart_intro"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="47dp"
                android:layout_below="@+id/chart_bottom_line"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                layout="@layout/layout_sleep_statistics_chart_intro"/>
        </RelativeLayout>
        <com.huami.sleep.daysleep.quotient.view.SleepQuotientView
            android:id="@+id/sleep_quotient_info"
            android:background="@drawable/sleep_main_bg"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"/>
        <com.huami.sleep.statistic.breath.BreathQualityViewForYMW
            android:id="@+id/sleepBreathYMW"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"/>
        <FrameLayout
            android:id="@+id/slpAnalysisContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/slpRegularLayout"
            android:background="@drawable/sleep_main_bg"
            android:padding="@dimen/slp_size_15dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/slp_size_15dp"
            android:layout_marginTop="@dimen/slp_size_15dp"
            android:layout_marginRight="@dimen/slp_size_15dp">
            <TextView
                android:textSize="@dimen/slp_size_18sp"
                android:textStyle="bold"
                android:textColor="@color/s1"
                android:id="@+id/regularTile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/slp_night_regular"
                android:paddingEnd="@dimen/slp_size_15dp"
                app:layout_constraintEnd_toStartOf="@+id/wakeTv"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/slp_size_14sp"
                android:textColor="@color/s2"
                android:id="@+id/wakeTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sleep_wakeup_time"
                android:drawableLeft="@drawable/slp_info_rect_wake"
                android:drawablePadding="6dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/slp_size_14sp"
                android:textColor="@color/s2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/sleep_sleep_time"
                android:drawableLeft="@drawable/slp_info_rect_deep"
                android:drawablePadding="6dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/wakeTv"/>
            <FrameLayout
                android:id="@+id/sleepRegular"
                android:layout_width="match_parent"
                android:layout_height="165dp"
                android:layout_marginTop="50dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/regularTile"/>
            <android.widget.Space
                android:id="@+id/regularTopV"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="20dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/sleepRegular"/>
            <TextView
                android:textSize="@dimen/slp_size_11sp"
                android:textColor="@color/s1"
                android:id="@+id/regularTipTv"
                android:background="@drawable/sleep_gray_bg"
                android:paddingLeft="5dp"
                android:paddingTop="3dp"
                android:paddingRight="5dp"
                android:paddingBottom="3dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="18：00-21：00"
                app:layout_constraintBottom_toTopOf="@+id/regularTopV"
                app:layout_constraintStart_toStartOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <FrameLayout
            android:id="@+id/contentLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</com.huami.sleep.view.VerticalScrollView>
