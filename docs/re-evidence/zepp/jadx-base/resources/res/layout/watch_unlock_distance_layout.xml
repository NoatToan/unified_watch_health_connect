<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/unlock_open_layout"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="64dp">
        <RelativeLayout
            android:id="@+id/unlock_distance_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="23.3dp"
            android:paddingEnd="23.3dp">
            <TextView
                android:textSize="14.7sp"
                android:textColor="@color/black_text"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15.8dp"
                android:text="@string/unlock_distance"
                android:layout_alignParentTop="true"
                android:layout_alignParentStart="true"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/dark_grey_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/watch_unlock_distance_content"
                android:layout_below="@+id/title"
                android:layout_toStartOf="@+id/distance_tv"
                android:layout_alignParentStart="true"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/grey_text"
                android:id="@+id/distance_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginEnd="14dp"
                android:layout_toStartOf="@+id/arrow_iv"/>
            <ImageView
                android:id="@+id/arrow_iv"
                android:background="@drawable/ic_list_item_right_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <View
            android:layout_gravity="bottom"
            android:id="@+id/distance_mask_view"
            android:background="#77f7f7f7"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="64dp"/>
    </FrameLayout>
    <include layout="@layout/split_line_width_match_parent"/>
</LinearLayout>
