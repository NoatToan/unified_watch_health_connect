<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/s10"
    android:scrollbars="none"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:background="@color/s36"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/size_58dp"
                android:paddingStart="@dimen/size_18dp"
                android:paddingEnd="@dimen/size_18dp">
                <TextView
                    android:id="@+id/tv_content"
                    android:layout_width="@dimen/size_130dp"
                    android:layout_height="@dimen/size_22dp"
                    android:text="@string/wl_invoice_content"
                    android:layout_centerVertical="true"
                    style="@style/ConfirmInVoiceHeadStyle"/>
                <TextView
                    android:gravity="start"
                    android:id="@+id/tv_content_massage"
                    android:background="@null"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/wl_invoice_recharge_fee"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@+id/tv_content"
                    style="@style/ConfirmInVoiceContentStyle"/>
                <View
                    android:background="@color/s4"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_alignParentBottom="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rl_invoice_head_confirm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/size_58dp"
                android:paddingStart="@dimen/size_18dp"
                android:paddingEnd="@dimen/size_18dp">
                <TextView
                    android:id="@+id/tv_invoice_head"
                    android:layout_width="@dimen/size_130dp"
                    android:layout_height="@dimen/size_22dp"
                    android:text="@string/wl_invoice_head"
                    android:layout_centerVertical="true"
                    style="@style/ConfirmInVoiceHeadStyle"/>
                <TextView
                    android:gravity="start"
                    android:id="@+id/tv_invoice_type_confirm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/wl_invoice_type_name"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@+id/tv_invoice_head"
                    style="@style/ConfirmInVoiceContentStyle"/>
                <View
                    android:background="@color/s4"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_alignParentBottom="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rl_company_name_confirm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/size_58dp"
                android:paddingStart="@dimen/size_18dp"
                android:paddingEnd="@dimen/size_18dp">
                <TextView
                    android:id="@+id/tv_company"
                    android:layout_width="@dimen/size_130dp"
                    android:layout_height="@dimen/size_22dp"
                    android:text="@string/wl_invoice_company_name"
                    android:layout_centerVertical="true"
                    style="@style/ConfirmInVoiceHeadStyle"/>
                <TextView
                    android:gravity="start"
                    android:id="@+id/tv_company_name"
                    android:paddingTop="@dimen/size_10dp"
                    android:paddingBottom="@dimen/size_10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@+id/tv_company"
                    style="@style/ConfirmInVoiceContentStyle"/>
                <View
                    android:background="@color/s4"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_alignParentBottom="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rl_tax_payer_number_confirm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/size_58dp"
                android:paddingStart="@dimen/size_18dp"
                android:paddingEnd="@dimen/size_18dp">
                <TextView
                    android:id="@+id/tv_taxpayer_number"
                    android:layout_width="@dimen/size_130dp"
                    android:layout_height="@dimen/size_22dp"
                    android:text="@string/wl_invoice_taxpayer_number"
                    android:layout_centerVertical="true"
                    style="@style/ConfirmInVoiceHeadStyle"/>
                <TextView
                    android:gravity="start"
                    android:id="@+id/tv_taxpayer_number_content"
                    android:paddingTop="@dimen/size_10dp"
                    android:paddingBottom="@dimen/size_10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@+id/tv_taxpayer_number"
                    style="@style/ConfirmInVoiceContentStyle"/>
            </RelativeLayout>
            <View
                android:background="@color/s10"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_8dp"/>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_42dp"
                android:paddingStart="@dimen/size_18dp"
                android:paddingEnd="@dimen/size_18dp">
                <TextView
                    android:textSize="@dimen/size_12sp"
                    android:textColor="@color/s3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/wl_invoice_input_receive_email_tips"
                    android:layout_centerVertical="true"/>
                <View
                    android:background="@color/s4"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_alignParentBottom="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/size_58dp"
                android:paddingStart="@dimen/size_18dp"
                android:paddingEnd="@dimen/size_18dp">
                <TextView
                    android:id="@+id/tv_receive_email"
                    android:layout_width="@dimen/size_130dp"
                    android:layout_height="@dimen/size_22dp"
                    android:text="@string/wl_invoice_email"
                    android:layout_centerVertical="true"
                    style="@style/ConfirmInVoiceHeadStyle"/>
                <TextView
                    android:gravity="start"
                    android:id="@+id/tv_receive_email_content"
                    android:paddingTop="@dimen/size_10dp"
                    android:paddingBottom="@dimen/size_10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@+id/tv_receive_email"
                    style="@style/ConfirmInVoiceContentStyle"/>
                <View
                    android:background="@color/s4"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_alignParentBottom="true"/>
            </RelativeLayout>
        </LinearLayout>
        <Button
            android:gravity="center"
            android:id="@+id/tv_submit_confirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_53dp"
            android:layout_marginBottom="@dimen/size_24dp"
            android:text="@string/wl_invoice_submit_confirm"
            android:layout_marginStart="@dimen/size_18dp"
            android:layout_marginEnd="@dimen/size_18dp"
            style="@style/Rainbow.Widget.Button.44.Circular"/>
    </LinearLayout>
</ScrollView>
