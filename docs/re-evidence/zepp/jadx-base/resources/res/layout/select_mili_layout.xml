<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:orientation="vertical"
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="20sp"
            android:textColor="@color/s1"
            android:gravity="center"
            android:id="@+id/tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="98dp"
            android:text="@string/select_mili_tips_1"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/s2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:layout_marginBottom="45.3dp"
            android:text="@string/select_mili_tips_2"
            android:layout_below="@+id/tips"
            android:layout_centerHorizontal="true"/>
        <ListView
            android:id="@+id/mili_device_list"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_marginTop="87dp"
            android:divider="@null"
            android:layout_below="@+id/tips"/>
    </RelativeLayout>
    <LinearLayout
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingBottom="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <TextView
            android:textSize="14sp"
            android:textColor="@drawable/bind_left_text_color"
            android:gravity="center"
            android:layout_gravity="start"
            android:id="@+id/select_mili_quit_tv"
            android:background="@drawable/midong_common_corner_rect"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="@string/cancel"
            android:layout_weight="1"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@drawable/bind_left_text_color"
            android:gravity="center"
            android:layout_gravity="end"
            android:id="@+id/select_mili_other_tv"
            android:background="@drawable/midong_common_corner_rect"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="@string/search_other_mili"
            android:layout_weight="1"
            android:layout_marginStart="20dp"/>
    </LinearLayout>
</RelativeLayout>
