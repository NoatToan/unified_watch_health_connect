<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s38"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.huami.sleep.daysleep.sleepstagechart.ui.view.SleepOverlayMenu
        android:id="@+id/overLayMenu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/selectInfoLL"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/selectInfoLL"
        android:padding="7dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="5dp"
        app:layout_constraintRight_toLeftOf="@+id/overLayMenu"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/s2"
            android:id="@+id/sleepTv"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <com.huami.sleep.view.UnitTextView
            android:textSize="40sp"
            android:textColor="@color/s1"
            android:id="@+id/sleepTotalTimeTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_below="@+id/sleepTv"
            app:typeface="km"
            app:unitColor="@color/s2"
            app:unitSize="13sp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/s2"
            android:id="@+id/sleepDurTV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"/>
    </LinearLayout>
    <View
        android:id="@+id/belowTipLine"
        android:background="@color/s4"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="7dp"
        android:layout_marginRight="15dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/selectInfoLL"/>
    <View
        android:id="@+id/line"
        android:background="@color/s4"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="50dp"
        android:layout_marginRight="15dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/belowTipLine"/>
    <FrameLayout
        android:id="@+id/chartLayout"
        android:layout_width="match_parent"
        android:layout_height="162dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/belowTipLine"/>
    <TextView
        android:textSize="@dimen/slp_size_13sp"
        android:textColor="@color/s1"
        android:gravity="center_vertical"
        android:id="@+id/makeTagTv"
        android:background="@drawable/slp_make_tag_bg"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginBottom="5dp"
        android:text="@string/slp_tag"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/chartLayout"
        app:layout_constraintEnd_toEndOf="parent"/>
    <com.huami.sleep.daysleep.sleepstagechart.ui.view.DragIntervalView
        android:id="@+id/dragSelectV"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="172dp"
        app:dv_drawPadding="15dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/chartLayout"/>
    <FrameLayout
        android:id="@+id/hrChartLayout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="162dp"
        app:layout_constraintBottom_toBottomOf="@+id/chartLayout"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/chartLayout"/>
    <RelativeLayout
        android:id="@+id/timeLayout"
        android:paddingLeft="15dp"
        android:paddingRight="15dp"
        android:layout_width="match_parent"
        android:layout_height="25dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/chartLayout">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/s3"
            android:id="@+id/startTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/s3"
            android:id="@+id/stopTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <View
        android:id="@+id/belowChartLine"
        android:background="@color/s4"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/timeLayout"/>
    <android.widget.Space
        android:id="@+id/space"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12.5dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/chartLayout"/>
    <com.huami.sleep.daysleep.sleepstagechart.ui.view.SleepTagChart
        android:id="@+id/tagResultLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/space"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:stc_drawPadding="15dp"/>
    <com.huami.sleep.daysleep.sleepstagechart.ui.view.SleepStageInfoView
        android:id="@+id/sleepDurationView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        app:layout_constraintTop_toBottomOf="@+id/belowChartLine"/>
    <com.huami.sleep.daysleep.sleepstagechart.ui.view.SleepTagEditCard
        android:id="@+id/slpTagCard"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/sleepDurationView"/>
</androidx.constraintlayout.widget.ConstraintLayout>
