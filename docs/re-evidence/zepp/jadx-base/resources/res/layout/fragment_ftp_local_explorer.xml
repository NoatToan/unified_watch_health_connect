<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.huami.watch.companion.ui.view.PagerSlidingTabStrip
        android:id="@+id/indicator"
        android:background="@color/s38"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:paddingStart="23.3dp"
        android:paddingEnd="23.3dp"
        app:pstsIndicatorColor="@color/p3"
        app:pstsIndicatorWidth="22dp"
        app:pstsTabTextColor="@color/btn_text_grey_red"/>
    <View
        android:id="@+id/line"
        android:background="@color/s4"
        android:layout_width="match_parent"
        android:layout_height="0.3dp"
        android:layout_below="@+id/indicator"/>
    <FrameLayout
        android:id="@+id/btn_layout"
        android:background="@color/s38"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:layout_alignParentBottom="true">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/s2"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/btn_upload"
            android:padding="8dp"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/file_manager_upload"
            android:drawableTop="@drawable/ftp_ic_upload"
            app:drawableTint="@color/s2"/>
    </FrameLayout>
    <View
        android:id="@+id/line2"
        android:background="@color/s4"
        android:layout_width="match_parent"
        android:layout_height="0.3dp"
        android:layout_above="@+id/btn_layout"/>
    <FrameLayout
        android:id="@+id/attention"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/line2"
        android:layout_below="@+id/line">
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:background="@drawable/ic_alert_20"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:backgroundTint="@color/s2"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/s2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/file_manager_no_file"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
    </FrameLayout>
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/line2"
        android:layout_below="@+id/line"/>
    <View
        android:id="@+id/fog_layer"
        android:background="@color/s38"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.65"/>
</RelativeLayout>
