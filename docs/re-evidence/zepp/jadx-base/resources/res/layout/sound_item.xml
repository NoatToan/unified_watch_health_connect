<?xml version="1.0" encoding="utf-8"?>
<com.huami.watch.companion.ximalaya.SoundItem xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/divider"
        android:background="@color/xima_listview_divider_color"
        android:layout_width="match_parent"
        android:layout_height="0.33dp"/>
    <RelativeLayout
        android:paddingTop="11dp"
        android:paddingBottom="11dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/divider">
        <ImageView
            android:id="@+id/item_icon"
            android:layout_width="@dimen/xima_search_item_ig_size"
            android:layout_height="@dimen/xima_search_item_ig_size"
            android:layout_centerVertical="true"/>
        <FrameLayout
            android:id="@+id/item_download"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true">
            <ImageView
                android:id="@+id/item_download_ig"
                android:background="@drawable/download"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </FrameLayout>
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_toStartOf="@+id/item_download"
            android:layout_toEndOf="@+id/item_icon">
            <TextView
                android:textSize="@dimen/xima_detail_title_size"
                android:textColor="@color/xima_category_title_color"
                android:id="@+id/item_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="@dimen/xima_detail_intruduce_size"
                android:textColor="@color/xima_light_graytext_color"
                android:id="@+id/item_author"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_below="@+id/item_title"/>
            <TextView
                android:textSize="@dimen/xima_detail_intruduce_size"
                android:textColor="@color/xima_light_graytext_color"
                android:id="@+id/item_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:drawablePadding="3dp"
                android:layout_below="@+id/item_author"
                android:drawableStart="@drawable/play"/>
            <TextView
                android:textSize="@dimen/xima_detail_intruduce_size"
                android:textColor="@color/xima_light_graytext_color"
                android:id="@+id/item_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:drawablePadding="2dp"
                android:layout_alignBottom="@+id/item_size"
                android:drawableStart="@drawable/xima_time"
                android:layout_marginStart="9.33dp"
                android:layout_toEndOf="@+id/item_size"/>
        </RelativeLayout>
    </RelativeLayout>&gt; 
</com.huami.watch.companion.ximalaya.SoundItem>
