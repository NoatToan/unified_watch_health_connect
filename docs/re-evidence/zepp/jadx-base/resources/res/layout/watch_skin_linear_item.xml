<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:id="@+id/skin_card"
    android:layout_width="100dp"
    android:layout_height="wrap_content"
    android:foreground="?android:attr/selectableItemBackground"
    card_view:cardBackgroundColor="@color/s38"
    card_view:cardCornerRadius="10dp"
    card_view:cardElevation="2dp"
    card_view:cardPreventCornerOverlap="true"
    card_view:cardUseCompatPadding="false">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="15dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/skin_iv"
            android:layout_width="70dp"
            android:layout_height="140dp"
            android:layout_marginTop="5dp"
            android:src="@drawable/icon_headview_band"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/s1"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/skin_tv_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="守望先锋守望先锋"
            android:singleLine="true"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/s2"
            android:gravity="bottom|center_horizontal"
            android:id="@+id/skin_tv_price"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="4dp"
            android:text="免费"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
