<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:weightSum="1">
    <FrameLayout
        android:background="@color/s38"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/unlock_screen_set_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <FrameLayout
                    android:clickable="false"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:paddingStart="@dimen/common_item_padding"
                    android:paddingEnd="@dimen/common_item_padding">
                    <TextView
                        android:textSize="11.3sp"
                        android:textColor="@color/s2"
                        android:gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:text="@string/first_set_lock_screen_pw"/>
                </FrameLayout>
                <View
                    android:background="@color/s4"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/divider"/>
                <FrameLayout
                    android:id="@+id/set_unlock_screen_password_layout"
                    android:background="@color/s38"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:paddingStart="@dimen/common_item_padding"
                    android:paddingEnd="@dimen/common_item_padding">
                    <TextView
                        android:textSize="15sp"
                        android:textColor="@color/s1"
                        android:gravity="center_vertical"
                        android:clickable="false"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:maxWidth="270dp"
                        android:text="@string/lock_screen_first_step"/>
                    <ImageView
                        android:layout_gravity="end|center_vertical"
                        android:id="@+id/set_unlock_screen_password_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/default_end_arrow"/>
                    <TextView
                        android:textSize="11.3sp"
                        android:textColor="@color/s2"
                        android:layout_gravity="end|center_vertical"
                        android:id="@+id/set_unlock_screen_password_text_tip"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/screen_lock_text_tip"/>
                </FrameLayout>
                <View
                    android:layout_gravity="bottom"
                    android:background="@color/s4"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/divider"/>
                <FrameLayout
                    android:clickable="false"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:paddingStart="@dimen/common_item_padding"
                    android:paddingEnd="@dimen/common_item_padding">
                    <TextView
                        android:textSize="11.3sp"
                        android:textColor="@color/s2"
                        android:gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:text="@string/check_lock_screen_pw"/>
                </FrameLayout>
                <View
                    android:background="@color/s4"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/divider"/>
                <FrameLayout
                    android:id="@+id/set_miband_unlock_layout"
                    android:background="@color/s38"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:paddingStart="@dimen/common_item_padding"
                    android:paddingEnd="@dimen/common_item_padding">
                    <TextView
                        android:textSize="15sp"
                        android:textColor="@color/s1"
                        android:gravity="center_vertical"
                        android:id="@+id/set_miband_unlock_text"
                        android:clickable="false"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:maxWidth="270dp"
                        android:text="@string/lock_screen_second_step"/>
                    <ImageView
                        android:layout_gravity="end|center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/default_end_arrow"/>
                </FrameLayout>
                <View
                    android:layout_gravity="bottom"
                    android:background="@color/s4"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/divider"/>
            </LinearLayout>
            <include layout="@layout/unlock_distance_layout"/>
            <RelativeLayout
                android:id="@+id/has_unlock_with_bracelet_ll"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/s1"
                    android:gravity="center_horizontal"
                    android:id="@+id/unlock_title_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="60dp"
                    android:text="@string/unlock_screen_title"
                    android:layout_centerHorizontal="true"
                    android:layout_marginStart="18dp"
                    android:layout_marginEnd="18dp"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/s3"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/unlock_screen_tips"
                    android:layout_below="@+id/unlock_title_tv"
                    android:layout_centerHorizontal="true"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/s41"
                    android:id="@+id/unlock_screen_invalid_tv"
                    android:paddingBottom="30dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/unlock_screen_invalid"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"/>
            </RelativeLayout>
        </LinearLayout>
        <View
            android:layout_gravity="bottom"
            android:id="@+id/miui_mask_view"
            android:background="@color/s38"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.85"/>
    </FrameLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/non_miui_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.huami.lib.view.widget.TipComponent
                android:id="@+id/tips"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/s2"
                android:id="@+id/tips_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="78.7dp"
                android:text="@string/unlock_for_smartlock_tip_step1"
                android:layout_below="@+id/tips"
                android:layout_marginStart="47.5dp"
                android:layout_marginEnd="47.5dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/s2"
                android:id="@+id/tips_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/unlock_for_smartlock_tip_step2"
                android:layout_below="@+id/tips_1"
                android:layout_marginStart="47.5dp"
                android:layout_marginEnd="47.5dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/s2"
                android:id="@+id/no_miui_step_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/unlock_for_smartlock_tip_step3"
                android:layout_below="@+id/tips_2"
                android:layout_marginStart="47.5dp"
                android:layout_marginEnd="47.5dp"/>
            <FrameLayout
                android:id="@+id/smartlock_fl"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true">
                <com.huami.lib.rainbow.button.RainbowButton
                    android:id="@+id/start_setting"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginBottom="24dp"
                    android:text="@string/unlock_for_smartlock_start_setting"
                    android:layout_marginStart="18dp"
                    android:layout_marginEnd="18dp"
                    style="?attr/buttonStyleGray_44_outline_circular"/>
            </FrameLayout>
        </RelativeLayout>
        <View
            android:layout_gravity="bottom"
            android:id="@+id/normal_mask_view"
            android:background="@color/s38"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.85"/>
    </FrameLayout>
</FrameLayout>
