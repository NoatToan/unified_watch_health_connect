<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.lib.rainbow.titlebar.RainbowTitleBar
        android:id="@+id/rainbowTitleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menuText="@string/save"
        app:menuTint="@color/p4"
        app:navigationText="@string/cancel"
        app:navigationTint="@color/s2"
        app:title="@string/set_alarm"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/alarm_item_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_12dp"
        android:layout_marginStart="@dimen/size_10dp"
        android:layout_marginEnd="@dimen/size_10dp">
        <LinearLayout
            android:id="@+id/alarm_time"
            android:layout_width="match_parent"
            android:layout_height="@dimen/alarm_wheel_hight"
            android:paddingStart="@dimen/size_24dp"
            android:paddingEnd="@dimen/size_24dp">
            <com.huami.widget.wheelview.WheelView
                android:id="@+id/ampm_wheel"
                android:paddingTop="@dimen/size_18dp"
                android:paddingBottom="@dimen/size_20dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/size_9dp"/>
            <com.huami.widget.wheelview.WheelView
                android:id="@+id/hour_wheel"
                android:paddingTop="@dimen/size_18dp"
                android:paddingBottom="@dimen/size_20dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/size_9dp"/>
            <com.huami.widget.wheelview.WheelView
                android:id="@+id/min_wheel"
                android:paddingTop="@dimen/size_18dp"
                android:paddingBottom="@dimen/size_20dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/lazy_mode_layout"
        android:background="@drawable/alarm_item_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_12dp"
        android:layout_marginStart="@dimen/size_10dp"
        android:layout_marginEnd="@dimen/size_10dp">
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="@dimen/size_16sp"
            android:textColor="@color/s1"
            android:id="@+id/tv_lazy_mode_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_16dp"
            android:text="@string/alarm_clock_lazy_title"
            android:fontFamily="km"
            android:layout_marginStart="@dimen/size_15dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/lazy_mode_switch"
            android:focusable="false"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/size_15dp"
            app:layout_constraintBottom_toBottomOf="@+id/tv_lazy_mode_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_lazy_mode_title"
            style="@style/Rainbow.Widget.Switch"/>
        <TextView
            android:textSize="@dimen/size_12sp"
            android:textColor="@color/s2"
            android:id="@+id/tv_lazy_mode_desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_10dp"
            android:layout_marginBottom="@dimen/size_16dp"
            android:text="@string/alarm_clock_lazy_summary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/lazy_mode_switch"
            app:layout_constraintStart_toStartOf="@+id/tv_lazy_mode_title"
            app:layout_constraintTop_toBottomOf="@+id/tv_lazy_mode_title"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/smart_mode_layout"
        android:background="@drawable/alarm_item_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_12dp"
        android:layout_marginStart="@dimen/size_10dp"
        android:layout_marginEnd="@dimen/size_10dp">
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="@dimen/size_16sp"
            android:textColor="@color/s1"
            android:id="@+id/tv_smart_mode_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_16dp"
            android:text="@string/alarm_clock_smart_title"
            android:fontFamily="km"
            android:layout_marginStart="@dimen/size_15dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/smart_mode_switch"
            android:focusable="false"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/size_15dp"
            app:layout_constraintBottom_toBottomOf="@+id/tv_smart_mode_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_smart_mode_title"
            style="@style/Rainbow.Widget.Switch"/>
        <TextView
            android:textSize="@dimen/size_12sp"
            android:textColor="@color/s2"
            android:id="@+id/tv_smart_mode_desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_10dp"
            android:layout_marginBottom="@dimen/size_16dp"
            android:text="@string/huami_os_alarm_clock_smart_summary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/smart_mode_switch"
            app:layout_constraintStart_toStartOf="@+id/tv_smart_mode_title"
            app:layout_constraintTop_toBottomOf="@+id/tv_smart_mode_title"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/repeat_mode_layout"
        android:background="@drawable/alarm_item_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_12dp"
        android:layout_marginStart="@dimen/size_10dp"
        android:layout_marginEnd="@dimen/size_10dp">
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="@dimen/size_16sp"
            android:textColor="@color/s1"
            android:id="@+id/tv_repeat_mode_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/td_size_21dp"
            android:layout_marginBottom="@dimen/td_size_21dp"
            android:text="@string/alarm_clock_repeat"
            android:fontFamily="km"
            android:layout_marginStart="@dimen/size_15dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/size_14sp"
            android:textColor="@color/s2"
            android:id="@+id/tv_repeat_mode_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="35dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_right_arrow"
            android:layout_marginEnd="@dimen/dp_10"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/s2"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
