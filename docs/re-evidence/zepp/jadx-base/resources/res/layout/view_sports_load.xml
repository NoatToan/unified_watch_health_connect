<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s38"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textStyle="bold"
            android:textColor="@color/s1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/sports_load_last_7"
            style="@style/Rainbow.TextAppearance.Body4"/>
        <FrameLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="33dp">
            <com.huami.watch.companion.firstbeat.DialView
                android:layout_gravity="center_horizontal"
                android:id="@+id/dv_sports_load"
                android:layout_width="195dp"
                android:layout_height="wrap_content"
                app:dv_stroke_width="13.3dp"/>
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="50dp">
                <com.huami.watch.companion.ui.view.HuaMiFontTextView
                    android:textSize="48sp"
                    android:textColor="@color/s1"
                    android:id="@+id/tv_sports_load_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/empty_value"
                    style="@style/Rainbow.TextAppearance.Number1"/>
                <TextView
                    android:textColor="@color/s2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/sport_load_unit"
                    style="@style/Rainbow.TextAppearance.Body5"/>
                <TextView
                    android:textStyle="bold"
                    android:textColor="@color/s1"
                    android:gravity="center"
                    android:id="@+id/tv_sports_load_level"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/empty_value"
                    style="@style/Rainbow.TextAppearance.Body1"/>
            </LinearLayout>
        </FrameLayout>
        <View
            android:background="@color/s10"
            android:layout_width="match_parent"
            android:layout_height="10.5dp"
            android:layout_marginTop="18dp"/>
        <TextView
            android:textStyle="bold"
            android:textColor="@color/s1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/sports_load_chart_tip"
            style="@style/Rainbow.TextAppearance.Body4"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/sport_load_status_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <com.huami.watch.companion.ui.view.HuaMiFontTextView
                android:textSize="24sp"
                android:textColor="@color/s1"
                android:gravity="center"
                android:id="@+id/status_value"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"/>
            <TextView
                android:textColor="@color/s2"
                android:gravity="bottom|center_horizontal"
                android:id="@+id/status_info"
                android:paddingBottom="4dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                style="@style/Rainbow.TextAppearance.Body4"/>
        </LinearLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.huami.watch.dataflow.chart.StatisticChartView
                android:id="@+id/chart"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="10dp"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"/>
            <TextView
                android:textColor="@color/s3"
                android:layout_gravity="center"
                android:id="@+id/tv_no_data"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:text="@string/wl_no_data"
                style="@style/Rainbow.TextAppearance.Body5"/>
        </FrameLayout>
        <View
            android:background="@color/s10"
            android:layout_width="match_parent"
            android:layout_height="10.5dp"
            android:layout_marginTop="18dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10.2dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="31dp">
            <TextView
                android:textStyle="bold"
                android:textColor="@color/s1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/sports_load"
                style="@style/Rainbow.TextAppearance.Body4"/>
            <TextView
                android:textColor="@color/s1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15.3dp"
                android:layout_marginBottom="20dp"
                android:text="@string/sports_load_des_info"
                android:lineSpacingExtra="5.3sp"
                style="@style/Rainbow.TextAppearance.Body5"/>
        </LinearLayout>
        <TextView
            android:textColor="@color/s3"
            android:id="@+id/jp_hint_text"
            android:background="@color/s10"
            android:paddingTop="12dp"
            android:paddingBottom="20dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="25dp"
            android:paddingEnd="25dp"
            style="@style/Rainbow.TextAppearance.Body5"/>
    </LinearLayout>
</ScrollView>
