<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/s36"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="20sp"
        android:textColor="@color/s1"
        android:id="@+id/device_reset_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="98dp"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/s2"
        android:id="@+id/device_reset_sub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:layout_below="@+id/device_reset_title"
        android:layout_centerHorizontal="true"
        android:paddingStart="50dp"
        android:paddingEnd="50dp"/>
    <RelativeLayout
        android:id="@+id/device_reset_connect"
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:layout_marginTop="151dp">
        <com.xiaomi.hm.health.device.view.HMLoadingView
            android:id="@+id/loading_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ImageView
            android:background="@color/s36"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/img_miband"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/vibrate_img"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/img_miband_vibrate"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/device_reset_input"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="82dp"
        android:layout_below="@+id/device_reset_sub">
        <com.xiaomi.hm.health.device.view.VerifyCodeView
            android:id="@+id/input_number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="77dp"
            android:layout_marginEnd="77dp"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/device_reset_ble"
        android:visibility="gone"
        android:layout_width="120dp"
        android:layout_height="190dp"
        android:layout_marginTop="61dp"
        android:layout_below="@+id/device_reset_sub"
        android:layout_centerHorizontal="true">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/img_phone"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/img_bluetooth"
            android:layout_centerInParent="true"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="39dp"
            android:src="@drawable/img_accept"
            android:layout_marginStart="75dp"/>
    </RelativeLayout>
    <include
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        layout="@layout/device_layout_bottom_common_btn"/>
</RelativeLayout>
