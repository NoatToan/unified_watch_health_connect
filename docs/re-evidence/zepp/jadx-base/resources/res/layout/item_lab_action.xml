<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/ll_lab"
    android:background="@color/s38"
    android:layout_width="match_parent"
    android:layout_height="@dimen/lab_behavior_item_height">
    <View
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="30"/>
    <ImageView
        android:id="@+id/imv_lab_action"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:scaleType="centerCrop"
        android:tint="@color/s1"/>
    <View
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="10"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/s1"
        android:gravity="bottom|center_horizontal"
        android:id="@+id/tx_lab_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <View
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="6"/>
    <TextView
        android:textSize="12.7sp"
        android:textColor="@color/s1"
        android:gravity="center"
        android:id="@+id/tx_mark_times"
        android:background="@drawable/tip_mark_times"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="31.3dp"/>
    <View
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="14"/>
</LinearLayout>
