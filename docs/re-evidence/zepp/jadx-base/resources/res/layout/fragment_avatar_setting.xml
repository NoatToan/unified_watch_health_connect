<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/takephoto"
        android:background="@drawable/selector_dialog_item_pressed"
        android:layout_width="match_parent"
        android:layout_height="52dp">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/arrow1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/selector_picker_arrow"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@drawable/selector_picker_text_color"
            android:gravity="start|center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/take_photo"
            android:clickable="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/userinfo_avatar_take_photo"/>
    </LinearLayout>
    <include layout="@layout/split_line_width_match_parent"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/choose"
        android:background="@drawable/selector_dialog_item_pressed"
        android:layout_width="match_parent"
        android:layout_height="52dp">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/arrow2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/selector_picker_arrow"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@drawable/selector_picker_text_color"
            android:gravity="start|center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/select_from_gallery"
            android:clickable="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/userinfo_avatar_from_gallery"/>
    </LinearLayout>
</LinearLayout>
