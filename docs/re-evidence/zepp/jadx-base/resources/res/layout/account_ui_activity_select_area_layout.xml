<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/s36"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="12sp"
        android:textColor="@color/s2"
        android:gravity="center_vertical"
        android:id="@+id/select_area_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/account_ui_size_15dp"
        android:layout_marginBottom="@dimen/account_ui_size_16dp"
        android:text="@string/account_ui_select_area_or_country_tips"
        android:layout_alignParentTop="true"
        android:layout_marginStart="@dimen/account_ui_size_18dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_current_area"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/account_ui_size_15dp"
        android:layout_below="@+id/select_area_content"
        android:layout_marginStart="@dimen/account_ui_size_18dp">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/s1"
            android:gravity="center_vertical"
            android:id="@+id/select_area_current_selected"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/item_checked"
            android:visibility="invisible"
            android:layout_width="@dimen/size_16dp"
            android:layout_height="@dimen/size_16dp"
            android:layout_marginLeft="@dimen/size_6pd"
            android:src="@drawable/account_ui_check"
            app:tint="@color/s1"/>
    </LinearLayout>
    <View
        android:id="@+id/select_area_divide"
        android:background="@color/s4"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_6pd"
        android:layout_below="@+id/ll_current_area"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/select_area_divide"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ListView
            android:id="@+id/select_area_list_view"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/s4"
            android:dividerHeight="1px"
            android:overScrollMode="never"
            android:paddingStart="@dimen/account_ui_size_18dp"
            android:paddingEnd="@dimen/account_ui_size_18dp"/>
        <com.huami.account.selectArea.baseui.IndexBar
            android:layout_gravity="end|center_vertical"
            android:id="@+id/indexBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/account_ui_size_13dp"
            android:minWidth="@dimen/size_16dp"
            android:minHeight="388dp"
            android:layout_below="@+id/select_area_content"
            android:layout_alignParentRight="true"
            app:indexBarTextSize="10sp"/>
    </FrameLayout>
</RelativeLayout>
