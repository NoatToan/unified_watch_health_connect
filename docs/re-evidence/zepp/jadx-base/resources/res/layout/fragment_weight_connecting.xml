<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/device_bind_rl"
    android:background="@color/one_foot_waiting_measuring_bg_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="20sp"
        android:gravity="center"
        android:id="@+id/title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="98dp"
        android:text="@string/weight_connecting"
        android:layout_centerHorizontal="true"
        style="@style/oneFootWaitingTitleStyle"/>
    <TextView
        android:textSize="14sp"
        android:id="@+id/sub_title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:text="@string/please_activate_device"
        android:layout_below="@+id/title_tv"
        android:layout_centerHorizontal="true"
        style="@style/oneFootWaitingTipStyle"/>
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="82dp"
        android:layout_below="@+id/sub_title_tv"
        android:layout_centerHorizontal="true">
        <com.huami.lib.view.progress.ProgressView
            android:layout_gravity="center"
            android:id="@+id/loading_view"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:progress="100"
            app:progressColor="@color/s14"
            app:strokeWidth="1.8dp"
            app:style="cycleLoading"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/device_img"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/img_bodyfat_blue"/>
    </FrameLayout>
    <TextView
        android:textSize="14sp"
        android:gravity="center"
        android:id="@+id/btn_cancel"
        android:padding="@dimen/bottom_button_padding"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="@string/cancel"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        style="@style/oneFootWaitingBottomCanCenButtonStyle"/>
</RelativeLayout>
