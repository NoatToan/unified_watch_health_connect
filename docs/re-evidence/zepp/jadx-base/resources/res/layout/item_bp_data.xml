<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container_bp_data_item"
    android:layout_width="match_parent"
    android:layout_height="@dimen/size_64">
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_item_history_first"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/body1s1"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/tv_item_history_first_status"
        android:layout_width="@dimen/size_16"
        android:layout_height="@dimen/size_16"
        android:src="@drawable/ic_bp_high"
        android:layout_marginStart="@dimen/size_4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_item_history_first"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_item_history_first_div"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/blood_pressure_div"
        android:paddingStart="@dimen/size_2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_item_history_first_status"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/body3s3"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_item_history_second"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/size_3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_item_history_first_div"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/body1s1"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/tv_item_history_second_status"
        android:layout_width="@dimen/size_16"
        android:layout_height="@dimen/size_16"
        android:src="@drawable/ic_bp_high"
        android:layout_marginStart="@dimen/size_4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_item_history_second"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_item_history_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/blood_pressure_unit"
        android:paddingStart="@dimen/size_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_item_history_second_status"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/body4s3"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/tv_item_history_device"
        android:layout_width="@dimen/size_12"
        android:layout_height="@dimen/size_12"
        android:layout_marginBottom="@dimen/size_2"
        android:layout_marginStart="@dimen/size_12"
        app:layout_constraintBottom_toBottomOf="@+id/tv_item_history_unit"
        app:layout_constraintStart_toEndOf="@+id/tv_item_history_unit"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_item_history_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/size_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/num7s2"/>
</androidx.constraintlayout.widget.ConstraintLayout>
