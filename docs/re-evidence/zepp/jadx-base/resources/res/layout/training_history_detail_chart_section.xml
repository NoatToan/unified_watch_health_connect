<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/chart_section"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp">
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/black70"
        android:gravity="center_horizontal"
        android:paddingTop="23dp"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="@string/heart_rate_chart"/>
    <RelativeLayout
        android:id="@+id/max_min_hr"
        android:paddingTop="18dp"
        android:layout_width="match_parent"
        android:layout_height="88dp">
        <View
            android:id="@+id/middle_divider"
            android:layout_height="44dp"
            android:layout_centerHorizontal="true"
            style="@style/HorizontalDivider"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="54dp"
            android:layout_toStartOf="@+id/middle_divider">
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="24sp"
                android:textColor="@color/black70"
                android:id="@+id/max_hr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:fontFamily="km"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/black40"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/training_max_hr"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="54dp"
            android:layout_toEndOf="@+id/middle_divider">
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="24sp"
                android:textColor="@color/black70"
                android:id="@+id/average_hr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:fontFamily="km"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/black40"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/average_heart_rate"/>
        </LinearLayout>
    </RelativeLayout>
    <FrameLayout
        android:id="@+id/no_hr_data"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="228dp">
        <View
            android:layout_gravity="bottom"
            android:background="@drawable/training_history_no_hr_chart_bg"
            android:layout_width="match_parent"
            android:layout_height="118dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/black20"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/no_training_hr_data"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/chart_container"
        android:layout_width="match_parent"
        android:layout_height="140dp"/>
    <View style="@style/VerticalDivider"/>
    <RelativeLayout
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_marginBottom="12dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="11sp"
            android:textColor="@color/black40"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:layout_centerVertical="true"
            android:fontFamily="km"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="11sp"
            android:textColor="@color/black40"
            android:id="@+id/chart_end_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:layout_centerVertical="true"
            android:fontFamily="km"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</LinearLayout>
