<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.lib.rainbow.titlebar.RainbowTitleBar
        android:id="@+id/tv_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menuIcon="@drawable/ic_edit_20"
        app:navigationIcon="@drawable/ic_arrow_back_20_2x"/>
    <FrameLayout
        android:id="@+id/status_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.huami.lib.view.widget.TipComponent
        android:layout_gravity="start"
        android:id="@+id/call_permission_tips"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.huami.lib.rainbow.ListTile
        android:id="@+id/call_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:ltv_checked="true"
        app:ltv_title="@string/incoming_call_alert_text"/>
    <com.huami.lib.rainbow.ListTile
        android:id="@+id/sms_item"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:itemSwitch="true"
        app:itemTitle="@string/sms_alert"/>
    <com.huami.lib.rainbow.ListTile
        android:id="@+id/notify_item"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:ltv_title="@string/app_notification_alert"
        app:ltv_trailing="@drawable/ic_arrow_forward_20_2x"/>
    <com.huami.lib.rainbow.ListTile
        android:id="@+id/smart_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:ltv_checked="true"
        app:ltv_subtitle="@string/earbud_smart_notify_tip"
        app:ltv_title="@string/earbud_smart_notify"/>
</LinearLayout>
