<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/s2"
        android:id="@+id/standard_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="9dp"
        android:text="@string/custom_vibrate_standard"
        android:layout_below="@+id/container"
        android:layout_marginStart="18dp"/>
    <View
        android:id="@+id/divider_1"
        android:background="@color/s4"
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider"
        android:layout_below="@+id/standard_tv"/>
    <com.xiaomi.hm.health.ui.smartplay.customvibrate.ui.SingleSelectView
        android:id="@+id/default_vibrate_sv_1"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_below="@+id/divider_1"/>
    <View
        android:id="@+id/divider_alarm"
        android:background="@color/s4"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider"
        android:layout_below="@+id/default_vibrate_sv_1"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"/>
    <com.xiaomi.hm.health.ui.smartplay.customvibrate.ui.SingleSelectView
        android:id="@+id/default_vibrate_sv_2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_below="@+id/divider_alarm"/>
    <View
        android:id="@+id/divider_2"
        android:background="@color/s4"
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider"
        android:layout_below="@+id/default_vibrate_sv_2"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/s2"
        android:id="@+id/custom_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="9dp"
        android:text="@string/custom_vibrate_diy"
        android:layout_below="@+id/divider_2"
        android:layout_marginStart="18dp"/>
    <View
        android:id="@+id/divider_3"
        android:background="@color/s4"
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider"
        android:layout_below="@+id/custom_tv"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/vibrate_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/action_container"
        android:layout_below="@+id/divider_3"
        android:overScrollMode="never"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/s1"
        android:id="@+id/empty_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:text="@string/custom_vibrate_empty"
        android:layout_below="@+id/divider_3"
        android:layout_centerHorizontal="true"/>
    <FrameLayout
        android:id="@+id/action_container"
        android:background="@color/s38"
        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:layout_alignParentBottom="true">
        <View
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider"/>
        <LinearLayout
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="9sp"
                android:textColor="@color/s2"
                android:gravity="center"
                android:id="@+id/edit_vibrate_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/custom_vibrate_edit"
                android:drawablePadding="3dp"
                app:drawableTopCompat="@drawable/icon_edit_selector"/>
            <TextView
                android:textSize="9sp"
                android:textColor="@color/s2"
                android:gravity="center"
                android:id="@+id/done_vibrate_tv"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/custom_vibrate_done"
                android:drawablePadding="3dp"
                app:drawableTopCompat="@drawable/layer_smart_alarm_done"/>
            <TextView
                android:textSize="9sp"
                android:textColor="@color/s2"
                android:gravity="center"
                android:id="@+id/add_vibrate_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/custom_vibrate_add"
                android:drawablePadding="3dp"
                android:layout_marginStart="50dp"
                app:drawableTopCompat="@drawable/icon_add_selector"/>
        </LinearLayout>
    </FrameLayout>
    <View
        android:id="@+id/mask_view"
        android:background="@color/mask_view"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/container"/>
</RelativeLayout>
