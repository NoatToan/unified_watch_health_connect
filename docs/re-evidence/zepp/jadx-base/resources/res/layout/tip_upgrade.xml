<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="bottom"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/rlyt_tip_container"
        android:background="@drawable/bg_tip_upgrade"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/iv_tips_left_img"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginTop="15dp"
            android:src="@drawable/ic_tips_icon_upgrade"
            android:layout_marginStart="14dp"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center_vertical"
            android:id="@+id/tv_tips_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:lines="1"
            android:layout_marginStart="5dp"
            android:layout_toEndOf="@+id/iv_tips_left_img"/>
        <TextView
            android:textColor="@color/white"
            android:id="@+id/tv_tips_info"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:maxHeight="90dp"
            android:layout_below="@+id/tv_tips_title"
            android:layout_marginEnd="30dp"
            android:layout_alignStart="@+id/tv_tips_title"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#ffec6616"
            android:gravity="center"
            android:id="@+id/btn_tip_upgrade"
            android:background="@drawable/bg_tip_upgrade_update_now"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="15dp"
            android:text="@string/update_now"
            android:layout_below="@+id/tv_tips_info"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:layout_alignStart="@+id/tv_tips_info"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#99ffffff"
            android:gravity="center"
            android:id="@+id/btn_tip_skip"
            android:background="@drawable/bg_tip_upgrade_skip"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="15dp"
            android:text="@string/interim_skip"
            android:layout_below="@+id/tv_tips_info"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginStart="15dp"
            android:layout_toEndOf="@+id/btn_tip_upgrade"/>
        <ImageView
            android:id="@+id/iv_tips_right_img"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="9dp"
            android:src="@drawable/ic_tip_close"
            android:scaleType="center"
            android:layout_marginEnd="10dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</RelativeLayout>
