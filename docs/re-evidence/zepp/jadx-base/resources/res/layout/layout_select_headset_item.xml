<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/peyto_container"
    android:background="@drawable/shape_corners_device_setting"
    android:layout_width="match_parent"
    android:layout_height="@dimen/size_100dp"
    android:layout_marginTop="@dimen/size_11dp"
    android:layout_marginStart="@dimen/td_size_10dp"
    android:layout_marginEnd="@dimen/td_size_10dp">
    <ImageView
        android:id="@+id/watch_img"
        android:layout_width="@dimen/dp_72"
        android:layout_height="@dimen/dp_72"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/size_12dp"/>
    <TextView
        android:textSize="@dimen/size_16sp"
        android:textColor="@color/s1"
        android:id="@+id/watch_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/size_92dp"
        style="@style/Rainbow.TextAppearance.Body3"/>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_arrow_right"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/size_20dp"
        android:layout_alignParentEnd="true"
        app:tint="@color/s2"/>
</RelativeLayout>
