<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/dialog_empty_invoice_area"/>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/dialog_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/size_14.5sp"
                android:textColor="@color/s2"
                android:gravity="center"
                android:id="@+id/tv_recharge_invoice"
                android:background="@drawable/btn_click_bg_round_top"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_48dp"
                android:text="@string/wl_recharge_invoice"/>
            <View
                android:background="@color/black20"
                android:layout_width="match_parent"
                android:layout_height="1px"/>
            <TextView
                android:textSize="@dimen/size_14.5sp"
                android:textColor="@color/s2"
                android:gravity="center"
                android:id="@+id/tv_service_invoice"
                android:background="@drawable/btn_click_bg_round_bottom"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_48dp"
                android:text="@string/wl_service_invoice"/>
        </LinearLayout>
        <FrameLayout
            android:background="@drawable/dialog_bg"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_52dp"
            android:layout_marginTop="@dimen/size_8dp">
            <TextView
                android:textSize="@dimen/size_13sp"
                android:textColor="@color/s1"
                android:gravity="center"
                android:id="@+id/tv_cancel"
                android:background="@drawable/btn_click_bg_round_dialog"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/wl_cancel"/>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
