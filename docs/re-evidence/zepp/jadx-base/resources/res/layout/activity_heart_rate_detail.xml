<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#f8f8f8"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:id="@+id/heart_value_area"
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="206dp">
                <com.huami.widget.typeface.TypefaceTextView
                    android:textSize="48sp"
                    android:textColor="@color/black"
                    android:layout_gravity="center"
                    android:id="@+id/hr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="37dp"
                    android:text="@string/zero_value"
                    android:layout_centerHorizontal="true"
                    android:fontFamily="km"/>
                <TextView
                    android:textSize="9.3sp"
                    android:textColor="@color/white60"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/unit_hr"
                    android:maxLines="1"
                    android:layout_alignBaseline="@+id/hr"
                    android:layout_alignBottom="@+id/hr"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="5dp"
                    android:layout_toEndOf="@+id/hr"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#8d8d8d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pre_measure"
                    android:layout_below="@+id/hr"
                    android:layout_centerHorizontal="true"/>
            </RelativeLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/heart_value_area">
                <View
                    android:background="#f8f8f8"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/black70"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="19.2dp"
                    android:text="@string/quite_heart_rate"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#8d8d8d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/quite_heart_rate_tip"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"/>
                <View
                    android:background="#f8f8f8"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:layout_marginTop="19.2dp"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/black70"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="19.2dp"
                    android:text="@string/hr_sport"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#8d8d8d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/hr_section_desc"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"/>
                <com.huami.view.weightfigure.WeightFigureView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/hr_figure_view"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="18dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    app:type="unmoveable"/>
                <com.xiaomi.hm.health.baseui.widget.SportHeartRateView
                    android:id="@+id/hr_sport_view"
                    android:paddingBottom="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="18dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    app:isInScrollView="true"/>
            </LinearLayout>
        </RelativeLayout>
    </ScrollView>
    <FrameLayout
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="@dimen/chart_bottom_bar_height">
        <View style="@style/VerticalDivider"/>
        <TextView
            android:textSize="9sp"
            android:textColor="@color/black40"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/delete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/delete"
            android:drawablePadding="3dp"
            app:drawableTopCompat="@drawable/selector_delete"/>
    </FrameLayout>
</LinearLayout>
