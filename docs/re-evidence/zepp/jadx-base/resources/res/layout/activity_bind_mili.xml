<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/device_bind_rl"
    android:background="@color/s36"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="20sp"
        android:textColor="@color/s1"
        android:gravity="center"
        android:id="@+id/title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="98dp"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/s2"
        android:gravity="center"
        android:id="@+id/sub_title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:layout_below="@+id/title_tv"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"/>
    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:layout_marginTop="151dp">
        <com.xiaomi.hm.health.device.view.HMLoadingView
            android:id="@+id/loading_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/device_img"
            android:background="@color/s36"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <com.xiaomi.hm.health.device.earbud.view.EarbudImageView
            android:layout_gravity="center"
            android:id="@+id/earbud_device_img"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/vibrate_img"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/img_miband_vibrate"/>
        <RelativeLayout
            android:layout_gravity="center"
            android:id="@+id/bind_weight_rl"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="52sp"
                android:textColor="@color/s14"
                android:id="@+id/bind_weight_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="000.0"
                android:layout_centerInParent="true"
                android:fontFamily="km"/>
            <TextView
                android:textSize="13.4sp"
                android:textColor="@color/s15"
                android:id="@+id/bind_weight_value_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignBaseline="@+id/bind_weight_value"
                android:layout_toEndOf="@+id/bind_weight_value"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_gravity="center"
            android:id="@+id/blue_monkey_vibrate_rl"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/left_vibrate_img"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/img_left_zzzz"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/img_right_zzzz"
                android:layout_marginStart="160dp"
                android:layout_toEndOf="@+id/left_vibrate_img"/>
        </RelativeLayout>
    </FrameLayout>
    <ImageView
        android:id="@+id/accept_img"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="276dp"
        android:src="@drawable/img_accept"
        android:layout_marginStart="192dp"/>
    <ImageView
        android:id="@+id/normandy_left_img"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="303dp"
        android:src="@drawable/img_left_zzzz"
        android:layout_marginStart="119dp"
        android:layout_alignParentStart="true"/>
    <ImageView
        android:id="@+id/normandy_right_img"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="303dp"
        android:src="@drawable/img_right_zzzz"
        android:layout_marginStart="119dp"
        android:layout_marginEnd="119dp"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/s1"
        android:gravity="center"
        android:id="@+id/cancel_tv"
        android:background="@drawable/bg_bind_device_cancel"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="20dp"
        android:text="@string/cancel"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="horizontal"
        android:id="@+id/ll_bottom"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/s1"
            android:gravity="center"
            android:id="@+id/tv_bottom_left"
            android:background="@drawable/bg_bind_device_cancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="@string/not_bind_now"
            android:layout_weight="1"/>
        <Space
            android:layout_width="21dp"
            android:layout_height="0dp"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/p3"
            android:gravity="center"
            android:id="@+id/tv_bottom_right"
            android:background="@drawable/bg_bind_device_cancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="@string/retry"
            android:layout_weight="1"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/s2"
        android:id="@+id/bottom_tv"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="35dp"
        android:text="@string/bind_mili_not_shake"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
    <ViewStub
        android:id="@+id/viewstub_bind_headset"
        android:layout="@layout/bind_headset_search_hint"
        android:inflatedId="@+id/bind_headset_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size_28dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
    <FrameLayout
        android:id="@+id/introduce_fragment"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</RelativeLayout>
