<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <RelativeLayout
            android:orientation="vertical"
            android:background="@color/s10"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.huami.watch.companion.firstbeat.VO2maxView
                android:id="@+id/view_run_vo2max"
                android:background="@color/s38"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10.5dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/view_chart"
                android:background="@color/s38"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/view_run_vo2max">
                <TextView
                    android:textStyle="bold"
                    android:textColor="@color/s1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/history_vo2max"
                    android:layout_marginStart="20dp"
                    style="@style/Rainbow.TextAppearance.Body4"/>
                <com.huami.watch.companion.ui.view.PagerSlidingTabStrip
                    android:id="@+id/indicator"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginStart="65dp"
                    android:layout_marginEnd="65dp"
                    app:pstsIndicatorColor="@color/s1"
                    app:pstsIndicatorWidth="22dp"
                    app:pstsTabTextColor="@color/companion_tab_selector_color"
                    app:pstsTabTextSize="14sp"
                    app:pstsTabTextStyle="bold"/>
                <com.huami.watch.companion.firstbeat.NoScrollViewPager
                    android:id="@+id/view_pager"
                    android:layout_width="match_parent"
                    android:layout_height="230dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/view_desc"
                android:background="@color/s38"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10.2dp"
                android:layout_below="@+id/view_chart"
                android:paddingStart="20dp"
                android:paddingEnd="31dp">
                <TextView
                    android:textStyle="bold"
                    android:textColor="@color/s1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/vo2max_des_title"
                    style="@style/Rainbow.TextAppearance.Body4"/>
                <TextView
                    android:textColor="@color/s1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15.3dp"
                    android:layout_marginBottom="20dp"
                    android:text="@string/vo2max_des_info"
                    android:lineSpacingExtra="5.3sp"
                    style="@style/Rainbow.TextAppearance.Body5"/>
            </LinearLayout>
            <TextView
                android:textColor="@color/s3"
                android:id="@+id/jp_hint_text"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="20dp"
                android:layout_below="@+id/view_desc"
                android:layout_marginStart="25dp"
                android:layout_marginEnd="25dp"
                style="@style/Rainbow.TextAppearance.Body5"/>
        </RelativeLayout>
    </ScrollView>
</FrameLayout>
