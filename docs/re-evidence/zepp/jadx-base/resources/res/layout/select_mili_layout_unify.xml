<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/size_15dp"
    android:paddingEnd="@dimen/size_15dp">
    <RelativeLayout
        android:orientation="vertical"
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <TextView
            android:textSize="18sp"
            android:textColor="@color/s1"
            android:gravity="center"
            android:id="@+id/tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="98dp"
            android:text="@string/select_mili_tips_1"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/s2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/select_mili_tips_2"
            android:layout_below="@+id/tips"
            android:layout_centerHorizontal="true"/>
        <ListView
            android:id="@+id/mili_device_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:divider="@color/transparent"
            android:dividerHeight="@dimen/size_15dp"
            android:layout_below="@+id/tips"/>
    </RelativeLayout>
    <Button
        android:textColorHint="@color/rainbow_btn_stroke_text_color_selector"
        android:id="@+id/select_mili_other_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_15dp"
        android:text="@string/search_other_mili"
        style="?attr/buttonStyleGray_48_flat"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/s1"
        android:gravity="center"
        android:id="@+id/select_mili_quit_tv"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="@dimen/size_15dp"
        android:layout_marginBottom="@dimen/size_15dp"
        android:text="@string/cancel_bind"/>
</LinearLayout>
