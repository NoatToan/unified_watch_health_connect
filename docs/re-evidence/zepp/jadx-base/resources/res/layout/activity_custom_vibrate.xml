<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/record_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/s1"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="68dp"
            android:text="@string/custom_vibrate_vibrate_tips"/>
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/device_img"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="140dp"
            android:src="@drawable/img_miband"/>
        <RelativeLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/vibrate_img_gt"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="158dp">
            <ImageView
                android:id="@+id/left_vibrate_img"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/img_left_zzzz"/>
            <ImageView
                android:id="@+id/right_vibrate_img"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/img_right_zzzz"
                android:layout_marginStart="100dp"
                android:layout_toEndOf="@+id/left_vibrate_img"/>
        </RelativeLayout>
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/vibrate_img"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="140dp"
            android:src="@drawable/img_miband_vibrate"/>
        <TextView
            android:textColor="@color/s2"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/vibrate_too_long_tv"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="348dp"
            android:text="@string/custom_vibrate_too_long_new"/>
    </FrameLayout>
    <com.xiaomi.hm.health.ui.smartplay.customvibrate.ui.CustomVibrateIndicator
        android:id="@+id/custom_indicator"
        android:layout_width="match_parent"
        android:layout_height="7dp"
        android:layout_marginBottom="6dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:enabled="false"
            android:textSize="14sp"
            android:textColor="@drawable/vibrate_bottom_text"
            android:gravity="center"
            android:layout_gravity="start"
            android:id="@+id/vibrate_on_device_btn"
            android:layout_width="144dp"
            android:layout_height="92dp"
            android:text="@string/custom_vibrate_vibrate_on_device"/>
        <TextView
            android:enabled="false"
            android:textSize="14sp"
            android:textColor="@drawable/vibrate_bottom_text"
            android:gravity="center"
            android:layout_gravity="end"
            android:id="@+id/stop_btn"
            android:layout_width="144dp"
            android:layout_height="92dp"
            android:text="@string/custom_vibrate_vibrate_stop"/>
    </FrameLayout>
</LinearLayout>
