<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.lib.rainbow.titlebar.RainbowTitleBar
        android:id="@+id/actionbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_arrow_back_20_2x"
        app:title="@string/as_quick_card_setting"
        style="@style/Rainbow.TextAppearance.Title3"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/lien_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="@dimen/size_15dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/lien_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="@dimen/size_15dp"/>
    <com.huami.lib.rainbow.ListTile
        android:id="@+id/item_show_attention"
        android:background="@drawable/shape_corners_device_setting"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_15dp"
        app:layout_constraintEnd_toStartOf="@+id/lien_end"
        app:layout_constraintStart_toStartOf="@+id/lien_start"
        app:layout_constraintTop_toBottomOf="@+id/actionbar"
        app:ltv_checked="true"
        app:ltv_title="@string/as_smart_display_calendar"/>
    <com.huami.lib.rainbow.ListTile
        android:id="@+id/item_card_setting"
        android:background="@drawable/shape_corners_device_setting"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:layout_constraintEnd_toStartOf="@+id/lien_end"
        app:layout_constraintStart_toStartOf="@+id/lien_start"
        app:layout_constraintTop_toBottomOf="@+id/item_show_attention"
        app:ltv_subtitle="@string/as_quick_card_desc_card_set"
        app:ltv_title="@string/as_smart_card_setting"/>
</androidx.constraintlayout.widget.ConstraintLayout>
