<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/mili_setting_sport_item"
    android:background="@drawable/bg_item"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="@dimen/draglist_item_height"
    android:paddingStart="@dimen/size_16dp"
    android:paddingEnd="@dimen/size_16dp">
    <ImageView
        android:gravity="center_vertical"
        android:id="@+id/mili_setting_sport_img"
        android:focusable="false"
        android:visibility="visible"
        android:clickable="false"
        android:layout_width="60dp"
        android:layout_height="match_parent"
        android:src="@drawable/device_list_icon_arrange"
        android:paddingStart="23dp"
        android:paddingEnd="21dp"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:textSize="@dimen/draglist_itemtext_size"
        android:textColor="#e6000000"
        android:gravity="center_vertical"
        android:id="@+id/mili_sport_type_name"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_toEndOf="@+id/mili_setting_sport_img"/>
    <ImageView
        android:layout_width="16dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_list_item_right_arrow"
        android:scaleType="fitCenter"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
