<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/dialog_empty_area"/>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/dialog_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="@dimen/person_info_setting_title_height"
            android:text="@string/earbud_play_time"
            style="@style/birthdayStyle"/>
        <View
            android:background="@color/black20"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/wheels"
            android:layout_width="match_parent"
            android:layout_height="@dimen/wheel_hight">
            <com.huami.widget.wheelview.WheelView
                android:id="@+id/time_wheel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </LinearLayout>
        <View
            android:background="@color/black20"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <LinearLayout
            android:orientation="horizontal"
            android:background="@color/trans"
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_height_max">
            <TextView
                android:gravity="center"
                android:id="@+id/btn_cancel"
                android:background="@drawable/btn_click_bg_round_dialog_bottom_left"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/cancel"
                android:layout_weight="1"
                style="@style/birthdayBtnCancelStyle"/>
            <View
                android:background="@color/black_20_percent"
                android:layout_width="1px"
                android:layout_height="match_parent"
                style="@style/separationStyle2"/>
            <TextView
                android:gravity="center"
                android:id="@+id/btn_save"
                android:background="@drawable/btn_click_bg_round_dialog_bottom_right"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/btn_confirm"
                android:layout_weight="1"
                style="@style/birthdayBtnSaveStyle"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
