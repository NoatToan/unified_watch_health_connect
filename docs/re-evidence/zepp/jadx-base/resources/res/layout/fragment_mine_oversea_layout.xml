<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.lib.view.scroll.HMScrollView
        android:id="@+id/mine_hmscrollview"
        android:scrollbars="none"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/mine_header_bg"
                android:layout_width="0dp"
                android:layout_height="190dp"
                android:src="@drawable/mine_home_header_bg"
                android:scaleType="fitXY"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/p_start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_begin="0dp"/>
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/p_end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_end="0dp"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/mine_home_head_card"
                android:background="@drawable/mine_home_info_item_bg"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_marginTop="190dp"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <com.xiaomi.hm.health.view.ImageItem
                    android:id="@+id/mine_health"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:image_background_color="@color/s15"
                    app:image_src="@drawable/ic_first_aid_24"
                    app:image_src_tint="@color/s5"
                    app:item_name="@string/health_label_my_health"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/medal"
                    app:layout_constraintHorizontal_weight="1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.xiaomi.hm.health.view.ImageItem
                    android:id="@+id/medal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:image_background_color="@color/s25"
                    app:image_src="@drawable/ic_my_medal_24"
                    app:image_src_tint="@color/s5"
                    app:item_name="@string/mine_medal_new"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/mine_order"
                    app:layout_constraintHorizontal_weight="1"
                    app:layout_constraintStart_toEndOf="@+id/mine_health"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.xiaomi.hm.health.view.ImageItem
                    android:id="@+id/mine_order"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:image_background_color="@color/s15"
                    app:image_src="@drawable/ic_my_record_24"
                    app:image_src_tint="@color/s5"
                    app:item_name="@string/mine_record"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/report"
                    app:layout_constraintHorizontal_weight="1"
                    app:layout_constraintStart_toEndOf="@+id/medal"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.xiaomi.hm.health.view.ImageItem
                    android:id="@+id/report"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:image_background_color="@color/s20"
                    app:image_src="@drawable/ic_my_weekly_report_24"
                    app:image_src_tint="@color/s5"
                    app:item_name="@string/mine_week_report"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_weight="1"
                    app:layout_constraintStart_toEndOf="@+id/mine_order"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.constraintlayout.widget.Group
                    android:id="@+id/mine_group"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:constraint_referenced_ids="mine_health                             ,medal,mine_order,report,mine_home_head_card"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.cardview.widget.CardView
                android:layout_width="82dp"
                android:layout_height="82dp"
                android:layout_marginTop="74dp"
                android:layout_marginEnd="15dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="41dp"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <com.huami.lib.view.image.CircleImageView
                    android:id="@+id/mine_person_icon"
                    android:layout_width="82dp"
                    android:layout_height="82dp"
                    android:src="@drawable/setting_avatar_default"
                    android:elevation="@dimen/mine_head_image_ele"
                    app:civ_border_color="@color/white_60"
                    app:civ_border_width="1.3dp"
                    app:civ_fill_color="@color/white60"
                    app:hm_civ_mask_color="@color/black30"
                    app:hm_civ_show_mask="true"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/avatar_in_audit"
                    android:background="@color/s1"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/account_ui_in_audit"
                    android:alpha="0.5"
                    android:elevation="@dimen/mine_head_image_ele"/>
            </androidx.cardview.widget.CardView>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/s5"
                android:ellipsize="end"
                android:id="@+id/mine_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="81dp"
                android:maxWidth="250dp"
                android:maxLines="1"
                android:fontFamily="lt-bold"
                android:layout_marginStart="15dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textColor="#b2b2b2"
                android:id="@+id/nickname_audit"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/account_ui_in_audit"
                app:layout_constraintStart_toStartOf="@+id/mine_name"
                app:layout_constraintTop_toBottomOf="@+id/mine_name"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textColor="@color/s2"
                android:gravity="center"
                android:id="@+id/mine_goals"
                android:background="@drawable/mine_home_standards_bg"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:drawablePadding="2dp"
                android:drawableStart="@drawable/ic_standards_18"
                android:fontFamily="lt"
                android:paddingStart="4dp"
                android:paddingEnd="8dp"
                android:layout_marginStart="15dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/nickname_audit"
                style="@style/Rainbow.TextAppearance.Body5"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/mine_home_device_card"
                android:background="@drawable/mine_home_info_item_bg"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/mine_home_head_card"
                app:layout_goneMarginTop="205dp">
                <com.huami.widget.typeface.TypefaceTextView
                    android:textColor="@color/s1"
                    android:gravity="start"
                    android:id="@+id/mine_device_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/mine_device"
                    android:layout_marginStart="15dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/Rainbow.TextAppearance.Title3"/>
                <TextView
                    android:textColor="@color/cl_ff5353"
                    android:id="@+id/tv_add_device_title"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:text="@string/smart_alarm_add"
                    android:drawablePadding="3dp"
                    android:layout_marginEnd="15dp"
                    app:drawableStartCompat="@drawable/ic_my_device_add"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <View
                    android:id="@+id/divider_mine_device"
                    android:background="@color/s4"
                    android:layout_width="match_parent"
                    android:layout_height="0.8dp"
                    android:layout_marginTop="11dp"
                    android:layout_marginStart="15dp"
                    android:layout_marginEnd="20dp"
                    app:layout_constraintTop_toBottomOf="@+id/mine_device_title"/>
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/divider_mine_device">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/mine_device_list"
                            android:paddingBottom="6dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <ImageView
                            android:id="@+id/iv_device_fold"
                            android:visibility="gone"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:src="@drawable/ic_my_device_fold"
                            android:scaleType="center"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/mine_device_list"/>
                        <TextView
                            android:textSize="15sp"
                            android:textColor="@color/p4"
                            android:gravity="center"
                            android:id="@+id/mine_add_device_bound"
                            android:background="@drawable/mine_home_add_device_bg"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_margin="15dp"
                            android:text="@string/mine_add_device"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/mine_device_list"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </FrameLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/mine_home_more_card"
                android:background="@drawable/mine_home_info_item_bg"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/mine_home_device_card">
                <com.huami.widget.typeface.TypefaceTextView
                    android:textColor="@color/s1"
                    android:gravity="start"
                    android:id="@+id/mine_more"
                    android:paddingTop="20.3dp"
                    android:paddingBottom="7.7dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/more"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/Rainbow.TextAppearance.Title3"/>
                <View
                    android:id="@+id/divider_mine_more"
                    android:background="@color/s4"
                    android:layout_width="match_parent"
                    android:layout_height="0.8dp"
                    android:layout_marginStart="15dp"
                    android:layout_marginEnd="15dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/mine_more"/>
                <androidx.cardview.widget.CardView
                    android:id="@+id/mine_more_layout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/s38"
                    app:cardCornerRadius="0dp"
                    app:cardElevation="0dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/divider_mine_more">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingStart="@dimen/mine_padding"
                        android:paddingEnd="@dimen/mine_padding">
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/item_nps_layout"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <com.huami.lib.rainbow.ListTile
                            android:id="@+id/mine_course"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:backgroundTint="@color/s38"
                            app:layout_constraintTop_toBottomOf="@+id/item_nps_layout"
                            app:ltv_title="@string/mine_course"/>
                        <com.huami.lib.rainbow.ListTile
                            android:id="@+id/item_sport_goal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:layout_constraintTop_toBottomOf="@+id/mine_course"
                            app:ltv_title="@string/mine_goals"/>
                        <com.huami.lib.rainbow.ListTile
                            android:id="@+id/item_my_record"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:layout_constraintTop_toBottomOf="@+id/item_sport_goal"
                            app:ltv_title="@string/mine_record"/>
                        <com.huami.lib.rainbow.ListTile
                            android:id="@+id/item_smart"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:layout_constraintTop_toBottomOf="@+id/item_my_record"
                            app:ltv_title="@string/mine_item_smart"/>
                        <com.huami.lib.rainbow.ListTile
                            android:id="@+id/item_friends"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:layout_constraintTop_toBottomOf="@+id/item_smart"
                            app:ltv_title="@string/mine_item_friends"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.cardview.widget.CardView>
                <com.huami.training.ui.widget.CourseCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/s38"
                    app:cardElevation="0dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/mine_more_layout">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="@dimen/mine_padding"
                        android:paddingEnd="@dimen/mine_padding">
                        <com.huami.lib.rainbow.ListTile
                            android:id="@+id/item_third"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:ltv_title="@string/third_bind"/>
                        <com.huami.lib.rainbow.ListTile
                            android:id="@+id/item_feed_back"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:ltv_title="@string/feedback_title_new"/>
                        <com.huami.lib.rainbow.ListTile
                            android:id="@+id/item_analyse"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:ltv_title="@string/ai_analysis"/>
                        <com.huami.lib.rainbow.ListTile
                            android:id="@+id/item_settings"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:ltv_title="@string/mine_item_settings"/>
                    </LinearLayout>
                </com.huami.training.ui.widget.CourseCardView>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <View
                android:layout_width="0dp"
                android:layout_height="30dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/mine_home_more_card"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.huami.lib.view.scroll.HMScrollView>
    <View
        android:id="@+id/top_mask"
        android:background="@color/s10"
        android:layout_width="0dp"
        android:layout_height="30dp"
        android:alpha="0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <RelativeLayout
        android:orientation="horizontal"
        android:id="@+id/mine_toolbar"
        android:background="@color/s10"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:alpha="0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="17.3sp"
            android:textColor="@color/s1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/homepage_item_mine"
            android:layout_centerInParent="true"
            android:fontFamily="lt"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/mine_message_layout"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:layout_marginEnd="@dimen/size_10dp"
        app:layout_constraintBottom_toBottomOf="@+id/mine_toolbar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/mine_toolbar">
        <ImageView
            android:id="@+id/mine_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_notifications_20"
            android:layout_centerInParent="true"
            android:layout_marginEnd="30dp"
            app:tint="@color/s2"/>
        <TextView
            android:textSize="@dimen/size_12sp"
            android:textColor="@color/s1"
            android:gravity="center"
            android:id="@+id/tv_red_dot"
            android:background="@drawable/ic_red_circle_border"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/size_20dp"
            android:layout_marginTop="7dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:layout_marginStart="-20dp"
            android:layout_toEndOf="@+id/mine_message"/>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
