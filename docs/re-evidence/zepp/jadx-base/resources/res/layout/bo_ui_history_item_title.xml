<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/line_top"
        android:background="@color/s3"
        android:layout_width="@dimen/bo_ui_size_1dp"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/bo_ui_size_2dp"
        app:layout_constraintBottom_toTopOf="@+id/dot"
        app:layout_constraintEnd_toEndOf="@+id/dot"
        app:layout_constraintStart_toStartOf="@+id/dot"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:background="@color/s3"
        android:layout_width="@dimen/bo_ui_size_1dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/bo_ui_size_2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/dot"
        app:layout_constraintStart_toStartOf="@+id/dot"
        app:layout_constraintTop_toBottomOf="@+id/dot"/>
    <View
        android:id="@+id/dot"
        android:background="@drawable/bo_ui_dot"
        android:layout_width="@dimen/bo_ui_size_9dp"
        android:layout_height="@dimen/bo_ui_size_9dp"
        app:layout_constraintBottom_toBottomOf="@+id/date"
        app:layout_constraintEnd_toStartOf="@+id/date"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/date"/>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/s1"
        android:id="@+id/year"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/bo_ui_size_12dp"
        android:layout_marginStart="@dimen/bo_ui_size_30dp"
        app:layout_constraintBottom_toTopOf="@+id/date"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/s1"
        android:id="@+id/date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/bo_ui_size_3dp"
        android:layout_marginBottom="@dimen/bo_ui_size_10dp"
        android:layout_marginStart="@dimen/bo_ui_size_30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/year"
        app:layout_goneMarginTop="@dimen/bo_ui_size_12dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
