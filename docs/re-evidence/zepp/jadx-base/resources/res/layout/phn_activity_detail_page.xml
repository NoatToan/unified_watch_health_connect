<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/view_pager_chart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <include
            android:id="@+id/include_card_training_status"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            layout="@layout/phn_card_training_status"/>
        <include
            android:id="@+id/include_today_plan_status_card"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            layout="@layout/phn_card_today_plan_status"/>
        <include
            android:id="@+id/include_today_plan_data_card"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            layout="@layout/phn_card_today_plan_data"/>
        <TextView
            android:textColor="@color/s3"
            android:layout_gravity="center"
            android:id="@+id/tv_currently_using_device"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="19dp"
            style="@style/Rainbow.TextAppearance.Body5"/>
        <TextView
            android:textColor="@color/s3"
            android:layout_gravity="center"
            android:id="@+id/tv_device_update_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="52dp"
            style="@style/Rainbow.TextAppearance.Body5"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
