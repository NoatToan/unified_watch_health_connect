<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.watch.companion.ui.view.ActionbarLayout
        android:id="@+id/actionbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#e6000000"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/find_watch_loading"
        android:lineSpacingExtra="0sp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#80000000"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/find_watch_msg"/>
    <RelativeLayout
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_marginTop="100dp">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/find_watch_bg"
            android:scaleType="fitXY"/>
        <ImageView
            android:id="@+id/point_one"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="42dp"
            android:src="@drawable/find_watch_point"
            android:alpha="1"
            android:layout_marginStart="42dp"/>
        <ImageView
            android:id="@+id/point_two"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="66dp"
            android:src="@drawable/find_watch_point"
            android:alpha="0"
            android:layout_marginEnd="34dp"
            android:layout_alignParentEnd="true"/>
        <ImageView
            android:id="@+id/point_three"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30dp"
            android:src="@drawable/find_watch_point"
            android:layout_alignParentBottom="true"
            android:alpha="0.5"
            android:layout_marginStart="30dp"/>
        <ImageView
            android:id="@+id/scan"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/find_watch_scanning"
            android:scaleType="fitXY"/>
        <ImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/find_watch_device"
            android:scaleType="fitXY"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
</LinearLayout>
