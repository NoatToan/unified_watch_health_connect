<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s38"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/s10"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:background="@color/s38"
            android:layout_width="match_parent"
            android:layout_height="?android:attr/actionBarSize"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="start|center_vertical"
                android:id="@+id/btn_back"
                android:background="@null"
                android:layout_width="@dimen/size_29dp"
                android:layout_height="@dimen/size_27dp"
                android:src="@drawable/arrow_back_black"
                android:scaleType="center"
                android:tint="@color/s1"
                android:layout_marginStart="@dimen/size_10dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/top_line"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/s1"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/display_brightness_title"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/size_24dp"
                android:text="@string/ds_display_brightness"/>
        </androidx.appcompat.widget.Toolbar>
        <FrameLayout
            android:id="@+id/container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="vertical"
                android:background="@drawable/shape_corners_device_setting"
                android:paddingTop="@dimen/size_6dp"
                android:paddingBottom="@dimen/size_6dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_12dp"
                android:layout_marginStart="@dimen/size_15dp"
                android:layout_marginEnd="@dimen/size_15dp">
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/device_setting_automatic_brightness"
                    android:background="@color/s38"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-4dp"
                    app:ltv_title="@string/ds_automati_brightness"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/d_setting_brightness_ViewGroup"
                    android:background="@color/s38"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size_74dp">
                    <TextView
                        android:textSize="15sp"
                        android:textColor="@color/s1"
                        android:gravity="center_vertical"
                        android:id="@+id/d_setting_brightness"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/size_12dp"
                        android:text="@string/ds_brightness"
                        android:layout_marginStart="@dimen/size_16dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <ImageView
                        android:id="@+id/td_icon_brightness_start"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/size_14dp"
                        android:layout_marginBottom="@dimen/size_17dp"
                        android:src="@drawable/device_setting_brightness_start"
                        android:tint="@color/s2"
                        android:layout_marginStart="@dimen/size_16dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/d_setting_brightness"/>
                    <ImageView
                        android:id="@+id/td_icon_brightness_end"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/device_setting_brightness_end"
                        android:tint="@color/s2"
                        android:layout_marginEnd="@dimen/size_14dp"
                        app:layout_constraintBottom_toBottomOf="@+id/td_icon_brightness_start"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/td_icon_brightness_start"/>
                    <SeekBar
                        android:id="@+id/device_setting_light_controller"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:maxHeight="@dimen/size_2dp"
                        android:progressDrawable="@drawable/device_setting_seekbar_style"
                        android:minHeight="@dimen/size_2dp"
                        android:thumb="@drawable/device_setting_dot"
                        android:layout_marginStart="@dimen/size_10dp"
                        android:layout_marginEnd="@dimen/size_10dp"
                        android:splitTrack="false"
                        app:layout_constraintBottom_toBottomOf="@+id/td_icon_brightness_start"
                        app:layout_constraintEnd_toStartOf="@+id/td_icon_brightness_end"
                        app:layout_constraintStart_toEndOf="@+id/td_icon_brightness_start"
                        app:layout_constraintTop_toTopOf="@+id/td_icon_brightness_start"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/device_setting_auto_screen"
                    android:background="@color/s38"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-4dp"
                    app:ltv_divider_color="@color/s4"
                    app:ltv_divider_padding="all"
                    app:ltv_title="@string/watch_setting_bright_screen_time"/>
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/ds_interest_screen_display"
                    android:background="@color/s38"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-4dp"
                    app:ltv_divider_color="@color/s4"
                    app:ltv_divider_padding="all"
                    app:ltv_title="@string/ds_interest_screen_display"/>
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/mili_setting_ges_screen_ll"
                    android:background="@color/s38"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-4dp"
                    app:ltv_title="@string/mili_setting_ges_screen"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <View
                android:id="@+id/mask_view"
                android:background="@color/cl_4d000000"
                android:focusable="true"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
