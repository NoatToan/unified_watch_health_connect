<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/wf_watch_face_detail_bg"
    android:focusableInTouchMode="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.watchfacesstore.view.CommonTitleBar
        android:id="@+id/common_title_bar"
        app:titleText=""
        style="@style/CommonTitleBar"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/layout_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="30dp">
            <FrameLayout
                android:id="@+id/fl_image"
                android:layout_width="250dp"
                android:layout_height="290dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:id="@+id/iv_device_bg"
                    android:layout_width="250dp"
                    android:layout_height="290dp"
                    android:src="@drawable/wf_img_circle_default"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/iv_device_preview"
                    android:layout_width="146dp"
                    android:layout_height="146dp"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/iv_device_transparent"
                    android:layout_width="146dp"
                    android:layout_height="146dp"/>
            </FrameLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_device_detail"
                android:background="@drawable/wf_item_common_bg"
                android:padding="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                app:layout_constraintTop_toBottomOf="@+id/fl_image">
                <TextView
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:id="@+id/tv_watch_face_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:textDirection="locale"
                    android:paddingEnd="4dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#ffffff"
                    android:id="@+id/tv_power_consumption_short"
                    android:background="@drawable/wf_label_bg"
                    android:visibility="invisible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/wf_text_power_consumption"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_watch_face_name"
                    app:layout_constraintStart_toEndOf="@+id/tv_watch_face_name"
                    app:layout_constraintTop_toTopOf="@+id/tv_watch_face_name"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#ffffff"
                    android:id="@+id/tv_power_consumption_long"
                    android:background="@drawable/wf_label_bg"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/wf_text_power_consumption"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    app:layout_constraintStart_toStartOf="@+id/tv_watch_face_name"
                    app:layout_constraintTop_toBottomOf="@+id/tv_watch_face_name"/>
                <androidx.constraintlayout.widget.Barrier
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:barrierDirection="start"
                    app:constraint_referenced_ids="iv_is_collect"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:orientation="horizontal"
                    android:id="@+id/infoLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    app:layout_constraintTop_toBottomOf="@+id/tv_power_consumption_long">
                    <TextView
                        android:textColor="@color/wf_text_light_white"
                        android:ellipsize="end"
                        android:id="@+id/publisherNameTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/WFContentTextStyle"/>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/packageInfoLayout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/publisherNameTv"
                        app:layout_constraintTop_toTopOf="parent">
                        <View
                            android:id="@+id/publisherNameDivider"
                            style="@style/WFDetailVerticalDivider"/>
                        <TextView
                            android:textColor="@color/wf_text_light_white"
                            android:id="@+id/packageSizeTv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="10dp"
                            style="@style/WFContentTextStyle"/>
                        <View
                            android:id="@+id/packageSizeDivider"
                            style="@style/WFDetailVerticalDivider"/>
                        <TextView
                            android:textColor="@color/wf_text_light_white"
                            android:id="@+id/moneyTv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="10dp"
                            style="@style/WFContentTextStyle"/>
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <ImageView
                    android:id="@+id/iv_is_collect"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tv_watch_face_name"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/wf_text_light_white"
                    android:id="@+id/tv_watch_face_intro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textDirection="locale"
                    android:layout_marginEnd="3dp"
                    app:layout_constraintTop_toBottomOf="@+id/infoLayout"/>
                <View
                    android:id="@+id/divider"
                    android:background="#1affffff"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="15dp"
                    app:layout_constraintTop_toBottomOf="@+id/tv_watch_face_intro"/>
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#e6ffffff"
                    android:id="@+id/tv_watch_face_style"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:text="@string/wf_detail_style"
                    app:layout_constraintStart_toStartOf="@+id/tv_watch_face_name"
                    app:layout_constraintTop_toBottomOf="@+id/divider"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:orientation="horizontal"
                    android:id="@+id/rl_style_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:layout_constraintTop_toBottomOf="@+id/tv_watch_face_style"/>
                <View
                    android:id="@+id/divider2"
                    android:background="#1affffff"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="15dp"
                    app:layout_constraintTop_toBottomOf="@+id/rl_style_list"/>
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#e6ffffff"
                    android:id="@+id/tv_watch_face_diy_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:text="@string/wf_detail_diy_title"
                    app:layout_constraintStart_toStartOf="@+id/tv_watch_face_name"
                    app:layout_constraintTop_toBottomOf="@+id/divider2"/>
                <ImageView
                    android:id="@+id/iv_watch_face_change"
                    android:background="@drawable/wf_iv_common_bg"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:layout_marginTop="15dp"
                    android:src="@drawable/wf_ic_add_diy_bg"
                    android:scaleType="center"
                    app:layout_constraintStart_toStartOf="@+id/tv_watch_face_diy_label"
                    app:layout_constraintTop_toBottomOf="@+id/tv_watch_face_diy_label"/>
                <View
                    android:id="@+id/divider3"
                    android:background="#1affffff"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="15dp"
                    app:layout_constraintTop_toBottomOf="@+id/iv_watch_face_change"/>
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#e6ffffff"
                    android:id="@+id/tv_watch_face_color"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:text="@string/wf_detail_color"
                    app:layout_constraintStart_toStartOf="@+id/tv_watch_face_name"
                    app:layout_constraintTop_toBottomOf="@+id/divider3"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rl_color_list"
                    android:layout_width="match_parent"
                    android:layout_height="114dp"
                    android:layout_marginTop="20dp"
                    app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                    app:layout_constraintTop_toBottomOf="@+id/tv_watch_face_color"
                    app:spanCount="6"/>
                <androidx.constraintlayout.widget.Group
                    android:id="@+id/group_style"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:constraint_referenced_ids="tv_watch_face_style,rl_style_list,divider"/>
                <androidx.constraintlayout.widget.Group
                    android:id="@+id/group_color"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:constraint_referenced_ids="divider3,tv_watch_face_color,rl_color_list"/>
                <androidx.constraintlayout.widget.Group
                    android:id="@+id/group_diy"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:constraint_referenced_ids="divider2,tv_watch_face_diy_label,iv_watch_face_change"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:id="@+id/tv_recommend_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/wf_detail_recommend_title"
                android:includeFontPadding="false"
                android:layout_marginStart="15dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cl_device_detail"/>
            <androidx.recyclerview.widget.RecyclerView
                android:orientation="horizontal"
                android:id="@+id/rl_recommend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginStart="15dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_recommend_title"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/group_recommend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="tv_recommend_title,rl_recommend"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/wf_text_light_white"
                android:id="@+id/tv_diy_tip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="@string/wf_diy_watch_face_tips"
                android:textDirection="locale"
                android:layout_marginStart="15dp"
                app:layout_constraintTop_toBottomOf="@+id/rl_recommend"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/sync_area"
        android:background="@color/wf_home_background_color"
        android:layout_width="match_parent"
        android:layout_height="80dp">
        <com.huami.watchfacesstore.view.WatchFaceProgressView
            android:textSize="16sp"
            android:id="@+id/btn_sync"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <include
        android:visibility="gone"
        layout="@layout/wf_error_layout"/>
</LinearLayout>
