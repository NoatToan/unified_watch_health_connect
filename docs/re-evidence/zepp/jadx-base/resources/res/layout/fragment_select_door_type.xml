<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s10"
    android:scrollbars="none"
    android:fadingEdge="none"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="never">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:background="@color/dark_sky_blue_three"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_select_door"
                android:layout_width="@dimen/size_238dp"
                android:layout_height="@dimen/size_304dp"
                android:src="@drawable/ic_nfc_placeholder"
                android:scaleType="center"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
        <TextView
            android:textSize="@dimen/size_18sp"
            android:textColor="@color/s1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_20dp"
            android:text="@string/access_door_simulation_entity_card"
            android:layout_marginStart="@dimen/size_15dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/access_selector_select_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_10dp"
            android:layout_marginStart="@dimen/size_15dp"
            android:layout_marginEnd="@dimen/size_15dp">
            <RelativeLayout
                android:id="@+id/rl_door_card"
                android:background="@drawable/access_item_click_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/size_15sp"
                    android:textColor="@color/s1"
                    android:id="@+id/tv_access_door"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size_22dp"
                    android:layout_marginTop="@dimen/size_12dp"
                    android:text="@string/access_door_unencrypted_tip_card"
                    android:layout_marginStart="@dimen/size_18dp"
                    android:layout_marginEnd="@dimen/size_52dp"/>
                <TextView
                    android:textSize="@dimen/size_12sp"
                    android:textColor="@color/s2"
                    android:id="@+id/tv_access_door_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/size_12dp"
                    android:text="@string/access_door_unencrypted_tip_down"
                    android:layout_below="@+id/tv_access_door"
                    android:layout_marginStart="@dimen/size_18dp"
                    android:layout_marginEnd="@dimen/size_52dp"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_arrow_forward_20_2x"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/size_18dp"
                    android:layout_alignParentEnd="true"
                    app:tint="@color/s2"/>
            </RelativeLayout>
            <View
                android:id="@+id/view_neighborhood"
                android:background="@color/s4"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"/>
            <RelativeLayout
                android:id="@+id/rl_door_neighborhood"
                android:background="@drawable/access_item_click_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/size_15sp"
                    android:textColor="@color/s1"
                    android:id="@+id/tv_access_neighborhood"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size_22dp"
                    android:layout_marginTop="@dimen/size_12dp"
                    android:text="@string/access_door_outside_the_neighborhood"
                    android:layout_marginStart="@dimen/size_18dp"
                    android:layout_marginEnd="@dimen/size_52dp"/>
                <TextView
                    android:textSize="@dimen/size_12sp"
                    android:textColor="@color/s2"
                    android:id="@+id/tv_access_door_message_neighborhood"
                    android:layout_width="@dimen/size_78dp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/size_12dp"
                    android:text="@string/access_door_smart_community_tip"
                    android:singleLine="true"
                    android:layout_below="@+id/tv_access_neighborhood"
                    android:layout_marginStart="@dimen/size_18dp"
                    android:layout_marginEnd="@dimen/size_52dp"/>
                <TextView
                    android:textSize="@dimen/size_12sp"
                    android:textColor="@color/s41"
                    android:id="@+id/tv_message_neighborhood_url"
                    android:layout_width="102dp"
                    android:layout_height="wrap_content"
                    android:text="@string/access_door_search_support_community_tip"
                    android:singleLine="true"
                    android:layout_below="@+id/tv_access_neighborhood"
                    android:layout_marginStart="@dimen/size_15dp"
                    android:layout_toEndOf="@+id/tv_access_door_message_neighborhood"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_arrow_forward_20_2x"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/size_18dp"
                    android:layout_alignParentEnd="true"
                    app:tint="@color/s2"/>
            </RelativeLayout>
            <View
                android:id="@+id/view_yun"
                android:background="@color/s4"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"/>
            <RelativeLayout
                android:id="@+id/rl_door_yun"
                android:background="@drawable/access_item_click_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/size_15sp"
                    android:textColor="@color/s1"
                    android:id="@+id/tv_access_yun"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size_22dp"
                    android:layout_marginTop="@dimen/size_12dp"
                    android:text="@string/access_door_xiangyun_tip"
                    android:layout_marginStart="@dimen/size_18dp"
                    android:layout_marginEnd="@dimen/size_52dp"/>
                <TextView
                    android:textSize="@dimen/size_12sp"
                    android:textColor="@color/s2"
                    android:id="@+id/tv_access_door_message_yun"
                    android:layout_width="@dimen/size_78dp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/size_12dp"
                    android:text="@string/access_door_smart_community_tip"
                    android:singleLine="true"
                    android:layout_below="@+id/tv_access_yun"
                    android:layout_marginStart="@dimen/size_18dp"
                    android:layout_marginEnd="@dimen/size_52dp"/>
                <TextView
                    android:textSize="@dimen/size_12sp"
                    android:textColor="@color/s41"
                    android:id="@+id/tv_message_yun_url"
                    android:layout_width="102dp"
                    android:layout_height="wrap_content"
                    android:text="@string/access_door_search_support_community_tip"
                    android:singleLine="true"
                    android:layout_below="@+id/tv_access_yun"
                    android:layout_marginStart="@dimen/size_15dp"
                    android:layout_toEndOf="@+id/tv_access_door_message_yun"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_arrow_forward_20_2x"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/size_18dp"
                    android:layout_alignParentEnd="true"
                    app:tint="@color/s2"/>
            </RelativeLayout>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/size_18sp"
            android:textColor="@color/s1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_20dp"
            android:text="@string/access_door_add_blank_card"
            android:layout_marginStart="@dimen/size_15dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/access_selector_select_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_10dp"
            android:layout_marginBottom="@dimen/size_20dp"
            android:layout_marginStart="@dimen/size_15dp"
            android:layout_marginEnd="@dimen/size_15dp">
            <RelativeLayout
                android:id="@+id/rl_white_card"
                android:background="@drawable/access_item_click_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/size_15sp"
                    android:textColor="@color/s1"
                    android:id="@+id/tv_white_door"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size_22dp"
                    android:layout_marginTop="@dimen/size_12dp"
                    android:text="@string/access_door_custom_blank_card"
                    android:layout_marginStart="@dimen/size_18dp"
                    android:layout_marginEnd="@dimen/size_52dp"/>
                <TextView
                    android:textSize="@dimen/size_12sp"
                    android:textColor="@color/s2"
                    android:id="@+id/tv_white_door_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/size_12dp"
                    android:text="@string/access_door_blank_card_tip"
                    android:layout_below="@+id/tv_white_door"
                    android:layout_marginStart="@dimen/size_18dp"
                    android:layout_marginEnd="@dimen/size_52dp"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_arrow_forward_20_2x"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/size_18dp"
                    android:layout_alignParentEnd="true"
                    app:tint="@color/s2"/>
            </RelativeLayout>
            <View
                android:id="@+id/divider_tag_top"
                android:background="@color/s4"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"/>
            <RelativeLayout
                android:id="@+id/rl_nfc_tag"
                android:background="@drawable/access_item_click_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/size_15sp"
                    android:textColor="@color/s1"
                    android:id="@+id/tv_tag_door"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size_22dp"
                    android:layout_marginTop="@dimen/size_12dp"
                    android:text="NFC 标签"
                    android:layout_marginStart="@dimen/size_18dp"
                    android:layout_marginEnd="@dimen/size_52dp"/>
                <TextView
                    android:textSize="@dimen/size_12sp"
                    android:textColor="@color/s2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/size_12dp"
                    android:text="手环模拟 NFC 标签，向手环中写入名片、链接等信息"
                    android:layout_below="@+id/tv_tag_door"
                    android:layout_marginStart="@dimen/size_18dp"
                    android:layout_marginEnd="@dimen/size_52dp"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_arrow_forward_20_2x"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/size_18dp"
                    android:layout_alignParentEnd="true"
                    app:tint="@color/s2"/>
            </RelativeLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
