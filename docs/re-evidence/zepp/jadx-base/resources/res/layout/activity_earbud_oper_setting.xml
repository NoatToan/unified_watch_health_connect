<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/status_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.xiaomi.hm.health.device.earbud.view.EarbudImageView
                android:gravity="center"
                android:id="@+id/device_img"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="30dp"
                app:bigStyle="true"
                app:hasBox="false"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#99000000"
                android:gravity="bottom"
                android:background="#fff8f8f8"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:text="@string/earbud_left_ear"
                android:paddingStart="17dp"/>
            <com.xiaomi.hm.health.baseui.widget.ItemView
                android:id="@+id/left_click"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:itemTitle="@string/earbud_click"/>
            <com.xiaomi.hm.health.baseui.widget.ItemView
                android:id="@+id/left_double_click"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:itemTitle="@string/earbud_double_click"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#99000000"
                android:gravity="bottom"
                android:background="#fff8f8f8"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:text="@string/earbud_right_ear"
                android:paddingStart="17dp"/>
            <com.xiaomi.hm.health.baseui.widget.ItemView
                android:id="@+id/right_click"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:itemTitle="@string/earbud_click"/>
            <com.xiaomi.hm.health.baseui.widget.ItemView
                android:id="@+id/right_double_click"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:itemTitle="@string/earbud_double_click"/>
            <TextView
                android:textSize="13sp"
                android:textColor="#ff8d8d8d"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/earbud_click_tip"
                android:layout_marginStart="17dp"
                android:layout_marginEnd="17dp"/>
            <TextView
                android:textSize="16sp"
                android:textColor="#ff000000"
                android:gravity="center"
                android:id="@+id/btn_reset"
                android:background="@drawable/common_corner_rect"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="60dp"
                android:layout_marginBottom="50dp"
                android:text="@string/earbud_oper_reset"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
