<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/s38"
    android:layout_width="0dp"
    android:layout_height="52dp"
    android:layout_weight="1">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/imageview"
        android:padding="0dp"
        android:focusable="false"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="7dp"
        android:scaleType="center"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/tab_indicator_color_selector"
        android:gravity="center_vertical"
        android:id="@+id/textview"
        android:focusable="false"
        android:layout_width="wrap_content"
        android:layout_height="14dp"
        android:layout_marginTop="2.1dp"
        android:layout_below="@+id/imageview"
        android:layout_centerHorizontal="true"/>
    <View
        android:id="@+id/red_dot"
        android:background="@drawable/ic_circle"
        android:visibility="gone"
        android:layout_width="7dp"
        android:layout_height="7dp"
        android:layout_marginTop="6.5dp"
        android:layout_alignParentTop="true"
        android:layout_marginStart="-4dp"
        android:layout_toEndOf="@+id/imageview"/>
    <View
        android:id="@+id/red_dot_for_sport"
        android:background="@drawable/ic_circle"
        android:visibility="gone"
        android:layout_width="7dp"
        android:layout_height="7dp"
        android:layout_marginTop="6.5dp"
        android:layout_alignParentTop="true"
        android:layout_marginStart="-4dp"
        android:layout_toEndOf="@+id/imageview"/>
    <TextView
        android:textSize="@dimen/size_12sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_red_dot"
        android:background="@drawable/ic_red_circle_border"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:layout_marginStart="-3dp"
        android:layout_toEndOf="@+id/imageview"/>
</RelativeLayout>
