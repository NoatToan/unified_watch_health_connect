<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s10"
    android:paddingBottom="30dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:background="@color/s38"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/chart_container_layout"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_chart_data"
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/heart_rate_size_15dp"
        android:layout_marginStart="5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="40sp"
            android:textColor="@color/s1"
            android:id="@+id/text_heart_rate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="12sp"
            android:textColor="@color/s2"
            android:id="@+id/text_unit"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/heart_rate_unit_hr"
            android:layout_marginStart="5dp"
            app:layout_constraintBaseline_toBaselineOf="@+id/text_heart_rate"
            app:layout_constraintStart_toEndOf="@+id/text_heart_rate"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="12sp"
            android:textColor="@color/s2"
            android:id="@+id/text_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/text_heart_rate"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/chart_container_layout"
        android:layout_width="match_parent"
        android:layout_height="209dp"
        app:layout_constraintTop_toBottomOf="@+id/layout_chart_data">
        <FrameLayout
            android:id="@+id/chart_container"
            android:background="@color/s38"
            android:layout_width="match_parent"
            android:layout_height="209dp"
            app:layout_constraintTop_toBottomOf="@+id/layout_chart_data"/>
    </FrameLayout>
    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/llColorDesc"
        android:padding="@dimen/heart_rate_size_15dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/heart_rate_size_15dp"
        android:layout_marginTop="0dp"
        android:layout_marginRight="@dimen/heart_rate_size_15dp"
        app:flexWrap="wrap"
        app:layout_constraintTop_toBottomOf="@+id/chart_container_layout"
        style="@style/HeartRateDetailContainerStyle">
        <TextView
            android:textColor="@color/s2"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/heart_rate_normal_heart_beat_label"
            android:drawablePadding="4.3dp"
            android:layout_marginEnd="30dp"
            app:drawableStartCompat="@drawable/heart_rate_normal_label_dot"
            style="@style/Rainbow.TextAppearance.Body5"/>
        <TextView
            android:textColor="@color/s2"
            android:gravity="center_vertical"
            android:id="@+id/label_atrial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/heart_rate_abnormal_heart_beat"
            android:drawablePadding="4.3dp"
            app:drawableStartCompat="@drawable/heart_rate_abnormal_label_dot"
            style="@style/Rainbow.TextAppearance.Body5"/>
    </com.google.android.flexbox.FlexboxLayout>
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/subHrFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/heart_rate_size_15dp"
        app:layout_constraintTop_toBottomOf="@+id/llColorDesc"
        app:layout_goneMarginTop="0dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
