<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.watch.companion.ui.view.ActionbarLayout
        android:id="@+id/actionbar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="26dp"
        android:layout_below="@+id/actionbar">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                android:id="@+id/tv_rom_update_ver"
                android:layout_width="match_parent"
                style="@style/Txt.Black"/>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="15dp"
                android:text="@string/update_log"
                android:layout_marginStart="20dp"
                style="@style/Txt.Black"/>
            <TextView
                android:id="@+id/tv_rom_update_info"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="10dp"
                android:layout_marginStart="40dp"
                style="@style/Txt.Black"/>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:gravity="center"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_alignParentBottom="true">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:gravity="center"
            android:id="@+id/setting_main_device"
            android:background="@drawable/watch_common_corner_rect"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="@string/update_now"
            android:onClick="onRomUpdateClick"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            style="@style/Txt.Black"/>
    </LinearLayout>
</RelativeLayout>
