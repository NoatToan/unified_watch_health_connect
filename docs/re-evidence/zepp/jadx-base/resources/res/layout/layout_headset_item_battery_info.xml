<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/headset_battery_info_container"
    android:visibility="gone"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="20dp"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintTop_toTopOf="parent">
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="12sp"
        android:textColor="@color/default_itemview_right_color"
        android:gravity="end"
        android:id="@+id/tv_left_battery"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="140dp"
        android:drawablePadding="4dp"
        android:drawableEnd="@drawable/headset_charging_icon"
        android:fontFamily="lt"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="12sp"
        android:textColor="@color/default_itemview_right_color"
        android:gravity="end"
        android:id="@+id/tv_right_battery"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:maxWidth="140dp"
        android:drawablePadding="4dp"
        android:fontFamily="lt"/>
</androidx.appcompat.widget.LinearLayoutCompat>
