<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@color/wf_home_background_color"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/iv_home_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/wf_ic_back"
            android:paddingStart="15dp"/>
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp"
            app:tabIndicator="@null"
            app:tabPaddingEnd="0dp"
            app:tabPaddingStart="0dp"
            app:tabSelectedTextColor="@color/wf_home_tab_text_select_color"
            app:tabTextAppearance="@style/TabLayoutTextStyle"
            app:tabTextColor="@color/wf_home_tab_text_color"/>
        <ImageView
            android:id="@+id/iv_change_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/wf_ic_change_view"
            android:layout_marginEnd="15dp"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/wf_container"
        android:background="@drawable/wf_watch_face_detail_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>
