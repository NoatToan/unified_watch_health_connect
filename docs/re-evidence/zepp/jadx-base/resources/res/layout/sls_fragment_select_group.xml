<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/sls_dialog_empty_area"/>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:background="@drawable/sls_change_live_pop_bg"
            android:layout_width="match_parent"
            android:layout_height="72dp">
            <ImageView
                android:id="@+id/sls_group_avatar"
                android:layout_width="39dp"
                android:layout_height="39dp"
                android:layout_centerVertical="true"
                android:contentDescription="@string/app_name"
                android:layout_marginStart="14dp"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="14sp"
                android:textColor="@color/white100"
                android:id="@+id/sls_dialog_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignTop="@+id/sls_group_avatar"
                android:layout_marginStart="14dp"
                android:layout_toEndOf="@+id/sls_group_avatar"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="12sp"
                android:textColor="@color/sls_back_8d"
                android:id="@+id/sls_dialog_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignBottom="@+id/sls_group_avatar"
                android:layout_marginStart="14dp"
                android:layout_toEndOf="@+id/sls_group_avatar"/>
        </RelativeLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:background="@color/sls_color_black_1a"
        android:layout_width="match_parent"
        android:layout_height="10dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/sls_rl_del_group"
        android:background="@color/sls_color_black_1a"
        android:layout_width="match_parent"
        android:layout_height="45dp">
        <ImageView
            android:layout_gravity="center_vertical"
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:src="@drawable/sls_group_delete"
            android:contentDescription="@string/app_name"
            android:layout_marginStart="19dp"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="15sp"
            android:textColor="@color/white100"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sls_group_delete"
            android:layout_marginStart="14dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/sls_rl_change_group"
        android:background="@color/sls_color_black_1a"
        android:layout_width="match_parent"
        android:layout_height="45dp">
        <ImageView
            android:layout_gravity="center_vertical"
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:src="@drawable/sls_group_change"
            android:contentDescription="@string/app_name"
            android:layout_marginStart="19dp"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="15sp"
            android:textColor="@color/white100"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sls_group_change"
            android:layout_marginStart="14dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/sls_rl_rename"
        android:background="@color/sls_color_black_1a"
        android:layout_width="match_parent"
        android:layout_height="45dp">
        <ImageView
            android:layout_gravity="center_vertical"
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:src="@drawable/sls_group_rename"
            android:contentDescription="@string/app_name"
            android:layout_marginStart="19dp"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="15sp"
            android:textColor="@color/white100"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sls_group_rename_change"
            android:layout_marginStart="14dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/sls_rl_change_play_name"
        android:background="@color/sls_color_black_1a"
        android:layout_width="match_parent"
        android:layout_height="45dp">
        <ImageView
            android:layout_gravity="center_vertical"
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:src="@drawable/sls_group_change_play_time"
            android:contentDescription="@string/app_name"
            android:layout_marginStart="19dp"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="15sp"
            android:textColor="@color/white100"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sls_group_change_play_time"
            android:layout_marginStart="14dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:background="@color/sls_color_black_1a"
        android:layout_width="match_parent"
        android:layout_height="10dp"/>
</LinearLayout>
