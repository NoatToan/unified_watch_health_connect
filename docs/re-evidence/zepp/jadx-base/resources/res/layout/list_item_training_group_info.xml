<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#ffffff"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp">
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="vertical"
        android:id="@+id/info_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="2dp"
        android:paddingEnd="4dp"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/repeat_info_area"
        android:paddingTop="13dp"
        android:paddingBottom="13dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="14sp"
            android:textColor="#e6000000"
            android:id="@+id/repeat_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/training_repeat_count_title"
            android:layout_below="@+id/info_area"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#dc2b0b"
            android:id="@+id/repeat_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_toEndOf="@+id/repeat_title"/>
    </LinearLayout>
    <View
        android:id="@+id/horizontal_line"
        android:background="#14000000"
        android:layout_width="match_parent"
        android:layout_height="0.3dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"/>
    <LinearLayout
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">
        <TextView
            android:textSize="14.4sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:gravity="center"
            android:id="@+id/edit_repeat_count"
            android:background="@drawable/watch_common_corner_rect"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:text="@string/change_training_repeat_count"
            android:layout_weight="1"
            android:layout_below="@+id/info_area"/>
        <TextView
            android:textSize="14.4sp"
            android:textStyle="bold"
            android:textColor="#ff5353"
            android:gravity="center"
            android:id="@+id/disband_repeat"
            android:background="@drawable/watch_common_corner_rect"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:text="@string/disband_training_repeat"
            android:layout_weight="1"
            android:layout_marginStart="20dp"
            android:layout_toEndOf="@+id/repeat_title"/>
    </LinearLayout>
</LinearLayout>
