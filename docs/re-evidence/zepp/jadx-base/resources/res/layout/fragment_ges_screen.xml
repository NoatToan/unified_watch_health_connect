<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/ges_screen_head_bg"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="245dp">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:background="@color/transparency"
            android:layout_width="match_parent"
            android:layout_height="?android:attr/actionBarSize"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="start|center_vertical"
                android:id="@+id/btn_back"
                android:background="@null"
                android:layout_width="29dp"
                android:layout_height="27dp"
                android:src="@drawable/arrow_back_black"
                android:scaleType="center"
                android:tint="@color/s1"
                android:layout_marginStart="@dimen/size_10dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/top_line"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/s1"
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:text="@string/mili_setting_ges_screen"/>
        </androidx.appcompat.widget.Toolbar>
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/ges_screen_img"
            android:layout_width="240dp"
            android:layout_height="134dp"
            android:src="@drawable/ges_screen_new"
            android:scaleType="fitXY"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/s2"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mili_setting_ges_screen_tips_wuhan"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:background="@drawable/ges_screen_footer_bg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            app:cardBackgroundColor="@color/s38"
            app:cardCornerRadius="6dp"
            app:cardElevation="0dp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/ges_screen_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ltv_title="@string/ds_interest_screen_display_enabled"
                    app:ltv_trailing="@drawable/ic_arrow_forward_20_2x"/>
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/sensitivity_item"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ltv_title="@string/ges_screen_sensitivity"
                    app:ltv_trailing="@drawable/ic_arrow_forward_20_2x"/>
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/start_time_item"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    app:ltv_title="@string/long_sit_alert_start"/>
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/end_time_item"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    app:ltv_title="@string/long_sit_alert_stop"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </FrameLayout>
</LinearLayout>
