<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/dialog_empty_area"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/bg_heart_rate_mode_dialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/black"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="@string/heart_measure_type"/>
        <View
            android:background="#f2f2f2"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <RelativeLayout
            android:id="@+id/view_allday_heart"
            android:layout_width="match_parent"
            android:layout_height="64dp">
            <ImageView
                android:id="@+id/iv_every_min"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/popup_pick_icon"
                android:tint="@color/pink"
                android:layout_centerVertical="true"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/pink"
                android:id="@+id/heart_measure_type_every_min"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:text="@string/heart_measure_type_every_min"
                android:layout_marginStart="22dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/grey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/heart_measure_type_every_min_info"
                android:layout_below="@+id/heart_measure_type_every_min"
                android:layout_marginStart="22dp"/>
        </RelativeLayout>
        <View
            android:background="@color/black20"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_marginStart="22dp"
            android:layout_marginEnd="22dp"/>
        <RelativeLayout
            android:id="@+id/view_manual"
            android:layout_width="match_parent"
            android:layout_height="64dp">
            <ImageView
                android:id="@+id/iv_manual"
                android:layout_width="21dp"
                android:layout_height="wrap_content"
                android:src="@drawable/popup_pick_icon"
                android:tint="@color/pink"
                android:layout_centerVertical="true"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:layout_alignParentStart="true"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/pink"
                android:id="@+id/heart_measure_type_manual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:text="@string/heart_measure_type_manual"
                android:layout_marginStart="22dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/grey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/heart_measure_type_manual_info"
                android:layout_below="@+id/heart_measure_type_manual"
                android:layout_marginStart="22dp"/>
        </RelativeLayout>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/grey"
            android:gravity="center"
            android:id="@+id/tv_cancel"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="@string/cancel"/>
    </LinearLayout>
</LinearLayout>
