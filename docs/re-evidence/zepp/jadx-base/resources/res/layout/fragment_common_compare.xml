<?xml version="1.0" encoding="utf-8"?>
<com.huami.hmchartui.ui.view.CommonCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/common_card_vertical_margin"
    android:layout_marginStart="@dimen/common_card_horizon_margin"
    android:layout_marginEnd="@dimen/common_card_horizon_margin"
    app:cardCornerRadius="@dimen/common_card_radius"
    app:cardElevation="@dimen/common_card_elevation">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@color/s38"
        android:paddingBottom="13dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.huami.widget.typeface.TypefaceTextView
            android:textColor="@color/s2"
            android:gravity="start|center_vertical"
            android:id="@+id/tv_compare_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lines="1"
            android:fontFamily="lt"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Rainbow.TextAppearance.Body5"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textColor="@color/s1"
            android:gravity="start|center_vertical"
            android:id="@+id/tv_compare_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:maxLines="5"
            android:fontFamily="lt"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_compare_title"
            style="@style/Rainbow.TextAppearance.Body3"/>
        <View
            android:id="@+id/divider"
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="3dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_compare_desc"/>
        <RelativeLayout
            android:id="@+id/layout_this_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/divider">
            <com.huami.widget.typeface.TypefaceTextView
                android:textStyle="bold"
                android:textColor="@color/s1"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:id="@+id/tv_compare_this_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lines="1"
                android:fontFamily="lt-bold"
                android:layout_marginStart="14dp"
                android:layout_toStartOf="@+id/tv_compare_this"
                android:layout_alignParentStart="true"
                style="@style/Rainbow.TextAppearance.Body3"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textStyle="bold"
                android:textColor="@color/s1"
                android:gravity="center_vertical"
                android:id="@+id/tv_compare_this"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lines="1"
                android:layout_alignBaseline="@+id/tv_compare_this_title"
                android:fontFamily="lt-bold"
                android:layout_marginEnd="2dp"
                android:layout_toStartOf="@+id/tv_compare_this_unit"
                style="@style/Rainbow.TextAppearance.Body3"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textColor="@color/s2"
                android:gravity="center_vertical"
                android:id="@+id/tv_compare_this_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lines="1"
                android:layout_alignBaseline="@+id/tv_compare_this_title"
                android:fontFamily="lt"
                android:layout_marginEnd="14dp"
                android:layout_alignParentEnd="true"
                style="@style/Rainbow.TextAppearance.Body5"/>
        </RelativeLayout>
        <ProgressBar
            android:id="@+id/pb_compare_this"
            android:layout_width="0dp"
            android:layout_height="10dp"
            android:layout_marginTop="5dp"
            android:max="100"
            android:progress="0"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layout_this_title"
            style="?android:attr/progressBarStyleHorizontal"/>
        <RelativeLayout
            android:id="@+id/layout_last_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/pb_compare_this">
            <com.huami.widget.typeface.TypefaceTextView
                android:textStyle="bold"
                android:textColor="@color/s1"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:id="@+id/tv_compare_last_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lines="1"
                android:fontFamily="lt-bold"
                android:layout_marginStart="14dp"
                android:layout_toStartOf="@+id/tv_compare_last"
                android:layout_alignParentStart="true"
                style="@style/Rainbow.TextAppearance.Body3"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textStyle="bold"
                android:textColor="@color/s1"
                android:gravity="center_vertical"
                android:id="@+id/tv_compare_last"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lines="1"
                android:layout_alignBaseline="@+id/tv_compare_last_title"
                android:fontFamily="lt-bold"
                android:layout_marginEnd="2dp"
                android:layout_toStartOf="@+id/tv_compare_last_unit"
                style="@style/Rainbow.TextAppearance.Body3"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textColor="@color/s2"
                android:gravity="center_vertical"
                android:id="@+id/tv_compare_last_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lines="1"
                android:layout_alignBaseline="@+id/tv_compare_last_title"
                android:fontFamily="lt"
                android:layout_marginEnd="14dp"
                android:layout_alignParentEnd="true"
                style="@style/Rainbow.TextAppearance.Body5"/>
        </RelativeLayout>
        <ProgressBar
            android:id="@+id/pb_compare_last"
            android:layout_width="0dp"
            android:layout_height="10dp"
            android:layout_marginTop="5dp"
            android:max="100"
            android:progress="0"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layout_last_title"
            style="?android:attr/progressBarStyleHorizontal"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.huami.hmchartui.ui.view.CommonCardView>
