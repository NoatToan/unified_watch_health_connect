<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:scrollbars="none"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.huami.lib.rainbow.titlebar.RainbowTitleBar
            android:id="@+id/title_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:title="@string/app_sort_phone"/>
        <FrameLayout
            android:id="@+id/container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.huami.lib.view.widget.TipComponent
            android:layout_gravity="start"
            android:id="@+id/permission_tips"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/s2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="8dp"
            android:text="@string/choose_phone_alert_setting"
            android:layout_marginStart="@dimen/size_15dp"
            android:layout_marginEnd="@dimen/size_15dp"/>
        <com.xiaomi.hm.health.ui.smartplay.btphone.phonecallalertsetting.PhoneAlertSettingItemView
            android:id="@+id/close_itv"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_56dp"
            android:layout_marginStart="@dimen/size_15dp"
            android:layout_marginEnd="@dimen/size_15dp"
            app:alertSettingItemEnableDivider="true"
            app:alertSettingItemRadiusPosition="top"
            app:alertSettingItemTitle="@string/close"/>
        <com.xiaomi.hm.health.ui.smartplay.btphone.phonecallalertsetting.PhoneAlertSettingItemView
            android:id="@+id/phone_alert_itv"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_56dp"
            android:layout_marginStart="@dimen/size_15dp"
            android:layout_marginEnd="@dimen/size_15dp"
            app:alertSettingItemEnableDivider="true"
            app:alertSettingItemSubTitle="@string/phone_alert_desc"
            app:alertSettingItemTitle="@string/incoming_call_alert"/>
        <com.xiaomi.hm.health.ui.smartplay.btphone.phonecallalertsetting.PhoneAlertSettingItemView
            android:id="@+id/bt_phone_itv"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_56dp"
            android:layout_marginStart="@dimen/size_15dp"
            android:layout_marginEnd="@dimen/size_15dp"
            app:alertSettingItemRadiusPosition="bottom"
            app:alertSettingItemSubTitle="@string/bt_phone_alert_desc"
            app:alertSettingItemTitle="@string/bt_phone_alert_title"/>
        <FrameLayout
            android:id="@+id/phone_alert_setting_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <FrameLayout
            android:id="@+id/bt_phone_setting_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <androidx.cardview.widget.CardView
            android:id="@+id/phone_call_sms_reply_container"
            android:background="@android:color/transparent"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_15dp"
            android:layout_marginStart="@dimen/size_15dp"
            android:layout_marginEnd="@dimen/size_15dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/s2"
            android:id="@+id/watch_setting_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_15dp"
            android:layout_marginBottom="8dp"
            android:text="@string/watch_phone_alert_setting_title"
            android:layout_marginStart="@dimen/size_15dp"
            android:layout_marginEnd="@dimen/size_15dp"/>
        <com.huami.lib.rainbow.ListTile
            android:id="@+id/contact_itv"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_56dp"
            android:layout_marginStart="@dimen/size_15dp"
            android:layout_marginEnd="@dimen/size_15dp"
            app:ltv_radius_position="all"
            app:ltv_title="@string/bt_contact_item"/>
    </LinearLayout>
</ScrollView>
