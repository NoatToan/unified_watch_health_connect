<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@drawable/dialog_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="10dp">
    <ImageView
        android:id="@+id/dialog_image"
        android:background="@drawable/wl_img_notice"
        android:layout_width="@dimen/size_130dp"
        android:layout_height="@dimen/size_130dp"
        android:layout_marginTop="30dp"/>
    <TextView
        android:textSize="@dimen/t6"
        android:textColor="@color/s1"
        android:gravity="center"
        android:id="@+id/dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/wl_notice_title"/>
    <TextView
        android:textAppearance="@style/TextAppearance.MiFit.Title.Inverse"
        android:textColor="@color/s2"
        android:gravity="center"
        android:id="@+id/dialog_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"/>
    <Button
        android:id="@+id/known_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_14dp"
        android:layout_marginBottom="@dimen/size_18dp"
        android:text="@string/wl_known"
        android:layout_marginStart="@dimen/wl_border_margin"
        android:layout_marginEnd="@dimen/wl_border_margin"
        style="@style/Rainbow.Widget.Button.44.Circular"/>
</LinearLayout>
