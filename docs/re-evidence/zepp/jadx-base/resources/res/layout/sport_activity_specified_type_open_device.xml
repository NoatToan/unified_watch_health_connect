<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/exists_applicable_device_container"
        android:visibility="gone"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:background="@color/s10"
                android:layout_width="match_parent"
                android:layout_height="2dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/s2"
                android:id="@+id/open_device_tips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:text="@string/open_device_maximum_device_count_tips"
                android:layout_marginStart="16dp"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/open_device_rv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#ff108ee8"
                android:layout_gravity="center_horizontal"
                android:id="@+id/exists_device_help"
                android:background="@drawable/sport_open_device_help_bg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="30dp"
                android:text="@string/open_device_sport_type_applicable_device_help"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/no_applicable_device_container"
        android:background="@color/s10"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:background="@drawable/icon_sport_open_device_no_applicable"
            android:layout_width="87dp"
            android:layout_height="87dp"
            android:layout_marginTop="78dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/s2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="@string/open_device_sport_type_no_applicable_device"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#ff108ee8"
            android:layout_gravity="center_horizontal"
            android:id="@+id/no_device_help"
            android:background="@drawable/sport_open_device_help_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/open_device_sport_type_applicable_device_help"/>
    </LinearLayout>
</FrameLayout>
