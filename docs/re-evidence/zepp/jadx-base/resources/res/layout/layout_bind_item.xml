<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:background="@color/s38"
        android:layout_width="match_parent"
        style="@style/activitySettingButtonStyle">
        <com.huami.lib.view.image.CircleImageView
            android:id="@+id/bind_app_icon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="20dp"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="16sp"
            android:id="@+id/bind_app_text"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/item_height"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:layout_toEndOf="@+id/bind_app_icon"
            style="@style/ListItemTitleText"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/thirdbind_indicator"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/item_height"
            android:layout_centerVertical="true"
            android:paddingEnd="@dimen/mili_margin"
            android:layout_marginStart="10dp"
            android:layout_alignParentEnd="true"
            app:srcCompat="@drawable/ic_arrow_forward_16"
            app:tint="@color/s1"/>
        <TextView
            android:id="@+id/thirdbind_status"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bind_status_disconnect"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/thirdbind_indicator"/>
    </RelativeLayout>
    <TextView
        android:enabled="false"
        android:id="@+id/divider"
        android:background="@color/s4"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginStart="@dimen/mili_margin"
        android:layout_marginEnd="@dimen/mili_margin"/>
</LinearLayout>
