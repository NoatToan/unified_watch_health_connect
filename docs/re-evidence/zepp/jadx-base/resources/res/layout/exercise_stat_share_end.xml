<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s4"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_width="43.3dp"
        android:layout_height="43.3dp"
        android:layout_marginTop="14.3dp"
        android:layout_marginBottom="14.3dp"
        android:src="@drawable/app_icon"
        android:layout_marginStart="13.3dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/share_end_qr_code"
        android:layout_width="43.3dp"
        android:layout_height="43.3dp"
        android:src="@drawable/sport_details_qr_code"
        android:layout_marginEnd="13.3dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="11.3sp"
        android:textColor="@color/s2"
        android:gravity="end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/share_end_suggest_desc"
        android:lineSpacingExtra="6sp"
        android:lineSpacingMultiplier="1"
        android:layout_marginEnd="13.3dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/share_end_qr_code"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
