<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="20sp"
            android:textColor="@color/s1"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="68dp"
            android:text="@string/training_before_hr_prompt_title"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/s2"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/training_before_hr_prompt_content"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/s2"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/training_before_hr_prompt_notice"/>
        <ImageView
            android:id="@+id/tr_img_center"
            android:background="@color/s10"
            android:layout_width="210dp"
            android:layout_height="210dp"
            android:layout_marginTop="68dp"
            android:src="@drawable/img_heartrate_uphand_train"
            android:scaleType="centerInside"/>
    </LinearLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/s2"
        android:gravity="center"
        android:id="@+id/know_btn"
        android:layout_width="match_parent"
        android:layout_height="92dp"
        android:text="@string/i_know"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
