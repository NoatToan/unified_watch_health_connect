<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.lib.rainbow.titlebar.RainbowTitleBar
        android:id="@+id/actionbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationIcon="@drawable/ic_arrow_back_20_2x"
        app:title="@string/personal_best"/>
    <net.lucode.hackware.magicindicator.MagicIndicator
        android:id="@+id/magicindicator"
        android:background="@color/s36"
        android:layout_width="match_parent"
        android:layout_height="47dp"
        android:layout_below="@+id/actionbar"/>
    <View
        android:id="@+id/line"
        android:background="@color/s4"
        android:layout_width="match_parent"
        android:layout_height="0.3dp"
        android:layout_below="@+id/magicindicator"/>
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/view_pager"
        android:background="@color/s10"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/line"/>
</RelativeLayout>
