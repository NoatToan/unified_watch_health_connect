<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/shape_rect_corner_white"
    android:padding="@dimen/size_15dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="@dimen/size_18sp"
        android:textColor="@color/s1"
        android:id="@+id/stress_today_analysis"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/stress_today_analysis"
        android:textDirection="locale"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.huami.widget.piechart.PieChart
        android:id="@+id/pieChart"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="30dp"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="@dimen/size_10dp"
        app:layout_constraintEnd_toStartOf="@+id/center_guide_line"
        app:layout_constraintTop_toBottomOf="@+id/stress_today_analysis"
        app:pie_chart_divider_width="2dp"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="14sp"
        android:textColor="@color/s1"
        android:gravity="center"
        android:id="@+id/empty_pie"
        android:background="@drawable/shape_circle_stress_pie_empty"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="30dp"
        android:text="@string/health_data_no_data"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="@dimen/size_10dp"
        app:layout_constraintEnd_toStartOf="@+id/center_guide_line"
        app:layout_constraintTop_toBottomOf="@+id/stress_today_analysis"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/center_guide_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="14sp"
        android:textColor="@color/s2"
        android:id="@+id/tv_stress_level_value_relax"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="@string/stress_relax_value"
        android:maxLines="2"
        android:drawablePadding="4dp"
        android:drawableStart="@drawable/stress_icon_stress_level_relax"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/center_guide_line"
        app:layout_constraintTop_toBottomOf="@+id/stress_today_analysis"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="14sp"
        android:textColor="@color/s2"
        android:id="@+id/tv_stress_level_value_normal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/stress_normal_value"
        android:maxLines="2"
        android:drawablePadding="4dp"
        android:drawableStart="@drawable/stress_icon_stress_level_normal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tv_stress_level_value_relax"
        app:layout_constraintTop_toBottomOf="@+id/tv_stress_level_value_relax"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="14sp"
        android:textColor="@color/s2"
        android:id="@+id/tv_stress_level_value_medium"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/stress_medium_value"
        android:maxLines="2"
        android:drawablePadding="4dp"
        android:layout_below="@+id/tv_stress_level_value_normal"
        android:drawableStart="@drawable/stress_icon_stress_level_medium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tv_stress_level_value_normal"
        app:layout_constraintTop_toBottomOf="@+id/tv_stress_level_value_normal"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="14sp"
        android:textColor="@color/s2"
        android:id="@+id/tv_stress_level_value_high"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/stress_high_value"
        android:maxLines="2"
        android:drawablePadding="4dp"
        android:layout_below="@+id/tv_stress_level_value_medium"
        android:drawableStart="@drawable/stress_icon_stress_level_high"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tv_stress_level_value_medium"
        app:layout_constraintTop_toBottomOf="@+id/tv_stress_level_value_medium"/>
    <View
        android:id="@+id/divider"
        android:layout_marginTop="25dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_stress_level_value_high"
        style="@style/VerticalDivider"/>
    <LinearLayout
        android:orientation="horizontal"
        android:paddingBottom="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider">
        <com.xiaomi.hm.health.training.ui.widget.UpDownTextItem
            android:id="@+id/day_max"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:downText="@string/stress_max"
            app:downTextColor="@color/s2"
            app:downTextSize="12sp"
            app:textPadding="1dp"
            app:upText="@string/value_invalid"
            app:upTextColor="@color/s1"
            app:upTextSize="14sp"/>
        <com.xiaomi.hm.health.training.ui.widget.UpDownTextItem
            android:id="@+id/day_min"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:downText="@string/stress_min"
            app:downTextColor="@color/s2"
            app:downTextSize="12sp"
            app:textPadding="1dp"
            app:upText="@string/value_invalid"
            app:upTextColor="@color/s1"
            app:upTextSize="14sp"/>
        <com.xiaomi.hm.health.training.ui.widget.UpDownTextItem
            android:id="@+id/day_avg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:downText="@string/stress_avg"
            app:downTextColor="@color/s2"
            app:downTextSize="12sp"
            app:textPadding="1dp"
            app:upText="@string/value_invalid"
            app:upTextColor="@color/s1"
            app:upTextSize="14sp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
