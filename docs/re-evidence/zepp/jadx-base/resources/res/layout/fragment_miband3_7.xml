<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/pale_grey_two"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="20sp"
        android:textColor="@color/black80"
        android:gravity="center"
        android:id="@+id/title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/play_miband3_nfc_title_temp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/black60"
        android:gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:text="@string/play_miband3_nfc_tips_temp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_tv"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.4"/>
    <ImageView
        android:id="@+id/img_pos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="95dp"
        app:layout_constraintStart_toStartOf="@+id/guideline"
        app:layout_constraintTop_toBottomOf="@+id/title_tv"
        app:srcCompat="@drawable/img_open_card"/>
    <TextView
        android:textSize="9sp"
        android:textColor="@color/dark_sky_blue_three"
        android:id="@+id/indicator_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="38dp"
        android:text="@string/play_miband3_nfc_please_slot_card"
        android:layout_marginEnd="28dp"
        app:layout_constraintEnd_toEndOf="@+id/img_pos"
        app:layout_constraintStart_toStartOf="@+id/img_pos"
        app:layout_constraintTop_toTopOf="@+id/img_pos"/>
    <com.xiaomi.hm.health.ui.playmiband2.MovableImageView
        android:id="@+id/img_slot_card"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="90dp"
        android:layout_marginEnd="60dp"
        app:layout_constraintEnd_toEndOf="@+id/img_pos"
        app:layout_constraintTop_toBottomOf="@+id/title_tv"
        app:srcCompat="@drawable/img_slot_card"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/dark_sky_blue_three"
        android:gravity="center"
        android:id="@+id/tv_goto_add"
        android:background="@drawable/miband3_instruct_text_bg"
        android:layout_width="80dp"
        android:layout_height="28dp"
        android:layout_marginBottom="86dp"
        android:text="@string/play_miband3_nfc_goto_add"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
