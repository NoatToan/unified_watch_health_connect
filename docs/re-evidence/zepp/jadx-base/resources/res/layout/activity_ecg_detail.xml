<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/s36"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:background="@color/s36"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="42.3dp">
        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_arrow_back_20_2x"
            android:scaleType="centerInside"
            android:layout_centerVertical="true"
            android:layout_marginStart="11dp"
            android:layout_alignParentStart="true"
            app:tint="@color/s1"/>
        <ImageView
            android:id="@+id/pre"
            android:padding="10dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_ecg_pre"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/title_text"/>
        <TextView
            android:textColor="@color/s1"
            android:id="@+id/title_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            style="@style/Rainbow.TextAppearance.Title3"/>
        <ImageView
            android:id="@+id/next"
            android:padding="10dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_ecg_next"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@+id/title_text"/>
        <TextView
            android:textStyle="bold"
            android:textColor="@color/p3"
            android:gravity="center"
            android:layout_gravity="end|center_vertical"
            android:id="@+id/delete_ecg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="90dp"
            android:text="@string/delete"
            android:layout_centerVertical="true"
            android:layout_marginEnd="11dp"
            android:layout_alignParentEnd="true"
            style="@style/Rainbow.TextAppearance.Number7"/>
    </RelativeLayout>
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/view_pager"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/ecg_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>
