<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="bottom"
    android:orientation="vertical"
    android:padding="8dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/view_other"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/round_rect_white_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/s2"
            android:gravity="center"
            android:id="@+id/item_setting"
            android:padding="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting"/>
        <View
            android:id="@+id/divider_setting"
            android:background="@color/black20"
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/s2"
            android:gravity="center"
            android:id="@+id/item_download_video"
            android:padding="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/download_training_video"/>
        <View
            android:id="@+id/divider_download"
            android:background="@color/black20"
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/s2"
            android:gravity="center"
            android:id="@+id/item_exit_training"
            android:padding="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/exit_training"/>
    </LinearLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/s2"
        android:gravity="center"
        android:id="@+id/btn_cancel"
        android:background="@drawable/round_rect_white_bg"
        android:padding="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/cancel"/>
</LinearLayout>
