<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:weight="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.xiaomi.hm.health.bodyfat.view.VerticalScrollView
        android:background="@color/s36"
        android:paddingBottom="66dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:background="@color/s36"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/layoutForScore"
                android:background="@color/bg_weight_title_color"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RelativeLayout
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/weight_rl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="38dp"
                    android:layout_marginBottom="38dp">
                    <com.huami.widget.typeface.TypefaceTextView
                        android:textSize="58sp"
                        android:textColor="@color/one_foot_value_color"
                        android:id="@+id/oneFootValueTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/empty_value"
                        android:fontFamily="km"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/one_foot_second_unit_color"
                        android:id="@+id/unitTV"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/unit_sec"
                        android:layout_alignBaseline="@+id/oneFootValueTextView"
                        android:layout_marginStart="2dp"
                        android:layout_toEndOf="@+id/oneFootValueTextView"/>
                </RelativeLayout>
            </LinearLayout>
            <View
                android:id="@+id/line_split2"
                android:background="@color/s4"
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider"
                android:layout_below="@+id/layoutForScore"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/weight_body_type_ll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/line_split2">
                <RelativeLayout
                    android:id="@+id/relayoutForNoScore"
                    android:background="@color/s36"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/s3"
                        android:id="@+id/textNoScore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/oft_has_no_data"
                        android:drawablePadding="3dp"
                        android:layout_centerInParent="true"/>
                </RelativeLayout>
                <RelativeLayout
                    android:orientation="vertical"
                    android:id="@+id/relayoutForScoreFigure"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/s1"
                        android:id="@+id/textViewScoreLevel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="23dp"
                        android:text="@string/one_foot_score_level"
                        android:layout_centerHorizontal="true"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="31dp"
                        android:layout_below="@+id/textViewScoreLevel"
                        android:layout_marginStart="18dp"
                        android:layout_marginEnd="18dp">
                        <com.huami.view.weightfigure.WeightFigureView
                            android:layout_gravity="center"
                            android:id="@+id/oneFootFigureView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            weight:type="unmoveable"/>
                    </LinearLayout>
                </RelativeLayout>
            </LinearLayout>
            <View
                android:id="@+id/line_split3"
                android:background="@color/s36"
                android:layout_width="match_parent"
                android:layout_height="@dimen/left_padding"
                android:layout_below="@+id/weight_body_type_ll"/>
            <include
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/line_split3"
                layout="@layout/card_status_introduces"/>
        </RelativeLayout>
    </com.xiaomi.hm.health.bodyfat.view.VerticalScrollView>
</RelativeLayout>
