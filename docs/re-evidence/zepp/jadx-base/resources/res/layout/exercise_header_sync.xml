<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <View
        android:id="@+id/divider_sync"
        android:background="@color/pale_grey"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_alignParentBottom="true"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/divider_sync"
        android:layout_centerVertical="true"
        android:layout_marginStart="18dp">
        <ImageView
            android:id="@+id/syncStateIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_history_record_sync_fail"
            android:layout_marginEnd="11dp"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/black70"
            android:id="@+id/unSyncCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/syncFailContainer"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/black70"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/running_history_record_sync_fail"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/black40"
                android:id="@+id/syncFailDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <View
            android:layout_height="32dp"
            style="@style/HorizontalDivider"/>
        <ImageView
            android:gravity="center"
            android:id="@+id/syncBtn"
            android:background="@drawable/btn_click_bg_rect_transparent"
            android:layout_width="59dp"
            android:layout_height="match_parent"
            android:src="@drawable/warn_retry"
            android:scaleType="centerInside"/>
    </LinearLayout>
</merge>
