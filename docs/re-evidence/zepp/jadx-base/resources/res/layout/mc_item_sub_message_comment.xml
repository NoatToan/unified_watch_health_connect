<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s38"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_icon_reply"
        android:background="@drawable/mc_notice_icon_reply"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_time"
        app:layout_constraintStart_toEndOf="@+id/tv_time"
        app:layout_constraintTop_toBottomOf="@+id/tv_time"
        app:layout_constraintTop_toTopOf="@+id/tv_time"/>
    <ImageView
        android:id="@+id/iv_thumbnail"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="19dp"
        android:layout_marginEnd="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_iv_thumbnail_icon"
        android:background="@drawable/mc_edit_icon_video"
        android:layout_width="22dp"
        android:layout_height="22dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_thumbnail"
        app:layout_constraintEnd_toEndOf="@+id/iv_thumbnail"
        app:layout_constraintStart_toStartOf="@+id/iv_thumbnail"
        app:layout_constraintTop_toTopOf="@+id/iv_thumbnail"/>
    <View
        android:id="@+id/mc_msg_item_divider"
        android:background="@drawable/mc_msg_item_divider"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_icon_reply"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="91dp"/>
    <com.huami.android.image.RoundImageView
        android:id="@+id/iv_avatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="19dp"
        android:layout_marginStart="15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:riv_border_width="0dp"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="10sp"
        android:textColor="@color/s2"
        android:ellipsize="end"
        android:id="@+id/iv_thumbnail_text"
        android:background="@drawable/mc_msg_sub_icon_bg"
        android:padding="5dp"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:text="@string/mc_comment_post"
        android:maxLines="3"
        android:fontFamily="lt"
        app:layout_constraintBottom_toBottomOf="@+id/iv_thumbnail"
        app:layout_constraintEnd_toEndOf="@+id/iv_thumbnail"
        app:layout_constraintStart_toStartOf="@+id/iv_thumbnail"
        app:layout_constraintTop_toTopOf="@+id/iv_thumbnail"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="14sp"
        android:textColor="@color/s2"
        android:ellipsize="end"
        android:id="@+id/tv_type_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/mc_comment_post"
        android:maxLines="1"
        android:fontFamily="lt"
        android:layout_marginStart="4dp"
        app:layout_constraintEnd_toStartOf="@+id/guideline3"
        app:layout_constraintStart_toEndOf="@+id/tv_nickname"
        app:layout_constraintTop_toTopOf="@+id/tv_nickname"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="14sp"
        android:textColor="@color/s1"
        android:id="@+id/tv_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:fontFamily="lt"
        android:layout_marginStart="8dp"
        app:layout_constraintEnd_toStartOf="@+id/guideline3"
        app:layout_constraintStart_toEndOf="@+id/iv_avatar"
        app:layout_constraintTop_toBottomOf="@+id/tv_nickname"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="12sp"
        android:textColor="@color/s2"
        android:ellipsize="end"
        android:id="@+id/tv_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:maxLines="1"
        android:fontFamily="lt"
        app:layout_constraintEnd_toStartOf="@+id/iv_icon_reply"
        app:layout_constraintStart_toStartOf="@+id/tv_nickname"
        app:layout_constraintTop_toBottomOf="@+id/tv_text"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="12sp"
        android:textColor="@color/s2"
        android:id="@+id/tv_reply_label"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/mc_replay"
        android:fontFamily="lt"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_time"
        app:layout_constraintStart_toEndOf="@+id/iv_icon_reply"
        app:layout_constraintTop_toTopOf="@+id/tv_time"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="16sp"
        android:textColor="@color/s1"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/tv_nickname"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:maxWidth="88dp"
        android:maxLines="1"
        android:fontFamily="lt"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="5dp"
        app:layout_constraintEnd_toStartOf="@+id/tv_type_label"
        app:layout_constraintStart_toEndOf="@+id/iv_avatar"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
