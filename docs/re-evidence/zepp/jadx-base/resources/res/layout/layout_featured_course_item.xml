<?xml version="1.0" encoding="utf-8"?>
<com.huami.training.ui.widget.CourseCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="147dp"
    style="@style/TrainingCard">
    <ImageView
        android:id="@+id/iv_bg"
        android:layout_width="match_parent"
        android:layout_height="115dp"
        android:scaleType="centerCrop"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">
        <TextView
            android:textSize="@dimen/tr_font_size_title"
            android:textColor="@color/tr_white"
            android:id="@+id/tv_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="23dp"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TrainingTextSingleLineStyle"/>
        <TextView
            android:textSize="@dimen/tr_font_size_subtitle"
            android:textColor="@color/tr_white"
            android:id="@+id/tv_rank_and_coursecount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:layout_constraintStart_toEndOf="@+id/iv_img"
            app:layout_constraintTop_toBottomOf="@+id/tv_name"
            style="@style/TrainingTextSingleLineStyle"/>
        <TextView
            android:textSize="@dimen/tr_font_size_subtitle"
            android:textColor="@color/tr_white"
            android:id="@+id/tv_course_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginStart="10dp"
            app:layout_constraintStart_toEndOf="@+id/tv_rank_and_coursecount"
            app:layout_constraintTop_toBottomOf="@+id/tv_name"
            style="@style/TrainingTextSingleLineStyle"/>
        <TextView
            android:textSize="@dimen/tr_font_size_subtitle"
            android:textColor="@color/tr_font_gray_light"
            android:id="@+id/tv_cal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            style="@style/TrainingTextSingleLineStyle"/>
        <TextView
            android:textSize="@dimen/tr_font_size_subtitle"
            android:textColor="@color/tr_font_gray_light"
            android:id="@+id/tv_study_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            style="@style/TrainingTextSingleLineStyle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.huami.training.ui.widget.CourseCardView>
