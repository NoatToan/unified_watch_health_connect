<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:weight="http://schemas.android.com/apk/res-auto"
    android:id="@+id/base_layout"
    android:background="@color/body_params_activity_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/value_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true">
        <RelativeLayout
            android:id="@+id/up_layout"
            android:layout_width="match_parent"
            android:layout_height="316dp">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true">
                <com.huami.widget.typeface.TypefaceTextView
                    android:textSize="68sp"
                    android:textColor="@color/s5"
                    android:id="@+id/value_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:fontFamily="din-med"/>
                <TextView
                    android:textSize="17.3sp"
                    android:textColor="@color/s3"
                    android:id="@+id/unit_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/percentage"
                    android:layout_alignBaseline="@+id/value_tv"
                    android:layout_marginStart="6.7dp"
                    android:layout_toEndOf="@+id/value_tv"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/s5"
                    android:gravity="center"
                    android:id="@+id/level_tv"
                    android:paddingTop="3.3dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/value_tv"
                    android:layout_centerHorizontal="true"/>
            </RelativeLayout>
        </RelativeLayout>
        <com.huami.view.weightfigure.WeightFigureView
            android:layout_gravity="center"
            android:id="@+id/figure_view"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/up_layout"
            weight:type="unmoveable"/>
    </RelativeLayout>
    <View
        android:id="@+id/split_view"
        android:background="@color/s2"
        android:layout_width="match_parent"
        android:layout_height="0.3dp"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="24dp"
        android:layout_below="@+id/value_ll"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/s1"
        android:gravity="start"
        android:id="@+id/has_figureview_tv"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15.7dp"
        android:layout_below="@+id/split_view"
        android:lineSpacingExtra="@dimen/body_params_linespace"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/s2"
        android:gravity="center"
        android:id="@+id/no_figureview_tv"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="123dp"
        android:layout_below="@+id/split_view"
        android:layout_marginStart="@dimen/bodyparams_no_value_margin"
        android:layout_marginEnd="@dimen/bodyparams_no_value_margin"/>
</RelativeLayout>
