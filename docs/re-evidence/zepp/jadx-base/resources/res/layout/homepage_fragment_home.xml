<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/homepage"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/homepage_imageview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/homepage_home_background"
        android:scaleType="fitXY"
        android:layout_alignParentStart="true"/>
    <View
        android:background="@color/s10"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/homepage_imageview"/>
    <View
        android:id="@+id/homepage_bar_avatar"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_alignParentTop="true"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/homepage_status"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="11dp"
        android:layout_marginRight="15dp"
        android:layout_below="@+id/homepage_bar_avatar">
        <com.huami.module.homepage.sync.view.refresh.HomeRefreshAnimator
            android:id="@+id/homepage_connect_animator"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_alignParentStart="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:lottie_repeatCount="1"/>
        <TextView
            android:textColor="@color/s1"
            android:ellipsize="end"
            android:id="@+id/homepage_device_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_centerVertical="true"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="10dp"
            android:layout_toEndOf="@+id/homepage_connect_animator"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/homepage_logo"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/homepage_connect_animator"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Rainbow.TextAppearance.Body5"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/homepage_logo"
            android:layout_width="80dp"
            android:layout_height="20dp"
            android:layout_centerInParent="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/homepage_logo"
            app:tint="@color/s1"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/homepage_sleep_aid"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:scaleType="fitXY"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/homepage_all_data_iv"
            app:layout_constraintEnd_toStartOf="@+id/homepage_all_data_iv"
            app:layout_constraintTop_toTopOf="@+id/homepage_all_data_iv"
            app:srcCompat="@drawable/ic_sleep_aid_20_s5_mifit"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/homepage_all_data_iv"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_all_data_20"
            android:scaleType="fitXY"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.huami.module.homepage.sync.view.refresh.HomeRefreshLayout
        android:id="@+id/homepage_srl"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="10dp"
        android:minHeight="1000dp"
        android:layout_below="@+id/homepage_status"
        app:srlDragRate="0.5"
        app:srlEnableLoadmore="false"
        app:srlEnablePreviewInEditMode="true"
        app:srlHeaderHeight="30dp"
        app:srlRealHeaderHeight="30dp">
        <com.huami.module.homepage.sync.view.refresh.HomeRefreshHeader
            android:id="@+id/homepage_refresh_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:srlAccentColor="@color/s2"
            app:srlDrawableProgressSize="0dp"
            app:srlEnableLastTime="false"
            app:srlFinishDuration="0"
            app:srlPrimaryColor="@android:color/transparent"
            app:srlTextSizeTitle="12sp"/>
        <androidx.core.widget.NestedScrollView
            android:id="@+id/homepage_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.huami.module.homepage.sync.view.refresh.ServerFaultView
                    android:id="@+id/homepage_server_fault"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <FrameLayout
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/homepage_card_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <FrameLayout
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/homepage_promotion_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </com.huami.module.homepage.sync.view.refresh.HomeRefreshLayout>
</RelativeLayout>
