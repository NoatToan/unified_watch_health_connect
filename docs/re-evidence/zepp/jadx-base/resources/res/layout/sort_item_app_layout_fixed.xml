<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/s38"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/sort_icon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:tint="@color/s2"
        android:layout_centerVertical="true"
        android:layout_marginStart="18dp"
        android:layout_alignParentStart="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toStartOf="@+id/sort_item_drag_area"
        android:layout_toEndOf="@+id/sort_icon">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/s1"
            android:gravity="start"
            android:id="@+id/sort_item_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/s1"
            android:gravity="start"
            android:id="@+id/sort_item_sub_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"/>
    </LinearLayout>
</RelativeLayout>
