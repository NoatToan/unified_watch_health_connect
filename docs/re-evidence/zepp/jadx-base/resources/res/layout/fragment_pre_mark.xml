<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="bottom|center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/btn_start_mark"
        android:background="@drawable/pre_mark_button_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_start_tagging"
        android:scaleType="centerInside"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#4d000000"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tx_action_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="46.7dp"
        android:layout_marginBottom="35.3dp"
        android:text="@string/tagging_tip"
        android:layout_marginStart="61dp"
        android:layout_marginEnd="61dp"/>
</LinearLayout>
