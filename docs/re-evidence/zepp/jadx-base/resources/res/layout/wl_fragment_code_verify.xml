<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="12sp"
        android:textColor="#5c000000"
        android:id="@+id/tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:text="@string/wl_sms_code_verify_tip"
        android:lineSpacingExtra="6sp"/>
    <EditText
        android:textSize="14sp"
        android:textColor="#e6000000"
        android:textColorHint="#5c000000"
        android:id="@+id/sms_code"
        android:background="@drawable/wl_watch_bank_text_bg"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:hint="@string/wl_sms_code_input_hint"
        android:layout_below="@+id/tip"
        android:inputType="number"
        android:textCursorDrawable="@drawable/wl_watch_bank_cursor_edit_box"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="5dp"
        android:layout_toStartOf="@+id/get_sms_code"/>
    <TextView
        android:id="@+id/get_sms_code"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:minWidth="100dp"
        android:text="@string/wl_get_verify_code"
        android:layout_below="@+id/tip"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:layout_marginEnd="20dp"
        android:layout_alignParentEnd="true"
        style="@style/BlackGreyBtn"/>
    <TextView
        android:enabled="false"
        android:id="@+id/submit"
        android:background="@drawable/wl_watch_bank_corner_white_rect"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_margin="20dp"
        android:text="@string/wl_bank_finish"
        android:layout_alignParentBottom="true"
        style="@style/UnionPayBlackBtn"/>
</RelativeLayout>
