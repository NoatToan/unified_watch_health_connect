<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/s20"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.viewpager.widget.ViewPager
            android:id="@+id/view_pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"/>
        <com.xiaomi.hm.health.bodyfat.view.CirclePageIndicator xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/indicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="33.3dp"
            app:fillColor="@color/s5"
            app:gap="8dp"
            app:pageColor="@color/s2"
            app:radius="2.5dp"
            app:strokeWidth="0dp"/>
    </FrameLayout>
    <include
        android:id="@+id/weight_instrcut"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerHorizontal="true"
        layout="@layout/weight_instruct"/>
    <include
        android:id="@+id/weight_unit_setting"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginTop="220dp"
        android:layout_centerHorizontal="true"
        layout="@layout/scale_unit_instrcut"/>
    <include
        android:id="@+id/one_foot_page"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="180.9dp"
        android:layout_centerHorizontal="true"
        layout="@layout/one_foot_instrcution"/>
    <include
        android:id="@+id/small_w_page"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="234.9dp"
        android:layout_centerHorizontal="true"
        layout="@layout/small_thing_weighting_instrcution"/>
    <include
        android:id="@+id/page_over_max"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="220dp"
        android:layout_centerHorizontal="true"
        layout="@layout/instruct_overload"/>
    <include
        android:id="@+id/page_low_battery"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="220dp"
        android:layout_centerHorizontal="true"
        layout="@layout/instruct_low_battery"/>
</RelativeLayout>
