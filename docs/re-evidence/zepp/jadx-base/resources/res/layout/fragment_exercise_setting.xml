<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/setting_title_layout"
        android:background="@color/s38"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:layout_alignParentTop="true">
        <ImageView
            android:id="@+id/common_title_left_button"
            android:layout_width="48dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_arrow_back_20_2x"
            android:scaleType="centerInside"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            app:tint="@color/s1"/>
        <TextView
            android:textSize="15.4sp"
            android:textColor="@color/s1"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/common_title_text"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="@string/sport_setting_new"
            android:maxLines="1"
            android:layout_centerInParent="true"/>
        <View
            android:background="@color/s10"
            android:layout_width="match_parent"
            android:layout_height="0.3dp"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
    <com.xiaomi.hm.health.bodyfat.view.VerticalScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/setting_title_layout"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.huami.lib.rainbow.ListTile
                android:id="@+id/auto_pause_switcher"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ltv_checked="true"
                app:ltv_divider_padding="all"
                app:ltv_title="@string/running_auto_pause"/>
            <com.huami.lib.rainbow.ListTile
                android:id="@+id/audio_play_switcher"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ltv_checked="true"
                app:ltv_divider_padding="all"
                app:ltv_title="@string/running_audio_play"/>
            <com.huami.lib.rainbow.ListTile
                android:id="@+id/screen_on_switcher"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ltv_checked="true"
                app:ltv_divider_padding="all"
                app:ltv_title="@string/sport_screen_on"/>
            <com.huami.lib.rainbow.ListTile
                android:id="@+id/treadmill_sound_state"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ltv_divider_padding="all"
                app:ltv_title="@string/treadmill_sound"/>
            <include
                android:id="@+id/space_below_choose_map"
                layout="@layout/view_gap"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/auto_pause_pace_seek_bar_container"
                android:background="@color/s38"
                android:paddingTop="20dp"
                android:paddingBottom="17dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="17dp"
                android:paddingEnd="17dp">
                <com.huami.widget.typeface.TypefaceTextView
                    android:textSize="15.4sp"
                    android:textColor="@color/s1"
                    android:id="@+id/auto_pause_pace_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableBottom="@drawable/triangle_drop_down"
                    android:drawablePadding="7dp"
                    android:fontFamily="km"/>
                <com.huami.moving.ui.view.PaceNotiSeekBar
                    android:id="@+id/auto_pause_seek_bar_pace"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:layout_marginTop="12dp"
                    app:psb_backgroundHeight="3dp"
                    app:psb_max="100"
                    app:psb_progress="0"
                    app:psb_thumbSize="20.2dp"/>
                <TextView
                    android:textSize="11.5sp"
                    android:textColor="@color/s2"
                    android:layout_gravity="end"
                    android:id="@+id/auto_pause_pace_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/running_detail_pace1"/>
            </LinearLayout>
            <include
                android:id="@+id/space_below_auto_pause_seek_bar"
                android:visibility="gone"
                layout="@layout/view_gap"/>
            <com.huami.lib.rainbow.ListTile
                android:id="@+id/pace_notify_switcher"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ltv_checked="true"
                app:ltv_divider_padding="all"
                app:ltv_subtitle="@string/sport_config_pace_notify_tip"
                app:ltv_title="@string/running_set_pace"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/pace_seek_bar_container"
                android:background="@color/s38"
                android:paddingTop="20dp"
                android:paddingBottom="17dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="17dp"
                android:paddingEnd="17dp">
                <com.huami.widget.typeface.TypefaceTextView
                    android:textSize="15.4sp"
                    android:textColor="@color/s1"
                    android:id="@+id/pace_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableBottom="@drawable/triangle_drop_down"
                    android:drawablePadding="7dp"
                    android:fontFamily="km"/>
                <com.huami.moving.ui.view.PaceNotiSeekBar
                    android:id="@+id/seek_bar_pace"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:layout_marginTop="12dp"
                    app:psb_backgroundHeight="3dp"
                    app:psb_max="100"
                    app:psb_progress="0"
                    app:psb_thumbSize="20.2dp"/>
                <TextView
                    android:textSize="11.5sp"
                    android:textColor="@color/s2"
                    android:layout_gravity="end"
                    android:id="@+id/pace_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/running_detail_pace1"/>
            </LinearLayout>
            <include
                android:id="@+id/space_below_seek_bar"
                layout="@layout/view_gap"/>
            <com.huami.lib.rainbow.ListTile
                android:id="@+id/beat_switcher"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ltv_checked="true"
                app:ltv_divider_padding="all"
                app:ltv_subtitle="@string/sport_config_beat_tip"
                app:ltv_title="@string/sport_config_beat_title"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/beat_bar_container"
                android:background="@color/s38"
                android:paddingTop="20dp"
                android:paddingBottom="17dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="17dp"
                android:paddingEnd="17dp">
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/beat_value_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <com.huami.widget.typeface.TypefaceTextView
                        android:textSize="15.4sp"
                        android:textColor="@color/s1"
                        android:id="@+id/beat_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawableBottom="@drawable/triangle_drop_down"
                        android:drawablePadding="7dp"
                        android:fontFamily="km"/>
                </LinearLayout>
                <com.xiaomi.hm.health.training.ui.widget.HeartRateSeekBar
                    android:id="@+id/beat_bar"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:layout_marginTop="12dp"
                    app:hrsb_backgroundHeight="3dp"
                    app:hrsb_max="220"
                    app:hrsb_progress="0"
                    app:hrsb_section_colors="@array/beat_section_colors_zepp"
                    app:hrsb_section_percent="@array/beat_section_percents"
                    app:hrsb_thumbSize="20.2dp"/>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp">
                    <TextView
                        android:textSize="13.4sp"
                        android:textColor="@color/cl_exercise_setting_text_not"
                        android:id="@+id/beat_section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"/>
                    <TextView
                        android:textSize="11.5sp"
                        android:textColor="@color/s2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="1dp"
                        android:text="@string/hr_unit"
                        android:layout_marginEnd="3dp"
                        android:layout_alignParentEnd="true"/>
                </RelativeLayout>
            </LinearLayout>
            <include
                android:id="@+id/space_below_beat"
                layout="@layout/view_gap"/>
            <com.huami.lib.rainbow.ListTile
                android:id="@+id/max_hr_notify_switcher"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ltv_checked="true"
                app:ltv_divider_padding="all"
                app:ltv_subtitle="@string/max_hr_warning_desc"
                app:ltv_title="@string/max_hr_warning"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/hr_seek_bar_container"
                android:background="@color/s38"
                android:paddingTop="20dp"
                android:paddingBottom="17dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="17dp"
                android:paddingEnd="17dp">
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/hr_value_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <com.huami.widget.typeface.TypefaceTextView
                        android:textSize="15.4sp"
                        android:textColor="@color/s1"
                        android:id="@+id/hr_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawableBottom="@drawable/triangle_drop_down"
                        android:drawablePadding="7dp"
                        android:fontFamily="km"/>
                </LinearLayout>
                <com.xiaomi.hm.health.training.ui.widget.HeartRateSeekBar
                    android:id="@+id/seek_bar_max_hr"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:layout_marginTop="12dp"
                    app:hrsb_backgroundHeight="3dp"
                    app:hrsb_max="220"
                    app:hrsb_progress="0"
                    app:hrsb_section_colors="@array/sport_hr_section_colors_zepp"
                    app:hrsb_thumbSize="20.2dp"/>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp">
                    <TextView
                        android:textSize="13.4sp"
                        android:textColor="@color/cl_exercise_setting_text_not"
                        android:id="@+id/hr_section_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"/>
                    <TextView
                        android:textSize="13.4sp"
                        android:textColor="@color/cl_exercise_setting_text_not"
                        android:id="@+id/hr_section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@+id/hr_section_title"/>
                    <TextView
                        android:textSize="11.5sp"
                        android:textColor="@color/s2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="1dp"
                        android:text="@string/sport_heart_rate_unit"
                        android:layout_marginEnd="3dp"
                        android:layout_alignParentEnd="true"/>
                </RelativeLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/sport_internal_set_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <include
                    android:id="@+id/space_below_pace_noti_bar"
                    layout="@layout/view_gap"/>
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/draw_gps_line_switcher"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ltv_checked="true"
                    app:ltv_divider_padding="all"
                    app:ltv_title="@string/sport_internal_setting_gps_line"/>
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/create_test_point_switcher"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ltv_checked="true"
                    app:ltv_divider_padding="all"
                    app:ltv_title="@string/sport_internal_setting_gps_point"/>
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/security_center"
                    android:background="@color/s38"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ltv_checked="false"
                    app:ltv_divider_padding="all"
                    app:ltv_title="@string/sport_internal_setting_security_center"/>
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/super_hide_mode"
                    android:background="@color/s38"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ltv_checked="false"
                    app:ltv_title="@string/sport_internal_setting_super_mode"/>
            </LinearLayout>
            <View
                android:background="@color/s4"
                android:layout_width="match_parent"
                android:layout_height="0.3dp"/>
            <View
                android:layout_width="match_parent"
                android:layout_height="40dp"/>
        </LinearLayout>
    </com.xiaomi.hm.health.bodyfat.view.VerticalScrollView>
</RelativeLayout>
