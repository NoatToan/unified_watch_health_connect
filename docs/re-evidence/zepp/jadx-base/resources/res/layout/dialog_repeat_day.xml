<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingBottom="@dimen/size_16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/size_16dp"
    android:paddingEnd="@dimen/size_16dp">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/alarm_item_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="18sp"
            android:textColor="#191919"
            android:layout_gravity="center_horizontal"
            android:id="@+id/title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/alarm_clock_repeat"
            android:fontFamily="km"/>
        <TextView
            android:textSize="@dimen/size_12sp"
            android:textColor="#666666"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_2dp"
            android:layout_marginBottom="9dp"
            android:text="@string/allow_multi_select"/>
        <View
            android:background="#0d000000"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <View
            android:background="#0d000000"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/size_16sp"
                android:textColor="#191919"
                android:gravity="center"
                android:id="@+id/tv_cancel"
                android:layout_width="wrap_content"
                android:layout_height="55dp"
                android:text="@string/cancel"
                android:layout_weight="1"/>
            <View
                android:layout_gravity="center_vertical"
                android:background="#0d000000"
                android:layout_width="@dimen/td_size_1dp"
                android:layout_height="@dimen/size_14dp"/>
            <TextView
                android:textSize="@dimen/size_16sp"
                android:textColor="#191919"
                android:gravity="center"
                android:id="@+id/tv_confirm"
                android:layout_width="wrap_content"
                android:layout_height="55dp"
                android:text="@string/confirm"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
