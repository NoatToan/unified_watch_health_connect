<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/sky_rect_radius_6_s45"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14sp"
        android:textColor="@color/s46"
        android:ellipsize="end"
        android:id="@+id/reminder_notification_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_14dp"
        android:text="@string/sky_reminder_notification_title"
        android:maxLines="2"
        android:layout_marginStart="@dimen/size_14dp"
        android:layout_marginEnd="@dimen/size_14dp"
        app:layout_constraintEnd_toStartOf="@+id/reminder_notification_open"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="12sp"
        android:textColor="@color/s46"
        android:ellipsize="end"
        android:id="@+id/reminder_notification_sub_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_5dp"
        android:layout_marginBottom="@dimen/size_14dp"
        android:text="@string/sky_reminder_notification_sub_title"
        android:maxLines="2"
        android:layout_marginStart="@dimen/size_14dp"
        android:layout_marginEnd="@dimen/size_14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/reminder_notification_open"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/reminder_notification_title"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14sp"
        android:textColor="@color/s46"
        android:gravity="center"
        android:id="@+id/reminder_notification_open"
        android:paddingTop="@dimen/size_8dp"
        android:paddingBottom="@dimen/size_8dp"
        android:layout_width="@dimen/size_80dp"
        android:layout_height="wrap_content"
        android:text="@string/sky_reminder_notification_open"
        android:paddingStart="@dimen/size_8dp"
        android:paddingEnd="@dimen/size_8dp"
        android:layout_marginEnd="@dimen/size_14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
