<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:background="@null"
    android:paddingLeft="@dimen/size_15dp"
    android:paddingRight="@dimen/size_15dp"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="@dimen/size_64dp">
    <ImageView
        android:id="@+id/iv_vibration"
        android:clickable="false"
        android:layout_width="@dimen/size_24dp"
        android:layout_height="@dimen/size_24dp"
        android:layout_marginEnd="@dimen/size_8dp"/>
    <TextView
        android:textSize="@dimen/size_16sp"
        android:textColor="@color/s1"
        android:id="@+id/tv_vibration"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@+id/iv_vibration"/>
    <ImageView
        android:id="@+id/iv_select"
        android:visibility="invisible"
        android:clickable="false"
        android:layout_width="@dimen/size_20dp"
        android:layout_height="@dimen/size_20dp"
        android:src="@drawable/ic_vibration_selected"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
