<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:huami="http://schemas.android.com/apk/res-auto"
    android:scrollbars="none"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="never">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.huami.lib.view.widget.TipComponent
            android:layout_gravity="start"
            android:id="@+id/call_permission_tips"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.huami.lib.rainbow.ListTile
            android:id="@+id/incoming_call_enable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            huami:ltv_checked="true"
            huami:ltv_subtitle="@string/enable_incoming_call_alert_tips"
            huami:ltv_title="@string/enable_incoming_call_alert"/>
        <com.huami.lib.rainbow.ListTile
            android:id="@+id/vibrate_mode_iv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            huami:ltv_tips="@string/custom_vibrate_mode_default"
            huami:ltv_title="@string/custom_vibrate_mode"/>
        <com.huami.lib.rainbow.ListTile
            android:id="@+id/strange_number_alert"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            huami:ltv_checked="true"
            huami:ltv_title="@string/strange_number_tips"/>
        <com.huami.lib.rainbow.ListTile
            android:id="@+id/show_contact_info_alert"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            huami:ltv_checked="true"
            huami:ltv_subtitle="@string/show_contact_info_summary"
            huami:ltv_title="@string/show_contact_info_tips"/>
        <com.huami.lib.rainbow.ListTile
            android:id="@+id/item_sms_call_reply"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            huami:ltv_checked="true"
            huami:ltv_title="@string/incoming_call_reply"/>
        <com.huami.lib.rainbow.ListTile
            android:id="@+id/item_sms_call_reply_management"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            huami:ltv_title="@string/incoming_call_reply_msg_management"/>
        <com.huami.lib.rainbow.ListTile
            android:id="@+id/incoming_call_delay_enable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            huami:ltv_checked="true"
            huami:ltv_title="@string/delay_alert"/>
        <com.huami.lib.rainbow.ListTile
            android:id="@+id/incoming_call_delay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            huami:ltv_tips="@string/incoming_call_delay_alert_tips"
            huami:ltv_title="@string/delay_alert_time"/>
        <com.xiaomi.hm.health.ui.smartplay.appnotify.view.NotificationFaqView
            android:id="@+id/tv_notification_faq"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_12dp"/>
    </LinearLayout>
</ScrollView>
