<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Rainbow.TextAppearance.Title2"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/averageHrLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/heart_rate_statistics_average"
        app:layout_constraintStart_toStartOf="@+id/title"
        app:layout_constraintTop_toBottomOf="@+id/title"
        style="@style/Rainbow.TextAppearance.Body3"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/averageHr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/averageHrLabel"
        app:layout_constraintEnd_toStartOf="@+id/averageHrUnit"
        app:layout_constraintTop_toTopOf="@+id/averageHrLabel"
        style="@style/Rainbow.TextAppearance.Number5"/>
    <TextView
        android:textColor="@color/s2"
        android:id="@+id/averageHrUnit"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/hm_common_heartrate_bpm"
        app:layout_constraintBottom_toBottomOf="@+id/averageHrLabel"
        app:layout_constraintEnd_toEndOf="parent"
        style="@style/Rainbow.TextAppearance.Body5"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/maxHrLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/heart_rate_statistics_max"
        app:layout_constraintStart_toStartOf="@+id/title"
        app:layout_constraintTop_toBottomOf="@+id/averageHrLabel"
        style="@style/Rainbow.TextAppearance.Body3"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/maxHr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/maxHrLabel"
        app:layout_constraintEnd_toStartOf="@+id/maxHrUnit"
        app:layout_constraintTop_toTopOf="@+id/maxHrLabel"
        style="@style/Rainbow.TextAppearance.Number5"/>
    <TextView
        android:textColor="@color/s2"
        android:id="@+id/maxHrUnit"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/hm_common_heartrate_bpm"
        app:layout_constraintBottom_toBottomOf="@+id/maxHrLabel"
        app:layout_constraintEnd_toEndOf="parent"
        style="@style/Rainbow.TextAppearance.Body5"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/minHrLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/heart_rate_statistics_min"
        app:layout_constraintStart_toStartOf="@+id/title"
        app:layout_constraintTop_toBottomOf="@+id/maxHrLabel"
        style="@style/Rainbow.TextAppearance.Body3"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/minHr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/minHrLabel"
        app:layout_constraintEnd_toStartOf="@+id/minHrUnit"
        app:layout_constraintTop_toTopOf="@+id/minHrLabel"
        style="@style/Rainbow.TextAppearance.Number5"/>
    <TextView
        android:textColor="@color/s2"
        android:id="@+id/minHrUnit"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/hm_common_heartrate_bpm"
        app:layout_constraintBottom_toBottomOf="@+id/minHrLabel"
        app:layout_constraintEnd_toEndOf="parent"
        style="@style/Rainbow.TextAppearance.Body5"/>
</androidx.constraintlayout.widget.ConstraintLayout>
