<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/image_item_iv"
        android:background="@color/s15"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/ic_first_aid_24"
        android:scaleType="center"
        android:tint="@color/s5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearance="@style/ShapeAppearance.App.Circular"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/s2"
        android:gravity="center"
        android:id="@+id/image_item_name"
        android:focusable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:fontFamily="lt"
        app:layout_constraintEnd_toEndOf="@+id/image_item_iv"
        app:layout_constraintStart_toStartOf="@+id/image_item_iv"
        app:layout_constraintTop_toBottomOf="@+id/image_item_iv"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/image_item_dot"
        android:visibility="gone"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:src="@drawable/shape_dot"
        app:layout_constraintEnd_toEndOf="@+id/image_item_iv"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
