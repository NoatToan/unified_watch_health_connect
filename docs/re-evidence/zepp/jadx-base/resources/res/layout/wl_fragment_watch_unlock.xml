<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/unlock_img"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:src="@drawable/wl_watch_bank_unlock_bg"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#80000000"
        android:gravity="center"
        android:id="@+id/unlock_msg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:layout_below="@+id/unlock_img"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:id="@+id/forget_pwd"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginBottom="14dp"
        android:text="@string/wl_watch_forget_pwd"
        android:layout_above="@+id/watch_unlock"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        style="@style/UnionPayRedTextBtn"/>
    <TextView
        android:id="@+id/watch_unlock"
        android:background="@drawable/wl_watch_bank_corner_white_rect"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="14dp"
        android:text="@string/wl_watch_unlock_btn"
        android:layout_above="@+id/watch_unlock_complete"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        style="@style/UnionPayBlackBtn"/>
    <TextView
        android:enabled="false"
        android:id="@+id/watch_unlock_complete"
        android:background="@drawable/wl_watch_bank_corner_white_rect"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="20dp"
        android:text="@string/wl_watch_unlock_complete"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        style="@style/UnionPayBlackBtn"/>
</RelativeLayout>
