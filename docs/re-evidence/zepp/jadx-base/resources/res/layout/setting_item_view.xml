<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s38"
    android:layout_width="match_parent"
    android:layout_height="@dimen/size_64dp">
    <ImageView
        android:id="@+id/left_arrow_iv"
        android:visibility="gone"
        android:layout_width="@dimen/size_12dp"
        android:layout_height="@dimen/size_12dp"
        android:src="@drawable/icon_phone_alert_left_arrow"
        android:layout_marginStart="@dimen/size_8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="26dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="@dimen/item_title_size"
            android:textColor="@color/s1"
            android:id="@+id/title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lines="1"
            android:fontFamily="lt"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="@dimen/item_summary_text_size"
            android:textColor="@color/s2"
            android:id="@+id/sub_title_tv"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:lines="1"
            android:fontFamily="lt"/>
    </LinearLayout>
    <View
        android:id="@+id/divider_view"
        android:background="@color/s4"
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <View
        android:id="@+id/mask_view"
        android:background="@color/s38"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.65"/>
</merge>
