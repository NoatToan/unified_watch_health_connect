<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/sleep_main_bg"
    android:layout_width="match_parent"
    android:layout_height="140dp">
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/breathDayName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:maxWidth="270dp"
        android:text="@string/sleep_breath_quality"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Rainbow.TextAppearance.Body3"/>
    <ImageView
        android:id="@+id/imgBetaSign"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_sleep_breath_quality_beta"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/breathDayName"
        app:layout_constraintStart_toEndOf="@+id/breathDayName"
        app:layout_constraintTop_toTopOf="@+id/breathDayName"/>
    <ImageView
        android:id="@+id/breathDayEmo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/breathDayDivide"
        app:layout_constraintStart_toStartOf="@+id/breathDayName"
        app:layout_constraintTop_toBottomOf="@+id/breathDayName"
        app:layout_constraintTop_toTopOf="@+id/breathDayDivide"/>
    <TextView
        android:textSize="20sp"
        android:textColor="@color/s1"
        android:id="@+id/breathDayStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/breathDayDivide"
        app:layout_constraintStart_toEndOf="@+id/breathDayEmo"
        app:layout_constraintTop_toTopOf="@+id/breathDayDivide"/>
    <View
        android:id="@+id/breathDayDivide"
        android:background="@color/s4"
        android:layout_width="1dp"
        android:layout_height="36dp"
        android:layout_marginTop="18dp"
        android:layout_marginStart="10dp"
        app:layout_constraintStart_toEndOf="@+id/breathDayStatus"
        app:layout_constraintTop_toBottomOf="@+id/breathDayName"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/s2"
        android:id="@+id/breathDayScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toEndOf="@+id/breathDayDivide"
        app:layout_constraintTop_toTopOf="@+id/breathDayDivide"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/s2"
        android:id="@+id/breathDayAdvice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/breathDayScore"
        app:layout_constraintTop_toBottomOf="@+id/breathDayScore"
        app:layout_goneMarginStart="12dp"/>
    <com.huami.sleep.view.PiecewiseLineView
        android:id="@+id/piecewiseView"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_marginBottom="20dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
