<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="20sp"
        android:textColor="@color/s1"
        android:gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_18dp"
        android:text="@string/bind_headset_single_headset"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14sp"
        android:textColor="@color/s2"
        android:gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_9dp"
        android:text="@string/bind_headset_single_headset_tips"
        android:layout_marginStart="@dimen/size_40dp"
        android:layout_marginEnd="@dimen/size_40dp"/>
    <Space
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/img_bind_mozart_single"/>
    <Space
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="3"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size_48dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/size_20dp"
        android:layout_marginEnd="@dimen/size_20dp">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/p3"
            android:gravity="center"
            android:id="@+id/tv_upgrade"
            android:background="@drawable/bg_bind_device_cancel"
            android:layout_width="0dp"
            android:layout_height="@dimen/size_48dp"
            android:text="@string/bind_headset_upgrade"
            android:layout_weight="1"/>
        <Space
            android:layout_width="@dimen/size_21dp"
            android:layout_height="0dp"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/s1"
            android:gravity="center"
            android:id="@+id/tv_next"
            android:background="@drawable/bg_bind_device_cancel"
            android:layout_width="0dp"
            android:layout_height="@dimen/size_48dp"
            android:text="@string/bind_headset_do_bind"
            android:layout_weight="1"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.appcompat.widget.LinearLayoutCompat>
