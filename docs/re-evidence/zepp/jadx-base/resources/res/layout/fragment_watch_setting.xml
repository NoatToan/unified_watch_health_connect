<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/s10"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:background="@color/s10"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="start|center_vertical"
            android:id="@+id/btn_back"
            android:background="@null"
            android:layout_width="@dimen/size_29dp"
            android:layout_height="@dimen/size_27dp"
            android:src="@drawable/arrow_back_black"
            android:scaleType="center"
            android:tint="@color/s1"
            android:layout_marginStart="@dimen/size_10dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/top_line"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/s1"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/watch_setting"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/size_24dp"
            android:text="@string/ds_watch_setting"/>
    </androidx.appcompat.widget.Toolbar>
    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.core.widget.NestedScrollView
            android:background="@color/s10"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="vertical"
                android:background="@drawable/shape_corners_device_setting"
                android:paddingTop="@dimen/size_6dp"
                android:paddingBottom="@dimen/size_6dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_15dp"
                android:layout_marginStart="@dimen/size_15dp"
                android:layout_marginEnd="@dimen/size_15dp"
                app:divider="@drawable/layer_divider_shape"
                app:showDividers="middle">
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/item_display_brightness"
                    android:background="@color/s38"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ltv_title="@string/ds_display_brightness"/>
                <com.huami.lib.rainbow.ListTile
                    android:background="@color/s38"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ltv_title="@string/ds_nfc"/>
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/device_setting_sound_vibration"
                    android:background="@color/s38"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ltv_title="@string/ds_sound_vibration"/>
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/device_setting_sport"
                    android:background="@color/s38"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ltv_title="@string/ds_sport"/>
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/device_setting_dnd"
                    android:background="@color/s38"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ltv_title="@string/ds_dnd"/>
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/device_setting_sleep_mode"
                    android:background="@color/s38"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ltv_title="@string/ctrl_center_sleep"/>
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/ds_offWist_setting"
                    android:background="@color/s38"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ltv_title="@string/ds_lock_password"/>
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/ds_quick_start_long_press_side"
                    android:background="@color/s38"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ltv_title="@string/ds_quick_start_long_press_side"/>
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/ds_quick_start_long_press_up"
                    android:background="@color/s38"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ltv_title="@string/ds_quick_start_long_press_up"/>
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/ds_quick_start_click_down"
                    android:background="@color/s38"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ltv_title="@string/ds_quick_start_click_down"/>
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/ds_app_sort"
                    android:background="@color/s38"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ltv_subtitle="@string/setting_tempo_apps_tips"
                    app:ltv_title="@string/setting_peyto_apps_title_band"/>
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/ds_short_cut"
                    android:background="@color/s38"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ltv_subtitle="@string/setting_shotcut_apps_tips"
                    app:ltv_title="@string/setting_shotcut_apps_title"/>
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/ds_quick_start"
                    android:background="@color/s38"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ltv_title="@string/ds_quick_start"/>
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/ds_screen_edit"
                    android:background="@color/s38"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ltv_title="@string/ds_screen_edit"/>
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/ds_control_center_edit"
                    android:background="@color/s38"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ltv_title="@string/ds_control_center_edit"/>
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/device_setting_offline_voice_wakeup_method"
                    android:background="@color/s38"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ltv_title="@string/ds_offline_voice_wakeup_method"/>
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/device_language"
                    android:background="@color/s38"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ltv_title="@string/ds_device_langauge"/>
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/device_gesture"
                    android:background="@color/s38"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ltv_title="@string/ds_device_gesture"/>
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/ds_wearing_method"
                    android:background="@color/s38"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ltv_title="@string/ds_wearing_method"/>
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/night_mode"
                    android:background="@color/s38"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ltv_title="@string/night_mode"/>
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/device_morning_greeting"
                    android:background="@color/s38"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ltv_title="@string/ds_device_morning_greeting"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.core.widget.NestedScrollView>
        <View
            android:id="@+id/mask_view"
            android:background="@color/cl_4d000000"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
</androidx.appcompat.widget.LinearLayoutCompat>
