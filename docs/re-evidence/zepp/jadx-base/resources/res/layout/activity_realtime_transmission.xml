<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.huami.lib.rainbow.titlebar.RainbowTitleBar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:navigationIcon="@drawable/ic_arrow_back_20_2x"
            app:title="@string/realtime_sync"/>
        <FrameLayout
            android:id="@+id/device_state_view_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.huami.lib.rainbow.ListTile
            android:id="@+id/container_toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            app:ltv_checked="true"
            app:ltv_radius_position="all"
            app:ltv_subtitle="@string/toggle_realtime_sync_tips"
            app:ltv_title="@string/toggle_realtime_sync"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/container_tips"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp">
                <TextView
                    android:textColor="@color/s2"
                    android:id="@+id/tv_realtime_open_tips1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/open_realtime_tips1"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    style="@style/Rainbow.TextAppearance.Body4"/>
                <TextView
                    android:textColor="@color/s2"
                    android:id="@+id/tv_realtime_open_tips2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/open_realtime_tips2"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    style="@style/Rainbow.TextAppearance.Body4"/>
                <TextView
                    android:textColor="@color/s2"
                    android:id="@+id/tv_realtime_open_tips3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/open_realtime_tips3"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    style="@style/Rainbow.TextAppearance.Body4"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/container_status"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp">
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/tv_heart_rate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ltv_radius_position="top"
                    app:ltv_title="@string/realtime_heart_rate"/>
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/tv_step"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ltv_title="@string/realtime_steps"/>
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/tv_cal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ltv_radius_position="bottom"
                    app:ltv_title="@string/realtime_cal"/>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
    <TextView
        android:textColor="@color/s3"
        android:id="@+id/tv_realtime_sync_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <com.huami.sync.LoadingView
        android:layout_gravity="end|center_vertical"
        android:id="@+id/loading"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:color="#a5a5a5"
        app:loading_view_size="20dp"/>
</RelativeLayout>
