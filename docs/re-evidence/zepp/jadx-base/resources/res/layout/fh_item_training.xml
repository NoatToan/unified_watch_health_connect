<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s38"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.huami.femalehealth.uilib.widget.FhRoundedImageView
        android:id="@+id/iv_tr_img"
        android:layout_width="100dp"
        android:layout_height="0dp"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="15dp"
        android:scaleType="centerCrop"
        app:fh_riv_bottom_radius="10dp"
        app:fh_riv_up_radius="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="h,1:1"
        app:layout_constraintEnd_toStartOf="@+id/tv_tr_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/s1"
        android:gravity="start"
        android:id="@+id/tv_tr_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="lt-bold"
        android:layout_marginStart="15dp"
        app:layout_constraintStart_toEndOf="@+id/iv_tr_img"
        app:layout_constraintTop_toTopOf="@+id/iv_tr_img"
        style="@style/FhTextSingleLineStyle"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/s2"
        android:id="@+id/level"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="lt"
        android:layout_marginStart="15dp"
        app:layout_constraintStart_toEndOf="@+id/iv_tr_img"
        app:layout_constraintTop_toBottomOf="@+id/tv_tr_name"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/s2"
        android:id="@+id/number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="lt"
        android:layout_marginStart="10dp"
        app:layout_constraintStart_toEndOf="@+id/level"
        app:layout_constraintTop_toBottomOf="@+id/tv_tr_name"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/s2"
        android:id="@+id/calorie"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="lt"
        android:layout_marginStart="10dp"
        app:layout_constraintStart_toEndOf="@+id/number"
        app:layout_constraintTop_toBottomOf="@+id/tv_tr_name"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/s2"
        android:id="@+id/number_learned"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="lt"
        android:layout_marginStart="15dp"
        app:layout_constraintStart_toEndOf="@+id/iv_tr_img"
        app:layout_constraintTop_toBottomOf="@+id/level"/>
    <TextView
        android:textSize="13sp"
        android:gravity="center"
        android:id="@+id/tv_join"
        android:background="@drawable/fh_orange_radius_btn_bg_for_training"
        android:layout_width="80dp"
        android:layout_height="28dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        android:text="@string/fh_join_course"
        android:fontFamily="lt"
        android:layout_marginStart="15dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_tr_img"
        app:layout_constraintStart_toEndOf="@+id/iv_tr_img"/>
    <TextView
        android:textSize="11sp"
        android:textColor="@color/white100"
        android:gravity="center"
        android:id="@+id/tv_label"
        android:background="@drawable/fh_orange_icon_label_bg"
        android:visibility="gone"
        android:layout_width="32dp"
        android:layout_height="17dp"
        android:layout_marginTop="10dp"
        android:fontFamily="lt"
        app:layout_constraintEnd_toEndOf="@+id/iv_tr_img"
        app:layout_constraintTop_toTopOf="@+id/iv_tr_img"/>
</androidx.constraintlayout.widget.ConstraintLayout>
