<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:baseui="http://schemas.android.com/apk/res-auto"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:background="@drawable/account_ui_bg_2022"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.huami.lib.rainbow.titlebar.RainbowTitleBar
            android:id="@+id/title_bar"
            android:background="@color/account_ui_transparency"
            android:layout_width="match_parent"
            android:layout_height="@dimen/account_ui_size_50dp"/>
        <TextView
            android:textSize="@dimen/account_ui_size_20sp"
            android:textStyle="bold"
            android:textColor="@color/s1"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="@string/account_ui_last_login_type_title"/>
        <com.huami.lib.view.image.CircleImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/image_avatar"
            android:layout_width="86dp"
            android:layout_height="86dp"
            android:layout_marginTop="40dp"
            android:src="@drawable/setting_avatar_default"
            baseui:civ_border_color="@color/s3"
            baseui:civ_border_width="1dp"
            baseui:civ_fill_color="@color/s3"
            baseui:hm_civ_mask_color="@color/s3"
            baseui:hm_civ_show_mask="true"/>
        <TextView
            android:textSize="@dimen/account_ui_size_20sp"
            android:textStyle="bold"
            android:textColor="@color/s1"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_nickname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"/>
        <TextView
            android:textSize="@dimen/account_ui_size_14sp"
            android:textColor="@color/s2"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_last_login_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <com.huami.lib.rainbow.button.RainbowButton
            android:textColor="@color/account_ui_white"
            android:gravity="center"
            android:id="@+id/button_login"
            android:background="@drawable/account_ui_btn_bg_login"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="40dp"
            android:text="@string/account_ui_phone_login_this_account"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"/>
        <TextView
            android:textColor="@color/s1"
            android:gravity="center"
            android:id="@+id/button_login_other"
            android:background="@drawable/account_ui_btn_stroke_s46"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:text="@string/account_ui_phone_login_other_account"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"/>
    </LinearLayout>
</FrameLayout>
