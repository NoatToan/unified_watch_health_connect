<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.exoplayer2.ui.AspectRatioFrameLayout
        android:id="@+id/aspect_ratio_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit">
        <SurfaceView
            android:layout_gravity="center"
            android:id="@+id/video_surface"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </com.google.android.exoplayer2.ui.AspectRatioFrameLayout>
    <ImageView
        android:id="@+id/post"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <View
        android:id="@+id/top_mask"
        android:background="@drawable/tr_fc_play_top_mask"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/bottom_mask"
        android:background="@drawable/tr_fc_play_bottom_mask"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <View
        android:id="@+id/middle_mask"
        android:background="@color/black30"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.xiaomi.hm.health.training.ui.widget.RealTimeHrView
        android:id="@+id/real_time_hr"
        android:visibility="gone"
        android:layout_width="82dp"
        android:layout_height="82dp"
        android:layout_marginBottom="27dp"
        android:layout_marginEnd="33dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:rthv_circle_bg_color="@color/black_90"
        app:rthv_colors="@array/hr_section_colors"
        app:rthv_entries="@array/tr_hr_section_names"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/white100"
        android:id="@+id/hr_initial_desc"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/training_hr"
        android:drawableTop="@drawable/icon_training_heart"
        android:drawablePadding="3dp"
        android:layout_centerInParent="true"
        app:layout_constraintBottom_toBottomOf="@+id/real_time_hr"
        app:layout_constraintEnd_toEndOf="@+id/real_time_hr"
        app:layout_constraintStart_toStartOf="@+id/real_time_hr"
        app:layout_constraintTop_toTopOf="@+id/real_time_hr"/>
    <ProgressBar
        android:id="@+id/video_buffering_progress"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateDrawable="@drawable/training_progress"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/white100"
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="11dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/btn_close"
        app:layout_constraintEnd_toStartOf="@+id/purchase_prompt"
        app:layout_constraintStart_toEndOf="@+id/btn_close"
        app:layout_constraintTop_toTopOf="@+id/btn_close"/>
    <ImageView
        android:id="@+id/btn_settings"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/tr_fc_play_settings"
        android:scaleType="centerInside"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="11sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/purchase_prompt"
        android:background="@drawable/tr_round_rect_black60"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/btn_settings"
        app:layout_constraintEnd_toStartOf="@+id/btn_settings"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toEndOf="@+id/title"
        app:layout_constraintTop_toTopOf="@+id/btn_settings"/>
    <ImageView
        android:id="@+id/btn_play"
        android:layout_width="43dp"
        android:layout_height="43dp"
        android:layout_marginBottom="13dp"
        android:src="@drawable/tr_fc_pause"
        android:layout_marginStart="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ImageView
        android:id="@+id/btn_lock"
        android:layout_width="43dp"
        android:layout_height="43dp"
        android:layout_marginBottom="13dp"
        android:src="@drawable/tr_fc_play_lock"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <SeekBar
        android:id="@+id/video_seek_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="31dp"
        android:maxHeight="3dp"
        android:max="100"
        android:progressDrawable="@drawable/tr_fc_video_seekbar_progress"
        android:thumb="@drawable/tr_fc_play_seekbar_thumb"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btn_lock"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/btn_play"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#fffcfcfc"
        android:id="@+id/current_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="@+id/video_seek_bar"
        app:layout_constraintTop_toBottomOf="@+id/video_seek_bar"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/vertical_middle_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/setting_start_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.225"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/setting_end_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.7812"/>
    <TextView
        android:textSize="15sp"
        android:textColor="#fffcfcfc"
        android:id="@+id/brightness_header"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="25dp"
        android:text="@string/tr_brightness"
        android:drawablePadding="13dp"
        android:drawableEnd="@drawable/tr_fc_brightness_min"
        app:layout_constraintBottom_toTopOf="@+id/vertical_middle_guideline"
        app:layout_constraintStart_toEndOf="@+id/setting_start_guideline"/>
    <ImageView
        android:id="@+id/brightness_max_icon"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/tr_fc_brightness_max"
        app:layout_constraintBottom_toBottomOf="@+id/brightness_header"
        app:layout_constraintEnd_toStartOf="@+id/setting_end_guideline"
        app:layout_constraintTop_toTopOf="@+id/brightness_header"/>
    <SeekBar
        android:id="@+id/brightness_seek_bar"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxHeight="3dp"
        android:max="100"
        android:progressDrawable="@drawable/tr_fc_video_seekbar_progress"
        android:thumb="@drawable/tr_fc_play_seekbar_thumb"
        app:layout_constraintBottom_toBottomOf="@+id/brightness_header"
        app:layout_constraintEnd_toStartOf="@+id/brightness_max_icon"
        app:layout_constraintStart_toEndOf="@+id/brightness_header"
        app:layout_constraintTop_toTopOf="@+id/brightness_header"/>
    <TextView
        android:textSize="15sp"
        android:textColor="#fffcfcfc"
        android:id="@+id/volume_header"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:text="@string/tr_volume"
        android:drawablePadding="13dp"
        android:drawableEnd="@drawable/tr_fc_volume_min"
        app:layout_constraintStart_toEndOf="@+id/setting_start_guideline"
        app:layout_constraintTop_toBottomOf="@+id/vertical_middle_guideline"/>
    <ImageView
        android:id="@+id/volume_max_icon"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/tr_fc_volume_max"
        app:layout_constraintBottom_toBottomOf="@+id/volume_header"
        app:layout_constraintEnd_toStartOf="@+id/setting_end_guideline"
        app:layout_constraintTop_toTopOf="@+id/volume_header"/>
    <SeekBar
        android:id="@+id/volume_seek_bar"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxHeight="3dp"
        android:max="100"
        android:progressDrawable="@drawable/tr_fc_video_seekbar_progress"
        android:thumb="@drawable/tr_fc_play_seekbar_thumb"
        app:layout_constraintBottom_toBottomOf="@+id/volume_header"
        app:layout_constraintEnd_toStartOf="@+id/volume_max_icon"
        app:layout_constraintStart_toEndOf="@+id/volume_header"
        app:layout_constraintTop_toTopOf="@+id/volume_header"/>
    <View
        android:id="@+id/intercept_click_mask"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:id="@+id/btn_close"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/tr_fc_close"
        android:scaleType="centerInside"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/horizontal_middle_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <FrameLayout
        android:id="@+id/btn_replay"
        android:background="@drawable/tr_round_rect_black80"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="60dp"
        android:minWidth="150dp"
        android:layout_marginEnd="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/horizontal_middle_guideline"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="13sp"
            android:textColor="#fffcfcfc"
            android:layout_gravity="center"
            android:id="@+id/btn_replay_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tr_play_again"
            android:drawablePadding="6dp"
            android:drawableStart="@drawable/tr_fc_replay"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/btn_next"
        android:background="@drawable/tr_round_rect_orange80"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="60dp"
        android:minWidth="150dp"
        android:layout_marginStart="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/horizontal_middle_guideline"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="13sp"
            android:textColor="#fffcfcfc"
            android:layout_gravity="center"
            android:id="@+id/btn_next_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="6dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
