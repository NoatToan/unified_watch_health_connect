<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s36"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.lib.rainbow.titlebar.RainbowTitleBar
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menuText="@string/save"
        app:menuTint="@color/enable_btn_txt"
        app:navigationText="@string/cancel"
        app:title="@string/mili_setting_off_wist_lock_set_password_title"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/title_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:layout_below="@+id/titleBar">
        <ImageView
            android:id="@+id/password_not_match_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/password_not_match_icon"
            android:layout_marginEnd="6dp"
            app:tint="@color/p3"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/s1"
            android:id="@+id/status_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mili_setting_off_wist_lock_enter_password"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_below="@+id/title_container">
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <com.xiaomi.hm.health.device.view.PassWordLayout
            android:id="@+id/password"
            android:layout_width="223dp"
            android:layout_height="38dp"
            app:box_input_color="@color/s1"
            app:box_no_input_color="@color/s1"
            app:draw_box_line_size="2dp"
            app:draw_txt_size="48sp"
            app:interval_width="24dp"
            app:is_show_input_line="false"
            app:item_width="70dp"
            app:pass_leng="four"
            app:text_input_color="@color/s1"/>
        <LinearLayout
            android:layout_width="@dimen/size_0.5dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/toggle_clear_img"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:src="@drawable/ic_hide_20"
                android:onClick="onClick"
                android:alpha="0.4"
                android:layout_marginStart="12dp"
                app:tint="@color/s3"/>
        </LinearLayout>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/input_layout_gt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:overScrollMode="never"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/input_layout_cinco"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="210dp"
        android:layout_alignParentBottom="true">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="70dp">
            <TextView
                android:textSize="30sp"
                android:textColor="@color/s2"
                android:gravity="center"
                android:id="@+id/password_key_1"
                android:background="@color/s36"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/mili_setting_off_wist_lock_password_key_1"
                android:layout_weight="1"
                android:onClick="onClick"/>
            <View
                android:background="@color/trans"
                android:layout_width="1dp"
                android:layout_height="match_parent"/>
            <TextView
                android:textSize="30sp"
                android:textColor="@color/s2"
                android:gravity="center"
                android:id="@+id/password_key_2"
                android:background="@color/s36"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/mili_setting_off_wist_lock_password_key_2"
                android:layout_weight="1"
                android:onClick="onClick"/>
        </LinearLayout>
        <View
            android:background="@color/trans"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="70dp">
            <TextView
                android:textSize="30sp"
                android:textColor="@color/s2"
                android:gravity="center"
                android:id="@+id/password_key_3"
                android:background="@color/s36"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/mili_setting_off_wist_lock_password_key_3"
                android:layout_weight="1"
                android:onClick="onClick"/>
            <View
                android:background="@color/trans"
                android:layout_width="1dp"
                android:layout_height="match_parent"/>
            <TextView
                android:textSize="30sp"
                android:textColor="@color/s2"
                android:gravity="center"
                android:id="@+id/password_key_4"
                android:background="@color/s36"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/mili_setting_off_wist_lock_password_key_4"
                android:layout_weight="1"
                android:onClick="onClick"/>
        </LinearLayout>
        <View
            android:background="@color/trans"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <LinearLayout
            android:gravity="end|center_vertical"
            android:background="@color/white100"
            android:layout_width="match_parent"
            android:layout_height="70dp">
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <LinearLayout
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/password_backspace_btn"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/password_del_btn"
                    android:onClick="onClick"
                    app:tint="@color/s2"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
