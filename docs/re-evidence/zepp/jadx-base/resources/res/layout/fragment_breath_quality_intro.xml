<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/sleep_main_bg"
        android:paddingLeft="@dimen/slp_size_15dp"
        android:paddingRight="@dimen/slp_size_15dp"
        android:paddingBottom="@dimen/slp_size_15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/slp_size_15dp"
        android:layout_marginTop="@dimen/slp_size_15dp"
        android:layout_marginRight="@dimen/slp_size_15dp">
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="@dimen/slp_size_18sp"
            android:textStyle="bold"
            android:textColor="@color/s1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/slp_size_15dp"
            android:text="@string/sleep_breath_relationship"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="@dimen/slp_size_14sp"
            android:textColor="@color/s2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/sleep_breath_relationship_text2"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/sleep_main_bg"
        android:paddingLeft="@dimen/slp_size_15dp"
        android:paddingRight="@dimen/slp_size_15dp"
        android:paddingBottom="@dimen/slp_size_15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/slp_size_15dp"
        android:layout_marginTop="@dimen/slp_size_15dp"
        android:layout_marginRight="@dimen/slp_size_15dp">
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="@dimen/slp_size_18sp"
            android:textStyle="bold"
            android:textColor="@color/s1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/slp_size_15dp"
            android:text="@string/how_to_get_sleep_breath_score_title"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="@dimen/slp_size_14sp"
            android:textColor="@color/s2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/how_to_get_sleep_breath_score_desc"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/sleep_main_bg"
        android:paddingLeft="@dimen/slp_size_15dp"
        android:paddingRight="@dimen/slp_size_15dp"
        android:paddingBottom="@dimen/slp_size_15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/slp_size_15dp"
        android:layout_marginTop="@dimen/slp_size_15dp"
        android:layout_marginRight="@dimen/slp_size_15dp">
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="@dimen/slp_size_18sp"
            android:textStyle="bold"
            android:textColor="@color/s1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/slp_size_15dp"
            android:text="@string/how_increase_sleep_breath_quality"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/funcListView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/s2"
        android:id="@+id/sleep_reference_documents"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:text="@string/sleep_reference_documents"
        android:layout_marginStart="30dp"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/s2"
        android:layout_gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="@string/sleep_breath_references"
        android:lineSpacingExtra="10dp"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="@dimen/slp_size_12sp"
        android:textColor="@color/s3"
        android:paddingLeft="30dp"
        android:paddingRight="30dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/slp_size_15dp"
        android:text="@string/sleep_breath_beta_tip"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/s15"
        android:layout_gravity="center"
        android:id="@+id/feed_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="30dp"
        android:text="@string/sleep_feedback_to_us"/>
</LinearLayout>
