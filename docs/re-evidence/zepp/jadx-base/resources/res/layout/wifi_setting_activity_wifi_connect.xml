<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="17sp"
        android:textColor="@color/s1"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_centerHorizontal="true"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14sp"
        android:textColor="@color/s2"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/wifi_set_tip"
        android:layout_below="@+id/tv_title"
        android:layout_centerHorizontal="true"/>
    <com.huami.core.device.wifi_settings.ui.view.ProgressView
        android:id="@+id/progress_load"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_marginTop="84dp"
        android:src="@mipmap/wifi_setting_icon_wifi_connect"
        android:layout_below="@+id/tv_tip"
        android:layout_centerHorizontal="true"
        app:progressColor="@color/wifi_progress_color"
        app:strokeWidth="2dp"
        app:style="cycleLoading"/>
    <com.huami.core.device.wifi_settings.ui.view.ProgressView
        android:id="@+id/progress_end"
        android:visibility="gone"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_marginTop="84dp"
        android:src="@mipmap/wifi_setting_icon_wifi_con_failed"
        android:max="100"
        android:progress="100"
        android:layout_below="@+id/tv_tip"
        android:layout_centerHorizontal="true"
        app:progressColor="@color/wifi_progress_color"
        app:strokeWidth="2dp"
        app:style="cycle"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="15sp"
        android:textColor="@color/color_white"
        android:gravity="center"
        android:id="@+id/tv_bottom"
        android:background="@drawable/wifi_connect_slt"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="66dp"
        android:text="@string/wifi_connect_success"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14sp"
        android:textColor="@color/s2"
        android:id="@+id/tv_help"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:text="@string/wifi_help"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
