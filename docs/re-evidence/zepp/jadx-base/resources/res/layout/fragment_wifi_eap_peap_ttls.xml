<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/bg_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:background="@drawable/divider_settings_item"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/step_two_verify"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/dark_grey_text"
            android:duplicateParentState="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/eap_step_two_verify"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@drawable/color_text_may_disable"
            android:gravity="end"
            android:id="@+id/step2_verify_result"
            android:duplicateParentState="true"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/none"
            android:layout_weight="1"
            android:layout_marginEnd="24dp"/>
        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_list_item_right_arrow"/>
    </LinearLayout>
    <View
        android:background="@drawable/divider_settings_item"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/dark_grey_text"
            android:duplicateParentState="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ca_certificate"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@drawable/color_text_may_disable"
            android:gravity="end"
            android:duplicateParentState="true"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/unspecified"
            android:layout_weight="1"
            android:layout_marginEnd="24dp"/>
        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_list_item_right_arrow"/>
    </LinearLayout>
    <include layout="@layout/split_line_width_match_parent"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="9dp"/>
    <include layout="@layout/split_line_width_match_parent"/>
    <LinearLayout
        android:orientation="horizontal"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="53dp">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/dark_grey_text"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/id"
            android:layout_marginStart="24dp"/>
        <EditText
            android:textSize="14sp"
            android:textColor="@color/black_text"
            android:textColorHint="@color/grey_text"
            android:gravity="start|center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/id_edit_box"
            android:background="@color/white"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:hint="@string/wifi_input_id"
            android:maxLines="1"
            android:layout_weight="1"
            android:textCursorDrawable="@drawable/cursor_edit_box"
            android:layout_marginStart="34dp"/>
    </LinearLayout>
    <View
        android:background="@drawable/divider_settings_item"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <LinearLayout
        android:orientation="horizontal"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="53dp">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/dark_grey_text"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/anonymous_id"
            android:layout_marginStart="24dp"/>
        <EditText
            android:textSize="14sp"
            android:textColor="@color/black_text"
            android:textColorHint="@color/grey_text"
            android:gravity="start|center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/anonymous_id_edit_box"
            android:background="@color/white"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:hint="@string/wifi_input_anonymousid"
            android:maxLines="1"
            android:layout_weight="1"
            android:textCursorDrawable="@drawable/cursor_edit_box"
            android:layout_marginStart="34dp"/>
    </LinearLayout>
    <View
        android:background="@drawable/divider_settings_item"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <LinearLayout
        android:orientation="horizontal"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="53dp">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/dark_grey_text"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/password"
            android:layout_marginStart="24dp"/>
        <EditText
            android:textSize="14sp"
            android:textColor="@color/black_text"
            android:textColorHint="@color/grey_text"
            android:gravity="start|center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/pwd_edit_box"
            android:background="@color/white"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:hint="@string/wifi_password_edit_hint"
            android:maxLines="1"
            android:layout_weight="1"
            android:inputType="textPassword"
            android:textCursorDrawable="@drawable/cursor_edit_box"
            android:layout_marginStart="34dp"/>
    </LinearLayout>
</LinearLayout>
