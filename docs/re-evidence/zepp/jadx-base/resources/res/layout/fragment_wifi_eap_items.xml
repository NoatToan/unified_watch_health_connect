<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:background="@drawable/divider_settings_item"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/eap_type"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/dark_grey_text"
            android:duplicateParentState="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/eap_type"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@drawable/color_text_may_disable"
            android:gravity="end"
            android:id="@+id/eap_type_result"
            android:duplicateParentState="true"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="24dp"/>
        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_list_item_right_arrow"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/eap_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
