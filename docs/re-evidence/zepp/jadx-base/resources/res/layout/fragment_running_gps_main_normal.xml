<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:sdv="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/map_container"
        android:layout_width="match_parent"
        android:layout_height="400dp"/>
    <FrameLayout
        android:id="@+id/data_container"
        android:background="@drawable/bg_running_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/data_display_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="80dp">
            <com.huami.moving.ui.view.SportingDataView
                android:id="@+id/sport_data_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                sdv:dataText="0.00"
                sdv:dataTextSize="96.7sp"
                sdv:descText="@string/running_distance_desc"
                sdv:tipsText="@string/running_ble_off"/>
            <Space
                android:id="@+id/data_margin"
                android:layout_width="0dp"
                android:layout_height="30dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.huami.moving.ui.view.SportingDataView
                    android:id="@+id/sport_data_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    sdv:dataText="00:00:00"
                    sdv:dataTextSize="26.7sp"
                    sdv:descText="@string/sporting_duration"/>
                <com.huami.moving.ui.view.SportingDataView
                    android:id="@+id/sport_data_3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    sdv:dataText="00&apos;00&apos;&apos;"
                    sdv:dataTextSize="26.7sp"
                    sdv:descText="@string/running_pace"/>
                <com.huami.moving.ui.view.SportingDataView
                    android:id="@+id/sport_data_4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    sdv:dataText="--"
                    sdv:dataTextSize="26.7sp"
                    sdv:descText="@string/running_hr"
                    sdv:tipsText="@string/running_pace"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/choose_data_item_tips_layout"
            android:background="@drawable/bg_choose_data_item_tips"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="80dp">
            <TextView
                android:textSize="13.3sp"
                android:textColor="@color/white"
                android:gravity="center_horizontal"
                android:id="@+id/tv_choose_data_item_tips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/choose_data_item_tip"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/choose_data_item_tips_close"
                android:padding="2dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/choose_data_tip_close"
                android:layout_marginStart="12dp"/>
        </LinearLayout>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/title_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.huami.moving.ui.view.GpsSignalView
            android:textColor="@color/white"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/gps_signal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="200dp"
            android:singleLine="true"/>
        <ImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/iv_btn_map"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/btn_running_map"
            android:layout_marginEnd="16dp"/>
        <ImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/btn_close_map"
            android:visibility="gone"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/btn_running_close_map"
            android:layout_marginEnd="16dp"/>
    </FrameLayout>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/btn_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:minHeight="115dp">
        <ImageButton
            android:layout_gravity="start|center_vertical"
            android:id="@+id/btn_settings"
            android:background="@drawable/btn_bg_oval_white"
            android:layout_width="53dp"
            android:layout_height="53dp"
            android:src="@drawable/ic_running_settings"
            android:layout_marginStart="41dp"/>
        <ImageButton
            android:layout_gravity="end|center_vertical"
            android:id="@+id/btn_lock"
            android:background="@drawable/btn_bg_oval_white"
            android:layout_width="53dp"
            android:layout_height="53dp"
            android:src="@drawable/ic_running_lock"
            android:layout_marginEnd="41dp"/>
        <com.huami.moving.ui.view.progresslayout.CustomRoundProgressBar
            android:layout_gravity="end|center_vertical"
            android:id="@+id/btn_done"
            android:background="@drawable/btn_bg_running_done"
            android:visibility="invisible"
            android:layout_width="99dp"
            android:layout_height="99dp"
            android:layout_marginEnd="59dp"
            sdv:RoundProgressBarProgressBgColor="#4cffffff"
            sdv:RoundProgressBarProgressBgWidth="2dp"
            sdv:RoundProgressBarProgressColor="@color/white"
            sdv:RoundProgressBarProgressWidth="2dp"
            sdv:RoundProgressBarTotal="1000"/>
        <ImageView
            android:layout_gravity="start|center_vertical"
            android:id="@+id/btn_resume"
            android:visibility="gone"
            android:layout_width="87dp"
            android:layout_height="87dp"
            android:src="@drawable/ic_running_resume"
            android:layout_marginStart="65dp"/>
        <ImageButton
            android:layout_gravity="center"
            android:id="@+id/btn_pause"
            android:background="@drawable/btn_bg_running_pause_zepp"
            android:layout_width="115dp"
            android:layout_height="115dp"
            android:src="@drawable/ic_running_pause"/>
        <com.huami.moving.ui.view.progresslayout.CustomRoundProgressBar
            android:layout_gravity="center"
            android:id="@+id/btn_unlock"
            android:background="@drawable/btn_bg_running_unlock"
            android:visibility="invisible"
            android:layout_width="99dp"
            android:layout_height="99dp"
            sdv:RoundProgressBarProgressBgColor="#4cffffff"
            sdv:RoundProgressBarProgressBgWidth="2dp"
            sdv:RoundProgressBarProgressColor="@color/white"
            sdv:RoundProgressBarProgressWidth="2dp"
            sdv:RoundProgressBarTotal="1000"/>
    </FrameLayout>
    <TextView
        android:textSize="13.3sp"
        android:textColor="@color/white"
        android:gravity="center_horizontal"
        android:layout_gravity="end|bottom"
        android:id="@+id/tv_done_tips"
        android:background="@drawable/bg_sporting_tips"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sporting_finish_tips"/>
    <TextView
        android:textSize="13.3sp"
        android:textColor="@color/white"
        android:gravity="center_horizontal"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/tv_unlock_tips"
        android:background="@drawable/bg_sporting_tips"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:text="@string/sporting_unlock_tips"/>
</FrameLayout>
