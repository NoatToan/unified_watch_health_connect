<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/center_iv"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"/>
    <com.xiaomi.hm.health.baseui.GifMovieView
        android:layout_gravity="center_horizontal"
        android:id="@+id/gif_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <RelativeLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/video_container_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.huami.view.videoview.FrameVideoView
            android:layout_gravity="center_horizontal"
            android:id="@+id/video_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/count_down_view"
            android:background="@drawable/video_countdown_bg_round"
            android:layout_width="48dp"
            android:layout_height="28dp"
            android:layout_marginTop="40dp"
            android:layout_alignParentTop="true"
            android:layout_marginEnd="12dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</merge>
