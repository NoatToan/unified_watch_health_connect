<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s38"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include layout="@layout/calendar_title_week"/>
        <View
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="0.33dp"
            android:layout_marginBottom="8dp"/>
        <FrameLayout
            android:id="@+id/fl_expandable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_month"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.xiaomi.hm.health.calendar.CalendarRecyclerView
                    android:id="@+id/crv_calendar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:overScrollMode="never"/>
                <View
                    android:background="@color/black20"
                    android:layout_width="match_parent"
                    android:layout_height="0.33dp"
                    android:layout_marginTop="17dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/ll_training_remind"
                    android:paddingTop="17dp"
                    android:paddingBottom="17dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp">
                    <TextView
                        android:textSize="15sp"
                        android:textColor="@color/s1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/training_reminder"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/s2"
                        android:gravity="end|center_vertical"
                        android:id="@+id/tx_reminder_time"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:drawablePadding="6dp"
                        android:layout_weight="1"
                        android:drawableEnd="@drawable/ic_arrow_forward_20"/>
                </LinearLayout>
            </LinearLayout>
            <com.xiaomi.hm.health.calendar.CalendarWeekViewpager
                android:id="@+id/cwv_week"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </FrameLayout>
        <ImageView
            android:id="@+id/imv_dragger"
            android:padding="3dp"
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:src="@drawable/cl_expand"
            android:tint="@color/dager_tint_gray"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
