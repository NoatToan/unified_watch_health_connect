<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s45"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="@color/s46"
        android:gravity="center"
        android:id="@+id/title"
        android:padding="@dimen/size_20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/sky_setting_play_time"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Rainbow.TextAppearance.Title2"/>
    <com.huami.widget.wheelview.WheelView
        android:id="@+id/wheelView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/bottom"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <LinearLayout
        android:id="@+id/bottom"
        android:background="@color/sky_pick_dialog_bottom_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">
        <TextView
            android:textColor="@color/s46"
            android:gravity="center"
            android:id="@+id/cancel_button"
            android:padding="15dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/sky_question_cancel"
            android:layout_weight="1"
            style="@style/Rainbow.TextAppearance.Body3"/>
        <TextView
            android:textColor="@color/s46"
            android:gravity="center"
            android:id="@+id/done_button"
            android:padding="15dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/sky_music_preference_save"
            android:layout_weight="1"
            style="@style/Rainbow.TextAppearance.Body3"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
