<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.watch.companion.ui.view.ActionbarLayout
        android:id="@+id/actionbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/device_preview_img"
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:layout_marginTop="@dimen/size_15dp"
        android:src="@drawable/device_xihu_watch_square"
        app:layout_constraintBottom_toTopOf="@+id/error_tips_tv"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/actionbar"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/iv_skin"
        android:layout_width="120dp"
        android:layout_height="120dp"
        app:layout_constraintBottom_toBottomOf="@+id/device_preview_img"
        app:layout_constraintLeft_toLeftOf="@+id/device_preview_img"
        app:layout_constraintRight_toRightOf="@+id/device_preview_img"
        app:layout_constraintTop_toTopOf="@+id/device_preview_img"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/iv_skin_transparent"
        android:layout_width="120dp"
        android:layout_height="120dp"
        app:layout_constraintBottom_toBottomOf="@+id/device_preview_img"
        app:layout_constraintLeft_toLeftOf="@+id/device_preview_img"
        app:layout_constraintRight_toRightOf="@+id/device_preview_img"
        app:layout_constraintTop_toTopOf="@+id/device_preview_img"/>
    <TextView
        android:textSize="@dimen/size_14sp"
        android:textColor="@color/black60"
        android:id="@+id/error_tips_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_change_skin"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/device_preview_img"/>
    <TextView
        android:textColor="#ffff5353"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_change_skin"
        android:background="@drawable/bg_btn_change_watch_face"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="31dp"
        android:text="@string/watch_skin_diy_change_background"
        android:layout_marginStart="@dimen/size_20dp"
        android:layout_marginEnd="@dimen/size_20dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/error_tips_tv"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view"
        android:paddingTop="30dp"
        android:paddingBottom="30dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/size_20dp"
        android:paddingEnd="@dimen/size_20dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_change_skin"/>
    <View
        android:background="#f6f7f8"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/recycler_view"/>
    <com.huami.watch.companion.watchface.view.WatchSkinProgressView
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/sync_apply_btn"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="18dp"
        android:text="@string/sync_watch_skin"
        android:layout_marginStart="@dimen/size_20dp"
        android:layout_marginEnd="@dimen/size_20dp"
        app:dialogMode="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
