<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/menu_content"
    android:background="@color/s39"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="end"
        android:id="@+id/menu_dismiss"
        android:layout_width="@dimen/relatives_size_24dp"
        android:layout_height="@dimen/relatives_size_24dp"
        android:layout_marginTop="@dimen/relatives_size_10dp"
        android:src="@drawable/ic_close_20_2x"
        android:tint="@color/s1"
        android:contentDescription="@string/relatives_app_name"
        android:layout_marginEnd="@dimen/relatives_size_15dp"/>
    <TextView
        android:textSize="@dimen/relatives_main_menu_item_text_size"
        android:textColor="@color/s1"
        android:gravity="center_vertical"
        android:id="@+id/action_add_friend"
        android:background="@drawable/relatives_menu_item_selector"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="@dimen/relatives_size_50dp"
        android:text="@string/relatives_label_scan_add"
        android:paddingStart="@dimen/relatives_size_16dp"
        android:paddingEnd="@dimen/relatives_size_16dp"/>
    <TextView
        android:textSize="@dimen/relatives_main_menu_item_text_size"
        android:textColor="@color/s1"
        android:gravity="center_vertical"
        android:id="@+id/action_my_qrcode"
        android:background="@drawable/relatives_menu_item_selector"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="@dimen/relatives_size_50dp"
        android:text="@string/relatives_label_my_qrcode"
        android:paddingStart="@dimen/relatives_size_16dp"
        android:paddingEnd="@dimen/relatives_size_16dp"/>
    <TextView
        android:textSize="@dimen/relatives_main_menu_item_text_size"
        android:textColor="@color/s1"
        android:gravity="center_vertical"
        android:id="@+id/action_add_friend_by_id"
        android:background="@drawable/relatives_menu_item_selector"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="@dimen/relatives_size_50dp"
        android:text="@string/relatives_label_search_add"
        android:paddingStart="@dimen/relatives_size_16dp"
        android:paddingEnd="@dimen/relatives_size_16dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/friend_share_invite_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/relatives_main_menu_item_text_size"
            android:textColor="@color/s1"
            android:gravity="center_vertical"
            android:id="@+id/action_share_friend_invite"
            android:background="@drawable/relatives_menu_item_selector"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="@dimen/relatives_size_50dp"
            android:text="@string/relatives_label_share_friend_invite"
            android:paddingStart="@dimen/relatives_size_16dp"
            android:paddingEnd="@dimen/relatives_size_16dp"/>
    </LinearLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/relatives_main_menu_item_text_size"
            android:textColor="@color/s1"
            android:gravity="center_vertical"
            android:id="@+id/message_button"
            android:background="@drawable/relatives_menu_item_selector"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="@dimen/relatives_size_50dp"
            android:text="@string/relatives_label_message"
            android:paddingStart="@dimen/relatives_size_16dp"
            android:paddingEnd="@dimen/relatives_size_16dp"/>
        <ImageView
            android:id="@+id/new_flag"
            android:visibility="gone"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/relatives_new_banner_icon"/>
    </RelativeLayout>
</LinearLayout>
