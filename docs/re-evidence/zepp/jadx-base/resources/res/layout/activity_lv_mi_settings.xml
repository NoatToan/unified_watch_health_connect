<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.watch.companion.ui.view.ActionbarLayout
        android:id="@+id/actionbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="262dp"
        android:src="@drawable/setting_lvmi_bg_warn"/>
    <RelativeLayout
        android:id="@+id/layout_switch"
        android:background="@color/white"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">
        <TextView
            android:textSize="14sp"
            android:textColor="#e6000000"
            android:gravity="start"
            android:id="@+id/tv_warn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/lvmi_warn_notice"
            android:lineSpacingExtra="2dp"
            android:layout_marginEnd="2dp"
            android:layout_toStartOf="@+id/enable_lvmi_notice"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#80000000"
            android:gravity="start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/lvmi_warn_notice_detail"
            android:layout_below="@+id/tv_warn"
            android:lineSpacingExtra="2dp"
            android:layout_marginEnd="2dp"
            android:layout_toStartOf="@+id/enable_lvmi_notice"/>
        <Switch
            android:id="@+id/enable_lvmi_notice"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:textOn=""
            android:textOff=""
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            style="@style/WatchSwitch"/>
    </RelativeLayout>
    <View
        android:background="#14000000"
        android:layout_width="match_parent"
        android:layout_height="0.7dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
    <com.huami.watch.companion.ui.view.SettingItemView
        android:id="@+id/setting_type"
        android:background="@color/white"
        android:paddingStart="-20dp"
        app:show_divider="false"
        app:title="@string/lvmi_support_type"
        style="@style/SettingItemStyle"/>
</LinearLayout>
