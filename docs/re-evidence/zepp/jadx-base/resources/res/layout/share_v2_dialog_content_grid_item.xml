<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="@dimen/share_v2_dialog_padding"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/share_icon"
        android:layout_width="@dimen/share_v2_dialog_icon_size"
        android:layout_height="@dimen/share_v2_dialog_icon_size"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="11sp"
        android:textColor="@color/s2"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/share_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="lt"/>
</LinearLayout>
