<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.watch.companion.ui.view.ActionbarLayout
        android:id="@+id/actionbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/grey_text"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/notificatin_setting_watch"
            android:layout_marginStart="20dp"/>
        <View
            android:background="#14000000"
            android:layout_width="match_parent"
            android:layout_height="0.3dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"/>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:id="@+id/notification_enable_setting"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/black90"
                android:layout_gravity="center"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/noti_switch_text"
                android:layout_weight="1"/>
            <Switch
                android:id="@+id/enable_notification"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:textOn=""
                android:textOff=""
                style="@style/WatchSwitch"/>
        </LinearLayout>
        <View
            android:background="#14000000"
            android:layout_width="match_parent"
            android:layout_height="0.3dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/noti_app_blacklist_view"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">
                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:src="@drawable/notice_setting_icon_blacklist"/>
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/black90"
                    android:duplicateParentState="true"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/noti_app_blacklist_setting"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"/>
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_list_item_right_arrow"/>
            </LinearLayout>
            <View
                android:id="@+id/noti_app_blacklist_mask_view"
                android:background="#77f7f7f7"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="64dp"/>
        </FrameLayout>
        <View
            android:background="#14000000"
            android:layout_width="match_parent"
            android:layout_height="0.3dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/noti_wechat_setting_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/noti_wechat_friend_msg_view"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">
                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:src="@drawable/notice_setting_icon_weixin"/>
                    <TextView
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/black90"
                        android:duplicateParentState="true"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/noti_wechat_friends_msg_setting"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/grey_text"
                        android:visibility="gone"
                        android:duplicateParentState="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="3dp"/>
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_list_item_right_arrow"/>
                </LinearLayout>
                <View
                    android:id="@+id/noti_wechat_friend_msg_mask_view"
                    android:background="#77f7f7f7"
                    android:visibility="gone"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"/>
            </FrameLayout>
            <View
                android:background="@drawable/divider_width_match_parent"
                android:layout_width="match_parent"
                android:layout_height="1px"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@+id/layout_screen_on_ignore"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">
            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/notice_setting_icon_phone"
                android:layout_marginEnd="12dp"/>
            <LinearLayout
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/black90"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/noti_screen_on_ignore"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/grey_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/noti_screen_on_ignore_tip"/>
            </LinearLayout>
            <Switch
                android:id="@+id/enable_screen_on_ignore"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:textOn=""
                android:textOff=""
                style="@style/WatchSwitch"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/layout_music_controller"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:background="#14000000"
                android:layout_width="match_parent"
                android:layout_height="0.3dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">
                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:src="@drawable/notification_setting_music_controller"
                    android:layout_marginEnd="12dp"/>
                <LinearLayout
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/black90"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/notification_music_controller"/>
                </LinearLayout>
                <Switch
                    android:id="@+id/enable_music_controller"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:textOn=""
                    android:textOff=""
                    style="@style/WatchSwitch"/>
            </LinearLayout>
        </LinearLayout>
        <View
            android:background="@drawable/divider_width_match_parent"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <View
            android:background="@color/bg_main"
            android:layout_width="match_parent"
            android:layout_height="8.7dp"/>
        <View
            android:background="@drawable/divider_width_match_parent"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/grey_text"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/notification_setting_phone_app"
            android:layout_marginStart="20dp"/>
        <View
            android:background="#14000000"
            android:layout_width="match_parent"
            android:layout_height="0.3dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"/>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:id="@+id/notification_setting_sport_sync"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">
            <ImageView
                android:layout_gravity="center_vertical"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/notice_setting_icon_new_sport"/>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/black90"
                android:layout_gravity="center"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/sport_sync_success_notification"
                android:layout_weight="1"
                android:layout_marginStart="12dp"/>
            <Switch
                android:id="@+id/switch_setting_sport_sync"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:textOn=""
                android:textOff=""
                style="@style/WatchSwitch"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
