<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:c="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/s14"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.lib.rainbow.titlebar.RainbowTitleBar
        android:id="@+id/tv_title_bar"
        android:background="@color/s14"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        c:navigationIcon="@drawable/ic_arrow_back_20_2x"
        c:title="@string/action_mark"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_top_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tv_title_bar">
        <View
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider"/>
        <ImageView
            android:id="@+id/imv_action_image"
            android:layout_width="match_parent"
            android:layout_height="176dp"
            android:layout_marginTop="55dp"
            android:src="@drawable/ic_badminton_big"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="15sp"
            android:textColor="@color/s5"
            android:gravity="center_horizontal"
            android:id="@+id/lab_tagging_temperature_select"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"/>
        <RelativeLayout
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="83.3dp"
            android:layout_marginTop="6dp">
            <com.xiaomi.hm.health.lab.view.TypefaceChronometer
                android:textSize="70sp"
                android:textColor="@color/s5"
                android:id="@+id/chronometer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:layout_centerInParent="true"
                android:lineSpacingExtra="0dp"
                android:lineSpacingMultiplier="1"
                android:fontFamily="din-med"/>
            <ImageView
                android:id="@+id/imv_device_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:src="@drawable/icon_marking_band"
                android:layout_alignBottom="@+id/chronometer"
                android:layout_marginStart="3.3dp"
                android:layout_toEndOf="@+id/chronometer"/>
        </RelativeLayout>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/s5"
            android:gravity="center_horizontal"
            android:id="@+id/lab_tagging_temperature_msg"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/lab_temperature_five_minutes"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"/>
    </LinearLayout>
    <com.xiaomi.hm.health.lab.view.RevealFrameLayout
        android:id="@+id/rfl_chart_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <CheckBox
        android:gravity="center"
        android:id="@+id/cb_title_right"
        android:background="@null"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/common_title_height"
        android:layout_marginTop="30dp"
        android:button="@drawable/checked_wave"
        android:layout_alignParentTop="true"
        android:layout_marginEnd="10dp"
        android:layout_alignParentEnd="true"/>
    <RelativeLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="195dp"
        android:layout_below="@+id/ll_top_container"
        android:layout_centerVertical="true">
        <TextView
            android:textSize="10.7sp"
            android:textColor="@color/s5"
            android:id="@+id/tx_device_connect_status"
            android:background="@drawable/bg_text_tip"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/device_connect_failed"
            android:layout_centerHorizontal="true"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_below="@+id/tx_device_connect_status">
            <FrameLayout
                android:id="@+id/fl_pause_view"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_centerInParent="true">
                <com.xiaomi.hm.health.lab.view.CustomRoundProgressBar
                    android:id="@+id/btn_pause_mark"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    c:RoundProgressBarCenterDrawable="@drawable/ic_sport_pause_44"
                    c:RoundProgressBarProgressBgColor="@color/white_20_percent"
                    c:RoundProgressBarProgressBgWidth="2.7dp"
                    c:RoundProgressBarProgressColor="@color/white_100_percent"
                    c:RoundProgressBarProgressWidth="2.7dp"
                    c:RoundProgressBarTotal="100"/>
                <View
                    android:background="@drawable/tagging_button_alpha_bg"
                    android:layout_width="105dp"
                    android:layout_height="105dp"
                    android:layout_margin="2.5dp"/>
            </FrameLayout>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/s5"
                android:id="@+id/long_press_tip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="@string/tagging_pause"
                android:layout_below="@+id/fl_pause_view"
                android:layout_centerHorizontal="true"/>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/btn_finish_mark"
                    android:background="@drawable/tagging_button_alpha_bg"
                    android:visibility="gone"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/finish_button_img"
                    android:scaleType="centerInside"
                    android:layout_centerInParent="true"
                    style="?android:attr/borderlessButtonStyle"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/btn_resume_mark"
                    android:background="@drawable/tagging_button_alpha_bg"
                    android:visibility="gone"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/continue_button_img"
                    android:scaleType="centerInside"
                    android:layout_centerInParent="true"
                    style="?android:attr/borderlessButtonStyle"/>
            </RelativeLayout>
        </RelativeLayout>
    </RelativeLayout>
    <com.xiaomi.hm.health.lab.view.RevealFrameLayout
        android:id="@+id/fl_countdown_container"
        android:background="@color/s10"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</RelativeLayout>
