<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/sky_guide_page_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:background="@drawable/sky_shape_radius_6_black70"
        android:paddingBottom="@dimen/size_20dp"
        android:layout_width="match_parent"
        android:layout_height="@dimen/sky_guide_card_height"
        android:layout_marginStart="@dimen/size_guide_view_horizon_margin"
        android:layout_marginEnd="@dimen/size_guide_view_horizon_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/sky_guide_viewpager"
            android:layout_width="match_parent"
            android:layout_height="@dimen/sky_guide_content_height"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.huami.sky.ui.view.SkyCirclePageIndicator
            android:id="@+id/page_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:gap="@dimen/size_10dp"
            app:indexColor="@color/s46"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:radius="@dimen/size_page_indicator_radius"
            app:roundRectRadius="@dimen/size_page_indicator_radius"
            app:unIndexColor="#4bb2b2b2"/>
        <ImageButton
            android:id="@+id/btn_close"
            android:background="@null"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_18dp"
            android:src="@drawable/ic_close_16_s46"
            android:layout_marginEnd="@dimen/size_18dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
