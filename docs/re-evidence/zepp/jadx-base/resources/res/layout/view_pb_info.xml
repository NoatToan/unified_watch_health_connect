<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:id="@+id/view_pb_confirmed"
        android:background="@drawable/bg_pb_confirmed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/view_current_pb"
            android:layout_width="match_parent"
            android:layout_height="68dp">
            <ImageView
                android:id="@+id/iv_pb_bg"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginLeft="@dimen/size_15dp"
                android:src="@drawable/bg_pb_max_time"
                android:layout_centerVertical="true"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/size_10dp"
                android:layout_toLeftOf="@+id/tv_pb_time"
                android:layout_toRightOf="@+id/iv_pb_bg"
                android:layout_centerVertical="true">
                <TextView
                    android:textStyle="bold"
                    android:textColor="@color/s2"
                    android:ellipsize="end"
                    android:id="@+id/tv_pb_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:maxLines="2"
                    style="@style/Rainbow.TextAppearance.Body4"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_below="@+id/tv_pb_title">
                    <com.huami.watch.companion.ui.view.HuaMiFontTextView
                        android:textColor="@color/s1"
                        android:id="@+id/tv_pb_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/empty_value"
                        style="@style/Rainbow.TextAppearance.Body1"/>
                    <TextView
                        android:textColor="@color/s2"
                        android:id="@+id/tv_pb_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        style="@style/Rainbow.TextAppearance.Body5"/>
                </LinearLayout>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <ImageView
                android:id="@+id/iv_pb_arrow"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/size_16dp"
                android:src="@drawable/ic_arrow_forward_20_2x"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                app:tint="@color/s1"/>
            <TextView
                android:textColor="@color/s2"
                android:id="@+id/tv_pb_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/size_10dp"
                android:layout_toLeftOf="@+id/iv_pb_arrow"
                android:layout_centerVertical="true"
                style="@style/Rainbow.TextAppearance.Body4"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/view_last_pb"
            android:background="@drawable/bg_pb_confirmed"
            android:layout_width="match_parent"
            android:layout_height="48dp">
            <View
                android:background="@color/s4"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginLeft="55dp"/>
            <TextView
                android:textStyle="bold"
                android:textColor="@color/s2"
                android:id="@+id/tv_last_pb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="55dp"
                android:text="@string/last_pb"
                android:layout_centerVertical="true"
                style="@style/Rainbow.TextAppearance.Body4"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="10dp"
                android:layout_toEndOf="@+id/tv_last_pb">
                <com.huami.watch.companion.ui.view.HuaMiFontTextView
                    android:textColor="@color/s2"
                    android:id="@+id/tv_last_pb_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Rainbow.TextAppearance.Body4"/>
                <TextView
                    android:textColor="@color/s2"
                    android:id="@+id/tv_last_pb_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    style="@style/Rainbow.TextAppearance.Body4"/>
            </LinearLayout>
            <TextView
                android:textColor="@color/s3"
                android:id="@+id/tv_last_pb_time"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                style="@style/Rainbow.TextAppearance.Body4"/>
        </RelativeLayout>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:id="@+id/view_pb_unconfirmed"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/view_unconfirmed_pb"
            android:background="@drawable/bg_pb_confirmed"
            android:layout_width="match_parent"
            android:layout_height="68dp">
            <ImageView
                android:id="@+id/iv_pb_bg_unconfirmed"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginLeft="@dimen/size_15dp"
                android:src="@drawable/bg_pb_max_time"
                android:layout_centerVertical="true"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/size_10dp"
                android:layout_toLeftOf="@+id/tv_unconfirmed_pb_time"
                android:layout_toRightOf="@+id/iv_pb_bg_unconfirmed"
                android:layout_centerVertical="true">
                <TextView
                    android:textStyle="bold"
                    android:textColor="@color/s2"
                    android:ellipsize="end"
                    android:id="@+id/tv_unconfirmed_pb_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:maxLines="2"
                    style="@style/Rainbow.TextAppearance.Body4"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_below="@+id/tv_pb_title">
                    <com.huami.watch.companion.ui.view.HuaMiFontTextView
                        android:textColor="@color/s1"
                        android:id="@+id/tv_unconfirmed_pb_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/empty_value"
                        style="@style/Rainbow.TextAppearance.Body1"/>
                    <TextView
                        android:textColor="@color/s2"
                        android:id="@+id/tv_unconfirmed_pb_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        style="@style/Rainbow.TextAppearance.Body5"/>
                </LinearLayout>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <ImageView
                android:id="@+id/iv_pb_arrow_unconfirmed"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/size_16dp"
                android:src="@drawable/default_end_arrow"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
            <TextView
                android:textColor="@color/s2"
                android:id="@+id/tv_unconfirmed_pb_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/size_10dp"
                android:layout_toLeftOf="@+id/iv_pb_arrow_unconfirmed"
                android:layout_centerVertical="true"
                style="@style/Rainbow.TextAppearance.Body4"/>
        </RelativeLayout>
        <RelativeLayout
            android:background="@drawable/bg_pb_confirmed"
            android:layout_width="match_parent"
            android:layout_height="48dp">
            <View
                android:background="@color/s4"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textStyle="bold"
                    android:textColor="@color/s3"
                    android:gravity="center"
                    android:id="@+id/btn_give_up"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/pb_give_up"
                    android:layout_weight="1"
                    style="@style/Rainbow.TextAppearance.Body4"/>
                <View
                    android:background="@color/s4"
                    android:layout_width="0.3dp"
                    android:layout_height="match_parent"/>
                <TextView
                    android:textStyle="bold"
                    android:textColor="@color/s1"
                    android:gravity="center"
                    android:id="@+id/btn_confirmed"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/dialog_confirm"
                    android:layout_weight="1"
                    style="@style/Rainbow.TextAppearance.Body4"/>
            </LinearLayout>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/view_unconfirmed_last_pb"
            android:background="@drawable/bg_pb_confirmed"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="48dp">
            <View
                android:background="@color/s4"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginLeft="55dp"
                android:layout_marginRight="@dimen/size_16dp"/>
            <TextView
                android:textStyle="bold"
                android:textColor="@color/s2"
                android:id="@+id/tv_unconfirmed_last_pb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="55dp"
                android:text="@string/last_pb"
                android:layout_centerVertical="true"
                style="@style/Rainbow.TextAppearance.Body4"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="10dp"
                android:layout_toEndOf="@+id/tv_unconfirmed_last_pb">
                <com.huami.watch.companion.ui.view.HuaMiFontTextView
                    android:textColor="@color/s2"
                    android:id="@+id/tv_unconfirmed_last_pb_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Rainbow.TextAppearance.Body4"/>
                <TextView
                    android:textColor="@color/s2"
                    android:id="@+id/tv_unconfirmed_last_pb_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    style="@style/Rainbow.TextAppearance.Body4"/>
            </LinearLayout>
            <TextView
                android:textColor="@color/s3"
                android:id="@+id/tv_unconfirmed_last_pb_time"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                style="@style/Rainbow.TextAppearance.Body4"/>
        </RelativeLayout>
    </androidx.appcompat.widget.LinearLayoutCompat>
</FrameLayout>
