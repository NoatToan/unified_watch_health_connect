<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:background="@color/s38"
    android:layout_width="match_parent"
    android:layout_height="300dp"
    app:cardBackgroundColor="@color/s38"
    app:cardCornerRadius="10dp"
    app:cardElevation="0dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/s1"
            android:id="@+id/tv_select_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="@string/fh_date_select"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/view_line_h"
            android:background="@color/fh_calendar_select_line_color"
            android:layout_width="match_parent"
            android:layout_height="@dimen/fh_calendar_select_line_size"
            android:layout_marginTop="13dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_select_title"/>
        <com.huami.femalehealth.uilib.widget.calendar.dialog.PickerView
            android:id="@+id/calendar_wheel_year"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/btn_cancel"
            app:layout_constraintEnd_toStartOf="@+id/calendar_wheel_month"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view_line_h"/>
        <com.huami.femalehealth.uilib.widget.calendar.dialog.PickerView
            android:id="@+id/calendar_wheel_month"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/btn_cancel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@+id/calendar_wheel_year"
            app:layout_constraintTop_toBottomOf="@+id/view_line_h"/>
        <TextView
            android:textColor="@color/s1"
            android:gravity="center"
            android:id="@+id/btn_cancel"
            android:background="#ffedeef0"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:text="@string/fh_cancel"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btn_sure"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:textColor="@color/s1"
            android:gravity="center"
            android:id="@+id/btn_sure"
            android:background="#ffedeef0"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:text="@string/fh_sure"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@+id/btn_cancel"/>
        <View
            android:id="@+id/view_line_v"
            android:background="@color/fh_calendar_select_line_color"
            android:layout_width="@dimen/fh_calendar_select_line_size"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view_line_h"/>
        <View
            android:background="#cccccc"
            android:layout_width="@dimen/fh_calendar_select_line_size"
            android:layout_height="50dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
