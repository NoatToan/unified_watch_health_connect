<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/head"
        android:background="@color/s38"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/value_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:paddingStart="@dimen/size_10dp"
            android:paddingEnd="@dimen/size_10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="40sp"
                android:textColor="@color/s1"
                android:id="@+id/value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/value_invalid"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="12sp"
                android:textColor="@color/s2"
                android:id="@+id/time"
                android:paddingBottom="@dimen/size_4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_10dp"
                android:textDirection="locale"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/value"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/dragtime_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:paddingStart="@dimen/size_10dp"
            android:paddingEnd="@dimen/size_10dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/s1"
                android:id="@+id/tag_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/stress_drag_time_title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="18sp"
                android:textColor="@color/s1"
                android:id="@+id/tag_time"
                android:paddingBottom="@dimen/size_4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textDirection="locale"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tag_title"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <FrameLayout
            android:id="@+id/day_chart"
            android:background="@color/s38"
            android:layout_width="match_parent"
            android:layout_height="205dp"
            android:layout_marginTop="@dimen/size_2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/value_container"/>
        <com.xiaomi.hm.health.healthtag.ui.view.SleepTagChart
            android:id="@+id/tagResultLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="40dp"
            app:layout_constraintBottom_toBottomOf="@+id/day_chart"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:stc_drawPadding="15dp"/>
        <com.xiaomi.hm.health.healthtag.ui.view.DragIntervalView
            android:id="@+id/tagDragV"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30dp"
            app:dv_bottom_drawPadding="20dp"
            app:dv_defaultMax="900"
            app:dv_defaultMin="540"
            app:dv_drag_height="140dp"
            app:dv_maxValue="1439"
            app:dv_minValue="0"
            app:dv_right_drawPadding="30dp"
            app:dv_top_drawPadding="20dp"
            app:layout_constraintBottom_toBottomOf="@+id/day_chart"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/shape_rect_corner_white"
        android:padding="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp">
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/s1"
            android:id="@+id/makeTagTv"
            android:background="@drawable/app_make_tag_btn_bg"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/make_tag_text"
            android:paddingStart="@dimen/dp_10"
            android:paddingEnd="@dimen/dp_10"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.google.android.flexbox.FlexboxLayout
            android:id="@+id/legendLL"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:flexWrap="wrap"
            app:justifyContent="flex_start"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/makeTagTv"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="14sp"
                android:textColor="@color/s2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/stress_level_relax"
                android:drawablePadding="4dp"
                android:drawableStart="@drawable/stress_icon_stress_level_relax"
                android:layout_marginEnd="15dp"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="14sp"
                android:textColor="@color/s2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/stress_level_normal"
                android:drawablePadding="4dp"
                android:drawableStart="@drawable/stress_icon_stress_level_normal"
                android:layout_marginEnd="15dp"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="14sp"
                android:textColor="@color/s2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/stress_level_medium"
                android:drawablePadding="4dp"
                android:drawableStart="@drawable/stress_icon_stress_level_medium"
                android:layout_marginEnd="15dp"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="14sp"
                android:textColor="@color/s2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/stress_level_high"
                android:drawablePadding="4dp"
                android:drawableStart="@drawable/stress_icon_stress_level_high"/>
        </com.google.android.flexbox.FlexboxLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tagEditCardLayout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp">
        <com.xiaomi.hm.health.healthtag.ui.view.HealthTagEditCard
            android:id="@+id/tagEditCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <include
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/size_15dp"
        layout="@layout/layout_stress_day"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="12sp"
        android:textColor="@color/s3"
        android:id="@+id/jp_hint_text"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/stress_daily_jp_hint"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="25dp"/>
</LinearLayout>
