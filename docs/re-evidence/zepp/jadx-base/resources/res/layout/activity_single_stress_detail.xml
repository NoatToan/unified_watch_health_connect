<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.lib.rainbow.titlebar.RainbowTitleBar
        android:id="@+id/rainbow_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menuIcon="@drawable/ic_share_20"
        app:menuTint="@color/s1"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/head"
        android:background="@color/s38"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="58sp"
            android:textColor="@color/s5"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/value_tv"
            android:background="@drawable/shape_circle_stress_pie_empty"
            android:layout_width="94dp"
            android:layout_height="94dp"
            android:layout_marginTop="@dimen/size_20dp"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="12sp"
            android:textColor="@color/s2"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/data_source"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_20dp"
            android:layout_marginBottom="25dp"
            android:text="@string/stress_data_source"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/shape_rect_corner_white"
        android:paddingTop="@dimen/size_12dp"
        android:paddingBottom="@dimen/size_12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/size_15dp"
        android:paddingStart="@dimen/size_15dp"
        android:paddingEnd="@dimen/size_15dp">
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="@dimen/size_18sp"
            android:textColor="@color/s1"
            android:id="@+id/data_range_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/stress_data_range"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.huami.widget.colorsbar.ColorsBar
            android:id="@+id/colors_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_15dp"
            app:colors_bar_divider_color="@color/s38"
            app:colors_bar_divider_width="1dp"
            app:colors_bar_height="7dp"
            app:colors_bar_indicator_enable="false"
            app:colors_bar_indicator_radius="6dp"
            app:colors_bar_indicator_stroke_width="2dp"
            app:colors_bar_text_color="@color/s3"
            app:colors_bar_text_margin="0dp"
            app:colors_bar_text_size="14sp"
            app:layout_constraintTop_toBottomOf="@+id/data_range_title"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="14sp"
            android:textColor="@color/s1"
            android:id="@+id/tv_level_relax"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="@string/stress_level_relax"
            android:drawablePadding="6dp"
            android:drawableStart="@drawable/stress_icon_stress_level_relax"
            app:layout_constraintEnd_toStartOf="@+id/tv_level_medium"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/colors_bar"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="14sp"
            android:textColor="@color/s1"
            android:id="@+id/tv_level_medium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="@string/stress_level_medium"
            android:drawablePadding="6dp"
            android:drawableStart="@drawable/stress_icon_stress_level_medium"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_level_relax"
            app:layout_constraintTop_toBottomOf="@+id/colors_bar"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="14sp"
            android:textColor="@color/s1"
            android:id="@+id/tv_level_normal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/stress_level_normal"
            android:drawablePadding="6dp"
            android:drawableStart="@drawable/stress_icon_stress_level_normal"
            app:layout_constraintEnd_toStartOf="@+id/tv_stress_level_high"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_level_relax"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="14sp"
            android:textColor="@color/s1"
            android:id="@+id/tv_stress_level_high"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/stress_level_high"
            android:drawablePadding="6dp"
            android:drawableStart="@drawable/stress_icon_stress_level_high"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_level_normal"
            app:layout_constraintTop_toBottomOf="@+id/tv_level_relax"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/shape_rect_corner_white"
        android:paddingTop="@dimen/size_12dp"
        android:paddingBottom="@dimen/size_15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/size_15dp"
        android:paddingEnd="@dimen/size_15dp"
        android:layout_marginStart="@dimen/size_15dp"
        android:layout_marginEnd="@dimen/size_15dp">
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="18sp"
            android:textColor="@color/s1"
            android:id="@+id/level_str"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="12sp"
            android:textColor="@color/s1"
            android:id="@+id/level_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_15dp"/>
    </LinearLayout>
</LinearLayout>
