<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_author"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="200dp">
        <ImageView
            android:id="@+id/iv_watch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_bind_wechat_left"
            android:layout_centerVertical="true"
            android:layout_marginEnd="16.2dp"
            android:layout_toStartOf="@+id/iv_bind_point_left"/>
        <ImageView
            android:id="@+id/iv_bind_point_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_bind_wechat_point"
            android:layout_centerVertical="true"
            android:layout_marginEnd="5.2dp"
            android:layout_toStartOf="@+id/iv_bind"/>
        <ImageView
            android:id="@+id/iv_bind"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_bind_wechat_middle"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/iv_bind_point_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_bind_wechat_point"
            android:layout_centerVertical="true"
            android:layout_marginStart="5.2dp"
            android:layout_toEndOf="@+id/iv_bind"/>
        <ImageView
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:src="@drawable/ic_third_party_mi"
            android:layout_centerVertical="true"
            android:layout_marginStart="16.2dp"
            android:layout_toEndOf="@+id/iv_bind_point_right"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/s1"
            android:id="@+id/tv_author"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="24dp"
            android:layout_below="@+id/iv_watch"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
</RelativeLayout>
