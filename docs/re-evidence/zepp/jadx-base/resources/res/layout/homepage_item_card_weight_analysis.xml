<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="185dp">
    <com.huami.module.homepage.cards.cardui.CardTitleBarView
        android:id="@+id/weight_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:secondTitleText="@string/homepage_item_card_body_indices"
        app:timeWarpRules="language"
        app:titleText="@string/homepage_item_card_weight"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/middle_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintGuide_percent="0.5"
        app:layout_constraintStart_toStartOf="parent"/>
    <View
        android:background="@color/s4"
        android:layout_width="0.5dp"
        android:layout_height="157dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.huami.module.homepage.cards.cardui.PiecewiseArcView
        android:id="@+id/weight_arc"
        android:layout_width="128dp"
        android:layout_height="110dp"
        android:layout_marginTop="15dp"
        android:layout_marginStart="19dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/weight_bar"/>
    <com.huami.module.homepage.cards.cardui.PiecewiseArcView
        android:id="@+id/body_arc"
        android:layout_width="128dp"
        android:layout_height="110dp"
        android:layout_marginTop="15dp"
        android:layout_marginEnd="19dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/weight_bar"/>
    <TextView
        android:textColor="@color/s1"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/weight_content"
        android:paddingBottom="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:maxWidth="128dp"
        android:maxLines="3"
        app:layout_constraintEnd_toEndOf="@+id/weight_arc"
        app:layout_constraintStart_toStartOf="@+id/weight_arc"
        app:layout_constraintTop_toTopOf="@+id/weight_arc"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/body_animation"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="25dp"
        app:layout_constraintEnd_toEndOf="@+id/body_arc"
        app:layout_constraintStart_toStartOf="@+id/body_arc"
        app:layout_constraintTop_toTopOf="@+id/body_arc"/>
    <TextView
        android:textColor="@color/s1"
        android:gravity="center"
        android:id="@+id/body_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:lineSpacingExtra="-4dp"
        app:layout_constraintBottom_toBottomOf="@+id/weight_content"
        app:layout_constraintEnd_toEndOf="@+id/body_arc"
        app:layout_constraintStart_toStartOf="@+id/body_arc"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <TextView
        android:textColor="@color/s1"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/bmi_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="41dp"
        android:layout_marginBottom="20dp"
        android:maxWidth="128dp"
        android:maxLines="3"
        android:lineSpacingExtra="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/weight_content"
        app:layout_constraintEnd_toEndOf="@+id/body_arc"
        app:layout_constraintStart_toStartOf="@+id/body_arc"
        style="@style/Rainbow.TextAppearance.Body4"/>
</androidx.constraintlayout.widget.ConstraintLayout>
