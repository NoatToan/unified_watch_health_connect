<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/permission_ll"
    android:layout_width="match_parent"
    android:layout_height="362dp">
    <TextView
        android:textColor="@color/s1"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/homepage_rom_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/homepage_rom_dialog_title"
        style="@style/Rainbow.TextAppearance.Title2"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/homepage_rom_dialog_nsl"
        android:layout_width="match_parent"
        android:layout_height="216dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textColor="@color/s1"
                android:id="@+id/homepage_rom_dialog_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                style="@style/Rainbow.TextAppearance.Body4"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <TextView
        android:background="@color/s4"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="20dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:id="@+id/homepage_rom_dialog_cl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp">
        <View
            android:id="@+id/homepage_rom_dialog_split"
            android:background="@color/s4"
            android:layout_width="1dp"
            android:layout_height="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textColor="@color/s3"
            android:gravity="center"
            android:id="@+id/homepage_rom_dialog_skip"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:text="@string/homepage_rom_update_skip"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/homepage_rom_dialog_split"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Rainbow.TextAppearance.Body3"/>
        <TextView
            android:textColor="@color/s1"
            android:gravity="center"
            android:id="@+id/homepage_rom_dialog_go"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:text="@string/homepage_om_update_now"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/homepage_rom_dialog_split"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Rainbow.TextAppearance.Body3"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
