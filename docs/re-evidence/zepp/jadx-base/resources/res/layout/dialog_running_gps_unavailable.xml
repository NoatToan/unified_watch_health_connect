<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/running_gps_dialog_bg"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/gps_signal_layout"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginTop="10dp"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true">
        <TextView
            android:textSize="@dimen/font_size_v2_f3"
            android:textColor="#cc000000"
            android:id="@+id/gps_pre_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/running_main_gps_prefix"
            android:layout_centerVertical="true"/>
        <ImageView
            android:id="@+id/gps_signal_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/gps_signal_1"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@+id/gps_pre_title"/>
    </RelativeLayout>
    <View
        android:id="@+id/split_line"
        android:background="#f8f8f8"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginTop="16dp"
        android:layout_below="@+id/gps_signal_layout"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
    <ImageView
        android:id="@+id/image"
        android:layout_width="wrap_content"
        android:layout_height="96dp"
        android:layout_marginTop="20dp"
        android:src="@drawable/running_none"
        android:scaleType="centerInside"
        android:layout_below="@+id/split_line"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="@dimen/running_gps_dialog_title"
        android:textColor="@color/running_gps_dialog_title"
        android:gravity="center_horizontal"
        android:id="@+id/gps_cannot_record_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/running_main_go_outdoor"
        android:layout_below="@+id/image"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="@dimen/running_gps_dialog_desc"
        android:textColor="@color/running_gps_dialog_desc"
        android:id="@+id/avoid_use_indoor_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:text="@string/running_main_avoid_use_indoor"
        android:layout_below="@+id/gps_cannot_record_text"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="@dimen/running_gps_dialog_desc"
        android:textColor="@color/running_gps_dialog_desc"
        android:id="@+id/please_go_outdoor_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:text="@string/running_main_gps_cannot_record"
        android:layout_below="@+id/gps_cannot_record_text"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
