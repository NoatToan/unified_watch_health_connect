<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_detail"
    android:background="@color/jac_theme_black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.android.design.dialog.loading.LoadingView
        android:id="@+id/car_check_progress_bar"
        android:layout_width="@dimen/size_52dp"
        android:layout_height="@dimen/size_52dp"
        app:layout_constraintBottom_toTopOf="@+id/car_check_tv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:lv_stroke="2dp"/>
    <TextView
        android:textSize="@dimen/t3"
        android:textColor="@color/s5"
        android:id="@+id/car_check_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_8dp"
        android:text="@string/jac_car_s_check"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/car_check_progress_bar"/>
    <Button
        android:textColor="@color/s5"
        android:id="@+id/car_retry_bt"
        android:visibility="gone"
        android:layout_width="@dimen/size_160dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="@string/jac_car_s_i_retry"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/car_check_tv"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/Rainbow.Widget.Button.Gray.38.Outline.Circular"/>
</androidx.constraintlayout.widget.ConstraintLayout>
