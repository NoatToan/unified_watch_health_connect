<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.lib.rainbow.titlebar.RainbowTitleBar
        android:id="@+id/tv_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_arrow_back_20_2x"
        app:title="@string/fh_menstruation_edit"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@color/s10"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.cardview.widget.CardView
            android:id="@+id/fh_layout_menstruation_start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/fh_setting_item_horizontal_margin"
            android:layout_marginStart="@dimen/fh_setting_item_horizontal_margin"
            android:layout_marginEnd="@dimen/fh_setting_item_horizontal_margin"
            app:cardBackgroundColor="@color/s38"
            app:cardCornerRadius="@dimen/fh_setting_item_corner_radius"
            app:cardElevation="@dimen/fh_setting_item_card_elevation"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/item_menstruation_start"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:ltv_title="@string/fh_menstruation_start"
                    app:ltv_trailing="@drawable/ic_arrow_forward_20_2x"/>
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/item_menstruation_end"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/item_menstruation_start"
                    app:ltv_title="@string/fh_menstruation_end"
                    app:ltv_trailing="@drawable/ic_arrow_forward_20_2x"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="70dp"
            android:paddingStart="@dimen/fh_btn_horizontal_margin"
            android:paddingEnd="@dimen/fh_btn_horizontal_margin"
            app:layout_constraintBottom_toBottomOf="parent">
            <Button
                android:id="@+id/tv_confirm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/fh_sure"
                style="@style/Rainbow.Widget.Button.44"/>
            <Button
                android:id="@+id/tv_cancel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/fh_cancel"
                style="?attr/buttonStyleGray_44_flat"/>
            <Button
                android:id="@+id/tv_delete"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/fh_menstruation_edit_delete"
                style="?attr/buttonStyleGray_44_flat"/>
            <Button
                android:id="@+id/tv_keep"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/fh_menstruation_edit_no_modify"
                style="?attr/buttonStyleGray_44_flat"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
