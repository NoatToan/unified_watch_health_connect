<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/pale_grey_two"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="20sp"
        android:textColor="@color/black80"
        android:gravity="center"
        android:id="@+id/title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/play_miband3_title_3"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/black60"
        android:gravity="center"
        android:id="@+id/sub_title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:text="@string/play_miband3_subtitle_3"
        android:layout_below="@+id/title_tv"
        android:layout_centerHorizontal="true"/>
    <View
        android:id="@+id/center_view"
        android:background="@color/transparent"
        android:layout_width="138dp"
        android:layout_height="1px"
        android:layout_centerInParent="true"/>
    <FrameLayout
        android:layout_width="92dp"
        android:layout_height="148dp"
        android:layout_marginTop="47dp"
        android:layout_below="@+id/sub_title_tv"
        android:layout_alignStart="@+id/center_view">
        <FrameLayout
            android:layout_gravity="end|top"
            android:id="@+id/frame_img_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/img_band_3_time"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="10sp"
                android:textColor="@color/play_miband3_text_color"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:layout_width="47dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="60dp"
                android:text="@string/play_miband3_date"
                android:maxLines="1"
                android:fontFamily="km"/>
        </FrameLayout>
        <FrameLayout
            android:layout_gravity="start|bottom"
            android:id="@+id/frame_img_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/img_band_3_notice"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="10sp"
                android:textColor="@color/play_miband3_text_color"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:layout_width="46dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="45dp"
                android:text="@string/play_miband3_distance_heart_rate_notify_count"
                android:maxLines="1"
                android:fontFamily="km"/>
        </FrameLayout>
        <FrameLayout
            android:layout_gravity="end|bottom"
            android:id="@+id/frame_img_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/img_band_3_notice_wechat"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="9sp"
                android:textColor="@color/play_miband3_text_color"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/play_miband3_distance_heart_rate_wechat"
                android:maxLines="1"
                android:fontFamily="km"
                android:layout_marginStart="12dp"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="9sp"
                android:textColor="@color/play_miband3_text_color"
                android:layout_width="46dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="23dp"
                android:text="@string/play_miband3_distance_heart_rate_wechat_content"
                android:fontFamily="km"/>
            <FrameLayout
                android:layout_gravity="bottom|center_horizontal"
                android:id="@+id/indicator_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/img_band_3_bar"/>
                <ImageView
                    android:id="@+id/indicator_img"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/img_band_3_bar_block"/>
            </FrameLayout>
        </FrameLayout>
    </FrameLayout>
    <View
        android:id="@+id/center_view_middle"
        android:background="@color/transparent"
        android:layout_width="138dp"
        android:layout_height="1px"
        android:layout_centerHorizontal="true"/>
    <View
        android:background="@color/pale_grey_two"
        android:layout_width="46dp"
        android:layout_height="74dp"
        android:layout_marginTop="121dp"
        android:layout_below="@+id/sub_title_tv"
        android:layout_alignStart="@+id/center_view_middle"/>
    <View
        android:background="@color/pale_grey_two"
        android:layout_width="46dp"
        android:layout_height="74dp"
        android:layout_marginTop="47dp"
        android:layout_below="@+id/sub_title_tv"
        android:layout_centerHorizontal="true"/>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp"
        android:src="@drawable/img_band_3"
        android:layout_below="@+id/sub_title_tv"
        android:layout_centerHorizontal="true"/>
    <View
        android:id="@+id/center_view_small"
        android:background="@color/transparent"
        android:layout_width="70dp"
        android:layout_height="1px"
        android:layout_centerInParent="true"/>
    <com.xiaomi.hm.health.ui.playmiband2.MovableImageView
        android:id="@+id/hand_img"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="210dp"
        android:src="@drawable/img_hand"
        android:layout_below="@+id/sub_title_tv"
        android:alpha="0"
        android:layout_toEndOf="@+id/center_view_small"/>
</RelativeLayout>
