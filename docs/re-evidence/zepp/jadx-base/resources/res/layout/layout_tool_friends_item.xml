<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="48dp">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/tool_friends_icon"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="@dimen/size_15dp"
        app:layout_constraintBottom_toBottomOf="@+id/tool_friends_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tool_friends_name"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="?attr/textAppearanceBody3"
        android:textColor="@color/s1"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/tool_friends_name"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:maxLines="1"
        android:singleLine="true"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/tool_friends_right"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/tool_friends_icon"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/tool_friends_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_tool_right_24"
        android:layout_marginEnd="@dimen/size_15dp"
        app:layout_constraintBottom_toBottomOf="@+id/tool_friends_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tool_friends_name"
        app:layout_constraintTop_toTopOf="@+id/tool_friends_name"/>
</androidx.constraintlayout.widget.ConstraintLayout>
