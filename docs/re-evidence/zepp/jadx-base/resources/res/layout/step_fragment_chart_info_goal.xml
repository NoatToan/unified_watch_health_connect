<?xml version="1.0" encoding="utf-8"?>
<com.huami.hmchartui.ui.view.CommonCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/common_card_vertical_margin"
    android:layout_marginStart="@dimen/common_card_horizon_margin"
    android:layout_marginEnd="@dimen/common_card_horizon_margin"
    app:cardCornerRadius="@dimen/common_card_radius"
    app:cardElevation="@dimen/common_card_elevation">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/step_stage_content"
        android:background="@color/s38"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="18sp"
            android:textColor="@color/s1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="@string/step_goal_title"
            android:layout_marginStart="15dp"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/s2"
                android:layout_gravity="start|center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/step_goal_all_count"
                android:maxLines="2"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="80dp"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/s1"
                android:layout_gravity="end|center_vertical"
                android:id="@+id/step_goal_all_count_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/step_goal_num"
                android:layout_marginEnd="25dp"/>
        </FrameLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="48dp">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/s2"
                android:layout_gravity="start|center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/step_goal_countinue_count"
                android:maxLines="2"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="80dp"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/s1"
                android:layout_gravity="end|center_vertical"
                android:id="@+id/step_goal_continue_count_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/step_goal_num"
                android:layout_marginEnd="25dp"/>
        </FrameLayout>
    </LinearLayout>
</com.huami.hmchartui.ui.view.CommonCardView>
