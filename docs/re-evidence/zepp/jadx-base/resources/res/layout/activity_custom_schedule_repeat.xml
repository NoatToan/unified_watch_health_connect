<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.watch.companion.ui.view.ActionbarLayout
        android:id="@+id/custom_repeat_action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:onClick="chooseRepeatType"
            style="@style/ItemStyle">
            <TextView
                android:textSize="14sp"
                android:textColor="#e6000000"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/repeat_frequency"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#80000000"
                android:id="@+id/custom_repeat_frequency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@+id/custom_repeat_frequency_arrow"/>
            <ImageView
                android:id="@+id/custom_repeat_frequency_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_arrow_right_small"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <View style="@style/Divider"/>
        <RelativeLayout
            android:onClick="chooseRepeatInterval"
            style="@style/ItemStyle">
            <TextView
                android:textSize="14sp"
                android:textColor="#e6000000"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/every"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#80000000"
                android:id="@+id/custom_repeat_interval"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@+id/custom_repeat_interval_arrow"/>
            <ImageView
                android:id="@+id/custom_repeat_interval_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_arrow_right_small"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <View style="@style/Divider"/>
        <TextView
            android:textSize="13sp"
            android:textColor="#4c000000"
            android:id="@+id/custom_repeat_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"/>
    </LinearLayout>
</LinearLayout>
