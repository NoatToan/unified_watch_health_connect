<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.lib.rainbow.titlebar.RainbowTitleBar
        android:id="@+id/actionbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationIcon="@drawable/ic_arrow_back_20_2x"
        app:title="@string/ecg_simple"/>
    <com.scwang.smartrefresh.layout.SmartRefreshLayout
        android:id="@+id/refresh_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.huami.watch.companion.ecg.view.EcgPtrHeaderView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.google.android.material.appbar.AppBarLayout
                android:gravity="center"
                android:orientation="vertical"
                android:background="@color/s36"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:elevation="0dp">
                <com.google.android.material.appbar.CollapsingToolbarLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/header"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="168dp"
                    android:minHeight="80dp"
                    app:layout_scrollFlags="exitUntilCollapsed|scroll">
                    <TextView
                        android:textColor="@color/s1"
                        android:gravity="center"
                        android:layout_gravity="center_horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="15dp"
                        android:layout_marginTop="100dp"
                        android:text="@string/ecg_hrv"
                        app:layout_collapseMode="parallax"
                        app:layout_collapseParallaxMultiplier="0.6"
                        style="@style/Rainbow.TextAppearance.Number8"/>
                    <TextView
                        android:textColor="@color/s3"
                        android:gravity="center"
                        android:layout_gravity="center_horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="15dp"
                        android:layout_marginTop="120dp"
                        android:text="@string/ecg_latest_result"
                        app:layout_collapseMode="parallax"
                        app:layout_collapseParallaxMultiplier="0.6"
                        style="@style/Rainbow.TextAppearance.Number8"/>
                    <com.huami.watch.companion.ui.view.HuaMiFontTextView
                        android:textSize="48sp"
                        android:textColor="@color/s1"
                        android:gravity="center"
                        android:id="@+id/hrv"
                        android:background="@color/s36"
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:layout_marginTop="20dp"
                        app:layout_collapseMode="pin"/>
                </com.google.android.material.appbar.CollapsingToolbarLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/empty_header"
                    android:background="@color/s36"
                    android:layout_width="match_parent"
                    android:layout_height="168dp">
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_alert_20"
                        app:tint="@color/s1"/>
                    <TextView
                        android:textColor="@color/s3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/ecg_no_data_simple"
                        style="@style/Rainbow.TextAppearance.Number7"/>
                </LinearLayout>
            </com.google.android.material.appbar.AppBarLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/ecg_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
        </androidx.coordinatorlayout.widget.CoordinatorLayout>
    </com.scwang.smartrefresh.layout.SmartRefreshLayout>
</LinearLayout>
