<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/s36"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/img_circle"
            android:clickable="true"
            android:layout_width="179dp"
            android:layout_height="179dp"
            android:src="@drawable/border_binding_varify"/>
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/button_icon"
                android:layout_width="83dp"
                android:layout_height="83dp"
                android:src="@drawable/binding_btn_bluetooth"/>
            <TextView
                android:textColor="@color/p2"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/button_text"
                android:background="@drawable/border_verify_text_button"
                android:layout_width="78dp"
                android:layout_height="24dp"
                android:layout_marginTop="4dp"
                android:text="@string/turn_bluetooth_on"/>
        </LinearLayout>
    </FrameLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/s2"
        android:id="@+id/tip_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="17dp"
        android:text="@string/bluetooth_tip"
        android:layout_below="@+id/btn"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/s1"
        android:id="@+id/title_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="53dp"
        android:text="@string/plz_turn_bluetooth_on"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@drawable/color_text_red_black"
        android:gravity="center"
        android:id="@+id/bind_later"
        android:background="@drawable/bg_big_btn_border"
        android:clickable="true"
        android:layout_width="313dp"
        android:layout_height="39dp"
        android:layout_marginBottom="16dp"
        android:text="@string/bind_later"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
