<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/external_device_data_container"
    android:background="@color/over_view_gradient_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="15.3sp"
        android:textColor="@color/white100"
        android:gravity="start|center_vertical"
        android:id="@+id/external_device_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14.4dp"
        android:text="@string/external_device_data"
        android:layout_marginStart="13.4dp"/>
    <RelativeLayout
        android:id="@+id/external_device_forefeet_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="19.1dp"
        android:layout_marginStart="13.4dp"
        android:layout_marginEnd="12.7dp">
        <TextView
            android:textSize="12.7sp"
            android:textColor="@color/color_999999"
            android:gravity="start|center_vertical"
            android:id="@+id/external_device_forefeet_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/running_detail_forefoot_desc"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="12.7sp"
            android:textColor="@color/white"
            android:layout_gravity="center_horizontal"
            android:id="@+id/external_device_forefeet_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/runningdetail_forefoot_ratio"
            android:layout_alignParentEnd="true"/>
        <View
            android:background="@color/white10"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="12dp"
            android:layout_below="@+id/external_device_forefeet_title"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/external_device_touchtime_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginStart="13.4dp"
        android:layout_marginEnd="12.7dp">
        <TextView
            android:textSize="12.7sp"
            android:textColor="@color/color_999999"
            android:gravity="start|center_vertical"
            android:id="@+id/external_device_touchtime_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/running_help_touch_down"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="12.7sp"
            android:textColor="@color/white"
            android:layout_gravity="center_horizontal"
            android:id="@+id/external_device_touchtime_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"/>
        <View
            android:background="@color/white10"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="12dp"
            android:layout_below="@+id/external_device_touchtime_title"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/external_device_flyratio_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginStart="13.4dp"
        android:layout_marginEnd="12.7dp">
        <TextView
            android:textSize="12.7sp"
            android:textColor="@color/color_999999"
            android:gravity="start|center_vertical"
            android:id="@+id/external_device_flyratio_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/flight_ratio"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="12.7sp"
            android:textColor="@color/white"
            android:layout_gravity="center_horizontal"
            android:id="@+id/external_device_flyratio_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"/>
        <View
            android:background="@color/white10"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="12dp"
            android:layout_below="@+id/external_device_flyratio_title"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/external_device_avg_cadence_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginStart="13.4dp"
        android:layout_marginEnd="12.7dp">
        <TextView
            android:textSize="12.7sp"
            android:textColor="@color/color_999999"
            android:gravity="start|center_vertical"
            android:id="@+id/external_device_avg_cadence_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/avg_cadence_text"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="12.7sp"
            android:textColor="@color/white"
            android:layout_gravity="center_horizontal"
            android:id="@+id/external_device_avg_cadence_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="78"
            android:layout_toStartOf="@+id/external_device_avg_cadence_unit"/>
        <TextView
            android:textSize="12.7sp"
            android:textColor="@color/white"
            android:id="@+id/external_device_avg_cadence_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cadence_unit"
            android:layout_alignBaseline="@+id/external_device_avg_cadence_value"
            android:layout_alignParentEnd="true"/>
        <View
            android:background="@color/white10"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="12dp"
            android:layout_below="@+id/external_device_avg_cadence_title"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/external_device_max_cadence_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginStart="13.4dp"
        android:layout_marginEnd="12.7dp">
        <TextView
            android:textSize="12.7sp"
            android:textColor="@color/color_999999"
            android:gravity="start|center_vertical"
            android:id="@+id/external_device_max_cadence_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/avg_cadence_text"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="12.7sp"
            android:textColor="@color/white"
            android:layout_gravity="center_horizontal"
            android:id="@+id/external_device_max_cadence_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="168"
            android:layout_toStartOf="@+id/external_device_max_cadence_unit"/>
        <TextView
            android:textSize="12.7sp"
            android:textColor="@color/white"
            android:id="@+id/external_device_max_cadence_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cadence_unit"
            android:layout_alignBaseline="@+id/external_device_max_cadence_value"
            android:layout_alignParentEnd="true"/>
        <View
            android:background="@color/white10"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="12dp"
            android:layout_below="@+id/external_device_max_cadence_title"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
</LinearLayout>
