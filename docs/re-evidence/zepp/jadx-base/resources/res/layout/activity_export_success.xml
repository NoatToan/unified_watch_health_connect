<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="18sp"
        android:textColor="@color/s1"
        android:id="@+id/tv_export_success"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:text="@string/run_share_export_success"
        android:drawableTop="@drawable/run_gpx_export_success"
        android:drawablePadding="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/v_line"
        android:background="@color/s4"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_export_success"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/s2"
        android:id="@+id/tv_file_name_location"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/run_share_export_file_name_location"
        android:layout_marginStart="65dp"
        android:layout_marginEnd="65dp"
        app:layout_constraintTop_toBottomOf="@+id/v_line"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/s38"
        android:gravity="center"
        android:id="@+id/tv_share"
        android:background="@drawable/shape_rect_red_corner_6"
        android:paddingTop="13dp"
        android:paddingBottom="13dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="15dp"
        android:text="@string/run_share_gpx"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_finish"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/s1"
        android:gravity="center"
        android:id="@+id/tv_finish"
        android:paddingTop="13dp"
        android:paddingBottom="13dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:text="@string/run_share_done"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
