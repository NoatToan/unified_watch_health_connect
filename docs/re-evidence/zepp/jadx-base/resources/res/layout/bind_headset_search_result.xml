<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/shape_bind_headset_search"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/size_18sp"
            android:textColor="@color/s1"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/bind_headset_search_device_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_26dp"/>
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/bind_headset_device_search_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/td_size_23dp"
            android:maxWidth="@dimen/size_177dp"
            android:maxHeight="@dimen/size_216dp"/>
        <Button
            android:textColor="@color/s1"
            android:id="@+id/bind_headset_device_sure"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_62dp"
            android:layout_marginTop="@dimen/size_20dp"
            android:text="@string/bind_headset_start_experience"
            android:backgroundTint="@color/s3"
            style="?android:attr/borderlessButtonStyle"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <ImageButton
        android:layout_gravity="end|top"
        android:id="@+id/bind_headset_device_cancel"
        android:layout_width="@dimen/size_24dp"
        android:layout_height="@dimen/size_24dp"
        android:layout_marginTop="@dimen/size_21dp"
        android:src="@drawable/private_haydn_bind_headset_cancel"
        android:layout_marginEnd="@dimen/size_21dp"/>
</FrameLayout>
