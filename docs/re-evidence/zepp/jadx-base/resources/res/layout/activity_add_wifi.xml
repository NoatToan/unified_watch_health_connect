<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.huami.watch.companion.ui.view.ActionbarLayout
            android:id="@+id/actionbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <ImageView
            android:id="@+id/image_commit"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/icon_topbar_commit"
            android:layout_centerVertical="true"
            android:layout_marginEnd="16dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/bg_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="horizontal"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="53dp">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/dark_grey_text"
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/wifi_name"
                android:layout_marginStart="24dp"/>
            <EditText
                android:textSize="14sp"
                android:textColor="@color/black_text"
                android:textColorHint="@color/grey_text"
                android:gravity="start|center_vertical"
                android:layout_gravity="center_vertical"
                android:id="@+id/wifi_name_edit_box"
                android:background="@color/white"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:hint="@string/wifi_input_ssid"
                android:maxLines="1"
                android:layout_weight="1"
                android:textCursorDrawable="@drawable/cursor_edit_box"
                android:layout_marginStart="34dp"/>
        </LinearLayout>
        <View
            android:background="@drawable/divider_settings_item"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/set_encode_type"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/dark_grey_text"
                android:duplicateParentState="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wifi_encode_type"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@drawable/color_text_may_disable"
                android:gravity="end"
                android:id="@+id/encode_type_result"
                android:duplicateParentState="true"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="24dp"/>
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_list_item_right_arrow"/>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/wifi_type_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <include layout="@layout/split_line_width_match_parent"/>
    </LinearLayout>
</LinearLayout>
