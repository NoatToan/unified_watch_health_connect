<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/wifi_center_dialog"
    android:paddingTop="16dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="295dp"
    android:layout_centerInParent="true"
    android:layout_marginStart="40dp"
    android:layout_marginEnd="40dp">
    <TextView
        android:textSize="18sp"
        android:textColor="#000"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/tv_title"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="16dp"/>
    <TextView
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:maxWidth="250dp"
        android:lineSpacingExtra="3dp"
        android:lineSpacingMultiplier="1.2"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        style="@style/Rainbow.TextAppearance.Title2"/>
    <View
        android:background="@color/s3"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginTop="16dp"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycle_menu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/layout_bottom"
        android:layout_width="match_parent"
        android:layout_height="53dp">
        <TextView
            android:gravity="center"
            android:id="@+id/tv_negative"
            android:background="@null"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:singleLine="true"
            android:layout_weight="1"
            style="@style/Rainbow.Widget.Button.Gray.48"/>
        <View
            android:id="@+id/column_line"
            android:background="@color/s3"
            android:layout_width="1px"
            android:layout_height="match_parent"/>
        <TextView
            android:gravity="center"
            android:id="@+id/tv_positive"
            android:background="@null"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"
            android:singleLine="true"
            android:layout_weight="1"
            style="@style/Rainbow.Widget.Button.Gray.48"/>
    </LinearLayout>
</LinearLayout>
