<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/content_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_30dp"
        android:text="@string/device_connect_heaset_alert"
        style="@style/DialogTitleStyle"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/dialog_bottom_panel"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="@dimen/size_30dp">
        <TextView
            android:textColor="@color/s2"
            android:layout_gravity="center"
            android:id="@+id/dialog_negative_button"
            android:background="@drawable/selector_dialog_button_start"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            style="@style/DialogButtonStyle"/>
        <View
            android:layout_gravity="center_vertical"
            android:background="@color/divider"
            android:visibility="gone"
            android:layout_width="@dimen/divider"
            android:layout_height="24dp"/>
        <TextView
            android:textColor="@color/s1"
            android:layout_gravity="center"
            android:id="@+id/dialog_positive_button"
            android:background="@drawable/selector_dialog_button_end"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@android:string/ok"
            android:layout_weight="1"
            style="@style/DialogButtonStyle"/>
    </LinearLayout>
</LinearLayout>
