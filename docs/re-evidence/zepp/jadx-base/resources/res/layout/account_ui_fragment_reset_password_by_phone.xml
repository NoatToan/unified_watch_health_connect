<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/s36"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/account_ui_size_12sp"
        android:textColor="@color/s2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22.3dp"
        android:text="@string/account_ui_account_reset_pwd_by_phone_only_in_china"
        android:layout_marginStart="@dimen/account_ui_hm_email_input_margin"
        android:layout_marginEnd="@dimen/account_ui_hm_email_input_margin"/>
    <LinearLayout
        android:background="@drawable/account_ui_bg_login_edit"
        android:layout_width="match_parent"
        android:layout_height="@dimen/account_ui_hm_email_input_height"
        android:layout_marginTop="12.7dp"
        android:layout_marginStart="@dimen/account_ui_hm_email_input_margin"
        android:layout_marginEnd="@dimen/account_ui_hm_email_input_margin">
        <TextView
            android:textSize="@dimen/account_ui_size_14sp"
            android:textColor="@color/s1"
            android:gravity="center_vertical"
            android:paddingBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/account_ui_hm_email_input_height"
            android:text="+86"
            android:layout_marginStart="@dimen/account_ui_size_15dp"
            android:layout_marginEnd="@dimen/account_ui_size_10dp"/>
        <View
            android:layout_gravity="center_vertical"
            android:background="@color/s4"
            android:layout_width="1dp"
            android:layout_height="26dp"/>
        <androidx.appcompat.widget.AppCompatEditText
            android:textSize="@dimen/account_ui_hm_email_text_size"
            android:textColor="@color/s1"
            android:textColorHint="@color/s3"
            android:id="@+id/input_phone_number"
            android:background="@drawable/account_ui_account_input_text_bg"
            android:paddingLeft="@dimen/account_ui_size_15dp"
            android:paddingRight="@dimen/account_ui_size_15dp"
            android:layout_width="match_parent"
            android:layout_height="@dimen/account_ui_hm_email_input_height"
            android:hint="@string/account_ui_account_input_phone"
            android:inputType="phone"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/hm_email_verification_code_rl"
        android:layout_width="match_parent"
        android:layout_height="@dimen/account_ui_hm_email_input_height"
        android:layout_marginTop="@dimen/account_ui_hm_email_password_margin_top"
        android:layout_marginStart="@dimen/account_ui_hm_email_input_margin"
        android:layout_marginEnd="@dimen/account_ui_hm_email_input_margin">
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <androidx.appcompat.widget.AppCompatEditText
                android:textSize="@dimen/account_ui_hm_email_text_size"
                android:textColor="@color/s1"
                android:gravity="start|center_vertical"
                android:id="@+id/input_verification_code"
                android:background="@drawable/account_ui_bg_login_edit"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:maxLines="2"
                android:maxEms="6"
                android:inputType="numberDecimal"
                android:paddingStart="@dimen/account_ui_hm_email_input_padding"
                android:paddingEnd="@dimen/account_ui_hm_email_input_padding"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/account_ui_hm_email_text_size"
                android:textColor="@color/s3"
                android:gravity="start|center_vertical"
                android:id="@+id/input_verification_code_hint"
                android:background="@drawable/account_ui_bg_login_edit"
                android:layout_width="match_parent"
                android:layout_height="@dimen/account_ui_hm_email_input_height"
                android:text="@string/account_ui_account_input_verify_code"
                android:maxLines="2"
                android:paddingStart="@dimen/account_ui_hm_email_input_padding"
                android:paddingEnd="@dimen/account_ui_hm_email_input_padding"
                app:autoSizeMaxTextSize="@dimen/account_ui_hm_email_text_size"
                app:autoSizeMinTextSize="10sp"
                app:autoSizeTextType="uniform"/>
        </FrameLayout>
        <Space
            android:layout_width="@dimen/account_ui_size_10dp"
            android:layout_height="match_parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:ellipsize="none"
            android:id="@+id/send_verify_btn"
            android:text="@string/account_ui_account_get_verify_code"
            android:maxLines="2"
            app:autoSizeMaxTextSize="@dimen/account_ui_size_14sp"
            app:autoSizeMinTextSize="8sp"
            app:autoSizeTextType="uniform"
            style="@style/AccountUiGetVerificationCodeButton"/>
    </LinearLayout>
    <TextView
        android:enabled="false"
        android:textSize="@dimen/account_ui_login_btn_text_size"
        android:textColor="@color/account_ui_select_alive_btn_txt_color"
        android:gravity="center"
        android:id="@+id/confirm_btn"
        android:background="@drawable/account_ui_btn_bg_login"
        android:layout_width="match_parent"
        android:layout_height="@dimen/account_ui_click_button_h"
        android:layout_marginTop="@dimen/account_ui_hm_email_register_btn_margin_top"
        android:text="@string/account_ui_login_email_forget_password_commit"
        android:layout_marginStart="@dimen/account_ui_hm_email_input_margin"
        android:layout_marginEnd="@dimen/account_ui_hm_email_input_margin"/>
</LinearLayout>
