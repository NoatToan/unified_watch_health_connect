<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="?attr/textAppearanceBody3"
        android:textColor="@color/s1"
        android:gravity="center_vertical"
        android:id="@+id/tool_snore_monitor"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/size_15dp"
        android:text="@string/small_tool_item_snore_monitor"
        android:drawablePadding="10dp"
        android:drawableStart="@drawable/ic_tool_snore_monitor_24"
        android:layout_marginStart="@dimen/size_15dp"
        app:layout_constraintEnd_toStartOf="@+id/tool_snore_monitor_date"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/Rainbow.TextAppearance.Body5"
        android:textColor="@color/s3"
        android:id="@+id/tool_snore_monitor_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/size_15dp"
        app:layout_constraintBottom_toBottomOf="@+id/tool_snore_monitor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tool_snore_monitor"
        app:layout_constraintTop_toTopOf="@+id/tool_snore_monitor"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="?attr/textAppearanceBody4"
        android:textColor="@color/s2"
        android:id="@+id/tool_snore_monitor_prompt"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/play_tool_snore_no_audio"
        android:layout_marginStart="@dimen/size_15dp"
        app:layout_constraintBottom_toBottomOf="@+id/tool_snore_monitor_check"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tool_snore_monitor_check"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="?attr/textAppearanceBody4"
        android:textColor="@color/s2"
        android:id="@+id/tool_snore_monitor_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginStart="@dimen/size_15dp"
        android:layout_marginEnd="@dimen/size_15dp"
        app:layout_constraintEnd_toStartOf="@+id/tool_snore_monitor_check"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tool_snore_monitor"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/tool_snore_monitor_status"
        android:background="@drawable/ic_tool_snore_monitor_wave_24"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:layout_marginStart="@dimen/size_15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tool_snore_monitor_title"/>
    <Button
        android:textAppearance="?attr/textAppearanceBody4"
        android:gravity="center"
        android:id="@+id/tool_snore_monitor_check"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:layout_marginEnd="@dimen/size_15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tool_snore_monitor"
        style="?attr/buttonStyleGray_38_flat_circular"/>
</androidx.constraintlayout.widget.ConstraintLayout>
