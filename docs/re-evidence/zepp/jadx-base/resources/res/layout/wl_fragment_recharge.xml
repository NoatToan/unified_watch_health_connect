<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.wallet.ui.view.NoticeBarView
        android:id="@+id/wl_noticebarview"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_52dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.huami.wallet.ui.view.MyTextView
        android:ellipsize="marquee"
        android:id="@+id/wl_tv_xiaomi_notice"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_42dp"
        android:text=""
        android:scrollHorizontally="true"
        android:singleLine="true"
        android:marqueeRepeatLimit="marquee_forever"
        android:layout_marginStart="@dimen/size_18dp"
        android:layout_marginEnd="@dimen/size_18dp"
        app:layout_constraintTop_toBottomOf="@+id/wl_noticebarview"
        style="@style/NoticeView.Content"/>
    <View
        android:background="@color/s36"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/should_pay_amount_value"
        app:layout_constraintTop_toTopOf="@+id/amount_title"/>
    <TextView
        android:textAppearance="@style/TextAppearance.MiFit.Title.Inverse"
        android:textColor="@color/s1"
        android:gravity="center_vertical"
        android:id="@+id/amount_title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_45dp"
        android:text="@string/wl_recharge_amount"
        android:paddingStart="@dimen/wl_border_margin"
        android:paddingEnd="@dimen/wl_border_margin"
        app:layout_constraintTop_toBottomOf="@+id/wl_tv_xiaomi_notice"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/amount_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/wl_border_margin"
        android:layout_marginEnd="@dimen/wl_border_margin"
        app:layout_constraintTop_toBottomOf="@+id/amount_title"/>
    <TextView
        android:textAppearance="@style/TextAppearance.MiFit.Title.Inverse"
        android:textColor="@color/s2"
        android:gravity="end|bottom"
        android:id="@+id/should_pay_amount_value"
        android:paddingBottom="@dimen/size_10dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_40dp"
        android:paddingStart="@dimen/wl_border_margin"
        android:paddingEnd="@dimen/wl_border_margin"
        app:layout_constraintTop_toBottomOf="@+id/amount_list"/>
    <TextView
        android:textAppearance="@style/TextAppearance.MiFit.Title2.Inverse"
        android:textColor="@color/s2"
        android:id="@+id/recharge_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_18dp"
        android:text="@string/wl_recharge_tips_title"
        android:layout_marginStart="@dimen/size_18dp"
        android:layout_marginEnd="@dimen/size_18dp"
        app:layout_constraintStart_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/should_pay_amount_value"/>
    <TextView
        android:textAppearance="@style/TextAppearance.MiFit.Caption.Inverse"
        android:textColor="@color/s3"
        android:id="@+id/wl_recharge_tips_bottom_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_10dp"
        android:text="@string/wl_recharge_tips_content"
        android:lineSpacingMultiplier="1.2"
        android:layout_marginStart="@dimen/size_18dp"
        android:layout_marginEnd="@dimen/size_18dp"
        app:layout_constraintStart_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/recharge_tips"/>
    <Button
        android:enabled="false"
        android:id="@+id/recharge_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:layout_marginBottom="@dimen/size_18dp"
        android:text="@string/wl_recharge_immediately"
        android:layout_marginStart="@dimen/wl_border_margin"
        android:layout_marginEnd="@dimen/wl_border_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        style="@style/Rainbow.Widget.Button.44.Circular"/>
    <View
        app:layout_constraintBottom_toBottomOf="@+id/should_pay_amount_value"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/HorizontalLine.Dim"/>
</androidx.constraintlayout.widget.ConstraintLayout>
