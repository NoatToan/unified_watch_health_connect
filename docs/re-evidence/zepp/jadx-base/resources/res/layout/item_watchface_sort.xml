<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="104dp"
    android:paddingStart="23.3dp"
    android:paddingEnd="23.3dp">
    <ImageView
        android:id="@+id/iv_sort"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_widget_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_watch"
        android:layout_width="76.8dp"
        android:layout_height="76.8dp"
        android:src="@drawable/watch_face_normal_bg"
        android:layout_marginStart="15.4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/iv_sort"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_watch_face"
        android:visibility="gone"
        android:layout_width="76.8dp"
        android:layout_height="76.8dp"
        android:layout_marginStart="15.4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/iv_sort"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="16sp"
        android:textColor="#e6000000"
        android:id="@+id/tv_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="表盘4"
        android:layout_marginStart="19.2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/iv_watch"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
