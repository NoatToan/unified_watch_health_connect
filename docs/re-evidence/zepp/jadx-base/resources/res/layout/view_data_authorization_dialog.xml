<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textAppearance="@style/Rainbow.TextAppearance.Body4"
        android:textColor="@color/s1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/thirdparty_data_authorization_dialog_msg"
        android:layout_marginStart="@dimen/size_20dp"
        android:layout_marginEnd="@dimen/size_20dp"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/account_ui_size_18dp"
        android:text="@string/thirdparty_today_data"
        style="@style/wechat_data_autorization_text_item_title"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/thirdparty_size_6"
        android:text="@string/thridparty_today_data_detail"
        style="@style/wechat_data_autorization_text_item"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/d5"
        android:text="@string/thirdparty_data_authorization_dialog_sport"
        style="@style/wechat_data_autorization_text_item_title"/>
    <TextView
        android:id="@+id/tv_wechat_sport"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/thirdparty_size_6"
        android:layout_marginBottom="@dimen/d5"
        style="@style/wechat_data_autorization_text_item"/>
</LinearLayout>
