<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/menu_content"
    android:background="@color/s39"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="end"
        android:id="@+id/menu_dismiss"
        android:padding="@dimen/relatives_size_3dp"
        android:layout_width="@dimen/relatives_size_30dp"
        android:layout_height="@dimen/relatives_size_30dp"
        android:layout_marginTop="@dimen/relatives_size_10dp"
        android:layout_marginBottom="@dimen/relatives_size_10dp"
        android:src="@drawable/relatives_warn_close"
        android:tint="@color/s1"
        android:contentDescription="@string/relatives_app_name"
        android:layout_marginStart="@dimen/relatives_size_9dp"
        android:layout_marginEnd="@dimen/relatives_size_9dp"/>
    <TextView
        android:textSize="@dimen/relatives_main_menu_item_text_size"
        android:textColor="@color/s1"
        android:gravity="center_vertical"
        android:id="@+id/action_remark"
        android:background="@drawable/relatives_menu_item_selector"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="@dimen/relatives_size_50dp"
        android:text="@string/relatives_label_remark_name"
        android:paddingStart="@dimen/relatives_size_16dp"
        android:paddingEnd="@dimen/relatives_main_menu_item_padding"/>
    <TextView
        android:textSize="@dimen/relatives_main_menu_item_text_size"
        android:textColor="@color/s1"
        android:gravity="center_vertical"
        android:id="@+id/action_remove_friend"
        android:background="@drawable/relatives_menu_item_selector"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="@dimen/relatives_size_50dp"
        android:text="@string/relatives_label_delete_friend"
        android:paddingStart="@dimen/relatives_size_16dp"
        android:paddingEnd="@dimen/relatives_main_menu_item_padding"/>
    <View
        android:background="@color/s4"
        android:layout_width="match_parent"
        android:layout_height="@dimen/relatives_divider"
        android:layout_marginStart="@dimen/relatives_main_menu_item_padding"
        android:layout_marginEnd="@dimen/relatives_main_menu_item_padding"/>
</LinearLayout>
