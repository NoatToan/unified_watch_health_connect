<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.lib.rainbow.titlebar.RainbowTitleBar
        android:theme="@style/Theme.App.Zepp"
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_arrow_back_20_2x"
        app:title="@string/special_contacts"
        app:titleTextColor="@color/s1"/>
    <androidx.fragment.app.FragmentContainerView
        android:name="com.xiaomi.hm.health.ui.smartplay.appnotify.ContactFragment"
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_bar"/>
    <Button
        android:textColor="@color/s5"
        android:id="@+id/btn_confirm"
        android:background="@drawable/bg_btn_activity_individuation"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_45dp"
        android:layout_marginLeft="@dimen/size_18dp"
        android:layout_marginRight="@dimen/size_18dp"
        android:layout_marginBottom="@dimen/size_45dp"
        android:text="@string/confirm"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
