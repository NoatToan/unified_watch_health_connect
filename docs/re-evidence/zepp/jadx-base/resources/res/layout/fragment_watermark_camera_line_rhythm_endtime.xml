<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:id="@+id/fl_camera"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:background="#0000"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"
        android:layout_alignParentRight="true"
        layout="@layout/layout_watermark_tag"/>
    <RelativeLayout
        android:id="@+id/rl_drag_line_area"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:gravity="center_vertical"
            android:id="@+id/rl_drag_line"
            android:padding="@dimen/watermark_line_thumbnail_padding_r"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:id="@+id/watermark_rhythm_layout"
                android:background="@drawable/run_watermark_running_rhythm_white"
                android:layout_width="260dp"
                android:layout_height="90dp">
                <com.huami.widget.typeface.TypefaceTextView
                    android:textSize="51.3sp"
                    android:textColor="@android:color/white"
                    android:gravity="end"
                    android:id="@+id/watermark_km_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="10.5"
                    android:layout_alignParentTop="true"
                    android:fontFamily="din-med"
                    android:layout_marginEnd="16dp"
                    android:layout_alignParentEnd="true"/>
                <LinearLayout
                    android:gravity="end"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:layout_alignParentBottom="true"
                    android:layout_marginEnd="16dp"
                    android:layout_alignParentEnd="true">
                    <com.huami.widget.typeface.TypefaceTextView
                        android:textSize="@dimen/running_watermark_rhythm_time_text_size"
                        android:textColor="@android:color/white"
                        android:id="@+id/watermark_time_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10.5"
                        android:fontFamily="din-med"/>
                </LinearLayout>
            </RelativeLayout>
        </RelativeLayout>
    </RelativeLayout>
</RelativeLayout>
