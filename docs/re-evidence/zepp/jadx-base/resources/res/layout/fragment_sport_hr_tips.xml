<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s36"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="20sp"
            android:textColor="@color/s1"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="68dp"
            android:text="@string/sport_before_hr_prompt_title"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/s2"
            android:gravity="center"
            android:id="@+id/tv_info_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/running_before_hr_prompt_content"
            android:lineSpacingExtra="5dp"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/s2"
            android:gravity="center"
            android:id="@+id/tv_info_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/running_before_hr_prompt_notice"/>
        <ImageView
            android:id="@+id/iv_image"
            android:background="@color/s36"
            android:layout_width="210dp"
            android:layout_height="210dp"
            android:layout_marginTop="68dp"
            android:src="@drawable/img_heartrate_uphand_sport"
            android:scaleType="centerInside"
            app:tint="@color/s1"/>
    </LinearLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/s2"
        android:gravity="center"
        android:id="@+id/know_btn"
        android:layout_width="match_parent"
        android:layout_height="92dp"
        android:text="@string/running_before_hr_prompt_ok"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
