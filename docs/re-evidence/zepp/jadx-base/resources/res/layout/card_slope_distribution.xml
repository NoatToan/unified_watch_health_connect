<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/shape_rect_white_corner_6"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/slope_distribution"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/moving_ui_slope_distribution"
        android:layout_marginStart="14dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Rainbow.TextAppearance.Body3"/>
    <com.huami.chart.chart.HMPieChart
        android:orientation="vertical"
        android:id="@+id/sport_slope_distribution"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="29dp"
        android:rotation="-90"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="@+id/moving_ui_guideline"
        app:layout_constraintStart_toStartOf="@+id/slope_distribution"
        app:layout_constraintTop_toBottomOf="@+id/slope_distribution"
        app:lineWidth="10dp"
        app:useCenter="false"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/moving_ui_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/lable_uphill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/slope_change_pie_chart_up_label"
        android:layout_marginStart="28dp"
        app:layout_constraintStart_toStartOf="@+id/moving_ui_guideline"
        app:layout_constraintTop_toTopOf="@+id/sport_slope_distribution"
        style="@style/Rainbow.TextAppearance.Body5"/>
    <TextView
        android:background="@drawable/shape_rect_uphill_corner_4"
        android:layout_width="9dp"
        android:layout_height="9dp"
        android:layout_marginEnd="5dp"
        app:layout_constraintBottom_toBottomOf="@+id/lable_uphill"
        app:layout_constraintEnd_toStartOf="@+id/lable_uphill"
        app:layout_constraintTop_toTopOf="@+id/lable_uphill"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/tv_uphill_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:layout_constraintStart_toStartOf="@+id/lable_uphill"
        app:layout_constraintTop_toBottomOf="@+id/lable_uphill"
        style="@style/Rainbow.TextAppearance.Body5"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/tv_uphill_percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginStart="70dp"
        app:layout_constraintStart_toStartOf="@+id/lable_uphill"
        app:layout_constraintTop_toBottomOf="@+id/lable_uphill"
        style="@style/Rainbow.TextAppearance.Body5"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/lable_flat_ground"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="31dp"
        android:text="@string/slope_change_pie_chart_flat_label"
        android:layout_marginStart="28dp"
        app:layout_constraintStart_toStartOf="@+id/moving_ui_guideline"
        app:layout_constraintTop_toBottomOf="@+id/lable_uphill"
        style="@style/Rainbow.TextAppearance.Body5"/>
    <TextView
        android:background="@drawable/shape_rect_flat_ground_corner_4"
        android:layout_width="9dp"
        android:layout_height="9dp"
        android:layout_marginEnd="5dp"
        app:layout_constraintBottom_toBottomOf="@+id/lable_flat_ground"
        app:layout_constraintEnd_toStartOf="@+id/lable_flat_ground"
        app:layout_constraintTop_toTopOf="@+id/lable_flat_ground"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/tv_fat_ground_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:layout_constraintStart_toStartOf="@+id/lable_flat_ground"
        app:layout_constraintTop_toBottomOf="@+id/lable_flat_ground"
        style="@style/Rainbow.TextAppearance.Body5"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/tv_fat_ground_percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginStart="70dp"
        app:layout_constraintStart_toStartOf="@+id/lable_flat_ground"
        app:layout_constraintTop_toBottomOf="@+id/lable_flat_ground"
        style="@style/Rainbow.TextAppearance.Body5"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/lable_downhill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="31dp"
        android:text="@string/slope_change_pie_chart_down_label"
        android:layout_marginStart="28dp"
        app:layout_constraintStart_toStartOf="@+id/moving_ui_guideline"
        app:layout_constraintTop_toBottomOf="@+id/lable_flat_ground"
        style="@style/Rainbow.TextAppearance.Body5"/>
    <TextView
        android:background="@drawable/shape_rect_downhill_corner_4"
        android:layout_width="9dp"
        android:layout_height="9dp"
        android:layout_marginEnd="5dp"
        app:layout_constraintBottom_toBottomOf="@+id/lable_downhill"
        app:layout_constraintEnd_toStartOf="@+id/lable_downhill"
        app:layout_constraintTop_toTopOf="@+id/lable_downhill"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/tv_downhill_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:layout_constraintStart_toStartOf="@+id/lable_downhill"
        app:layout_constraintTop_toBottomOf="@+id/lable_downhill"
        style="@style/Rainbow.TextAppearance.Body5"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/tv_downhill_percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="20dp"
        android:layout_marginStart="70dp"
        app:layout_constraintStart_toStartOf="@+id/lable_downhill"
        app:layout_constraintTop_toBottomOf="@+id/lable_downhill"
        style="@style/Rainbow.TextAppearance.Body5"/>
</androidx.constraintlayout.widget.ConstraintLayout>
