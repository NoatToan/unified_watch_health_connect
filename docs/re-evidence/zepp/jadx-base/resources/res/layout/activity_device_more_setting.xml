<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.watch.companion.ui.view.ActionbarLayout
        android:id="@+id/actionbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/layout_more"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.huami.watch.companion.ui.view.SettingItemView
                android:onClick="onSettingRomUpdateClick"
                app:icon="@drawable/ic_setting_item_upgrade"
                app:title="@string/watch_rom_upgrade"
                style="@style/SettingItemStyle"/>
            <com.huami.watch.companion.ui.view.SettingItemView
                android:visibility="gone"
                android:onClick="onSettingDeviceNameClick"
                app:icon="@drawable/ic_setting_item_device_name"
                app:title="@string/watch_name_info"
                style="@style/SettingItemStyle"/>
            <com.huami.watch.companion.ui.view.SettingItemView
                android:id="@+id/assistant_lab"
                android:onClick="onSettingAssistantLabClick"
                app:icon="@drawable/ic_setting_item_notification_test"
                app:title="@string/assistant_lab"
                style="@style/SettingItemStyle"/>
            <com.huami.watch.companion.ui.view.SettingItemView
                android:onClick="onSettingNotificationTestClick"
                app:icon="@drawable/ic_setting_item_notification_test"
                app:show_divider="false"
                app:title="@string/notification_tester"
                style="@style/SettingItemStyle"/>
        </LinearLayout>
        <View
            android:id="@+id/mask_view"
            android:background="#77f7f7f7"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignBottom="@+id/layout_more"/>
    </RelativeLayout>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#ff5353"
        android:gravity="center"
        android:id="@+id/setting_main_device"
        android:background="@drawable/watch_common_corner_white_rect"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="30dp"
        android:layout_marginBottom="10dp"
        android:text="@string/device_unbind"
        android:onClick="onSettingUnbindClick"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
</LinearLayout>
