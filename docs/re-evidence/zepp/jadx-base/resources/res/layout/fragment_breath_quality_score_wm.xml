<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/sleep_main_bg"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/size_15dp"
    android:layout_marginStart="@dimen/size_15dp"
    android:layout_marginEnd="@dimen/size_15dp">
    <TextView
        android:textSize="@dimen/slp_size_18sp"
        android:textStyle="bold"
        android:textColor="@color/s1"
        android:id="@+id/chartTitleTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_15dp"
        android:paddingStart="@dimen/size_15dp"
        android:paddingEnd="@dimen/size_15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:id="@+id/tipLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/chartTitleTv">
        <TextView
            android:textSize="@dimen/slp_size_11sp"
            android:textColor="@color/s1"
            android:id="@+id/tipTv"
            android:background="@drawable/sleep_gray_bg"
            android:paddingLeft="5dp"
            android:paddingTop="3dp"
            android:paddingRight="5dp"
            android:paddingBottom="3dp"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/chartContentFL"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tipLayout"/>
    <TextView
        android:textSize="@dimen/slp_size_14sp"
        android:textColor="@color/s2"
        android:gravity="center"
        android:id="@+id/emptyTv"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:text="@string/health_data_no_data"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/chartTitleTv"/>
    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/legendLL"
        android:paddingBottom="@dimen/size_15dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:flexWrap="wrap"
        app:justifyContent="flex_start"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/chartContentFL">
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="14sp"
            android:textColor="@color/s2"
            android:paddingTop="@dimen/size_15dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/risk_level_normal"
            android:drawablePadding="4dp"
            android:drawableStart="@drawable/slp_risk_level_normal"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="10dp"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="14sp"
            android:textColor="@color/s2"
            android:paddingTop="@dimen/size_15dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/risk_level_low"
            android:drawablePadding="4dp"
            android:drawableStart="@drawable/slp_risk_level_low"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="10dp"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="14sp"
            android:textColor="@color/s2"
            android:paddingTop="@dimen/size_15dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/risk_level_medium"
            android:drawablePadding="4dp"
            android:drawableStart="@drawable/slp_risk_level_medium"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="10dp"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="14sp"
            android:textColor="@color/s2"
            android:paddingTop="@dimen/size_15dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/risk_level_high"
            android:drawablePadding="4dp"
            android:drawableStart="@drawable/slp_risk_level_high"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="10dp"/>
    </com.google.android.flexbox.FlexboxLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
