<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/s38"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/s10"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:background="@color/s38"
            android:layout_width="match_parent"
            android:layout_height="?android:attr/actionBarSize">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="start|center_vertical"
                android:id="@+id/btn_back"
                android:background="@null"
                android:layout_width="@dimen/size_29dp"
                android:layout_height="@dimen/size_27dp"
                android:src="@drawable/arrow_back_black"
                android:scaleType="center"
                android:tint="@color/s1"
                android:layout_marginStart="@dimen/size_10dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/top_line"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/s1"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/toolbar_title"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/size_24dp"
                android:text="@string/ds_sound_vibration"/>
        </androidx.appcompat.widget.Toolbar>
        <FrameLayout
            android:id="@+id/container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="vertical"
                    android:id="@+id/voice_setting_layout"
                    android:background="@drawable/shape_corners_device_setting"
                    android:paddingTop="@dimen/size_6dp"
                    android:paddingBottom="@dimen/size_6dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_12dp"
                    android:layout_marginStart="@dimen/size_15dp"
                    android:layout_marginEnd="@dimen/size_15dp">
                    <com.huami.lib.rainbow.ListTile
                        android:id="@+id/device_setting_ringtone_reminder"
                        android:background="@color/s38"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="-4dp"
                        app:ltv_title="@string/ds_sound_ringtone_reminder"/>
                    <com.huami.lib.rainbow.ListTile
                        android:id="@+id/device_setting_sound_cover_screen_muting_switch"
                        android:background="@color/s38"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="-4dp"
                        app:ltv_title="@string/ds_sound_cover_screen_muting"/>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/device_setting_volume_viewGroup"
                        android:background="@color/s38"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/size_74dp">
                        <TextView
                            android:textSize="15sp"
                            android:textColor="@color/s1"
                            android:gravity="center_vertical"
                            android:id="@+id/ds_setting_volume_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/size_12dp"
                            android:text="@string/ds_sound_volume"
                            android:layout_marginStart="@dimen/size_16dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <ImageView
                            android:id="@+id/ds_icon_volume_start"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/size_14dp"
                            android:layout_marginBottom="@dimen/size_17dp"
                            android:src="@drawable/device_setting_volume_small"
                            android:tint="@color/s1"
                            android:layout_marginStart="@dimen/size_16dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/ds_setting_volume_title"/>
                        <ImageView
                            android:id="@+id/ds_icon_volume_end"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/device_setting_volume_big"
                            android:tint="@color/s1"
                            android:layout_marginEnd="@dimen/size_14dp"
                            app:layout_constraintBottom_toBottomOf="@+id/ds_icon_volume_start"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="@+id/ds_icon_volume_start"/>
                        <SeekBar
                            android:id="@+id/device_setting_volume_controller"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:maxHeight="@dimen/size_2dp"
                            android:progressDrawable="@drawable/device_setting_seekbar_style"
                            android:minHeight="@dimen/size_2dp"
                            android:thumb="@drawable/device_setting_dot"
                            android:layout_marginStart="@dimen/size_10dp"
                            android:layout_marginEnd="@dimen/size_10dp"
                            android:splitTrack="false"
                            app:layout_constraintBottom_toBottomOf="@+id/ds_icon_volume_start"
                            app:layout_constraintEnd_toStartOf="@+id/ds_icon_volume_end"
                            app:layout_constraintStart_toEndOf="@+id/ds_icon_volume_start"
                            app:layout_constraintTop_toTopOf="@+id/ds_icon_volume_start"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="vertical"
                    android:id="@+id/buzzer_layout"
                    android:background="@drawable/shape_corners_device_setting"
                    android:paddingTop="@dimen/size_6dp"
                    android:paddingBottom="@dimen/size_6dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_15dp"
                    android:layout_marginStart="@dimen/size_15dp"
                    android:layout_marginEnd="@dimen/size_15dp">
                    <com.huami.lib.rainbow.ListTile
                        android:id="@+id/buzzer_scenes_item"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="-4dp"
                        app:ltv_title="@string/ds_sound_buzzer_scenes"/>
                    <com.huami.lib.rainbow.ListTile
                        android:id="@+id/buzzer_vibrate_strength_item"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="-4dp"
                        app:ltv_title="@string/ds_sound_buzzer_vibrate_strength"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/voice_broadcast_switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_15dp"
                    android:layout_marginStart="@dimen/size_15dp"
                    android:layout_marginEnd="@dimen/size_15dp"
                    app:ltv_radius_position="all"
                    app:ltv_title="@string/running_audio_play"/>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="vertical"
                    android:background="@drawable/shape_corners_device_setting"
                    android:paddingTop="@dimen/size_6dp"
                    android:paddingBottom="@dimen/size_6dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_15dp"
                    android:layout_marginStart="@dimen/size_15dp"
                    android:layout_marginEnd="@dimen/size_15dp">
                    <com.huami.lib.rainbow.ListTile
                        android:id="@+id/device_setting_sound_notification_vibration"
                        android:background="@color/s38"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="-4dp"
                        app:ltv_title="@string/ds_sound_notification_vibration"/>
                    <ViewStub
                        android:id="@+id/sound_strength_vibration"
                        android:layout="@layout/view_stub_vibration"
                        android:inflatedId="@+id/sound_strength_radio_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <com.huami.lib.rainbow.ListTile
                        android:id="@+id/device_setting_sound_system_vibration"
                        android:background="@color/s38"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="-4dp"
                        app:ltv_title="@string/ds_sound_system_vibration"/>
                    <com.huami.lib.rainbow.ListTile
                        android:id="@+id/device_setting_sound_vibration_feedback_switch"
                        android:background="@color/s38"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="-4dp"
                        app:ltv_title="@string/ds_sound_vibration_remind"/>
                    <com.huami.lib.rainbow.ListTile
                        android:id="@+id/device_setting_sound_crown_vibration"
                        android:background="@color/s38"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="-4dp"
                        app:ltv_title="@string/ds_sound_crown_vibration"/>
                    <com.huami.lib.rainbow.ListTile
                        android:id="@+id/custom_vibrate_mode_iv"
                        android:background="@color/s38"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="-4dp"
                        app:ltv_title="@string/custom_vibrate_mode"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
            </LinearLayout>
            <View
                android:id="@+id/mask_view"
                android:background="@color/cl_4d000000"
                android:focusable="true"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
    </LinearLayout>
</androidx.appcompat.widget.LinearLayoutCompat>
