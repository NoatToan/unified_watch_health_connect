<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white100"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <EditText
        android:textSize="12.7sp"
        android:textColor="@color/ft_edit_gray"
        android:textColorHint="@color/pai_info_color"
        android:gravity="start|top"
        android:id="@+id/ft_care_topic_edit"
        android:background="@color/forth_background_color"
        android:paddingTop="19.5dp"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_marginTop="10dp"
        android:hint="@string/ft_title_activity_personal_info_edit_hint"
        android:textCursorDrawable="@null"
        android:paddingStart="20dp"
        android:paddingEnd="23dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="11sp"
        android:textColor="@color/pai_info_color"
        android:id="@+id/ft_care_topic_edit_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="15.5dp"
        android:lineSpacingExtra="0sp"
        android:fontFamily="lt"
        android:layout_marginEnd="24.5dp"
        app:layout_constraintBottom_toBottomOf="@+id/ft_care_topic_edit"
        app:layout_constraintEnd_toEndOf="@+id/ft_care_topic_edit"/>
</androidx.constraintlayout.widget.ConstraintLayout>
