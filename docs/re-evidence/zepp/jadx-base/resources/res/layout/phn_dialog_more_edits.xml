<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/phn_shape_corners_top"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="@color/s1"
        android:gravity="center"
        android:id="@+id/tv_modify_rest_days"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/phn_modify_rest_days_title"
        style="@style/Rainbow.TextAppearance.Body3"/>
    <View
        android:background="@color/s4"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <TextView
        android:textColor="@color/s1"
        android:gravity="center"
        android:id="@+id/tv_termination_plan"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/phn_termination_plan"
        style="@style/Rainbow.TextAppearance.Body3"/>
</LinearLayout>
