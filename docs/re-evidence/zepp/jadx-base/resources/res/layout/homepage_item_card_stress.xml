<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="132dp">
    <com.huami.module.homepage.cards.cardui.BackgroundTextView
        android:textColor="@color/s1"
        android:gravity="center"
        android:id="@+id/pressure_mask"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/homepage_item_card_no_pressure_tip"
        app:backgroundTintAlpha="0.92"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/pressure_none_iv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/homepage_stress_none_mifit"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.huami.module.homepage.cards.cardui.CardTitleBarView
        android:id="@+id/pressure_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:showExpandButton="false"
        app:titleText="@string/homepage_item_card_pressure"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/pressure_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="17dp"
        android:layout_marginStart="66dp"
        android:layout_marginEnd="14dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pressure_bar"
        style="@style/Rainbow.TextAppearance.Number2"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/pressure_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/pressure_value"
        app:layout_constraintStart_toStartOf="@+id/pressure_value"
        app:layout_constraintTop_toBottomOf="@+id/pressure_value"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/pressure_scale_iv"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginBottom="27dp"
        android:layout_marginStart="29dp"
        android:layout_marginEnd="34dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/pressure_value"/>
</androidx.constraintlayout.widget.ConstraintLayout>
