<?xml version="1.0" encoding="utf-8"?>
<com.huami.lib.view.scroll.HMScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.huami.lib.rainbow.titlebar.RainbowTitleBar
            android:id="@+id/rainbowTitleBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:title="@string/headset_settings_action"/>
        <com.huami.lib.view.scroll.HMExpandHeadView
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_200dp">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/headset_action_logo"/>
            </FrameLayout>
        </com.huami.lib.view.scroll.HMExpandHeadView>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:id="@+id/container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <TextView
                android:textColor="@color/s2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/headset_action_category_left_ear"
                style="@style/settingCategoryTitleStyle"/>
            <com.huami.lib.rainbow.ListTile
                android:id="@+id/headset_action_item_left_single_touch"
                android:background="@color/s38"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/size_64dp"
                android:paddingStart="@dimen/size_17dp"
                android:paddingEnd="@dimen/size_17dp"
                app:ltv_title="@string/headset_action_single_touch"/>
            <com.huami.lib.rainbow.ListTile
                android:id="@+id/headset_action_item_left_double_touch"
                android:background="@color/s38"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/size_64dp"
                android:paddingStart="@dimen/size_17dp"
                android:paddingEnd="@dimen/size_17dp"
                app:itemEndArrow="true"
                app:ltv_title="@string/headset_action_double_touch"/>
            <com.huami.lib.rainbow.ListTile
                android:id="@+id/headset_action_item_left_triple_touch"
                android:background="@color/s38"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/size_64dp"
                android:paddingStart="@dimen/size_17dp"
                android:paddingEnd="@dimen/size_17dp"
                app:ltv_title="@string/headset_action_triple_touch"/>
            <TextView
                android:textColor="@color/s2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/headset_action_category_right_ear"
                style="@style/settingCategoryTitleStyle"/>
            <com.huami.lib.rainbow.ListTile
                android:id="@+id/headset_action_item_right_single_touch"
                android:background="@color/s38"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/size_64dp"
                android:paddingStart="@dimen/size_17dp"
                android:paddingEnd="@dimen/size_17dp"
                app:ltv_title="@string/headset_action_single_touch"/>
            <com.huami.lib.rainbow.ListTile
                android:id="@+id/headset_action_item_right_double_touch"
                android:background="@color/s38"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/size_64dp"
                android:paddingStart="@dimen/size_17dp"
                android:paddingEnd="@dimen/size_17dp"
                app:ltv_title="@string/headset_action_double_touch"/>
            <com.huami.lib.rainbow.ListTile
                android:id="@+id/headset_action_item_right_triple_touch"
                android:background="@color/s38"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/size_64dp"
                android:paddingStart="@dimen/size_17dp"
                android:paddingEnd="@dimen/size_17dp"
                app:ltv_title="@string/headset_action_triple_touch"/>
            <TextView
                android:textSize="@dimen/size_13sp"
                android:textColor="@color/s2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_11dp"
                android:text="@string/headset_action_desc"
                android:layout_marginStart="@dimen/size_16dp"
                android:layout_marginEnd="@dimen/size_16dp"/>
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <Button
                android:textColor="@color/s1"
                android:id="@+id/headset_action_default_bt"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_50dp"
                android:layout_marginBottom="@dimen/size_10dp"
                android:text="@string/headset_action_reset_default"
                android:layout_marginStart="@dimen/size_21dp"
                android:layout_marginEnd="@dimen/size_21dp"
                android:backgroundTint="@color/s38"/>
        </LinearLayout>
    </LinearLayout>
</com.huami.lib.view.scroll.HMScrollView>
