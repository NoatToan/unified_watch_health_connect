<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="@color/s1"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="63dp"
        android:text="@string/select_schedule_repeat"
        style="@style/Rainbow.TextAppearance.Title2"/>
    <RelativeLayout
        android:id="@+id/repeat_on_mo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="50dp">
        <TextView
            android:textColor="@color/s1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/repeat_on_mo"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/common_item_padding"
            style="@style/Rainbow.TextAppearance.Number7"/>
        <CheckBox
            android:id="@+id/repeat_on_mo_check"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/common_item_padding"
            android:layout_alignParentEnd="true"
            app:buttonTint="@color/rainbow_tint_multichoice"
            style="@style/CheckboxStyle"/>
    </RelativeLayout>
    <View style="@style/DividerWithMargin"/>
    <RelativeLayout
        android:id="@+id/repeat_on_tu"
        android:layout_marginTop="10dp"
        style="@style/ItemStyle">
        <TextView
            android:textColor="@color/s1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/repeat_on_tu"
            android:layout_centerVertical="true"
            style="@style/Rainbow.TextAppearance.Number7"/>
        <CheckBox
            android:id="@+id/repeat_on_tu_check"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            app:buttonTint="@color/rainbow_tint_multichoice"
            style="@style/CheckboxStyle"/>
    </RelativeLayout>
    <View style="@style/DividerWithMargin"/>
    <RelativeLayout
        android:id="@+id/repeat_on_we"
        android:layout_marginTop="10dp"
        style="@style/ItemStyle">
        <TextView
            android:textColor="@color/s1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/repeat_on_we"
            android:layout_centerVertical="true"
            style="@style/Rainbow.TextAppearance.Number7"/>
        <CheckBox
            android:id="@+id/repeat_on_we_check"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            app:buttonTint="@color/rainbow_tint_multichoice"
            style="@style/CheckboxStyle"/>
    </RelativeLayout>
    <View style="@style/DividerWithMargin"/>
    <RelativeLayout
        android:id="@+id/repeat_on_th"
        android:layout_marginTop="10dp"
        style="@style/ItemStyle">
        <TextView
            android:textColor="@color/s1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/repeat_on_th"
            android:layout_centerVertical="true"
            style="@style/Rainbow.TextAppearance.Number7"/>
        <CheckBox
            android:id="@+id/repeat_on_th_check"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            app:buttonTint="@color/rainbow_tint_multichoice"
            style="@style/CheckboxStyle"/>
    </RelativeLayout>
    <View style="@style/DividerWithMargin"/>
    <RelativeLayout
        android:id="@+id/repeat_on_fr"
        android:layout_marginTop="10dp"
        style="@style/ItemStyle">
        <TextView
            android:textColor="@color/s1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/repeat_on_fr"
            android:layout_centerVertical="true"
            style="@style/Rainbow.TextAppearance.Number7"/>
        <CheckBox
            android:id="@+id/repeat_on_fr_check"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            app:buttonTint="@color/rainbow_tint_multichoice"
            style="@style/CheckboxStyle"/>
    </RelativeLayout>
    <View style="@style/DividerWithMargin"/>
    <RelativeLayout
        android:id="@+id/repeat_on_sa"
        android:layout_marginTop="10dp"
        style="@style/ItemStyle">
        <TextView
            android:textColor="@color/s1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/repeat_on_sa"
            android:layout_centerVertical="true"
            style="@style/Rainbow.TextAppearance.Number7"/>
        <CheckBox
            android:id="@+id/repeat_on_sa_check"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            app:buttonTint="@color/rainbow_tint_multichoice"
            style="@style/CheckboxStyle"/>
    </RelativeLayout>
    <View style="@style/DividerWithMargin"/>
    <RelativeLayout
        android:id="@+id/repeat_on_su"
        android:layout_marginTop="10dp"
        style="@style/ItemStyle">
        <TextView
            android:textColor="@color/s1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/repeat_on_su"
            android:layout_centerVertical="true"
            style="@style/Rainbow.TextAppearance.Number7"/>
        <CheckBox
            android:id="@+id/repeat_on_su_check"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            app:buttonTint="@color/rainbow_tint_multichoice"
            style="@style/CheckboxStyle"/>
    </RelativeLayout>
    <View style="@style/DividerWithMargin"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/dialog_bottom_panel"
        android:layout_width="match_parent"
        android:layout_height="52dp">
        <TextView
            android:textColor="@color/s2"
            android:layout_gravity="center"
            android:id="@+id/dialog_negative_button"
            android:background="@drawable/selector_dialog_button_start"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/cancel"
            android:layout_weight="1"
            style="@style/DialogButtonStyle"/>
        <View
            android:layout_gravity="center_vertical"
            android:background="@color/divider"
            android:layout_width="@dimen/divider"
            android:layout_height="24dp"/>
        <TextView
            android:textColor="@color/s1"
            android:layout_gravity="center"
            android:id="@+id/dialog_positive_button"
            android:background="@drawable/selector_dialog_button_end"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/confirm"
            android:layout_weight="1"
            style="@style/DialogButtonStyle"/>
    </LinearLayout>
</LinearLayout>
