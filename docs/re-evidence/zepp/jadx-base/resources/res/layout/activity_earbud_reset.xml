<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.lib.rainbow.titlebar.RainbowTitleBar
        android:id="@+id/tv_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menuIcon="@drawable/ic_edit_20"
        app:navigationIcon="@drawable/ic_arrow_back_20_2x"
        app:title=""/>
    <TextView
        android:textSize="17sp"
        android:textColor="@color/s1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/bind_restore_factory"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/s2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/earbud_reset_check_device"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"/>
    <com.xiaomi.hm.health.device.earbud.view.EarbudImageView
        android:gravity="center"
        android:id="@+id/device_img"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"/>
    <View
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="47dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp">
        <Button
            android:textSize="15sp"
            android:gravity="center"
            android:id="@+id/btn_return"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/cancel"
            android:layout_weight="1"
            style="?attr/buttonStyleGray_48_outline"/>
        <Button
            android:enabled="false"
            android:textSize="15sp"
            android:gravity="center"
            android:id="@+id/btn_reset"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/bind_restore_factory"
            android:layout_weight="1"
            android:layout_marginStart="20dp"
            style="?attr/buttonStyleGray_48_outline"/>
    </LinearLayout>
</LinearLayout>
