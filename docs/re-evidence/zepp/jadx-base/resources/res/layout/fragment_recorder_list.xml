<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s10"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/actionbar"
        android:background="@color/s38"
        android:fitsSystemWindows="true"
        android:layout_width="0dp"
        android:layout_height="44dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="start|center_vertical"
            android:id="@+id/btn_back"
            android:background="@null"
            android:layout_width="29dp"
            android:layout_height="27dp"
            android:src="@drawable/ic_arrow_back_20_2x"
            android:scaleType="center"
            android:tint="?android:attr/textColorPrimary"
            android:layout_marginStart="10dp"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:textAppearance="@style/Rainbow.TextAppearance.Title3"
            android:textSize="16sp"
            android:textColor="?android:attr/textColorPrimary"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:text="@string/device_recorder"
            android:lines="1"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/bg_recorder_trans_txt"
            android:ellipsize="end"
            android:layout_gravity="end"
            android:id="@+id/tv_transport"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/transport_record_file"
            android:lines="1"
            android:layout_marginEnd="15dp"/>
    </androidx.appcompat.widget.Toolbar>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/layout_device_status"
        android:background="@color/s38"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/actionbar">
        <com.huami.lib.view.widget.TipComponent
            android:layout_gravity="center_vertical"
            android:id="@+id/tipview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_device_status">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_record_file_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/layout_transform"
            android:background="@color/s38"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <TextView
                android:textColor="@color/bg_recorder_trans_to_phone_txt"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tv_transform"
                android:paddingTop="10dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/transport_to_phone"
                android:drawableTop="@drawable/bg_recorder_trans_to_phone"
                android:drawablePadding="6dp"
                android:paddingStart="@dimen/size_20dp"
                android:paddingEnd="@dimen/size_20dp"
                app:drawableTopCompat="@drawable/bg_recorder_trans_to_phone"/>
        </LinearLayout>
    </LinearLayout>
    <RelativeLayout
        android:orientation="vertical"
        android:id="@+id/layout_empty"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_device_status">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/img_record_file_empty"
            android:layout_above="@+id/tv_record_file_empty"
            android:layout_centerHorizontal="true"
            app:tint="@color/s2"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/s2"
            android:id="@+id/tv_record_file_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/record_file_empty"
            android:layout_centerInParent="true"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/s2"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/record_file_empty_desc"
            android:layout_below="@+id/tv_record_file_empty"
            android:layout_centerHorizontal="true"
            android:layout_marginStart="50dp"
            android:layout_marginEnd="50dp"/>
        <View
            android:id="@+id/fog_layer"
            android:background="@color/s38"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.65"/>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
