<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/s38"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:background="@color/s38"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="start|center_vertical"
            android:id="@+id/btn_back"
            android:background="@null"
            android:layout_width="@dimen/size_29dp"
            android:layout_height="@dimen/size_27dp"
            android:src="@drawable/arrow_back_black"
            android:scaleType="center"
            android:tint="@color/s1"
            android:layout_marginStart="@dimen/size_10dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/top_line"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/s1"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/size_24dp"
            android:text="@string/watch_settings_screen_off_display"/>
    </androidx.appcompat.widget.Toolbar>
    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/s10"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.cardview.widget.CardView
            android:id="@+id/function_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_14dp"
            android:layout_marginStart="@dimen/size_14dp"
            android:layout_marginEnd="@dimen/size_14dp"
            app:cardBackgroundColor="#ffffff"
            app:cardCornerRadius="@dimen/size_6dp"
            app:cardElevation="0dp">
            <com.huami.lib.rainbow.ListTile
                android:id="@+id/follow_dial_iv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ltv_title="@string/dial_style_follow_dial"/>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:id="@+id/style_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/size_14dp"
            android:layout_marginBottom="@dimen/size_39dp"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/size_14dp"
            android:layout_marginEnd="@dimen/size_14dp"
            app:cardBackgroundColor="@color/s38"
            app:cardCornerRadius="@dimen/size_6dp"
            app:cardElevation="0dp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/s1"
                    android:id="@+id/type_select_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_11dp"
                    android:text="@string/watch_settings_screen_off_display_type_select"
                    android:layout_marginStart="@dimen/size_15dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/screen_off_dial_type_rv"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/size_19dp"
                    android:layout_weight="1"
                    android:overScrollMode="never"
                    app:layout_constraintTop_toBottomOf="@+id/type_select_tv"/>
            </LinearLayout>
            <View
                android:id="@+id/mask_view"
                android:background="@color/cl_4d000000"
                android:focusable="true"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@+id/container"/>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</LinearLayout>
