<?xml version="1.0" encoding="utf-8"?>
<com.huami.hmchartui.ui.view.CommonCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_step_game"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="105dp"
    android:layout_marginTop="14dp"
    android:layout_marginStart="14dp"
    android:layout_marginEnd="14dp"
    app:cardCornerRadius="@dimen/common_card_radius"
    app:cardElevation="@dimen/common_card_elevation">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/card_step_game"
        android:background="@drawable/bg_step_game"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="40dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/barrier"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="12sp"
                android:textColor="@color/s30"
                android:ellipsize="end"
                android:id="@+id/step_tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/step_game_title"
                android:lines="1"
                android:fontFamily="lt"
                app:layout_constraintBottom_toTopOf="@+id/step_sub_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/s30"
                android:ellipsize="end"
                android:id="@+id/step_sub_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/step_game_sub_title"
                android:maxLines="2"
                android:lineSpacingExtra="6dp"
                android:fontFamily="lt-bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/step_tv_title"
                app:layout_constraintTop_toBottomOf="@+id/step_tv_title"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/step_pb_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/step_sub_title">
                <ProgressBar
                    android:id="@+id/step_pb"
                    android:layout_width="0dp"
                    android:layout_height="5dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/step_bg_pb"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/step_pb_desc"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="?android:attr/progressBarStyleHorizontal"/>
                <com.huami.widget.typeface.TypefaceTextView
                    android:textSize="12sp"
                    android:textColor="@color/s30"
                    android:id="@+id/step_pb_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="lt"
                    android:layout_marginStart="5dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/step_pb"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrier"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            app:barrierDirection="start"
            app:constraint_referenced_ids="step_tv_btn"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="12sp"
            android:textColor="@color/s5"
            android:gravity="center"
            android:id="@+id/step_tv_btn"
            android:background="@drawable/bg_step_game_btn"
            android:layout_width="wrap_content"
            android:layout_height="31dp"
            android:minWidth="81dp"
            android:text="@string/step_unlock_step_game"
            android:fontFamily="lt"
            android:layout_marginEnd="14dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.huami.hmchartui.ui.view.CommonCardView>
