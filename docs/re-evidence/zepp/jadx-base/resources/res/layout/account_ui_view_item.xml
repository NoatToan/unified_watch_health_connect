<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/common_item_padding"
        android:paddingEnd="@dimen/account_ui_item_padding_horizontal">
        <RelativeLayout
            android:layout_gravity="center_vertical"
            android:id="@+id/content_layout"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="5.5dp"
            android:layout_marginBottom="5.5dp"
            android:layout_weight="1"
            android:paddingStart="0dp"
            android:paddingEnd="14dp">
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="@dimen/item_title_size"
                android:textColor="@color/account_ui_default_itemview_title_color"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="lt"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="@dimen/account_ui_item_summary_text_size"
                android:textColor="@color/account_ui_black40"
                android:id="@+id/summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/title"
                android:fontFamily="lt"/>
        </RelativeLayout>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="12sp"
            android:textColor="@color/account_ui_default_itemview_right_color"
            android:gravity="end"
            android:layout_gravity="end|center_vertical"
            android:id="@+id/right_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="140dp"
            android:fontFamily="lt"
            android:layout_marginEnd="4dp"/>
        <com.huami.account.ui.view.HMCircleBorderImageView
            android:gravity="end"
            android:layout_gravity="end|center_vertical"
            android:id="@+id/right_value_img"
            android:visibility="gone"
            android:layout_width="33.3dp"
            android:layout_height="33.3dp"
            android:layout_marginEnd="4dp"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/right_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/account_ui_default_end_arrow"/>
        <androidx.appcompat.widget.SwitchCompat
            android:layout_gravity="center"
            android:id="@+id/item_switch"
            android:focusable="false"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/AccountUiswitchStyle"/>
    </LinearLayout>
</merge>
