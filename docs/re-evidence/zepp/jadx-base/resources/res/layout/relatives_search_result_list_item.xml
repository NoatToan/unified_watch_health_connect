<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:background="@color/s38"
    android:layout_width="match_parent"
    android:layout_height="@dimen/relatives_size_90dp">
    <ImageView
        android:layout_gravity="start|center_vertical"
        android:id="@+id/icon"
        android:background="@drawable/relatives_person_avatar_default"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="@dimen/relatives_size_44dp"
        android:layout_height="@dimen/relatives_size_44dp"
        android:scaleType="centerCrop"
        android:layout_marginStart="@dimen/relatives_size_16dp"/>
    <RelativeLayout
        android:layout_gravity="start|center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/relatives_size_68dp">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/s1"
            android:ellipsize="end"
            android:id="@+id/username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/relatives_size_210dp"
            android:maxLines="1"
            android:lineSpacingExtra="-1sp"
            android:layout_marginEnd="@dimen/relatives_size_3dp"
            android:layout_toStartOf="@+id/add_button"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/s2"
            android:id="@+id/uid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/relatives_size_6dp"
            android:layout_below="@+id/username"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/p3"
            android:gravity="center"
            android:id="@+id/add_button"
            android:background="@drawable/relatives_friend_corner_rect"
            android:paddingTop="@dimen/relatives_size_5dp"
            android:paddingBottom="@dimen/relatives_size_5dp"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/relatives_size_28dp"
            android:text="@string/relatives_title_add_friend"
            android:lineSpacingExtra="-6.7sp"
            android:paddingStart="@dimen/relatives_size_12dp"
            android:paddingEnd="@dimen/relatives_size_12dp"
            android:layout_marginEnd="@dimen/relatives_size_16dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</FrameLayout>
