<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/content"
    android:background="@color/s44"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.amap.api.maps.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/td_line_running_setting_btn"
        android:background="@drawable/td_running_setting_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:layout_marginEnd="13dp"/>
    <LinearLayout
        android:layout_gravity="start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:layout_marginStart="13dp">
        <com.huami.treadmill.ui.component.SmallMapView
            android:id="@+id/small_map_vw"
            android:layout_width="50dp"
            android:layout_height="50dp"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="16sp"
            android:textColor="@color/s5"
            android:gravity="center"
            android:id="@+id/small_map_ratio"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:text="0.0%"
            android:layout_centerHorizontal="true"
            android:fontFamily="lt"
            android:layout_marginStart="15dp"/>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="end"
        android:layout_width="175dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="62dp"
        android:layout_marginEnd="5dp">
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="41sp"
            android:textColor="@color/s5"
            android:gravity="center"
            android:id="@+id/rank_number"
            android:layout_width="wrap_content"
            android:layout_height="60dp"
            android:text="0"
            android:layout_centerHorizontal="true"
            android:fontFamily="lt"
            android:layout_marginStart="25dp"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="16sp"
            android:textColor="@color/s5"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="60dp"
            android:text="th"
            android:layout_centerHorizontal="true"
            android:fontFamily="lt"
            android:layout_marginStart="5dp"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:layout_gravity="end"
        android:id="@+id/recycler_view"
        android:layout_width="175dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="126dp"/>
</FrameLayout>
