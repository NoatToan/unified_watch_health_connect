<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/qr_code"
        android:background="@android:color/white"
        android:layout_width="@dimen/relatives_size_156dp"
        android:layout_height="@dimen/relatives_size_156dp"
        android:layout_marginTop="@dimen/relatives_size_82dp"
        android:scaleType="fitCenter"
        android:layout_centerHorizontal="true"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="17sp"
        android:textColor="@color/s1"
        android:layout_gravity="center_horizontal"
        android:id="@+id/user_id"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/relatives_size_22dp"
        android:layout_below="@+id/qr_code"
        android:layout_centerHorizontal="true"
        android:fontFamily="km"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/s2"
            android:gravity="center_horizontal"
            android:id="@+id/tv_scan_tip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/relatives_label_my_qrcode_tips"
            android:lineSpacingExtra="7sp"
            android:paddingStart="@dimen/relatives_size_38dp"
            android:paddingEnd="@dimen/relatives_size_38dp"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/s1"
            android:gravity="center"
            android:id="@+id/share_button"
            android:background="@drawable/relatives_midong_common_corner_rect"
            android:layout_width="match_parent"
            android:layout_height="@dimen/relatives_size_48dp"
            android:layout_marginTop="@dimen/relatives_size_30dp"
            android:layout_marginBottom="@dimen/relatives_size_20dp"
            android:text="@string/relatives_share_to_friends"
            android:layout_marginStart="@dimen/relatives_common_item_padding"
            android:layout_marginEnd="@dimen/relatives_common_item_padding"/>
    </LinearLayout>
</RelativeLayout>
