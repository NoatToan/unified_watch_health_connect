<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/training_pause_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/training_gauss_blur_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <TextView
        android:textSize="@dimen/training_pause_text_size"
        android:textColor="@color/white"
        android:id="@+id/training_cost_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="@dimen/training_pause_text_size"
        android:textColor="@color/training_pause_action_name"
        android:id="@+id/training_action_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="45dp"
        android:layout_below="@+id/training_cost_time"
        android:layout_centerHorizontal="true"/>
    <TextureView
        android:id="@+id/training_thumbnail"
        android:layout_width="192dp"
        android:layout_height="108dp"
        android:layout_marginTop="12dp"
        android:layout_below="@+id/training_action_name"
        android:layout_centerHorizontal="true"/>
    <com.xiaomi.hm.health.baseui.TextLinkAdView
        android:id="@+id/ad_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:layout_below="@+id/training_thumbnail"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:badgeColor="@color/color_warning"
        app:textColor="@color/white100"/>
    <com.xiaomi.hm.health.training.ui.widget.TrainingPauseView
        android:id="@+id/training_resume"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:layout_marginBottom="12dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
