<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/shape_rect_white_corner_6"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/moving_ui_diagram_title_layout"
        android:layout_width="match_parent"
        android:layout_height="40dp">
        <TextView
            android:textAppearance="@style/Rainbow.TextAppearance.Body3"
            android:textColor="@color/s1"
            android:id="@+id/moving_ui_diagram_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="14dp"/>
        <TextView
            android:textAppearance="@style/Rainbow.TextAppearance.Body3"
            android:textColor="@color/s2"
            android:id="@+id/moving_ui_diagram_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="6dp"
            android:layout_toEndOf="@+id/moving_ui_diagram_title"/>
        <ImageView
            android:id="@+id/moving_ui_diagram_chart_icon"
            android:background="@drawable/ic_moving_ui_chart_land_scape"
            android:padding="6dp"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="8dp"
            android:layout_alignParentTop="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="8dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/moving_ui_diagram_labels_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/d2">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/moving_ui_diagram_first_sub_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_gravity="center"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <com.huami.widget.typeface.TypefaceTextView
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/s1"
                    android:gravity="center_horizontal"
                    android:id="@+id/moving_ui_diagram_subtitle1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="din-med"/>
                <TextView
                    android:textAppearance="@style/Rainbow.TextAppearance.Body4"
                    android:textColor="@color/s2"
                    android:gravity="center_horizontal"
                    android:id="@+id/moving_ui_diagram_subtitle_name1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <View
                android:layout_gravity="center"
                android:background="@color/s4"
                android:layout_width="1dp"
                android:layout_height="40dp"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_gravity="center"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <com.huami.widget.typeface.TypefaceTextView
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/s1"
                    android:gravity="center_horizontal"
                    android:id="@+id/moving_ui_diagram_subtitle2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="din-med"/>
                <TextView
                    android:textAppearance="@style/Rainbow.TextAppearance.Body4"
                    android:textColor="@color/s2"
                    android:gravity="center_horizontal"
                    android:id="@+id/moving_ui_diagram_subtitle_name2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/moving_ui_diagram_second_sub_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/d3">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_gravity="center"
                android:orientation="vertical"
                android:id="@+id/moving_ui_diagram_sub3"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <com.huami.widget.typeface.TypefaceTextView
                    android:textSize="20sp"
                    android:textColor="@color/s1"
                    android:gravity="center_horizontal"
                    android:id="@+id/moving_ui_diagram_subtitle3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="din-med"/>
                <TextView
                    android:textAppearance="@style/Rainbow.TextAppearance.Body4"
                    android:textColor="@color/s2"
                    android:gravity="center_horizontal"
                    android:id="@+id/moving_ui_diagram_subtitle_name3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <View
                android:layout_gravity="center"
                android:id="@+id/moving_ui_diagram_subtitle_split_3"
                android:background="@color/s4"
                android:visibility="gone"
                android:layout_width="1dp"
                android:layout_height="40dp"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_gravity="center"
                android:orientation="vertical"
                android:id="@+id/moving_ui_diagram_sub4"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <com.huami.widget.typeface.TypefaceTextView
                    android:textSize="20sp"
                    android:textColor="@color/s1"
                    android:gravity="center_horizontal"
                    android:id="@+id/moving_ui_diagram_subtitle4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="din-med"/>
                <TextView
                    android:textAppearance="@style/Rainbow.TextAppearance.Body4"
                    android:textColor="@color/s2"
                    android:gravity="center_horizontal"
                    android:id="@+id/moving_ui_diagram_subtitle_name4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </LinearLayout>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/moving_ui_diagram_container"
        android:layout_width="match_parent"
        android:layout_height="205dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/body_status_bottom"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="13dp">
        <TextView
            android:id="@+id/moving_ui_bottom_status_icon_1"
            android:background="@drawable/shape_rect_s15_corner_4"
            android:visibility="gone"
            android:layout_width="9dp"
            android:layout_height="9dp"/>
        <TextView
            android:textColor="@color/s2"
            android:id="@+id/moving_ui_bottom_status_label_1"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/moving_ui_chart_pressure_relax"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="19dp"
            style="@style/Rainbow.TextAppearance.Body5"/>
        <TextView
            android:id="@+id/moving_ui_bottom_status_icon_2"
            android:background="@drawable/shape_rect_good_corner_4"
            android:layout_width="9dp"
            android:layout_height="9dp"/>
        <TextView
            android:textColor="@color/s2"
            android:id="@+id/moving_ui_bottom_status_label_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/moving_ui_good"
            android:layout_marginStart="4dp"
            style="@style/Rainbow.TextAppearance.Body5"/>
        <TextView
            android:id="@+id/moving_ui_bottom_status_icon_3"
            android:background="@drawable/shape_rect_flat_ground_corner_4"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginStart="19dp"/>
        <TextView
            android:textColor="@color/s2"
            android:id="@+id/moving_ui_bottom_status_label_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/moving_ui_generally"
            android:layout_marginStart="4dp"
            style="@style/Rainbow.TextAppearance.Body5"/>
        <TextView
            android:id="@+id/moving_ui_bottom_status_icon_4"
            android:background="@drawable/shape_rect_uphill_corner_4"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginStart="19dp"/>
        <TextView
            android:textColor="@color/s2"
            android:id="@+id/moving_ui_bottom_status_label_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/moving_ui_fatigue"
            android:layout_marginStart="4dp"
            style="@style/Rainbow.TextAppearance.Body5"/>
    </LinearLayout>
</LinearLayout>
