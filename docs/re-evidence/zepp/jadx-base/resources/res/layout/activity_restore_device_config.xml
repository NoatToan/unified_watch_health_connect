<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="20sp"
        android:textColor="@color/s1"
        android:gravity="center"
        android:id="@+id/restore_title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="98dp"
        android:text="@string/restore_device_title"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/s2"
        android:gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:text="@string/restore_tips"
        android:layout_below="@+id/restore_title_tv"
        android:layout_centerHorizontal="true"/>
    <RelativeLayout
        android:id="@+id/work_rl"
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:layout_marginTop="151dp">
        <com.xiaomi.hm.health.device.view.HMLoadingView
            android:id="@+id/restore_loading_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ImageView
            android:id="@+id/device_img"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/img_miband"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
</RelativeLayout>
