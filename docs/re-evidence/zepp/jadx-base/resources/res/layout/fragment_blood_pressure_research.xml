<?xml version="1.0" encoding="utf-8"?>
<com.huami.lib.rainbow.shapeable.ShapeableConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_research_container"
    android:background="@color/s38"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/size_10"
    android:paddingEnd="@dimen/size_10"
    app:shapeAppearance="@style/ShapeAppearance.App.Rounded">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_research"
        android:background="@drawable/bp_research_icon"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_195"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/s5"
        android:gravity="end"
        android:id="@+id/tv_research_result"
        android:paddingTop="@dimen/size_13"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lines="1"
        android:paddingEnd="@dimen/size_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_research_title"
        android:paddingTop="@dimen/size_10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lines="1"
        android:paddingStart="@dimen/size_17"
        android:paddingEnd="@dimen/size_17"
        app:layout_constraintTop_toBottomOf="@+id/iv_research"
        style="@style/title2s1"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/s2"
        android:id="@+id/tv_research_desc"
        android:paddingTop="@dimen/size_5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:paddingStart="@dimen/size_17"
        android:paddingEnd="@dimen/size_17"
        app:layout_constraintTop_toBottomOf="@+id/tv_research_title"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:gravity="start"
        android:id="@+id/tv_research_author"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_8"
        android:lines="1"
        android:paddingStart="@dimen/size_17"
        android:paddingEnd="@dimen/size_17"
        app:layout_constraintTop_toBottomOf="@+id/tv_research_desc"
        style="@style/body5s3"/>
    <View
        android:id="@+id/iv_research_div"
        android:background="@color/s4"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_line"
        android:layout_marginTop="@dimen/size_14"
        android:paddingStart="@dimen/size_17"
        android:paddingEnd="@dimen/size_17"
        app:layout_constraintTop_toBottomOf="@+id/tv_research_author"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/blood_pressure_s2"
        android:id="@+id/tv_research_useraction"
        android:paddingTop="@dimen/size_15"
        android:paddingBottom="15dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/blood_pressure_resource_enter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_research_div"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="@dimen/size_12"
        android:layout_height="@dimen/size_12"
        android:src="@drawable/ic_arrow_forward_20_2x"
        android:layout_marginStart="@dimen/size_11"
        app:layout_constraintBottom_toBottomOf="@+id/tv_research_useraction"
        app:layout_constraintStart_toEndOf="@+id/tv_research_useraction"
        app:layout_constraintTop_toTopOf="@+id/tv_research_useraction"
        app:tint="@color/s2"/>
</com.huami.lib.rainbow.shapeable.ShapeableConstraintLayout>
