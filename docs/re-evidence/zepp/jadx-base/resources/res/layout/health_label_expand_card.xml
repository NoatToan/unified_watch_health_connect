<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="62dp">
        <RelativeLayout
            android:id="@+id/health_label_header"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_alignParentTop="true"
            android:layout_marginStart="17dp">
            <TextView
                android:textColor="@color/s1"
                android:id="@+id/health_label_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/health_label_home_title"
                android:layout_centerVertical="true"
                style="@style/Rainbow.TextAppearance.Body3"/>
            <ImageView
                android:id="@+id/health_label_arrow"
                android:padding="7dp"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_expand_more_20"
                android:layout_centerVertical="true"
                android:layout_marginEnd="8dp"
                android:layout_alignParentEnd="true"
                app:tint="@color/s2"/>
        </RelativeLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/health_label_expand"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="62dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="62dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/health_label_icon"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/ic_health_label_icon"
                    android:layout_marginStart="7dp"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/health_label_expand_rv"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginStart="2dp"/>
            </LinearLayout>
            <View
                android:background="@drawable/shape_label_shader"
                android:layout_width="34dp"
                android:layout_height="52dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </RelativeLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/health_label_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="-25dp">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/health_label_rv_all"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            app:layout_constraintBottom_toTopOf="@+id/health_label_add"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/health_label_rv_one"
                android:layout_width="match_parent"
                android:layout_height="42dp"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/health_label_rv_two"
                android:layout_width="match_parent"
                android:layout_height="42dp"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/health_label_rv_three"
                android:layout_width="match_parent"
                android:layout_height="42dp"/>
        </LinearLayout>
        <Button
            android:id="@+id/health_label_retry"
            android:visibility="gone"
            android:layout_width="82dp"
            android:layout_height="38dp"
            android:layout_marginBottom="41dp"
            android:text="@string/health_label_refresh"
            app:layout_constraintBottom_toTopOf="@+id/health_label_add"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="?attr/buttonStyleRed_38_outline"/>
        <TextView
            android:textColor="@color/s1"
            android:id="@+id/health_label_network_error"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="@string/health_label_network_error"
            app:layout_constraintBottom_toTopOf="@+id/health_label_retry"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/Rainbow.TextAppearance.Body4"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/health_label_loading_ll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/health_label_add"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/health_label_loading_iv"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_loading"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/FF666666"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/health_label_loading"
                android:layout_marginStart="3dp"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/health_label_add"
            android:layout_width="20dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="20dp"
            android:src="@drawable/ic_add_label_icon"
            app:layout_constraintBottom_toBottomOf="@+id/health_label_container"
            app:layout_constraintEnd_toEndOf="@+id/health_label_container"
            app:layout_constraintStart_toStartOf="@+id/health_label_container"
            app:tint="@color/s2"/>
        <ImageView
            android:id="@+id/health_label_record"
            android:layout_width="20dp"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_health_record_icon"
            app:layout_constraintBottom_toBottomOf="@+id/health_label_add"
            app:layout_constraintEnd_toStartOf="@+id/health_label_add"
            app:layout_constraintStart_toStartOf="@+id/health_label_container"
            app:layout_constraintTop_toTopOf="@+id/health_label_add"
            app:tint="@color/s2"/>
        <ImageView
            android:id="@+id/health_label_edit"
            android:layout_width="20dp"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_health_edit_icon"
            app:layout_constraintBottom_toBottomOf="@+id/health_label_add"
            app:layout_constraintEnd_toEndOf="@+id/health_label_container"
            app:layout_constraintStart_toEndOf="@+id/health_label_add"
            app:layout_constraintTop_toTopOf="@+id/health_label_add"
            app:tint="@color/s2"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
