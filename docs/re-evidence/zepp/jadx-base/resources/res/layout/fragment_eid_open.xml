<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#f8f8f8"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_eid_open_bg"
        android:scaleType="fitCenter"
        android:layout_alignParentEnd="true"/>
    <RelativeLayout
        android:id="@+id/top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="38dp"
        android:paddingStart="23dp"
        android:paddingEnd="23dp">
        <TextView
            android:textSize="61.4sp"
            android:textColor="#fe5e17"
            android:gravity="center_horizontal"
            android:id="@+id/step_index"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1"/>
        <TextView
            android:textSize="19.2sp"
            android:textColor="#fe5e17"
            android:gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="/4"
            android:layout_alignBaseline="@+id/step_index"
            android:layout_marginStart="3dp"
            android:layout_toEndOf="@+id/step_index"/>
        <TextView
            android:textSize="15.4sp"
            android:textColor="#fe5e17"
            android:gravity="center_horizontal"
            android:id="@+id/step_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/eid_open_collection_information"
            android:layout_below="@+id/step_index"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/normal_body"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <ImageView
            android:id="@+id/step_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/eid_open_step_password"/>
        <ProgressBar
            android:id="@+id/progress_bar"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="36dp"
            android:max="100"
            android:indeterminateOnly="false"
            android:progressDrawable="@drawable/eid_progress_bar"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"/>
        <TextView
            android:textSize="13.4sp"
            android:textColor="#000000"
            android:gravity="center_horizontal"
            android:id="@+id/step_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="@string/eid_open_input_password_tips"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/face_body"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/finish"
        android:layout_below="@+id/top">
        <com.huami.eid.ui.camera.SenseCameraPreview
            android:id="@+id/camera_preview"
            android:layout_width="278dp"
            android:layout_height="278dp"
            android:layout_marginTop="20dp"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="20sp"
            android:textColor="#000000"
            android:id="@+id/linkface_txt_note"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/common_detecting"
            android:layout_below="@+id/camera_preview"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <TextView
        android:textSize="13.4sp"
        android:textStyle="bold"
        android:textColor="@drawable/eid_text_color_selector"
        android:gravity="center_horizontal"
        android:id="@+id/finish"
        android:background="@drawable/eid_border_selector"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/eid_open_finish"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="23dp"
        android:layout_marginEnd="23dp"/>
</RelativeLayout>
