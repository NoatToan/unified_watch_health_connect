<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/card_corner_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/size_10"
    android:layout_marginEnd="@dimen/size_10">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container_chart_info_short"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.google.android.flexbox.FlexboxLayout
            android:orientation="horizontal"
            android:id="@+id/flex_chart_intro"
            android:paddingTop="@dimen/size_17"
            android:paddingBottom="@dimen/size_17"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingEnd="@dimen/size_17"
            app:alignContent="flex_start"
            app:alignItems="flex_start"
            app:flexDirection="row"
            app:flexWrap="nowrap"
            app:justifyContent="flex_start"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/switch_avg_line"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textColor="@color/blood_pressure_s2"
                android:ellipsize="end"
                android:id="@+id/tv_info_short_item"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/blood_pressure_sbp"
                android:maxLines="1"
                android:drawablePadding="@dimen/size_5"
                android:drawableStart="@drawable/blood_pressure_shape_sbp_circle"
                android:paddingStart="@dimen/size_13"
                style="@style/Rainbow.TextAppearance.Body4"/>
            <TextView
                android:textColor="@color/blood_pressure_s2"
                android:ellipsize="end"
                android:id="@+id/tv_info_short_item2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/blood_pressure_dbp"
                android:maxLines="1"
                android:drawablePadding="@dimen/size_5"
                android:drawableStart="@drawable/blood_pressure_shape_dbp_circle"
                android:paddingStart="@dimen/size_13"
                style="@style/Rainbow.TextAppearance.Body4"/>
        </com.google.android.flexbox.FlexboxLayout>
        <com.huami.lib.rainbow.widget.SwitchCompat
            android:id="@+id/switch_avg_line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false"
            android:paddingEnd="@dimen/size_4"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tv_avg_line"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Rainbow.Widget.Switch"/>
        <TextView
            android:textColor="@color/blood_pressure_s2"
            android:id="@+id/tv_avg_line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/blood_pressure_avg_line"
            android:maxLines="1"
            android:paddingEnd="@dimen/size_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Rainbow.TextAppearance.Body4"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
