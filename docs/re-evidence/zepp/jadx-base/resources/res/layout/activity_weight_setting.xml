<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/device_setting_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.lib.rainbow.titlebar.RainbowTitleBar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:menuIcon="@drawable/ic_edit_20"
        app:navigationIcon="@drawable/ic_arrow_back_20_2x"
        style="@style/Rainbow.TextAppearance.Title3"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:elevation="0dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <include
                android:id="@+id/device_status_wrapper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                layout="@layout/device_setting_header"/>
            <FrameLayout
                android:background="@drawable/bg_device_setting_unit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10"
                android:layout_marginStart="@dimen/size_15dp"
                android:layout_marginEnd="@dimen/size_15dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/ll_par1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.huami.lib.rainbow.ListTile
                        android:id="@+id/show_setting_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/size_64dp"
                        android:onClick="onClick"
                        app:ltv_title="@string/smart_card_setting"/>
                    <com.huami.lib.rainbow.ListTile
                        android:id="@+id/member_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/size_64dp"
                        android:onClick="onClick"
                        app:ltv_title="@string/family_manager"/>
                    <com.huami.lib.rainbow.ListTile
                        android:id="@+id/unit_set_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/size_64dp"
                        android:onClick="onClick"
                        app:itemDivider="gone"
                        app:ltv_title="@string/weight_set_unit"/>
                    <com.huami.lib.rainbow.ListTile
                        android:id="@+id/wifi_set_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/size_64dp"
                        android:onClick="onClick"
                        app:itemDivider="gone"
                        app:ltv_title="@string/weight_wifi_update"/>
                    <com.huami.lib.rainbow.ListTile
                        android:id="@+id/weight_setting_merge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/size_64dp"
                        android:onClick="onClick"
                        app:itemDivider="gone"
                        app:ltv_checked="true"
                        app:ltv_subtitle="@string/weight_settings_merge_tips"
                        app:ltv_title="@string/weight_settings_merge_title"/>
                    <com.huami.lib.rainbow.ListTile
                        android:id="@+id/body_analyse_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/size_64dp"
                        android:onClick="onClick"
                        app:itemDivider="gone"
                        app:ltv_checked="true"
                        app:ltv_subtitle="@string/weight_body_analyse_tips"
                        app:ltv_title="@string/weight_body_analyse"/>
                    <com.huami.lib.rainbow.ListTile
                        android:id="@+id/weight_pressure_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/size_64dp"
                        android:onClick="onClick"
                        app:itemDivider="gone"
                        app:ltv_checked="true"
                        app:ltv_subtitle="@string/weight_pressure_tips"
                        app:ltv_title="@string/weight_pressure"/>
                    <com.huami.lib.rainbow.ListTile
                        android:id="@+id/weight_setting_smart_weight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/size_64dp"
                        android:onClick="onClick"
                        app:itemDivider="gone"
                        app:ltv_checked="true"
                        app:ltv_subtitle="@string/small_thing_setting_tips"
                        app:ltv_title="@string/small_thing_weight"/>
                </LinearLayout>
            </FrameLayout>
            <FrameLayout
                android:background="@drawable/bg_device_setting_unit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10"
                android:layout_marginStart="@dimen/size_15dp"
                android:layout_marginEnd="@dimen/size_15dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/ll_par2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.huami.lib.rainbow.ListTile
                        android:id="@+id/weight_setting_help"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/size_64dp"
                        android:onClick="onClick"
                        app:itemDivider="gone"
                        app:ltv_title="@string/weight_setting_help"/>
                    <com.huami.lib.rainbow.ListTile
                        android:id="@+id/weight_setting_firmware_upgrade"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/size_64dp"
                        android:onClick="onClick"
                        app:ltv_title="@string/setting_update"/>
                    <com.huami.lib.rainbow.ListTile
                        android:id="@+id/weight_setting_erase_data"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/size_64dp"
                        android:onClick="onClick"
                        app:itemDivider="gone"
                        app:ltv_subtitle="@string/erase_scale_history_data_item_sub_title"
                        app:ltv_title="@string/erase_scale_history_data_item_title"/>
                    <com.huami.lib.rainbow.ListTile
                        android:id="@+id/mili_setting_faq_item"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/size_64dp"
                        app:itemDivider="gone"
                        app:itemTopBottomStyle="true"
                        app:ltv_title="@string/setting_question"/>
                    <com.huami.lib.rainbow.ListTile
                        android:id="@+id/weight_setting_firmware_version"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/size_64dp"
                        app:itemDivider="gone"
                        app:ltv_title="@string/shoes_setting_fw_version"/>
                    <com.huami.lib.rainbow.ListTile
                        android:id="@+id/mac_address"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/size_64dp"
                        app:itemDivider="gone"
                        app:ltv_title="@string/mili_setting_mac_address"/>
                    <com.huami.lib.rainbow.ListTile
                        android:id="@+id/amazfit_scale_about_device"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/size_64dp"
                        app:itemDivider="gone"
                        app:itemTopBottomStyle="true"
                        app:ltv_title="@string/about_device"/>
                    <com.huami.lib.rainbow.ListTile
                        android:id="@+id/test_layout"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/size_64dp"
                        android:onClick="onClick"
                        app:itemDivider="gone"
                        app:ltv_title="内部版本身体得分测试"/>
                    <com.huami.lib.rainbow.ListTile
                        android:id="@+id/test_algo_layout"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/size_64dp"
                        android:onClick="onClick"
                        app:itemDivider="gone"
                        app:ltv_title="内部版本算法测试"/>
                </LinearLayout>
            </FrameLayout>
            <androidx.appcompat.widget.AppCompatButton
                android:textColor="@color/s1"
                android:id="@+id/weight_setting_unbind"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="30dp"
                android:text="@string/mili_setting_unbind"
                android:onClick="onClick"
                android:layout_marginStart="@dimen/size_15dp"
                android:layout_marginEnd="@dimen/size_15dp"
                style="?attr/buttonStyleGray_48_flat"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
