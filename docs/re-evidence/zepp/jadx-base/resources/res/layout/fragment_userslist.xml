<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/dlg_empty_area_btn"
        android:background="@color/s10"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/user_choose_bg"
            android:layout_width="match_parent"
            android:layout_height="259.3984dp"
            style="@style/chooseUserFragmentPaddingStyle">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="192.7dp">
                <TextView
                    android:layout_gravity="center"
                    android:id="@+id/title_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26.7dp"
                    android:text="@string/weight_choose_user_title"
                    style="@style/userChooseTitleStyle"/>
                <HorizontalScrollView
                    android:id="@+id/scrollview"
                    android:scrollbars="none"
                    android:layout_width="match_parent"
                    android:layout_height="149.3dp">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent">
                        <GridView
                            android:id="@+id/users_list"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:listSelector="@android:color/transparent"
                            android:horizontalSpacing="26.7dp"
                            android:stretchMode="none"
                            android:numColumns="auto_fit"
                            android:paddingStart="26.7dp"
                            android:paddingEnd="26.7dp"/>
                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                style="@style/userChooseDividerStyle"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="66.7dp">
                <ImageView
                    android:id="@+id/giveup_iv"
                    android:layout_width="33.3dp"
                    android:layout_height="33.3dp"
                    android:layout_marginTop="11dp"
                    android:layout_marginBottom="4.7dp"
                    android:src="@drawable/icon_giveup"
                    android:scaleType="centerCrop"
                    style="@style/userChooseCancelIcon"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/give_up"
                    style="@style/userChooseCancelText"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
