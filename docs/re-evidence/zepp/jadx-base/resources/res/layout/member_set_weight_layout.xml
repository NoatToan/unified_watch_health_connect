<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/scale_measuring_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/click_button_text_size"
        android:textColor="@color/s5"
        android:gravity="center"
        android:id="@+id/write_weight_tv"
        android:background="@drawable/person_info_button"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="@dimen/click_button_h"
        android:layout_marginBottom="@dimen/item_padding"
        android:text="@string/choose_weight_manual"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/item_padding"
        android:layout_marginEnd="@dimen/item_padding"/>
    <TextView
        android:gravity="center"
        android:id="@+id/title_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="34.7dp"
        style="@style/memberWeightingTitleStyle"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tips_tv"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="13.3dp"
        android:layout_below="@+id/title_tv"
        style="@style/memberWeightingTitleStyle"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:layout_marginTop="85dp">
        <com.huami.lib.view.progress.ProgressView
            android:id="@+id/weight_chart"
            android:layout_width="177dp"
            android:layout_height="177dp"
            android:layout_centerInParent="true"
            app:style="cycleLoading"
            style="@style/memberWeightingLoadingStyle"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="52sp"
                android:id="@+id/weight_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                style="@style/memberWeightingValueStyle"/>
            <TextView
                android:textSize="13.3sp"
                android:id="@+id/unit_tv"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignBaseline="@+id/weight_value"
                android:layout_toEndOf="@+id/weight_value"
                style="@style/memberWeightingUnitStyle"/>
        </RelativeLayout>
        <ImageView
            android:id="@+id/iconImage"
            android:layout_width="73.3dp"
            android:layout_height="73.3dp"
            android:scaleType="centerCrop"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
</RelativeLayout>
