<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/action_bar_white"
        android:background="#f4f5f7"
        android:layout_width="match_parent"
        android:layout_height="46.3dp">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#e6000000"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/reselect_pic"
            android:layout_centerVertical="true"
            android:onClick="onBackClick"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#e6000000"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/crop_pic"
            android:layout_centerInParent="true"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#e6000000"
            android:id="@+id/title_crop_confirm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@android:string/yes"
            android:layout_centerVertical="true"
            android:onClick="onBackClick"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/action_bar_black"
        android:background="#000000"
        android:layout_width="match_parent"
        android:layout_height="46.3dp">
        <ImageView
            android:padding="6dp"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_ocr_back"
            android:scaleType="centerInside"
            android:layout_centerVertical="true"
            android:onClick="onBackClick"
            android:layout_marginStart="11dp"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#ffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/crop_pic"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <com.huami.assistant.ocr.crop.CropView
            android:id="@+id/crop_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.huami.assistant.ocr.crop.FrameOverlayView
            android:id="@+id/overlay_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.huami.assistant.ocr.camera.MaskView
            android:id="@+id/crop_mask_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <RelativeLayout
        android:id="@+id/crop_control_view"
        android:background="#000000"
        android:layout_width="match_parent"
        android:layout_height="70dp">
        <TextView
            android:textSize="14sp"
            android:textColor="#ffffff"
            android:id="@+id/cancel_button"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/retake_pic"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/camera_left_margin"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#ffffff"
            android:id="@+id/confirm_button"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/use_pic"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/camera_right_margin"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</LinearLayout>
