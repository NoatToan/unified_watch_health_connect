<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@null"
    android:layout_width="match_parent"
    android:layout_height="@dimen/size_70dp">
    <ImageView
        android:id="@+id/icon"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="@dimen/size_36dp"
        android:layout_height="@dimen/size_36dp"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/common_item_padding"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/s1"
        android:ellipsize="end"
        android:layout_gravity="center_vertical"
        android:id="@+id/tv_app_name"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/size_11dp"
        android:layout_toEndOf="@+id/icon"/>
    <ImageView
        android:id="@+id/iv_contacts"
        android:focusable="false"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="@dimen/size_16dp"
        android:layout_height="@dimen/size_16dp"
        android:src="@drawable/ic_contacts"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/size_10dp"
        android:layout_toEndOf="@+id/tv_app_name"/>
    <ImageView
        android:id="@+id/contacts_click_area"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_toStartOf="@+id/notifi_on"/>
    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/notifi_on"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/size_10dp"
        android:layout_marginEnd="@dimen/common_item_padding"
        android:layout_alignParentEnd="true"/>
    <View
        android:background="@color/s4"
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/common_item_padding"
        android:layout_marginEnd="@dimen/common_item_padding"/>
</RelativeLayout>
