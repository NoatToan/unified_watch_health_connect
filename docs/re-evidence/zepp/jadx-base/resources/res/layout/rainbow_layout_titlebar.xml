<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="50dp"
    android:animateLayoutChanges="true"
    android:paddingStart="@dimen/d2"
    android:paddingEnd="@dimen/d2">
    <ImageButton
        android:layout_gravity="center"
        android:id="@+id/rainbow_navigation_icon"
        android:background="@null"
        android:layout_width="36dp"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:paddingStart="@dimen/d2"
        android:paddingEnd="@dimen/d2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_arrow_back_20_2x"
        app:tint="?android:attr/textColorPrimary"/>
    <TextView
        android:textColor="?android:attr/textColorSecondary"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/rainbow_navigation_text"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:maxLines="1"
        android:paddingStart="@dimen/d1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guideline_l"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_default="wrap"
        style="@style/Rainbow.TextAppearance.Body3"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline_l"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_percent="0.2"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/container_l"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="end"
        app:constraint_referenced_ids="rainbow_navigation_icon,rainbow_navigation_text"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="@style/Rainbow.TextAppearance.Title3"
        android:textColor="?android:attr/textColorPrimary"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/rainbow_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:lines="1"
        app:layout_constraintBottom_toTopOf="@+id/rainbow_subtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintWidth_percent="0.6"/>
    <TextView
        android:textColor="?android:attr/textColorSecondary"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/rainbow_subtitle"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:lines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/rainbow_title"
        app:layout_constraintStart_toStartOf="@+id/rainbow_title"
        app:layout_constraintTop_toBottomOf="@+id/rainbow_title"
        app:layout_constraintWidth_percent="0.6"
        style="@style/Rainbow.TextAppearance.Body5"/>
    <ImageButton
        android:id="@+id/rainbow_collapse_icon"
        android:background="@null"
        android:visibility="gone"
        android:layout_width="36dp"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:paddingStart="@dimen/d2"
        android:paddingEnd="@dimen/d2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/container_r"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?android:attr/textColorPrimary"/>
    <ImageButton
        android:layout_gravity="center"
        android:id="@+id/rainbow_menu_icon"
        android:background="@null"
        android:visibility="gone"
        android:layout_width="36dp"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:paddingStart="@dimen/d2"
        android:paddingEnd="@dimen/d2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?android:attr/textColorPrimary"/>
    <TextView
        android:textColor="?android:attr/textColorPrimary"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/rainbow_menu_text"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:maxLines="1"
        android:paddingEnd="@dimen/d2"
        app:drawableTint="?android:attr/textColorPrimary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toEndOf="@+id/guideline_r"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_default="wrap"
        style="@style/Rainbow.TextAppearance.Body3"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline_r"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_percent="0.8"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/container_r"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:barrierDirection="start"
        app:constraint_referenced_ids="rainbow_menu_icon,rainbow_menu_text"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/rainbow_tab_layout"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/container_r"
        app:layout_constraintStart_toEndOf="@+id/container_l"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="0dp"
        app:tabGravity="fill"
        app:tabMode="auto"/>
    <ViewStub
        android:id="@+id/rainbow_view_stub"
        android:layout="@layout/rainbow_layout_titlebar_search"
        android:inflatedId="@+id/rainbow_view_stub"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
