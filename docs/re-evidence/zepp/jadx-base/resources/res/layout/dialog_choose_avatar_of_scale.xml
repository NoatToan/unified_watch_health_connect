<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/dialog_empty_area"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/user_choose_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textColor="@color/s1"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="@dimen/account_ui_size_58dp"
            android:text="@string/text_choose_avatar_of_scale"
            style="@style/DialogTitleStyle"/>
        <View
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list_avatar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp"/>
        <View
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider"
            android:layout_marginTop="20dp"/>
        <TextView
            android:textColor="@color/s1"
            android:id="@+id/btn_cancel"
            android:background="@drawable/selector_dialog_button_neutral"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="@string/cancel"
            style="@style/DialogButtonStyle"/>
    </LinearLayout>
</LinearLayout>
