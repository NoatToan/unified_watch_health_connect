<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/td_line_runing_rank_bg"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:src="@drawable/td_line_running_rank_me_bg"/>
    <LinearLayout
        android:layout_gravity="start"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:layout_marginStart="25dp">
        <TextView
            android:textSize="17sp"
            android:textColor="@color/s2"
            android:id="@+id/td_line_runing_rank_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="17sp"
            android:textColor="@color/s2"
            android:gravity="center"
            android:id="@+id/td_line_runing_rank_name"
            android:layout_width="70dp"
            android:layout_height="match_parent"
            android:singleLine="true"
            android:layout_marginStart="5dp"/>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="end"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:layout_marginEnd="10dp">
        <TextView
            android:textSize="17sp"
            android:textColor="@color/s2"
            android:gravity="center"
            android:id="@+id/td_line_runing_rank_distance"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="13.20"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/s2"
            android:gravity="center"
            android:id="@+id/td_line_runing_rank_distance_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="km"
            android:layout_marginStart="5dp"/>
    </LinearLayout>
</FrameLayout>
