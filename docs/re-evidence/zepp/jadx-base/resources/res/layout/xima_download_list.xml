<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.watch.companion.ui.view.ActionbarLayout
        android:id="@+id/actionbar_search"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ProgressBar
            android:id="@+id/album_watch_space_progress"
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:progressDrawable="@drawable/progressbar"
            style="?android:attr/progressBarStyleHorizontal"/>
        <TextView
            android:textSize="@dimen/xima_watchspace_size"
            android:textColor="@color/xima_light_graytext_color"
            android:gravity="center_horizontal"
            android:id="@+id/watch_space"
            android:background="@color/transparent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <RelativeLayout
        android:gravity="center_vertical"
        android:background="@color/white"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="10dp"
        android:paddingEnd="20dp">
        <TextView
            android:textSize="@dimen/xima_album_package_button_textsize"
            android:textColor="@color/xima_light_graytext_color"
            android:id="@+id/album_totalcount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/package_par"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true">
            <TextView
                android:textColor="@color/xima_light_graytext_color"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/xima_album_package"
                android:layout_toLeftOf="@+id/album_package"/>
            <TextView
                android:textColor="@color/xima_download_package_color"
                android:id="@+id/album_package"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toLeftOf="@+id/package_ig"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="8dp"/>
            <ImageView
                android:id="@+id/package_ig"
                android:background="@drawable/arrow_down"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"/>
        </LinearLayout>
    </RelativeLayout>
    <View
        android:background="@color/xima_listview_divider_color"
        android:layout_width="match_parent"
        android:layout_height="0.33dp"/>
    <FrameLayout
        android:background="@color/xima_watchspace_bg_color"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <ScrollView
            android:id="@+id/album_package_group_par"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.huami.watch.companion.ximalaya.RadiogroupCL
                android:id="@+id/album_package_group"
                android:paddingBottom="18dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </ScrollView>
        <ListView
            android:id="@+id/package_download_list"
            android:background="@color/white"
            android:paddingLeft="22dp"
            android:paddingRight="22dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/xima_watchspace_bg_color"
            android:dividerHeight="0.33dp"/>
    </FrameLayout>
    <View
        android:background="@color/xima_listview_divider_color"
        android:layout_width="match_parent"
        android:layout_height="0.33dp"/>
    <RelativeLayout
        android:background="@color/white"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">
        <Button
            android:textSize="@dimen/xima_detail_title_size"
            android:textColor="@color/xima_album_button_text_color"
            android:id="@+id/download_now"
            android:background="@drawable/selector_button_background"
            android:paddingTop="8.6dp"
            android:paddingBottom="8.6dp"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/xima_album_button_height"
            android:text="@string/xima_download_now"
            android:layout_centerVertical="true"
            android:paddingStart="47dp"
            android:paddingEnd="47dp"
            android:layout_alignParentStart="true"
            android:stateListAnimator="@null"/>
        <TextView
            android:textSize="@dimen/xima_detail_title_size"
            android:textColor="@color/xima_album_button_text_color"
            android:id="@+id/all_pick"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/xima_allpick"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</LinearLayout>
