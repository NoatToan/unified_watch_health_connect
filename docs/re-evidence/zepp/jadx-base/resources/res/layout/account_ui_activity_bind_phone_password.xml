<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/s36"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/account_ui_phone_login_content_margin"
    android:paddingEnd="@dimen/account_ui_phone_login_content_margin">
    <androidx.appcompat.widget.AppCompatEditText
        android:textSize="@dimen/account_ui_register_phone_password_text_size"
        android:typeface="monospace"
        android:textColor="@color/s1"
        android:textColorHint="@color/s3"
        android:gravity="start|center_vertical"
        android:id="@+id/input_password_text"
        android:background="@drawable/account_ui_account_input_text_bg"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="46.7dp"
        android:hint="@string/account_ui_account_input_login_password"
        android:inputType="textPassword"
        android:textAlignment="viewStart"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="@dimen/account_ui_size_12sp"
        android:textColor="@color/s2"
        android:id="@+id/set_password_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/account_ui_size_12dp"
        android:layout_marginBottom="@dimen/account_ui_size_12dp"
        android:text="@string/account_ui_account_password_format_limit_tip"/>
    <androidx.appcompat.widget.AppCompatEditText
        android:textSize="@dimen/account_ui_register_phone_password_text_size"
        android:typeface="monospace"
        android:textColor="@color/s1"
        android:textColorHint="@color/s3"
        android:gravity="start|center_vertical"
        android:id="@+id/input_password_text_again"
        android:background="@drawable/account_ui_account_input_text_bg"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:hint="@string/account_ui_account_input_login_password_again"
        android:inputType="textPassword"
        android:textAlignment="viewStart"/>
    <TextView
        android:textSize="@dimen/account_ui_login_btn_text_size"
        android:textColor="@color/account_ui_select_alive_btn_txt_color"
        android:gravity="center"
        android:id="@+id/confirm_btn"
        android:background="@drawable/account_ui_btn_bg_login"
        android:layout_width="match_parent"
        android:layout_height="@dimen/account_ui_click_button_h"
        android:layout_marginTop="60dp"
        android:text="@string/account_ui_btn_confirm"/>
</LinearLayout>
