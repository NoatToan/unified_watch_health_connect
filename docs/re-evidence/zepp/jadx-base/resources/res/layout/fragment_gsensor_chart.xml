<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ll_root"
    android:background="#ff1a1d24"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.lib.rainbow.titlebar.RainbowTitleBar
        android:id="@+id/tv_title_bar"
        android:background="@color/s14"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/data_collect"/>
    <View
        android:background="@color/divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_gsensor"
        android:background="#1e2128"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="@dimen/gsensor_container_height">
        <RelativeLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/title_bar_gsensor"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/imv_gesnsor_normal"
                android:paddingTop="12.3dp"
                android:paddingBottom="12.3dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/title_back_icon"
                android:paddingStart="13.3dp"
                android:paddingEnd="13.3dp"/>
            <TextView
                android:textSize="14.7sp"
                android:textColor="@color/white90"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/data_collect"
                android:layout_centerInParent="true"
                android:layout_marginStart="5.7dp"/>
        </RelativeLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_gsensor_bar"
            android:paddingTop="13.3dp"
            android:paddingBottom="6.3dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="21.7dp"
            android:paddingEnd="16.7dp">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_accelerate_chart"/>
            <TextView
                android:textSize="12.7sp"
                android:textColor="@color/white90"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/accelerate"
                android:layout_weight="1"
                android:layout_marginStart="5.7dp"/>
            <ImageView
                android:id="@+id/imv_fullscreen_gsensor"
                android:background="@drawable/btn_fullscreen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:button="@null"
                android:layout_marginEnd="23.3dp"/>
            <CheckBox
                android:id="@+id/cbx_show_hide_gsensor"
                android:background="@drawable/checked_show_hide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:button="@null"/>
            <TextView
                android:textSize="14.7sp"
                android:textColor="@color/white100"
                android:id="@+id/tx_lable_x"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sensor_lable_x"
                android:drawablePadding="3.3dp"
                android:drawableStart="@drawable/line_lable_x"/>
            <TextView
                android:textSize="14.7sp"
                android:textColor="@color/white100"
                android:id="@+id/tx_lable_y"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sensor_lable_y"
                android:drawablePadding="3.3dp"
                android:alpha="0.5"
                android:drawableStart="@drawable/line_lable_y"
                android:layout_marginStart="18.7dp"/>
            <TextView
                android:textSize="14.7sp"
                android:textColor="@color/white100"
                android:id="@+id/tx_lable_z"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sensor_lable_z"
                android:drawablePadding="3.3dp"
                android:alpha="0.5"
                android:drawableStart="@drawable/line_lable_z"
                android:layout_marginStart="18.7dp"/>
        </LinearLayout>
        <com.xiaomi.hm.health.lab.view.BehaviorTagsLineChartView
            android:id="@+id/hlcv_gsensor"
            android:paddingTop="11dp"
            android:paddingBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="21.7dp"
            android:paddingEnd="16.7dp"/>
    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="13.3dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_ppgsensor"
        android:background="#1e2128"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ppgsensor_container_height">
        <RelativeLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/title_bar_ppgsensor"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/imv_ppgesnsor_normal"
                android:paddingTop="12.3dp"
                android:paddingBottom="12.3dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/title_back_icon"
                android:paddingStart="13.3dp"
                android:paddingEnd="13.3dp"/>
            <TextView
                android:textSize="14.7sp"
                android:textColor="@color/white90"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/data_collect"
                android:layout_centerInParent="true"
                android:layout_marginStart="5.7dp"/>
        </RelativeLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_ppgsensor_bar"
            android:paddingTop="13.3dp"
            android:paddingBottom="6.3dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="21.7dp"
            android:paddingEnd="16.7dp">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_heart_chart"/>
            <TextView
                android:textSize="12.7sp"
                android:textColor="@color/white90"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/heart_rate"
                android:layout_weight="1"
                android:layout_marginStart="5.7dp"/>
            <ImageView
                android:id="@+id/imv_fullscreen_ppgsensor"
                android:background="@drawable/btn_fullscreen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:button="@null"
                android:layout_marginEnd="23.3dp"/>
            <CheckBox
                android:id="@+id/cbx_show_hide_ppgsensor"
                android:background="@drawable/checked_show_hide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:button="@null"/>
        </LinearLayout>
        <com.xiaomi.hm.health.lab.view.BehaviorTagsLineChartView
            android:id="@+id/hlcv_ppgsensor"
            android:paddingTop="11dp"
            android:paddingBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="21.7dp"
            android:paddingEnd="16.7dp"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:scrollbarStyle="insideOverlay"
        android:id="@+id/rcv_nmea_log"
        android:background="@drawable/nmea_round_rect_bg"
        android:padding="15dp"
        android:visibility="gone"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="355dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
</LinearLayout>
