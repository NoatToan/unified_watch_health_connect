<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="#ffffff"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:id="@+id/union_card_main"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:cardCornerRadius="16dp"
        app:cardPreventCornerOverlap="false"
        app:layout_constraintDimensionRatio="320:180"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/union_card_img"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/wl_watch_bank_card_default"
            android:scaleType="fitXY"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#ffffff"
            android:layout_gravity="start|bottom"
            android:id="@+id/union_card_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16.7dp"
            android:shadowColor="#66000000"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:layout_marginStart="20dp"/>
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:layout_gravity="end|top"
            android:id="@+id/union_card_state"
            android:background="@drawable/wl_watch_bank_semicircle_shape_gray"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginEnd="12dp"/>
    </androidx.cardview.widget.CardView>
    <LinearLayout
        android:orientation="vertical"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@+id/union_card_main">
        <View
            android:background="#14000000"
            android:layout_width="match_parent"
            android:layout_height="0.3dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"/>
        <RelativeLayout
            android:background="?attr/selectableItemBackground"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#e6000000"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wl_union_card_no"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"/>
            <TextView
                android:textSize="12sp"
                android:textStyle="normal"
                android:textColor="#80000000"
                android:id="@+id/union_card_no"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:fontFamily="sans-serif"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <View
            android:background="#14000000"
            android:layout_width="match_parent"
            android:layout_height="0.3dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"/>
        <RelativeLayout
            android:id="@+id/faq_area"
            android:background="?attr/selectableItemBackground"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#e6000000"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wl_bank_faq"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"/>
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/wl_watch_bank_arrow_right"
                android:scaleType="centerInside"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <View
            android:background="#14000000"
            android:layout_width="match_parent"
            android:layout_height="0.3dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"/>
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#e6000000"
            android:gravity="center"
            android:id="@+id/union_card_active"
            android:background="?attr/selectableItemBackground"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/wl_active_bank_card"/>
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@drawable/wl_watch_bank_delete_text_color_selector"
            android:gravity="center"
            android:id="@+id/union_card_delete"
            android:background="?attr/selectableItemBackground"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/wl_delete_card"/>
        <View
            android:background="#14000000"
            android:layout_width="match_parent"
            android:layout_height="0.3dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
