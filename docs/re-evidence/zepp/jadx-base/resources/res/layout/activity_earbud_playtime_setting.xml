<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.lib.rainbow.titlebar.RainbowTitleBar
        android:id="@+id/tv_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menuIcon="@drawable/ic_edit_20"
        app:navigationIcon="@drawable/ic_arrow_back_20_2x"
        app:title="@string/earbud_play_time"/>
    <FrameLayout
        android:id="@+id/status_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/img_earbud_play_time"
        android:layout_marginStart="25dp"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/s2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/earbud_playtime_setting_tip"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"/>
    <com.huami.lib.rainbow.ListTile
        android:id="@+id/play_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        app:ltv_title="@string/earbud_play_time"
        app:ltv_trailing="@drawable/ic_arrow_forward_20_2x"/>
    <com.huami.lib.rainbow.ListTile
        android:id="@+id/smart_play"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:ltv_checked="true"
        app:ltv_subtitle="@string/earbud_smart_play_tip"
        app:ltv_title="@string/earbud_smart_play"/>
</LinearLayout>
