<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/s36"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/fw_info_fw_top"
        android:background="@color/s10"
        android:layout_width="match_parent"
        android:layout_height="180dp">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:src="@drawable/fw_info_gt2"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/s2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:text="@string/mili_setting_fw_upgrade"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <FrameLayout
        android:id="@+id/fw_tips_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/fw_info_fw_top"/>
    <RelativeLayout
        android:id="@+id/fw_info_fw_lt"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="40dp"
        android:layout_below="@+id/fw_tips_container"
        android:paddingStart="35dp"
        android:paddingEnd="35dp">
        <View
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/s1"
            android:id="@+id/fw_info_fw_ver"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mili_fw_info_fw"
            android:layout_centerVertical="true"
            android:layout_marginEnd="170dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/p3"
            android:id="@+id/fw_info_fw_st"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mili_fw_info_upgrad_not"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"/>
        <View
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/fw_info_base_res_id"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_below="@+id/fw_info_fw_lt"
        android:paddingStart="35dp"
        android:paddingEnd="35dp">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/s1"
            android:id="@+id/fw_info_base_res_ver"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mili_fw_info_base_res"
            android:layout_centerVertical="true"
            android:layout_marginEnd="170dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/p3"
            android:id="@+id/fw_info_base_res_st"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mili_fw_info_upgrad_not"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"/>
        <View
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/fw_info_res_id"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_below="@+id/fw_info_base_res_id"
        android:paddingStart="35dp"
        android:paddingEnd="35dp">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/s1"
            android:id="@+id/fw_info_res_ver"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mili_fw_info_res"
            android:layout_centerVertical="true"
            android:layout_marginEnd="170dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/p3"
            android:id="@+id/fw_info_res_st"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mili_fw_info_upgrad_not"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"/>
        <View
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/fw_info_font_id"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_below="@+id/fw_info_res_id"
        android:paddingStart="35dp"
        android:paddingEnd="35dp">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/s1"
            android:id="@+id/fw_info_font_ver"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mili_fw_info_font"
            android:layout_centerVertical="true"
            android:layout_marginEnd="170dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/p3"
            android:id="@+id/fw_info_font_ver_st"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mili_fw_info_upgrad_not"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"/>
        <View
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/fw_info_gps_id"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_below="@+id/fw_info_font_id"
        android:paddingStart="35dp"
        android:paddingEnd="35dp">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/s1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mili_fw_info_gps"
            android:layout_centerVertical="true"
            android:layout_marginEnd="170dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/p3"
            android:id="@+id/fw_info_gps_st"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mili_fw_info_upgrad_not"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"/>
        <View
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
    <Button
        android:textSize="14sp"
        android:id="@+id/mili_fw_info_upgrade_now_bt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:text="@string/update_now"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:onClick="onClick"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        style="?attr/buttonStyleGray_38_outline"/>
    <TextView
        android:textSize="@dimen/size_14sp"
        android:textColor="@color/s15"
        android:gravity="center"
        android:id="@+id/fw_upgrade_log"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_29dp"
        android:layout_marginBottom="@dimen/size_24dp"
        android:text="@string/fw_upgrade_log"
        android:layout_above="@+id/mili_fw_info_upgrade_now_bt"/>
    <View
        android:id="@+id/fw_upgrade_mask_view"
        android:background="@color/s38"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/fw_tips_container"
        android:alpha="0.6"/>
</RelativeLayout>
