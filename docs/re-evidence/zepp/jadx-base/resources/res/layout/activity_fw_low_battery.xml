<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/s36"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="20sp"
        android:textColor="@color/s2"
        android:gravity="center"
        android:id="@+id/low_battery_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="98dp"
        android:text="@string/mili_low_battery_title"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/s3"
        android:gravity="center"
        android:id="@+id/low_battery_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:text="@string/mili_low_battery_tips"
        android:layout_below="@+id/low_battery_title"
        android:layout_centerHorizontal="true"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="112dp"
        android:src="@drawable/img_low_power"
        android:layout_below="@+id/low_battery_tips"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:id="@+id/low_battery_ok_btn"
        android:text="@string/gotit"
        style="@style/BottomTextStyle"/>
</RelativeLayout>
