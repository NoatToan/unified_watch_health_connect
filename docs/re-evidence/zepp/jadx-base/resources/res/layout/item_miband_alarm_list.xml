<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@color/s38"
    android:layout_width="match_parent"
    android:layout_height="58dp"
    android:minHeight="58dp"
    android:paddingStart="@dimen/common_item_padding"
    android:paddingEnd="@dimen/common_item_padding">
    <FrameLayout
        android:id="@+id/delete_layout"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="11.3sp"
        android:layout_centerVertical="true"
        android:layout_marginEnd="11.3dp">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/alarm_delete"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/smart_alarm_delete"/>
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/loading_parent"
            android:background="@drawable/shape_loading_origin_bg"
            android:padding="2dp"
            android:visibility="gone"
            android:layout_width="18dp"
            android:layout_height="18dp">
            <com.huami.lib.view.widget.LoadingView
                android:layout_gravity="center"
                android:id="@+id/loading_view"
                android:layout_width="15dp"
                android:layout_height="15dp"
                app:stroke="1.5dp"/>
        </FrameLayout>
    </FrameLayout>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="19sp"
        android:textColor="@color/s1"
        android:id="@+id/miband_alarm_time_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:fontFamily="km"
        android:layout_toEndOf="@+id/delete_layout"/>
    <TextView
        android:textSize="7.3sp"
        android:textColor="@color/s2"
        android:layout_gravity="center"
        android:id="@+id/miband_alarm_ampm_text"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="4.3dp"
        android:layout_toEndOf="@+id/miband_alarm_time_text"/>
    <View
        android:id="@+id/divider"
        android:background="@color/s4"
        android:layout_width="@dimen/divider"
        android:layout_height="26.7dp"
        android:layout_centerVertical="true"
        android:layout_marginStart="15dp"
        android:layout_toEndOf="@+id/miband_alarm_ampm_text"/>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="11dp"
        android:layout_toEndOf="@+id/divider">
        <TextView
            android:textSize="10sp"
            android:textColor="@color/s2"
            android:gravity="center"
            android:id="@+id/miband_alarm_repeat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/s2"
            android:gravity="center"
            android:id="@+id/miband_alarm_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <androidx.appcompat.widget.SwitchCompat
        android:layout_gravity="center"
        android:id="@+id/miband_alarm_switch"
        android:focusable="false"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"
        style="@style/Rainbow.Widget.Switch"/>
    <View
        android:background="@color/s4"
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
