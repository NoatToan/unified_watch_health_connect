<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/sleep_main_bg"
    android:padding="@dimen/size_15dp"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/size_15dp"
    android:layout_marginStart="@dimen/size_15dp"
    android:layout_marginEnd="@dimen/size_15dp">
    <TextView
        android:textSize="@dimen/slp_size_18sp"
        android:textColor="@color/s1"
        android:id="@+id/yearTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <RelativeLayout
        android:id="@+id/chartRL"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/yearTv">
        <com.huami.sleep.view.SleepPosCircleView
            android:id="@+id/riskChart"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_marginTop="36dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14sp"
            android:textColor="@color/s1"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:id="@+id/normalDayTv"
            android:paddingTop="@dimen/size_15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/risk_level_medium"
            android:drawablePadding="4dp"
            android:drawableStart="@drawable/slp_risk_level_normal"
            android:layout_marginStart="25dp"
            android:layout_marginEnd="10dp"
            android:layout_toEndOf="@+id/riskChart"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14sp"
            android:textColor="@color/s1"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:id="@+id/lowDayTv"
            android:paddingTop="@dimen/size_15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/risk_level_low"
            android:drawablePadding="4dp"
            android:layout_below="@+id/normalDayTv"
            android:drawableStart="@drawable/slp_risk_level_low"
            android:layout_marginStart="25dp"
            android:layout_marginEnd="10dp"
            android:layout_toEndOf="@+id/riskChart"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14sp"
            android:textColor="@color/s1"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:id="@+id/mediumDayTv"
            android:paddingTop="@dimen/size_15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/risk_level_medium"
            android:drawablePadding="4dp"
            android:layout_below="@+id/lowDayTv"
            android:drawableStart="@drawable/slp_risk_level_medium"
            android:layout_marginStart="25dp"
            android:layout_marginEnd="10dp"
            android:layout_toEndOf="@+id/riskChart"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14sp"
            android:textColor="@color/s1"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:id="@+id/highDayTv"
            android:paddingTop="@dimen/size_15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/risk_level_high"
            android:drawablePadding="4dp"
            android:layout_below="@+id/mediumDayTv"
            android:drawableStart="@drawable/slp_risk_level_high"
            android:layout_marginStart="25dp"
            android:layout_marginEnd="10dp"
            android:layout_toEndOf="@+id/riskChart"/>
    </RelativeLayout>
    <TextView
        android:textSize="@dimen/slp_size_14sp"
        android:textColor="@color/s2"
        android:gravity="center"
        android:id="@+id/emptyTv"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:text="@string/health_data_no_data"
        android:layout_below="@+id/yearTv"/>
</RelativeLayout>
