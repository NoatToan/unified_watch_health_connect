<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/trans"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/sls_dialog_empty_area"/>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/sls_dialog_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/sls_black_70"
            android:gravity="center"
            android:id="@+id/updateTv"
            android:background="@color/trans"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="@string/sls_group_rename"/>
        <EditText
            android:textSize="12sp"
            android:textColor="@color/sls_black_60"
            android:layout_gravity="center_vertical"
            android:id="@+id/info_nick_name"
            android:background="@drawable/sls_bg_round"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="34dp"
            android:hint="@string/sls_group_rename"
            android:maxLines="1"
            android:maxLength="20"
            android:textDirection="locale"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"/>
        <View
            android:background="@color/sls_black_20_percent"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <LinearLayout
            android:orientation="horizontal"
            android:background="@color/trans"
            android:layout_width="match_parent"
            android:layout_height="52dp">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/sls_black_70"
                android:gravity="center"
                android:id="@+id/nick_name_btn_cancel"
                android:background="@drawable/sls_btn_click_bg_round_dialog_bottom_left"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/sls_cancel"
                android:layout_weight="1"/>
            <View
                android:background="@color/sls_black_20_percent"
                android:layout_width="1px"
                android:layout_height="match_parent"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@drawable/sls_enable_text_color"
                android:gravity="center"
                android:id="@+id/nick_name_btn_save"
                android:background="@drawable/sls_btn_click_bg_round_dialog_bottom_right"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/sls_save"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
