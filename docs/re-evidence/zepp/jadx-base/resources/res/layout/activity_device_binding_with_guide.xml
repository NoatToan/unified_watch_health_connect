<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/bg_main"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="16sp"
        android:textColor="#e6000000"
        android:gravity="center"
        android:id="@+id/title_binding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="@string/binding_title"
        android:lineSpacingExtra="0sp"/>
    <TextView
        android:textSize="20sp"
        android:textColor="#e6000000"
        android:gravity="center"
        android:id="@+id/device_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/device_name_xihu_disney_tip_title"
        android:lineSpacingExtra="0sp"/>
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/bind_view_pager"
        android:layout_width="match_parent"
        android:layout_height="340dp"
        android:layout_marginTop="10dp"/>
    <com.huami.watch.companion.ui.view.CircleIndicator
        android:id="@+id/bind_indicator"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        app:ci_background="#e0e2e5"
        app:ci_gravity="center"
        app:ci_margin="5dp"
        app:ci_mode="outside"
        app:ci_radius="2dp"
        app:ci_selected_background="#ffd22d00"/>
    <LinearLayout
        android:gravity="bottom"
        android:orientation="vertical"
        android:background="#ffffff"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="12sp"
            android:textColor="#80000000"
            android:gravity="center"
            android:id="@+id/tip_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/binding_content"
            android:lineSpacingExtra="12sp"/>
        <com.huami.watch.companion.ui.view.RotateProgressView
            android:layout_gravity="center"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="26dp"/>
    </LinearLayout>
</LinearLayout>
