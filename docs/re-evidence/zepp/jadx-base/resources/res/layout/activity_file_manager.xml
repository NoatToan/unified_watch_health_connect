<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/file_manager_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/actionbar"
                android:background="@color/s38"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RelativeLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="44dp">
                    <ImageView
                        android:padding="5dp"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:src="@drawable/ic_arrow_back_20_2x"
                        android:layout_centerVertical="true"
                        android:onClick="onBackPressedInternal"
                        android:layout_marginStart="10dp"
                        android:layout_alignParentStart="true"
                        app:tint="?android:attr/textColorPrimary"/>
                    <TextView
                        android:textSize="17sp"
                        android:textColor="@color/s1"
                        android:id="@+id/textview_title"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerHorizontal="true"
                        android:layout_centerVertical="true"/>
                    <FrameLayout
                        android:id="@+id/btn_trans_list_container"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="10dp"
                        android:layout_alignParentEnd="true">
                        <ImageView
                            android:id="@+id/btn_trans_list"
                            android:padding="5dp"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/ftp_icon_transport_list_button"
                            android:onClick="onTransferListBtnClick"
                            app:tint="@color/ftp_icon_transport_list_button_tint"/>
                        <View
                            android:layout_gravity="end|top"
                            android:id="@+id/ftp_new_point"
                            android:background="@drawable/ftp_export_red_point"
                            android:visibility="invisible"
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:layout_margin="3dp"
                            android:backgroundTint="@color/p3"/>
                    </FrameLayout>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/s1"
                        android:gravity="center"
                        android:id="@+id/btn_clear_all"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:text="@string/file_manager_clear_all"
                        android:layout_centerVertical="true"
                        android:onClick="onClearAllBtnClick"
                        android:layout_marginEnd="20dp"
                        android:layout_alignParentEnd="true"/>
                </RelativeLayout>
            </LinearLayout>
            <fragment
                android:name="com.huami.watch.wififtp.FileManagerFragment"
                android:id="@+id/fg_file_explorer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <fragment
                android:name="com.huami.watch.wififtp.FtpTransferListFragment"
                android:id="@+id/fg_file_transfer_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
