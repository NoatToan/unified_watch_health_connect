<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clickable="true"
    android:layout_width="76.7dp"
    android:layout_height="76.7dp"
    android:layout_marginStart="9dp">
    <ImageView
        android:id="@+id/default_watermark"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <RelativeLayout
        android:id="@+id/default_watermark_buttom_layout"
        android:background="#0000"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/default_watermark_thumbnail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"/>
        <ImageView
            android:id="@+id/hot_watermark_icon"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/watermark_hot"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/new_watermark_buttom_layout"
        android:background="#0000"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/new_watermark_thumbnail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"/>
        <ImageView
            android:id="@+id/new_watermark_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/watermark_new"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true"/>
        <com.huami.android.design.dialog.loading.LoadingView
            android:id="@+id/loading_view"
            android:visibility="gone"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_centerInParent="true"
            app:lv_stroke="1.5dp"/>
        <ImageView
            android:id="@+id/new_watermark_download_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:src="@drawable/watermark_new_download"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="2dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</FrameLayout>
