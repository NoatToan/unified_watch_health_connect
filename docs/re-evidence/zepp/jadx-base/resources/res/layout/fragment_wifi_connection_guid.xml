<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/s10"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:orientation="vertical"
        android:id="@+id/toolbar"
        android:background="@color/s38"
        android:layout_width="match_parent"
        android:layout_height="44dp">
        <ImageView
            android:id="@+id/iv_back"
            android:padding="5dp"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/ic_arrow_back_20_2x"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:layout_alignParentStart="true"
            app:tint="?android:attr/textColorPrimary"/>
        <TextView
            android:textSize="17sp"
            android:textColor="@color/s1"
            android:id="@+id/tv_title"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wifi_connection_guide_title"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/s2"
            android:id="@+id/tv_guide_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="@string/wifi_connection_guide_content"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"/>
        <RelativeLayout
            android:gravity="center_vertical"
            android:background="@drawable/bg_wifi_sample"
            android:layout_width="match_parent"
            android:layout_height="63dp"
            android:layout_marginTop="36dp"
            android:layout_below="@+id/tv_guide_content"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/s1"
                android:id="@+id/tv_wifi_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_wifi"
                android:layout_marginEnd="15dp"
                android:layout_alignParentEnd="true"
                app:tint="@color/s1"/>
        </RelativeLayout>
        <Button
            android:id="@+id/tv_go_wifi_setting"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="87dp"
            android:text="@string/go_to_wifi_setting_btn_txt"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"
            style="@style/Rainbow.Widget.Button.48"/>
    </RelativeLayout>
</LinearLayout>
