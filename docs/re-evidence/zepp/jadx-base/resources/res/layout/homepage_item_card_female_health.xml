<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_fragment"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="185dp">
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/female_health_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/homepage_item_card_female_health"
        android:layout_marginStart="15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Rainbow.TextAppearance.Body3"/>
    <com.huami.module.homepage.cards.business.femalehealth.FemaleCircleListView
        android:id="@+id/female_health_list"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/s2"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/female_health_content"
        android:paddingLeft="15dp"
        android:paddingRight="15dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:layout_marginBottom="12dp"
        android:maxLines="2"
        app:layout_constraintBottom_toTopOf="@+id/female_health_list"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="20sp"
        android:textColor="@color/s1"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/female_health_level"
        android:paddingLeft="15dp"
        android:paddingRight="15dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="9dp"
        android:maxLines="2"
        app:layout_constraintBottom_toTopOf="@+id/female_health_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/female_health_title"/>
    <View
        android:id="@+id/female_health_none"
        android:background="@drawable/homepage_female_health_none_bg"
        android:layout_width="wrap_content"
        android:layout_height="72dp"
        android:layout_marginBottom="46dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <Button
        android:id="@+id/female_health_button"
        android:visibility="visible"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="44dp"
        android:text="@string/homepage_female_health_go_to_record"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="?attr/buttonStyleRed_38_outline"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/female_health_none_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:text="@string/homepage_female_health_none_data"
        app:layout_constraintBottom_toTopOf="@+id/female_health_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/homepage_female_health_none_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="female_health_none,female_health_button,female_health_none_content"/>
</androidx.constraintlayout.widget.ConstraintLayout>
