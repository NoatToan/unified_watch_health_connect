<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingBottom="100dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/tv_training_analysis_status_over"
        android:text="@string/phn_training_analysis_status_over"
        style="@style/phn_ui.NounExplain.NounTitle"/>
    <TextView
        android:id="@+id/tv_training_analysis_status_over_desc"
        android:text="@string/phn_training_analysis_status_over_desc"
        style="@style/phn_ui.NounExplain.NounContent"/>
    <TextView
        android:id="@+id/tv_training_analysis_status_optimal"
        android:text="@string/phn_training_analysis_status_optimal"
        style="@style/phn_ui.NounExplain.NounTitle"/>
    <TextView
        android:id="@+id/tv_training_analysis_status_optimal_desc"
        android:text="@string/phn_training_analysis_status_optimal_desc"
        style="@style/phn_ui.NounExplain.NounContent"/>
    <TextView
        android:id="@+id/tv_training_analysis_status_balance"
        android:text="@string/phn_training_analysis_status_balance"
        style="@style/phn_ui.NounExplain.NounTitle"/>
    <TextView
        android:id="@+id/tv_training_analysis_status_balance_desc"
        android:text="@string/phn_training_analysis_status_balance_desc"
        style="@style/phn_ui.NounExplain.NounContent"/>
    <TextView
        android:id="@+id/tv_training_analysis_status_abundant"
        android:text="@string/phn_training_analysis_status_abundant"
        style="@style/phn_ui.NounExplain.NounTitle"/>
    <TextView
        android:id="@+id/tv_training_analysis_status_abundant_desc"
        android:text="@string/phn_training_analysis_status_abundant_desc_modify"
        style="@style/phn_ui.NounExplain.NounContent"/>
    <TextView
        android:id="@+id/tv_training_analysis_status_rest"
        android:text="@string/phn_training_analysis_status_rest_modify"
        style="@style/phn_ui.NounExplain.NounTitle"/>
    <TextView
        android:id="@+id/tv_training_analysis_status_rest_desc"
        android:text="@string/phn_training_analysis_status_rest_desc_modify"
        style="@style/phn_ui.NounExplain.NounContent"/>
</LinearLayout>
