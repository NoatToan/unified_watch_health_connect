<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:weight="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.xiaomi.hm.health.bodyfat.view.VerticalScrollView
        android:background="@color/s36"
        android:paddingBottom="66dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraint_layout"
            android:background="@color/s36"
            android:paddingBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/weight_value_ll_picker"
                android:background="@drawable/scale_detail_header_bg"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                weight:layout_constraintEnd_toEndOf="parent"
                weight:layout_constraintStart_toStartOf="parent"
                weight:layout_constraintTop_toTopOf="parent">
                <RelativeLayout
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/weight_rl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="38dp">
                    <com.huami.widget.typeface.TypefaceTextView
                        android:id="@+id/one_foot_value_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/empty_value"
                        style="@style/weightDetailValueStyle"/>
                    <TextView
                        android:id="@+id/unitTV"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/unit_sec"
                        android:layout_alignBaseline="@+id/one_foot_value_tv"
                        android:layout_marginStart="2dp"
                        android:layout_toEndOf="@+id/one_foot_value_tv"
                        style="@style/weightDetailUnitStyle"/>
                </RelativeLayout>
                <RelativeLayout
                    android:gravity="center"
                    android:id="@+id/chart_container"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:layout_marginTop="20dp"/>
            </LinearLayout>
            <com.xiaomi.hm.health.bodyfat.view.WeightLoadingStatus
                android:id="@+id/loading_status"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                weight:layout_constraintEnd_toEndOf="parent"
                weight:layout_constraintStart_toStartOf="parent"
                weight:layout_constraintTop_toTopOf="parent"/>
            <RelativeLayout
                android:id="@+id/user_picker_ll"
                android:background="@color/scale_detail_bg_end_color"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                weight:layout_constraintEnd_toEndOf="parent"
                weight:layout_constraintStart_toStartOf="parent"
                weight:layout_constraintTop_toBottomOf="@+id/weight_value_ll_picker">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="10dp"
                    android:src="@drawable/ic_triangle"
                    android:layout_centerHorizontal="true"/>
                <com.xiaomi.hm.health.bodyfat.view.WeightUserQuickPicker
                    android:id="@+id/user_picker"
                    android:background="@color/s38"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/weight_user_picker_content_height"
                    android:layout_marginTop="10dp"/>
            </RelativeLayout>
            <View
                android:id="@+id/line_split2"
                android:background="@color/s5"
                android:layout_width="0dp"
                android:layout_height="@dimen/divider"
                android:layout_below="@+id/user_picker_ll"
                weight:layout_constraintEnd_toEndOf="parent"
                weight:layout_constraintStart_toStartOf="parent"
                weight:layout_constraintTop_toBottomOf="@+id/user_picker_ll"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/weight_body_type_ll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                weight:layout_constraintEnd_toEndOf="parent"
                weight:layout_constraintStart_toStartOf="parent"
                weight:layout_constraintTop_toBottomOf="@+id/line_split2">
                <RelativeLayout
                    android:id="@+id/rl_no_score"
                    android:background="@color/s38"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="156dp">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/s3"
                        android:id="@+id/tx_no_score"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/no_bmi_for_height"
                        android:drawablePadding="3dp"
                        android:layout_centerInParent="true"/>
                </RelativeLayout>
                <RelativeLayout
                    android:orientation="vertical"
                    android:id="@+id/rl_has_score"
                    android:background="@color/s38"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="14sp"
                        android:id="@+id/tx_score_level"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="23dp"
                        android:text="@string/one_foot_score_level"
                        style="@style/oneFootDetailLevelTitleStyle"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="31dp"
                        android:layout_below="@+id/tx_score_level"
                        android:layout_marginStart="18dp"
                        android:layout_marginEnd="18dp">
                        <com.huami.view.weightfigure.WeightFigureView
                            android:layout_gravity="center"
                            android:id="@+id/one_foot_figure_view"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            weight:type="unmoveable"/>
                    </LinearLayout>
                </RelativeLayout>
            </LinearLayout>
            <include
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                weight:layout_constraintEnd_toEndOf="parent"
                weight:layout_constraintStart_toStartOf="parent"
                weight:layout_constraintTop_toBottomOf="@+id/weight_body_type_ll"
                layout="@layout/card_status_introduces"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.xiaomi.hm.health.bodyfat.view.VerticalScrollView>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/ll_bottom"
        android:background="@color/s38"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true">
        <RelativeLayout
            android:id="@+id/measure_ll"
            android:background="@color/s38"
            android:layout_width="wrap_content"
            android:layout_height="66dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">
            <ImageView
                android:id="@+id/measure_iv"
                android:layout_width="33.3dp"
                android:layout_height="33.3dp"
                android:layout_marginTop="11dp"
                android:src="@drawable/weight_detail_zoomout"
                android:scaleType="centerInside"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="9.3sp"
                android:textColor="@color/s2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4.7dp"
                android:text="@string/measure"
                android:layout_below="@+id/measure_iv"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/guest_ll"
            android:background="@color/s38"
            android:layout_width="wrap_content"
            android:layout_height="66dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">
            <ImageView
                android:id="@+id/guest_iv"
                android:layout_width="33.3dp"
                android:layout_height="33.3dp"
                android:layout_marginTop="11dp"
                android:src="@drawable/guest_selector"
                android:scaleType="centerInside"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="9.3sp"
                android:textColor="@color/s2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4.7dp"
                android:text="@string/guest"
                android:layout_below="@+id/guest_iv"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/delete_ll"
            android:background="@color/s38"
            android:layout_width="wrap_content"
            android:layout_height="66dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">
            <ImageView
                android:id="@+id/delete_iv"
                android:layout_width="33.3dp"
                android:layout_height="33.3dp"
                android:layout_marginTop="11dp"
                android:src="@drawable/delete_selector"
                android:scaleType="centerInside"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="9.3sp"
                android:textColor="@color/s2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4.7dp"
                android:text="@string/delete_weight"
                android:layout_below="@+id/delete_iv"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
    </LinearLayout>
</RelativeLayout>
