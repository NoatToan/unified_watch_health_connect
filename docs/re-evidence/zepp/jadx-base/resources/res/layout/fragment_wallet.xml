<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/s36"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.watch.companion.ui.view.NfcItemView
        android:id="@+id/eidItem"
        android:background="@drawable/wl_eid_enter_bg"
        android:visibility="gone"
        app:nfc_icon="@drawable/wl_eid_enter_icon"
        app:nfc_info="@string/eid_card_org_message"
        app:nfc_title="@string/nfc_eid_card_title"
        style="@style/NfcItemStyle"/>
    <com.xiaomi.hm.health.nfc.NfcItemView
        android:id="@+id/busItem"
        android:background="@drawable/wl_bus_enter_bg"
        android:visibility="gone"
        app:nfc_icon="@drawable/wl_bus_enter_icon"
        app:nfc_title="@string/bus_card_pay_v2"
        style="@style/NfcItemStyle"/>
    <com.xiaomi.hm.health.nfc.NfcItemView
        android:id="@+id/doorItem"
        android:background="@drawable/wl_door_enter_bg"
        android:visibility="gone"
        app:nfc_icon="@drawable/wl_door_enter_icon"
        app:nfc_title="@string/access_door_card_simulation"
        style="@style/NfcItemStyle"/>
    <com.xiaomi.hm.health.nfc.NfcItemView
        android:id="@+id/bankItem"
        android:background="@drawable/wl_bank_enter_bg"
        android:visibility="gone"
        app:nfc_icon="@drawable/wl_bank_enter_icon"
        app:nfc_title="@string/up_mi_pay_title"
        style="@style/NfcItemStyle"/>
    <com.xiaomi.hm.health.nfc.NfcItemView
        android:id="@+id/item_master_card"
        android:background="@drawable/wl_bank_enter_bg"
        android:visibility="gone"
        app:nfc_icon="@drawable/wl_bank_enter_icon"
        app:nfc_title="@string/nfc_master_card"
        style="@style/NfcItemStyle"/>
    <com.huami.watch.companion.ui.view.NfcItemView
        android:id="@+id/carItem"
        android:background="@drawable/wl_xiaopeng_enter_bg"
        android:visibility="gone"
        app:nfc_icon="@drawable/wl_xiaopeng_enter_icon"
        app:nfc_title="@string/wl_xiaopeng_enter_title"
        style="@style/NfcItemStyle"/>
    <com.huami.watch.companion.ui.view.NfcItemView
        android:id="@+id/jacCarItem"
        android:background="@drawable/wl_jac_enter_bg"
        android:visibility="gone"
        app:nfc_icon="@drawable/wl_jac_enter_icon"
        app:nfc_title="@string/wl_jac_enter_title"
        style="@style/NfcItemStyle"/>
</LinearLayout>
