<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/shape_rect_white_corner_6"
    android:paddingBottom="19dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/training_effect"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/over_view_training_effect"
        android:layout_marginStart="14dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Rainbow.TextAppearance.Body3"/>
    <ImageView
        android:visibility="invisible"
        android:layout_width="19dp"
        android:layout_height="19dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="@dimen/d1"
        app:layout_constraintBottom_toBottomOf="@+id/training_effect"
        app:layout_constraintStart_toEndOf="@+id/training_effect"
        app:layout_constraintTop_toTopOf="@+id/training_effect"
        app:srcCompat="@drawable/ic_tips_20_s2"/>
    <TextView
        android:id="@+id/line"
        android:visibility="gone"
        android:layout_width="1dp"
        android:layout_height="130dp"
        android:layout_marginTop="41dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/tv_aerobic"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:text="@string/moving_ui_aerobic"
        app:layout_constraintStart_toStartOf="@+id/training_effect"
        app:layout_constraintTop_toBottomOf="@+id/training_effect"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <com.huami.chart.chart.HMSpeedDialChart
        android:id="@+id/chart_aerobic"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="15dp"
        android:layout_marginStart="17dp"
        android:layout_marginEnd="27dp"
        app:capType="round"
        app:colors="@array/moving_ui_training_effect_color"
        app:defaultColor="@color/s4"
        app:layout_constraintDimensionRatio="125:66"
        app:layout_constraintEnd_toEndOf="@+id/line"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_aerobic"
        app:lineWidth="8dp"
        app:markLineColor="@color/s38"
        app:markLineDegree="5"
        app:useCenter="false"/>
    <TextView
        android:textSize="31sp"
        android:textColor="@color/s1"
        android:id="@+id/tv_aerobic_score"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/chart_aerobic"
        app:layout_constraintEnd_toEndOf="@+id/chart_aerobic"
        app:layout_constraintStart_toStartOf="@+id/chart_aerobic"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/s1"
        android:id="@+id/tv_aerobic_state"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toEndOf="@+id/chart_aerobic"
        app:layout_constraintStart_toStartOf="@+id/chart_aerobic"
        app:layout_constraintTop_toBottomOf="@+id/chart_aerobic"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/tv_anaerobic"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:text="@string/moving_ui_anaerobic"
        android:layout_marginStart="17dp"
        app:layout_constraintStart_toStartOf="@+id/line"
        app:layout_constraintTop_toBottomOf="@+id/training_effect"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <com.huami.chart.chart.HMSpeedDialChart
        android:id="@+id/chart_anaerobic"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="15dp"
        android:layout_marginStart="26dp"
        android:layout_marginEnd="18dp"
        app:capType="round"
        app:colors="@array/moving_ui_training_effect_color"
        app:defaultColor="@color/s4"
        app:layout_constraintDimensionRatio="125:66"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/line"
        app:layout_constraintTop_toBottomOf="@+id/tv_anaerobic"
        app:lineWidth="8dp"
        app:markLineColor="@color/s38"
        app:markLineDegree="5"
        app:useCenter="false"/>
    <TextView
        android:textSize="31sp"
        android:textColor="@color/s1"
        android:id="@+id/tv_anaerobic_score"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/chart_anaerobic"
        app:layout_constraintEnd_toEndOf="@+id/chart_anaerobic"
        app:layout_constraintStart_toStartOf="@+id/chart_anaerobic"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/s1"
        android:id="@+id/tv_anaerobic_state"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toEndOf="@+id/chart_anaerobic"
        app:layout_constraintStart_toStartOf="@+id/chart_anaerobic"
        app:layout_constraintTop_toBottomOf="@+id/chart_anaerobic"/>
</androidx.constraintlayout.widget.ConstraintLayout>
