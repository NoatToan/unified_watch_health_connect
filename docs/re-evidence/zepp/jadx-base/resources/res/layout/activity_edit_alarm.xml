<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.watch.companion.ui.view.ActionbarLayout
        android:id="@+id/actionbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:id="@+id/alarm_setting_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <View
            android:background="@color/theme_window_bg"
            android:layout_width="match_parent"
            android:layout_height="10.7dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:onClick="toRepeatPage"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/alarm_repeat"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#999999"
                android:gravity="end|center_vertical"
                android:id="@+id/alarm_repeat_info"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_right_arrow"/>
        </LinearLayout>
        <include layout="@layout/split_line_with_margin"/>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">
            <LinearLayout
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#e6000000"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/alarm_switch"/>
            </LinearLayout>
            <Switch
                android:id="@+id/switch_alarm"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:textOn=""
                android:textOff=""
                style="@style/WatchSwitch"/>
        </LinearLayout>
    </LinearLayout>
    <View
        android:background="@color/theme_window_bg"
        android:layout_width="match_parent"
        android:layout_height="10.7dp"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/pink"
        android:gravity="center"
        android:id="@+id/alarm_delete"
        android:background="@drawable/watch_common_corner_white_rect"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/watch_delete_alarm"
        android:onClick="deleteAlarm"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
</LinearLayout>
