<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.lib.rainbow.titlebar.RainbowTitleBar
        android:id="@+id/tv_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/bind_restore_factory"/>
    <TextView
        android:textSize="@dimen/size_14sp"
        android:textColor="@color/s2"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_39dp"
        android:text="@string/headset_reset_desc"
        android:layout_marginStart="@dimen/size_15dp"
        android:layout_marginEnd="@dimen/size_15dp"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_62dp"
        android:src="@drawable/headset_reset_tip"/>
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size_47dp"
        android:layout_marginStart="@dimen/size_20dp"
        android:layout_marginEnd="@dimen/size_21dp">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/s1"
            android:gravity="center"
            android:id="@+id/headset_reset_cancel_bt"
            android:background="@drawable/bg_bind_device_cancel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:minHeight="@dimen/size_48dp"
            android:text="@string/cancel"
            android:layout_weight="1"/>
        <Space
            android:layout_width="21dp"
            android:layout_height="0dp"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/color_selector_reset_btn_txt"
            android:gravity="center"
            android:id="@+id/headset_reset_bt"
            android:background="@drawable/bg_bind_device_cancel"
            android:paddingTop="@dimen/size_5dp"
            android:paddingBottom="5dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/size_48dp"
            android:text="@string/bind_restore_factory"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
