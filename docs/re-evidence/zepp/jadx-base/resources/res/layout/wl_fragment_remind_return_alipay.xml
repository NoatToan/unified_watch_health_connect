<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="start"
    android:orientation="vertical"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:background="@color/s36"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="@color/s2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_18dp"
                    android:text="@string/wl_return_card_alipay_auth"
                    android:layout_marginStart="@dimen/common_item_padding"
                    android:layout_marginEnd="@dimen/common_item_padding"
                    style="@style/TextAppearance.MiFit.Title3.Inverse"/>
                <View
                    android:background="@color/divide"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size_0.5dp"
                    android:layout_marginTop="@dimen/size_18dp"
                    android:layout_marginStart="@dimen/common_item_padding"
                    android:layout_marginEnd="@dimen/common_item_padding"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/ll_alipay_auth"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_18dp"
                    android:layout_marginBottom="@dimen/size_18dp">
                    <View
                        android:background="@drawable/wl_return_card_alipay_auth"
                        android:layout_width="@dimen/size_36dp"
                        android:layout_height="@dimen/size_36dp"
                        android:layout_marginStart="@dimen/size_18dp"/>
                    <TextView
                        android:textColor="@color/s2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/wl_return_card_alipay_auth_tips"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/common_item_padding"
                        android:layout_marginEnd="@dimen/common_item_padding"
                        style="@style/TextAppearance.MiFit.Title3.Inverse"/>
                    <TextView
                        android:textColor="@color/s2"
                        android:id="@+id/tv_alipay_tips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/wl_return_card_alipay_auth_click_tips"
                        style="@style/TextAppearance.MiFit.Title2.Inverse"/>
                    <View
                        android:background="@drawable/ic_arrow_forward_20"
                        android:layout_width="@dimen/size_18dp"
                        android:layout_height="@dimen/size_18dp"
                        android:layout_marginStart="@dimen/size_10dp"
                        android:layout_marginEnd="@dimen/size_18dp"
                        android:backgroundTint="@color/s2"/>
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:textColor="@color/s2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_18dp"
                android:text="@string/wl_return_card_alipay_auth_notice_title"
                android:layout_marginStart="@dimen/common_item_padding"
                android:layout_marginEnd="@dimen/common_item_padding"
                style="@style/TextAppearance.MiFit.Title3.Inverse"/>
            <TextView
                android:textColor="@color/s2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_18dp"
                android:text="@string/wl_return_card_alipay_auth_notice_content"
                android:layout_marginStart="@dimen/size_18dp"
                style="@style/TextAppearance.MiFit.Title.Inverse"/>
        </LinearLayout>
    </ScrollView>
    <Button
        android:enabled="false"
        android:id="@+id/alipay_auth_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="18dp"
        android:text="@string/wl_return_card_notice_confirm"
        android:layout_marginStart="@dimen/wl_border_margin"
        android:layout_marginEnd="@dimen/wl_border_margin"
        style="@style/Rainbow.Widget.Button.44.Circular"/>
</LinearLayout>
