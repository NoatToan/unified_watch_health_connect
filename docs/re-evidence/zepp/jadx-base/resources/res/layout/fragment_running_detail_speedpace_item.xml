<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:id="@+id/rl_km_segment"
    android:layout_width="match_parent"
    android:layout_height="30dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_km"
        android:layout_width="47dp"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true">
        <ImageView
            android:id="@+id/iv_right_triangle"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_km_segment_arrow"
            android:layout_marginStart="8dp"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textColor="@color/s1"
            android:gravity="center"
            android:id="@+id/km_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="din-med"
            android:textDirection="ltr"
            android:layout_marginStart="5dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_toStartOf="@+id/spendtime_text"
        android:layout_toEndOf="@+id/ll_km">
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="14sp"
            android:textColor="@color/s1"
            android:id="@+id/speed_min_text"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:fontFamily="din-med"
            android:textDirection="ltr"/>
        <ProgressBar
            android:id="@+id/speed_progress"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:max="500"
            android:progress="20"
            android:progressDrawable="@drawable/running_detail_speedpace_progress_drawable"
            android:layout_marginStart="11dp"
            style="?android:attr/progressBarStyleHorizontal"/>
    </LinearLayout>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="14sp"
        android:textColor="@color/s1"
        android:gravity="center"
        android:id="@+id/spendtime_text"
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        android:fontFamily="din-med"
        android:layout_marginEnd="20dp"
        android:layout_toStartOf="@+id/heart_rate_text"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="14sp"
        android:textColor="@color/s1"
        android:gravity="center"
        android:id="@+id/heart_rate_text"
        android:layout_width="30dp"
        android:layout_height="wrap_content"
        android:fontFamily="din-med"
        android:layout_marginEnd="12dp"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
