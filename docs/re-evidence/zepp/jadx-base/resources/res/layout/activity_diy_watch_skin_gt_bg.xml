<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/s36"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.lib.rainbow.titlebar.RainbowTitleBar
        android:id="@+id/title_bar"
        android:background="@color/s4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/event_remind_custom"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:layout_gravity="center_horizontal"
                android:id="@+id/cinco_container"
                android:layout_width="120dp"
                android:layout_height="206dp"
                android:layout_marginTop="32dp">
                <ImageView
                    android:id="@+id/device_preview_img"
                    android:layout_width="120dp"
                    android:layout_height="206dp"
                    android:src="@drawable/img_cinco_bg"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/cinco_bg_img"
                    android:layout_width="40dp"
                    android:layout_height="80dp"
                    android:src="@drawable/icon_cinco_dial_default_bg"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/cinco_transparent_img"
                    android:layout_width="40dp"
                    android:layout_height="80dp"
                    android:src="@drawable/icon_cinco_dial_default_bg"/>
            </FrameLayout>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/s2"
                android:layout_gravity="center_horizontal"
                android:id="@+id/error_tips_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"/>
            <TextView
                android:textColor="@color/p4"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/change_bg_btn"
                android:background="@drawable/bg_rect_selector_change_skin"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="11dp"
                android:text="@string/watch_skin_change_bg"
                android:layout_marginStart="@dimen/size_20dp"
                android:layout_marginEnd="@dimen/size_20dp"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="18dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:nestedScrollingEnabled="false"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.xiaomi.hm.health.device.watch_skin.WatchSkinProgressView
        android:textColor="@color/s5"
        android:gravity="center"
        android:id="@+id/sync_apply_btn"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="18dp"
        android:text="@string/sync_watch_skin"
        android:layout_marginStart="@dimen/size_20dp"
        android:layout_marginEnd="@dimen/size_20dp"
        app:btnRadius="@dimen/btn_click_bg_round_radius_dial_new"
        app:dialogMode="false"/>
</LinearLayout>
