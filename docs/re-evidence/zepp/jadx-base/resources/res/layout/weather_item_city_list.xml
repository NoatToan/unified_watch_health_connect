<?xml version="1.0" encoding="utf-8"?>
<com.zhouyou.recyclerview.swipemenu.SwipeMenuLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/s38"
    android:layout_width="match_parent"
    android:layout_height="61.5dp">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/smContentView"
        android:background="@color/s38"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <CheckBox
            android:textSize="15sp"
            android:textColor="@color/s1"
            android:layout_gravity="center_vertical"
            android:id="@+id/default_city_cb"
            android:background="@android:color/transparent"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:button="@null"
            android:foregroundGravity="fill"
            android:drawableEnd="@drawable/box_red_selector"
            android:layout_marginStart="14dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/s1"
            android:gravity="center_vertical"
            android:id="@+id/city_title_tv"
            android:background="@color/s38"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="0dp"/>
    </LinearLayout>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/s36"
        android:gravity="center"
        android:id="@+id/smMenuView"
        android:background="@color/p3"
        android:layout_width="67dp"
        android:layout_height="match_parent"
        android:text="@string/delete"/>
</com.zhouyou.recyclerview.swipemenu.SwipeMenuLayout>
