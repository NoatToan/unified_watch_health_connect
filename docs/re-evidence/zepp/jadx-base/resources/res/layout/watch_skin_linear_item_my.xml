<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:layout_marginBottom="10dp">
    <FrameLayout
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/skin_iv"
            android:layout_width="70dp"
            android:layout_height="140dp"
            android:src="@drawable/icon_headview_band"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/skin_iv_mask"
            android:layout_width="70dp"
            android:layout_height="140dp"/>
        <CheckBox
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/skin_cb"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:button="@drawable/rb_slt_yellow_white"/>
    </FrameLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/watch_skin_name_text_color"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/skin_tv_name"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="守望先锋守望先锋"
        android:singleLine="true"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/watch_skin_price_text_color"
        android:gravity="bottom|center_horizontal"
        android:id="@+id/skin_tv_price"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="4dp"
        android:text="免费"/>
</LinearLayout>
