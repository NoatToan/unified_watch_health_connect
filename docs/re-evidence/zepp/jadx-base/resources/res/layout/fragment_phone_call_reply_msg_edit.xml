<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?android:attr/windowBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.lib.rainbow.titlebar.RainbowTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:menuText="@string/save"
        app:menuTint="@color/rainbow_btn_stroke_text_color_selector"
        app:navigationText="@string/cancel"
        app:navigationTint="@color/rainbow_btn_gray_text_color_selector"
        app:title="@string/phone_call_reply_msg_management"/>
    <FrameLayout
        android:id="@+id/device_status_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_bar"/>
    <FrameLayout
        android:id="@+id/content_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/device_status_content">
        <com.huami.lib.rainbow.shapeable.ShapeableConstraintLayout
            android:background="?android:attr/colorBackground"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            app:shapeAppearance="@style/ShapeAppearance.App.Rounded">
            <androidx.appcompat.widget.AppCompatEditText
                android:textColor="@color/s1"
                android:gravity="start"
                android:id="@+id/et_content"
                android:background="@android:color/transparent"
                android:padding="15dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textDirection="locale"
                android:textAlignment="viewStart"
                app:layout_constraintEnd_toStartOf="@+id/tv_limit"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Rainbow.TextAppearance.Body3"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/s3"
                android:gravity="end"
                android:id="@+id/tv_limit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:minWidth="21dp"
                android:textDirection="locale"
                android:textAlignment="viewEnd"
                android:layout_marginEnd="15dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Rainbow.TextAppearance.Body4"/>
        </com.huami.lib.rainbow.shapeable.ShapeableConstraintLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
