<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/phn_shape_corners_top"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="@color/s1"
        android:gravity="center"
        android:id="@+id/tv_modify_rest_days_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:text="@string/phn_modify_rest_days_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Rainbow.TextAppearance.Title2"/>
    <View
        android:id="@+id/view_line1"
        android:background="@color/s4"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_modify_rest_days_title"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_week_picker"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:overScrollMode="never"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_line1"/>
    <View
        android:id="@+id/view_line2"
        android:background="@color/s4"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@+id/rv_week_picker"/>
    <TextView
        android:textColor="@color/s2"
        android:id="@+id/tv_modify_rest_days_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/phn_modify_rest_days_desc_modify"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_line2"
        style="@style/Rainbow.TextAppearance.Body5"/>
    <LinearLayout
        android:orientation="horizontal"
        android:background="@color/s4"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="21dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_modify_rest_days_desc">
        <TextView
            android:textColor="@color/s2"
            android:gravity="center"
            android:id="@+id/tv_modify_cancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/phn_common_cancel"
            android:layout_weight="1"
            style="@style/Rainbow.TextAppearance.Body3"/>
        <TextView
            android:textColor="@color/s1"
            android:gravity="center"
            android:id="@+id/tv_modify_confirm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/phn_common_confirm"
            android:layout_weight="1"
            style="@style/Rainbow.TextAppearance.Body3"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
