<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/weight_mon_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.viewpager.widget.ViewPager
            android:id="@+id/view_pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"/>
        <com.xiaomi.hm.health.view.indicator.CirclePageIndicator xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/indicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="33.3dp"
            app:fillColor="#ffffff"
            app:gap="8dp"
            app:pageColor="#33ffffff"
            app:radius="2.5dp"
            app:strokeWidth="0dp"/>
    </FrameLayout>
    <RelativeLayout
        android:id="@+id/page_2_layout"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="152dp"
            android:src="@drawable/instruction_weight_floor"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="155dp"
            android:src="@drawable/weight_bfs_standing"
            android:layout_centerHorizontal="true"/>
        <LinearLayout
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="219dp"
            android:layout_marginStart="37.3dp">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/white60"
                android:layout_width="73dp"
                android:layout_height="wrap_content"
                android:text="@string/instruction_weight_page6_t1"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/instruction_weight_l1"
                android:layout_marginStart="@dimen/instruction_weight_page6_l1_left"/>
        </LinearLayout>
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/white60"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="277dp"
                android:text="@string/play_weight_bfs_page2_tip2"
                android:layout_marginStart="265dp"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="293.1953dp"
                android:src="@drawable/instruction_weight_l2"
                android:layout_marginStart="218.8dp"/>
        </RelativeLayout>
        <LinearLayout
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="393dp"
            android:layout_marginStart="@dimen/instruction_weight_page6_txt3_left">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/white60"
                android:layout_width="85dp"
                android:layout_height="wrap_content"
                android:text="@string/instruction_weight_page6_t3"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/instruction_weight_l3"
                android:layout_marginStart="5.5dp"/>
        </LinearLayout>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/page_3_layout"
        android:background="@drawable/weight_bfs_set_unit_bg"
        android:visibility="invisible"
        android:layout_width="240dp"
        android:layout_height="226.7dp"
        android:layout_marginTop="220dp"
        android:layout_centerHorizontal="true">
        <TextView
            android:textSize="9sp"
            android:textColor="@color/white40"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="44dp"
            android:text="@string/weight_set_unit"
            android:layout_marginStart="34dp"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="77.3dp"
            android:src="@drawable/weight_bfs_unit_arrow"
            android:layout_marginStart="18dp"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/white60"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="77dp"
            android:text="@string/weight_bfs_unit_kg"
            android:layout_marginStart="34dp"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/white60"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="118.3dp"
            android:text="@string/weight_bfs_unit_pound"
            android:layout_marginStart="34dp"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/white60"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="159.7dp"
            android:text="@string/weight_bfs_unit_jin"
            android:layout_marginStart="34dp"/>
    </RelativeLayout>
    <include
        android:id="@+id/one_foot_page"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="180.9dp"
        android:layout_centerHorizontal="true"
        layout="@layout/one_foot_instrcution"/>
    <include
        android:id="@+id/small_w_page"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="234.9dp"
        android:layout_centerHorizontal="true"
        layout="@layout/small_thing_weighting_instrcution"/>
    <RelativeLayout
        android:id="@+id/page_3_layout_no_jin"
        android:background="@drawable/weight_bfs_set_unit_bg_no_jin"
        android:visibility="invisible"
        android:layout_width="240dp"
        android:layout_height="226.7dp"
        android:layout_marginTop="220dp"
        android:layout_centerHorizontal="true">
        <TextView
            android:textSize="9sp"
            android:textColor="@color/white40"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="65dp"
            android:text="@string/weight_set_unit"
            android:layout_marginStart="34dp"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="98.5dp"
            android:src="@drawable/weight_bfs_unit_arrow"
            android:layout_marginStart="18dp"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/white60"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="98dp"
            android:text="@string/weight_bfs_unit_kg"
            android:layout_marginStart="34dp"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/white60"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="139.3dp"
            android:text="@string/weight_bfs_unit_pound"
            android:layout_marginStart="34dp"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/page_over_max"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="220dp">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/big_weight_bfs"
            android:layout_centerHorizontal="true"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:src="@drawable/weightbfs_ol"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/page_low_battery"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="220dp">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/big_weight_bfs"
            android:layout_centerHorizontal="true"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:src="@drawable/weight_bfs_low_power"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
</RelativeLayout>
