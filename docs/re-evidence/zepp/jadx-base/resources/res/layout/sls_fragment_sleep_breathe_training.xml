<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:scrollbars="none"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/sls_breathe_training_header_layout"
            android:background="@drawable/sls_sleep_breath_training_header_bg"
            android:layout_width="match_parent"
            android:layout_height="140dp">
            <androidx.constraintlayout.widget.Guideline
                android:orientation="horizontal"
                android:id="@+id/guideline1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_percent="0.4"/>
            <View
                android:id="@+id/sls_breathe_training_line"
                android:background="@color/sls_sleep_breath_line"
                android:layout_width="2dp"
                android:layout_height="22dp"
                android:layout_marginStart="17dp"
                app:layout_constraintBottom_toBottomOf="@+id/guideline1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/guideline1"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="@dimen/sls_text_size_24"
                android:textColor="@color/s1"
                android:id="@+id/sls_breathe_training_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sls_breathe_training"
                android:fontFamily="lt-bold"
                android:layout_marginStart="12dp"
                app:layout_constraintBottom_toBottomOf="@+id/guideline1"
                app:layout_constraintStart_toEndOf="@+id/sls_breathe_training_line"
                app:layout_constraintTop_toTopOf="@+id/guideline1"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="@dimen/sls_text_size_14"
                android:textColor="@color/s2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/sls_training_sleep_msg"
                android:fontFamily="lt"
                app:layout_constraintStart_toStartOf="@+id/sls_breathe_training_title"
                app:layout_constraintTop_toBottomOf="@+id/sls_breathe_training_title"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/sls_breathe_training_inhale_layout"
            android:background="@drawable/sls_breathing_training_inhale_bg"
            android:layout_width="match_parent"
            android:layout_height="112dp"
            android:layout_marginTop="15dp"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp">
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="15sp"
                android:textColor="@color/s1"
                android:id="@+id/sls_tv_training_card_title1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="21dp"
                android:text="@string/sls_training_card_title1"
                android:fontFamily="lt-bold"
                android:layout_marginStart="96dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="12sp"
                android:textColor="@color/s2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="20dp"
                android:text="@string/sls_training_card_label1"
                android:fontFamily="lt"
                android:layout_marginStart="96dp"
                android:layout_marginEnd="23dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/sls_tv_training_card_title1"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/sls_breathe_training_exhale_layout"
            android:background="@drawable/sls_breathing_training_exhale_bg"
            android:layout_width="match_parent"
            android:layout_height="112dp"
            android:layout_marginTop="15dp"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp">
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="15sp"
                android:textColor="@color/s1"
                android:id="@+id/sls_tv_training_card_title2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="21dp"
                android:text="@string/sls_training_card_title2"
                android:fontFamily="lt-bold"
                android:layout_marginStart="96dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="12sp"
                android:textColor="@color/s2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/sls_training_card_label2"
                android:fontFamily="lt"
                android:layout_marginStart="96dp"
                android:layout_marginEnd="23dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/sls_tv_training_card_title2"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="14sp"
            android:textColor="@color/s2"
            android:id="@+id/sls_breathe_training_prompt_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/sls_breathe_training_label1"
            android:drawablePadding="10dp"
            android:drawableStart="@drawable/sls_share_icon_point"
            android:fontFamily="lt"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="14sp"
            android:textColor="@color/s2"
            android:id="@+id/sls_breathe_training_prompt_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="@string/sls_breathe_training_label2"
            android:drawablePadding="10dp"
            android:drawableStart="@drawable/sls_share_icon_point"
            android:fontFamily="lt"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"/>
        <Button
            android:gravity="center"
            android:id="@+id/sls_btn_start_training"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="15dp"
            android:layout_marginBottom="20dp"
            android:text="@string/sls_training_start"
            android:fontFamily="lt-bold"
            style="@style/Rainbow.Widget.Button.48"/>
    </LinearLayout>
</ScrollView>
