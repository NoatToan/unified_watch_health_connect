<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:padding="17dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_img"
        android:layout_width="80dp"
        android:layout_height="53dp"
        android:scaleType="centerCrop"/>
    <TextView
        android:textSize="9sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_preview"
        android:background="#24d297"
        android:layout_width="23dp"
        android:layout_height="15dp"
        android:text="@string/tr_preview"/>
    <FrameLayout
        android:id="@+id/layout_lock"
        android:background="@color/black"
        android:layout_width="80dp"
        android:layout_height="53dp"
        android:alpha="0.5"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/iv_lock"
        android:layout_width="17dp"
        android:layout_height="17dp"
        android:src="@drawable/ic_lock"
        app:layout_constraintBottom_toBottomOf="@+id/iv_img"
        app:layout_constraintEnd_toEndOf="@+id/iv_img"
        app:layout_constraintStart_toStartOf="@+id/iv_img"
        app:layout_constraintTop_toTopOf="@+id/iv_img"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/s1"
        android:ellipsize="end"
        android:id="@+id/tv_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="13dp"
        android:maxLines="1"
        android:layout_marginStart="13dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/tv_learn_times"
        app:layout_constraintStart_toEndOf="@+id/iv_img"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:layout_marginStart="13dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_img"
        app:layout_constraintTop_toBottomOf="@+id/tv_name">
        <TextView
            android:textSize="11sp"
            android:textColor="@color/s2"
            android:id="@+id/tv_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <View
            android:id="@+id/view_divider1"
            android:background="@color/color_eeeeee"
            android:layout_width="@dimen/divider"
            android:layout_height="10dp"
            android:layout_marginStart="6dp"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/s2"
            android:id="@+id/tv_consumption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"/>
        <View
            android:id="@+id/view_divider2"
            android:background="@color/color_eeeeee"
            android:layout_width="@dimen/divider"
            android:layout_height="10dp"
            android:layout_marginStart="6dp"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/s2"
            android:ellipsize="end"
            android:id="@+id/tv_instrument"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="6dp"/>
    </LinearLayout>
    <TextView
        android:textSize="11sp"
        android:textColor="@color/s3"
        android:id="@+id/tv_learn_times"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
