<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/repeat_type_day"
        style="@style/ItemStyle">
        <ImageView
            android:id="@+id/repeat_type_day_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_pop_selected"
            android:layout_marginEnd="12dp"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#e6000000"
            android:id="@+id/repeat_type_day_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/repeat_every_day"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/repeat_type_week"
        style="@style/ItemStyle">
        <ImageView
            android:id="@+id/repeat_type_week_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_pop_selected"
            android:layout_marginEnd="12dp"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#e6000000"
            android:id="@+id/repeat_type_week_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/repeat_every_week"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/repeat_type_month"
        style="@style/ItemStyle">
        <ImageView
            android:id="@+id/repeat_type_month_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_pop_selected"
            android:layout_marginEnd="12dp"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#e6000000"
            android:id="@+id/repeat_type_month_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/repeat_every_month"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/repeat_type_year"
        style="@style/ItemStyle">
        <ImageView
            android:id="@+id/repeat_type_year_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_pop_selected"
            android:layout_marginEnd="12dp"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#e6000000"
            android:id="@+id/repeat_type_year_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/repeat_every_year"/>
    </LinearLayout>
</LinearLayout>
