                                android:layout_height="wrap_content">
                                <ImageView
                                    android:id="@+id/sleep_right_dot"
                                    android:layout_width="10dp"
                                    android:layout_height="10dp"
                                    android:layout_marginTop="5dp"
                                    android:src="@drawable/sleep_pos_right_dot"/>
