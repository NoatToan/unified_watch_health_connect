                                    android:textSize="14sp"
                                    android:textColor="@color/s2"
                                    android:gravity="center"
                                    android:id="@+id/sleep_right_name"
                                    android:layout_width="wrap_content"
                                    android:layout_height="20dp"
                                    android:text="@string/sleep_pos_right"
                                    android:layout_marginStart="7dp"
                                    android:layout_toEndOf="@+id/sleep_right_dot"/>
                                <TextView
                                    android:textSize="16sp"
                                    android:textColor="@color/s1"
                                    android:id="@+id/sleep_right_time"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:layout_below="@+id/sleep_right_name"
                                    android:layout_alignStart="@+id/sleep_right_name"/>
                            </RelativeLayout>
                            <RelativeLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp">
                                <ImageView
                                    android:id="@+id/sleep_left_dot"
                                    android:background="@drawable/sleep_pos_left_dot"
                                    android:layout_width="10dp"
                                    android:layout_height="10dp"
                                    android:layout_marginTop="5dp"/>
                                <TextView
                                    android:textSize="14sp"
                                    android:textColor="@color/s2"
                                    android:gravity="center"
                                    android:id="@+id/sleep_left_name"
                                    android:layout_width="wrap_content"
                                    android:layout_height="20dp"
                                    android:text="@string/sleep_pos_left"
                                    android:layout_marginStart="7dp"
                                    android:layout_toEndOf="@+id/sleep_left_dot"/>
                                <TextView
                                    android:textSize="16sp"
                                    android:textColor="@color/s1"
                                    android:id="@+id/sleep_left_time"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:layout_below="@+id/sleep_left_name"
                                    android:layout_alignStart="@+id/sleep_left_name"/>
                            </RelativeLayout>
                            <RelativeLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp">
                                <ImageView
                                    android:id="@+id/sleep_back_dot"
                                    android:background="@drawable/sleep_pos_back_dot"
                                    android:layout_width="10dp"
                                    android:layout_height="10dp"
                                    android:layout_marginTop="5dp"/>
                                <TextView
                                    android:textSize="14sp"
                                    android:textColor="@color/s2"
                                    android:gravity="center"
                                    android:id="@+id/sleep_back_name"
                                    android:layout_width="wrap_content"
                                    android:layout_height="20dp"
                                    android:text="@string/sleep_pos_back"
                                    android:layout_marginStart="7dp"
                                    android:layout_toEndOf="@+id/sleep_back_dot"/>
                                <TextView
