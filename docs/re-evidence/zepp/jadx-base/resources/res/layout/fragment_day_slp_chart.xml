                                    android:text="@string/sleep_pos_stomach"
                                    android:layout_marginStart="7dp"
                                    android:layout_toEndOf="@+id/sleep_stomach_dot"/>
                                <TextView
                                    android:textSize="16sp"
                                    android:textColor="@color/s1"
                                    android:id="@+id/sleep_stomach_time"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:layout_below="@+id/sleep_stomach_name"
                                    android:layout_alignStart="@+id/sleep_stomach_name"/>
                            </RelativeLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
