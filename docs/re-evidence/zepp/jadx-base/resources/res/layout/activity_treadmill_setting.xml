<?xml version="1.0" encoding="utf-8"?>
<com.huami.lib.view.scroll.HMScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/s10"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.huami.lib.view.scroll.HMExpandHeadView
            android:background="@color/s10"
            android:layout_width="match_parent"
            android:layout_height="278dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="80dp"
                android:layout_centerHorizontal="true"
                app:srcCompat="@drawable/treadmill_device_page"/>
        </com.huami.lib.view.scroll.HMExpandHeadView>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:background="@color/s4"
                android:layout_width="match_parent"
                android:layout_height="1px"/>
            <FrameLayout
                android:id="@+id/container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <View
                android:background="@color/s4"
                android:layout_width="match_parent"
                android:layout_height="1px"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/item_layout"
                android:background="@color/s10"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/item_music_equalizer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ltv_title="@string/bolt_setting_music_equalizer"/>
                <include layout="@layout/device_setting_view_space"/>
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/item_maintain"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ltv_title="@string/setting_maintain"/>
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/item_faq"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ltv_title="@string/setting_question"/>
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/item_check_upgrade"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ltv_title="@string/setting_update"/>
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/item_no_load_test"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ltv_title="@string/bolt_setting_no_Load_test"/>
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/item_clear_data"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ltv_title="@string/bolt_setting_clear_data"/>
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/item_fw_version"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ltv_title="@string/mili_setting_fw_version"/>
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/item_mac_address"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ltv_title="@string/mili_setting_mac_address"/>
                <View
                    android:background="@color/s4"
                    android:layout_width="match_parent"
                    android:layout_height="0.33dp"/>
            </LinearLayout>
            <Button
                android:id="@+id/treadmill_setting_unbind"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"
                android:text="@string/mili_setting_unbind"
                android:onClick="onClick"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                style="@style/Rainbow.Widget.Button.48"/>
        </LinearLayout>
    </LinearLayout>
</com.huami.lib.view.scroll.HMScrollView>
