<?xml version="1.0" encoding="utf-8"?>
<com.huami.training.ui.widget.CustomSmartRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/smart_refresh"
    android:background="@color/s36"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:srlPrimaryColor="@color/s10">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/refresh_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="14sp"
            android:textColor="@color/s2"
            android:gravity="center"
            android:id="@+id/empty_tips"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="90dp"
            android:text="@string/tr_joined_course_empty_tips"
            android:fontFamily="lt"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.huami.training.ui.widget.CustomSmartRefreshLayout>
