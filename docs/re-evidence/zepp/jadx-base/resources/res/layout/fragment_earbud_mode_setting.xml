<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.Placeholder
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="39"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="15sp"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:id="@+id/setting_one_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <TextView
            android:textSize="15sp"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:id="@+id/setting_two_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/earbud_rest"
            android:layout_weight="1"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.Placeholder
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="36"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="150dp"
            android:layout_weight="1">
            <com.huami.widget.wheelview.WheelView
                android:id="@+id/time_set_one_wheel"
                android:layout_width="100dp"
                android:layout_height="150dp"
                android:layout_centerInParent="true"/>
            <TextView
                android:textSize="15sp"
                android:textColor="#32ffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/unit_min_long"
                android:layout_centerVertical="true"
                android:layout_marginEnd="-10dp"
                android:layout_alignEnd="@+id/time_set_one_wheel"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/time_set_two"
            android:layout_width="0dp"
            android:layout_height="150dp"
            android:layout_weight="1">
            <com.huami.widget.wheelview.WheelView
                android:id="@+id/time_set_two_wheel"
                android:layout_width="100dp"
                android:layout_height="150dp"
                android:layout_centerInParent="true"/>
            <TextView
                android:textSize="15sp"
                android:textColor="#32ffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/unit_min_long"
                android:layout_centerVertical="true"
                android:layout_marginEnd="-10dp"
                android:layout_alignEnd="@+id/time_set_two_wheel"/>
        </RelativeLayout>
    </LinearLayout>
    <androidx.constraintlayout.widget.Placeholder
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="191"/>
    <TextView
        android:enabled="true"
        android:textSize="14sp"
        android:textColor="#000000"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/start_btn"
        android:background="@drawable/bg_earbud_button"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:minWidth="78dp"
        android:text="@string/earbud_start"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"/>
</LinearLayout>
