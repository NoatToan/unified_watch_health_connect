<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s38"
    android:paddingBottom="@dimen/size_20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/size_20dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/root_rest_cal"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/rest_cal_line"
            android:background="@color/s10"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.xiaomi.hm.health.running.calori.view.CalorieListTile
            android:id="@+id/lt_rest_cal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/rest_cal_line"
            app:ltv_title="@string/calorie_rest_cal"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/card_status_dividing_line"
        android:background="@color/s10"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/root_rest_cal"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/sport_energy_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_20dp"
        android:text="@string/sport_energy_title"
        android:paddingStart="@dimen/size_20dp"
        android:paddingEnd="@dimen/size_20dp"
        app:layout_constraintTop_toBottomOf="@+id/card_status_dividing_line"
        style="@style/Rainbow.TextAppearance.Title3"/>
    <TextView
        android:textColor="@color/s2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15.3dp"
        android:text="@string/sport_energy_footer"
        android:lineSpacingExtra="5.3sp"
        android:paddingStart="@dimen/size_20dp"
        android:paddingEnd="@dimen/size_20dp"
        app:layout_constraintTop_toBottomOf="@+id/sport_energy_title"
        style="@style/Rainbow.TextAppearance.Body5"/>
</androidx.constraintlayout.widget.ConstraintLayout>
