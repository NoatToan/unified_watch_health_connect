<?xml version="1.0" encoding="utf-8"?>
<com.huami.lib.view.scroll.HMScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/normandy_setting_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:background="@color/s10"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.huami.lib.view.scroll.HMExpandHeadView
            android:id="@+id/unused_device_head_view"
            android:background="@color/transparency"
            android:layout_width="match_parent"
            android:layout_height="246dp">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="106dp"
                android:text="@string/out_of_service"
                android:drawableTop="@drawable/icon_out_of_service"
                android:drawablePadding="7dp"
                android:layout_centerHorizontal="true"/>
        </com.huami.lib.view.scroll.HMExpandHeadView>
        <FrameLayout
            android:id="@+id/container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/unused_device_head_view"/>
        <View
            android:id="@+id/divider"
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_below="@+id/container"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/divider">
            <com.huami.lib.rainbow.ListTile
                android:id="@+id/use_device"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="69dp"
                android:onClick="onClick"
                app:ltv_subtitle="@string/use_device_tips_band"
                app:ltv_title="@string/use_device"/>
            <com.huami.lib.rainbow.ListTile
                android:id="@+id/play_with_device"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_62dp"
                android:onClick="onClick"
                app:ltv_title="@string/play_with_device"/>
            <com.huami.lib.rainbow.ListTile
                android:id="@+id/faq_item"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_62dp"
                android:onClick="onClick"
                app:ltv_title="@string/setting_question"/>
            <com.huami.lib.rainbow.ListTile
                android:id="@+id/firmware_version"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_62dp"
                app:ltv_title="@string/shoes_setting_fw_version"
                app:ltv_trailing="@color/transparency"/>
            <com.huami.lib.rainbow.ListTile
                android:id="@+id/mac_address"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_62dp"
                app:ltv_title="@string/mili_setting_mac_address"
                app:ltv_trailing="@color/transparency"/>
            <View
                android:background="@color/s4"
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider"/>
        </LinearLayout>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/black40"
            android:gravity="center"
            android:id="@+id/activate_amazfit_watch_tips"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="100dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp"/>
        <androidx.appcompat.widget.AppCompatButton
            android:textColor="@color/tangerine"
            android:gravity="center"
            android:id="@+id/unbind"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:text="@string/mili_setting_unbind"
            android:layout_alignParentBottom="true"
            android:onClick="onClick"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"
            style="?attr/buttonStyleGray_48_flat"/>
    </RelativeLayout>
</com.huami.lib.view.scroll.HMScrollView>
