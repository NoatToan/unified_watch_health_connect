<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/chart_area"
        android:background="@drawable/no_hr_chart_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/whole_day_hr_chart_area_height">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/black70"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/chart_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/loading"
            android:drawablePadding="12dp"
            app:drawableTopCompat="@drawable/icon_hr_warning"/>
        <FrameLayout
            android:layout_gravity="bottom"
            android:id="@+id/chart_container"
            android:layout_width="match_parent"
            android:layout_height="@dimen/whole_day_hr_chart_height"/>
    </FrameLayout>
    <RelativeLayout
        android:orientation="horizontal"
        android:id="@+id/day_scale"
        android:background="@color/pale_grey_two"
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">
        <TextView
            android:id="@+id/day_first"
            style="@style/RestHrDateTextStyle"/>
        <TextView
            android:id="@+id/day_first_third"
            style="@style/RestHrDateTextStyle"/>
        <TextView
            android:id="@+id/day_last_third"
            android:layout_alignParentEnd="true"
            style="@style/RestHrDateTextStyle"/>
        <TextView
            android:id="@+id/day_last"
            android:layout_alignParentEnd="true"
            style="@style/RestHrDateTextStyle"/>
    </RelativeLayout>
    <View style="@style/VerticalDivider"/>
    <RelativeLayout
        android:id="@+id/btn_intro"
        android:background="@drawable/bg_item"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="72dp">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/black70"
            android:id="@+id/title_rhr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="13.5dp"
            android:text="@string/heart_rate_rest"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/black40"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="13.5dp"
            android:text="@string/rhr_intro_new"
            android:layout_below="@+id/title_rhr"
            android:layout_marginEnd="52dp"/>
        <ImageView
            android:layout_width="12dp"
            android:layout_height="13.5dp"
            android:src="@drawable/ic_indicator_right_arrow"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <View style="@style/VerticalDivider"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/list_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:layout_marginTop="8dp"
            style="@style/VerticalDivider"/>
    </LinearLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/black20"
        android:layout_gravity="center"
        android:id="@+id/empty_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="74dp"
        android:text="@string/wear_ring_to_measure_rest_hr"
        android:drawablePadding="3dp"
        app:drawableTopCompat="@drawable/icon_no_rest_hr"/>
</LinearLayout>
