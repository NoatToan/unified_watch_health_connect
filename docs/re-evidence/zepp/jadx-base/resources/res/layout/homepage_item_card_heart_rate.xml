<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minHeight="185dp">
    <com.huami.module.homepage.cards.cardui.CardTitleBarView
        android:id="@+id/heart_rate_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:showExpandButton="true"
        app:titleText="@string/homepage_item_card_heart_rate"/>
    <RelativeLayout
        android:id="@+id/ring_rl"
        android:layout_width="136dp"
        android:layout_height="118dp"
        android:layout_marginTop="14dp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/heart_rate_bar">
        <com.huami.module.homepage.cards.cardui.GradientArcView
            android:id="@+id/ring"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"/>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/red_heart"
            android:layout_width="30dp"
            android:layout_height="30dp"/>
    </RelativeLayout>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/rest_hr_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="61dp"
        android:text="@string/homepage_item_card_rest_hr"
        android:layout_marginStart="22dp"
        app:layout_constraintStart_toEndOf="@+id/ring_rl"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/rest_hr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        app:layout_constraintBaseline_toBaselineOf="@+id/rest_hr_title"
        app:layout_constraintBottom_toBottomOf="@+id/rest_hr_title"
        app:layout_constraintStart_toEndOf="@+id/rest_hr_title"
        app:layout_constraintTop_toTopOf="@+id/rest_hr_title"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/min_hr_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:text="@string/homepage_item_card_min_hr"
        app:layout_constraintStart_toStartOf="@+id/rest_hr_title"
        app:layout_constraintTop_toBottomOf="@+id/rest_hr_title"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/min_hr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        app:layout_constraintBaseline_toBaselineOf="@+id/min_hr_title"
        app:layout_constraintBottom_toBottomOf="@+id/min_hr_title"
        app:layout_constraintStart_toEndOf="@+id/min_hr_title"
        app:layout_constraintTop_toTopOf="@+id/min_hr_title"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/max_hr_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:text="@string/homepage_item_card_max_hr"
        app:layout_constraintStart_toStartOf="@+id/min_hr_title"
        app:layout_constraintTop_toBottomOf="@+id/min_hr_title"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/max_hr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        app:layout_constraintBaseline_toBaselineOf="@+id/max_hr_title"
        app:layout_constraintBottom_toBottomOf="@+id/max_hr_title"
        app:layout_constraintStart_toEndOf="@+id/max_hr_title"
        app:layout_constraintTop_toTopOf="@+id/max_hr_title"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <com.huami.module.homepage.cards.business.heartrate.HeartRateChartView
        android:id="@+id/detail"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ring_rl"
        app:layout_constraintVertical_bias="0"/>
    <com.huami.module.homepage.cards.cardui.BackgroundTextView
        android:textColor="@color/s1"
        android:gravity="center"
        android:id="@+id/no_hr_data"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:text="@string/homepage_item_card_no_hr_data"
        app:backgroundTintAlpha="0.92"
        app:layout_constraintBottom_toBottomOf="@+id/ring_rl"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/heart_rate_bar"
        style="@style/Rainbow.TextAppearance.Body4"/>
</androidx.constraintlayout.widget.ConstraintLayout>
