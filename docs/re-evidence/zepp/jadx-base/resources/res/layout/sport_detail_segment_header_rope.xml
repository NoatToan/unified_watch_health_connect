<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="40dp">
    <TextView
        android:textSize="10.7sp"
        android:textColor="@color/s2"
        android:gravity="center"
        android:id="@+id/index"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:text="@string/segment_number"
        android:layout_weight="3"/>
    <TextView
        android:textSize="10.7sp"
        android:textColor="@color/s2"
        android:gravity="center"
        android:id="@+id/count"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:text="@string/rope_count"
        android:layout_weight="5"/>
    <TextView
        android:textSize="10.7sp"
        android:textColor="@color/s2"
        android:gravity="center"
        android:id="@+id/frequency"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:text="@string/rope_frequency_title"
        android:layout_weight="5"/>
    <TextView
        android:textSize="10.7sp"
        android:textColor="@color/s2"
        android:gravity="center"
        android:id="@+id/heart"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:text="@string/segment_heartrate"
        android:layout_weight="5"/>
    <TextView
        android:textSize="10.7sp"
        android:textColor="@color/s2"
        android:gravity="center"
        android:id="@+id/cast"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:text="@string/segment_cast"
        android:layout_weight="5"/>
    <TextView
        android:textSize="10.7sp"
        android:textColor="@color/s2"
        android:gravity="center"
        android:id="@+id/time"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:text="@string/segment_use_time"
        android:layout_weight="5"/>
</LinearLayout>
