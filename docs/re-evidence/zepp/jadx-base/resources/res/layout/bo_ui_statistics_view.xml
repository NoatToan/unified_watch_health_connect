<?xml version="1.0" encoding="utf-8"?>
<com.huami.bloodoxygen.ui.view.BloodOxygenCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingTop="@dimen/bo_ui_size_12dp"
        android:paddingBottom="@dimen/bo_ui_size_28dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/bo_ui_size_15dp"
        android:paddingEnd="@dimen/bo_ui_size_15dp">
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="@dimen/bo_ui_size_18sp"
            android:textStyle="bold"
            android:textColor="@color/s1"
            android:id="@+id/statistics_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textDirection="locale"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/divider"
            android:layout_marginTop="@dimen/bo_ui_size_15dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/statistics_title"
            style="@style/bo_ui_Divider_Horizontal"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="@dimen/bo_ui_size_14sp"
            android:textColor="@color/s1"
            android:gravity="start"
            android:id="@+id/avg_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/bo_ui_size_20dp"
            android:text="@string/bo_ui_statistics_max"
            android:textDirection="locale"
            app:layout_constraintEnd_toStartOf="@+id/avg_value"
            app:layout_constraintHorizontal_weight="8"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/divider"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="@dimen/bo_ui_size_16sp"
            android:textStyle="bold"
            android:textColor="@color/s1"
            android:gravity="end"
            android:id="@+id/avg_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textDirection="locale"
            app:layout_constraintBaseline_toBaselineOf="@+id/avg_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="2"
            app:layout_constraintStart_toEndOf="@+id/avg_title"
            app:layout_constraintTop_toBottomOf="@+id/divider"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="@dimen/bo_ui_size_14sp"
            android:textColor="@color/s1"
            android:gravity="start"
            android:id="@+id/max_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/bo_ui_size_42dp"
            android:text="@string/bo_ui_statistics_min"
            android:textDirection="locale"
            app:layout_constraintEnd_toStartOf="@+id/max_value"
            app:layout_constraintHorizontal_weight="8"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/avg_title"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="@dimen/bo_ui_size_16sp"
            android:textStyle="bold"
            android:textColor="@color/s1"
            android:gravity="end"
            android:id="@+id/max_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textDirection="locale"
            app:layout_constraintBaseline_toBaselineOf="@+id/max_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="2"
            app:layout_constraintStart_toEndOf="@+id/max_title"
            app:layout_constraintTop_toBottomOf="@+id/avg_title"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="@dimen/bo_ui_size_14sp"
            android:textColor="@color/s1"
            android:gravity="start"
            android:id="@+id/min_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/bo_ui_size_42dp"
            android:text="@string/bo_ui_statistics_avg"
            android:textDirection="locale"
            app:layout_constraintEnd_toStartOf="@+id/min_value"
            app:layout_constraintHorizontal_weight="8"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/max_title"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="@dimen/bo_ui_size_16sp"
            android:textStyle="bold"
            android:textColor="@color/s1"
            android:gravity="end"
            android:id="@+id/min_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textDirection="locale"
            app:layout_constraintBaseline_toBaselineOf="@+id/min_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="2"
            app:layout_constraintStart_toEndOf="@+id/min_title"
            app:layout_constraintTop_toBottomOf="@+id/max_title"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.huami.bloodoxygen.ui.view.BloodOxygenCardView>
