<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s10"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/actionbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="start|center_vertical"
                android:id="@+id/btn_back"
                android:background="@null"
                android:layout_width="@dimen/size_40dp"
                android:layout_height="match_parent"
                android:src="@drawable/ic_arrow_back_20_2x"
                android:scaleType="center"
                android:tint="@color/s1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textAppearance="@style/Rainbow.TextAppearance.Title3"
                android:textColor="?android:attr/textColorPrimary"
                android:ellipsize="end"
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/as_smart_card_setting"
                android:maxLines="2"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/tv_save"
                app:layout_constraintStart_toEndOf="@+id/btn_back"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:enabled="false"
                android:textColor="@color/btn_text_stupid_color"
                android:gravity="center"
                android:layout_gravity="end|center_vertical"
                android:id="@+id/tv_save"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="@dimen/size_48dp"
                android:text="@string/save"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.appcompat.widget.Toolbar>
    <TextView
        android:textColor="@color/s2"
        android:gravity="center_vertical"
        android:id="@+id/sort_top_label"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:text="@string/as_quick_card_setting_top_tips"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/actionbar"
        style="@style/Rainbow.TextAppearance.Body5"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_app_cards"
        android:background="@drawable/bg_device_setting_unit"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottom_tips"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sort_top_label"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/s2"
        android:gravity="center"
        android:id="@+id/bottom_tips"
        android:padding="@dimen/size_10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/as_quick_card_setting_tips"
        android:paddingStart="25dp"
        android:paddingEnd="25dp"
        app:layout_constraintBottom_toBottomOf="parent"
        style="@style/Rainbow.TextAppearance.Body5"/>
    <View
        android:id="@+id/mask_view"
        android:background="#77f7f7f7"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/actionbar"/>
</androidx.constraintlayout.widget.ConstraintLayout>
