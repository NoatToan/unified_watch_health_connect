<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.wallet.ui.view.NoticeBarView
        android:id="@+id/wl_noticebarview"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_52dp"/>
    <com.huami.wallet.ui.view.MyTextView
        android:ellipsize="marquee"
        android:id="@+id/wl_tv_xiaomi_notice"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_42dp"
        android:scrollHorizontally="true"
        android:singleLine="true"
        android:marqueeRepeatLimit="marquee_forever"
        android:layout_marginStart="@dimen/size_18dp"
        android:layout_marginEnd="@dimen/size_18dp"
        style="@style/NoticeView.Content"/>
    <androidx.core.widget.NestedScrollView
        android:background="@color/s36"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <View
                android:id="@+id/card_image_bg"
                android:background="@color/s36"
                android:paddingTop="@dimen/size_14dp"
                android:paddingBottom="@dimen/size_14dp"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:paddingStart="@dimen/wl_border_margin"
                android:paddingEnd="@dimen/wl_border_margin"
                app:layout_constraintDimensionRatio="324:205"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.cardview.widget.CardView
                android:id="@+id/card"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/size_14dp"
                android:layout_marginBottom="@dimen/size_14dp"
                android:layout_marginStart="@dimen/wl_border_margin"
                android:layout_marginEnd="@dimen/wl_border_margin"
                app:cardCornerRadius="@dimen/wl_image_round_rect_radius"
                app:cardPreventCornerOverlap="false"
                app:layout_constraintDimensionRatio="324:205"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <RelativeLayout
                    android:id="@+id/rl_card"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <ImageView
                        android:id="@+id/card_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/wl_placeholder_image"
                        android:scaleType="centerCrop"/>
                    <TextView
                        android:textSize="@dimen/size_12sp"
                        android:textColor="@color/white100"
                        android:id="@+id/tv_open_card_know"
                        android:background="@drawable/wl_solid_semicircle_shape_gray"
                        android:padding="@dimen/size_6dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/size_14dp"
                        android:text="@string/wl_format_open_card_information"
                        android:drawablePadding="@dimen/size_2dp"
                        android:layout_alignParentBottom="true"
                        android:drawableEnd="@drawable/wl_ic_arrow_right_detail_fragment"
                        android:layout_marginStart="@dimen/size_20dp"
                        android:layout_marginEnd="@dimen/size_15dp"
                        android:layout_alignParentEnd="true"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/rl_card_information"
                    android:background="@color/white_100"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <TextView
                        android:textSize="@dimen/size_14.5sp"
                        android:textStyle="bold"
                        android:textColor="@color/black_80"
                        android:id="@+id/tv_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/size_15dp"
                        android:text="@string/wl_format_open_card_information"
                        android:layout_centerHorizontal="true"
                        android:layout_marginStart="@dimen/size_22dp"
                        android:layout_marginEnd="@dimen/size_22dp"/>
                    <TextView
                        android:textSize="@dimen/size_14.5sp"
                        android:id="@+id/card_information"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="@dimen/size_6dp"
                        android:layout_marginBottom="@dimen/size_24dp"
                        android:scaleType="centerCrop"
                        android:layout_below="@+id/tv_title"
                        android:lineSpacingMultiplier="1.3"
                        android:layout_marginStart="@dimen/size_22dp"
                        android:layout_marginEnd="@dimen/size_22dp"/>
                    <TextView
                        android:textSize="@dimen/size_12sp"
                        android:textColor="@color/black_80"
                        android:id="@+id/tv_return"
                        android:padding="@dimen/size_6dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/size_14dp"
                        android:text="@string/wl_format_open_card_information_return"
                        android:drawablePadding="@dimen/size_2dp"
                        android:layout_alignParentBottom="true"
                        android:drawableEnd="@drawable/default_end_arrow"
                        android:layout_marginStart="@dimen/size_20dp"
                        android:layout_marginEnd="@dimen/size_15dp"
                        android:layout_alignParentEnd="true"/>
                </RelativeLayout>
            </androidx.cardview.widget.CardView>
            <View
                android:id="@+id/view"
                android:background="@color/s36"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="@+id/phone_title"
                app:layout_constraintTop_toTopOf="@+id/service_charge_title"/>
            <TextView
                android:textAppearance="@style/TextAppearance.MiFit.Title2.Inverse"
                android:textColor="@color/s2"
                android:gravity="start|center_vertical"
                android:id="@+id/service_charge_title"
                android:background="@drawable/wl_clickable_item_background"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_58dp"
                android:layout_marginTop="@dimen/wl_item_spacing"
                android:text="@string/wl_service_charge"
                android:paddingStart="@dimen/wl_border_margin"
                android:paddingEnd="@dimen/wl_border_margin"
                app:layout_constraintTop_toBottomOf="@+id/card_image_bg"/>
            <TextView
                android:textAppearance="@style/TextAppearance.MiFit.Caption.Inverse3"
                android:textColor="@color/s2"
                android:id="@+id/service_charge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/wl_border_margin"
                android:layout_marginEnd="@dimen/wl_border_margin"
                app:layout_constraintBottom_toBottomOf="@+id/service_charge_title"
                app:layout_constraintEnd_toEndOf="@+id/service_charge_title"
                app:layout_constraintTop_toTopOf="@+id/service_charge_title"/>
            <TextView
                android:textAppearance="@style/TextAppearance.MiFit.Title2.Inverse"
                android:textColor="@color/s2"
                android:gravity="start|center_vertical"
                android:id="@+id/recharge_amount_title"
                android:background="@drawable/wl_clickable_item_background"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_58dp"
                android:text="@string/wl_recharge_amount"
                android:paddingStart="@dimen/wl_border_margin"
                android:paddingEnd="@dimen/wl_border_margin"
                app:layout_constraintTop_toBottomOf="@+id/service_charge_title"/>
            <TextView
                android:textAppearance="@style/TextAppearance.MiFit.Caption.Inverse3"
                android:textColor="@color/s2"
                android:id="@+id/recharge_amount_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableEnd="@drawable/default_end_arrow"
                android:layout_marginStart="@dimen/wl_border_margin"
                android:layout_marginEnd="@dimen/wl_border_margin"
                app:layout_constraintBottom_toBottomOf="@+id/recharge_amount_title"
                app:layout_constraintEnd_toEndOf="@+id/recharge_amount_title"
                app:layout_constraintTop_toTopOf="@+id/recharge_amount_title"/>
            <TextView
                android:textAppearance="@style/TextAppearance.MiFit.Title2.Inverse"
                android:textColor="@color/s2"
                android:gravity="start|center_vertical"
                android:id="@+id/flash_sale_title"
                android:background="@drawable/wl_clickable_item_background"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_58dp"
                android:text="@string/wl_flash_sale"
                android:paddingStart="@dimen/wl_border_margin"
                android:paddingEnd="@dimen/wl_border_margin"
                app:layout_constraintTop_toBottomOf="@+id/recharge_amount_title"/>
            <TextView
                android:textAppearance="@style/TextAppearance.MiFit.Caption.Inverse3"
                android:textColor="@color/s2"
                android:id="@+id/flash_sale"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/wl_border_margin"
                android:layout_marginEnd="@dimen/wl_border_margin"
                app:layout_constraintBottom_toBottomOf="@+id/flash_sale_title"
                app:layout_constraintEnd_toEndOf="@+id/flash_sale_title"
                app:layout_constraintTop_toTopOf="@+id/flash_sale_title"/>
            <TextView
                android:textAppearance="@style/TextAppearance.MiFit.Title2.Inverse"
                android:textColor="@color/s2"
                android:gravity="start|center_vertical"
                android:id="@+id/coupon_title"
                android:background="@drawable/wl_clickable_item_background"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_58dp"
                android:text="@string/wl_flash_sale"
                android:paddingStart="@dimen/wl_border_margin"
                android:paddingEnd="@dimen/wl_border_margin"
                app:layout_constraintTop_toBottomOf="@+id/flash_sale_title"/>
            <TextView
                android:textColor="@color/s2"
                android:id="@+id/coupon"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableEnd="@drawable/default_end_arrow"
                android:layout_marginStart="@dimen/wl_border_margin"
                android:layout_marginEnd="@dimen/wl_border_margin"
                app:layout_constraintBottom_toBottomOf="@+id/coupon_title"
                app:layout_constraintEnd_toEndOf="@+id/coupon_title"
                app:layout_constraintTop_toTopOf="@+id/coupon_title"/>
            <TextView
                android:textAppearance="@style/TextAppearance.MiFit.Title2.Inverse"
                android:textColor="@color/s2"
                android:gravity="start|center_vertical"
                android:id="@+id/should_pay_amount_title"
                android:background="@drawable/wl_clickable_item_background"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_58dp"
                android:text="@string/wl_pay_money"
                android:paddingStart="@dimen/wl_border_margin"
                android:paddingEnd="@dimen/wl_border_margin"
                app:layout_constraintTop_toBottomOf="@+id/coupon_title"/>
            <TextView
                android:textAppearance="@style/TextAppearance.MiFit.Title.Inverse"
                android:textColor="@color/s2"
                android:id="@+id/should_pay_amount_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/wl_border_margin"
                android:layout_marginEnd="@dimen/wl_border_margin"
                app:layout_constraintBottom_toBottomOf="@+id/should_pay_amount_title"
                app:layout_constraintEnd_toEndOf="@+id/should_pay_amount_title"
                app:layout_constraintTop_toTopOf="@+id/should_pay_amount_title"/>
            <TextView
                android:textAppearance="@style/TextAppearance.MiFit.Title2.Inverse"
                android:textColor="@color/s2"
                android:gravity="start|center_vertical"
                android:id="@+id/phone_title"
                android:background="@drawable/wl_clickable_item_background"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_58dp"
                android:text="@string/wl_reserved_phone"
                android:paddingStart="@dimen/wl_border_margin"
                android:paddingEnd="@dimen/wl_border_margin"
                app:layout_constraintTop_toBottomOf="@+id/should_pay_amount_title"/>
            <TextView
                android:textAppearance="@style/TextAppearance.MiFit.Caption.Blue"
                android:id="@+id/modify_phone_button"
                android:background="@drawable/wl_clickable_item_background"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wl_modify"
                android:layout_marginEnd="@dimen/wl_border_margin"
                app:layout_constraintBottom_toBottomOf="@+id/phone_title"
                app:layout_constraintEnd_toEndOf="@+id/phone_title"
                app:layout_constraintTop_toTopOf="@+id/phone_title"/>
            <TextView
                android:textColor="@color/s2"
                android:id="@+id/phone_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/wl_border_margin"
                android:layout_marginEnd="12dp"
                app:layout_constraintBottom_toBottomOf="@+id/phone_title"
                app:layout_constraintEnd_toStartOf="@+id/modify_phone_button"
                app:layout_constraintTop_toTopOf="@+id/phone_title"/>
            <LinearLayout
                android:gravity="center"
                android:id="@+id/ll_agree"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="55dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/phone_title">
                <CheckBox
                    android:id="@+id/agreement_checkbox"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:button="?android:attr/listChoiceIndicatorMultiple"
                    android:layout_marginStart="@dimen/size_8dp"/>
                <TextView
                    android:textAppearance="@style/TextAppearance.MiFit.Caption.Inverse"
                    android:textColor="@color/s2"
                    android:id="@+id/agree"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/size_6dp"
                    android:layout_marginEnd="@dimen/size_8dp"/>
            </LinearLayout>
            <Button
                android:enabled="true"
                android:id="@+id/open_up_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="18dp"
                android:text="@string/wl_open_card_now"
                android:layout_marginStart="@dimen/wl_border_margin"
                android:layout_marginEnd="@dimen/wl_border_margin"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ll_agree"
                style="@style/Rainbow.Widget.Button.44.Circular"/>
            <View
                android:background="@color/s4"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/card_image_bg"
                style="@style/HorizontalLine.Dim"/>
            <View
                android:background="@color/s4"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/service_charge_title"
                style="@style/HorizontalLine.Dim"/>
            <View
                android:background="@color/s4"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/service_charge_title"
                style="@style/HorizontalLine"/>
            <View
                android:background="@color/s4"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/recharge_amount_title"
                style="@style/HorizontalLine"/>
            <View
                android:id="@+id/flash_sale_divider"
                android:background="@color/s4"
                android:visibility="gone"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/flash_sale_title"
                style="@style/HorizontalLine"/>
            <View
                android:id="@+id/coupon_divider"
                android:background="@color/s4"
                android:visibility="gone"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/coupon_title"
                style="@style/HorizontalLine"/>
            <View
                android:id="@+id/pay_amount_divider"
                android:background="@color/s4"
                android:visibility="gone"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/should_pay_amount_title"
                style="@style/HorizontalLine"/>
            <View
                android:background="@color/s4"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/view"
                style="@style/HorizontalLine.Dim"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
