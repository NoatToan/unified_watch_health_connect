<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/register_scroller"
    android:background="@color/s36"
    android:scrollbars="none"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/s36"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/layout_select_area_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:id="@+id/layout_select_area"
                android:background="@drawable/account_ui_bg_login_edit"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="51dp"
                android:layout_marginStart="@dimen/account_ui_account_side_margin"
                android:layout_marginEnd="@dimen/account_ui_account_side_margin">
                <TextView
                    android:textColor="@color/s1"
                    android:gravity="center_vertical"
                    android:layout_gravity="left"
                    android:id="@+id/tv_select_area"
                    android:paddingLeft="@dimen/account_ui_padding_login_editor_start"
                    android:paddingRight="@dimen/account_ui_select_area_padding_end"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/account_ui_account_select_area"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="right"
                    android:layout_width="@dimen/account_ui_size_24dp"
                    android:layout_height="@dimen/account_ui_size_24dp"
                    android:layout_margin="@dimen/account_ui_size_10dp"
                    android:src="@drawable/account_ui_icon_select_area"/>
            </FrameLayout>
            <TextView
                android:textSize="@dimen/account_ui_size_12sp"
                android:textColor="@color/s3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12.3dp"
                android:text="@string/account_ui_account_select_area_tip"
                android:layout_marginStart="@dimen/account_ui_account_side_margin"
                android:layout_marginEnd="@dimen/account_ui_account_side_margin"/>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/register_form_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <FrameLayout
            android:id="@+id/user_agreement_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</ScrollView>
