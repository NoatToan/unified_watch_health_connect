<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_fitage"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/questionnaireBg"
        android:background="@drawable/pai_detail_block"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:minHeight="104dp"
        app:layout_constraintBottom_toBottomOf="@+id/questionnaireBottomSpace"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/questionnaireTopSpace"/>
    <Space
        android:id="@+id/questionnaireTopSpace"
        android:layout_width="match_parent"
        android:layout_height="15dp"
        android:layout_marginTop="15dp"
        app:layout_constraintBottom_toTopOf="@+id/questionnaireTopBorder"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <Space
        android:id="@+id/questionnaireBottomSpace"
        android:layout_width="match_parent"
        android:layout_height="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/questionnaireBottomBorder"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/questionnaireTopBorder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:barrierDirection="top"
        app:constraint_referenced_ids="questionnaireIcon,questionnaireTitle"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/questionnaireBottomBorder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="questionnaireIcon,questionnaireSubtitle"/>
    <ImageView
        android:id="@+id/questionnaireIcon"
        android:layout_width="75dp"
        android:layout_height="75dp"
        android:src="@drawable/pai_fitness_questionnaire"
        android:layout_marginStart="15dp"
        app:layout_constraintBottom_toBottomOf="@+id/questionnaireBottomSpace"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/questionnaireTopSpace"/>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/s2"
        android:gravity="start"
        android:id="@+id/questionnaireTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2.5dp"
        android:text="@string/pai_get_to_know_your_fitness_age"
        android:layout_marginStart="9dp"
        android:layout_marginEnd="9dp"
        app:layout_constraintBottom_toTopOf="@+id/questionnaireSubtitle"
        app:layout_constraintEnd_toStartOf="@+id/questionnaireArrow"
        app:layout_constraintStart_toEndOf="@+id/questionnaireIcon"
        app:layout_constraintTop_toTopOf="@+id/questionnaireBg"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/s2"
        android:gravity="start"
        android:id="@+id/questionnaireSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2.5dp"
        android:text="@string/pai_click_to_fill_questionnaire"
        android:layout_marginStart="9dp"
        android:layout_marginEnd="9dp"
        app:layout_constraintBottom_toBottomOf="@+id/questionnaireBg"
        app:layout_constraintEnd_toStartOf="@+id/questionnaireArrow"
        app:layout_constraintStart_toEndOf="@+id/questionnaireIcon"
        app:layout_constraintTop_toBottomOf="@+id/questionnaireTitle"/>
    <ImageView
        android:id="@+id/questionnaireArrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_arrow_forward_20_2x"
        android:layout_marginEnd="15dp"
        app:layout_constraintBottom_toBottomOf="@+id/questionnaireBg"
        app:layout_constraintEnd_toEndOf="@+id/questionnaireBg"
        app:layout_constraintTop_toTopOf="@+id/questionnaireBg"
        app:tint="@color/s2"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/questionnaire"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="questionnaireTopSpace,questionnaireBottomSpace,questionnaireArrow,questionnaireBg,questionnaireIcon,questionnaireSubtitle,questionnaireTitle"/>
    <View
        android:id="@+id/ageChartBg"
        android:background="@drawable/pai_detail_block"
        android:layout_width="match_parent"
        android:layout_height="183dp"
        android:layout_marginTop="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/questionnaireBg"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/currentAgeTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:text="@string/pai_current_predicted_age_title"
        android:layout_marginStart="15dp"
        app:layout_constraintStart_toStartOf="@+id/ageChartBg"
        app:layout_constraintTop_toTopOf="@+id/ageChartBg"
        style="@style/Rainbow.TextAppearance.Title3"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/currentAge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawablePadding="2dp"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/currentAgeTitle"
        app:layout_constraintStart_toEndOf="@+id/currentAgeTitle"
        app:layout_constraintTop_toTopOf="@+id/currentAgeTitle"
        style="@style/Rainbow.TextAppearance.Title3"/>
    <FrameLayout
        android:id="@+id/ageChartContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="15dp"
        app:layout_constraintBottom_toBottomOf="@+id/ageChartBg"
        app:layout_constraintEnd_toEndOf="@+id/ageChartBg"
        app:layout_constraintStart_toStartOf="@+id/ageChartBg"
        app:layout_constraintTop_toBottomOf="@+id/currentAgeTitle"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/ageChartArea"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="ageChartBg,currentAgeTitle,currentAge,ageChartContainer"/>
    <View
        android:id="@+id/predictedAgeBg"
        android:background="@drawable/pai_detail_block"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="15dp"
        app:layout_constraintBottom_toBottomOf="@+id/ageSeekbarAreaBottomSpace"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ageChartBg"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/predictedAgeTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="@string/pai_predicted_age_title"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        app:layout_constraintStart_toStartOf="@+id/predictedAgeBg"
        app:layout_constraintTop_toBottomOf="@+id/ageChartBg"
        style="@style/Rainbow.TextAppearance.Title3"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/paiName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:text="@string/pai_name"
        android:layout_marginStart="15dp"
        app:layout_constraintStart_toStartOf="@+id/predictedAgeBg"
        app:layout_constraintTop_toBottomOf="@+id/predictedAgeTitle"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/soughtPai"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="24dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/paiName"
        app:layout_constraintStart_toEndOf="@+id/paiName"
        app:layout_constraintTop_toTopOf="@+id/paiName"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <SeekBar
        android:id="@+id/soughtPaiSeekbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxHeight="8dp"
        android:max="150"
        android:progress="100"
        android:progressDrawable="@drawable/pai_age_seekbar"
        android:thumb="@drawable/pai_seekbar_thumb"
        android:splitTrack="false"
        app:layout_constraintEnd_toEndOf="@+id/predictedAgeBg"
        app:layout_constraintStart_toStartOf="@+id/predictedAgeBg"
        app:layout_constraintTop_toBottomOf="@+id/soughtPai"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/insistDaysTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/pai_insist_days"
        android:layout_marginStart="15dp"
        app:layout_constraintStart_toStartOf="@+id/predictedAgeBg"
        app:layout_constraintTop_toBottomOf="@+id/soughtPaiSeekbar"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/insistDays"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="24dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/insistDaysTitle"
        app:layout_constraintStart_toEndOf="@+id/insistDaysTitle"
        app:layout_constraintTop_toTopOf="@+id/insistDaysTitle"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <SeekBar
        android:id="@+id/insistDaysSeekbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxHeight="8dp"
        android:max="90"
        android:progress="90"
        android:progressDrawable="@drawable/pai_age_seekbar"
        android:thumb="@drawable/pai_seekbar_thumb"
        android:splitTrack="false"
        app:layout_constraintEnd_toEndOf="@+id/predictedAgeBg"
        app:layout_constraintStart_toStartOf="@+id/predictedAgeBg"
        app:layout_constraintTop_toBottomOf="@+id/insistDaysTitle"/>
    <Space
        android:id="@+id/ageSeekbarAreaBottomSpace"
        android:layout_width="match_parent"
        android:layout_height="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/insistDaysSeekbar"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/ageSeekbarArea"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="ageSeekbarAreaBottomSpace,predictedAgeBg,predictedAgeTitle,paiName,insistDaysTitle,soughtPai,insistDays,soughtPaiSeekbar,insistDaysSeekbar"/>
</androidx.constraintlayout.widget.ConstraintLayout>
