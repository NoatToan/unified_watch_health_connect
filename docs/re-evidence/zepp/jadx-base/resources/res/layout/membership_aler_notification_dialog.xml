<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/s38"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_30dp"
        android:src="@drawable/icon_alter_44"/>
    <TextView
        android:textAppearance="@style/Rainbow.TextAppearance.Body3"
        android:textColor="@color/s1"
        android:gravity="top|center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/member_card_alert_msg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_10dp"
        android:layout_alignParentLeft="true"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        style="@style/Rainbow.TextAppearance.Body3"/>
    <Button
        android:textAppearance="@style/Rainbow.TextAppearance.Body3"
        android:textColor="@color/s1"
        android:gravity="center"
        android:id="@+id/member_btn_known"
        android:background="@color/s4"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_55dp"
        android:layout_marginTop="@dimen/size_30dp"
        android:text="@string/ble_known"
        android:textAllCaps="false"
        android:stateListAnimator="@null"/>
</androidx.appcompat.widget.LinearLayoutCompat>
