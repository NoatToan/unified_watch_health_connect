<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <View
        android:layout_gravity="center"
        android:background="@drawable/ic_sky_play_bg"
        android:layout_width="@dimen/size_26dp"
        android:layout_height="@dimen/size_26dp"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/play"
        android:layout_width="32dp"
        android:layout_height="32dp"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/loading"
        android:visibility="gone"
        android:layout_width="32dp"
        android:layout_height="32dp"
        app:lottie_fileName="sky_preference_loading_play.json"
        app:lottie_repeatCount="-1"/>
    <com.huami.sky.ui.view.SkyCircularProgressView
        android:id="@+id/countTimeProgressView"
        android:visibility="gone"
        android:layout_width="32dp"
        android:layout_height="32dp"
        app:borderDrawColor="@color/s46"
        app:borderWidth="@dimen/size_1dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</merge>
