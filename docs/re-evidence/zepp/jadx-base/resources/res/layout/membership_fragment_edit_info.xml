<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.lib.rainbow.titlebar.RainbowTitleBar
        android:id="@+id/rainbow_title_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:menuText="@string/save"
        app:navigationText="@string/cancel"
        app:title="@string/membership_title_input_info"/>
    <androidx.cardview.widget.CardView
        android:id="@+id/cardView_info_edit"
        android:background="@color/s38"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_12dp"
        android:layout_marginStart="@dimen/size_10dp"
        android:layout_marginEnd="@dimen/size_10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rainbow_title_bar">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:focusableInTouchMode="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/s1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_14dp"
                android:text="@string/membership_card_name"
                android:layout_marginStart="@dimen/size_14dp"/>
            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/edit_name"
                android:background="@drawable/membership_card_border"
                android:paddingLeft="@dimen/size_12dp"
                android:paddingRight="@dimen/size_12dp"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_44dp"
                android:layout_marginTop="@dimen/size_10dp"
                android:inputType="text"
                android:paddingEnd="@dimen/size_12dp"
                android:layout_marginStart="@dimen/size_12dp"
                android:layout_marginEnd="@dimen/size_18dp"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/s1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_14dp"
                android:text="@string/membership_card_info"
                android:layout_marginStart="@dimen/size_14dp"/>
            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/edit_number"
                android:background="@drawable/membership_card_border"
                android:paddingLeft="@dimen/size_12dp"
                android:paddingRight="@dimen/size_12dp"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_44dp"
                android:layout_marginTop="@dimen/size_10dp"
                android:layout_marginBottom="@dimen/size_26dp"
                android:inputType="text"
                android:layout_marginStart="@dimen/size_12dp"
                android:layout_marginEnd="@dimen/size_18dp"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView
        android:background="@color/s38"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_12dp"
        android:layout_marginStart="@dimen/size_10dp"
        android:layout_marginEnd="@dimen/size_10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardView_info_edit">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="@dimen/size_20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/s1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_14dp"
                android:text="@string/membership_card_select_color"
                android:layout_marginStart="@dimen/size_14dp"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_view_color"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/size_14dp"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="6"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
