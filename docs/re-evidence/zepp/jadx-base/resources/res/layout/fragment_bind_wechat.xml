<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s36"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.lib.rainbow.titlebar.RainbowTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/bind_wechat_title"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/view_save_qr"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/title_bar">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/img_qr"
            android:layout_width="@dimen/qr_size"
            android:layout_height="@dimen/qr_size"
            android:layout_marginTop="@dimen/qr_top_margin"
            android:contentDescription="微信二维码"/>
        <TextView
            android:textColor="@color/s1"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qr_bottom_margin"
            android:text="@string/wechat_scan_qrcode_text"
            android:layout_marginStart="@dimen/desc_left_margin"
            android:layout_marginEnd="@dimen/desc_left_margin"
            style="@style/Rainbow.TextAppearance.Body2"/>
        <TextView
            android:textColor="@color/s2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/desc_top_margin"
            android:text="@string/save_qr_way_desc"
            android:layout_marginStart="@dimen/desc_left_margin"
            android:layout_marginEnd="@dimen/desc_left_margin"
            style="@style/Rainbow.TextAppearance.Body4"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/view_send_qr"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/title_bar">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/img_watch_qr"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/watch_qr_height"
            android:layout_marginTop="@dimen/watch_top_margin"
            android:src="@drawable/ic_watch_qr_code"
            android:contentDescription="手表微信二维码"/>
        <TextView
            android:textColor="@color/s1"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/watch_bottom_margin"
            android:text="@string/wechat_scan_qrcode_text"
            android:layout_marginStart="@dimen/desc_left_margin"
            android:layout_marginEnd="@dimen/desc_left_margin"
            style="@style/Rainbow.TextAppearance.Body2"/>
        <TextView
            android:textColor="@color/s2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/desc_top_margin"
            android:text="@string/watch_way_desc"
            android:layout_marginStart="@dimen/desc_left_margin"
            android:layout_marginEnd="@dimen/desc_left_margin"
            style="@style/Rainbow.TextAppearance.Body4"/>
    </LinearLayout>
    <TextView
        android:textColor="@color/s2"
        android:gravity="center_horizontal"
        android:id="@+id/bind_tips"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/qr_top_margin"
        android:text="@string/wechat_bind_tips"
        android:layout_marginStart="@dimen/desc_left_margin"
        android:layout_marginEnd="@dimen/desc_left_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/Rainbow.TextAppearance.Body5"/>
    <com.huami.lib.rainbow.button.RainbowButton
        android:id="@+id/btn_other_way"
        android:visibility="gone"
        android:layout_width="@dimen/watch_qr_height"
        android:layout_height="@dimen/desc_top_margin"
        android:layout_marginBottom="@dimen/tips_top_margin"
        android:text="@string/wechat_bind_other_way"
        app:layout_constraintBottom_toTopOf="@+id/bind_tips"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="?attr/buttonStyleGray_48_flat"/>
    <com.huami.lib.rainbow.button.RainbowButton
        android:id="@+id/btn_do_qr"
        android:layout_width="@dimen/watch_qr_height"
        android:layout_height="@dimen/desc_top_margin"
        android:layout_marginBottom="@dimen/d5"
        app:layout_constraintBottom_toTopOf="@+id/btn_other_way"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
