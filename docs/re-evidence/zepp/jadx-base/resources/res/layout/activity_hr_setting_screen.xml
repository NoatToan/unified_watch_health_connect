<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <View
        android:background="@color/split_color"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <androidx.core.widget.NestedScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.huami.lib.view.ItemView
                android:id="@+id/hr_detect_item"
                android:background="@color/white100"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:itemEndArrow="true"
                app:itemSummary="@string/setting_heartrate_alert_wuhan_india_tips_msg"
                app:itemTitle="@string/setting_heartrate_detect_mode"/>
            <com.huami.lib.view.ItemView
                android:id="@+id/hr_freq_item"
                android:background="@color/white100"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:itemSummary="@string/open_auto_hr_detect_tips"
                app:itemTitle="@string/setting_heartrate_detect_freq"/>
            <com.huami.lib.view.ItemView
                android:id="@+id/sport_detect_item"
                android:background="@color/white100"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:itemEndArrow="false"
                app:itemSummary="@string/sport_hr_detect_tips"
                app:itemSwitch="true"
                app:itemTitle="@string/setting_heartrate_detect_sport_detect"/>
            <com.huami.lib.view.ItemView
                android:id="@+id/hr_alert_item"
                android:background="@color/white100"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:itemEndArrow="false"
                app:itemSummary="@string/hr_detect_alert_tips"
                app:itemSwitch="true"
                app:itemTitle="@string/setting_heartrate_alert_title"/>
            <com.huami.lib.view.ItemView
                android:id="@+id/hr_alert_value_item"
                android:background="@color/white100"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:itemTitle="@string/setting_heartrate_alert_value_title"/>
            <com.huami.lib.view.ItemView
                android:id="@+id/all_day_pressure_item"
                android:background="@color/white100"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:itemSwitch="true"
                app:itemTitle="@string/all_day_pressure_detect"/>
            <com.huami.lib.view.ItemView
                android:id="@+id/spo2_osa_item"
                android:background="@color/white100"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:itemSummary="@string/sleep_spo2_detect_summary_no_osa"
                app:itemSwitch="true"
                app:itemTitle="@string/sleep_spo2_detect_no_osa"
                app:itemTitleTipIcon="@drawable/ic_sleep_spo2_beat"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
