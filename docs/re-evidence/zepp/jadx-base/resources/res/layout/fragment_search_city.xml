<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s38"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/search_city_container"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="horizontal"
            android:background="@drawable/huamios_search_city"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:layout_weight="1"
            android:layout_marginStart="20dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_city_search"
                android:layout_marginStart="14dp"/>
            <EditText
                android:textSize="13sp"
                android:textColor="@color/s1"
                android:textColorHint="@color/s3"
                android:layout_gravity="center_vertical"
                android:id="@+id/search_city_et"
                android:background="@drawable/huamios_search_city"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:hint="@string/huamios_weather_city_search_hint"
                android:maxLines="1"
                android:layout_weight="1"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:textCursorDrawable="@drawable/edittext_cursor"
                android:layout_marginStart="6dp"/>
        </LinearLayout>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/s1"
            android:layout_gravity="center_vertical"
            android:id="@+id/weather_cancel_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancel"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"/>
    </LinearLayout>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/s1"
        android:id="@+id/hot_city_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/weather_city_hot"
        android:layout_marginStart="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/search_city_container"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/hot_city_rc"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        app:layout_constraintTop_toBottomOf="@+id/hot_city_tv"/>
    <FrameLayout
        android:id="@+id/city_result_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/search_city_container"/>
</androidx.constraintlayout.widget.ConstraintLayout>
