<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/weighting_result_op_rl"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="36dp"
    android:layout_alignParentBottom="true">
    <TextView
        android:textSize="14sp"
        android:textColor="@color/s1"
        android:gravity="center"
        android:id="@+id/weighting_bf_help"
        android:layout_width="80dp"
        android:layout_height="60dp"
        android:text="@string/weighting_weight_bf_help"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/s1"
        android:gravity="center"
        android:id="@+id/weighting_bf_abandon"
        android:layout_width="80dp"
        android:layout_height="60dp"
        android:layout_marginTop="10dp"
        android:text="@string/weighting_weight_bf_abandon"
        android:layout_below="@+id/weighting_bf_help"
        android:layout_marginStart="44dp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/p3"
        android:gravity="center"
        android:id="@+id/weighting_bf_save"
        android:layout_width="80dp"
        android:layout_height="60dp"
        android:layout_marginTop="10dp"
        android:text="@string/weighting_weight_bf_save"
        android:layout_below="@+id/weighting_bf_help"
        android:layout_marginEnd="44dp"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
