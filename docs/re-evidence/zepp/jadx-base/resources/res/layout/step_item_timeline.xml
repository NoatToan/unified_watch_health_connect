<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="68dp"
    android:paddingStart="18dp">
    <ImageView
        android:id="@+id/step_time_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="12sp"
        android:textColor="@color/s2"
        android:id="@+id/step_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12.8dp"
        android:layout_alignBaseline="@+id/step_time_line"
        android:fontFamily="lt"
        android:layout_marginStart="13dp"
        android:layout_toEndOf="@+id/step_time_line"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="12sp"
        android:textColor="@color/s2"
        android:id="@+id/step_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12.8dp"
        android:layout_alignBaseline="@+id/step_time_line"
        android:fontFamily="lt"
        android:layout_marginEnd="18dp"
        android:layout_alignParentEnd="true"/>
    <com.huami.step.view.StepUnitTextView
        android:textSize="16sp"
        android:textColor="@color/s1"
        android:id="@+id/step_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3.3dp"
        android:layout_below="@+id/step_title"
        android:layout_marginStart="12dp"
        android:layout_toEndOf="@+id/step_time_line"
        app:stepUnitColor="@color/s3"
        app:stepUnitSize="12sp"/>
    <com.huami.step.view.StepUnitTextView
        android:textSize="16sp"
        android:textColor="@color/s1"
        android:id="@+id/step_distance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3.3dp"
        android:layout_below="@+id/step_title"
        android:layout_marginStart="12dp"
        android:layout_toEndOf="@+id/step_value"
        app:stepUnitColor="@color/s3"
        app:stepUnitSize="12sp"/>
    <com.huami.step.view.StepUnitTextView
        android:textSize="16sp"
        android:textColor="@color/s1"
        android:id="@+id/step_calorie"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3.3dp"
        android:layout_below="@+id/step_title"
        android:layout_marginStart="12dp"
        android:layout_toEndOf="@+id/step_distance"
        app:stepUnitColor="@color/s3"
        app:stepUnitSize="12sp"/>
</RelativeLayout>
