<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.lib.rainbow.titlebar.RainbowTitleBar
        android:id="@+id/action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationIcon="@drawable/ic_arrow_back_20_2x"
        app:title="@string/setting_app_moreset"/>
    <FrameLayout
        android:id="@+id/auto_ota_at_night_setting_tips_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.huami.lib.rainbow.ListTile
        android:id="@+id/auto_ota_at_night_switch"
        android:background="@drawable/bg_device_setting_unit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_15dp"
        app:ltv_subtitle="@string/auto_ota_at_night_summary"
        app:ltv_title="@string/auto_ota_at_night"/>
</LinearLayout>
