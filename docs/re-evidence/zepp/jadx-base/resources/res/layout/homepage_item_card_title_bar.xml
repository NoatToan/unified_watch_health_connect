<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="30dp">
    <TextView
        android:textColor="@color/s1"
        android:ellipsize="end"
        android:id="@+id/card_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        android:adjustViewBounds="true"
        android:maxWidth="295dp"
        android:maxLines="1"
        android:layout_marginStart="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Rainbow.TextAppearance.Body3"/>
    <TextView
        android:textColor="@color/s3"
        android:id="@+id/last_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        app:layout_constraintBaseline_toBaselineOf="@+id/card_title"
        app:layout_constraintBottom_toBottomOf="@+id/card_title"
        app:layout_constraintStart_toEndOf="@+id/card_title"
        style="@style/Rainbow.TextAppearance.Body5"/>
    <TextView
        android:textColor="@color/s1"
        android:ellipsize="end"
        android:id="@+id/card_second_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        android:maxWidth="145dp"
        android:maxLines="1"
        android:layout_marginStart="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/homepage_card_guideline"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5"
        style="@style/Rainbow.TextAppearance.Body3"/>
    <TextView
        android:textColor="@color/s3"
        android:id="@+id/second_last_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        app:layout_constraintBaseline_toBaselineOf="@+id/card_second_title"
        app:layout_constraintBottom_toBottomOf="@+id/card_second_title"
        app:layout_constraintStart_toEndOf="@+id/card_second_title"
        style="@style/Rainbow.TextAppearance.Body5"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/fold_button"
        android:padding="7dp"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/ic_expand_more_20"
        android:tint="@color/s2"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/card_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/card_title"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/homepage_card_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
</androidx.constraintlayout.widget.ConstraintLayout>
