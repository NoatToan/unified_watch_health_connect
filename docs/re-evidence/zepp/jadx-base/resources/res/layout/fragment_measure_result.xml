<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@drawable/bg_input_measure_result"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="30dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="50dp"
        android:paddingEnd="50dp">
        <TextView
            android:textSize="18sp"
            android:textColor="@color/s1"
            android:id="@+id/input_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/s2"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/blood_pressure_result_input_summary_new"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>
            <TextView
                android:textSize="27sp"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:id="@+id/input_times_one"
                android:background="@drawable/bg_measure_result_input_times"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:text="1"/>
            <View
                android:id="@+id/input_line_one"
                android:background="@drawable/bg_measure_item_line"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="2"/>
            <TextView
                android:enabled="false"
                android:textSize="27sp"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:id="@+id/input_times_two"
                android:background="@drawable/bg_measure_result_input_times"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:text="2"/>
            <View
                android:id="@+id/input_line_two"
                android:background="@drawable/bg_measure_item_line"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="2"/>
            <TextView
                android:enabled="false"
                android:textSize="27sp"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:id="@+id/input_times_three"
                android:background="@drawable/bg_measure_result_input_times"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:text="3"/>
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:background="@drawable/bg_measure_result_input"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="20dp"
            android:paddingStart="10dp"
            android:paddingEnd="23dp">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/s1"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/systolic_high"/>
            <EditText
                android:textSize="16sp"
                android:textColor="@color/s2"
                android:gravity="center_vertical"
                android:id="@+id/systolic_edit"
                android:background="@android:color/transparent"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:inputType="number"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/s2"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/blood_pressure_result_unit"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:background="@drawable/bg_measure_result_input"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="20dp"
            android:paddingStart="10dp"
            android:paddingEnd="23dp">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/s1"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/diastolic_low"/>
            <EditText
                android:textSize="16sp"
                android:textColor="@color/s2"
                android:gravity="center_vertical"
                android:id="@+id/diastolic_edit"
                android:background="@android:color/transparent"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:inputType="number"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/s2"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/blood_pressure_result_unit"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="40dp">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/s2"
            android:gravity="center"
            android:id="@+id/re_measure"
            android:background="@drawable/bg_input_re_measure"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/blood_pressure_re_measure"
            android:layout_weight="1"/>
        <View
            android:layout_gravity="center_vertical"
            android:background="@color/s4"
            android:layout_width="0.3dp"
            android:layout_height="24dp"/>
        <TextView
            android:enabled="false"
            android:textSize="16sp"
            android:textColor="@color/input_save_btn_color"
            android:gravity="center"
            android:id="@+id/btn_save"
            android:background="@drawable/bg_input_submit"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/btn_save"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
