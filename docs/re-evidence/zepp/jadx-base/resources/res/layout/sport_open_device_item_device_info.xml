<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s38"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="86dp">
    <ImageView
        android:id="@+id/device_drawing"
        android:layout_width="53dp"
        android:layout_height="53dp"
        android:layout_marginTop="10dp"
        android:layout_marginStart="19dp"/>
    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/device_open_switch"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginTop="20dp"
        android:thumb="@drawable/sport_open_device_switch_thumb"
        android:layout_marginEnd="14dp"
        android:layout_alignParentEnd="true"
        app:showText="false"
        app:switchMinWidth="48dp"
        app:track="@drawable/sport_open_device_switch_track"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/s1"
        android:ellipsize="end"
        android:id="@+id/device_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="17dp"
        android:maxWidth="200dp"
        android:maxLines="1"
        android:layout_marginStart="9.3dp"
        android:layout_toEndOf="@+id/device_drawing"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/s1"
        android:ellipsize="end"
        android:id="@+id/device_connect_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_alignBaseline="@+id/device_name"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="5dp"
        android:layout_toStartOf="@+id/device_open_switch"
        android:layout_toEndOf="@+id/device_name"/>
    <com.xiaomi.hm.health.ui.sportdevice.view.AutoLineFeedLayout
        android:id="@+id/sport_device_support_analysis_type_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="20dp"
        android:layout_below="@+id/device_name"
        android:layout_marginStart="9.3dp"
        android:layout_marginEnd="10dp"
        android:layout_toStartOf="@+id/device_open_switch"
        android:layout_toEndOf="@+id/device_drawing"/>
    <View
        android:background="@color/s4"
        android:layout_width="match_parent"
        android:layout_height="0.3dp"
        android:layout_marginTop="1dp"
        android:layout_below="@+id/sport_device_support_analysis_type_container"
        android:layout_marginStart="14.3dp"/>
</RelativeLayout>
