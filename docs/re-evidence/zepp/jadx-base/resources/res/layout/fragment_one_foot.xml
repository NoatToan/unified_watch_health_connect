<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/scale_measuring_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="18sp"
        android:textColor="@color/s1"
        android:id="@+id/weighting_title_id"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:text="@string/one_foot_measuring"
        android:layout_centerHorizontal="true"/>
    <com.xiaomi.hm.health.bodyfat.view.WeightingDynamicWeightView
        android:id="@+id/weight_dynamic_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:layout_below="@+id/weighting_title_id"
        android:layout_centerHorizontal="true"/>
    <FrameLayout
        android:id="@+id/family_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</RelativeLayout>
