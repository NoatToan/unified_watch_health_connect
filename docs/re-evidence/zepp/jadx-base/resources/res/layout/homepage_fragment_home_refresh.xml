<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="20dp"
    android:layout_height="20dp">
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/homepage_connecting_icon"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        app:lottie_repeatCount="-1"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/homepage_connect_success_icon"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/homepage_connect_fail_icon"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"/>
    <com.huami.devicestylepower.DeviceImageView
        android:id="@+id/homepage_device_icon"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:scaleType="fitXY"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/homepage_device_bind"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        app:srcCompat="@drawable/ic_add_20"
        app:tint="@color/s1"/>
</FrameLayout>
