<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="bottom"
    android:orientation="horizontal"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/shadow"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:src="@drawable/above_shadow"/>
    <RelativeLayout
        android:id="@+id/rlyt_tip_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/shadow">
        <ImageView
            android:id="@+id/iv_tips_left_img"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:src="@drawable/ic_card_icon_hr"
            android:layout_marginStart="23dp"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:id="@+id/tv_tips_title"
            android:layout_marginTop="18dp"
            android:layout_marginStart="11dp"
            android:layout_toEndOf="@+id/iv_tips_left_img"
            style="@style/Txt.Black"/>
        <TextView
            android:id="@+id/tv_tips_info"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="18dp"
            android:layout_below="@+id/tv_tips_title"
            android:layout_toStartOf="@+id/right_icon_area"
            android:layout_alignStart="@+id/tv_tips_title"
            style="@style/Txt.Grey"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/right_icon_area"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginEnd="10dp"
            android:layout_alignParentEnd="true">
            <ImageView
                android:id="@+id/iv_tips_right_img"
                android:padding="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_card_icon_hr"/>
            <ImageView
                android:id="@+id/iv_tips_right_bottom_img"
                android:padding="5dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_card_icon_hr"/>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
