<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/s36"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/scale_img"
        android:layout_width="232dp"
        android:layout_height="232dp"
        android:src="@drawable/bg_scale_breath"
        android:layout_centerInParent="true"/>
    <com.huami.watch.companion.ui.view.HuaMiFontTextView
        android:textSize="36sp"
        android:textColor="#ffffff"
        android:id="@+id/time_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/s1"
        android:id="@+id/duration_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/duration_msg_text"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/s1"
        android:id="@+id/duration_msg_text"
        android:paddingBottom="70dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
    <ImageView
        android:padding="16dp"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:src="@drawable/ic_earbud_breath_close"
        android:onClick="stopBreath"/>
</RelativeLayout>
