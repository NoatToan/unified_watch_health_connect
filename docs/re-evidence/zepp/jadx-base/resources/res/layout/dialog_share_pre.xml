<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/running_gps_dialog_bg"
    android:paddingBottom="30dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="14sp"
        android:textColor="@color/color_666666"
        android:id="@+id/cancel_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cancel"
        android:layout_marginStart="15.8dp"
        app:layout_constraintBottom_toBottomOf="@+id/title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/title"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/black"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10.6dp"
        android:text="@string/run_share_type"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/line"
        android:background="#eeeeee"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="42.7dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/center_gu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/start_gu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.1"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/end_gu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.9"/>
    <ImageView
        android:id="@+id/run_share_long_img"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28.8dp"
        android:src="@drawable/run_share_long_img"
        android:contentDescription="@string/run_share_type"
        app:layout_constraintEnd_toEndOf="@+id/center_gu"
        app:layout_constraintStart_toStartOf="@+id/start_gu"
        app:layout_constraintTop_toTopOf="@+id/line"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/black"
        android:gravity="center"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/run_share_type_img"
        app:layout_constraintEnd_toEndOf="@+id/center_gu"
        app:layout_constraintStart_toStartOf="@+id/start_gu"
        app:layout_constraintTop_toBottomOf="@+id/run_share_long_img"/>
    <ImageView
        android:id="@+id/run_share_long_cam"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28.8dp"
        android:src="@drawable/run_share_long_cam"
        android:contentDescription="@string/run_share_type"
        app:layout_constraintEnd_toEndOf="@+id/end_gu"
        app:layout_constraintStart_toStartOf="@+id/center_gu"
        app:layout_constraintTop_toTopOf="@+id/line"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/black"
        android:gravity="center"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/run_share_type_cam"
        app:layout_constraintEnd_toEndOf="@+id/end_gu"
        app:layout_constraintStart_toStartOf="@+id/center_gu"
        app:layout_constraintTop_toBottomOf="@+id/run_share_long_cam"/>
</androidx.constraintlayout.widget.ConstraintLayout>
