<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.lib.rainbow.titlebar.RainbowTitleBar
        android:id="@+id/rainbowTitleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/headset_settings_action"/>
    <ScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never">
        <TabHost
            android:id="@android:id/tabhost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TabWidget
                    android:id="@android:id/tabs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <FrameLayout
                    android:id="@+id/container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <FrameLayout
                    android:id="@android:id/tabcontent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_10dp">
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/left_ear_setting"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <androidx.cardview.widget.CardView
                            android:background="@color/s38"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/size_15dp"
                            android:layout_marginEnd="@dimen/size_15dp"
                            app:cardBackgroundColor="@color/s38"
                            app:cardCornerRadius="6dp"
                            app:cardElevation="0px"
                            app:cardUseCompatPadding="false">
                            <LinearLayout
                                android:orientation="vertical"
                                android:id="@+id/headset_left_ll"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">
                                <com.huami.lib.rainbow.ListTile
                                    android:id="@+id/headset_left_long_press"
                                    android:background="@color/s38"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    app:ltv_subtitle="@string/headset_long_press_summary"
                                    app:ltv_title="@string/headset_long_press_title"/>
                                <CheckBox
                                    android:textSize="15sp"
                                    android:textColor="@color/s1"
                                    android:id="@+id/headset_left_noise_control_mode_reduction"
                                    android:background="@android:color/transparent"
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/size_64dp"
                                    android:button="@null"
                                    android:text="@string/settings_item_noise_reduction"
                                    android:foregroundGravity="fill"
                                    android:drawableEnd="@drawable/box_red_selector"
                                    android:paddingStart="@dimen/size_4_dot_5dp"
                                    android:layout_marginStart="@dimen/d4"
                                    android:layout_marginEnd="@dimen/d4"/>
                                <CheckBox
                                    android:textSize="15sp"
                                    android:textColor="@color/s1"
                                    android:id="@+id/headset_left_noise_control_mode_penetrate"
                                    android:background="@android:color/transparent"
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/size_64dp"
                                    android:button="@null"
                                    android:text="@string/noise_control_mode_penetrate"
                                    android:drawableEnd="@drawable/box_red_selector"
                                    android:paddingStart="@dimen/size_4_dot_5dp"
                                    android:layout_marginStart="@dimen/d4"
                                    android:layout_marginEnd="@dimen/d4"/>
                                <CheckBox
                                    android:textSize="15sp"
                                    android:textColor="@color/s1"
                                    android:id="@+id/headset_left_noise_control_mode_close"
                                    android:background="@android:color/transparent"
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/size_64dp"
                                    android:button="@null"
                                    android:text="@string/noise_control_mode_close"
                                    android:drawableEnd="@drawable/box_red_selector"
                                    android:paddingStart="@dimen/size_4_dot_5dp"
                                    android:layout_marginStart="@dimen/d4"
                                    android:layout_marginEnd="@dimen/d4"/>
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>
                        <androidx.cardview.widget.CardView
                            android:background="@color/s38"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/size_15dp"
                            android:layout_marginStart="@dimen/size_15dp"
                            android:layout_marginEnd="@dimen/size_15dp"
                            app:cardBackgroundColor="@color/s38"
                            app:cardCornerRadius="6dp"
                            app:cardElevation="0px"
                            app:cardUseCompatPadding="false">
                            <LinearLayout
                                android:orientation="vertical"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">
                                <com.huami.lib.rainbow.ListTile
                                    android:id="@+id/headset_left_short_press"
                                    android:background="@color/s38"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    app:ltv_title="@string/headset_short_press"/>
                                <com.huami.lib.rainbow.ListTile
                                    android:id="@+id/headset_left_short_press_twice"
                                    android:background="@color/s38"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    app:ltv_title="@string/headset_short_press_twice"/>
                                <com.huami.lib.rainbow.ListTile
                                    android:id="@+id/headset_left_short_press_three_times"
                                    android:background="@color/s38"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    app:ltv_title="@string/headset_short_press_three_times"/>
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/right_ear_setting"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <androidx.cardview.widget.CardView
                            android:background="@color/s38"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/size_15dp"
                            android:layout_marginEnd="@dimen/size_15dp"
                            app:cardBackgroundColor="@color/s38"
                            app:cardCornerRadius="6dp"
                            app:cardElevation="0px"
                            app:cardUseCompatPadding="false">
                            <LinearLayout
                                android:orientation="vertical"
                                android:id="@+id/headset_right_ll"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">
                                <com.huami.lib.rainbow.ListTile
                                    android:id="@+id/headset_right_long_press"
                                    android:background="@color/s38"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    app:ltv_subtitle="@string/headset_long_press_summary"
                                    app:ltv_title="@string/headset_long_press_title"/>
                                <CheckBox
                                    android:textSize="15sp"
                                    android:textColor="@color/s1"
                                    android:id="@+id/headset_right_noise_control_mode_reduction"
                                    android:background="@android:color/transparent"
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/size_64dp"
                                    android:button="@null"
                                    android:text="@string/settings_item_noise_reduction"
                                    android:drawableEnd="@drawable/box_red_selector"
                                    android:paddingStart="@dimen/size_4_dot_5dp"
                                    android:layout_marginStart="@dimen/d4"
                                    android:layout_marginEnd="@dimen/d4"/>
                                <CheckBox
                                    android:textSize="15sp"
                                    android:textColor="@color/s1"
                                    android:id="@+id/headset_right_noise_control_mode_penetrate"
                                    android:background="@android:color/transparent"
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/size_64dp"
                                    android:button="@null"
                                    android:text="@string/noise_control_mode_penetrate"
                                    android:drawableEnd="@drawable/box_red_selector"
                                    android:paddingStart="@dimen/size_4_dot_5dp"
                                    android:layout_marginStart="@dimen/d4"
                                    android:layout_marginEnd="@dimen/d4"/>
                                <CheckBox
                                    android:textSize="15sp"
                                    android:textColor="@color/s1"
                                    android:id="@+id/headset_right_noise_control_mode_close"
                                    android:background="@android:color/transparent"
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/size_64dp"
                                    android:button="@null"
                                    android:text="@string/noise_control_mode_close"
                                    android:drawableEnd="@drawable/box_red_selector"
                                    android:paddingStart="@dimen/size_4_dot_5dp"
                                    android:layout_marginStart="@dimen/d4"
                                    android:layout_marginEnd="@dimen/d4"/>
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>
                        <androidx.cardview.widget.CardView
                            android:background="@color/s38"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/size_15dp"
                            android:layout_marginStart="@dimen/size_15dp"
                            android:layout_marginEnd="@dimen/size_15dp"
                            app:cardBackgroundColor="@color/s38"
                            app:cardCornerRadius="6dp"
                            app:cardElevation="0px"
                            app:cardUseCompatPadding="false">
                            <LinearLayout
                                android:orientation="vertical"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">
                                <com.huami.lib.rainbow.ListTile
                                    android:id="@+id/headset_right_short_press"
                                    android:background="@color/s38"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    app:ltv_title="@string/headset_short_press"/>
                                <com.huami.lib.rainbow.ListTile
                                    android:id="@+id/headset_right_short_press_twice"
                                    android:background="@color/s38"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    app:ltv_title="@string/headset_short_press_twice"/>
                                <com.huami.lib.rainbow.ListTile
                                    android:id="@+id/headset_right_short_press_three_times"
                                    android:background="@color/s38"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    app:ltv_title="@string/headset_short_press_three_times"/>
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>
                    </LinearLayout>
                </FrameLayout>
                <Space
                    android:background="@color/transparent"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size_20dp"/>
                <Button
                    android:textColor="@color/s1"
                    android:id="@+id/headset_action_default_bt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/size_10dp"
                    android:text="@string/headset_action_reset_default"
                    android:layout_marginStart="@dimen/size_21dp"
                    android:layout_marginEnd="@dimen/size_21dp"
                    android:backgroundTint="@color/s38"/>
            </LinearLayout>
        </TabHost>
    </ScrollView>
</androidx.appcompat.widget.LinearLayoutCompat>
