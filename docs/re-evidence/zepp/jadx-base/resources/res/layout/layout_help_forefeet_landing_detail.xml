<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="13.3sp"
        android:textColor="@color/run_white_50_percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/running_help_fore_feet_display_prompt"/>
    <View
        android:background="@color/white10"
        android:layout_width="match_parent"
        android:layout_height="0.7dp"
        android:layout_marginTop="30dp"/>
    <TextView
        android:textSize="13.3sp"
        android:textColor="@color/run_white_50_percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="@string/running_help_fore_feet_compare"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/run_white_30_percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="13.3dp"
        android:text="@string/running_help_fore_feet_compare_desc"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:background="@drawable/icon_running_help_forefeet_figure1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="26.7dp"/>
    <TextView
        android:textSize="13.3sp"
        android:textColor="@color/run_white_50_percent"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="@string/running_help_fore_feet_try"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/run_white_30_percent"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="13.3dp"
        android:text="@string/running_help_fore_feet_try_desc1"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:background="@drawable/icon_running_help_forefeet_figure2"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="26.7dp"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/run_white_30_percent"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="@string/running_help_fore_feet_try_desc2"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:background="@drawable/icon_running_help_forefeet_figure3"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="26.7dp"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/run_white_30_percent"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="@string/running_help_fore_feet_try_desc3"/>
</LinearLayout>
