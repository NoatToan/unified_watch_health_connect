<?xml version="1.0" encoding="utf-8"?>
<com.huami.lib.rainbow.shapeable.ShapeableConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s38"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:shapeAppearance="@style/ShapeAppearance.App.Rounded">
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/permission_center_item_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toStartOf="@+id/permission_center_item_status"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Rainbow.TextAppearance.Title3"/>
    <TextView
        android:textColor="@color/s2"
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/permission_center_item_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/permission_center_item_title"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <TextView
        android:textColor="@color/s2"
        android:id="@+id/permission_center_item_content"
        android:paddingBottom="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/permission_center_item_title"
        style="@style/Rainbow.TextAppearance.Body4"/>
</com.huami.lib.rainbow.shapeable.ShapeableConstraintLayout>
