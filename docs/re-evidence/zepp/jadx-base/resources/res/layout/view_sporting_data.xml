<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:id="@+id/fl_data_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">
            <com.huami.widget.typeface.TypefaceTextView
                android:textColor="@color/white"
                android:layout_gravity="center"
                android:id="@+id/tv_data"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="din-med"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/white"
                android:ellipsize="middle"
                android:layout_gravity="center"
                android:id="@+id/tv_tips"
                android:background="@drawable/bg_sporting_data_tips"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="104dp"
                android:singleLine="true"/>
        </FrameLayout>
        <ImageView
            android:id="@+id/iv_warning"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_sporting_warning"
            android:layout_centerVertical="true"
            android:layout_marginStart="5dp"
            android:layout_toEndOf="@+id/fl_data_container"/>
    </RelativeLayout>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="15.3sp"
        android:textColor="@color/txt_color_sporting_data_desc"
        android:layout_gravity="center"
        android:id="@+id/tv_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="din-med"/>
</merge>
