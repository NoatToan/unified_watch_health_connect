<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textColor="@color/s2"
        android:id="@+id/tv_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/segment_title_exercise_name"
        android:layout_marginStart="44dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Rainbow.TextAppearance.Body5"/>
    <TextView
        android:textColor="@color/s2"
        android:gravity="center_horizontal"
        android:id="@+id/tv_count"
        android:layout_width="46dp"
        android:layout_height="wrap_content"
        android:text="@string/modify_count"
        android:layout_marginEnd="13dp"
        app:layout_constraintEnd_toStartOf="@+id/tv_weight"
        app:layout_constraintTop_toTopOf="@+id/tv_weight"
        style="@style/Rainbow.TextAppearance.Body5"/>
    <TextView
        android:textColor="@color/s2"
        android:gravity="center_horizontal"
        android:id="@+id/tv_weight"
        android:layout_width="61dp"
        android:layout_height="wrap_content"
        android:text="@string/modify_weight_segment"
        android:layout_marginEnd="17dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_name"
        style="@style/Rainbow.TextAppearance.Body5"/>
</androidx.constraintlayout.widget.ConstraintLayout>
