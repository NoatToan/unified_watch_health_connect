<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dialog_bottom_button_height">
    <TextView
        android:textColor="@color/s1"
        android:layout_gravity="center"
        android:id="@+id/dialog_neutral_button"
        android:background="@drawable/selector_dialog_button_neutral"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        style="@style/DialogButtonStyle"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/dialog_bottom_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textColor="@color/s2"
            android:layout_gravity="center"
            android:id="@+id/dialog_negative_button"
            android:background="@drawable/selector_dialog_button_start"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            style="@style/DialogButtonStyle"/>
        <View
            android:layout_gravity="center_vertical"
            android:background="@color/divider"
            android:visibility="gone"
            android:layout_width="@dimen/divider"
            android:layout_height="24dp"/>
        <TextView
            android:textColor="@color/s1"
            android:layout_gravity="center"
            android:id="@+id/dialog_positive_button"
            android:background="@drawable/selector_dialog_button_end"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            style="@style/DialogButtonStyle"/>
    </LinearLayout>
    <View
        android:layout_gravity="top"
        android:background="@color/divider"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider"/>
</FrameLayout>
