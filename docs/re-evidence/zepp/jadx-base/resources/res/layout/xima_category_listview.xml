<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ListView
        android:id="@+id/category_listview"
        android:paddingLeft="22dp"
        android:paddingRight="22dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@color/xima_listview_divider_color"
        android:dividerHeight="0.33dp"/>
    <TextView
        android:textSize="@dimen/xima_detail_title_size"
        android:textColor="@color/xima_graytext_color"
        android:gravity="center_vertical"
        android:layout_gravity="center"
        android:id="@+id/nodata"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/xima_nodata"
        android:drawableTop="@drawable/ic_search_no_data"
        android:drawablePadding="16dp"/>
</FrameLayout>
