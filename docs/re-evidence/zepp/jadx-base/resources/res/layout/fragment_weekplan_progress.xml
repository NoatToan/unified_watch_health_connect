<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/gl_base_start"
        android:layout_width="@dimen/size_1dp"
        android:layout_height="match_parent"
        app:layout_constraintGuide_begin="@dimen/size_14dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/gl_base_end"
        android:layout_width="@dimen/size_1dp"
        android:layout_height="match_parent"
        app:layout_constraintGuide_end="@dimen/size_14dp"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_weekplan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_sky_triangle"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/base_content"
        android:background="@drawable/bg_weekplan_progress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toStartOf="@+id/gl_base_end"
        app:layout_constraintStart_toEndOf="@+id/gl_base_start"
        app:layout_constraintTop_toBottomOf="@+id/iv_weekplan">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_weekplan_close"
            android:paddingBottom="@dimen/size_8dp"
            android:layout_width="@dimen/size_40dp"
            android:layout_height="@dimen/size_40dp"
            android:src="@drawable/ic_close_12_s2"
            android:scaleType="center"
            android:tint="@color/s47"
            android:paddingStart="@dimen/size_8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/s46"
            android:id="@+id/tv_weekplan_hint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginStart="@dimen/size_16dp"
            android:layout_marginEnd="@dimen/size_16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Rainbow.TextAppearance.Body4"/>
        <com.huami.sky.ui.view.WeekPlanProcessView
            android:id="@+id/progress_weekplan"
            android:paddingBottom="@dimen/size_10dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_10dp"
            android:layout_marginStart="@dimen/size_10dp"
            android:layout_marginEnd="@dimen/size_16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_weekplan_hint"
            app:weekViewProcess="-1"
            app:weekViewToday="@string/today"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
