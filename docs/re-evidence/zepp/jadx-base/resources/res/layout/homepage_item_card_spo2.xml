<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="112dp">
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/spo2_lottie"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:scaleType="fitEnd"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:lottie_fileName="homepage_spo2_mifit.json"
        app:lottie_repeatCount="-1"/>
    <com.huami.module.homepage.cards.cardui.BackgroundTextView
        android:textColor="@color/s1"
        android:gravity="center"
        android:id="@+id/spo2_mask"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/homepage_item_card_no_spo2_tip"
        app:backgroundTintAlpha="0.92"
        app:cornerDirection="right"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.huami.module.homepage.cards.cardui.CardTitleBarView
        android:id="@+id/spo2_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:titleText="@string/homepage_item_card_spo2"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/spo2_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Rainbow.TextAppearance.Number2"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/spo2_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="17dp"
        app:layout_constraintEnd_toEndOf="@+id/spo2_value"
        app:layout_constraintStart_toStartOf="@+id/spo2_value"
        app:layout_constraintTop_toBottomOf="@+id/spo2_value"
        style="@style/Rainbow.TextAppearance.Body4"/>
</androidx.constraintlayout.widget.ConstraintLayout>
