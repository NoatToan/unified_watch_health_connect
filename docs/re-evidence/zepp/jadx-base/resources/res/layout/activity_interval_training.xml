<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.watch.companion.ui.view.ActionbarLayout
        android:id="@+id/actionbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/training_info_text_size"
            android:textStyle="bold"
            android:textColor="@drawable/sync_text_color_selector"
            android:id="@+id/sync"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sync_training"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/training_info_padding_end"
            android:layout_alignParentEnd="true"/>
    </com.huami.watch.companion.ui.view.ActionbarLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:layout_alignParentBottom="true">
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:gravity="center"
            android:id="@+id/add"
            android:background="@drawable/watch_common_corner_rect"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/add_training"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view"
        android:background="@color/white"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="88dp"
        android:layout_below="@+id/actionbar"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#80000000"
        android:gravity="center"
        android:id="@+id/empty_tips"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:text="@string/interval_training_empty_tips"
        android:drawablePadding="8dp"
        android:layout_centerInParent="true"
        android:drawableStart="@drawable/ic_empty_tips"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"/>
    <FrameLayout
        android:id="@+id/container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
