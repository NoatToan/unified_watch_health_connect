<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/s38"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:background="@color/s4"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_0.5dp"
        android:layout_marginStart="@dimen/size_20dp"
        android:layout_marginEnd="@dimen/size_20dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_60dp"
        android:layout_marginStart="@dimen/size_20dp"
        android:layout_marginEnd="@dimen/size_20dp">
        <ImageView
            android:id="@+id/alarm_delete"
            android:padding="@dimen/size_10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/smart_alarm_delete"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="19sp"
            android:textColor="@color/s1"
            android:id="@+id/alarm_time_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="km"/>
        <TextView
            android:textSize="7.3sp"
            android:textColor="@color/s2"
            android:layout_gravity="center"
            android:id="@+id/alarm_ampm_text"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4.3dp"/>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/size_11dp">
            <TextView
                android:textSize="10sp"
                android:textColor="@color/s2"
                android:gravity="center"
                android:id="@+id/alarm_repeat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="10sp"
                android:textColor="@color/s2"
                android:gravity="center"
                android:id="@+id/alarm_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <androidx.appcompat.widget.SwitchCompat
            android:layout_gravity="center"
            android:id="@+id/alarm_switch"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Rainbow.Widget.Switch"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/end_line"
        android:background="@color/s4"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_0.5dp"/>
</LinearLayout>
