<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/s39"
    app:cardCornerRadius="@dimen/account_ui_size_10dp"
    app:cardElevation="0dp">
    <LinearLayout
        android:orientation="vertical"
        android:padding="@dimen/account_ui_size_24dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="@dimen/account_ui_size_14sp"
            android:textColor="@color/p4"
            android:gravity="center"
            android:id="@+id/tv_reset_password_by_email"
            android:background="@drawable/account_ui_shape_reset_password_type"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/account_ui_account_find_pwd_from_email"/>
        <Space
            android:layout_width="0dp"
            android:layout_height="@dimen/account_ui_size_16dp"/>
        <TextView
            android:textSize="@dimen/account_ui_size_14sp"
            android:textColor="@color/p4"
            android:gravity="center"
            android:id="@+id/tv_reset_password_by_phone"
            android:background="@drawable/account_ui_shape_reset_password_type"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/account_ui_account_find_pwd_from_phone"/>
        <Space
            android:layout_width="0dp"
            android:layout_height="@dimen/account_ui_size_16dp"/>
        <TextView
            android:textSize="@dimen/account_ui_size_14sp"
            android:textColor="@color/s3"
            android:gravity="center"
            android:id="@+id/tv_reset_password_cancel"
            android:background="@drawable/account_ui_shape_reset_password_type"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/account_ui_cancel"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
