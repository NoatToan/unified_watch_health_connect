<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="15dp"
        android:layout_marginStart="@dimen/account_ui_account_side_margin"
        android:layout_marginEnd="@dimen/account_ui_account_side_margin">
        <CheckBox
            android:layout_gravity="top"
            android:id="@+id/useragreement_info_checkbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false"
            app:buttonTint="@color/s3"
            style="@style/CheckboxStyle"/>
        <TextView
            android:textSize="@dimen/account_ui_info_content_size"
            android:textColor="@color/s2"
            android:gravity="start"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/useragreement_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/account_ui_user_agreement_regist_title"
            android:layout_marginStart="6dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/useragreement_ux_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="15dp"
        android:layout_marginStart="@dimen/account_ui_account_side_margin"
        android:layout_marginEnd="@dimen/account_ui_account_side_margin">
        <CheckBox
            android:layout_gravity="top"
            android:id="@+id/useragreement_ux_checkbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false"
            app:buttonTint="@color/s3"
            style="@style/CheckboxStyle"/>
        <TextView
            android:textSize="@dimen/account_ui_info_content_size"
            android:textColor="@color/s2"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/useragreement_ux"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/account_ui_user_agreement_ux"
            android:layout_marginStart="6dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/useragreement_edm_ll"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="31dp"
        android:layout_marginStart="@dimen/account_ui_account_side_margin"
        android:layout_marginEnd="@dimen/account_ui_account_side_margin">
        <CheckBox
            android:layout_gravity="top"
            android:id="@+id/useragreement_edm_checkbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false"
            app:buttonTint="@color/s3"
            style="@style/CheckboxStyle"/>
        <TextView
            android:textSize="@dimen/account_ui_info_content_size"
            android:textColor="@color/s2"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/useragreement_edm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/account_ui_edm_register_content"
            android:layout_marginStart="6dp"/>
    </LinearLayout>
</LinearLayout>
