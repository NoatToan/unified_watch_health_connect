<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/status_layout"
    android:background="@color/s10"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@mipmap/ic_warning_error"
        android:layout_marginStart="19dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:minHeight="40dp"
        android:layout_weight="1"
        android:layout_marginStart="11dp">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/s1"
            android:gravity="center_vertical"
            android:id="@+id/tv_top_title"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:text="@string/wifi_device_disconnect_title"
            android:layout_weight="1"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/s2"
            android:id="@+id/tv_top_tips"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:text="@string/wifi_device_disconnect_msg"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
