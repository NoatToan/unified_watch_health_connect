<?xml version="1.0" encoding="utf-8"?>
<com.scwang.smartrefresh.layout.SmartRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/refresh_layout"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ListView
            android:id="@+id/list_view"
            android:fadingEdge="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:cacheColorHint="#00000000"
            android:divider="@color/divider"
            android:dividerHeight="0dp"
            android:fastScrollEnabled="false"
            android:headerDividersEnabled="false"
            android:footerDividersEnabled="false"
            android:smoothScrollbar="true"
            android:overScrollMode="never"
            android:requiresFadingEdge="none"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/empty_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/imv_history_result_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="125.3dp"
                android:src="@drawable/img_query_behavior_history_fail"
                app:tint="@color/s2"/>
            <TextView
                android:textSize="14.3sp"
                android:textColor="@color/s3"
                android:id="@+id/tx_history_result_tip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"/>
        </LinearLayout>
    </FrameLayout>
</com.scwang.smartrefresh.layout.SmartRefreshLayout>
