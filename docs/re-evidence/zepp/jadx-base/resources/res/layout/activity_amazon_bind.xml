<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:background="@android:color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <RelativeLayout
        android:id="@+id/layout_author"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/part_select_language"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="10dp">
            <TextView
                android:textSize="14sp"
                android:textColor="#80000000"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="@string/third_party_amazon_tips_select_language"/>
            <TextView
                android:textSize="16sp"
                android:textColor="#80000000"
                android:gravity="start|center_vertical"
                android:id="@+id/btn_select_language"
                android:background="@drawable/bg_btn_select_language"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:textAllCaps="false"
                android:drawableEnd="@drawable/alexa_ui_arrow_right"
                style="?android:attr/borderlessButtonStyle"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:layout_width="200dp"
                android:layout_height="120dp"
                android:src="@drawable/third_party_logo_alexa"/>
            <TextView
                android:textSize="20sp"
                android:textColor="#e6000000"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tv_author_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/third_party_amazon_account"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#80000000"
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tv_author_des"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/third_party_amazon_account_login_des"
                android:paddingStart="30dp"
                android:paddingEnd="30dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#80000000"
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tv_author_des_1"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/third_party_amazon_account_login_des_1"
                android:paddingStart="30dp"
                android:paddingEnd="30dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#80000000"
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tv_author_des_2"
                android:paddingTop="5dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/third_party_amazon_account_login_des_2"
                android:lineSpacingExtra="5dp"
                android:paddingStart="30dp"
                android:paddingEnd="30dp"/>
        </LinearLayout>
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:id="@+id/amazon_login_out"
            android:background="#ff009bc3"
            android:padding="11dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="15dp"
            android:text="@string/third_party_amazon_account_login"
            android:layout_alignParentBottom="true"
            android:textAllCaps="false"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#80000000"
            android:gravity="center"
            android:id="@+id/tv_learn_more"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:layout_marginRight="30dp"
            android:layout_marginBottom="20dp"
            android:text=""
            android:layout_above="@+id/amazon_login_out"
            android:lineSpacingMultiplier="1.5"/>
        <View
            android:id="@+id/v_line"
            android:background="#60000000"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0.8px"
            android:layout_marginLeft="30dp"
            android:layout_marginRight="30dp"
            android:layout_marginBottom="15dp"
            android:layout_above="@+id/tv_learn_more"/>
    </RelativeLayout>
</LinearLayout>
