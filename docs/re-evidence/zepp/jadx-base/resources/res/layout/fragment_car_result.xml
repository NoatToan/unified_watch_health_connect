<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/xp_theme_black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/car_result_iv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size_24dp"
        android:src="@drawable/xp_success"
        android:scaleType="centerCrop"
        android:contentDescription="@string/car_s_car_title"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.25"/>
    <TextView
        android:textColor="@color/s5"
        android:id="@+id/car_result_reminds"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_24dp"
        android:text="@string/car_s_xiaopeng_tips_use"
        android:lineSpacingExtra="@dimen/size_10dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/car_result_iv"
        app:layout_goneMarginTop="@dimen/size_24dp"/>
    <TextView
        android:textColor="@color/car_grey_result"
        android:gravity="center"
        android:id="@+id/car_result_error"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_24dp"
        android:layout_marginBottom="25dp"
        android:lineSpacingExtra="@dimen/size_10dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/car_result_reminds"
        app:layout_goneMarginTop="@dimen/size_24dp"/>
    <TextView
        android:textColor="@color/car_grey_result"
        android:gravity="center"
        android:id="@+id/car_result_error_code"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size_24dp"
        android:lineSpacingExtra="@dimen/size_10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/car_result_error"
        app:layout_goneMarginTop="@dimen/size_24dp"/>
    <Button
        android:textColor="@color/s5"
        android:id="@+id/car_result_bt"
        android:layout_width="@dimen/size_160dp"
        android:layout_height="wrap_content"
        android:text="@string/car_s_xiaopeng_i_success"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/car_result_error_code"
        app:layout_constraintVertical_bias="0.14"
        style="@style/Rainbow.Widget.Button.Gray.38.Outline.Circular"/>
</androidx.constraintlayout.widget.ConstraintLayout>
