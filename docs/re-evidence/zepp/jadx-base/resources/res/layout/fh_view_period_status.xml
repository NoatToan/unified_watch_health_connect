<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:item="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/s1"
            android:id="@+id/tv_pain_group_title"
            android:layout_width="wrap_content"
            android:layout_height="21dp"
            android:text="@string/fh_period_pain"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_pain_group_content"
            android:background="@drawable/fh_bg_round_rect_grey_10dp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">
            <com.huami.femalehealth.uilib.widget.StatusChooseItemView
                android:id="@+id/sv_pain_group_first"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                item:fh_statusItemImage="@drawable/fh_item_pain_light"
                item:fh_statusItemSelect="false"
                item:fh_statusItemTitle="@string/fh_pain_degree_light"/>
            <com.huami.femalehealth.uilib.widget.StatusChooseItemView
                android:id="@+id/sv_pain_group_second"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                item:fh_statusItemImage="@drawable/fh_item_pain_middle"
                item:fh_statusItemSelect="false"
                item:fh_statusItemTitle="@string/fh_pain_degree_middle"/>
            <com.huami.femalehealth.uilib.widget.StatusChooseItemView
                android:id="@+id/sv_pain_group_third"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                item:fh_statusItemImage="@drawable/fh_item_pain_serious"
                item:fh_statusItemSelect="false"
                item:fh_statusItemTitle="@string/fh_pain_degree_heavy"/>
        </LinearLayout>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/s1"
            android:id="@+id/tv_pain_blood_title"
            android:layout_width="wrap_content"
            android:layout_height="21dp"
            android:layout_marginTop="12dp"
            android:text="@string/fh_symptom_name_blood"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_blood_group_content"
            android:background="@drawable/fh_bg_round_rect_grey_10dp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">
            <com.huami.femalehealth.uilib.widget.StatusChooseItemView
                android:id="@+id/sv_blood_group_first"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                item:fh_statusItemImage="@drawable/fh_item_blood_little"
                item:fh_statusItemSelect="false"
                item:fh_statusItemTitle="@string/fh_blood_degree_light"/>
            <com.huami.femalehealth.uilib.widget.StatusChooseItemView
                android:id="@+id/sv_blood_group_second"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                item:fh_statusItemImage="@drawable/fh_item_blood_middle"
                item:fh_statusItemSelect="false"
                item:fh_statusItemTitle="@string/fh_blood_degree_middle"/>
            <com.huami.femalehealth.uilib.widget.StatusChooseItemView
                android:id="@+id/sv_blood_group_third"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                item:fh_statusItemImage="@drawable/fh_item_blood_heavy"
                item:fh_statusItemSelect="false"
                item:fh_statusItemTitle="@string/fh_blood_degree_heavy"/>
        </LinearLayout>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/s1"
            android:id="@+id/tv_mood_group_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/fh_symptom_name_mood"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_mood_group_content"
            android:background="@drawable/fh_bg_round_rect_grey_10dp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">
            <com.huami.femalehealth.uilib.widget.StatusChooseItemView
                android:id="@+id/sv_mood_group_first"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                item:fh_statusItemImage="@drawable/fh_item_mood_happy"
                item:fh_statusItemSelect="false"
                item:fh_statusItemTitle="@string/fh_mood_degree_light"/>
            <com.huami.femalehealth.uilib.widget.StatusChooseItemView
                android:id="@+id/sv_mood_group_second"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                item:fh_statusItemImage="@drawable/fh_item_mood_middle"
                item:fh_statusItemSelect="false"
                item:fh_statusItemTitle="@string/fh_mood_degree_middle"/>
            <com.huami.femalehealth.uilib.widget.StatusChooseItemView
                android:id="@+id/sv_mood_group_third"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                item:fh_statusItemImage="@drawable/fh_item_mood_heavy"
                item:fh_statusItemSelect="false"
                item:fh_statusItemTitle="@string/fh_mood_degree_heavy"/>
        </LinearLayout>
    </LinearLayout>
</merge>
