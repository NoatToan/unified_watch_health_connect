<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@color/s36"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="20sp"
        android:textColor="@color/s1"
        android:gravity="center"
        android:id="@+id/fw_upgrade_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="98dp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/s2"
        android:gravity="center"
        android:id="@+id/fw_upgrade_tips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:layout_below="@+id/fw_upgrade_title"/>
    <com.huami.lib.view.progress.ProgressView
        android:id="@+id/fw_upgrade_progress"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_marginTop="82dp"
        android:src="@drawable/img_dfu"
        android:layout_below="@+id/fw_upgrade_tips"
        android:layout_centerHorizontal="true"
        app:backgroundColor="@color/s4"
        app:progressColor="@color/s14"
        app:strokeWidth="1.8dp"
        app:style="cycle"/>
    <TextView
        android:textSize="@dimen/size_14sp"
        android:textColor="@color/s14"
        android:gravity="center"
        android:id="@+id/fw_upgrade_log"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_29dp"
        android:text="@string/fw_upgrade_log"
        android:layout_below="@+id/fw_upgrade_progress"/>
    <TextView
        android:textSize="@dimen/size_14sp"
        android:textColor="@color/s2"
        android:gravity="center"
        android:id="@+id/fw_upgrade_description"
        android:paddingLeft="39dp"
        android:paddingRight="39dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:layout_below="@+id/fw_upgrade_log"/>
    <include
        android:id="@+id/ll_update_select"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        layout="@layout/device_layout_bottom_common_btn"/>
</RelativeLayout>
