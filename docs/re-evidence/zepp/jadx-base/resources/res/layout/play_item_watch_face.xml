<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="124dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="10dp">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_watch_face"
        android:layout_width="104dp"
        android:layout_height="110dp"
        android:layout_marginTop="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_watch_face_new"
        android:visibility="gone"
        android:layout_width="36dp"
        android:layout_height="23dp"
        android:src="@drawable/play_icon_watch_face_new"
        android:layout_marginStart="78dp"
        app:layout_constraintStart_toStartOf="@+id/iv_watch_face"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_watch_face_shadow"
        android:layout_width="62dp"
        android:layout_height="6dp"
        android:src="@drawable/play_watch_face_shadow"
        app:layout_constraintEnd_toEndOf="@+id/iv_watch_face"
        app:layout_constraintStart_toStartOf="@+id/iv_watch_face"
        app:layout_constraintTop_toBottomOf="@+id/iv_watch_face"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="@dimen/play_sub_title_size"
        android:textColor="@color/play_sub_title_color"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_watch_face_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_watch_face_shadow"/>
</androidx.constraintlayout.widget.ConstraintLayout>
