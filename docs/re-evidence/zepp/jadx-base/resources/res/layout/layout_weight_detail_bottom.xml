<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/s38"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:background="@color/s4"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="66.7dp"
            android:layout_centerHorizontal="true">
            <RelativeLayout
                android:id="@+id/statistic_ll"
                android:visibility="visible"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/statistic_iv"
                    android:background="@drawable/statistics_icon_selector"
                    android:layout_width="33.3dp"
                    android:layout_height="33.3dp"
                    android:layout_marginTop="11dp"
                    android:scaleType="centerInside"
                    android:layout_centerHorizontal="true"/>
                <TextView
                    android:textSize="9.3sp"
                    android:textColor="@color/s2"
                    android:id="@+id/statistic_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4.7dp"
                    android:text="@string/statistic"
                    android:layout_below="@+id/statistic_iv"
                    android:layout_centerHorizontal="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/manual_weight_ll"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/record_iv"
                    android:layout_width="33.3dp"
                    android:layout_height="33.3dp"
                    android:layout_marginTop="11dp"
                    android:src="@drawable/record_weight_btn"
                    android:scaleType="centerInside"
                    android:layout_centerHorizontal="true"/>
                <TextView
                    android:textSize="9.3sp"
                    android:textColor="@color/s2"
                    android:id="@+id/record_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4.7dp"
                    android:text="@string/record_weight"
                    android:layout_below="@+id/record_iv"
                    android:layout_centerHorizontal="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/holdbaby_weight_ll"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/holdbaby_iv"
                    android:layout_width="33.3dp"
                    android:layout_height="33.3dp"
                    android:layout_marginTop="11dp"
                    android:src="@drawable/baby_hold_selector"
                    android:scaleType="centerInside"
                    android:layout_centerHorizontal="true"/>
                <TextView
                    android:textSize="9.3sp"
                    android:textColor="@color/s2"
                    android:id="@+id/holdbaby_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="@string/hold_baby_weight"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/delete_ll"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/delete_iv"
                    android:layout_width="33.3dp"
                    android:layout_height="33.3dp"
                    android:layout_marginTop="11dp"
                    android:src="@drawable/delete_selector"
                    android:scaleType="centerInside"
                    android:layout_centerHorizontal="true"/>
                <TextView
                    android:textSize="9.3sp"
                    android:textColor="@color/s2"
                    android:id="@+id/delete_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4.7dp"
                    android:text="@string/delete_weight"
                    android:layout_below="@+id/delete_iv"
                    android:layout_centerHorizontal="true"/>
            </RelativeLayout>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
