<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="match_parent">
    <TextView
        android:textSize="12sp"
        android:textColor="#80000000"
        android:id="@+id/progress_layout_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#80000000"
        android:id="@+id/region_value"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginStart="10dp"
        android:layout_toEndOf="@+id/progress_layout_name"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#4d000000"
        android:id="@+id/time"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:08:30"
        android:layout_alignParentTop="true"
        android:layout_marginEnd="50dp"
        android:layout_alignParentEnd="true"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="14dp"
        android:layout_marginTop="4dp"
        android:layout_below="@+id/time"
        android:layout_alignStart="@+id/progress_layout_name">
        <view
            android:layout_gravity="center_vertical"
            android:id="@+id/progress_layout_progress"
            android:layout_width="0dp"
            android:layout_height="14dp"
            android:layout_weight="1"
            class="com.huami.watch.companion.ui.view.HeartrateProgressItem$ProgressBar"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#99000000"
            android:id="@+id/progress_layout_desc"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:layout_marginTop="-3.2dp"
            android:layout_marginStart="9dp"/>
    </LinearLayout>
</RelativeLayout>
