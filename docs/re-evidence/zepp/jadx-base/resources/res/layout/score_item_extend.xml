<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="70dp">
    <ImageView
        android:id="@+id/bf_score_ll_pre"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:src="@drawable/bf3_b_m_i"
        android:layout_centerVertical="true"
        android:layout_marginStart="19dp"
        style="@style/bodyfatIndexIconStyle"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_bf3_params"
        android:layout_width="wrap_content"
        android:layout_height="26dp"
        android:layout_marginTop="14dp"
        android:layout_marginStart="15dp"
        android:layout_toEndOf="@+id/bf_score_ll_pre">
        <TextView
            android:layout_gravity="center"
            android:id="@+id/params_name_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/bodyIndexTitleStyle"/>
        <com.huami.lib.view.text.UnitTextView
            android:layout_gravity="center"
            android:id="@+id/params_value_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/bodyIndexValueStyle"/>
    </LinearLayout>
    <TextView
        android:id="@+id/content_state_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-3dp"
        android:layout_below="@+id/ll_bf3_params"
        android:layout_marginStart="15dp"
        android:layout_toEndOf="@+id/bf_score_ll_pre"
        style="@style/bodyIndexSubTitleStyle"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/s2"
        android:id="@+id/text_view_details"
        android:background="@drawable/bodyfat_bg_view_details"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/text_view_details"
        android:layout_alignTop="@+id/content_state_tv"
        android:paddingStart="3dp"
        android:paddingEnd="3dp"
        android:layout_marginStart="5dp"
        android:layout_toEndOf="@+id/content_state_tv"
        style="@style/bodyfatItemDetailStyle"/>
    <View
        android:id="@+id/divider_bottom"
        android:background="@color/s4"
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider_slp_info"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"/>
</RelativeLayout>
