<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/bg_earbud_music"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:onClick="disableDelete">
    <RelativeLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@color/s36"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.xiaomi.hm.health.device.view.HMLoadingView
            android:id="@+id/loading_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <TextView
            android:textSize="17sp"
            android:textColor="@color/s1"
            android:id="@+id/dis_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="90dp"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/s2"
            android:gravity="center"
            android:id="@+id/dis_msg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/bind_earbud_no_device_tip"
            android:layout_below="@+id/dis_title"
            android:layout_centerHorizontal="true"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"/>
        <com.xiaomi.hm.health.device.earbud.view.EarbudImageView
            android:id="@+id/earbud_device_img"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/no_ble"
        android:background="@color/s36"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="17sp"
            android:textColor="@color/s1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="90dp"
            android:text="@string/ble_not_open"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/s2"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/retry_after_ble_open"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="78dp"
            android:src="@drawable/img_earbud_no_ble"/>
        <View
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/s1"
            android:id="@+id/open_ble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="60dp"
            android:text="@string/turn_bluetooth_on"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/title_content"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:layout_marginTop="24dp">
        <ImageView
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_earbud_back"
            android:layout_centerVertical="true"
            android:onClick="onReturnClick"
            android:layout_marginStart="11dp"/>
        <ImageView
            android:id="@+id/set_btn"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/icon_earbud_set_black"
            android:layout_centerVertical="true"
            android:onClick="toEarbudSetting"
            android:layout_marginEnd="11dp"
            android:layout_alignParentEnd="true"/>
        <ImageView
            android:id="@+id/update_red_dot"
            android:background="@drawable/ic_red_circle"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_alignTop="@+id/set_btn"
            android:layout_alignEnd="@+id/set_btn"/>
    </RelativeLayout>
</RelativeLayout>
