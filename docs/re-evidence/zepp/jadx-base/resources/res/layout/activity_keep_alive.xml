<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s36"
    android:scrollbars="none"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="never">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="49dp">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/s1"
                android:id="@+id/keep_alive_current_phone_pre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/keep_alive_current_phone"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/p3"
                android:id="@+id/keep_alive_current_phone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@+id/keep_alive_current_phone_pre"/>
            <RelativeLayout
                android:id="@+id/keep_alive_change"
                android:layout_width="49dp"
                android:layout_height="match_parent"
                android:layout_alignParentEnd="true">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/keep_alive_change"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"
                    app:tint="@color/s1"/>
            </RelativeLayout>
        </RelativeLayout>
        <View
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/s1"
            android:gravity="start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="19dp"
            android:text="@string/keep_alive_tips_title"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/s2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/keep_alive_tips_content"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/s2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="@string/keep_alive_tips_content_note"/>
        <TextView
            android:textColor="@color/s3"
            android:gravity="start"
            android:id="@+id/keep_alive_setting_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"/>
        <View
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_marginTop="8dp"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/s1"
            android:gravity="start"
            android:id="@+id/keep_alive_setting_auto_start"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="19dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/s2"
            android:gravity="start"
            android:id="@+id/keep_alive_setting_auto_start_rom"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"/>
        <Button
            android:id="@+id/keep_alive_setting_auto_start_setting"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:text="@string/keep_alive_setting"
            style="?attr/buttonStyleGray_38_outline_circular"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/s1"
            android:gravity="start"
            android:id="@+id/keep_alive_setting_power_manager"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/s2"
            android:gravity="start"
            android:id="@+id/keep_alive_setting_power_manager_rom"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"/>
        <Button
            android:id="@+id/keep_alive_setting_power_manager_setting"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:text="@string/keep_alive_setting"
            style="?attr/buttonStyleGray_38_outline_circular"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/s1"
            android:gravity="start"
            android:id="@+id/keep_alive_setting_app_lock"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/s2"
            android:gravity="start"
            android:id="@+id/keep_alive_setting_app_lock_rom"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"/>
        <Button
            android:id="@+id/keep_alive_setting_app_lock_setting"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:text="@string/keep_alive_setting"
            style="?attr/buttonStyleGray_38_outline_circular"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/s2"
            android:gravity="start"
            android:id="@+id/keep_alive_setting_other"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="19dp"
            android:text="@string/keep_alive_setting_other"/>
        <View
            android:background="@color/trans"
            android:layout_width="match_parent"
            android:layout_height="48dp"/>
    </LinearLayout>
</ScrollView>
