<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.lib.rainbow.titlebar.RainbowTitleBar
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/mili_setting_ges_screen"/>
    <FrameLayout
        android:id="@+id/anim_container"
        android:background="@color/s38"
        android:layout_width="match_parent"
        android:layout_height="251dp">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/lift_wrist_img"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/bright_screen_img"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textColor="@color/s2"
            android:gravity="center"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:text="@string/mili_setting_ges_screen_tips_wuhan"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.huami.lib.rainbow.ListTile
        android:id="@+id/ges_screen_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:ltv_divider_padding="all"
        app:ltv_title="@string/mili_setting_ges_screen"/>
    <com.huami.lib.rainbow.ListTile
        android:id="@+id/sensitivity_item"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:ltv_divider_padding="all"
        app:ltv_title="@string/ges_screen_sensitivity"/>
    <com.huami.lib.rainbow.ListTile
        android:id="@+id/start_time_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:ltv_divider_padding="all"
        app:ltv_title="@string/long_sit_alert_start"/>
    <com.huami.lib.rainbow.ListTile
        android:id="@+id/end_time_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:ltv_title="@string/long_sit_alert_stop"/>
</LinearLayout>
