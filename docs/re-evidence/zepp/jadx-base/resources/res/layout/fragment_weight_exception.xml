<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="16sp"
        android:textColor="@color/weighting_title_text_color"
        android:layout_gravity="center_horizontal"
        android:id="@+id/weight_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="72dp"
        android:text="@string/weighting_weight_title"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="70dp">
        <com.xiaomi.hm.health.bodyfat.view.WeightChartView
            android:layout_gravity="center_horizontal"
            android:id="@+id/weight_chart"
            android:layout_width="200dp"
            android:layout_height="200dp"
            app:circleColor="@color/weighting_circle_color"
            app:edgeColor="@color/weighting_circle_edge_color"
            app:unFillColor="@color/weighting_circle_not_fill_color"
            app:weightFillColor="@color/weighting_circle_fill_color"/>
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/weight_number_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/img_flag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="48sp"
                android:textColor="@color/weighting_value_text_color"
                android:ellipsize="none"
                android:gravity="center"
                android:id="@+id/number"
                android:paddingTop="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:fontFamily="km"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/weighting_unit_text_color"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
