<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/fl_select_image_cancel"
        android:background="@drawable/dialog_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_52dp"
        android:layout_marginTop="@dimen/size_8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        <TextView
            android:textSize="@dimen/click_button_text_size"
            android:textColor="@color/black60"
            android:gravity="center"
            android:id="@+id/tv_select_image_cancel"
            android:background="@drawable/btn_click_bg_round_dialog"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/cancel"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/dialog_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/fl_select_image_cancel"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        <TextView
            android:textSize="@dimen/size_14.5sp"
            android:textColor="@color/main_ui_title_color"
            android:gravity="center"
            android:id="@+id/tv_select_image_camera_area"
            android:background="@drawable/btn_click_bg_round_top"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_48dp"
            android:text="@string/userinfo_avatar_take_photo"/>
        <View
            android:background="@color/black20"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <TextView
            android:textSize="@dimen/size_14.5sp"
            android:textColor="@color/main_ui_title_color"
            android:gravity="center"
            android:id="@+id/tv_select_image_local_area"
            android:background="@drawable/btn_click_bg_round_bottom"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_48dp"
            android:text="@string/userinfo_avatar_from_gallery"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
