<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:item="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/g_center_y"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        item:layout_constraintGuide_percent="0.5"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/s2"
        android:id="@+id/intro_deep"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/sleep_sign_deep_sleep"
        android:drawablePadding="5dp"
        android:drawableStart="@drawable/slp_info_rect_deep"
        item:layout_constraintBottom_toTopOf="@+id/g_center_y"
        item:layout_constraintEnd_toStartOf="@+id/intro_light"
        item:layout_constraintHorizontal_weight="1"
        item:layout_constraintStart_toStartOf="parent"
        item:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/s2"
        android:id="@+id/intro_light"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/sleep_sign_light_sleep"
        android:drawablePadding="5dp"
        android:drawableStart="@drawable/slp_info_rect_light"
        item:layout_constraintBottom_toTopOf="@+id/g_center_y"
        item:layout_constraintEnd_toStartOf="@+id/intro_rem"
        item:layout_constraintHorizontal_weight="1"
        item:layout_constraintStart_toEndOf="@+id/intro_deep"
        item:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/s2"
        android:id="@+id/intro_rem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sleep_subview_rem_sleep"
        android:drawablePadding="5dp"
        android:drawableStart="@drawable/slp_info_rect_rem"
        item:layout_constraintBottom_toTopOf="@+id/g_center_y"
        item:layout_constraintEnd_toEndOf="parent"
        item:layout_constraintStart_toEndOf="@+id/intro_light"
        item:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/s2"
        android:id="@+id/intro_awake"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/sleep_subview_awake_sleep"
        android:drawablePadding="5dp"
        android:drawableStart="@drawable/slp_info_rect_wake"
        item:layout_constraintBottom_toBottomOf="parent"
        item:layout_constraintEnd_toStartOf="@+id/intro_nap"
        item:layout_constraintHorizontal_weight="1"
        item:layout_constraintStart_toStartOf="parent"
        item:layout_constraintTop_toTopOf="@+id/g_center_y"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/s2"
        android:id="@+id/intro_nap"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/sporadic_sleep"
        android:drawablePadding="5dp"
        android:drawableStart="@drawable/slp_info_rect_nap"
        item:layout_constraintBottom_toBottomOf="parent"
        item:layout_constraintEnd_toEndOf="@+id/intro_rem_placeholder"
        item:layout_constraintHorizontal_weight="1"
        item:layout_constraintStart_toEndOf="@+id/intro_awake"
        item:layout_constraintTop_toTopOf="@+id/g_center_y"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/s2"
        android:id="@+id/intro_rem_placeholder"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sleep_subview_rem_sleep"
        android:drawablePadding="5dp"
        android:drawableStart="@drawable/slp_info_rect_rem"
        item:layout_constraintBottom_toTopOf="@+id/g_center_y"
        item:layout_constraintEnd_toEndOf="parent"
        item:layout_constraintStart_toEndOf="@+id/intro_nap"
        item:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
