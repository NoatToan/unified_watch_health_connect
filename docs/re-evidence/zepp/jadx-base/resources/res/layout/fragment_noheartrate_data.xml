<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/ll_no_hr_parent"
    android:background="@drawable/bg_white_round_rect"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="15dp"
    android:layout_marginStart="15dp"
    android:layout_marginEnd="15dp">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16.7dp"
        android:layout_marginBottom="18.3dp"
        android:layout_marginStart="15dp">
        <ImageView
            android:layout_width="28.3dp"
            android:layout_height="28.3dp"
            android:src="@drawable/pai_img"/>
        <TextView
            android:textColor="@color/s1"
            android:gravity="start|center_vertical"
            android:id="@+id/pai_value_today"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pai_value_today"
            android:textDirection="locale"
            android:textAlignment="viewStart"
            android:layout_marginStart="14dp"
            style="@style/Rainbow.TextAppearance.Title3"/>
    </LinearLayout>
    <include
        android:id="@+id/ll_no_hr_content"
        layout="@layout/fragment_pai_no_hr"/>
</LinearLayout>
