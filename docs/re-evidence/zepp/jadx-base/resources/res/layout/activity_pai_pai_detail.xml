<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="never">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@color/s10"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/fl_history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/fl_hrsetting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/fl_history"/>
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/fl_sporthint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/fl_barrier"/>
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/fl_dayhr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/fl_hrsetting"/>
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/fl_daynohr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/fl_hrsetting"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/fl_barrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="fl_dayhr,fl_daynohr"/>
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/fl_fitnessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"
            app:layout_constraintTop_toBottomOf="@+id/fl_sporthint"/>
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/fl_intro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/fl_fitnessage"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="11sp"
            android:textColor="@color/s3"
            android:id="@+id/jp_hint_text"
            android:paddingBottom="19dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="この機能は、一部のデバイスでのみサポートされています"
            android:layout_marginStart="35dp"
            android:layout_marginEnd="35dp"
            app:layout_constraintTop_toBottomOf="@+id/fl_intro"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
