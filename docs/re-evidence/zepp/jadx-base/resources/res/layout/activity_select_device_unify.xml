<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ListView
        android:id="@+id/device_list"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/size_15dp"
        android:layout_marginBottom="@dimen/size_56dp"
        android:divider="@android:color/transparent"
        android:dividerHeight="15dp"
        android:layout_marginStart="@dimen/size_15dp"
        android:layout_marginEnd="@dimen/size_15dp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@drawable/bind_left_text_color"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/skip_tv"
        android:background="@color/s4"
        android:padding="5dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:text="@string/cancel"
        android:layout_alignParentBottom="true"/>
    <androidx.cardview.widget.CardView
        android:id="@+id/layout_bind_not_right_now"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_56dp"
        android:layout_alignParentBottom="true"
        app:cardBackgroundColor="@color/s10"
        app:cardCornerRadius="0dp"
        app:cardElevation="6dp">
        <TextView
            android:textColor="@color/s41"
            android:layout_gravity="center"
            android:id="@+id/tv_bind_not_right_now"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bind_not_right_now"
            app:drawableEndCompat="@drawable/ic_arrow_forward_16_s41"/>
    </androidx.cardview.widget.CardView>
</RelativeLayout>
