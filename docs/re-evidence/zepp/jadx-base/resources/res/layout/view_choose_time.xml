<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="@color/s1"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/time_choose_title"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25.3dp"
        android:layout_marginBottom="25dp"
        style="?attr/textAppearanceTitle2"/>
    <View
        android:background="@color/s4"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="202dp"
        android:paddingStart="15dp"
        android:paddingEnd="15dp">
        <com.huami.widget.wheelview.WheelView
            android:id="@+id/time_choose_ampm_wheel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <View
            android:background="@color/s4"
            android:visibility="gone"
            android:layout_width="@dimen/round_bg_stroke"
            android:layout_height="match_parent"/>
        <com.huami.widget.wheelview.WheelView
            android:id="@+id/time_choose_hour_wheel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <View
            android:background="@color/s4"
            android:visibility="gone"
            android:layout_width="@dimen/round_bg_stroke"
            android:layout_height="match_parent"/>
        <com.huami.widget.wheelview.WheelView
            android:id="@+id/time_choose_min_wheel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
