<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s36"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.huami.lib.rainbow.titlebar.RainbowTitleBar
        android:id="@+id/tv_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menuIcon="@drawable/ic_edit_20"
        app:navigationIcon="@drawable/ic_arrow_back_20_2x"/>
    <com.huami.lib.view.scroll.HMScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tv_title_bar">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/main_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="30dp"
                android:minHeight="160dp">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="center"
                    android:id="@+id/iv_disconnect"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:srcCompat="@drawable/img_x"/>
                <RelativeLayout
                    android:id="@+id/battery_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@+id/icon_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="4dp"
                        android:src="@drawable/ic_earbud_setting"
                        android:scaleType="fitXY"
                        android:layout_marginStart="17dp"
                        android:layout_marginEnd="36dp"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_toEndOf="@+id/icon_view">
                        <LinearLayout
                            android:gravity="bottom"
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="10dp"
                                android:src="@drawable/ic_headset_settings_left"/>
                            <com.huami.widget.typeface.TypefaceTextView
                                android:textSize="30sp"
                                android:textColor="@color/setting_battery_low_text_color"
                                android:gravity="bottom"
                                android:id="@+id/tv_left_battery"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="20dp"/>
                            <com.huami.widget.typeface.TypefaceTextView
                                android:textSize="15sp"
                                android:textColor="@color/setting_battery_low_text_color"
                                android:gravity="bottom"
                                android:id="@+id/tv_left_battery_percent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/percent"
                                android:layout_marginStart="4dp"/>
                        </LinearLayout>
                        <LinearLayout
                            android:gravity="bottom"
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="10dp"
                                android:src="@drawable/ic_headset_settings_right"/>
                            <com.huami.widget.typeface.TypefaceTextView
                                android:textSize="30sp"
                                android:textColor="@color/setting_battery_low_text_color"
                                android:gravity="bottom"
                                android:id="@+id/tv_right_battery"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="20dp"/>
                            <com.huami.widget.typeface.TypefaceTextView
                                android:textSize="15sp"
                                android:textColor="@color/setting_battery_low_text_color"
                                android:gravity="bottom"
                                android:id="@+id/tv_right_battery_percent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/percent"
                                android:layout_marginStart="4dp"/>
                        </LinearLayout>
                    </LinearLayout>
                </RelativeLayout>
            </FrameLayout>
            <androidx.cardview.widget.CardView
                android:background="@color/s38"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                app:cardBackgroundColor="@color/s38"
                app:cardCornerRadius="6dp"
                app:cardElevation="0px"
                app:cardUseCompatPadding="false">
                <FrameLayout
                    android:id="@+id/status_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:background="@color/s38"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                app:cardBackgroundColor="@color/s38"
                app:cardCornerRadius="6dp"
                app:cardElevation="0px"
                app:cardUseCompatPadding="false">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.huami.lib.rainbow.ListTile
                        android:id="@+id/play_time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:ltv_title="@string/earbud_play_time"
                        app:ltv_trailing="@drawable/ic_arrow_forward_20_2x"/>
                    <com.huami.lib.rainbow.ListTile
                        android:id="@+id/alarm"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:ltv_title="@string/earbud_alarm"
                        app:ltv_trailing="@drawable/ic_arrow_forward_20_2x"/>
                    <com.huami.lib.rainbow.ListTile
                        android:id="@+id/operation"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:ltv_title="@string/earbud_operation"
                        app:ltv_trailing="@drawable/ic_arrow_forward_20_2x"/>
                    <com.huami.lib.rainbow.ListTile
                        android:id="@+id/notify"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:ltv_title="@string/earbud_notify"
                        app:ltv_trailing="@drawable/ic_arrow_forward_20_2x"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <Space
                android:layout_width="match_parent"
                android:layout_height="15dp"/>
            <androidx.cardview.widget.CardView
                android:background="@color/s38"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                app:cardBackgroundColor="@color/s38"
                app:cardCornerRadius="6dp"
                app:cardElevation="0px"
                app:cardUseCompatPadding="false">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.huami.lib.rainbow.ListTile
                        android:id="@+id/play_device"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:ltv_title="@string/earbud_play"
                        app:ltv_trailing="@drawable/ic_arrow_forward_20_2x"/>
                    <com.huami.lib.rainbow.ListTile
                        android:id="@+id/help"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:ltv_title="@string/setting_question"
                        app:ltv_trailing="@drawable/ic_arrow_forward_20_2x"/>
                    <com.huami.lib.rainbow.ListTile
                        android:id="@+id/check_update"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:ltv_title="@string/setting_update"
                        app:ltv_trailing="@drawable/ic_arrow_forward_20_2x"/>
                    <com.huami.lib.rainbow.ListTile
                        android:id="@+id/reset"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:ltv_title="@string/bind_restore_factory"
                        app:ltv_trailing="@drawable/ic_arrow_forward_20_2x"/>
                    <com.huami.lib.rainbow.ListTile
                        android:id="@+id/fw_version"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:itemEndArrow="false"
                        app:ltv_title="@string/mili_setting_fw_version"
                        app:ltv_trailing="@drawable/ic_arrow_forward_20_2x"/>
                    <com.huami.lib.rainbow.ListTile
                        android:id="@+id/mac_address"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:itemEndArrow="false"
                        app:ltv_title="@string/mili_setting_mac_address"
                        app:ltv_trailing="@drawable/ic_arrow_forward_20_2x"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <Button
                android:id="@+id/setting_unbind"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="60dp"
                android:layout_marginBottom="30dp"
                android:text="@string/mili_setting_unbind"
                android:textAllCaps="false"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                style="?attr/buttonStyleGray_48_flat"/>
        </LinearLayout>
    </com.huami.lib.view.scroll.HMScrollView>
</RelativeLayout>
