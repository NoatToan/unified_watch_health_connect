<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s36"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/wl_iv_shift_in"
        android:layout_width="@dimen/size_88dp"
        android:layout_height="@dimen/size_88dp"
        android:layout_marginTop="@dimen/size_71dp"
        android:src="@drawable/wl_ic_done_green"
        android:layout_marginStart="@dimen/size_8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/s2"
        android:id="@+id/wl_tv_shift_in_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/wl_iv_shift_in"
        style="@style/TextAppearance.MiFit.Title3.Inverse2"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:id="@+id/wl_tv_shift_error_info"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/wl_tv_shift_in_info"
        style="@style/TextAppearance.MiFit.Caption.Inverse"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:id="@+id/wl_tv_shift_error_code"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:layout_marginStart="@dimen/size_8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/wl_tv_shift_error_info"
        style="@style/TextAppearance.MiFit.Caption.Inverse"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/s3"
        android:id="@+id/wl_tv_shift_in_info_tiny"
        android:paddingLeft="@dimen/wl_border_margin"
        android:paddingRight="@dimen/wl_border_margin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/wl_tv_shift_error_code"
        style="@style/TextAppearance.MiFit.Caption.Inverse"/>
    <Button
        android:id="@+id/wl_bt_shift_in_bottom"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size_24dp"
        android:text="@string/wl_finish"
        android:layout_marginStart="@dimen/wl_border_margin"
        android:layout_marginEnd="@dimen/wl_border_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        style="@style/Rainbow.Widget.Button.44.Circular"/>
</androidx.constraintlayout.widget.ConstraintLayout>
