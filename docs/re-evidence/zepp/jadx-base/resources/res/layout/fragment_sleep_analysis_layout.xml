<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/sleep_main_bg"
    android:padding="@dimen/slp_size_15dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="15dp"
    android:layout_marginTop="@dimen/slp_size_15dp"
    android:layout_marginRight="15dp">
    <TextView
        android:textSize="@dimen/slp_size_18sp"
        android:textStyle="bold"
        android:textColor="@color/s1"
        android:id="@+id/mainTitleTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/slp_size_13sp"
        android:textColor="@color/s2"
        android:id="@+id/subTitleTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mainTitleTv"/>
    <View
        android:id="@+id/lineV"
        android:background="@color/s4"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/line"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@+id/subTitleTv"/>
    <TextView
        android:textSize="@dimen/slp_size_13sp"
        android:textColor="@color/s1"
        android:id="@+id/bestScoreTv"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lineV"/>
    <TextView
        android:textSize="@dimen/slp_size_13sp"
        android:textColor="@color/s1"
        android:id="@+id/worstScoreTv"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bestScoreTv"/>
</androidx.constraintlayout.widget.ConstraintLayout>
