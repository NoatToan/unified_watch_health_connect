<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:paddingStart="10dp"
    android:paddingEnd="10dp">
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="15sp"
        android:textColor="@color/bm_common_black"
        android:id="@+id/nameTv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/editText"
        app:layout_constraintHorizontal_weight="2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/bm_common_TextStyle_Rtl"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="14sp"
        android:textColor="@color/s1"
        android:textColorHint="@color/s2"
        android:gravity="end"
        android:id="@+id/valueTv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/moreIv"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/nameTv"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/moreIv"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:src="@drawable/ic_arrow_forward_20_2x"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/s2"/>
</androidx.constraintlayout.widget.ConstraintLayout>
