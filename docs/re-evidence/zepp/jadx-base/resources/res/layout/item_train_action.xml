<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:background="@color/s38"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/item_horizontal_margin"
    android:paddingEnd="@dimen/item_horizontal_margin">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_item"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_width="78dp"
            android:layout_height="50dp">
            <ImageView
                android:id="@+id/imv_background_item"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/icon_default_item_head"
                android:scaleType="centerCrop"/>
            <View
                android:id="@+id/view_front_bg"
                android:background="@drawable/item_video_small_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/s1"
            android:id="@+id/tx_video_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/s2"
            android:id="@+id/tx_repeat_times"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <View
        android:id="@+id/divider_line"
        android:background="@color/s4"
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_rest"
        android:paddingTop="@dimen/item_horizontal_margin"
        android:paddingBottom="@dimen/item_horizontal_margin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/s1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/rest"
            android:layout_weight="1"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/s2"
            android:id="@+id/tx_rest_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>
