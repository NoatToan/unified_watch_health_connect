<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <Space
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="0.015"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="17sp"
        android:textColor="@color/s1"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/headset_upgrade_out_box_title"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14sp"
        android:textColor="@color/s2"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_6dp"
        android:text="@string/headset_upgrade_out_box_msg"
        android:layout_marginStart="@dimen/size_15dp"
        android:layout_marginEnd="@dimen/size_15dp"/>
    <Space
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="0.046"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="37dp"
        android:src="@drawable/headset_reset_tip"/>
    <Space
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="0.405"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/s1"
        android:gravity="center"
        android:id="@+id/tv_upgrade"
        android:background="@drawable/bg_bind_device_cancel"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_48dp"
        android:layout_marginBottom="@dimen/size_47dp"
        android:text="@string/start_upgrade"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/size_20dp"
        android:layout_marginEnd="@dimen/size_20dp"/>
</androidx.appcompat.widget.LinearLayoutCompat>
