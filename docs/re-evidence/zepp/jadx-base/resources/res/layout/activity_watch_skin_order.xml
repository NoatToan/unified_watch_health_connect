<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:background="@color/s38"
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:paddingStart="15dp"
            android:paddingEnd="15dp">
            <androidx.cardview.widget.CardView
                android:id="@+id/skin_card"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                card_view:cardBackgroundColor="@color/s38"
                card_view:cardCornerRadius="5dp"
                card_view:cardElevation="0dp"
                card_view:cardPreventCornerOverlap="true"
                card_view:cardUseCompatPadding="false">
                <ImageView
                    android:id="@+id/skin_iv"
                    android:layout_width="50dp"
                    android:layout_height="100dp"
                    android:src="@drawable/icon_cinco_dial_default_bg"/>
            </androidx.cardview.widget.CardView>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/s1"
                android:id="@+id/skin_name_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="星空表盘"
                android:layout_toRightOf="@+id/skin_card"
                android:layout_alignTop="@+id/skin_card"
                android:layout_marginStart="15dp"/>
            <View
                android:background="@color/s4"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
        <FrameLayout
            android:background="@color/s38"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="10dp"
            android:paddingStart="15dp"
            android:paddingEnd="15dp">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/s1"
                android:layout_gravity="start|center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="应付金额"/>
            <TextView
                android:textSize="18sp"
                android:textColor="@color/s30"
                android:layout_gravity="end|center_vertical"
                android:id="@+id/skin_price_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="￥5.0元"
                android:layout_marginEnd="1dp"/>
        </FrameLayout>
        <FrameLayout
            android:background="@color/s38"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:paddingStart="15dp"
            android:paddingEnd="15dp">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/s1"
                android:layout_gravity="start|center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wxpay_pay"
                android:drawablePadding="9dp"
                android:drawableStart="@drawable/wxpay"/>
            <RadioButton
                android:layout_gravity="end|center_vertical"
                android:id="@+id/skin_wx_rb"
                android:background="@drawable/watch_skin_rb_slt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:button="@null"/>
        </FrameLayout>
        <View
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_alignParentBottom="true"/>
        <FrameLayout
            android:background="@color/s38"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:paddingStart="15dp"
            android:paddingEnd="15dp">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/s1"
                android:layout_gravity="start|center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/alipay_pay"
                android:drawablePadding="9dp"
                android:drawableStart="@drawable/alipay"/>
            <RadioButton
                android:layout_gravity="end|center_vertical"
                android:id="@+id/skin_alipay_rb"
                android:background="@drawable/watch_skin_rb_slt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:button="@null"/>
        </FrameLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="end"
                android:layout_gravity="bottom"
                android:background="@color/s38"
                android:layout_width="match_parent"
                android:layout_height="57dp"
                android:paddingEnd="10dp">
                <TextView
                    android:textSize="18sp"
                    android:textColor="@color/s1"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/skin_total_price_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/watch_skin_total_price"
                    android:layout_marginEnd="15dp"/>
                <TextView
                    android:textColor="@color/s36"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/skin_buy_tv"
                    android:background="@drawable/common_corner_rect_red"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:minWidth="135dp"
                    android:text="@string/watch_skin_confirm_pay"
                    android:singleLine="true"
                    android:paddingStart="37dp"
                    android:paddingEnd="37dp"/>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
    <include
        android:visibility="gone"
        layout="@layout/watch_skin_error_layout"/>
</FrameLayout>
