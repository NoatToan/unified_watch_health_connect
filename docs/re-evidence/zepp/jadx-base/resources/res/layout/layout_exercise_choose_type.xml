<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:background="@color/s38"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/type_title_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:layout_alignParentTop="true">
        <ImageView
            android:id="@+id/type_close_button"
            android:padding="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_common_close"
            android:scaleType="centerInside"
            android:layout_centerVertical="true"
            android:layout_marginEnd="12dp"
            android:layout_alignParentEnd="true"
            app:tint="@color/s1"/>
        <TextView
            android:textSize="17sp"
            android:textColor="@color/s1"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/type_title"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:maxLines="1"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <GridView
        android:id="@+id/sport_type_grid_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="130dp"
        android:listSelector="@android:color/transparent"
        android:horizontalSpacing="36dp"
        android:verticalSpacing="48dp"
        android:stretchMode="columnWidth"
        android:columnWidth="70dp"
        android:numColumns="auto_fit"
        android:layout_below="@+id/type_title_layout"
        android:layout_centerInParent="true"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"/>
</RelativeLayout>
