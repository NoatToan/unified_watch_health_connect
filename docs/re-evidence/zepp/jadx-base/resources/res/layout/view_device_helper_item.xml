<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="15sp"
        android:textColor="@color/s1"
        android:id="@+id/device_helper_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/s1"
        android:id="@+id/device_helper_tips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:layout_below="@+id/device_helper_title"
        android:lineSpacingExtra="3dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"/>
    <View
        android:id="@+id/fill_view"
        android:layout_width="match_parent"
        android:layout_height="21dp"
        android:layout_below="@+id/device_helper_tips"/>
    <View
        android:id="@+id/divider"
        android:background="@color/s2"
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider"
        android:layout_below="@+id/fill_view"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"/>
</RelativeLayout>
