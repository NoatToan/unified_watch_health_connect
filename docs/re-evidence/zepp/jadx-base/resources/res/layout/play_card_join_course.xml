<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingTop="13dp"
    android:paddingBottom="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="15dp"
    android:paddingEnd="15dp">
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="16sp"
        android:textColor="#666"
        android:id="@+id/tv_join_course_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <View
        android:background="#eee"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="6dp"/>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="vertical"
        android:id="@+id/rl_join_course"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="14sp"
        android:textColor="#666"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_more"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="19dp"
        android:text="@string/tr_view_more"
        android:drawableEnd="@drawable/ic_tool_right_24"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textColor="#b2b2b2"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_no_join_course"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="29dp"
        android:text="@string/play_tool_no_join_course"
        android:drawablePadding="8dp"
        android:drawableStart="@drawable/play_icon_no_course"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textStyle="bold"
        android:textColor="#ff5850"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_add_course"
        android:background="@drawable/play_add_course_bg"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        android:text="@string/tr_add_course"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"/>
</LinearLayout>
