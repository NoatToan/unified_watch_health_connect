<?xml version="1.0" encoding="utf-8"?>
<com.huami.watch.companion.ximalaya.AlbumItem xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/selector_item_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/divider"
        android:background="@color/xima_listview_divider_color"
        android:layout_width="match_parent"
        android:layout_height="0.33dp"/>
    <RelativeLayout
        android:paddingTop="11dp"
        android:paddingBottom="11dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/divider">
        <ImageView
            android:id="@+id/item_icon"
            android:layout_width="@dimen/xima_search_item_ig_size"
            android:layout_height="@dimen/xima_search_item_ig_size"
            android:layout_centerVertical="true"/>
        <ImageView
            android:id="@+id/item_insert_ig"
            android:background="@drawable/ic_list_item_right_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"/>
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_toStartOf="@+id/item_insert_ig"
            android:layout_toEndOf="@+id/item_icon">
            <TextView
                android:textSize="@dimen/xima_detail_title_size"
                android:textColor="@color/xima_category_title_color"
                android:id="@+id/item_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="@dimen/xima_detail_intruduce_size"
                android:textColor="@color/xima_light_graytext_color"
                android:id="@+id/item_author"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_below="@+id/item_title"/>
            <TextView
                android:textSize="@dimen/xima_detail_intruduce_size"
                android:textColor="@color/xima_light_graytext_color"
                android:id="@+id/item_displaycount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:drawablePadding="3dp"
                android:layout_below="@+id/item_author"
                android:drawableStart="@drawable/play"/>
            <TextView
                android:textSize="@dimen/xima_detail_intruduce_size"
                android:textColor="@color/xima_light_graytext_color"
                android:id="@+id/item_totalcount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:drawablePadding="3dp"
                android:layout_alignBottom="@+id/item_displaycount"
                android:drawableStart="@drawable/voice"
                android:layout_marginStart="15dp"
                android:layout_toEndOf="@+id/item_displaycount"/>
        </RelativeLayout>
    </RelativeLayout>
</com.huami.watch.companion.ximalaya.AlbumItem>
