<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/running_detail_shape_rect_white_corner_6"
    android:paddingBottom="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="10dp"
    android:layout_marginEnd="10dp">
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/moving_ui_strength_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/strength_training_exercise_part"
        android:layout_marginStart="14dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Rainbow.TextAppearance.Body3"/>
    <com.huami.moving.sport.ui.view.bar.BodyPositionView
        android:id="@+id/moving_ui_strength_body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:minWidth="134dp"
        android:layout_marginStart="30dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/moving_ui_strength_title"
        app:moving_ui_is_back_body="false"/>
    <com.huami.moving.sport.ui.view.bar.BodyPositionView
        android:id="@+id/moving_ui_strength_body_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:minWidth="134dp"
        android:layout_marginEnd="30dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/moving_ui_strength_title"
        app:moving_ui_is_back_body="true"/>
    <TextView
        android:textColor="@color/s2"
        android:gravity="center_vertical"
        android:id="@+id/moving_ui_strength_tips_first"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="17dp"
        android:text="@string/strength_training_exercise_main_muscles"
        android:drawablePadding="5dp"
        android:drawableStart="@drawable/moving_ui_shape_circle_red"
        android:layout_marginStart="14dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/moving_ui_strength_body"
        style="@style/Rainbow.TextAppearance.Body5"/>
    <TextView
        android:textColor="@color/s2"
        android:gravity="center_vertical"
        android:id="@+id/moving_ui_strength_tips_second"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="17dp"
        android:text="@string/strength_training_exercise_secondary_muscles"
        android:drawablePadding="5dp"
        android:drawableStart="@drawable/moving_ui_shape_circle_yellow"
        android:layout_marginStart="@dimen/size_20dp"
        app:layout_constraintStart_toEndOf="@+id/moving_ui_strength_tips_first"
        app:layout_constraintTop_toBottomOf="@+id/moving_ui_strength_body"
        style="@style/Rainbow.TextAppearance.Body5"/>
    <TextView
        android:textColor="@color/s2"
        android:gravity="center_vertical"
        android:id="@+id/moving_ui_strength_tips_third"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/strength_training_exercise_non_target_muscles"
        android:drawablePadding="5dp"
        android:drawableStart="@drawable/moving_ui_shape_circle_gary"
        android:layout_marginStart="14dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/moving_ui_strength_tips_first"
        style="@style/Rainbow.TextAppearance.Body5"/>
</androidx.constraintlayout.widget.ConstraintLayout>
