<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/s38"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/size_20sp"
        android:textColor="@color/s1"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:text="@string/headset_cervical_protection_seated_calibration"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/size_14sp"
        android:textColor="@color/s2"
        android:gravity="center"
        android:id="@+id/cervical_protection_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_20dp"
        android:text="@string/headset_cervical_protection_calibration_hint"
        android:paddingStart="@dimen/size_26dp"
        android:paddingEnd="@dimen/size_26dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/cervical_protection_img"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/td_size_44dp"
        android:src="@drawable/private_haydn_cervical_protection_calibration"
        android:scaleType="centerInside"
        app:layout_constraintDimensionRatio="h,1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.46"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cervical_protection_hint"/>
    <include
        android:id="@+id/cervical_protection_calibration_ing"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size_39dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        layout="@layout/bind_headset_search_hint"/>
    <Button
        android:textSize="@dimen/size_16sp"
        android:id="@+id/cervical_protection_calibration_btn"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_52dp"
        android:layout_marginBottom="@dimen/size_64dp"
        android:text="@string/headset_cervical_protection_calibration_start"
        android:layout_marginStart="@dimen/size_22dp"
        android:layout_marginEnd="@dimen/size_22dp"
        android:stateListAnimator="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
