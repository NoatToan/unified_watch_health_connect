<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minHeight="118dp">
    <com.huami.module.homepage.cards.cardui.CardTitleBarView
        android:id="@+id/heart_rate_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:showExpandButton="true"
        app:titleText="@string/homepage_item_card_heart_rate"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/heart"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="23dp"
        android:layout_marginStart="15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/heart_rate_bar"
        app:lottie_fileName="homepage_heart_animation.json"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/heart_rate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/heart"
        app:layout_constraintStart_toEndOf="@+id/heart"
        app:layout_constraintTop_toTopOf="@+id/heart"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <View
        android:background="@color/s4"
        android:layout_width="0.5dp"
        android:layout_height="40dp"
        android:layout_marginTop="53dp"
        app:layout_constraintEnd_toEndOf="@+id/rate_guideline"
        app:layout_constraintStart_toStartOf="@+id/rate_guideline"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.huami.module.homepage.cards.cardui.GradientLineView
        android:id="@+id/heart_rate_line"
        android:layout_width="170dp"
        android:layout_height="20dp"
        android:layout_marginTop="53dp"
        android:layout_marginEnd="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/heart_rate_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        app:layout_constraintStart_toStartOf="@+id/heart_rate_line"
        app:layout_constraintTop_toBottomOf="@+id/heart_rate_line"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <com.huami.module.homepage.cards.business.heartrate.HeartRateChartView
        android:id="@+id/detail"
        android:paddingBottom="12dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/heart"/>
    <com.huami.module.homepage.cards.cardui.BackgroundTextView
        android:textColor="@color/s1"
        android:gravity="center"
        android:id="@+id/no_hr_data"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:text="@string/homepage_item_card_no_hr_data"
        app:backgroundTintAlpha="0.92"
        app:layout_constraintBottom_toTopOf="@+id/detail"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/rate_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.4169"/>
</androidx.constraintlayout.widget.ConstraintLayout>
