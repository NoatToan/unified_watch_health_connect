<?xml version="1.0" encoding="utf-8"?>
<com.huami.lib.view.scroll.HMScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/normandy_setting_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/content_container"
        android:background="@color/view_base_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.huami.lib.view.scroll.HMExpandHeadView
            android:id="@+id/normandy_setting_icon_rl"
            android:background="@drawable/img_shoes_bg"
            android:layout_width="match_parent"
            android:layout_height="246dp">
            <ImageView
                android:id="@+id/normandy_setting_chart"
                android:background="@drawable/img_shoes_chip"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginTop="102dp"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/white"
                android:id="@+id/normandy_setting_low_battery_tips"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="@string/normandy_low_battery"
                android:layout_below="@+id/normandy_setting_chart"
                android:layout_centerHorizontal="true"/>
        </com.huami.lib.view.scroll.HMExpandHeadView>
        <FrameLayout
            android:id="@+id/container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <View
            android:background="@color/split_color"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <com.huami.lib.view.ItemView
                android:id="@+id/mars_mileage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:onClick="onClick"
                app:itemTitle="@string/shoes_setting_distance"/>
            <com.huami.lib.view.ItemView
                android:id="@+id/mars_place_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:onClick="onClick"
                app:itemTitle="@string/shoes_place_mode"
                app:itemValue="@string/shoes_left_shoe"/>
            <com.huami.lib.view.ItemView
                android:id="@+id/mars_setting_calibrate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:onClick="onClick"
                app:itemTitle="@string/shoes_setting_calibrate"/>
            <com.huami.lib.view.ItemView
                android:id="@+id/normandy_setting_firmware_version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:itemEndArrow="false"
                app:itemTitle="@string/shoes_setting_fw_version"/>
            <com.huami.lib.view.ItemView
                android:id="@+id/mac_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:itemEndArrow="false"
                app:itemTitle="@string/mili_setting_mac_address"/>
        </LinearLayout>
        <Button
            android:textColor="@color/tangerine"
            android:id="@+id/normandy_setting_unbind"
            android:layout_width="match_parent"
            android:text="@string/mili_setting_unbind"
            android:onClick="onClick"
            style="@style/unbindDevicesStyle"/>
    </LinearLayout>
</com.huami.lib.view.scroll.HMScrollView>
