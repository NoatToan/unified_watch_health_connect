<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.lib.rainbow.titlebar.RainbowTitleBar
        android:id="@+id/tv_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/setting_shotcut_apps_title"/>
    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tv_title_bar"/>
    <include
        android:id="@+id/notification_permission_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/container"
        layout="@layout/layout_music_permission"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/black40"
        android:gravity="center_vertical"
        android:id="@+id/sort_top_label"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:text="@string/sort_top_label"
        android:layout_below="@+id/notification_permission_container"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"/>
    <View
        android:id="@+id/sort_top_divider"
        android:background="@color/black20"
        android:layout_width="match_parent"
        android:layout_height="0.33dp"
        android:layout_below="@+id/sort_top_label"/>
    <com.xiaomi.hm.health.view.dslv.DragSortListView
        android:id="@+id/sort_listview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@color/black20"
        android:dividerHeight="0.33dp"
        android:layout_below="@+id/sort_top_divider"
        android:footerDividersEnabled="false"
        app:collapsed_height="2dp"
        app:drag_enabled="true"
        app:drag_scroll_start="0.33"
        app:float_alpha="0.6"
        app:max_drag_scroll_speed="0.5"
        app:slide_shuffle_speed="0.3"
        app:use_default_controller="false"/>
    <View
        android:id="@+id/mask_view"
        android:background="#77f7f7f7"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/container"/>
</RelativeLayout>
