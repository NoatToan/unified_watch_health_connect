<?xml version="1.0" encoding="utf-8"?>
<com.huami.lib.view.scroll.HMScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/s10"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.huami.lib.view.scroll.HMExpandHeadView
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_250dp">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/headset_thru_mode_bg"
                        android:scaleType="fitXY"/>
                    <ImageView
                        android:layout_gravity="center_horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/size_27dp"
                        android:src="@drawable/headset_action_logo"/>
                </FrameLayout>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/s3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_15dp"
                    android:text="@string/headset_side_listen_desc"
                    android:layout_marginStart="@dimen/size_56dp"
                    android:layout_marginEnd="@dimen/size_56dp"/>
            </LinearLayout>
        </com.huami.lib.view.scroll.HMExpandHeadView>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:id="@+id/container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <View
                android:background="@color/s4"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginStart="@dimen/common_item_padding"
                android:layout_marginEnd="@dimen/common_item_padding"/>
            <RelativeLayout
                android:paddingTop="@dimen/size_11dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/common_item_padding"
                android:paddingEnd="@dimen/common_item_padding">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/s1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/headset_side_listen_volume"
                    android:layout_alignParentStart="true"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/s3"
                    android:id="@+id/tv_side_listen_volume"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"/>
                <SeekBar
                    android:id="@+id/headset_vocal_enhancement_volume_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_26dp"
                    android:layout_marginBottom="@dimen/td_size_31dp"
                    android:max="100"
                    android:layout_below="@+id/tv_side_listen_volume"
                    style="@style/CustomSeekbarStyle"/>
            </RelativeLayout>
            <View
                android:id="@+id/side_listen_volume_divider"
                android:background="@color/split_color"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginStart="@dimen/common_item_padding"
                android:layout_marginEnd="@dimen/common_item_padding"/>
            <com.huami.lib.rainbow.ListTile
                android:id="@+id/headset_vocal_enhancement_item"
                android:background="@color/s38"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ltv_checked="false"
                app:ltv_subtitle="@string/headset_vocal_enhancement_desc"
                app:ltv_title="@string/headset_vocal_enhancement"/>
        </LinearLayout>
    </LinearLayout>
</com.huami.lib.view.scroll.HMScrollView>
