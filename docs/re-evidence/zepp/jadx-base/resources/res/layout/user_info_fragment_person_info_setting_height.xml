<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/dialog_empty_area"/>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/user_info_dialog_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/s1"
            android:gravity="center"
            android:id="@+id/dialog_title"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="@string/user_info_modify_height"
            style="@style/DialogTitleStyle"/>
        <View
            android:background="@color/user_info_activity_set_unit_divider_color"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/user_info_wheel_hight"
            android:layout_marginStart="@dimen/user_info_size_14dp"
            android:layout_marginEnd="@dimen/user_info_size_14dp">
            <com.huami.widget.wheelview.WheelView
                android:id="@+id/info_height_foot_wheel"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
            <com.huami.widget.wheelview.WheelView
                android:id="@+id/info_height_wheel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
        </LinearLayout>
        <View
            android:background="@color/user_info_activity_set_unit_divider_color"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:background="@color/user_info_trans"
            android:layout_width="match_parent"
            android:layout_height="55dp">
            <TextView
                android:textColor="@color/s2"
                android:gravity="center"
                android:id="@+id/height_btn_cancel"
                android:background="@drawable/selector_dialog_button_start"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/cancel"
                android:layout_weight="1"
                style="@style/DialogButtonStyle"/>
            <TextView
                android:textColor="@color/s1"
                android:gravity="center"
                android:id="@+id/height_btn_save"
                android:background="@drawable/selector_dialog_button_end"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/account_ui_yes"
                android:layout_weight="1"
                style="@style/DialogButtonStyle"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
