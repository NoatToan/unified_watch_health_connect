<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/search_title"
        android:background="@color/s38"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/search_edit_frame"
            android:background="@drawable/tr_shape_search_bg"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:layout_marginStart="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tv_cancel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/s3">
            <ImageView
                android:id="@+id/delete"
                android:visibility="gone"
                android:layout_width="30dp"
                android:layout_height="match_parent"
                android:src="@drawable/tr_ic_delete"
                android:scaleType="centerInside"
                android:paddingEnd="5dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="15sp"
            android:textColor="@color/p3"
            android:gravity="center"
            android:id="@+id/tv_cancel"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="@string/tr_cancel"
            android:fontFamily="lt"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/hot_search_zone"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@+id/search_title">
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="18sp"
            android:textColor="@color/s1"
            android:id="@+id/tv_hot_search"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tr_hot_search"
            android:fontFamily="lt"
            android:layout_marginStart="20dp"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/training_home_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            app:layout_constraintTop_toBottomOf="@+id/tv_hot_search"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcv_search_result"
        android:background="@color/s36"
        android:visibility="gone"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintBottom_toTopOf="@+id/load_more_bar"
        app:layout_constraintTop_toBottomOf="@+id/search_title"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/error_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/load_more_bar"
        app:layout_constraintTop_toBottomOf="@+id/search_title">
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="14sp"
            android:textColor="@color/s2"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_error_tips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="60dp"
            android:fontFamily="lt"/>
        <Button
            android:textSize="12sp"
            android:textColor="@color/tr_search_theme_color"
            android:id="@+id/retry"
            android:background="@drawable/tr_shape_corner_white_bg_orange_stroke"
            android:visibility="gone"
            android:layout_width="76dp"
            android:layout_height="24dp"
            android:layout_marginTop="16.7dp"
            android:text="@string/tr_refresh"
            android:fontFamily="lt"
            style="?android:attr/borderlessButtonStyle"/>
    </LinearLayout>
    <ProgressBar
        android:id="@+id/loading_bar"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        app:layout_constraintBottom_toTopOf="@+id/load_more_bar"
        app:layout_constraintTop_toBottomOf="@+id/search_title"
        style="?android:attr/progressBarStyle"/>
    <ProgressBar
        android:id="@+id/load_more_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        style="?android:attr/progressBarStyleHorizontal"/>
</androidx.constraintlayout.widget.ConstraintLayout>
