<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/dialog_empty_area"/>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/dialog_bg_weight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="@color/s1"
                android:gravity="center"
                android:id="@+id/titleTv"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:text="@string/record_weight"
                style="@style/DialogTitleStyle"/>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/wheel_hight"
                android:layout_marginTop="4dp">
                <LinearLayout
                    android:orientation="horizontal"
                    android:background="@drawable/bg_rect"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/wheel_hight"
                    android:minHeight="@dimen/item_height"
                    android:layout_marginStart="@dimen/account_ui_size_14dp"
                    android:layout_marginEnd="@dimen/account_ui_size_14dp">
                    <com.huami.widget.wheelview.WheelView
                        android:id="@+id/info_weight_int_wheel"
                        android:background="@color/s39"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"/>
                    <com.huami.widget.wheelview.WheelView
                        android:id="@+id/info_weight_decimal_wheel"
                        android:background="@color/s39"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"/>
                </LinearLayout>
            </RelativeLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:background="@color/trans"
            android:layout_width="match_parent"
            android:layout_height="55dp">
            <TextView
                android:textColor="@color/s2"
                android:gravity="center"
                android:id="@+id/weight_btn_cancel"
                android:background="@drawable/selector_dialog_button_start"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/cancel"
                android:layout_weight="1"
                style="@style/DialogButtonStyle"/>
            <View
                android:background="@color/s4"
                android:layout_width="1px"
                android:layout_height="match_parent"/>
            <TextView
                android:textColor="@color/s1"
                android:gravity="center"
                android:id="@+id/weight_btn_save"
                android:background="@drawable/selector_dialog_button_end"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/save"
                android:layout_weight="1"
                style="@style/DialogButtonStyle"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
