<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white100"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.moving.ui.view.MapHelperLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:shield="true">
        <FrameLayout
            android:id="@+id/map"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.huami.moving.ui.view.MapHelperLayout>
    <ImageView
        android:id="@+id/markedFlag"
        android:background="@drawable/shape_sgin_bg"
        android:padding="5dp"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="96dp"
        android:src="@drawable/ic_km_display_20_s5"
        android:layout_above="@+id/mapFlag"
        android:layout_marginStart="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/satelliteFlag"
        android:background="@drawable/shape_sgin_bg"
        android:padding="5dp"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:src="@drawable/ic_satellite_display_20_s5"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="12.7dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/markedFlag"/>
    <ImageView
        android:id="@+id/mapFlag"
        android:background="@drawable/shape_sgin_bg"
        android:padding="5dp"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="12dp"
        android:src="@drawable/ic_appear_20_s5"
        android:layout_marginStart="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/satelliteFlag"/>
    <ImageView
        android:id="@+id/loactionFlag"
        android:background="@drawable/shape_sgin_bg"
        android:padding="5dp"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:src="@drawable/ic_location_20_s5"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="12.7dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mapFlag"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="12sp"
        android:textColor="#8d8d8d"
        android:gravity="center"
        android:id="@+id/line_map_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:fontFamily="lt"
        android:layout_marginStart="15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_logo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_sport_detail_logo_have_gps"
        android:layout_marginEnd="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/markedFlag"/>
</androidx.constraintlayout.widget.ConstraintLayout>
