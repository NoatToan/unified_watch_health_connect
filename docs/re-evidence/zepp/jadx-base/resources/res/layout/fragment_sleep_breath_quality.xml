<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:orientation="vertical"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@color/s38"
            android:paddingBottom="30dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.huami.sleep.view.UnitTextView
                android:textSize="40sp"
                android:textColor="@color/s1"
                android:id="@+id/scoreTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="42dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:typeface="km"
                app:unitColor="@color/s2"
                app:unitSize="14sp"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textColor="@color/s1"
                android:id="@+id/ref_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/sleep_breath_quality_reference_value"
                app:layout_constraintBottom_toTopOf="@+id/value_tip"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/scoreTv"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/s2"
                android:gravity="center"
                android:id="@+id/value_tip"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:paddingStart="30dp"
                android:paddingEnd="30dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ref_value"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@drawable/sleep_main_bg"
            android:padding="@dimen/slp_size_15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/slp_size_15dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="@dimen/slp_size_15dp">
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="@dimen/slp_size_18sp"
                android:textStyle="bold"
                android:textColor="@color/s44"
                android:id="@+id/scoreDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.huami.view.weightfigure.WeightFigureView
                android:layout_gravity="center_horizontal"
                android:id="@+id/breath_figure_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/scoreDesc"
                app:type="unmoveable"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/odiListLayout"
            android:background="@drawable/sleep_main_bg"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/slp_size_15dp"
            android:layout_marginTop="@dimen/slp_size_15dp"
            android:layout_marginRight="@dimen/slp_size_15dp">
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="@dimen/slp_size_18sp"
                android:textStyle="bold"
                android:textColor="@color/s44"
                android:id="@+id/textView5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="@string/suspected_od"
                android:layout_marginStart="15dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/odiListView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView5"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/sleep_main_bg"
            android:paddingLeft="@dimen/slp_size_15dp"
            android:paddingRight="@dimen/slp_size_15dp"
            android:paddingBottom="@dimen/slp_size_15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/slp_size_15dp"
            android:layout_marginTop="@dimen/slp_size_15dp"
            android:layout_marginRight="@dimen/slp_size_15dp">
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="@dimen/slp_size_18sp"
                android:textStyle="bold"
                android:textColor="@color/s44"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/slp_size_15dp"
                android:text="@string/sleep_breath_relationship"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="@dimen/slp_size_14sp"
                android:textColor="@color/s2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/sleep_breath_relationship_text2"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/sleep_main_bg"
            android:paddingLeft="@dimen/slp_size_15dp"
            android:paddingRight="@dimen/slp_size_15dp"
            android:paddingBottom="@dimen/slp_size_15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/slp_size_15dp"
            android:layout_marginTop="@dimen/slp_size_15dp"
            android:layout_marginRight="@dimen/slp_size_15dp">
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="@dimen/slp_size_18sp"
                android:textStyle="bold"
                android:textColor="@color/s44"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/slp_size_15dp"
                android:text="@string/how_increase_sleep_breath_quality"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/funcListView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
        </LinearLayout>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/s2"
            android:id="@+id/sleep_reference_documents"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="@string/sleep_reference_documents"
            android:layout_marginStart="30dp"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/s2"
            android:layout_gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/sleep_breath_references"
            android:lineSpacingExtra="10dp"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="@dimen/slp_size_12sp"
            android:textColor="@color/s3"
            android:paddingLeft="30dp"
            android:paddingRight="30dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/slp_size_15dp"
            android:text="@string/sleep_breath_beta_tip"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/s15"
            android:layout_gravity="center"
            android:id="@+id/feed_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="30dp"
            android:text="@string/sleep_feedback_to_us"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
