<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s36"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nested_scrollview"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/card_in_use"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/size_12sp"
                    android:textColor="@color/s2"
                    android:id="@+id/title_default_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/wl_border_margin"
                    android:text="@string/wl_default_card_use"
                    android:drawableBottom="@color/s4"
                    android:paddingStart="@dimen/wl_border_margin"
                    android:paddingEnd="@dimen/wl_border_margin"/>
                <View
                    android:background="@color/s4"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size_0.5dp"
                    android:layout_marginTop="@dimen/wl_item_spacing"
                    android:layout_marginStart="@dimen/wl_border_margin"
                    android:layout_marginEnd="@dimen/wl_border_margin"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="@dimen/wl_item_spacing">
                    <androidx.cardview.widget.CardView
                        android:id="@+id/card"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_marginStart="@dimen/wl_border_margin"
                        android:layout_marginEnd="@dimen/wl_border_margin"
                        app:cardCornerRadius="@dimen/wl_image_round_rect_radius"
                        app:cardPreventCornerOverlap="false"
                        app:layout_constraintDimensionRatio="324:205"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <ImageView
                            android:id="@+id/card_image_default"
                            android:focusable="true"
                            android:clickable="true"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/wl_placeholder_image"
                            android:scaleType="centerCrop"/>
                    </androidx.cardview.widget.CardView>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/cards_idle"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/size_12sp"
                    android:textColor="@color/s2"
                    android:id="@+id/title_idle_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/wl_border_margin"
                    android:text="@string/wl_idle_card"
                    android:paddingStart="@dimen/wl_border_margin"
                    android:paddingEnd="@dimen/wl_border_margin"/>
                <View
                    android:background="@color/s4"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size_0.5dp"
                    android:layout_marginTop="@dimen/wl_item_spacing"
                    android:layout_marginStart="@dimen/wl_border_margin"
                    android:layout_marginEnd="@dimen/wl_border_margin"/>
                <com.loopeer.cardstack.CardStackView
                    android:id="@+id/card_stack"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="@dimen/wl_item_spacing"
                    app:stackNumBottomShow="3"
                    app:stackOverlapGaps="80dp"
                    app:stackOverlapGapsCollapse="40dp"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <include
        android:visibility="gone"
        layout="@layout/wl_retry"/>
</RelativeLayout>
