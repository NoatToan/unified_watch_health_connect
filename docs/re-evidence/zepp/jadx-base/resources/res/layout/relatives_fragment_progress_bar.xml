<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="bottom"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@color/s39"
        android:layout_width="match_parent"
        android:layout_height="@dimen/relatives_size_67dp"
        android:paddingStart="@dimen/relatives_size_20dp"
        android:paddingEnd="@dimen/relatives_size_0dp">
        <ProgressBar
            android:layout_width="@dimen/relatives_size_36dp"
            android:layout_height="@dimen/relatives_size_36dp"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/relatives_custom_progress_draw"
            android:indeterminateDuration="700"
            android:indeterminateTint="@color/s1"
            android:indeterminateTintMode="src_in"
            style="@android:style/Widget.ProgressBar"/>
        <TextView
            android:textColor="@color/s1"
            android:gravity="center_vertical"
            android:id="@+id/progress_txt"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/relatives_unbinding"
            android:paddingStart="@dimen/relatives_size_10dp"
            android:paddingEnd="@dimen/relatives_size_0dp"/>
    </LinearLayout>
</LinearLayout>
