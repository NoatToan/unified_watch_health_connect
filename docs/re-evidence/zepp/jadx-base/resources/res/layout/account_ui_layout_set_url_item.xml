<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#f4f5f5"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <Spinner
        android:id="@+id/set_test_url_txt_spinner"
        android:background="@color/account_ui_white100"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_alignParentTop="true"
        android:spinnerMode="dropdown"
        android:layout_marginStart="@dimen/account_ui_mili_margin"
        android:layout_marginEnd="@dimen/account_ui_mili_margin"/>
    <ImageView
        android:id="@+id/set_test_url_img"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:src="@drawable/account_ui_arrow_downward"
        android:scaleType="centerInside"
        android:layout_alignParentTop="true"
        android:layout_marginEnd="@dimen/account_ui_mili_margin"
        android:layout_alignParentEnd="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/set_test_url_txt_input"
        android:background="@color/account_ui_gray"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/set_test_url_txt_spinner"
        android:layout_marginStart="@dimen/account_ui_mili_margin"
        android:layout_marginEnd="@dimen/account_ui_mili_margin">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="@color/account_ui_black"
                android:gravity="center"
                android:id="@+id/set_test_url_txt_input_http"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/account_ui_txt_input_http"
                android:layout_weight="1"/>
            <View
                android:background="@color/account_ui_white100"
                android:layout_width="1px"
                android:layout_height="match_parent"
                android:layout_margin="3dp"/>
            <TextView
                android:textColor="@color/account_ui_black"
                android:gravity="center"
                android:id="@+id/set_test_url_txt_input_https"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/account_ui_txt_input_https"
                android:layout_weight="1"/>
            <View
                android:background="@color/account_ui_white100"
                android:layout_width="1px"
                android:layout_height="match_parent"
                android:layout_margin="3dp"/>
            <TextView
                android:textColor="@color/account_ui_black"
                android:gravity="center"
                android:id="@+id/set_test_url_txt_input_www"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/account_ui_txt_input_www"
                android:layout_weight="1"/>
            <View
                android:background="@color/account_ui_white100"
                android:layout_width="1px"
                android:layout_height="match_parent"
                android:layout_margin="3dp"/>
            <TextView
                android:textColor="@color/account_ui_black"
                android:gravity="center"
                android:id="@+id/set_test_url_txt_input_separator"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/account_ui_txt_input_separator"
                android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="@color/account_ui_black"
                android:gravity="center"
                android:id="@+id/set_test_url_txt_input_com"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/account_ui_txt_input_com"
                android:layout_weight="1"/>
            <View
                android:background="@color/account_ui_white100"
                android:layout_width="1px"
                android:layout_height="match_parent"
                android:layout_margin="3dp"/>
            <TextView
                android:textColor="@color/account_ui_black"
                android:gravity="center"
                android:id="@+id/set_test_url_txt_input_cn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/account_ui_txt_input_cn"
                android:layout_weight="1"/>
            <View
                android:background="@color/account_ui_white100"
                android:layout_width="1px"
                android:layout_height="match_parent"
                android:layout_margin="3dp"/>
            <TextView
                android:textColor="@color/account_ui_black"
                android:gravity="center"
                android:id="@+id/set_test_url_txt_input_dot"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/account_ui_txt_input_dot"
                android:layout_weight="1"/>
            <View
                android:background="@color/account_ui_white100"
                android:layout_width="1px"
                android:layout_height="match_parent"
                android:layout_margin="3dp"/>
            <TextView
                android:textColor="#ff0000"
                android:gravity="center"
                android:id="@+id/set_test_url_clear"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/account_ui_test_url_clear"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
    <EditText
        android:textColor="@color/account_ui_black70"
        android:textColorHint="@color/account_ui_black40"
        android:gravity="start|top"
        android:id="@+id/set_test_url_txt"
        android:background="@color/account_ui_white100"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/set_test_url_txt_input"
        android:inputType="textUri"
        android:textCursorDrawable="@null"
        android:layout_marginStart="@dimen/account_ui_mili_margin"
        android:layout_marginEnd="@dimen/account_ui_mili_margin"/>
</RelativeLayout>
