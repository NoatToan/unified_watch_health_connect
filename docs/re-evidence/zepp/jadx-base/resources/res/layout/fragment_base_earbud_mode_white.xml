<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/title_content"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:layout_marginTop="24dp">
        <ImageView
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_earbud_back_white"
            android:layout_centerVertical="true"
            android:onClick="onReturnClick"
            android:layout_marginStart="11dp"/>
        <ImageView
            android:id="@+id/set_btn"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/icon_earbud_set_white"
            android:layout_centerVertical="true"
            android:onClick="toEarbudSetting"
            android:layout_marginEnd="11dp"
            android:layout_alignParentEnd="true"/>
        <ImageView
            android:id="@+id/update_red_dot"
            android:background="@drawable/ic_red_circle"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_alignTop="@+id/set_btn"
            android:layout_alignEnd="@+id/set_btn"/>
    </RelativeLayout>
    <TextView
        android:textSize="13sp"
        android:textColor="#ffffffff"
        android:gravity="end|center_vertical"
        android:id="@+id/left_battery"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:drawablePadding="13dp"
        android:drawableStart="@drawable/icon_earbud_electric_left"
        android:layout_marginStart="30dp"/>
    <TextView
        android:textSize="13sp"
        android:textColor="#ffffffff"
        android:gravity="end|center_vertical"
        android:id="@+id/right_battery"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:drawablePadding="13dp"
        android:drawableStart="@drawable/icon_earbud_electric_right"
        android:layout_marginStart="30dp"/>
    <FrameLayout
        android:id="@+id/content_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="20"/>
    <androidx.constraintlayout.widget.Placeholder
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/bg_earbud_music_play_setting_trans"
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="90dp"
        android:minHeight="80dp"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/ic_play"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/icon_earbud_music_play_white"/>
                <TextView
                    android:textSize="17sp"
                    android:textColor="#99ffffff"
                    android:gravity="center_vertical"
                    android:id="@+id/music_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/icon_earbud_voice_white"/>
                <SeekBar
                    android:id="@+id/volume_seek"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:maxHeight="2dp"
                    android:progressDrawable="@drawable/earbud_white_seekbar"
                    android:thumb="@drawable/icon_earbud_seek_thumb"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="#99ffffff"
                    android:id="@+id/volume_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>
        <ImageView
            android:id="@+id/music_control"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/icon_music_pause_grey"
            android:layout_marginStart="10dp"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.Placeholder
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
</LinearLayout>
