<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:background="@color/relatives_white"
    android:layout_width="match_parent"
    android:layout_height="@dimen/relatives_size_64dp">
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="start|center_vertical"
        android:id="@+id/icon"
        android:background="@drawable/relatives_person_avatar_default"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="@dimen/relatives_size_32dp"
        android:layout_height="@dimen/relatives_size_32dp"
        android:scaleType="fitCenter"
        android:layout_marginStart="@dimen/relatives_common_item_padding"/>
    <RelativeLayout
        android:layout_gravity="start|center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/relatives_size_60dp">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/relatives_black70"
            android:ellipsize="end"
            android:id="@+id/username"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/relatives_size_235dp"
            android:maxLines="1"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/relatives_black40"
            android:id="@+id/uid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/username"/>
    </RelativeLayout>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/relatives_common_light_color"
        android:gravity="center"
        android:layout_gravity="end|center_vertical"
        android:id="@+id/add_button"
        android:background="@drawable/relatives_friend_corner_rect"
        android:paddingTop="@dimen/relatives_size_5dp"
        android:paddingBottom="@dimen/relatives_size_5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/relatives_title_add_friend"
        android:paddingStart="@dimen/relatives_size_12dp"
        android:paddingEnd="@dimen/relatives_size_12dp"
        android:layout_marginEnd="@dimen/relatives_common_item_padding"/>
</FrameLayout>
