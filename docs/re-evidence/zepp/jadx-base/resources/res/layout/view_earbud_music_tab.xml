<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/s36"
    android:layout_width="match_parent"
    android:layout_height="80dp">
    <ImageView
        android:id="@+id/arrow_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:src="@drawable/icon_earbud_pull_down"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:gravity="bottom|center_horizontal"
        android:id="@+id/music_tab_my"
        android:paddingTop="10dp"
        android:paddingBottom="24dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/earbud_music_my"
        android:includeFontPadding="false"
        android:layout_alignParentBottom="true"
        android:paddingStart="20dp"
        android:paddingEnd="8dp"
        style="@style/earbud_music_tab_select"/>
    <TextView
        android:gravity="bottom|center_horizontal"
        android:id="@+id/music_tab_list"
        android:paddingTop="10dp"
        android:paddingBottom="24dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/earbud_music_list"
        android:includeFontPadding="false"
        android:layout_alignBottom="@+id/music_tab_my"
        android:paddingStart="8dp"
        android:paddingEnd="20dp"
        android:layout_toEndOf="@+id/music_tab_my"
        style="@style/earbud_music_tab_unselect"/>
</RelativeLayout>
