<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="#f4f5f5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/main_ui_content_color"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="25dp"
            android:text="@string/choose_device_please"
            android:paddingStart="@dimen/mili_margin"
            android:paddingEnd="@dimen/mili_margin"/>
        <include
            android:layout_width="match_parent"
            android:layout_height="1px"
            layout="@layout/divider_horizontal"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ll_mili"
            android:background="@drawable/bg_item"
            android:layout_width="match_parent"
            android:layout_height="45dp">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/imv_device_type_mili"
                android:background="@drawable/bg_item"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/arrow_single_choice_orange"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                app:layout_constraintStart_toStartOf="parent"/>
            <TextView
                android:textSize="12.7sp"
                android:textColor="@color/main_ui_title_color"
                android:gravity="center_vertical"
                android:id="@+id/tx_device_type_mili"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                app:layout_constraintStart_toEndOf="@+id/imv_device_type_mili"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="horizontal"
            android:id="@+id/ll_shoes"
            android:background="@drawable/bg_item"
            android:layout_width="match_parent"
            android:layout_height="45dp">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/imv_device_type_shoes"
                android:background="@drawable/bg_item"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/arrow_single_choice_orange"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                app:layout_constraintStart_toStartOf="parent"/>
            <TextView
                android:textSize="12.7sp"
                android:textColor="@color/main_ui_title_color"
                android:gravity="center_vertical"
                android:id="@+id/tx_device_type_shoes"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                app:layout_constraintStart_toEndOf="@+id/imv_device_type_shoes"/>
            <include
                android:layout_width="0dp"
                android:layout_height="1px"
                app:layout_constraintStart_toEndOf="@+id/imv_device_type_shoes"
                layout="@layout/divider_horizontal"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ll_blue_monkey"
            android:background="@drawable/bg_item"
            android:layout_width="match_parent"
            android:layout_height="45dp">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/imv_device_type_other"
                android:background="@drawable/bg_item"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/arrow_single_choice_orange"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                app:layout_constraintStart_toStartOf="parent"/>
            <TextView
                android:textSize="12.7sp"
                android:textColor="@color/main_ui_title_color"
                android:gravity="center_vertical"
                android:id="@+id/tx_device_type_other"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                app:layout_constraintStart_toEndOf="@+id/imv_device_type_other"/>
            <include
                android:layout_width="0dp"
                android:layout_height="1px"
                app:layout_constraintStart_toEndOf="@+id/imv_device_type_other"
                layout="@layout/divider_horizontal"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</FrameLayout>
