<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/common_title_bar_parent"
    android:layout_width="match_parent"
    android:layout_height="@dimen/common_title_height">
    <RelativeLayout
        android:id="@+id/common_title_bar_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:id="@+id/common_title_center_layout"
            android:layout_width="184dp"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_centerVertical="true">
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="@dimen/base_title_size"
                android:textColor="@color/base_title_color"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/common_title_center_top_text"
                android:background="@null"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleType="fitCenter"
                android:maxWidth="240dp"
                android:maxLines="1"
                android:singleLine="true"
                android:layout_centerHorizontal="true"
                android:textAllCaps="false"
                android:fontFamily="lt"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="@dimen/base_subtitle_size"
                android:textColor="@color/base_sub_title_color"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/common_title_center_bottom_text"
                android:background="@null"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="240dp"
                android:maxLines="1"
                android:singleLine="true"
                android:layout_below="@+id/common_title_center_top_text"
                android:layout_centerHorizontal="true"
                android:textAllCaps="false"
                android:fontFamily="lt"
                app:autoSizeMaxTextSize="@dimen/base_subtitle_size"
                app:autoSizeMinTextSize="6sp"
                app:autoSizeTextType="uniform"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/left_area"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp">
            <Button
                android:textSize="12sp"
                android:gravity="center"
                android:id="@+id/common_title_left_text"
                android:background="@null"
                android:padding="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleType="fitCenter"
                android:maxWidth="68dp"
                android:minWidth="48dp"
                android:minHeight="0dp"
                android:maxLines="1"
                android:layout_centerVertical="true"
                android:textAllCaps="false"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="14dp"
                app:autoSizeMaxTextSize="12sp"
                app:autoSizeMinTextSize="9sp"
                app:autoSizeTextType="uniform"/>
            <ImageButton
                android:textSize="12sp"
                android:gravity="center"
                android:id="@+id/common_title_left_image"
                android:background="@null"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:scaleType="center"
                android:layout_centerVertical="true"
                android:textAllCaps="false"
                android:layout_marginEnd="1dp"/>
            <ImageButton
                android:textSize="12sp"
                android:gravity="center"
                android:id="@+id/common_title_left_image2"
                android:background="@null"
                android:visibility="gone"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:scaleType="center"
                android:layout_centerVertical="true"
                android:textAllCaps="false"
                android:layout_toEndOf="@+id/common_title_left_image"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/right_area"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp"
            android:layout_alignParentEnd="true">
            <ImageButton
                android:gravity="center"
                android:id="@+id/common_title_right_text2"
                android:background="@null"
                android:visibility="gone"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/common_title_cancel"
                android:scaleType="center"
                android:layout_centerVertical="true"
                android:textAllCaps="false"
                android:layout_alignParentStart="true"/>
            <Button
                android:textSize="12sp"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/common_title_right_text"
                android:background="@null"
                android:padding="0dp"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:maxWidth="80dp"
                android:singleLine="true"
                android:layout_centerVertical="true"
                android:textAllCaps="false"
                android:layout_marginEnd="10dp"
                android:layout_toEndOf="@+id/common_title_right_text2"/>
            <ImageButton
                android:id="@+id/common_title_right_image"
                android:background="@null"
                android:visibility="gone"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:scaleType="center"
                android:layout_centerVertical="true"
                android:textAllCaps="false"
                android:layout_toEndOf="@+id/common_title_right_text2"/>
        </RelativeLayout>
        <ImageButton
            android:id="@+id/common_title_right_func"
            android:background="@null"
            android:visibility="gone"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/common_title_func"
            android:scaleType="center"
            android:layout_centerVertical="true"
            android:textAllCaps="false"
            android:layout_marginEnd="15dp"
            android:layout_alignParentEnd="true"/>
        <View
            android:id="@+id/common_title_right_red_dot"
            android:background="@drawable/ic_red_circle"
            android:visibility="gone"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginTop="9dp"
            android:layout_marginEnd="9dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</LinearLayout>
