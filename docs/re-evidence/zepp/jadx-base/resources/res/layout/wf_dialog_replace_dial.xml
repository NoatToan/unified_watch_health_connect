<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@drawable/wf_tip_dialog_bg"
    android:layout_width="295dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="40dp"
    android:layout_marginEnd="40dp">
    <TextView
        android:textSize="16sp"
        android:textColor="#ffffff"
        android:id="@+id/dialog_msg"
        android:paddingTop="30dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/wf_detail_dial_replace_tip"
        android:paddingStart="43dp"
        android:paddingEnd="43dp"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rl_dial_list"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:paddingStart="43dp"
        android:paddingEnd="43dp"/>
    <View
        android:background="#19f2f2f2"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <LinearLayout
        android:id="@+id/dialog_bottom_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="16sp"
            android:textColor="#66ffffff"
            android:gravity="center"
            android:id="@+id/dialog_cancel"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/wf_dialog_tip_cancel"
            android:layout_weight="1"/>
        <View
            android:layout_gravity="center_vertical"
            android:background="#1affffff"
            android:layout_width="1dp"
            android:layout_height="24dp"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/dialog_confirm"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/wf_detail_ensure_replace_dial"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
