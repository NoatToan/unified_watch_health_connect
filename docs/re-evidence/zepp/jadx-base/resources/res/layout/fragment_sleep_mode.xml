<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s10"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/layout_toolbar"/>
    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/dnd_container"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>
    <FrameLayout
        android:id="@+id/sleep_mode_container"
        android:background="@color/s10"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/container">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                app:cardBackgroundColor="@color/s38"
                app:cardCornerRadius="6dp"
                app:cardElevation="0dp">
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/sleep_mode_screen_lt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ltv_checked="true"
                    app:ltv_subtitle="@string/sleep_watch_screen_tips"
                    app:ltv_title="@string/sleep_watch_screen"/>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                app:cardBackgroundColor="@color/s38"
                app:cardCornerRadius="6dp"
                app:cardElevation="0dp">
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/sleep_watch_screen_smart_enable_lt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ltv_checked="true"
                    app:ltv_subtitle="@string/sleep_watch_screen_smart_enable_tips"
                    app:ltv_title="@string/sleep_watch_screen_smart_enable"/>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
        <View
            android:id="@+id/mask_view"
            android:background="@color/cl_4d000000"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
