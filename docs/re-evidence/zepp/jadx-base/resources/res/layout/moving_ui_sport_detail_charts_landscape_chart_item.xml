<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <CheckBox
        android:textAppearance="@style/Rainbow.TextAppearance.Body4"
        android:textColor="@color/s2"
        android:id="@+id/moving_ui_chart_select_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="true"
        android:button="@drawable/ic_overlay_checkbox"
        android:text="@string/running_help_adjust_speed"
        android:layout_marginStart="@dimen/d2"
        android:layout_marginEnd="@dimen/d1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/Rainbow.TextAppearance.Body4"
        android:textColor="@color/s1"
        android:gravity="center"
        android:id="@+id/moving_ui_chart_select_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        app:layout_constraintEnd_toEndOf="@+id/moving_ui_chart_select_icon"
        app:layout_constraintStart_toStartOf="@+id/moving_ui_chart_select_icon"
        app:layout_constraintTop_toBottomOf="@+id/moving_ui_chart_select_icon"/>
</androidx.constraintlayout.widget.ConstraintLayout>
