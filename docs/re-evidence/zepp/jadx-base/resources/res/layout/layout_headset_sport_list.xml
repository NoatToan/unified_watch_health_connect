<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/view_group_headset_sport_settings"
    android:background="@color/s38"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/s38"
    app:cardCornerRadius="6dp"
    app:cardElevation="0px"
    app:cardUseCompatPadding="false">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.huami.lib.rainbow.ListTile
            android:id="@+id/item_headset_settings_running_recognition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:itemDivider="gone"
            app:ltv_checked="false"
            app:ltv_subtitle="@string/settings_item_running_recognition_summary"
            app:ltv_title="@string/settings_item_running_recognition"/>
        <com.huami.lib.rainbow.ListTile
            android:id="@+id/item_headset_settings_hr_broadcast"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:ltv_subtitle="@string/headset_hr_broadcast_summary"
            app:ltv_title="@string/headset_hr_broadcast"/>
        <com.huami.lib.rainbow.ListTile
            android:id="@+id/item_headset_settings_high_hr_reminder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:itemDivider="gone"
            app:ltv_checked="false"
            app:ltv_subtitle="@string/settings_item_high_hr_reminder_summary"
            app:ltv_title="@string/settings_item_high_hr_reminder"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/hr_seek_bar_container"
            android:background="@color/s38"
            android:paddingTop="@dimen/size_20dp"
            android:paddingBottom="@dimen/size_17dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/size_17dp"
            android:paddingEnd="@dimen/size_17dp">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/hr_value_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.huami.widget.typeface.TypefaceTextView
                    android:textSize="15.4sp"
                    android:textColor="@color/s1"
                    android:id="@+id/hr_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableBottom="@drawable/triangle_drop_down"
                    android:drawablePadding="7dp"
                    android:fontFamily="km"/>
            </LinearLayout>
            <com.xiaomi.hm.health.ui.widget.HeartRateSeekBar
                android:id="@+id/seek_bar_max_hr"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_28dp"
                android:layout_marginTop="@dimen/size_12dp"
                app:hrsb_backgroundHeight="3dp"
                app:hrsb_max="220"
                app:hrsb_progress="0"
                app:hrsb_section_colors="@array/sport_hr_section_colors"
                app:hrsb_thumbSize="20.2dp"/>
            <TextView
                android:textSize="@dimen/td_size_11sp"
                android:textColor="@color/s3"
                android:layout_gravity="end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_6dp"
                android:layout_marginBottom="@dimen/size_1dp"
                android:text="@string/sport_heart_rate_unit"
                android:layout_marginEnd="@dimen/size_3dp"/>
        </LinearLayout>
        <com.huami.lib.rainbow.ListTile
            android:id="@+id/item_headset_settings_beat_enhancement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:itemDivider="gone"
            app:ltv_checked="false"
            app:ltv_subtitle="@string/settings_item_beat_enhancement_summary"
            app:ltv_title="@string/settings_item_beat_enhancement"/>
        <com.huami.lib.rainbow.ListTile
            android:id="@+id/item_headset_settings_percussion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:ltv_checked="false"
            app:ltv_subtitle="@string/settings_item_percussion_summary"
            app:ltv_title="@string/settings_item_percussion"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.cardview.widget.CardView>
