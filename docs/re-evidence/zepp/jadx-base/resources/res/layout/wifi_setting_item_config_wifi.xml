<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="120dp"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">
    <FrameLayout
        android:id="@+id/layout_wifi_name"
        android:layout_width="match_parent"
        android:layout_height="40dp">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="15sp"
            android:textColor="@color/s1"
            android:ellipsize="end"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/tv_wifi_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AHHM"
            android:maxLines="1"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/iv_wifi_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/wifi_setting_icon_wifi"
            android:tint="@color/s1"/>
    </FrameLayout>
    <View
        android:id="@+id/line"
        android:background="@color/s5"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@+id/layout_wifi_name"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="10dp"
        android:layout_alignParentBottom="true">
        <Button
            android:textSize="15sp"
            android:gravity="center"
            android:id="@+id/tv_reset"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/wifi_reset"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            style="?attr/buttonStyleRed_48_outline"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="15sp"
            android:gravity="center"
            android:id="@+id/tv_remove"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/wifi_remove"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            style="?attr/buttonStyleGray_48_flat"/>
    </LinearLayout>
</RelativeLayout>
