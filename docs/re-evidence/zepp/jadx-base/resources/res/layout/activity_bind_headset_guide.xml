<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="20sp"
        android:textColor="@color/s1"
        android:gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_98dp"
        android:text="@string/bind_headset_tips_title"
        android:layout_centerHorizontal="true"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14sp"
        android:textColor="@color/s2"
        android:gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_9dp"
        android:text="@string/bind_headset_tips_msg"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="@dimen/size_40dp"
        android:layout_marginEnd="@dimen/size_40dp"/>
    <Space
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/img_bind_headset_guide"/>
        <com.airbnb.lottie.LottieAnimationView
            android:layout_gravity="bottom|center_horizontal"
            android:layout_width="@dimen/size_52dp"
            android:layout_height="@dimen/size_52dp"
            android:layout_marginBottom="@dimen/td_size_43dp"
            android:scaleType="centerCrop"
            app:lottie_autoPlay="true"
            app:lottie_fileName="anim_mozart_tap_box_btn.json"
            app:lottie_loop="true"/>
    </FrameLayout>
    <Space
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="3"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size_20dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/size_20dp"
        android:layout_marginEnd="@dimen/size_20dp">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/s1"
            android:gravity="center"
            android:id="@+id/tv_cancel"
            android:background="@drawable/bg_bind_device_cancel"
            android:layout_width="0dp"
            android:layout_height="@dimen/size_48dp"
            android:text="@string/parental_authorization_back"
            android:layout_weight="1"/>
        <Space
            android:layout_width="@dimen/size_21dp"
            android:layout_height="0dp"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/p3"
            android:gravity="center"
            android:id="@+id/tv_next"
            android:background="@drawable/bg_bind_device_cancel"
            android:layout_width="0dp"
            android:layout_height="@dimen/size_48dp"
            android:text="@string/next_step"
            android:layout_weight="1"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.appcompat.widget.LinearLayoutCompat>
