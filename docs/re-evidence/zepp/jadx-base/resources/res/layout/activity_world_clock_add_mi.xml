<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/cl_ffedeff0"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/search_area"
        android:paddingTop="@dimen/size_10dp"
        android:paddingBottom="@dimen/size_10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.huami.worldclock.component.ClearEditText
            android:textSize="@dimen/size_13sp"
            android:textColor="@color/cl_e6000000"
            android:textColorHint="@color/cl_33000000"
            android:gravity="start|center_vertical"
            android:id="@+id/search_edit_text"
            android:background="@drawable/shape_clear_edittext_mi"
            android:layout_width="0dp"
            android:layout_height="@dimen/size_28dp"
            android:hint="@string/mi_search_hint"
            android:drawablePadding="@dimen/size_10dp"
            android:layout_weight="1"
            android:textCursorDrawable="@drawable/shape_text_cursor_mi"
            android:drawableStart="@drawable/icon_world_clock_search"
            android:drawableEnd="@drawable/icon_world_clock_clear"
            android:textDirection="locale"
            android:textAlignment="viewStart"
            android:layoutDirection="locale"
            android:paddingStart="@dimen/size_10dp"
            android:paddingEnd="@dimen/size_10dp"
            android:layout_marginStart="@dimen/size_15dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/cl_ff4c4c4c"
            android:gravity="center"
            android:id="@+id/cancel"
            android:layout_width="wrap_content"
            android:layout_height="21dp"
            android:minWidth="30dp"
            android:text="@string/cancel"
            android:layoutDirection="locale"
            android:layout_marginStart="@dimen/size_12dp"
            android:layout_marginEnd="@dimen/size_15dp"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/area_result"
        android:background="@android:color/white"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/search_area">
        <TextView
            android:textSize="@dimen/size_12sp"
            android:textColor="@color/cl_33000000"
            android:layout_gravity="center"
            android:id="@+id/search_empty"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mi_no_matching_city"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.huami.worldclock.component.IndexBar
            android:layout_gravity="end|center_vertical"
            android:id="@+id/indexBar"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/size_16dp"
            android:minHeight="388dp"
            android:paddingStart="1dp"
            android:paddingEnd="1dp"
            app:indexBarTextSize="10sp"/>
        <TextView
            android:textSize="25sp"
            android:textColor="@android:color/white"
            android:gravity="start"
            android:layout_gravity="end|center_vertical"
            android:id="@+id/tvSideBarHint"
            android:background="@drawable/index_bra_hint"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-181dp"
            android:textDirection="locale"
            android:paddingStart="@dimen/size_13dp"
            android:layout_marginEnd="33dp"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
