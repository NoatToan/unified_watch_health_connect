<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bm_detail_tab_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_constraintTop_toTopOf="parent">
    <RadioGroup
        android:orientation="horizontal"
        android:id="@+id/tab_group"
        android:background="@drawable/bm_detail_tab_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/bm_detail_size_17dp"
        android:layout_marginStart="@dimen/bm_detail_size_15dp"
        android:layout_marginEnd="@dimen/bm_detail_size_15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <RadioButton
            android:id="@+id/tab_day"
            android:background="@drawable/bm_detail_tab_start_bg_selector"
            android:checked="true"
            android:text="@string/bm_detail_day"
            style="@style/bm_detail_Tab_Selector"/>
        <RadioButton
            android:id="@+id/tab_week"
            android:background="@drawable/bm_detail_tab_middle_bg_selector"
            android:text="@string/bm_detail_week"
            style="@style/bm_detail_Tab_Selector"/>
        <RadioButton
            android:id="@+id/tab_month"
            android:background="@drawable/bm_detail_tab_middle_bg_selector"
            android:text="@string/bm_detail_month"
            style="@style/bm_detail_Tab_Selector"/>
        <RadioButton
            android:id="@+id/tab_year"
            android:background="@drawable/bm_detail_tab_end_bg_selector"
            android:text="@string/bm_detail_year"
            style="@style/bm_detail_Tab_Selector"/>
    </RadioGroup>
</androidx.constraintlayout.widget.ConstraintLayout>
