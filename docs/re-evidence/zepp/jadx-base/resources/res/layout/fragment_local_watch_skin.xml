<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/watch_skin_list"
        android:background="@color/s10"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <FrameLayout
        android:background="@color/s38"
        android:layout_width="match_parent"
        android:layout_height="66dp">
        <View
            android:layout_gravity="top"
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider"/>
        <TextView
            android:textSize="9sp"
            android:textColor="@color/s2"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/edit_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/edit"
            android:drawableTop="@drawable/edit_alarm_selector"
            android:drawablePadding="3dp"/>
        <TextView
            android:textSize="9sp"
            android:textColor="@color/s2"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/done_btn"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/smart_alarm_done"
            android:drawableTop="@drawable/smart_alarm_done"
            android:drawablePadding="3dp"/>
    </FrameLayout>
</LinearLayout>
