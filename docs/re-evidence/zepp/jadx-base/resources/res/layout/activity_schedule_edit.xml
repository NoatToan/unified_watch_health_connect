<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/s4"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.watch.companion.ui.view.ActionbarLayout
        android:id="@+id/action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ScrollView
        android:background="@drawable/bg_white_round_corner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:layout_below="@+id/action_bar">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                style="@style/ScheduleEditItemStyle">
                <com.huami.watch.companion.ui.view.LiveEditText
                    android:textColorHint="#b2b2b2"
                    android:id="@+id/et_schedule_title"
                    android:layout_width="match_parent"
                    android:hint="@string/schedule_title"
                    android:maxLength="60"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    style="@style/ScheduleEditTextStyle"/>
            </FrameLayout>
            <FrameLayout style="@style/ScheduleEditItemStyle">
                <TextView
                    android:text="@string/all_day_event"
                    style="@style/ScheduleEditTextStyle"/>
                <Switch
                    android:layout_gravity="end|center_vertical"
                    android:id="@+id/reminder_all_day"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/WatchSwitch"/>
            </FrameLayout>
            <RelativeLayout
                android:onClick="onClickScheduleStartTime"
                style="@style/ScheduleEditItemStyle">
                <TextView
                    android:text="@string/start_time"
                    style="@style/ScheduleEditTextStyle"/>
                <TextView
                    android:id="@+id/tv_schedule_start"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@+id/schedule_start_arrow"
                    style="@style/ScheduleEditInfoStyle"/>
                <ImageView
                    android:id="@+id/schedule_start_arrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_arrow_forward_20_2x"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:onClick="onClickScheduleEndTime"
                style="@style/ScheduleEditItemStyle">
                <TextView
                    android:text="@string/end_time"
                    style="@style/ScheduleEditTextStyle"/>
                <TextView
                    android:id="@+id/tv_schedule_end"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@+id/schedule_end_arrow"
                    style="@style/ScheduleEditInfoStyle"/>
                <ImageView
                    android:id="@+id/schedule_end_arrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_arrow_forward_20_2x"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/view_reminder_repeat"
                android:onClick="onClickScheduleRepeat"
                style="@style/ScheduleEditItemStyle">
                <TextView
                    android:id="@+id/reminder_repeat_text"
                    android:text="@string/repeat"
                    style="@style/ScheduleEditTextStyle"/>
                <TextView
                    android:ellipsize="middle"
                    android:gravity="end"
                    android:id="@+id/tv_schedule_reminder_type"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="15dp"
                    android:layout_toStartOf="@+id/reminder_repeat_arrow"
                    android:layout_toEndOf="@+id/reminder_repeat_text"
                    style="@style/ScheduleEditInfoStyle"/>
                <ImageView
                    android:id="@+id/reminder_repeat_arrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_arrow_forward_20_2x"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/view_reminder_minute"
                android:onClick="onClickScheduleReminderMinutes"
                style="@style/ScheduleEditItemStyle">
                <TextView
                    android:id="@+id/reminder_remind_text"
                    android:text="@string/remind"
                    style="@style/ScheduleEditTextStyle"/>
                <TextView
                    android:ellipsize="end"
                    android:gravity="end"
                    android:id="@+id/tv_schedule_reminder_min"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="15dp"
                    android:layout_toStartOf="@+id/reminder_remind_arrow"
                    android:layout_toEndOf="@+id/reminder_remind_text"
                    style="@style/ScheduleEditInfoStyle"/>
                <ImageView
                    android:id="@+id/reminder_remind_arrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_arrow_forward_20_2x"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
            <FrameLayout
                android:paddingTop="21dp"
                android:paddingBottom="21dp"
                android:layout_height="wrap_content"
                android:minHeight="152dp"
                style="@style/ScheduleEditItemStyle">
                <com.huami.watch.companion.ui.view.LiveEditText
                    android:textColorHint="#b2b2b2"
                    android:layout_gravity="top"
                    android:id="@+id/reminder_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/desc"
                    android:maxLength="120"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    style="@style/ScheduleEditTextStyle"/>
            </FrameLayout>
        </LinearLayout>
    </ScrollView>
    <Button
        android:textSize="16sp"
        android:textColor="#ff5850"
        android:id="@+id/schedule_delete"
        android:background="@drawable/bg_white_round_corner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="15dp"
        android:text="@string/delete"
        android:layout_alignParentBottom="true"
        android:onClick="onClickScheduleDelete"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        style="?android:attr/borderlessButtonStyle"/>
</RelativeLayout>
