<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_view"
    android:background="@color/s36"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/title_bar_back"
        android:padding="@dimen/size_20dp"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_32dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <Button
            android:layout_gravity="start|center_vertical"
            android:id="@+id/back_button"
            android:background="@drawable/ic_arrow_back_20"
            android:layout_width="@dimen/size_20dp"
            android:layout_height="@dimen/size_20dp"
            android:scaleType="centerInside"
            android:backgroundTint="@color/s1"/>
    </FrameLayout>
    <com.huami.lib.view.image.HMCircleImageView
        android:id="@+id/iv_user_avatar"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:layout_marginTop="50dp"
        android:src="@drawable/setting_avatar_default"
        app:civ_border_color="@color/s3"
        app:civ_border_width="1.3dp"
        app:civ_fill_color="@color/s3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_bar_back"/>
    <TextView
        android:textColor="@color/s1"
        android:gravity="center"
        android:id="@+id/text_user_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="@+id/iv_user_avatar"
        app:layout_constraintStart_toStartOf="@+id/iv_user_avatar"
        app:layout_constraintTop_toBottomOf="@+id/iv_user_avatar"/>
    <TextView
        android:textColor="@color/s1"
        android:gravity="center"
        android:id="@+id/text_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:lineSpacingExtra="5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_user_name"/>
    <TextView
        android:textSize="50sp"
        android:textColor="@color/s1"
        android:id="@+id/text_num"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_tips"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/text_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        app:layout_constraintBaseline_toBaselineOf="@+id/text_num"
        app:layout_constraintStart_toEndOf="@+id/text_num"/>
    <FrameLayout
        android:id="@+id/layout_center"
        android:background="@drawable/midong_step_share_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/text_unit">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/s22"
            android:gravity="center"
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/btn_set_goal"
            android:background="@drawable/bg_round_rect_green"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:text="@string/text_set_new_goal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:background="@color/s10"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_center">
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/share_icon_cur_weight"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/s1"
                android:layout_gravity="center_horizontal"
                android:id="@+id/text_weight_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/s2"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/weight_params_pre"/>
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/share_icon_bmi"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/s1"
                android:layout_gravity="center_horizontal"
                android:id="@+id/text_bmi_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/s2"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/bmi"/>
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/share_icon_figure"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/s1"
                android:layout_gravity="center_horizontal"
                android:id="@+id/text_body_shape"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/s2"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/body_shape"/>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/share_container"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
