<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/device_setting_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:chainUseRtl="true">
    <com.huami.lib.rainbow.titlebar.RainbowTitleBar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:menuIcon="@drawable/ic_edit_20"
        app:navigationIcon="@drawable/ic_arrow_back_20_2x"
        style="@style/Rainbow.TextAppearance.Title3"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:elevation="0dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="60dp">
            <include
                android:id="@+id/device_status_wrapper"
                layout="@layout/fragment_device_setting_header"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/connect_state_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_open_normal_setting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="打开旧的设置页"/>
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_open_schedule"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="打开日程"/>
                    <androidx.appcompat.widget.AppCompatButton
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="日程实验室"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_disconnect_state"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="断连状态"/>
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_connecting_state"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="连接状态"/>
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_charging"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="充电状态"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_sync_state"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="同步状态"/>
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_sync_gps_state"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="同步A-GPS"/>
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_sync_gps_state_fail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="同步A-GPS失败"/>
                </LinearLayout>
            </LinearLayout>
            <FrameLayout
                android:background="@drawable/bg_device_setting_unit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10"
                android:layout_marginStart="@dimen/size_15dp"
                android:layout_marginEnd="@dimen/size_15dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/ll_par1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_6dp"
                    android:layout_marginBottom="@dimen/size_6dp">
                    <com.xiaomi.hm.health.device.setting.ui.DeviceSettingItemView
                        android:id="@+id/item_health_detect"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:title="@string/health_detect"/>
                    <com.xiaomi.hm.health.device.setting.ui.DeviceSettingItemView
                        android:id="@+id/item_notification_and_reminder"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:title="@string/push_and_alert"/>
                    <com.xiaomi.hm.health.device.setting.ui.DeviceSettingItemView
                        android:id="@+id/item_watch_skin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:title="@string/wf_home_tab_name_1"/>
                    <com.xiaomi.hm.health.device.setting.ui.DeviceSettingItemView
                        android:id="@+id/item_js_app_store"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:title="@string/setting_js_app_store"/>
                    <com.xiaomi.hm.health.device.setting.ui.DeviceSettingItemView
                        android:id="@+id/item_esim"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:title="@string/esim_card_manage"/>
                    <com.xiaomi.hm.health.device.setting.ui.DeviceSettingItemView
                        android:id="@+id/item_vibrate_mode"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:title="@string/custom_vibrate_mode"/>
                </LinearLayout>
                <View
                    android:id="@+id/mask_1"
                    android:background="@color/black03"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </FrameLayout>
            <FrameLayout
                android:background="@drawable/bg_device_setting_unit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_15dp"
                android:layout_marginStart="@dimen/size_15dp"
                android:layout_marginEnd="@dimen/size_15dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/ll_par2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_6dp"
                    android:layout_marginBottom="@dimen/size_6dp">
                    <com.xiaomi.hm.health.device.setting.ui.DeviceSettingItemView
                        android:id="@+id/item_watch_setting"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:radius_top_left="@dimen/size_6dp"
                        app:radius_top_right="@dimen/size_6dp"
                        app:title="@string/ds_watch_setting"/>
                    <com.xiaomi.hm.health.device.setting.ui.DeviceSettingItemView
                        android:id="@+id/item_device_app_manager"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:title="@string/app_list_manage"/>
                    <com.xiaomi.hm.health.device.setting.ui.DeviceSettingItemView
                        android:id="@+id/item_smart_assistant_setting"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:title="@string/as_quick_card_title"/>
                    <com.xiaomi.hm.health.device.setting.ui.DeviceSettingItemView
                        android:id="@+id/item_device_app_item_setting"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:showArrow="false"
                        app:title="@string/widget_setting"/>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_app_setting_items"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <View
                    android:id="@+id/mask_2"
                    android:background="@color/black03"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </FrameLayout>
            <FrameLayout
                android:background="@drawable/bg_device_setting_unit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_15dp"
                android:layout_marginStart="@dimen/size_15dp"
                android:layout_marginEnd="@dimen/size_15dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/ll_par3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_6dp"
                    android:layout_marginBottom="@dimen/size_6dp">
                    <com.xiaomi.hm.health.device.setting.ui.DeviceSettingItemView
                        android:id="@+id/item_find_device"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:title="@string/mili_setting_find_chaohu"/>
                    <com.xiaomi.hm.health.device.setting.ui.DeviceSettingItemView
                        android:id="@+id/item_bluetooth_broadcast"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:subtitle="@string/unused"
                        app:title="@string/identify_broadcast"/>
                    <com.xiaomi.hm.health.device.setting.ui.DeviceSettingItemView
                        android:id="@+id/item_bluetooth_sport_broadcast"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:subtitle="@string/unused"
                        app:title="@string/sport_heart_boradcast"/>
                    <com.xiaomi.hm.health.device.setting.ui.DeviceSettingItemView
                        android:id="@+id/item_realtime_data"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:title="@string/realtime_sync"/>
                    <com.xiaomi.hm.health.device.setting.ui.DeviceSettingItemView
                        android:id="@+id/item_spite_binding_item"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:subtitle="@string/unused"
                        app:title="@string/bind_limit"/>
                    <com.xiaomi.hm.health.device.setting.ui.DeviceSettingItemView
                        android:id="@+id/item_keep_alive"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:title="@string/keep_alive_permission"/>
                    <com.xiaomi.hm.health.device.setting.ui.DeviceSettingItemView
                        android:id="@+id/item_unlock_screen"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:title="@string/unlock_phone_screen"/>
                    <com.xiaomi.hm.health.device.setting.ui.DeviceSettingItemView
                        android:id="@+id/item_lab"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:title="@string/library"/>
                </LinearLayout>
                <View
                    android:id="@+id/mask_3"
                    android:background="@color/black03"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </FrameLayout>
            <FrameLayout
                android:background="@drawable/bg_device_setting_unit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_15dp"
                android:layout_marginStart="@dimen/size_15dp"
                android:layout_marginEnd="@dimen/size_15dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/ll_par4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_6dp"
                    android:layout_marginBottom="@dimen/size_6dp">
                    <com.xiaomi.hm.health.device.setting.ui.DeviceSettingItemView
                        android:id="@+id/item_check_update"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:title="@string/system_update"/>
                    <com.xiaomi.hm.health.device.setting.ui.DeviceSettingItemView
                        android:id="@+id/item_about"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:title="@string/about_device"/>
                    <com.xiaomi.hm.health.device.setting.ui.DeviceSettingItemView
                        android:id="@+id/item_faq"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:title="@string/setting_question"/>
                    <com.xiaomi.hm.health.device.setting.ui.DeviceSettingItemView
                        android:id="@+id/item_instruction"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:title="@string/product_description"/>
                    <com.xiaomi.hm.health.device.setting.ui.DeviceSettingItemView
                        android:id="@+id/item_js_app_developer_mode"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:title="@string/devicex_developer_mode"/>
                    <com.xiaomi.hm.health.device.setting.ui.DeviceSettingItemView
                        android:id="@+id/item_offline_voice_cmd"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:title="@string/offline_voice_cmd_new"/>
                </LinearLayout>
                <View
                    android:id="@+id/mask_4"
                    android:background="@color/black03"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </FrameLayout>
            <androidx.appcompat.widget.AppCompatButton
                android:textColor="@color/s1"
                android:id="@+id/btn_unbind"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="30dp"
                android:text="@string/mili_setting_unbind"
                android:layout_marginStart="@dimen/size_15dp"
                android:layout_marginEnd="@dimen/size_15dp"
                style="?attr/buttonStyleGray_48_flat"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
