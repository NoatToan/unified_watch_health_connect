<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="20sp"
        android:textColor="@color/s1"
        android:gravity="center"
        android:id="@+id/title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="98dp"
        android:text="@string/unbind"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/s2"
        android:gravity="center"
        android:id="@+id/sub_title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:layout_below="@+id/title_tv"
        android:layout_centerHorizontal="true"/>
    <RelativeLayout
        android:id="@+id/bolt_unbind_img"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="111dp"
        android:layout_below="@+id/title_tv"
        android:layout_centerHorizontal="true">
        <ImageView
            android:id="@+id/left_img"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:src="@drawable/img_phone"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/treadmill_unbind"
            android:layout_marginStart="55dp"
            android:layout_toEndOf="@+id/left_img"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="83dp"
            android:src="@drawable/img_unbind"
            android:layout_marginStart="85dp"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/unbind_container"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="112dp"
        android:layout_below="@+id/title_tv"
        android:layout_centerHorizontal="true">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/img_phone"
            android:alpha="0.5"
            android:layout_alignParentStart="true"/>
        <ImageView
            android:layout_gravity="end"
            android:id="@+id/un_bind_device_img"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/img_miband"
            android:layout_centerVertical="true"
            android:alpha="0.5"
            android:layout_alignParentEnd="true"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/img_unbind"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <include
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        layout="@layout/device_layout_bottom_common_btn"/>
</RelativeLayout>
