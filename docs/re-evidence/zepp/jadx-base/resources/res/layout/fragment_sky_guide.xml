<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/sky_guide_anim"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_guide_view_height"
        android:layout_marginTop="@dimen/size_guide_view_top_margin"
        app:layout_constraintTop_toTopOf="parent"
        app:lottie_loop="true"/>
    <TextView
        android:textSize="20sp"
        android:textColor="@color/s5"
        android:id="@+id/sky_guide_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_guide_view_title_top_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sky_guide_anim"/>
    <TextView
        android:textColor="@color/s5"
        android:gravity="center"
        android:id="@+id/sky_guide_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_guide_view_title_top_margin"
        android:lineSpacingExtra="@dimen/size_5dp"
        android:paddingStart="@dimen/size_20dp"
        android:paddingEnd="@dimen/size_20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sky_guide_title"/>
    <TextView
        android:textColor="@color/s5"
        android:gravity="center"
        android:id="@+id/sky_btn_welcome"
        android:background="@drawable/sky_rect_radius_6_s46_alpha8"
        android:layout_width="match_parent"
        android:layout_height="@dimen/sky_button_height"
        android:text="@string/sky_play_welcome"
        android:layout_marginStart="@dimen/size_20dp"
        android:layout_marginEnd="@dimen/size_20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
