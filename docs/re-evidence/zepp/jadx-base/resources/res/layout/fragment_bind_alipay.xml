<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/bind_alipay_img_container"
        android:background="@color/s15"
        android:layout_width="match_parent"
        android:layout_height="361dp">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:src="@drawable/third_party_access_alipay"
            android:contentDescription="@null"/>
    </LinearLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/s2"
        android:gravity="center"
        android:id="@+id/bind_alipay_tips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/bind_alipay_tips"
        android:layout_below="@+id/bind_alipay_img_container"/>
    <Button
        android:id="@+id/bind_alipay_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="13.3dp"
        android:layout_marginBottom="23.3dp"
        android:text="@string/bind_alipay_btn"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="26.7dp"
        android:layout_marginEnd="26.7dp"
        style="?attr/buttonStyleRed_44_outline"/>
</RelativeLayout>
