<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/more_card"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="136dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
    <RelativeLayout
        android:id="@+id/union_card_add_view"
        android:background="#ffffff"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:layout_alignParentBottom="true"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">
        <TextView
            android:id="@+id/union_card_add"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/wl_bank_open_up_now"
            android:layout_centerInParent="true"
            style="@style/UnionPayBlackBtn"/>
    </RelativeLayout>
    <include
        android:id="@+id/card_info"
        android:background="#ffffff"
        android:visibility="invisible"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/wl_watch_bank_card_info"/>
    <RelativeLayout
        android:paddingTop="14dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/union_card_add_view">
        <TextView
            android:textSize="12sp"
            android:textColor="#80000000"
            android:gravity="center_vertical"
            android:background="@drawable/wl_watch_bank_add_content_bg"
            android:padding="5dp"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:text="@string/wl_open_union_card_remark"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"/>
    </RelativeLayout>
    <include
        android:id="@+id/union_card_empty"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        layout="@layout/wl_watch_bank_card_empty"/>
    <include
        android:id="@+id/union_card_error"
        android:visibility="gone"
        layout="@layout/wl_watch_bank_loading_error"/>
</RelativeLayout>
