<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:item="http://schemas.android.com/apk/res-auto"
    android:background="@color/s38"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/stat_user_info_container"
        android:background="@color/s38"
        android:layout_width="match_parent"
        android:layout_height="84dp">
        <com.huami.lib.view.image.CircleImageView
            android:id="@+id/stat_view_avatar"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_marginTop="20dp"
            android:src="@drawable/setting_avatar_default"
            android:layout_marginStart="20dp"
            item:civ_border_color="@color/s3"
            item:civ_border_width="1.3dp"
            item:civ_fill_color="@color/s3"
            item:hm_civ_mask_color="@color/s2"
            item:hm_civ_show_mask="true"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/s1"
            android:ellipsize="end"
            android:id="@+id/stat_view_nickname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:singleLine="true"
            android:layout_marginStart="10dp"
            android:layout_toEndOf="@+id/stat_view_avatar"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/s3"
            android:ellipsize="end"
            android:id="@+id/stat_view_sport_des"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:singleLine="true"
            android:layout_below="@+id/stat_view_nickname"
            android:layout_alignStart="@+id/stat_view_nickname"/>
        <View
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="0.3dp"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            style="@style/exerciseHeaderCountDividerStyle"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/stat_sport_count_container"
        android:background="@color/s38"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="13sp"
            android:textColor="@color/s1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/exercise_history_stat_sport_count_des"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/stat_sport_count_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"/>
    </LinearLayout>
    <include
        android:id="@+id/stat_share_end"
        layout="@layout/exercise_stat_share_end"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/s38"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/s2"
            android:id="@+id/tv_date_range"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_marginStart="20dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/stat_data_layout"
            android:background="@color/s38"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/iv_running_stat_bg"
                    android:layout_width="230dp"
                    android:layout_height="100dp"
                    android:layout_marginTop="15dp"
                    android:src="@drawable/bg_sport_his_stat_all_sport"
                    android:layout_alignParentEnd="true"/>
                <com.huami.widget.typeface.TypefaceTextView
                    android:textColor="@color/s1"
                    android:id="@+id/stat_main_data"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    style="@style/statMainDataStyle"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/s3"
                    android:gravity="bottom"
                    android:id="@+id/stat_main_data_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/unit_min_long"
                    android:layout_below="@+id/stat_main_data"
                    android:layout_alignStart="@+id/stat_main_data"/>
            </RelativeLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <com.huami.widget.typeface.TypefaceTextView
                        android:textSize="21sp"
                        android:textColor="@color/s1"
                        android:id="@+id/stat_sub_data_first"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="ow"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/s3"
                        android:gravity="bottom"
                        android:id="@+id/stat_sub_data_first_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <com.huami.widget.typeface.TypefaceTextView
                        android:textSize="21sp"
                        android:textColor="@color/s1"
                        android:id="@+id/stat_sub_data_second"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="ow"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/s3"
                        android:gravity="bottom"
                        android:id="@+id/stat_sub_data_second_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="end"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <com.huami.widget.typeface.TypefaceTextView
                        android:textSize="21sp"
                        android:textColor="@color/s1"
                        android:id="@+id/stat_sub_data_third"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="ow"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/exercise_header_unit_color"
                        android:gravity="bottom"
                        android:id="@+id/stat_sub_data_third_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <Space
            android:id="@+id/exec_chart_space"
            android:background="@color/s38"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="30dp"/>
        <FrameLayout
            android:id="@+id/chart_area"
            android:background="@color/s38"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="45dp"
            android:layout_marginBottom="@dimen/chart_area"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"/>
        <View
            android:id="@+id/divider_bottom"
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            style="@style/exerciseHeaderCountDividerStyle"/>
    </LinearLayout>
</FrameLayout>
