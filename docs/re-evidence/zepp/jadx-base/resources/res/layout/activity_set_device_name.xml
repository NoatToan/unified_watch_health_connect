<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.huami.watch.companion.ui.view.ActionbarLayout
            android:id="@+id/actionbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <ImageView
            android:id="@+id/image_commit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_topbar_commit"
            android:layout_centerVertical="true"
            android:layout_marginEnd="16dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:paddingStart="23dp"
        android:paddingEnd="16dp">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/dark_grey_text"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/userinfo_nickname"/>
        <com.huami.watch.companion.ui.view.ClearableEditText
            android:textSize="14sp"
            android:textColor="@color/black_text"
            android:textColorHint="@color/grey_text"
            android:gravity="start|center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/nickname_edit_box"
            android:background="@color/white"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:hint="@string/plz_input_nickname"
            android:layout_weight="1"
            android:textCursorDrawable="@drawable/cursor_edit_box"
            android:layout_marginStart="34dp"/>
    </LinearLayout>
    <include layout="@layout/split_line_width_match_parent"/>
</LinearLayout>
