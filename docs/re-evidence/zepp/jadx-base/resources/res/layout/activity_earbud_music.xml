<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.sothree.slidinguppanel.SlidingUpPanelLayout
        android:gravity="bottom"
        android:id="@+id/sliding_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:umanoDragView="@+id/music_tab"
        app:umanoFadeColor="@android:color/transparent"
        app:umanoInitialState="collapsed"
        app:umanoOverlay="true"
        app:umanoPanelHeight="80dp"
        app:umanoShadowHeight="0dp">
        <FrameLayout
            android:id="@+id/mode_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.constraintlayout.widget.Placeholder
                android:id="@+id/space_view"
                android:layout_width="match_parent"
                android:layout_height="80dp"/>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="-12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardMaxElevation="4dp">
                <com.xiaomi.hm.health.device.earbud.view.ViewEarbudMusicTab
                    android:id="@+id/music_tab"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    app:isArrowUp="true"/>
                <androidx.viewpager.widget.ViewPager
                    android:id="@+id/music_pager"
                    android:background="@drawable/bg_earbud_music"
                    android:paddingBottom="20dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="80dp"
                    android:onClick="disableDelete"/>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </com.sothree.slidinguppanel.SlidingUpPanelLayout>
    <FrameLayout
        android:id="@+id/device_not_connect_content"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</RelativeLayout>
