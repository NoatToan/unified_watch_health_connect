<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:baseui="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/account_ui_bg_2022"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/s2"
                    android:id="@+id/new_user_skip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/user_info_new_user_skip_margin_top"
                    android:text="@string/user_info_homepage_rom_update_skip"
                    android:layout_marginStart="@dimen/user_info_new_user_margin_start_end"
                    android:layout_marginEnd="@dimen/account_ui_size_16dp"
                    android:layout_alignParentEnd="true"/>
                <TextView
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/s1"
                    android:id="@+id/new_user_info_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/user_info_new_user_info_margin_top"
                    android:text="@string/user_info_new_user_title"
                    android:layout_marginStart="@dimen/user_info_new_user_margin_start_end"
                    android:layout_marginEnd="@dimen/user_info_new_user_margin_start_end"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/s1"
                    android:id="@+id/new_user_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/user_info_new_user_tip_margin_top"
                    android:layout_marginBottom="@dimen/account_ui_dp_40"
                    android:text="@string/user_info_new_user_info_tip"
                    android:layout_marginStart="@dimen/user_info_new_user_margin_start_end"
                    android:layout_marginEnd="@dimen/user_info_new_user_margin_start_end"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_below="@+id/new_user_info"/>
            </RelativeLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/setting_name"
                    android:background="@color/user_info_trans"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/user_info_new_user_item_margin"
                    android:paddingEnd="@dimen/user_info_new_user_item_margin"
                    baseui:ltv_divider_color="@color/s3"
                    baseui:ltv_divider_padding="all"
                    baseui:ltv_tips="@string/user_info_new_user_item_input_default"
                    baseui:ltv_title="@string/user_info_name"
                    baseui:ltv_trailing="@drawable/ic_arrow_forward_20_2x"/>
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/setting_gender"
                    android:background="@color/user_info_trans"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/user_info_new_user_item_margin"
                    android:paddingEnd="@dimen/user_info_new_user_item_margin"
                    baseui:ltv_divider_color="@color/s3"
                    baseui:ltv_divider_padding="all"
                    baseui:ltv_tips="@string/user_info_new_user_item_choose_default"
                    baseui:ltv_title="@string/user_info_your_gender"
                    baseui:ltv_trailing="@drawable/ic_arrow_forward_20_2x"/>
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/setting_birthday"
                    android:background="@color/user_info_trans"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/user_info_new_user_item_margin"
                    android:paddingEnd="@dimen/user_info_new_user_item_margin"
                    baseui:ltv_divider_color="@color/s3"
                    baseui:ltv_divider_padding="all"
                    baseui:ltv_tips="@string/user_info_new_user_item_choose_default"
                    baseui:ltv_title="@string/user_info_please_input_birthday"
                    baseui:ltv_trailing="@drawable/ic_arrow_forward_20_2x"/>
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/setting_height"
                    android:background="@color/user_info_trans"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/user_info_new_user_item_margin"
                    android:paddingEnd="@dimen/user_info_new_user_item_margin"
                    baseui:ltv_divider_color="@color/s3"
                    baseui:ltv_divider_padding="all"
                    baseui:ltv_tips="@string/user_info_new_user_item_choose_default"
                    baseui:ltv_title="@string/user_info_your_height"
                    baseui:ltv_trailing="@drawable/ic_arrow_forward_20_2x"/>
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/setting_weight"
                    android:background="@color/user_info_trans"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/user_info_new_user_item_margin"
                    android:paddingEnd="@dimen/user_info_new_user_item_margin"
                    baseui:ltv_divider_color="@color/s3"
                    baseui:ltv_divider_padding="all"
                    baseui:ltv_tips="@string/user_info_new_user_item_choose_default"
                    baseui:ltv_title="@string/user_info_your_weight"
                    baseui:ltv_trailing="@drawable/ic_arrow_forward_20_2x"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <TextView
        android:textColor="@color/account_ui_select_alive_btn_txt_color"
        android:gravity="center"
        android:layout_gravity="bottom"
        android:id="@+id/new_user_next"
        android:background="@drawable/account_ui_btn_bg_login"
        android:layout_width="match_parent"
        android:layout_height="@dimen/user_info_click_button_h"
        android:layout_marginBottom="@dimen/user_info_new_user_margin_top_bottom"
        android:text="@string/user_info_new_user_done"
        android:layout_marginStart="@dimen/user_info_new_user_margin_start_end"
        android:layout_marginEnd="@dimen/user_info_new_user_margin_start_end"/>
</LinearLayout>
