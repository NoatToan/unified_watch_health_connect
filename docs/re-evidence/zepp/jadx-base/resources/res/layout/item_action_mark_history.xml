<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/ll_lab"
    android:background="@color/s38"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include
        android:id="@+id/item_top_line"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginTop="1px"
        android:layout_marginStart="23dp"
        android:layout_marginEnd="23dp"
        layout="@layout/divider_horizontal"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="18dp"
            android:paddingBottom="18dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/s1"
                    android:ellipsize="end"
                    android:id="@+id/tx_action_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/s1"
                    android:ellipsize="end"
                    android:id="@+id/tx_customize_behavior_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"/>
            </LinearLayout>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/s2"
                android:ellipsize="end"
                android:gravity="start"
                android:id="@+id/tx_mark_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2.7dp"
                android:maxLines="1"/>
        </LinearLayout>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/imv_upload"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/btn_upload_mark_his"
            android:scaleType="centerInside"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"/>
    </LinearLayout>
    <include
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginBottom="1px"
        android:layout_marginStart="23dp"
        android:layout_marginEnd="23dp"
        layout="@layout/divider_horizontal"/>
</LinearLayout>
