<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/user_info_trans"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/dialog_empty_area"/>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/user_info_dialog_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:layout_gravity="center"
            android:id="@+id/updateTv"
            android:layout_width="wrap_content"
            android:layout_height="58dp"
            android:text="@string/user_info_modify_nickname"
            style="@style/DialogTitleStyle"/>
        <EditText
            android:textSize="@dimen/user_info_person_info_nickname_text_size"
            android:textColor="@color/s1"
            android:textColorHint="@color/s3"
            android:layout_gravity="center_vertical"
            android:id="@+id/info_nick_name"
            android:background="@drawable/bg_dialog_edittext"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="@dimen/user_info_person_info_nickname_height"
            android:layout_marginTop="@dimen/user_info_person_info_nickname_margin_top"
            android:layout_marginBottom="@dimen/user_info_person_info_nickname_margin_bottom"
            android:hint="@string/user_info_add_family_nickname_hint"
            android:maxLines="1"
            android:maxLength="20"
            android:inputType="text"
            android:paddingStart="@dimen/user_info_person_info_nickname_padding"
            android:paddingEnd="@dimen/user_info_person_info_nickname_padding"
            android:layout_marginStart="@dimen/user_info_person_info_nickname_margin_start_end"
            android:layout_marginEnd="@dimen/user_info_person_info_nickname_margin_start_end"/>
        <View
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <LinearLayout
            android:orientation="horizontal"
            android:background="@color/user_info_trans"
            android:layout_width="match_parent"
            android:layout_height="@dimen/user_info_item_height_max">
            <TextView
                android:textSize="@dimen/user_info_person_info_setting_text_size"
                android:textColor="@color/s2"
                android:gravity="center"
                android:id="@+id/nick_name_btn_cancel"
                android:background="@drawable/selector_dialog_button_start"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/cancel"
                android:layout_weight="1"
                style="@style/DialogButtonStyle"/>
            <TextView
                android:textSize="@dimen/user_info_person_info_setting_text_size"
                android:textColor="@color/s1"
                android:gravity="center"
                android:id="@+id/nick_name_btn_save"
                android:background="@drawable/selector_dialog_button_end"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/save"
                android:layout_weight="1"
                style="@style/DialogButtonStyle"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
