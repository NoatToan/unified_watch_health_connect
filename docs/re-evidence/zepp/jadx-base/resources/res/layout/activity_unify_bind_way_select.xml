<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.lib.rainbow.titlebar.RainbowTitleBar
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/choose_watch_type"/>
    <androidx.cardview.widget.CardView
        android:id="@+id/cardBindByQr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/size_15dp"
        android:layout_marginTop="@dimen/size_15dp"
        android:layout_marginRight="@dimen/size_15dp"
        app:cardBackgroundColor="@color/s38"
        app:cardCornerRadius="6dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@+id/titleBar">
        <ImageView
            android:id="@+id/has_qr_code_img"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="23dp"
            android:layout_marginBottom="@dimen/size_22dp"
            android:src="@drawable/img_bind_with_qr"
            android:layout_marginStart="68dp"/>
        <TextView
            android:textSize="@dimen/size_15sp"
            android:textColor="@color/s1"
            android:layout_gravity="center_vertical"
            android:id="@+id/qr_code"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/watch_with_qr"
            android:layout_marginStart="158dp"
            android:layout_marginEnd="20dp"/>
    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView
        android:id="@+id/cardBindByBlueTooth"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/size_15dp"
        android:layout_marginTop="@dimen/size_15dp"
        android:layout_marginRight="@dimen/size_15dp"
        app:cardBackgroundColor="@color/s38"
        app:cardCornerRadius="6dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@+id/cardBindByQr">
        <ImageView
            android:id="@+id/no_qr_code_img"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="23dp"
            android:layout_marginBottom="@dimen/size_22dp"
            android:src="@drawable/img_bind_no_qr"
            android:layout_marginStart="68dp"/>
        <TextView
            android:textSize="@dimen/size_15sp"
            android:textColor="@color/s1"
            android:layout_gravity="center_vertical"
            android:id="@+id/no_qr_code"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/watch_without_qr"
            android:layout_marginStart="158dp"
            android:layout_marginEnd="20dp"/>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
