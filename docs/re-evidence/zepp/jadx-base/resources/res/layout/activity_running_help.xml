<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/helpContainer"
    android:background="@color/running_primary_color"
    android:scrollbars="none"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:paddingBottom="16.7dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="13.3sp"
            android:textColor="@color/white70"
            android:gravity="center"
            android:id="@+id/paceTitle"
            android:background="@color/white06"
            android:layout_width="match_parent"
            android:layout_height="53.3dp"
            android:layout_marginTop="16.7dp"
            android:text="@string/running_pace"/>
        <ViewStub
            android:id="@+id/paceDetail"
            android:layout="@layout/layout_help_pace_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="13.3dp"
            android:layout_marginStart="34dp"
            android:layout_marginEnd="34dp"/>
        <TextView
            android:textSize="13.3sp"
            android:textColor="@color/white70"
            android:gravity="center"
            android:id="@+id/heartRateTitle"
            android:background="@color/white06"
            android:layout_width="match_parent"
            android:layout_height="53.3dp"
            android:layout_marginTop="16.7dp"
            android:text="@string/running_hr"/>
        <ViewStub
            android:id="@+id/heartRateDetail"
            android:layout="@layout/layout_help_heart_rate_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="13.3dp"
            android:layout_marginStart="34dp"
            android:layout_marginEnd="34dp"/>
        <TextView
            android:textSize="13.3sp"
            android:textColor="@color/white70"
            android:gravity="center"
            android:id="@+id/strideFreqTitle"
            android:background="@color/white06"
            android:layout_width="match_parent"
            android:layout_height="53.3dp"
            android:layout_marginTop="16.7dp"
            android:text="@string/running_help_pace_freq"/>
        <ViewStub
            android:id="@+id/strideFreqDetail"
            android:layout="@layout/layout_help_stride_freq_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="13.3dp"
            android:layout_marginStart="34dp"
            android:layout_marginEnd="34dp"/>
        <TextView
            android:textSize="13.3sp"
            android:textColor="@color/white70"
            android:gravity="center"
            android:id="@+id/strideTitle"
            android:background="@color/white06"
            android:layout_width="match_parent"
            android:layout_height="53.3dp"
            android:layout_marginTop="16.7dp"
            android:text="@string/running_stride"/>
        <ViewStub
            android:id="@+id/strideDetail"
            android:layout="@layout/layout_help_stride_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="13.3dp"
            android:layout_marginStart="34dp"
            android:layout_marginEnd="34dp"/>
        <TextView
            android:textSize="13.3sp"
            android:textColor="@color/white70"
            android:gravity="center"
            android:id="@+id/upHillTitle"
            android:background="@color/white06"
            android:layout_width="match_parent"
            android:layout_height="53.3dp"
            android:layout_marginTop="16.7dp"
            android:text="@string/sport_help_cycling_up_hill"/>
        <ViewStub
            android:id="@+id/upHillDetail"
            android:layout="@layout/layout_help_cycling_up_hill_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="13.3dp"
            android:layout_marginStart="34dp"
            android:layout_marginEnd="34dp"/>
        <TextView
            android:textSize="13.3sp"
            android:textColor="@color/white70"
            android:gravity="center"
            android:id="@+id/forefeetTitle"
            android:background="@color/white06"
            android:layout_width="match_parent"
            android:layout_height="53.3dp"
            android:layout_marginTop="16.7dp"
            android:text="@string/running_help_pre_foot"/>
        <ViewStub
            android:id="@+id/forefeetDetail"
            android:layout="@layout/layout_help_forefeet_landing_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="13.3dp"
            android:layout_marginStart="34dp"
            android:layout_marginEnd="34dp"/>
        <TextView
            android:textSize="13.3sp"
            android:textColor="@color/white70"
            android:gravity="center"
            android:id="@+id/touchDownTitle"
            android:background="@color/white06"
            android:layout_width="match_parent"
            android:layout_height="53.3dp"
            android:layout_marginTop="16.7dp"
            android:text="@string/running_help_touch_down"/>
        <ViewStub
            android:id="@+id/touchDownDetail"
            android:layout="@layout/layout_help_touchdown_time_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="34dp"
            android:layout_marginTop="30dp"
            android:layout_marginRight="34dp"
            android:layout_marginBottom="13.3dp"/>
        <TextView
            android:textSize="13.3sp"
            android:textColor="@color/white70"
            android:gravity="center"
            android:id="@+id/flightRatioTitle"
            android:background="@color/white06"
            android:layout_width="match_parent"
            android:layout_height="53.3dp"
            android:layout_marginTop="16.7dp"
            android:text="@string/running_help_jump_ratio"/>
        <ViewStub
            android:id="@+id/flightRatioDetail"
            android:layout="@layout/layout_help_flight_ratio_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="34dp"
            android:layout_marginTop="30dp"
            android:layout_marginRight="34dp"
            android:layout_marginBottom="13.3dp"/>
    </LinearLayout>
</ScrollView>
