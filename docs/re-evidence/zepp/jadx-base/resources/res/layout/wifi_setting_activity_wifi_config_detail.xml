<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="15sp"
        android:textColor="@color/s1"
        android:gravity="center_vertical"
        android:id="@+id/tv_wifi_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:minHeight="62dp"
        android:text="HSWM"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="wrap_content"
        android:layout_height="62dp"
        android:src="@mipmap/wifi_setting_icon_wifi"
        android:layout_alignTop="@+id/tv_wifi_name"
        android:layout_alignParentEnd="true"/>
    <View
        android:background="@color/s5"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@+id/tv_wifi_name"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="15sp"
        android:textColor="@color/s1"
        android:gravity="center_vertical"
        android:id="@+id/tv_wifi_ip_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="62dp"
        android:text="IPV 4"
        android:layout_below="@+id/tv_wifi_name"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="15sp"
        android:textColor="@color/s2"
        android:gravity="center_vertical"
        android:id="@+id/tv_wifi_ip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="62dp"
        android:text="10.28.7.33"
        android:layout_alignTop="@+id/tv_wifi_ip_title"
        android:layout_alignParentEnd="true"/>
    <View
        android:background="@color/s5"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@+id/tv_wifi_ip_title"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="15sp"
        android:textColor="@color/s1"
        android:gravity="center_vertical"
        android:id="@+id/tv_wifi_mac_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="62dp"
        android:text="Mac地址"
        android:layout_below="@+id/tv_wifi_ip_title"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="15sp"
        android:textColor="@color/s2"
        android:gravity="center_vertical"
        android:id="@+id/tv_wifi_mac"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="62dp"
        android:text="18:00:DB:9D:3E:2C"
        android:layout_alignTop="@+id/tv_wifi_mac_title"
        android:layout_alignParentEnd="true"/>
    <View
        android:background="@color/s5"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@+id/tv_wifi_mac_title"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="62dp"
        android:layout_alignParentBottom="true">
        <androidx.appcompat.widget.AppCompatTextView
            android:gravity="center"
            android:id="@+id/tv_remove"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/wifi_remove"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            style="?attr/buttonStyleGray_48_flat"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:gravity="center"
            android:id="@+id/tv_reset"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/wifi_reset"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            style="?attr/buttonStyleRed_48_flat"/>
    </LinearLayout>
</RelativeLayout>
