<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:background="@color/s38"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_warning_error"
        android:layout_marginStart="19dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/s38"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:layout_weight="1"
        android:layout_marginStart="11dp">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/s1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_notify_access_title"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/s2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_sort_music_notification_permission_tip"/>
    </LinearLayout>
    <View
        android:layout_gravity="center_vertical"
        android:background="@color/divide"
        android:layout_width="@dimen/divider"
        android:layout_height="32dp"
        android:layout_marginEnd="20dp"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/warn_set"
        android:tint="@color/s2"
        android:layout_marginEnd="21dp"/>
</LinearLayout>
