<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/dialog_empty_area"/>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/user_info_dialog_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="@dimen/user_info_person_info_setting_title_height"
            android:text="@string/user_info_modify_gender"
            style="@style/DialogTitleStyle"/>
        <View
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider"/>
        <LinearLayout
            android:id="@+id/person_info_male_area"
            android:background="@color/s39"
            android:layout_width="match_parent"
            android:layout_height="@dimen/user_info_item_height_small">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/info_gender_male"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_all_done_20_2x"
                android:layout_marginStart="@dimen/dialog_choice_arrow_start_margin"
                android:layout_marginEnd="@dimen/user_info_person_info_gender_arrow_margin"
                app:tint="@color/p4"/>
            <TextView
                android:textSize="@dimen/user_info_mili_normal_txt_size"
                android:textColor="@color/s1"
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:id="@+id/info_gender_male_txt"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/user_info_male"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/person_info_female_area"
            android:background="@color/s39"
            android:layout_width="match_parent"
            android:layout_height="@dimen/user_info_item_height_small">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/info_gender_female"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_all_done_20_2x"
                android:layout_marginStart="@dimen/dialog_choice_arrow_start_margin"
                android:layout_marginEnd="@dimen/user_info_person_info_gender_arrow_margin"
                app:tint="@color/p4"/>
            <TextView
                android:textSize="@dimen/user_info_mili_normal_txt_size"
                android:textColor="@color/s1"
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:id="@+id/info_gender_female_txt"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/user_info_female"/>
        </LinearLayout>
        <View
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <TextView
            android:textSize="@dimen/user_info_person_info_setting_text_size"
            android:textColor="@color/s2"
            android:gravity="center"
            android:id="@+id/setting_gender_cancel"
            android:background="@drawable/selector_dialog_button_start"
            android:layout_width="match_parent"
            android:layout_height="@dimen/user_info_item_height_max"
            android:text="@string/cancel"
            style="@style/DialogButtonStyle"/>
    </LinearLayout>
</LinearLayout>
