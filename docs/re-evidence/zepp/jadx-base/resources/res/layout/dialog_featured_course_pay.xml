<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="13sp"
                android:textColor="@color/color_999999"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/tr_purchase_confirm"
                android:maxLines="2"
                android:layout_weight="3"
                android:paddingStart="20dp"/>
            <TextView
                android:id="@+id/iv_close"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:scaleType="center"
                android:layout_weight="1"
                android:drawableEnd="@drawable/icon_common_close"
                android:paddingEnd="20dp"/>
        </LinearLayout>
        <View style="@style/TrainingHorizontalDivider"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:paddingTop="20dp"
            android:paddingBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">
            <TextView
                android:textSize="13sp"
                android:textColor="@color/color_333333"
                android:ellipsize="end"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/tr_purchase_content"
                android:maxLines="2"
                android:layout_weight="1"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/color_999999"
                android:ellipsize="end"
                android:gravity="end"
                android:id="@+id/tv_purchase_content"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="3"
                android:layout_weight="2"
                android:layout_marginStart="@dimen/activity_horizontal_margin"/>
        </LinearLayout>
        <View
            android:layout_marginStart="13dp"
            android:layout_marginEnd="13dp"
            style="@style/TrainingHorizontalDivider"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:paddingTop="20dp"
            android:paddingBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">
            <TextView
                android:textSize="13sp"
                android:textColor="@color/color_333333"
                android:ellipsize="end"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/tr_pay_amount"
                android:maxLines="2"
                android:layout_weight="1"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="19sp"
                android:textColor="@color/color_ff8810"
                android:ellipsize="end"
                android:gravity="end"
                android:id="@+id/tv_pay_amount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_weight="2"
                android:layout_marginStart="@dimen/activity_horizontal_margin"/>
        </LinearLayout>
        <View
            android:background="@color/color_eeeff0"
            android:layout_width="match_parent"
            android:layout_height="10dp"/>
        <RelativeLayout
            android:id="@+id/layout_wx"
            android:paddingTop="20dp"
            android:paddingBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">
            <ImageView
                android:id="@+id/icon_wx"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_wx"/>
            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_toStartOf="@+id/cb_wx"
                android:layout_toEndOf="@+id/icon_wx">
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/color_333333"
                    android:ellipsize="end"
                    android:id="@+id/tv_wx"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="150dp"
                    android:text="@string/tr_pay_weixin"
                    android:maxLines="2"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/color_999999"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/tr_pay_weixin_recommend"
                    android:layout_below="@+id/tv_wx"/>
                <TextView
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/tv_recommend"
                    android:background="@drawable/ic_recommend_bg"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:text="@string/tr_recommend"
                    android:maxLines="1"
                    android:layout_marginStart="10dp"
                    android:layout_toEndOf="@+id/tv_wx"/>
            </RelativeLayout>
            <CheckBox
                android:id="@+id/cb_wx"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:button="@drawable/selector_cb"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <View
            android:layout_marginStart="13dp"
            android:layout_marginEnd="13dp"
            style="@style/TrainingHorizontalDivider"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@+id/layout_zfb"
            android:paddingTop="20dp"
            android:paddingBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">
            <TextView
                android:textSize="13sp"
                android:textColor="@color/color_333333"
                android:id="@+id/tv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/tr_pay_zhifubao"
                android:drawablePadding="8dp"
                android:layout_weight="1"
                android:drawableStart="@drawable/ic_zfb"
                android:layout_marginEnd="8dp"/>
            <CheckBox
                android:id="@+id/cb_zfb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:button="@drawable/selector_cb"/>
        </LinearLayout>
        <Button
            android:textColor="@color/white"
            android:id="@+id/btn_confirm"
            android:background="@drawable/btn_bg_corner_origin"
            android:layout_width="match_parent"
            android:layout_height="47dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="7dp"
            android:text="@string/tr_confirm"
            android:layout_marginStart="13dp"
            android:layout_marginEnd="13dp"
            style="?android:attr/borderlessButtonStyle"/>
    </LinearLayout>
</LinearLayout>
