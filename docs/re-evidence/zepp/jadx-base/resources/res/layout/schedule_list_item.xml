<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="10dp"
    android:layout_marginEnd="10dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@android:color/white"
        android:paddingTop="7.5dp"
        android:paddingBottom="7.5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="0dp"
        android:paddingEnd="19dp">
        <View
            android:background="@drawable/bg_red_round_corner_schedule_indicator"
            android:layout_width="2dp"
            android:layout_height="0dp"
            android:layout_marginStart="15dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.huami.assistant.ui.widget.ExpandTextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#191919"
            android:ellipsize="end"
            android:id="@+id/card_reminder_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="6sp"
            android:layout_marginStart="28dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#b2b2b2"
            android:id="@+id/card_item_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/card_reminder_title"
            app:layout_constraintTop_toBottomOf="@+id/card_reminder_title"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/card_reminder_desc_content"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/card_reminder_title"
            app:layout_constraintTop_toBottomOf="@+id/card_item_time">
            <com.huami.assistant.ui.widget.ExpandTextView
                android:textSize="14sp"
                android:textColor="#666666"
                android:ellipsize="end"
                android:id="@+id/card_reminder_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="6sp"/>
        </LinearLayout>
        <include
            android:visibility="gone"
            layout="@layout/card_item_title"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <include layout="@layout/schedule_list_item_divider"/>
</LinearLayout>
