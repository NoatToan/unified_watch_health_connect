<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="185dp">
    <com.huami.module.homepage.cards.cardui.CardTitleBarView
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:secondTitleText="@string/homepage_item_card_spo2"
        app:timeWarpRules="language"
        app:titleText="@string/homepage_item_card_pressure"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/pressure_scale_iv"
        android:layout_width="47dp"
        android:layout_height="125dp"
        android:layout_marginEnd="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/middle_line"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.7"
        app:srcCompat="@drawable/ic_card_stress"/>
    <com.huami.module.homepage.cards.business.stressAndspo2.RoundLottieAnimationView
        android:id="@+id/spo2_lottie"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/middle_line"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1"
        app:lottie_repeatCount="-1"/>
    <com.huami.module.homepage.cards.cardui.BackgroundTextView
        android:id="@+id/pressure_mask"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:backgroundTintAlpha="0.92"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/pressure_scale_iv"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_bar"/>
    <com.huami.module.homepage.cards.cardui.BackgroundTextView
        android:id="@+id/spo2_mask"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:backgroundTintAlpha="0.92"
        app:cornerDirection="right"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/middle_line"
        app:layout_constraintTop_toBottomOf="@+id/title_bar"/>
    <View
        android:id="@+id/middle_line"
        android:background="@color/s4"
        android:layout_width="0.5dp"
        android:layout_height="161dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/pressure_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/middle_line"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Rainbow.TextAppearance.Number2"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/pressure_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/pressure_value"
        app:layout_constraintStart_toStartOf="@+id/pressure_value"
        app:layout_constraintTop_toBottomOf="@+id/pressure_value"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <TextView
        android:textColor="@color/s1"
        android:gravity="center"
        android:id="@+id/no_pressure_tip"
        android:paddingLeft="15dp"
        android:paddingRight="15dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/homepage_item_card_no_pressure_tip"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/middle_line"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/spo2_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/middle_line"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Rainbow.TextAppearance.Number2"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/spo2_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/spo2_value"
        app:layout_constraintStart_toStartOf="@+id/spo2_value"
        app:layout_constraintTop_toBottomOf="@+id/spo2_value"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <TextView
        android:textColor="@color/s1"
        android:gravity="center"
        android:id="@+id/no_spo2_tip"
        android:paddingLeft="15dp"
        android:paddingRight="15dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/homepage_item_card_no_spo2_tip"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/middle_line"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Rainbow.TextAppearance.Body4"/>
</androidx.constraintlayout.widget.ConstraintLayout>
