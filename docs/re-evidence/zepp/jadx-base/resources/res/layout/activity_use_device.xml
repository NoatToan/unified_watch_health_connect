<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/s36"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="20sp"
        android:textColor="@color/s1"
        android:gravity="center"
        android:id="@+id/title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="78dp"
        android:text="@string/use_now"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/s2"
        android:gravity="center"
        android:id="@+id/sub_title_tv"
        android:layout_width="258dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:text="@string/use_now_tips_band_watch"
        android:layout_below="@+id/title_tv"
        android:layout_centerHorizontal="true"/>
    <ImageView
        android:id="@+id/device_img"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="142dp"
        android:src="@drawable/img_midong_watch_lite"
        android:layout_below="@+id/title_tv"
        android:layout_centerHorizontal="true"/>
    <View
        android:id="@+id/center_view"
        android:layout_width="1px"
        android:layout_height="1px"
        android:layout_centerInParent="true"/>
    <ImageView
        android:id="@+id/new_device_img"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="138dp"
        android:src="@drawable/img_new_device"
        android:layout_below="@+id/title_tv"
        android:layout_marginStart="10dp"
        android:layout_toEndOf="@+id/center_view"/>
    <include
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        layout="@layout/device_layout_bottom_common_btn"/>
</RelativeLayout>
