<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/s36"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:background="@drawable/mine_head_bg_user"
        android:layout_width="match_parent"
        android:layout_height="210dp">
        <RelativeLayout
            android:id="@+id/person_info_avatar_rl"
            android:layout_width="@dimen/person_avatar_size"
            android:layout_height="@dimen/person_avatar_size"
            android:layout_marginTop="76dp"
            android:layout_centerHorizontal="true">
            <com.huami.lib.view.image.CircleImageView
                android:id="@+id/person_info_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/setting_avatar_default"
                app:civ_border_color="@color/s10"
                app:civ_border_width="1.3dp"
                app:civ_fill_color="@color/s36"
                app:hm_civ_show_mask="true"/>
            <ImageView
                android:layout_width="@dimen/person_info_camera"
                android:layout_height="@dimen/person_info_camera"
                android:src="@drawable/setting_camera"
                android:layout_alignParentBottom="true"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </RelativeLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/s2"
        android:paddingTop="14dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/bf3_family_info_title"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"/>
    <View
        android:background="@color/s4"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginStart="@dimen/person_info_item_margin"
        android:layout_marginEnd="@dimen/person_info_item_margin"/>
    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>
