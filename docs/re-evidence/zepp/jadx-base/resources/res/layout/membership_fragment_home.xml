<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.lib.rainbow.titlebar.RainbowTitleBar
        android:id="@+id/rainbow_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:menuIcon="@drawable/ic_tips_20"
        app:menuTint="@color/s1"
        app:title="@string/membership_title"/>
    <FrameLayout
        android:id="@+id/container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rainbow_title_bar"/>
    <TextView
        android:id="@+id/member_empty_hint_msg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/membership_card_empty_list"
        android:drawableTop="@drawable/membership_ic_empty"
        app:drawableTint="@color/s3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/container"/>
    <Button
        android:id="@+id/member_btn_add"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_30dp"
        android:text="@string/smart_alarm_add"
        android:drawablePadding="@dimen/size_5dp"
        android:drawableStart="@drawable/ic_add_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/member_empty_hint_msg"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guideline_l_bottom_area"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="33dp"/>
    <View
        android:id="@+id/member_space"
        android:background="@color/s38"
        android:layout_width="0dp"
        android:layout_height="@dimen/size_66dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <Button
        android:textSize="@dimen/size_12sp"
        android:textColor="@color/s2"
        android:gravity="center_horizontal"
        android:id="@+id/member_edit"
        android:background="@android:color/transparent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/size_34dp"
        android:minHeight="@dimen/size_34dp"
        android:text="@string/edit"
        android:drawableTop="@drawable/ic_edit_20"
        android:drawablePadding="3dp"
        android:layout_marginEnd="@dimen/size_92dp"
        app:layout_constraintBottom_toBottomOf="@+id/guideline_l_bottom_area"
        app:layout_constraintEnd_toStartOf="@+id/member_add"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/guideline_l_bottom_area"/>
    <Button
        android:textSize="@dimen/size_12sp"
        android:textColor="@color/s2"
        android:gravity="center_horizontal"
        android:id="@+id/member_add"
        android:background="@android:color/transparent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/size_34dp"
        android:minHeight="@dimen/size_34dp"
        android:text="@string/smart_alarm_add"
        android:drawableTop="@drawable/ic_add_20"
        android:drawablePadding="3dp"
        app:layout_constraintBottom_toBottomOf="@+id/guideline_l_bottom_area"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/member_edit"
        app:layout_constraintTop_toTopOf="@+id/guideline_l_bottom_area"/>
    <Button
        android:textSize="@dimen/size_12sp"
        android:textColor="@color/p3"
        android:gravity="center"
        android:layout_gravity="bottom"
        android:id="@+id/member_btn_complete"
        android:background="@android:color/transparent"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/smart_alarm_done"
        android:drawableTop="@drawable/membership_ic_checked_20_p3"
        android:drawablePadding="3dp"
        android:layout_alignParentBottom="true"
        android:backgroundTint="@android:color/transparent"
        app:layout_constraintBottom_toBottomOf="@+id/guideline_l_bottom_area"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/guideline_l_bottom_area"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:paddingBottom="@dimen/size_10dp"
        android:scrollbars="none"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/size_33dp"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@+id/guideline_l_bottom_area"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/container"/>
    <View
        android:id="@+id/mask_view"
        android:background="@color/cl_b2000000"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/container"/>
</androidx.constraintlayout.widget.ConstraintLayout>
