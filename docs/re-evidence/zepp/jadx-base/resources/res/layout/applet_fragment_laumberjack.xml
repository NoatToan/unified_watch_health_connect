<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/s36"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ListView
                android:id="@+id/applet_device_log_list_view"
                android:paddingLeft="@dimen/account_ui_size_10dp"
                android:paddingRight="@dimen/account_ui_size_10dp"
                android:scrollbars="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:transcriptMode="alwaysScroll"
                android:divider="@color/account_ui_gray"
                android:dividerHeight="@dimen/account_ui_size_0.5dp"
                android:layout_above="@+id/applet_device_log_btn_layout"
                android:headerDividersEnabled="false"
                android:footerDividersEnabled="false"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/applet_device_log_btn_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true">
                <Button
                    android:textSize="@dimen/applet_12dp"
                    android:gravity="center"
                    android:id="@+id/applet_device_log_clear"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/applet_48dp"
                    android:layout_marginLeft="@dimen/account_ui_size_10dp"
                    android:layout_marginRight="@dimen/account_ui_size_10dp"
                    android:text="@string/applet_clear_log"
                    android:layout_weight="1"
                    style="@style/Rainbow.Widget.Button.48"/>
                <Button
                    android:textSize="@dimen/applet_12dp"
                    android:gravity="center"
                    android:id="@+id/applet_device_log_close"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/applet_48dp"
                    android:layout_marginLeft="@dimen/account_ui_size_10dp"
                    android:layout_marginRight="@dimen/account_ui_size_10dp"
                    android:text="@string/applet_device_log_close"
                    android:layout_weight="1"
                    style="@style/Rainbow.Widget.Button.48"/>
            </LinearLayout>
        </RelativeLayout>
        <TextView
            android:textSize="@dimen/applet_12dp"
            android:textColor="@android:color/black"
            android:layout_gravity="center"
            android:id="@+id/applet_empty_hint"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
</androidx.appcompat.widget.LinearLayoutCompat>
