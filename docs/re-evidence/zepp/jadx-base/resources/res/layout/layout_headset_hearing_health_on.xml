<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/headset_hearing_health_on"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/headset_hearing_health_on_constraintLayout"
            android:background="@color/s38"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="45sp"
                android:textColor="@color/s1"
                android:id="@+id/volume_decibel_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_42dp"
                app:layout_constraintBottom_toTopOf="@+id/volume_decibel_description"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Rainbow.TextAppearance.Number1"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/s2"
                android:id="@+id/volume_decibel_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_item_hearing_health_volume_decibel_unit"
                android:layout_marginStart="@dimen/size_2dp"
                app:layout_constraintBaseline_toBaselineOf="@+id/volume_decibel_value"
                app:layout_constraintStart_toEndOf="@+id/volume_decibel_value"/>
            <TextView
                android:textSize="@dimen/size_14sp"
                android:textColor="@color/s2"
                android:id="@+id/volume_decibel_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/td_size_1dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/volume_decibel_value"/>
            <com.xiaomi.hm.health.device.headset.ui.MarqueeView
                android:id="@+id/marqueeView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/td_size_38dp"
                android:layout_marginBottom="@dimen/size_34dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/volume_decibel_description"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.cardview.widget.CardView
            android:background="@color/s38"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14.75dp"
            android:layout_marginStart="@dimen/size_15dp"
            android:layout_marginEnd="@dimen/size_15dp"
            app:cardBackgroundColor="@color/s38"
            app:cardCornerRadius="6dp"
            app:cardElevation="0px"
            app:cardUseCompatPadding="false">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/size_15sp"
                    android:textColor="@color/s1"
                    android:id="@+id/suggestion_use_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_19dp"
                    android:text="@string/settings_headset_suggest_user_time_title"
                    android:drawablePadding="1.5dp"
                    android:layout_marginStart="@dimen/size_16dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ImageView
                    android:id="@+id/suggestion_use_time_caveat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/private_haydn_volume_user_time_caveat"
                    android:layout_marginStart="@dimen/bm_detail_size_5dp"
                    app:layout_constraintBottom_toBottomOf="@+id/suggestion_use_time"
                    app:layout_constraintStart_toEndOf="@+id/suggestion_use_time"
                    app:layout_constraintTop_toTopOf="@+id/suggestion_use_time"
                    app:tint="@color/s1"/>
                <ImageView
                    android:id="@+id/headset_refresh_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_19dp"
                    android:src="@drawable/private_haydn_volume_user_time_refresh"
                    android:layout_marginEnd="@dimen/size_17"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/s1"/>
                <TextView
                    android:textSize="@dimen/size_12sp"
                    android:textColor="@color/s2"
                    android:id="@+id/user_time_hint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/bm_detail_size_5dp"
                    android:text="@string/settings_headset_action_refresh_hint"
                    android:layout_marginStart="@dimen/size_16dp"
                    android:layout_marginEnd="@dimen/size_16dp"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/suggestion_use_time"/>
                <ImageView
                    android:id="@+id/icon_left_ear"
                    android:layout_width="@dimen/size_80dp"
                    android:layout_height="@dimen/td_size_67dp"
                    android:layout_marginTop="49.5dp"
                    android:src="@drawable/headset_hearing_left_selector"
                    android:layout_marginStart="@dimen/size_26dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/user_time_hint"/>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/size_32dp"
                    android:layout_marginEnd="@dimen/size_50dp"
                    app:layout_constraintBottom_toBottomOf="@+id/title_left_ear"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/icon_left_ear"
                    app:layout_constraintTop_toTopOf="@+id/icon_left_ear">
                    <TextView
                        android:textSize="@dimen/size_14sp"
                        android:textColor="@color/s1"
                        android:id="@+id/left_ear_user_time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/size_16dp"
                        app:layout_constrainedWidth="true"/>
                    <ProgressBar
                        android:id="@+id/progress_bar_left"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/size_8dp"
                        android:max="100"
                        android:indeterminateDuration="500"
                        style="@style/Widget.AppCompat.ProgressBar.Horizontal"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <TextView
                    android:textSize="@dimen/size_12sp"
                    android:textColor="@color/s1"
                    android:gravity="center"
                    android:id="@+id/title_left_ear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/headset_action_category_left_ear"
                    app:layout_constraintEnd_toEndOf="@+id/icon_left_ear"
                    app:layout_constraintStart_toStartOf="@+id/icon_left_ear"
                    app:layout_constraintTop_toBottomOf="@+id/icon_left_ear"/>
                <ImageView
                    android:id="@+id/icon_right_ear"
                    android:layout_width="@dimen/size_80dp"
                    android:layout_height="@dimen/td_size_67dp"
                    android:layout_marginTop="@dimen/size_28dp"
                    android:src="@drawable/headset_hearing_right_selector"
                    android:layout_marginStart="@dimen/size_26dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/title_left_ear"/>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/size_32dp"
                    android:layout_marginEnd="@dimen/size_50dp"
                    app:layout_constraintBottom_toBottomOf="@+id/title_right_ear"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/icon_right_ear"
                    app:layout_constraintTop_toTopOf="@+id/icon_right_ear">
                    <TextView
                        android:textSize="@dimen/size_14sp"
                        android:textColor="@color/s1"
                        android:id="@+id/right_ear_user_time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/size_16dp"/>
                    <ProgressBar
                        android:id="@+id/progress_bar_right"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/size_8dp"
                        android:max="100"
                        android:indeterminateDuration="500"
                        style="@style/Widget.AppCompat.ProgressBar.Horizontal"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/s1"
                    android:gravity="center"
                    android:id="@+id/title_right_ear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="29.5dp"
                    android:text="@string/headset_action_category_right_ear"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="@+id/icon_right_ear"
                    app:layout_constraintStart_toStartOf="@+id/icon_right_ear"
                    app:layout_constraintTop_toBottomOf="@+id/icon_right_ear"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
    <View
        android:id="@+id/mask_view"
        android:background="@color/cl_4d000000"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
