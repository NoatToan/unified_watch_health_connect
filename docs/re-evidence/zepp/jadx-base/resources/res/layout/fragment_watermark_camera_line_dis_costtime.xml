<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:id="@+id/fl_camera"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:background="#0000"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"
        android:layout_alignParentRight="true"
        layout="@layout/layout_watermark_tag"/>
    <RelativeLayout
        android:id="@+id/rl_drag_line_area"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:gravity="center_vertical"
            android:id="@+id/rl_drag_line"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="80dp"
            android:paddingEnd="@dimen/watermark_line_thumbnail_padding_r">
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="69.3sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:gravity="bottom"
                android:id="@+id/watermark_km_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="16."
                android:singleLine="true"
                android:fontFamily="din-med"
                android:layout_marginStart="@dimen/watermark_line_km_margin_r"/>
            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_toEndOf="@+id/watermark_km_value">
                <com.huami.widget.typeface.TypefaceTextView
                    android:textSize="43.7sp"
                    android:textColor="@android:color/white"
                    android:id="@+id/tv_km_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="79"
                    android:singleLine="true"
                    android:layout_alignParentTop="true"
                    android:fontFamily="din-med"/>
                <com.huami.widget.typeface.TypefaceTextView
                    android:textSize="16sp"
                    android:textColor="@android:color/white"
                    android:id="@+id/watermark_time_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="79"
                    android:singleLine="true"
                    android:layout_alignParentBottom="true"
                    android:fontFamily="din-med"/>
            </RelativeLayout>
        </RelativeLayout>
    </RelativeLayout>
</RelativeLayout>
