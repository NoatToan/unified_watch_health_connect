<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/tool_scale_balance_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_15dp"
        android:src="@drawable/ic_tool_scale_balance"
        android:layout_marginStart="@dimen/size_15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/play_title_size"
        android:textColor="@color/play_title_color"
        android:gravity="center_vertical"
        android:id="@+id/tool_scale_balance"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/play_tool_scale_balance"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="@dimen/size_15dp"
        app:layout_constraintBottom_toBottomOf="@+id/tool_scale_balance_image"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/tool_scale_balance_image"
        app:layout_constraintTop_toTopOf="@+id/tool_scale_balance_image"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/play_min_sub_title_size"
        android:textColor="@color/play_sub_title_color"
        android:id="@+id/tool_scale_device_status"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="@dimen/size_15dp"
        android:text="@string/play_device_not_active"
        android:layout_marginEnd="@dimen/size_15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="@+id/tool_scale_balance"
        app:layout_constraintTop_toBottomOf="@+id/tool_scale_balance"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/play_sub_title_size"
        android:textColor="#ff312e"
        android:gravity="center"
        android:id="@+id/tool_scale_balance_check"
        android:background="@drawable/shape_tool_snore_monitor"
        android:layout_width="80dp"
        android:layout_height="38dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="@dimen/size_15dp"
        android:text="@string/play_tool_scale_check"
        android:layout_marginEnd="@dimen/size_15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tool_scale_balance"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/play_sub_title_size"
        android:textColor="@color/play_sub_title_color"
        android:id="@+id/tool_scale_balance_not_check"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/play_tool_scale_not_check"
        android:layout_marginStart="@dimen/size_15dp"
        app:layout_constraintBottom_toBottomOf="@+id/tool_scale_balance_check"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tool_scale_balance_check"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tool_scale_balance_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/tool_scale_balance_check"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tool_scale_balance_check">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="20sp"
            android:textColor="@color/play_title_color"
            android:id="@+id/tool_scale_balance_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/size_15dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/play_sub_title_size"
            android:textColor="@color/play_sub_title_color"
            android:id="@+id/tool_scale_balance_time_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/tool_scale_balance_time"
            app:layout_constraintStart_toEndOf="@+id/tool_scale_balance_time"
            app:layout_constraintTop_toTopOf="@+id/tool_scale_balance_time"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/play_sub_title_size"
            android:textColor="@color/play_sub_title_color"
            android:id="@+id/tool_scale_balance_grade_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/play_tool_scale_grade"
            android:layout_marginStart="@dimen/size_15dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tool_scale_balance_time"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/play_sub_title_size"
            android:textColor="#00b088"
            android:id="@+id/tool_scale_balance_grade"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/tool_scale_balance_grade_title"
            app:layout_constraintStart_toEndOf="@+id/tool_scale_balance_grade_title"
            app:layout_constraintTop_toTopOf="@+id/tool_scale_balance_grade_title"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
