<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/s39"
    android:paddingTop="@dimen/share_dialog_content_padding_top"
    android:paddingBottom="@dimen/share_dialog_content_padding_bottom"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/share_dialog_content_padding_horizontal"
    android:paddingEnd="@dimen/share_dialog_content_padding_horizontal">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"/>
</FrameLayout>
