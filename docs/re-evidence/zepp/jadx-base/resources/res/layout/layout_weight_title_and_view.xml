<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="16sp"
        android:textColor="@color/weighting_title_text_color"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="72dp"
        android:text="@string/weighting_weight_bf_failed"
        android:layout_centerHorizontal="true"/>
    <RelativeLayout
        android:id="@+id/layout_weight"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="70dp"
        android:layout_below="@+id/title">
        <com.xiaomi.hm.health.bodyfat.view.WeightChartView
            android:id="@+id/weight_chart"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_centerInParent="true"
            app:circleColor="@color/weighting_circle_color"
            app:edgeColor="@color/weighting_circle_edge_color"
            app:unFillColor="@color/weighting_circle_not_fill_color"
            app:weightFillColor="@color/weighting_circle_fill_color"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/weight_number_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:baselineAligned="true"
            android:layout_centerInParent="true">
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="48sp"
                android:textColor="@color/weighting_value_text_color"
                android:ellipsize="none"
                android:gravity="center"
                android:id="@+id/number"
                android:paddingTop="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:fontFamily="km"/>
            <TextView
                android:textSize="10sp"
                android:textStyle="normal"
                android:textColor="@color/weighting_unit_text_color"
                android:id="@+id/number_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/unit_kg"
                android:maxLines="1"
                android:layout_marginStart="2dp"/>
        </LinearLayout>
        <com.xiaomi.hm.health.bodyfat.view.FatMeasuringView
            android:id="@+id/bodyfat_view"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:layout_below="@+id/weight_number_layout"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
</merge>
