<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.watch.companion.ui.view.ActionbarLayout
        android:id="@+id/actionbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/border_edit_box"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_margin="16dp">
            <EditText
                android:textSize="14sp"
                android:textColor="@color/black"
                android:textColorHint="@color/grey_text"
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:id="@+id/weather_city_search_input"
                android:background="@android:color/transparent"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:hint="@string/weather_city_pick_input_hint"
                android:singleLine="true"
                android:maxLength="200"
                android:layout_weight="1"
                android:imeOptions="actionSearch"
                android:textCursorDrawable="@drawable/cursor_edit_box"
                android:paddingStart="8dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/weather_city_search_clear"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:src="@drawable/btn_edit_text_clear"
                    android:scaleType="center"
                    android:onClick="onWeatherCityClear"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"/>
                <View
                    android:background="@color/divider_color"
                    android:layout_width="1px"
                    android:layout_height="match_parent"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"/>
            </LinearLayout>
            <ImageView
                android:id="@+id/weather_city_search"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/selector_input_search_icon"
                android:scaleType="center"
                android:onClick="onWeatherCitySearch"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"/>
        </LinearLayout>
        <include
            android:layout_width="match_parent"
            android:layout_height="10dp"
            layout="@layout/split_line_width_match_parent"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/weather_city_non_input_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="15dp">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/view_current_location"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="17sp"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="@string/weather_city_located"/>
                <include layout="@layout/split_line_width_match_parent"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:id="@+id/weather_current_location"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:text="@string/weather_location_failed"
                    android:drawablePadding="8dp"/>
            </LinearLayout>
            <include
                android:layout_width="match_parent"
                android:layout_height="5dp"
                layout="@layout/split_line_width_match_parent"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/hot_city_view"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="17sp"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:text="@string/weather_city_hot"/>
                <ScrollView
                    android:scrollbars="none"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="11dp">
                    <com.huami.watch.companion.weather.HotCityView
                        android:id="@+id/weather_city_hot_layout"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                </ScrollView>
            </LinearLayout>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/weather_city_search_result_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="8dp">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/weather_city_search_result_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/weather_city_search_hint_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/dark_grey_text"
                android:gravity="center_horizontal"
                android:id="@+id/weather_city_search_hint"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="15dp"/>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
