<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/s1"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        android:text="@string/blood_pressure_correct_tips_title"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
    <ScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="40dp"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/s1"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="38dp"
                android:text="@string/blood_pressure_correct_tips_one_new"
                android:drawablePadding="12dp"
                app:drawableStartCompat="@drawable/ic_blood_pressure_tips_one"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/s1"
                android:gravity="center"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="38dp"
                android:text="@string/blood_pressure_correct_tips_two"
                android:drawablePadding="12dp"
                app:drawableStartCompat="@drawable/ic_blood_pressure_tips_two"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/s1"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="38dp"
                android:text="@string/blood_pressure_correct_tips_three"
                android:drawablePadding="12dp"
                app:drawableStartCompat="@drawable/ic_blood_pressure_tips_three"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/s1"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="38dp"
                android:text="@string/blood_pressure_correct_tips_four"
                android:drawablePadding="12dp"
                app:drawableStartCompat="@drawable/ic_blood_pressure_tips_four"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/s1"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="38dp"
                android:text="@string/blood_pressure_correct_tips_five"
                android:drawablePadding="12dp"
                app:drawableStartCompat="@drawable/ic_blood_pressure_tips_five"/>
        </LinearLayout>
    </ScrollView>
    <Button
        android:id="@+id/btn_know"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="100dp"
        android:text="@string/btn_i_know_new"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp"
        style="@style/Rainbow.Widget.Button.48"/>
</LinearLayout>
