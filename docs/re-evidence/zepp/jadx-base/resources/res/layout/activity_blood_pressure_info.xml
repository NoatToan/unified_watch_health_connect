<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/container_titlebar"
        layout="@layout/titlebar_blood_pressure"/>
    <androidx.core.widget.NestedScrollView xmlns:app="http://schemas.android.com/apk/res-auto"
        android:background="@color/s38"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:paddingBottom="@dimen/size_49"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_28"
            android:layout_marginStart="@dimen/size_26"
            android:layout_marginEnd="@dimen/size_26">
            <TextView
                android:id="@+id/tv_hbp_title"
                android:text="@string/blood_pressure_hbp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/style_bp_intro_title"/>
            <TextView
                android:id="@+id/tv_hbp_item1"
                android:layout_marginTop="@dimen/size_10"
                android:text="@string/hbp_info_desc1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_hbp_title"
                style="@style/style_bp_intro_forbit_desc"/>
            <TextView
                android:id="@+id/tv_hbp_item2"
                android:layout_marginTop="@dimen/size_20"
                android:text="@string/hbp_info_desc2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_hbp_item1"
                style="@style/style_bp_intro_forbit_desc"/>
            <TextView
                android:id="@+id/tv_hbp_item3"
                android:layout_marginTop="@dimen/size_20"
                android:text="@string/hbp_info_desc3"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_hbp_item2"
                style="@style/style_bp_intro_forbit_desc"/>
            <ImageView
                android:id="@+id/iv_hbp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_16"
                android:src="@drawable/ic_hbp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_hbp_item3"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_49"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/iv_hbp">
                <TextView
                    android:id="@+id/tv_lbp_title"
                    android:text="@string/blood_pressure_lbp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/style_bp_intro_title"/>
                <TextView
                    android:id="@+id/tv_lbp_item1"
                    android:layout_marginTop="@dimen/size_10"
                    android:text="@string/lbp_info_desc1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_lbp_title"
                    style="@style/style_bp_intro_forbit_desc"/>
                <TextView
                    android:id="@+id/tv_lbp_item2"
                    android:layout_marginTop="@dimen/size_20"
                    android:text="@string/lbp_info_desc2"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_lbp_item1"
                    style="@style/style_bp_intro_forbit_desc"/>
                <TextView
                    android:id="@+id/tv_lbp_item3"
                    android:layout_marginTop="@dimen/size_20"
                    android:text="@string/lbp_info_desc3"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_lbp_item2"
                    style="@style/style_bp_intro_forbit_desc"/>
                <TextView
                    android:id="@+id/tv_lbp_item4"
                    android:layout_marginTop="@dimen/size_20"
                    android:text="@string/lbp_info_desc4"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_lbp_item3"
                    style="@style/style_bp_intro_forbit_desc"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
