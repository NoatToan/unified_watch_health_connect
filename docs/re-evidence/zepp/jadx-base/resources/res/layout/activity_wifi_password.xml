<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center_vertical"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.huami.watch.companion.ui.view.ActionbarLayout
            android:id="@+id/wifi_pwd_actionbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <ImageView
            android:id="@+id/button_submit"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/icon_topbar_commit"
            android:layout_centerVertical="true"
            android:layout_marginEnd="16dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/dark_grey_text"
        android:gravity="start|center_vertical"
        android:id="@+id/textview_ssid"
        android:background="@color/bg_main"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:paddingStart="24dp"/>
    <include layout="@layout/split_line_width_match_parent"/>
    <LinearLayout
        android:orientation="horizontal"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="53dp">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/black_text"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/password"
            android:layout_marginStart="24dp"/>
        <com.huami.watch.companion.ui.view.PasswordEditText
            android:textSize="14sp"
            android:textColor="@color/black_text"
            android:textColorHint="@color/grey_text"
            android:gravity="start|center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/edit_text_password"
            android:background="@color/white"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:hint="@string/wifi_password_edit_hint"
            android:maxLines="1"
            android:layout_weight="1"
            android:inputType="textPassword"
            android:textCursorDrawable="@drawable/cursor_edit_box"
            android:textAlignment="viewStart"
            android:layout_marginStart="34dp"
            android:layout_marginEnd="16dp"/>
    </LinearLayout>
    <include layout="@layout/split_line_width_match_parent"/>
    <View
        android:background="@color/bg_main"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
</LinearLayout>
