<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s38"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/health_label_history_back"
        android:layout_width="48dp"
        android:layout_height="56dp"
        android:src="@drawable/ic_health_label_back"
        android:scaleType="center"
        android:tint="@color/s1"
        android:layout_marginStart="3dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/s1"
        android:gravity="center_vertical"
        android:id="@+id/health_label_history_title"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:text="@string/health_label_history_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Rainbow.TextAppearance.Title3"/>
    <View
        android:id="@+id/view_3"
        android:background="@color/health_label_white1A"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintTop_toBottomOf="@+id/health_label_history_back"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/health_label_history_recycler_view"
        android:background="@color/s10"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_3"
        app:layout_constraintVertical_bias="1"
        app:layout_constraintVertical_weight="1"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/health_label_history_date_layout"
        android:background="@color/s10"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        app:layout_constraintTop_toBottomOf="@+id/view_3">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/health_label_history_ring"
            android:background="@drawable/shape_label_history_ring"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginStart="15dp"
            app:layout_constraintBottom_toBottomOf="@+id/health_label_history_date"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/health_label_history_date"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/s1"
            android:gravity="center_vertical"
            android:id="@+id/health_label_history_date"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_40"
            android:layout_marginStart="9dp"
            app:layout_constraintStart_toEndOf="@+id/health_label_history_ring"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Rainbow.TextAppearance.Body3"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/s1"
            android:gravity="center_vertical"
            android:id="@+id/health_label_history_year"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/margin_15"
            app:layout_constraintBottom_toBottomOf="@+id/health_label_history_date"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/health_label_history_date"
            style="@style/Rainbow.TextAppearance.Body3"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/health_label_history_date_image"
        android:background="@drawable/health_label_history_shadow"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        app:layout_constraintTop_toBottomOf="@+id/health_label_history_date_layout"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/health_label_history_delete_ll"
        android:background="@drawable/shape_label_history_delete_bg"
        android:visibility="gone"
        android:layout_width="120dp"
        android:layout_height="120dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/health_label_history_delete_iv"
            android:layout_width="36dp"
            android:layout_height="36dp"
            app:srcCompat="@drawable/ic_loading_onequarter"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/s3"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7.5dp"
            android:text="@string/health_label_history_delete"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
