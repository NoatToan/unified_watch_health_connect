<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/item_bp_year_ring"
        android:background="@drawable/shape_bp_history_ring"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginStart="15dp"
        app:layout_constraintBottom_toBottomOf="@+id/item_bp_year"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/item_bp_year"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/size_24"
        android:textColor="@color/s1"
        android:gravity="center_vertical"
        android:id="@+id/item_bp_year"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="9dp"
        app:layout_constraintStart_toEndOf="@+id/item_bp_year_ring"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/size_16"
        android:textColor="@color/s1"
        android:gravity="center_vertical"
        android:id="@+id/item_bp_year_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:layout_marginStart="14dp"
        app:layout_constraintStart_toEndOf="@+id/view_2"
        app:layout_constraintTop_toBottomOf="@+id/item_bp_year"/>
    <View
        android:id="@+id/view_2"
        android:background="#0fffffff"
        android:layout_width="@dimen/size_1"
        android:layout_height="0dp"
        android:layout_marginStart="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/item_bp_year_date"
        app:layout_constraintEnd_toStartOf="@+id/item_bp_year_date"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/item_bp_year"/>
</androidx.constraintlayout.widget.ConstraintLayout>
