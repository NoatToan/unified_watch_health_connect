<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/s38"
    android:layout_width="match_parent"
    android:layout_height="72dp">
    <View
        android:id="@+id/firstSplitLine"
        android:visibility="gone"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        style="@style/VerticalDivider"/>
    <View
        android:id="@+id/commonSplitLine"
        android:layout_marginStart="60dp"
        android:layout_marginEnd="18dp"
        style="@style/VerticalDivider"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <ImageView
            android:id="@+id/sportsTypeIcon"
            android:padding="5dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="18dp"
            android:layout_alignParentStart="true"
            style="@style/sportsTypeIcon"/>
        <ImageView
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/icon_right_arrow_focus"
            android:layout_centerVertical="true"
            android:layout_marginEnd="18dp"
            android:layout_alignParentEnd="true"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="14sp"
            android:textColor="@color/s2"
            android:gravity="center_vertical"
            android:id="@+id/sportsBegin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:fontFamily="km"
            android:layout_marginEnd="18dp"
            android:layout_alignParentEnd="true"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="14dp"
            android:layout_toStartOf="@+id/sportsBegin"
            android:layout_toEndOf="@+id/sportsTypeIcon">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="23dp">
                <com.huami.widget.typeface.TypefaceTextView
                    android:textSize="15sp"
                    android:textColor="@color/s1"
                    android:ellipsize="end"
                    android:id="@+id/sportsType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:lines="1"
                    android:fontFamily="km"
                    android:layout_marginStart="5dp"/>
                <com.huami.widget.typeface.TypefaceTextView
                    android:textSize="15sp"
                    android:textColor="@color/s1"
                    android:ellipsize="end"
                    android:id="@+id/sportsTypeData"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:lines="1"
                    android:fontFamily="km"
                    android:layout_marginStart="5dp"/>
                <ImageView
                    android:id="@+id/sportsDeviceIcon"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6.7dp"
                    app:tint="@color/s3"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/runningInfoContainer_top_margin">
                <com.huami.widget.typeface.TypefaceTextView
                    android:textSize="@dimen/sportCostTime_text_size"
                    android:textColor="@color/s2"
                    android:gravity="center_vertical"
                    android:id="@+id/sportCostTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="4dp"
                    android:drawableStart="@drawable/ic_time_14_s2"
                    android:fontFamily="km"
                    android:layout_marginStart="5dp"
                    app:drawableTint="@color/s3"/>
                <com.huami.widget.typeface.TypefaceTextView
                    android:textSize="@dimen/sportCostTime_text_size"
                    android:textColor="@color/s2"
                    android:gravity="center_vertical"
                    android:id="@+id/sportSubData"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="4dp"
                    android:drawableStart="@drawable/ic_calories_14_s2"
                    android:fontFamily="km"
                    android:layout_marginStart="20dp"
                    app:drawableTint="@color/s3"/>
                <com.huami.widget.typeface.TypefaceTextView
                    android:textSize="@dimen/sportCostTime_text_size"
                    android:textColor="@color/s2"
                    android:gravity="center_vertical"
                    android:id="@+id/sportFreq"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="4dp"
                    android:drawableStart="@drawable/ic_calories_14_s2"
                    android:fontFamily="km"
                    android:layout_marginStart="20dp"
                    app:drawableTint="@color/s3"/>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
    <View
        android:id="@+id/endSplitLine"
        android:visibility="gone"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        style="@style/VerticalDivider"/>
</LinearLayout>
