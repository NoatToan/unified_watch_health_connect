<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_schedule_item_start"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:layout_marginTop="10dp">
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="15dp"
        android:layout_alignParentStart="true"
        style="@style/Rainbow.TextAppearance.Number6"/>
    <TextView
        android:textColor="@color/p3"
        android:id="@+id/weekday"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginEnd="26dp"
        android:layout_alignParentEnd="true"
        style="@style/Rainbow.TextAppearance.Number8"/>
    <ImageView
        android:background="@color/s4"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"/>
</RelativeLayout>
