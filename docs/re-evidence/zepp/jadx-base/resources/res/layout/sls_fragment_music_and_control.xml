<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/sls_back_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="12sp"
        android:textColor="@color/white100"
        android:ellipsize="end"
        android:id="@+id/sls_about_play_music_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="@string/sls_about_play_music_label"
        android:fontFamily="lt"
        android:layout_marginStart="29dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.huami.sleepassistant.lib.widget.CustomSmartRefreshLayout
        android:id="@+id/sls_fragment_refresh"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sls_about_play_music_label">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/sls_fragment_music_recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="24dp"/>
    </com.huami.sleepassistant.lib.widget.CustomSmartRefreshLayout>
    <com.huami.sleepassistant.lib.widget.CanNotClickView
        android:id="@+id/sls_can_not_click_view"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
