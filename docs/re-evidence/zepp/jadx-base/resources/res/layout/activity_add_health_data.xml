<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/size_15dp"
    android:paddingEnd="@dimen/size_15dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/data_edit"
        android:background="@drawable/shape_rect_corner_white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_15dp"
        android:maxHeight="260dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/date_item"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_64dp"
            android:paddingStart="@dimen/size_13dp"
            android:paddingEnd="@dimen/size_12dp"
            app:layout_constraintTop_toTopOf="parent">
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="@dimen/size_15sp"
                android:textColor="@color/s1"
                android:id="@+id/date_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/health_data_date"
                android:textDirection="locale"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/date"
                app:layout_constraintHorizontal_weight="2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="@dimen/size_14sp"
                android:textColor="@color/s1"
                android:gravity="end"
                android:id="@+id/date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textDirection="locale"
                app:drawableTint="@color/s2"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toEndOf="@+id/date_text"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/time_item"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_64dp"
            android:paddingStart="@dimen/size_13dp"
            android:paddingEnd="@dimen/size_12dp"
            app:layout_constraintTop_toBottomOf="@+id/date_item">
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="@dimen/size_15sp"
                android:textColor="@color/s1"
                android:id="@+id/time_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/time"
                android:textDirection="locale"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/time"
                app:layout_constraintHorizontal_weight="2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="@dimen/size_14sp"
                android:textColor="@color/s1"
                android:gravity="end"
                android:id="@+id/time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textDirection="locale"
                app:drawableTint="@color/s2"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toEndOf="@+id/time_text"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/data_item"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_64dp"
            android:paddingStart="@dimen/size_13dp"
            android:paddingEnd="@dimen/size_12dp"
            app:layout_constraintTop_toBottomOf="@+id/time_item">
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="@dimen/size_15sp"
                android:textColor="@color/s1"
                android:id="@+id/data_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textDirection="locale"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/editText"
                app:layout_constraintHorizontal_weight="2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <EditText
                android:textSize="@dimen/size_14sp"
                android:textColor="@color/s1"
                android:textColorHint="@color/s2"
                android:gravity="end"
                android:id="@+id/editText"
                android:background="@null"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:textCursorDrawable="@drawable/cursor_edit_box"
                android:textDirection="locale"
                app:drawableTint="@color/s2"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toEndOf="@+id/data_text"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/extra_data_item"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_64dp"
            android:paddingStart="@dimen/size_13dp"
            android:paddingEnd="@dimen/size_12dp"
            app:layout_constraintTop_toBottomOf="@+id/data_item">
            <com.huami.widget.typeface.TypefaceTextView
                android:textSize="@dimen/size_15sp"
                android:textColor="@color/s1"
                android:id="@+id/extra_data_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/card_dbp"
                android:textDirection="locale"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/extra_editText"
                app:layout_constraintHorizontal_weight="2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <EditText
                android:textSize="@dimen/size_14sp"
                android:textColor="@color/s1"
                android:textColorHint="@color/s2"
                android:gravity="end"
                android:id="@+id/extra_editText"
                android:background="@null"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:textCursorDrawable="@drawable/cursor_edit_box"
                android:textDirection="locale"
                app:drawableTint="@color/s2"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toEndOf="@+id/extra_data_text"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <Button
        android:enabled="false"
        android:textSize="@dimen/size_15sp"
        android:gravity="center"
        android:id="@+id/save"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_48dp"
        android:layout_marginTop="@dimen/size_45dp"
        android:text="@string/save"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/data_edit"
        style="@style/Rainbow.Widget.Button.48"/>
</androidx.constraintlayout.widget.ConstraintLayout>
