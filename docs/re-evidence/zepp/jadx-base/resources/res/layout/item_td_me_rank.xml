<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/left_icon_area"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/td_size_14dp"
        android:layout_marginBottom="@dimen/td_size_14dp"
        android:layout_marginStart="@dimen/td_size_23dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/icon"
            android:layout_width="@dimen/td_size_28dp"
            android:layout_height="@dimen/td_size_28dp"
            android:layout_marginStart="@dimen/td_size_38dp"/>
        <ImageView
            android:background="@drawable/td_avatar_ring_orange"
            android:layout_width="@dimen/td_size_28dp"
            android:layout_height="@dimen/td_size_28dp"
            android:layout_marginStart="@dimen/td_size_38dp"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="15sp"
            android:textColor="@color/cl_ff5353"
            android:layout_gravity="center_vertical"
            android:id="@+id/td_rank"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="lt"
            android:layout_marginStart="@dimen/td_size_14dp"/>
    </FrameLayout>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="15sp"
        android:textColor="@color/cl_ff5353"
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="lt"
        android:layout_marginStart="@dimen/td_size_14dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/time_or_count"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toEndOf="@+id/left_icon_area"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="15sp"
        android:textColor="@color/s2"
        android:gravity="end"
        android:id="@+id/time_or_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="lt"
        android:layout_marginEnd="@dimen/td_size_23dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toEndOf="@+id/name"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
