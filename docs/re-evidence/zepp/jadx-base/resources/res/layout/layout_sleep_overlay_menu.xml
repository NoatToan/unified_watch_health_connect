<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/main"
            android:paddingStart="8dp"
            android:paddingEnd="10dp"
            style="@style/SleepOverlayItem">
            <ImageView
                android:id="@+id/iv_main"
                android:visibility="gone"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:id="@+id/tv_main"
                android:text="@string/slp_no_select_overlay"
                android:layout_marginStart="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/iv_main"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TextBody5s1"/>
            <ImageView
                android:id="@+id/iv_arrow"
                android:layout_width="14dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_expand_more_20"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tv_main"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/s3"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/resp_layout"
            android:visibility="gone"
            android:layout_marginTop="4dp"
            style="@style/SleepOverlayItem">
            <ImageView
                android:id="@+id/iv_resp"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_sleep_breathing_24"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:id="@+id/tv_resp"
                android:text="@string/slp_resp_rate_overlay"
                android:layout_marginStart="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/iv_resp"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TextBody5s1"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/hr_layout"
            android:visibility="gone"
            android:layout_marginTop="4dp"
            style="@style/SleepOverlayItem">
            <ImageView
                android:id="@+id/iv_hr"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_heart_rate_24"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:id="@+id/hr"
                android:text="@string/slp_heart_rate_overlay"
                android:layout_marginStart="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/iv_hr"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TextBody5s1"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/close_layout"
            android:visibility="gone"
            android:layout_marginTop="4dp"
            style="@style/SleepOverlayItem">
            <ImageView
                android:id="@+id/iv_close"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_remove_20"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/s1"/>
            <TextView
                android:id="@+id/tv_close"
                android:text="@string/state_close"
                android:layout_marginStart="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/iv_close"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TextBody5s1"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</merge>
