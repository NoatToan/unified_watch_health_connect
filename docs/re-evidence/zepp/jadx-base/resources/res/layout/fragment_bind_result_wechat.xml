<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s36"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.lib.rainbow.titlebar.RainbowTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/bind_wechat_title"/>
    <ImageView
        android:id="@+id/img"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/bind_success_img_top"
        android:src="@drawable/ic_step_bind"
        android:contentDescription="展示绑定状态"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_bar"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/bind_success_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/bind_success_tips_top"
        android:text="@string/bind_wechat_status"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/img"
        style="@style/Rainbow.TextAppearance.Body2"/>
    <TextView
        android:textColor="@color/s2"
        android:id="@+id/tv_desc_steps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/desc_top_margin"
        android:text="@string/dec_steps_bind_success"
        android:layout_marginStart="@dimen/desc_left_margin"
        android:layout_marginEnd="@dimen/desc_left_margin"
        app:layout_constraintTop_toBottomOf="@+id/bind_success_tips"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <TextView
        android:textColor="@color/s2"
        android:id="@+id/bind_tips"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/qr_top_margin"
        android:text="@string/desc_sports_bind_success"
        android:layout_marginStart="@dimen/desc_left_margin"
        android:layout_marginEnd="@dimen/desc_left_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/Rainbow.TextAppearance.Body5"/>
    <com.huami.lib.rainbow.button.RainbowButton
        android:id="@+id/btn_delete_device"
        android:visibility="gone"
        android:layout_width="@dimen/watch_qr_height"
        android:layout_height="@dimen/desc_top_margin"
        android:layout_marginBottom="@dimen/desc_left_margin"
        android:text="@string/btn_delete_device"
        app:layout_constraintBottom_toTopOf="@+id/bind_tips"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="?attr/buttonStyleRed_48_outline"/>
</androidx.constraintlayout.widget.ConstraintLayout>
