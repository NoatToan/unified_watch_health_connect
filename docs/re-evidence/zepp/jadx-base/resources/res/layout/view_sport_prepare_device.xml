<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    style="@style/viewSportPrepareDeviceStyle">
    <RelativeLayout
        android:layout_gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/iv_ic_device_1"
            android:layout_width="@dimen/size_33dp"
            android:layout_height="@dimen/size_33dp"
            android:src="@drawable/ic_sport_prepare_default_device"
            android:layout_marginStart="3.3dp"/>
        <ImageView
            android:id="@+id/iv_ic_device_2"
            android:layout_width="@dimen/size_33dp"
            android:layout_height="@dimen/size_33dp"
            android:src="@drawable/ic_sport_prepare_default_device"
            android:layout_marginStart="16dp"/>
    </RelativeLayout>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_heart_rate_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp">
            <TextView
                android:textSize="12sp"
                android:textColor="#333333"
                android:id="@+id/tv_heart_rate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sport_prepare_device_line"/>
            <TextView
                android:textSize="9.3sp"
                android:textColor="#8d8d8d"
                android:ellipsize="end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="60dp"
                android:text="@string/sport_waiting_heart_rate"
                android:lines="1"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_hardware_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp">
            <TextView
                android:textSize="12sp"
                android:textColor="#333333"
                android:id="@+id/tv_hardware"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sport_prepare_device_line"/>
            <TextView
                android:textSize="9.3sp"
                android:textColor="#8d8d8d"
                android:ellipsize="end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="80dp"
                android:text="@string/sport_waiting_hardware"
                android:lines="1"/>
        </LinearLayout>
    </LinearLayout>
</merge>
