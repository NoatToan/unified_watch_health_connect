<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="210dp">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/middle_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintGuide_percent="0.5"
        app:layout_constraintStart_toStartOf="parent"/>
    <View
        android:background="@color/s4"
        android:layout_width="0.5dp"
        android:layout_height="145dp"
        android:layout_marginTop="44dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        android:text="@string/homepage_item_card_sport_state"
        android:layout_marginStart="15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Rainbow.TextAppearance.Body3"/>
    <com.huami.module.homepage.cards.cardui.PiecewiseArcView
        android:id="@+id/max_vo2_arc"
        android:layout_width="128dp"
        android:layout_height="110dp"
        android:layout_marginTop="15dp"
        android:layout_marginStart="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <com.huami.module.homepage.cards.cardui.PiecewiseArcView
        android:id="@+id/epoc_arc"
        android:layout_width="128dp"
        android:layout_height="110dp"
        android:layout_marginTop="15dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/s1"
        android:gravity="center"
        android:id="@+id/max_vo2_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        app:layout_constraintEnd_toEndOf="@+id/max_vo2_arc"
        app:layout_constraintStart_toStartOf="@+id/max_vo2_arc"
        app:layout_constraintTop_toTopOf="@+id/max_vo2_arc"
        style="@style/Rainbow.TextAppearance.Body5"/>
    <TextView
        android:textColor="@color/s1"
        android:gravity="center"
        android:id="@+id/epoc_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        app:layout_constraintEnd_toEndOf="@+id/epoc_arc"
        app:layout_constraintStart_toStartOf="@+id/epoc_arc"
        app:layout_constraintTop_toTopOf="@+id/epoc_arc"
        style="@style/Rainbow.TextAppearance.Body5"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/s1"
        android:ellipsize="end"
        android:gravity="center"
        android:paddingBottom="10dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/homepage_item_card_max_vo2"
        android:maxLines="2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/max_vo2_arc"
        app:layout_constraintStart_toStartOf="@+id/max_vo2_arc"
        app:layout_constraintTop_toBottomOf="@+id/max_vo2_arc"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <TextView
        android:textColor="@color/s1"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="@string/homepage_item_card_epoc"
        android:maxLines="2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/epoc_arc"
        app:layout_constraintStart_toStartOf="@+id/epoc_arc"
        app:layout_constraintTop_toBottomOf="@+id/epoc_arc"
        style="@style/Rainbow.TextAppearance.Body4"/>
</androidx.constraintlayout.widget.ConstraintLayout>
