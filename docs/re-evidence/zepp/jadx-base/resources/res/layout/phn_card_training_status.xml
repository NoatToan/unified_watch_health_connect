<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/phn_shape_card_common"
    android:paddingTop="17dp"
    android:paddingBottom="17dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/tv_fatigue_level"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/phn_training_analysis_fatigue_level"
        android:drawablePadding="5dp"
        android:drawableStart="@drawable/phn_shape_dot_oval_s51"
        android:layout_marginStart="19dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="100dp"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/tv_fitness_level"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/phn_training_analysis_fitness_level"
        android:drawablePadding="5dp"
        android:drawableStart="@drawable/phn_shape_dot_oval_s15"
        app:layout_constraintStart_toStartOf="@+id/tv_fatigue_level"
        app:layout_constraintTop_toBottomOf="@+id/tv_fatigue_level"
        app:layout_constraintWidth_max="100dp"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <TextView
        android:textColor="@color/s1"
        android:id="@+id/tv_training_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/phn_training_analysis_status"
        android:layout_marginEnd="13dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_fatigue_level"
        app:layout_constraintWidth_max="100dp"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <com.huami.lib.rainbow.widget.SwitchCompat
        android:id="@+id/switch_training_status"
        android:focusable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="false"
        android:layout_marginEnd="4dp"
        app:layout_constraintEnd_toStartOf="@+id/tv_training_status"
        app:layout_constraintTop_toTopOf="@+id/tv_fatigue_level"
        style="@style/Rainbow.Widget.Switch"/>
    <com.huami.phn.coach.ui.view.PHNTrainingStatusView
        android:id="@+id/training_status_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintStart_toStartOf="@+id/tv_fatigue_level"
        app:layout_constraintTop_toBottomOf="@+id/tv_fitness_level"/>
</androidx.constraintlayout.widget.ConstraintLayout>
