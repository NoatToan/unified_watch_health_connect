<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/point_text_img"
        android:background="@drawable/circle_bg"
        android:layout_width="8.2dp"
        android:layout_height="8.2dp"
        android:layout_marginTop="3.9dp"
        android:layout_alignParentTop="true"
        android:layout_toStartOf="@+id/point_text"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#333333"
        android:id="@+id/point_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="7.2dp"/>
</RelativeLayout>
