<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/account_ui_transparency"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/account_ui_dialog_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="18sp"
                android:textColor="@color/s1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="@string/account_ui_anonymous_login_or_reg_title"/>
            <TextView
                android:textSize="@dimen/account_ui_logout_content_text_size"
                android:textColor="@color/s1"
                android:gravity="start"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:layout_marginBottom="@dimen/account_ui_logout_margin"
                android:text="@string/account_ui_anonymous_login_or_reg_content"
                android:layout_marginStart="40dp"
                android:layout_marginEnd="40dp"/>
        </LinearLayout>
        <View
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <LinearLayout
            android:orientation="horizontal"
            android:background="@color/account_ui_trans"
            android:layout_width="match_parent"
            android:layout_height="@dimen/account_ui_item_height_max">
            <TextView
                android:textSize="@dimen/account_ui_person_info_setting_text_size"
                android:textColor="@color/s1"
                android:gravity="center"
                android:id="@+id/btn_cancel"
                android:background="@drawable/account_ui_btn_click_bg_round_dialog_bottom_left"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/account_ui_cancel"
                android:layout_weight="1"/>
            <View
                android:background="@color/s4"
                android:layout_width="1px"
                android:layout_height="match_parent"/>
            <TextView
                android:textSize="@dimen/account_ui_person_info_setting_text_size"
                android:textColor="@color/s1"
                android:gravity="center"
                android:id="@+id/btn_login_or_register"
                android:background="@drawable/account_ui_btn_click_bg_round_dialog_bottom_right"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/account_ui_anonymous_login_or_reg"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
