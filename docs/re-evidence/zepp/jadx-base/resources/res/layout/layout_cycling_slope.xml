<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/normalSlopeDataContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="21dp"
    android:layout_marginBottom="16dp">
    <com.huami.moving.ui.view.SlopePieChartView
        android:layout_gravity="center_vertical"
        android:id="@+id/slopePieChart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/pieChartLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="49dp">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/slope_up_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_alignParentStart="true">
                <View
                    android:background="@drawable/shape_slope_up"
                    android:layout_width="8dp"
                    android:layout_height="8dp"/>
                <TextView
                    android:textSize="12.7sp"
                    android:textColor="@color/color_999999"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/slope_change_pie_chart_up_label"
                    android:layout_marginStart="7dp"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_below="@+id/slope_up_title"
                android:layout_marginStart="15dp"
                android:layout_alignParentStart="true">
                <TextView
                    android:textSize="12.7sp"
                    android:textColor="@color/color_999999"
                    android:gravity="center"
                    android:id="@+id/slopeUpTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00:00"/>
                <TextView
                    android:textSize="12.7sp"
                    android:textColor="@color/color_999999"
                    android:gravity="center"
                    android:id="@+id/slopeUpPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:layout_marginStart="13dp"/>
            </LinearLayout>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/down_up_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_alignParentStart="true">
                <View
                    android:background="@drawable/shape_slope_down"
                    android:layout_width="8dp"
                    android:layout_height="8dp"/>
                <TextView
                    android:textSize="12.7sp"
                    android:textColor="@color/color_999999"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/slope_change_pie_chart_down_label"
                    android:layout_marginStart="7dp"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_below="@+id/down_up_title"
                android:layout_marginStart="15dp"
                android:layout_alignParentStart="true">
                <TextView
                    android:textSize="12.7sp"
                    android:textColor="@color/color_999999"
                    android:gravity="center"
                    android:id="@+id/slopeDownTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00:00"/>
                <TextView
                    android:textSize="12.7sp"
                    android:textColor="@color/color_999999"
                    android:gravity="center"
                    android:id="@+id/slopeDownPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:layout_marginStart="13dp"/>
            </LinearLayout>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/flat_up_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_alignParentStart="true">
                <View
                    android:background="@drawable/shape_slope_flat"
                    android:layout_width="8dp"
                    android:layout_height="8dp"/>
                <TextView
                    android:textSize="12.7sp"
                    android:textColor="@color/color_999999"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/slope_change_pie_chart_flat_label"
                    android:layout_marginStart="7dp"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_below="@+id/flat_up_title"
                android:layout_marginStart="15dp"
                android:layout_alignParentStart="true">
                <TextView
                    android:textSize="12.7sp"
                    android:textColor="@color/color_999999"
                    android:gravity="center"
                    android:id="@+id/slopeFlatTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00:00"/>
                <TextView
                    android:textSize="12.7sp"
                    android:textColor="@color/color_999999"
                    android:gravity="center"
                    android:id="@+id/slopeFlatPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:layout_marginStart="13dp"/>
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
