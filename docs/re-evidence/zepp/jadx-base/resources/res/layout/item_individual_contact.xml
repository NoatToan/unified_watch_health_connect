<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_round_app_notification"
    android:layout_width="match_parent"
    android:layout_height="@dimen/size_128dp"
    android:paddingEnd="@dimen/size_15dp">
    <CheckBox
        android:id="@+id/cb_contact"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:button="@drawable/bg_item_diagnosis_select"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/divider"
        android:background="@color/divide"
        android:visibility="gone"
        android:layout_width="@dimen/size_1dp"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/size_20dp"
        android:layout_marginBottom="@dimen/size_20dp"
        android:layout_marginStart="@dimen/size_50dp"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="@dimen/size_14sp"
        android:textColor="@color/s2"
        android:id="@+id/tv_label_contact"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_contact"
        android:layout_marginStart="@dimen/size_15dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_contact"
        app:layout_constraintStart_toEndOf="@+id/divider"
        app:layout_constraintTop_toTopOf="@+id/tv_contact"/>
    <TextView
        android:textColor="@color/s1"
        android:gravity="center_vertical"
        android:id="@+id/tv_contact"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/size_64dp"
        android:drawableEnd="@drawable/ic_arrow_forward_20_2x"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/size_14sp"
        android:textColor="@color/s2"
        android:id="@+id/tv_label_vibration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_vibration"
        android:layout_marginStart="@dimen/size_15dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_vibration"
        app:layout_constraintStart_toEndOf="@+id/divider"
        app:layout_constraintTop_toTopOf="@+id/tv_vibration"/>
    <ImageView
        android:id="@+id/iv_vibration"
        android:layout_width="@dimen/size_24dp"
        android:layout_height="@dimen/size_24dp"
        android:layout_marginEnd="@dimen/size_8dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_vibration"
        app:layout_constraintEnd_toStartOf="@+id/tv_vibration"
        app:layout_constraintTop_toTopOf="@+id/tv_vibration"/>
    <TextView
        android:textColor="@color/s1"
        android:gravity="center_vertical"
        android:id="@+id/tv_vibration"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/size_64dp"
        android:layout_marginLeft="@dimen/size_8dp"
        android:drawableEnd="@drawable/ic_arrow_forward_20_2x"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
