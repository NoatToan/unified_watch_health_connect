<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/s36"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="20sp"
        android:textColor="@color/s1"
        android:gravity="center"
        android:id="@+id/title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="98dp"
        android:text="@string/erase_scale_history_data"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/s1"
        android:gravity="center"
        android:id="@+id/sub_title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:text="@string/erase_scale_history_data_tips"
        android:layout_below="@+id/title_tv"
        android:layout_centerHorizontal="true"/>
    <com.huami.lib.view.progress.ProgressView
        android:id="@+id/bind_chart"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_marginTop="82dp"
        android:src="@drawable/img_clean"
        android:progress="100"
        android:layout_below="@+id/sub_title_tv"
        android:layout_centerHorizontal="true"
        app:backgroundColor="@color/s36"
        app:progressColor="@color/erase_scale_history_data_circle_color"
        app:strokeWidth="1.8dp"
        app:style="cycle"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <TextView
            android:textSize="14sp"
            android:textColor="@drawable/bind_left_text_color"
            android:gravity="center"
            android:layout_gravity="start"
            android:id="@+id/left_btn"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="144dp"
            android:layout_height="93dp"
            android:text="@string/cancel"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@drawable/erase_scale_history_right_button_text_color"
            android:gravity="center"
            android:layout_gravity="end"
            android:id="@+id/right_btn"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="144dp"
            android:layout_height="93dp"
            android:text="@string/erase_scale_history_data_button_text"/>
    </FrameLayout>
</RelativeLayout>
