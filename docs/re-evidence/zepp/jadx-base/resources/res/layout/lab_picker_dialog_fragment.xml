<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/lab_dialog_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/lab_temperature_black"
        android:gravity="center"
        android:id="@+id/lab_dialog_picker_title"
        android:layout_width="wrap_content"
        android:layout_height="62dp"
        android:text="@string/lab_temperature_device_parts_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/divider_1"
        android:background="#fff2f2f2"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintTop_toBottomOf="@+id/lab_dialog_picker_title"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <com.huami.widget.wheelview.WheelView
        android:id="@+id/lab_temperature_wheelview_1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:layout_marginStart="36dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toTopOf="@+id/divider_2"
        app:layout_constraintEnd_toStartOf="@+id/guideline_1"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider_1"
        app:layout_constraintVertical_weight="1"/>
    <com.huami.widget.wheelview.WheelView
        android:id="@+id/lab_temperature_wheelview_2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="36dp"
        app:layout_constraintBottom_toTopOf="@+id/divider_2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/guideline_1"
        app:layout_constraintTop_toBottomOf="@+id/divider_1"
        app:layout_constraintVertical_weight="1"/>
    <View
        android:id="@+id/divider_2"
        android:background="#fff2f2f2"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="220dp"
        app:layout_constraintTop_toBottomOf="@+id/divider_1"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="15sp"
        android:textColor="@color/lab_temperature_black_cancel"
        android:gravity="center"
        android:id="@+id/lab_temperature_cancel"
        android:background="?android:attr/selectableItemBackground"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:text="@string/cancel_tagging"
        app:layout_constraintEnd_toStartOf="@+id/divider_3"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider_2"/>
    <View
        android:id="@+id/divider_3"
        android:background="#fff2f2f2"
        android:layout_width="1dp"
        android:layout_height="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/lab_temperature_cancel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/lab_temperature_cancel"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="15sp"
        android:textColor="@color/lab_temperature_black"
        android:gravity="center"
        android:id="@+id/lab_temperature_ok"
        android:background="?android:attr/selectableItemBackground"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:text="@string/btn_confirm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/divider_3"
        app:layout_constraintTop_toBottomOf="@+id/divider_2"/>
</androidx.constraintlayout.widget.ConstraintLayout>
