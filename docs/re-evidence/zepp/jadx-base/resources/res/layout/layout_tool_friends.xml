<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="?attr/textAppearanceBody3"
        android:textColor="@color/s1"
        android:gravity="center_vertical"
        android:id="@+id/tool_friends"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/size_15dp"
        android:text="@string/mine_item_friends"
        android:drawablePadding="10dp"
        android:drawableStart="@drawable/ic_tool_friends_24"
        android:layout_marginStart="@dimen/size_15dp"
        app:layout_constraintEnd_toStartOf="@+id/tool_friends_add"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tool_friends_add"
        android:background="@drawable/shape_tool_friends"
        android:layout_width="56dp"
        android:layout_height="34dp"
        android:layout_marginEnd="@dimen/size_15dp"
        app:layout_constraintBottom_toBottomOf="@+id/tool_friends"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tool_friends"
        app:layout_constraintTop_toTopOf="@+id/tool_friends"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/tool_friends_add_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_tool_friends_add_24"
        app:layout_constraintBottom_toBottomOf="@+id/tool_friends_add"
        app:layout_constraintEnd_toEndOf="@+id/tool_friends_add"
        app:layout_constraintStart_toStartOf="@+id/tool_friends_add"
        app:layout_constraintTop_toTopOf="@+id/tool_friends_add"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tool_no_friends_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_10dp"
        app:layout_constraintTop_toBottomOf="@+id/tool_friends">
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="?attr/textAppearanceBody4"
            android:textColor="@color/s2"
            android:id="@+id/tool_friends_prompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/play_tool_friends_method"
            android:layout_marginStart="@dimen/size_15dp"
            android:layout_marginEnd="@dimen/size_15dp"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/tool_friends_scan"
            android:layout_width="64dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:src="@drawable/ic_tool_friends_scan_24"
            android:scaleType="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tool_friends_prompt"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/tool_friends_qrcode"
            android:layout_width="64dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:src="@drawable/ic_tool_friends_qrcode_24"
            android:scaleType="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tool_friends_invite"
            app:layout_constraintStart_toEndOf="@+id/tool_friends_scan"
            app:layout_constraintTop_toBottomOf="@+id/tool_friends_prompt"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/tool_friends_invite"
            android:layout_width="64dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:src="@drawable/ic_tool_friends_invite_24"
            android:scaleType="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tool_friends_prompt"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tool_friends_layout"
        android:paddingBottom="10dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_10dp"
        app:layout_constraintTop_toBottomOf="@+id/tool_friends">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/tool_friends_recyclerview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/view_1"
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginStart="@dimen/size_15dp"
            android:layout_marginEnd="@dimen/size_15dp"
            app:layout_constraintTop_toBottomOf="@+id/tool_friends_recyclerview"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/tool_friends_more"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@+id/view_1">
            <androidx.appcompat.widget.AppCompatTextView
                android:textAppearance="?attr/textAppearanceBody4"
                android:textColor="@color/s2"
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/play_tool_friends_more"
                android:drawableEnd="@drawable/ic_tool_right_24"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
