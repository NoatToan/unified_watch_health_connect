<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@color/s36"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/tip_iv"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:src="@drawable/ic_nfc_placeholder"
        android:scaleType="center"
        android:layout_weight="467"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:background="@color/s36"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="173">
        <TextView
            android:textSize="24sp"
            android:textColor="@color/s1"
            android:id="@+id/wl_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_24dp"
            android:text="@string/wl_band_can_use_bus_card"/>
        <TextView
            android:textAppearance="@style/TextAppearance.MiFit.Title"
            android:textColor="@color/s2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wl_no_wait_in_line"/>
        <Button
            android:gravity="center"
            android:id="@+id/setup_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/size_18dp"
            android:text="@string/wl_open_up_now"
            style="@style/Rainbow.Widget.Button.44.Circular"/>
    </LinearLayout>
</LinearLayout>
