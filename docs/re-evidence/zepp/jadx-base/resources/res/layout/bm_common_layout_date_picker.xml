<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:background="@drawable/bm_common_shape_rect_corner_white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="15dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp">
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/bm_common_black"
            android:gravity="center"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/divider"
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="@dimen/bm_common_divider_height"
            android:layout_marginTop="@dimen/size_20dp"
            app:layout_constraintTop_toBottomOf="@+id/title"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/wheel"
            android:layout_width="match_parent"
            android:layout_height="222dp"
            app:layout_constraintTop_toBottomOf="@+id/divider">
            <com.huami.widget.wheelview.WheelView
                android:id="@+id/wheel_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                app:layout_constraintEnd_toStartOf="@+id/wheel_2"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toStartOf="parent"/>
            <com.huami.widget.wheelview.WheelView
                android:id="@+id/wheel_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                app:layout_constraintEnd_toStartOf="@+id/wheel_3"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toEndOf="@+id/wheel_1"/>
            <com.huami.widget.wheelview.WheelView
                android:id="@+id/wheel_3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toEndOf="@+id/wheel_2"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:id="@+id/divider_2"
            android:background="@color/s4"
            android:layout_width="match_parent"
            android:layout_height="@dimen/bm_common_divider_height"
            android:layout_marginTop="@dimen/size_20dp"
            app:layout_constraintTop_toBottomOf="@+id/wheel"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="16sp"
            android:textColor="@color/s2"
            android:gravity="center"
            android:id="@+id/cancel"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:text="@string/bm_common_cancel"
            android:fontFamily="lt-bold"
            app:layout_constraintEnd_toStartOf="@+id/divider_3"
            app:layout_constraintHorizontal_weight="171"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/divider_2"/>
        <View
            android:id="@+id/divider_3"
            android:background="@color/s4"
            android:layout_width="0dp"
            android:layout_height="24dp"
            app:layout_constraintBottom_toBottomOf="@+id/cancel"
            app:layout_constraintEnd_toStartOf="@+id/confirm"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@+id/cancel"
            app:layout_constraintTop_toTopOf="@+id/cancel"/>
        <com.huami.widget.typeface.TypefaceTextView
            android:textSize="16sp"
            android:textColor="@color/bm_common_black"
            android:gravity="center"
            android:id="@+id/confirm"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:text="@string/bm_common_confirm"
            android:fontFamily="lt-bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="171"
            app:layout_constraintStart_toEndOf="@+id/divider_3"
            app:layout_constraintTop_toBottomOf="@+id/divider_2"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
