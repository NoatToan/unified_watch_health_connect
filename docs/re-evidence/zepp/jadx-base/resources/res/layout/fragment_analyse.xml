<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/card_corner_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/size_10"
    android:layout_marginEnd="@dimen/size_10">
    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/fl_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_16"
        android:layout_marginStart="@dimen/size_15"
        app:alignItems="center"
        app:flexDirection="row"
        app:flexWrap="nowrap"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textColor="@color/blood_pressure_s1"
            android:ellipsize="end"
            android:id="@+id/tv_analyse_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lines="1"
            app:layout_constraintEnd_toStartOf="@+id/iv_research_detail"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Rainbow.TextAppearance.Title2"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_research_detail"
            android:visibility="gone"
            android:layout_width="@dimen/size_16"
            android:layout_height="@dimen/size_16"
            android:src="@drawable/ic_tips_20"
            android:layout_marginStart="@dimen/size_6"
            app:tint="@color/s2"/>
    </com.google.android.flexbox.FlexboxLayout>
    <View
        android:id="@+id/line_analyse"
        android:background="@color/line_color"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_line"
        android:layout_marginTop="@dimen/size_15"
        android:layout_marginStart="@dimen/size_15"
        android:layout_marginEnd="@dimen/size_15"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fl_title"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/ry_content"
        android:paddingBottom="@dimen/size_19"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@+id/line_analyse"/>
</androidx.constraintlayout.widget.ConstraintLayout>
