<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:baseui="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/s36"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="220dp">
                <ImageView
                    android:background="@color/trans"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/mine_head_bg"
                    android:scaleType="fitXY"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/s3"
                    android:id="@+id/new_user_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/new_user_info_margin_top"
                    android:text="@string/new_user_info"
                    android:layout_centerHorizontal="true"
                    android:layout_marginStart="@dimen/new_user_margin_start_end"
                    android:layout_marginEnd="@dimen/new_user_margin_start_end"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_below="@+id/new_user_info">
                    <RelativeLayout
                        android:id="@+id/new_user_avatar_rl"
                        android:layout_width="@dimen/new_user_avatar_rl_size"
                        android:layout_height="@dimen/new_user_avatar_rl_size">
                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            baseui:cardCornerRadius="@dimen/relatives_size_44dp"
                            baseui:cardElevation="0dp">
                            <com.huami.lib.view.image.CircleImageView
                                android:id="@+id/new_user_avatar"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/setting_avatar_default"
                                baseui:civ_border_color="@color/s3"
                                baseui:civ_border_width="1.3dp"
                                baseui:civ_fill_color="@color/s3"
                                baseui:hm_civ_border_color_touch="@color/s30"/>
                            <TextView
                                android:textSize="12sp"
                                android:textColor="@color/white"
                                android:gravity="center"
                                android:layout_gravity="bottom"
                                android:id="@+id/tv_avatar_in_audit"
                                android:background="#191919"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:text="@string/account_ui_in_audit"
                                android:alpha="0.5"/>
                        </androidx.cardview.widget.CardView>
                        <ImageView
                            android:layout_width="@dimen/new_user_camera_size"
                            android:layout_height="@dimen/new_user_camera_size"
                            android:src="@drawable/setting_camera"
                            android:layout_alignParentBottom="true"
                            android:layout_alignParentEnd="true"/>
                    </RelativeLayout>
                </LinearLayout>
            </RelativeLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:background="@color/trans"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/new_user_info_setting_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    baseui:ltv_tips="@string/new_user_item_input_default"
                    baseui:ltv_title="@string/name"/>
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/new_user_info_setting_gender"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    baseui:ltv_tips="@string/new_user_item_choose_default"
                    baseui:ltv_title="@string/your_gender"/>
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/new_user_info_setting_birthday"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    baseui:ltv_tips="@string/new_user_item_choose_default"
                    baseui:ltv_title="@string/please_input_birthday"/>
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/new_user_info_setting_height"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    baseui:ltv_tips="@string/new_user_item_choose_default"
                    baseui:ltv_title="@string/your_height"/>
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/new_user_info_setting_weight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    baseui:ltv_tips="@string/new_user_item_choose_default"
                    baseui:ltv_title="@string/your_weight"/>
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/new_user_info_setting_goal_activity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    baseui:ltv_title="@string/mine_item_sport_goal"/>
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/new_user_info_setting_goal_calorie"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    baseui:ltv_title="@string/goal_calorie_item"/>
                <com.huami.lib.rainbow.ListTile
                    android:id="@+id/new_user_info_setting_goal_sleep"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    baseui:ltv_title="@string/goal_sleep_item"/>
                <View
                    android:background="@color/s4"
                    android:layout_width="match_parent"
                    android:layout_height="1px"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <TextView
        android:textColor="@color/s3"
        android:gravity="center"
        android:id="@+id/new_user_skip"
        android:background="@drawable/btn_bg_skip"
        android:layout_width="match_parent"
        android:layout_height="@dimen/click_button_h"
        android:layout_marginTop="@dimen/new_user_margin_top_bottom"
        android:layout_marginBottom="12dp"
        android:text="@string/homepage_rom_update_skip"
        android:layout_marginStart="@dimen/new_user_margin_start_end"
        android:layout_marginEnd="@dimen/new_user_margin_start_end"/>
    <TextView
        android:textColor="@color/account_ui_select_alive_btn_txt_color"
        android:gravity="center"
        android:layout_gravity="bottom"
        android:id="@+id/new_user_next"
        android:background="@drawable/button_hm_email"
        android:layout_width="match_parent"
        android:layout_height="@dimen/click_button_h"
        android:layout_marginBottom="@dimen/new_user_margin_top_bottom"
        android:text="@string/next_step"
        android:layout_marginStart="@dimen/new_user_margin_start_end"
        android:layout_marginEnd="@dimen/new_user_margin_start_end"/>
</LinearLayout>
