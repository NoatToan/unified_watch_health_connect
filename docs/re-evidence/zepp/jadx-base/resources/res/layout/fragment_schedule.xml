<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#f3f3f3"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.watch.companion.ui.view.ActionbarLayout
        android:id="@+id/actionbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/layout_dynamic_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_no_event"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#999999"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/no_updates"
                android:lineSpacingExtra="0sp"/>
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_update"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.oubowu.stickyitemdecoration.StickyHeadContainer
            android:id="@+id/stick_head_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include layout="@layout/schedule_list_item_date"/>
        </com.oubowu.stickyitemdecoration.StickyHeadContainer>
    </FrameLayout>
    <LinearLayout
        android:gravity="center"
        android:background="@android:color/white"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="12sp"
            android:textColor="#666666"
            android:gravity="center_horizontal"
            android:id="@+id/iv_add"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="添加日程"
            android:drawableTop="@drawable/ic_schedule_add"
            android:drawablePadding="6dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#666666"
            android:gravity="center_horizontal"
            android:id="@+id/iv_more"
            android:padding="10dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/smart_setting"
            android:drawableTop="@drawable/ic_smart_setting"
            android:drawablePadding="6dp"
            android:layout_marginStart="48dp"/>
    </LinearLayout>
</LinearLayout>
