<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="horizontal"
        android:id="@+id/share"
        android:background="@color/s38"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="@dimen/share_sheet_item_height"
        android:overScrollMode="never"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
    <View
        android:id="@+id/function_line"
        android:background="@color/s4"
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider"/>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="horizontal"
        android:id="@+id/function"
        android:background="@color/s38"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="@dimen/share_sheet_item_height"
        android:overScrollMode="never"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
    <FrameLayout
        android:background="@color/s4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/s1"
            android:gravity="center"
            android:id="@+id/cancel_button"
            android:background="@drawable/function_sheet_bottom_selector"
            android:layout_width="match_parent"
            android:layout_height="@dimen/share_dialog_success_button_height"
            android:text="@string/share_cancel"/>
    </FrameLayout>
</LinearLayout>
