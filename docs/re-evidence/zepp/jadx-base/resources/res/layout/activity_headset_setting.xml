<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/s10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.lib.rainbow.titlebar.RainbowTitleBar
        android:id="@+id/rainbow_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.huami.lib.view.scroll.HMScrollView
        android:id="@+id/scroll_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:id="@+id/header_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="center"
                    android:id="@+id/iv_disconnect"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tint="@color/s2"
                    app:srcCompat="@drawable/img_x"/>
                <include layout="@layout/layout_headset_detail_header"/>
            </FrameLayout>
            <androidx.cardview.widget.CardView
                android:id="@+id/container"
                android:background="@android:color/white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_5dp"
                android:layout_marginStart="@dimen/size_15dp"
                android:layout_marginEnd="@dimen/size_15dp"
                app:cardBackgroundColor="@color/s38"
                app:cardCornerRadius="6dp"
                app:cardElevation="0px"
                app:cardUseCompatPadding="false"/>
            <ViewStub
                android:id="@+id/viewstud_headset_noise"
                android:layout="@layout/layout_headset_noise_reduction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_15dp"
                android:layout_marginStart="@dimen/size_15dp"
                android:layout_marginEnd="@dimen/size_15dp"/>
            <androidx.cardview.widget.CardView
                android:background="@color/s38"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_15dp"
                android:layout_marginBottom="@dimen/size_10dp"
                android:layout_marginStart="@dimen/size_15dp"
                android:layout_marginEnd="@dimen/size_15dp"
                app:cardBackgroundColor="@color/s38"
                app:cardCornerRadius="6dp"
                app:cardElevation="0px"
                app:cardUseCompatPadding="false">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.huami.lib.rainbow.ListTile
                        android:id="@+id/item_headset_settings_hearing_health"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/size_64dp"
                        app:ltv_title="@string/settings_item_hearing_health"/>
                    <com.huami.lib.rainbow.ListTile
                        android:id="@+id/item_headset_settings_cervical_protection"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/size_64dp"
                        app:ltv_title="@string/settings_item_cervical_protection"/>
                    <com.huami.lib.rainbow.ListTile
                        android:id="@+id/item_sky_sleep_relax"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/size_64dp"
                        app:ltv_title="@string/item_sky_sleep_relax"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_5dp"
                android:layout_marginStart="@dimen/size_15dp"
                android:layout_marginEnd="@dimen/size_15dp"
                app:cardCornerRadius="6dp"
                app:cardElevation="0px"
                app:cardUseCompatPadding="false">
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@color/s38"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.huami.lib.rainbow.ListTile
                        android:id="@+id/item_headset_settings_action"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/size_64dp"
                        app:ltv_title="@string/headset_settings_action"/>
                    <com.huami.lib.rainbow.ListTile
                        android:id="@+id/item_headset_settings_equalizer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/size_64dp"
                        app:ltv_title="@string/bolt_eq_title"/>
                    <com.huami.lib.rainbow.ListTile
                        android:id="@+id/item_headset_settings_side_listen"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/size_64dp"
                        app:ltv_title="@string/headset_settings_side_listen"/>
                    <com.huami.lib.rainbow.ListTile
                        android:id="@+id/item_headset_settings_sport"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/size_64dp"
                        app:ltv_title="@string/headset_settings_sport"/>
                    <com.huami.lib.rainbow.ListTile
                        android:id="@+id/item_headset_settings_voice_control"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/size_64dp"
                        app:ltv_title="@string/settings_item_voice_control"/>
                    <com.huami.lib.rainbow.ListTile
                        android:id="@+id/item_headset_settings_wear_induction"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/size_64dp"
                        app:ltv_checked="false"
                        app:ltv_subtitle="@string/settings_item_wear_induction_summary"
                        app:ltv_title="@string/settings_item_wear_induction"/>
                    <com.huami.lib.rainbow.ListTile
                        android:id="@+id/item_headset_alarm"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/size_64dp"
                        app:ltv_title="@string/item_headset_alarm"/>
                    <com.huami.lib.rainbow.ListTile
                        android:id="@+id/item_headset_smart_play_music"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/size_64dp"
                        app:ltv_subtitle="@string/item_headset_smart_play_music_summary"
                        app:ltv_title="@string/earbud_smart_play"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <ViewStub
                android:id="@+id/viewstud_headset_sport"
                android:layout="@layout/layout_headset_sport_list"
                android:inflatedId="@+id/view_group_headset_sport_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_15dp"
                android:layout_marginStart="@dimen/size_15dp"
                android:layout_marginEnd="@dimen/size_15dp"/>
            <androidx.cardview.widget.CardView
                android:background="@color/s38"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_15dp"
                android:layout_marginStart="@dimen/size_15dp"
                android:layout_marginEnd="@dimen/size_15dp"
                app:cardBackgroundColor="@color/s38"
                app:cardCornerRadius="6dp"
                app:cardElevation="0px"
                app:cardUseCompatPadding="false">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.huami.lib.rainbow.ListTile
                        android:id="@+id/item_headset_settings_play"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/size_64dp"
                        app:ltv_title="玩转"/>
                    <com.huami.lib.rainbow.ListTile
                        android:id="@+id/item_faq"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/size_64dp"
                        app:ltv_title="@string/setting_question"/>
                    <com.huami.lib.rainbow.ListTile
                        android:id="@+id/item_check_firmware"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/size_64dp"
                        app:ltv_title="@string/setting_update"/>
                    <com.huami.lib.rainbow.ListTile
                        android:id="@+id/item_reset"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/size_64dp"
                        app:ltv_title="@string/bind_restore_factory"/>
                    <com.huami.lib.rainbow.ListTile
                        android:id="@+id/item_fw_version"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/size_64dp"
                        app:ltv_title="@string/mili_setting_fw_version"/>
                    <com.huami.lib.rainbow.ListTile
                        android:id="@+id/item_mac_address"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/size_64dp"
                        app:ltv_title="@string/mili_setting_mac_address"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <Space
                android:layout_width="0dp"
                android:layout_height="@dimen/size_122dp"/>
            <Button
                android:textColor="@color/p4"
                android:id="@+id/setting_unbind"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_50dp"
                android:text="@string/mili_setting_unbind"
                android:textAllCaps="false"
                android:layout_marginStart="@dimen/size_15dp"
                android:layout_marginEnd="@dimen/size_15dp"
                android:stateListAnimator="@null"
                android:backgroundTint="@color/s38"/>
            <Space
                android:layout_width="0dp"
                android:layout_height="@dimen/td_size_31dp"/>
        </LinearLayout>
    </com.huami.lib.view.scroll.HMScrollView>
</androidx.appcompat.widget.LinearLayoutCompat>
