<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:ads="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/def_normal_black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/sport_ad_layout"
        android:background="@drawable/bg_rect_corners"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="120dp"
        android:layout_centerInParent="true">
        <com.xiaomi.hm.health.baseui.RoundedCornersImageView
            android:layout_gravity="center"
            android:id="@+id/sport_ad_image"
            android:layout_width="264dp"
            android:layout_height="180dp"
            android:scaleType="fitXY"
            ads:corner_top_left="4dp"
            ads:corner_top_right="4dp"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/dark_black"
                android:gravity="center"
                android:id="@+id/sport_ad_title"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="something"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/def_normal_black"
                android:gravity="center"
                android:id="@+id/sport_ad_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="something just like this \10 Chainsmokers \10 Cold Play"
                android:lineSpacingMultiplier="1.3"/>
        </LinearLayout>
    </LinearLayout>
    <ImageButton
        android:id="@+id/sport_ad_close"
        android:background="@drawable/ic_close_36"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:layout_marginBottom="8dp"
        android:layout_below="@+id/sport_ad_layout"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
