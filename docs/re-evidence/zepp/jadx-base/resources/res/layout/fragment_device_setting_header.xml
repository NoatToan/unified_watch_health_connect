<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/_root"
    android:background="@android:color/transparent"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/top_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="0dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/vertical_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.54"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="50sp"
        android:textColor="@color/s1"
        android:id="@+id/tv_battery_level"
        android:layout_width="wrap_content"
        android:layout_height="70dp"
        android:layout_marginTop="55dp"
        app:layout_constraintStart_toStartOf="@+id/vertical_line"
        app:layout_constraintTop_toBottomOf="@+id/top_line"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="22sp"
        android:textColor="@color/s2"
        android:id="@+id/tv_percent"
        android:layout_width="22dp"
        android:layout_height="30dp"
        android:layout_marginBottom="11dp"
        android:text="%"
        android:layout_marginStart="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_battery_level"
        app:layout_constraintStart_toEndOf="@+id/tv_battery_level"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="12sp"
        android:textColor="@color/s2"
        android:id="@+id/tv_last_charge"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="3dp"
        android:layout_marginEnd="@dimen/size_15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/vertical_line"
        app:layout_constraintTop_toBottomOf="@+id/tv_battery_level"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_battery_info"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tv_battery_level, tv_percent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/s2"
        android:id="@+id/tv_device_status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="100dp"
        android:minHeight="@dimen/size_20dp"
        android:text="@string/add_devices_connecting"
        android:layout_marginStart="35dp"
        android:layout_marginEnd="@dimen/size_15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/vertical_line"
        app:layout_constraintTop_toBottomOf="@+id/top_line"
        style="@style/Rainbow.TextAppearance.Body4"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="12sp"
        android:textColor="@color/s2"
        android:gravity="center"
        android:id="@+id/retry_connect_tv"
        android:background="@drawable/bg_new_device_page_retry_btn"
        android:visibility="gone"
        android:layout_width="69dp"
        android:layout_height="31dp"
        android:layout_marginTop="10dp"
        android:text="@string/retry"
        android:layout_marginStart="14dp"
        app:layout_constraintStart_toEndOf="@+id/vertical_line"
        app:layout_constraintTop_toBottomOf="@+id/tv_device_status"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/fl_watch_picture"
        android:background="@color/transparent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="@dimen/dp_10"
        app:layout_constraintEnd_toStartOf="@+id/vertical_line"
        app:layout_constraintTop_toBottomOf="@+id/top_line">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_device_shadow"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:src="@drawable/img_device_shadow"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="160:24"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_skin"
            android:visibility="gone"
            android:layout_width="160dp"
            android:layout_height="186dp"
            android:layout_marginBottom="7dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_dial"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/iv_skin"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/iv_skin"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_device_transparent"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:src="@android:color/transparent"
            app:layout_constraintBottom_toBottomOf="@+id/iv_skin"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/iv_skin"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_default_device"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@android:color/transparent"
            app:cardCornerRadius="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/icon_state"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_device_connecting"
        app:layout_constraintBottom_toBottomOf="@+id/tv_device_status"
        app:layout_constraintEnd_toStartOf="@+id/tv_device_status"
        app:layout_constraintTop_toTopOf="@+id/tv_device_status"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="12sp"
        android:textColor="@color/s2"
        android:id="@+id/tv_charging"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="15dp"
        android:layout_marginTop="2dp"
        android:drawablePadding="2dp"
        android:drawableStart="@drawable/ic_device_charge"
        android:layout_marginStart="5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/vertical_line"
        app:layout_constraintTop_toBottomOf="@+id/tv_battery_level"/>
</androidx.constraintlayout.widget.ConstraintLayout>
