<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/wl_union_card_nm"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#ff5353"
        android:id="@+id/add_support_bank"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/wl_support_bank"
        android:layout_alignParentEnd="true"/>
    <com.unionpay.ui.widget.BankCardEditText
        android:textSize="14sp"
        android:textColor="#e6000000"
        android:textColorHint="#5c000000"
        android:id="@+id/add_union_card_nm"
        android:background="@drawable/wl_watch_bank_text_bg"
        android:padding="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:hint="@string/wl_input_union_card_nm"
        android:layout_below="@+id/add_support_bank"
        android:inputType="number"
        android:textCursorDrawable="@drawable/wl_watch_bank_cursor_edit_box"/>
    <CheckBox
        android:id="@+id/protocol_agree"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:checked="false"
        android:button="@drawable/wl_watch_bank_checkbox"
        android:layout_below="@+id/add_union_card_nm"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#de000000"
        android:id="@+id/agree_protocol_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/wl_bank_protcol_agree"
        android:layout_alignBaseline="@+id/protocol_agree"
        android:layout_marginStart="10dp"
        android:layout_toEndOf="@+id/protocol_agree"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#dc2b0b"
        android:id="@+id/protocol_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBaseline="@+id/protocol_agree"
        android:layout_toEndOf="@+id/agree_protocol_text"/>
    <TextView
        android:enabled="false"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/wl_watch_bank_btn_text_color_black"
        android:gravity="center"
        android:id="@+id/next_button"
        android:background="@drawable/wl_watch_bank_corner_white_rect"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/wl_bank_next_step"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
