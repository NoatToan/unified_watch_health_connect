<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.midong.webview.widget.WebToolBar
        android:id="@+id/web_title_bar"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="46.3dp"/>
    <ProgressBar
        android:id="@+id/web_progress"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:max="100"
        android:progress="5"
        android:progressTint="@color/dark_red"
        android:progressTintMode="src_in"
        android:progressBackgroundTint="@android:color/transparent"
        android:progressBackgroundTintMode="src_in"
        style="?android:attr/progressBarStyleHorizontal"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <com.huami.midong.webview.jsbridge.JsBridgeStatusWebView
            android:id="@+id/js_status_web_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ImageView
            android:id="@+id/web_no_title_back"
            android:visibility="gone"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="8dp"
            android:src="@drawable/web_title_back_white"
            android:scaleType="centerInside"
            android:layout_marginStart="10dp"/>
    </RelativeLayout>
</LinearLayout>
