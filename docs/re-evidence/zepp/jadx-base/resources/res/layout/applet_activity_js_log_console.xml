<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s36"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/applet_log_tabLayout"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="@dimen/applet_48dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tabIndicatorHeight="2dp"
        app:tabSelectedTextColor="@color/p4"
        app:tabTextColor="@color/s1"/>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/applet_log_viewpager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/applet_log_tabLayout"/>
</androidx.constraintlayout.widget.ConstraintLayout>
