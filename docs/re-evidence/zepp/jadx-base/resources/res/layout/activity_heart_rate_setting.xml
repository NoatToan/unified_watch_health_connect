<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.huami.watch.companion.ui.view.ActionbarLayout
        android:id="@+id/action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <RelativeLayout
        android:id="@+id/view_allday_heart"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#e6000000"
            android:id="@+id/hr_switch_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/all_day_heartrate"
            android:layout_centerVertical="true"/>
        <Switch
            android:id="@+id/hr_switch"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:thumb="@drawable/ic_hr_switch_thumb"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            style="@style/WatchSwitch"/>
    </RelativeLayout>
    <RelativeLayout
        android:orientation="horizontal"
        android:id="@+id/view_heart_measure_type"
        android:background="@color/white"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="2dp"
        android:onClick="toSettingTime"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#e6000000"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/heart_measure_type"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#4c000000"
            android:id="@+id/heart_measure_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="10dp"
            android:layout_toStartOf="@+id/heart_measure_arrow"/>
        <ImageView
            android:id="@+id/heart_measure_arrow"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/arrow_right"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/af_content_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#e6000000"
                android:id="@+id/af_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/atrial_fibrillation_notify"
                android:layout_centerVertical="true"/>
            <Switch
                android:id="@+id/af_switch"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:thumb="@drawable/ic_hr_switch_thumb"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                style="@style/WatchSwitch"/>
        </RelativeLayout>
        <TextView
            android:textSize="12sp"
            android:textColor="#4c000000"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/atrial_fibrillation_tips"
            android:lineSpacingExtra="8sp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"/>
        <RelativeLayout
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#e6000000"
                android:id="@+id/disturb_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/atrial_fibrillation_disturb"
                android:layout_centerVertical="true"/>
            <Switch
                android:id="@+id/af_disturb"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:thumb="@drawable/ic_hr_switch_thumb"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                style="@style/WatchSwitch"/>
        </RelativeLayout>
        <RelativeLayout
            android:orientation="horizontal"
            android:background="@color/white"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="2dp"
            android:onClick="toSettingTime"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#e6000000"
                android:id="@+id/disturb_time_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/atrial_fibrillation_disturb_time"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#4c000000"
                android:id="@+id/disturb_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginEnd="10dp"
                android:layout_toStartOf="@+id/time_arrow"/>
            <ImageView
                android:id="@+id/time_arrow"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/arrow_right"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <TextView
            android:textSize="12sp"
            android:textColor="#4c000000"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/atrial_fibrillation_disturb_tips"
            android:lineSpacingExtra="8sp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"/>
    </LinearLayout>
</LinearLayout>
