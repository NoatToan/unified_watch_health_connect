<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s36"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <cn.bingoogolapple.bgabanner.BGABanner
        android:id="@+id/banner_guide_content"
        android:background="@color/s15"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:banner_pageChangeDuration="1000"
        app:banner_pointAutoPlayAble="true"
        app:banner_pointContainerBackground="@android:color/transparent"
        app:banner_pointDrawable="@drawable/wl_viewpager_point"
        app:banner_pointLeftRightMargin="@dimen/size_14dp"
        app:banner_pointTopBottomMargin="@dimen/size_16dp"
        app:banner_transitionEffect="alpha"
        app:layout_constraintBottom_toTopOf="@+id/bottom_space"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_weight="464"/>
    <Space
        android:id="@+id/bottom_space"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/banner_guide_content"
        app:layout_constraintVertical_weight="110"/>
    <net.lucode.hackware.magicindicator.MagicIndicator
        android:id="@+id/magic_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size_18dp"
        app:layout_constraintBottom_toBottomOf="@+id/banner_guide_content"
        app:layout_constraintEnd_toEndOf="@+id/banner_guide_content"
        app:layout_constraintStart_toStartOf="@+id/banner_guide_content"/>
    <TextView
        android:textAppearance="@style/TextAppearance.MiFit.Title.Dim.Inverse"
        android:textColor="@color/s3"
        android:gravity="center"
        android:id="@+id/wl_progress_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size_6dp"
        android:text="@string/wl_open_bus_card_in_progress"
        app:layout_constraintBottom_toTopOf="@+id/progress_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/bottom_space"
        app:layout_constraintVertical_chainStyle="packed"/>
    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_4dp"
        android:layout_marginTop="@dimen/size_6dp"
        android:max="100"
        android:indeterminateOnly="false"
        android:progressDrawable="@drawable/wl_progress_bar"
        android:layout_marginStart="@dimen/size_45dp"
        android:layout_marginEnd="@dimen/size_45dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/wl_progress_text"
        app:layout_constraintVertical_chainStyle="packed"/>
</androidx.constraintlayout.widget.ConstraintLayout>
