<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:scrollbars="none"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.huami.lib.rainbow.titlebar.RainbowTitleBar
            android:id="@+id/actionbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:title="@string/widget_sim"/>
        <ImageView
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10.7dp"
            android:src="@drawable/ic_esim_welcome"
            android:scaleType="fitCenter"/>
        <TextView
            android:textSize="13.3sp"
            android:textColor="@color/s2"
            android:id="@+id/introduction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5.3dp"
            android:text="@string/esim_introduction"
            android:lineSpacingExtra="10sp"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="28dp"/>
        <TextView
            android:textSize="13.3sp"
            android:textColor="@color/s1"
            android:layout_gravity="center_horizontal"
            android:id="@+id/esim_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="11.7dp"
            android:text="@string/esim_more_info"
            android:drawablePadding="4dp"
            android:lineSpacingExtra="0sp"
            android:drawableEnd="@drawable/ic_tips_20"
            app:drawableTint="@color/s2"/>
        <RelativeLayout
            android:orientation="horizontal"
            android:id="@+id/opening_area"
            android:background="#ffffff"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="52.7dp"
            android:layout_marginTop="12.7dp"
            android:paddingStart="23dp"
            android:paddingEnd="23dp">
            <com.huami.android.design.dialog.loading.LoadingView
                android:id="@+id/progress_bar"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="13.3sp"
                android:textStyle="bold"
                android:textColor="@color/s1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/esim_card"
                android:layout_centerVertical="true"
                android:layout_marginStart="4dp"
                android:layout_toEndOf="@+id/progress_bar"/>
            <TextView
                android:textSize="13.3sp"
                android:textColor="@color/s2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/activating"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view"
            android:background="@color/s38"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15.3dp"/>
        <TextView
            android:textSize="14.7sp"
            android:textStyle="bold"
            android:textColor="@color/s1"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/add"
            android:background="@drawable/white_corner_btn_bg"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp"
            android:text="@string/esim_add_account"
            android:layout_marginStart="23dp"
            android:layout_marginEnd="23dp"/>
        <TextView
            android:textSize="11.3sp"
            android:textColor="@color/s3"
            android:layout_gravity="center_horizontal"
            android:id="@+id/error_text"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14.7dp"
            android:layout_marginBottom="20dp"
            android:text="@string/esim_disconnect_error_tips"
            android:lineSpacingExtra="0sp"/>
    </LinearLayout>
</ScrollView>
