<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="30sp"
        android:textColor="@color/s27"
        android:id="@+id/timeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/snore_current_time"
        android:layout_above="@+id/timeLayout"
        android:layout_centerHorizontal="true"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/timeLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/centerBtnLayout"
        android:layout_centerHorizontal="true">
        <TextView
            android:textSize="70sp"
            android:textColor="@color/s27"
            android:id="@+id/timeHour"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="70sp"
            android:textColor="@color/s27"
            android:id="@+id/colons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/snore_maohao"/>
        <TextView
            android:textSize="70sp"
            android:textColor="@color/s27"
            android:id="@+id/timeMin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/centerBtnLayout"
        android:layout_width="match_parent"
        android:layout_height="170dp"
        android:layout_marginBottom="218dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true">
        <com.airbnb.lottie.LottieAnimationView
            android:layout_gravity="center"
            android:id="@+id/breathView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.53"
            app:lottie_autoPlay="true"
            app:lottie_fileName="breath.json"
            app:lottie_loop="true"/>
        <com.huami.snore.ui.view.CustomRoundProgressBar
            android:layout_gravity="center"
            android:id="@+id/progress"
            android:layout_width="170dp"
            android:layout_height="170dp"
            app:RoundProgressBarProgressBgColor="#4cffffff"
            app:RoundProgressBarProgressBgWidth="6dp"
            app:RoundProgressBarProgressColor="@color/s25"
            app:RoundProgressBarProgressWidth="6dp"
            app:RoundProgressBarTotal="100"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.airbnb.lottie.LottieAnimationView
            android:layout_gravity="center"
            android:id="@+id/innerCircleView"
            android:layout_width="150dp"
            android:layout_height="150dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:lottie_autoPlay="true"
            app:lottie_fileName="snore_monitor_end.json"
            app:lottie_loop="true"/>
        <View
            android:layout_gravity="center"
            android:id="@+id/scale"
            android:background="@drawable/stop_btn_scale_bg"
            android:visibility="gone"
            android:layout_width="150dp"
            android:layout_height="150dp"
            app:layout_constraintBottom_toBottomOf="@+id/progress"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/progress"/>
        <TextView
            android:textSize="24sp"
            android:textColor="@color/s5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/snore_long_press"
            app:layout_constraintBottom_toBottomOf="@+id/guideline3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/s5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/snore_finish_monitor"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/guideline3"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@+id/guideline3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintGuide_percent="0.5"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/bottomBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="77dp"
        android:layout_alignParentBottom="true">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/s5"
            android:gravity="center"
            android:id="@+id/helpSleepTonality"
            android:background="@drawable/help_sleep_tonality_bg"
            android:visibility="gone"
            android:text="@string/snore_help_sleep_tonality"
            android:drawablePadding="3dp"
            android:drawableStart="@drawable/snore_help_sleep_tonality_icon"
            style="@style/activityMonitoringButtonStyle"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/s5"
            android:gravity="center"
            android:id="@+id/helpSleepRegulation"
            android:background="@drawable/help_sleep_regulation_bg"
            android:text="@string/snore_help_sleep_regulating"
            android:drawablePadding="3dp"
            android:drawableStart="@drawable/snore_help_sleep_regulating_icon"
            android:layout_marginStart="20dp"
            style="@style/activityMonitoringButtonStyle"/>
    </LinearLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/s27"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:text="@string/snore_recommend_tool_tip"
        android:layout_above="@+id/bottomBtn"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
