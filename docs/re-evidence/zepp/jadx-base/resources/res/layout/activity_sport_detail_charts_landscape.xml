<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/s38"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/moving_ui_diagram_landscape_chart_back_icon"
        android:layout_width="@dimen/d5"
        android:layout_height="@dimen/d5"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_arrow_back_20_2x"
        app:tint="@color/s1"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/moving_ui_diagram_landscape_chart_label_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="116dp"
        android:layout_marginEnd="116dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/moving_ui_diagram_landscape_flag_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/moving_ui_diagram_landscape_chart_label_layout">
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/s2"
            android:gravity="center"
            android:id="@+id/moving_ui_diagram_landscape_flag_text"
            android:background="@drawable/shape_rect_s4_corner_4"
            android:layout_width="60dp"
            android:layout_height="18dp"
            style="@style/Rainbow.TextAppearance.Body5"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/moving_ui_diagram_landscape_container"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/moving_ui_diagram_landscape_flag_layout"/>
</androidx.constraintlayout.widget.ConstraintLayout>
