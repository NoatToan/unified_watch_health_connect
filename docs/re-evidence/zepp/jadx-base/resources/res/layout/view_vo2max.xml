<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center"
        android:id="@+id/tv_vo2max_sport"
        android:visibility="gone"
        android:layout_marginTop="23dp"
        android:drawablePadding="14dp"
        android:drawableStart="@drawable/ic_vo2max_run"
        android:layout_marginStart="23dp"
        style="@style/Txt.Black"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp">
        <TextView
            android:textStyle="bold"
            android:textColor="@color/s1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vo2max_current_max"
            style="@style/Rainbow.TextAppearance.Body4"/>
        <TextView
            android:textColor="@color/s2"
            android:id="@+id/tv_vo2max_update_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/vo2max_update_time"
            style="@style/Rainbow.TextAppearance.Body5"/>
        <FrameLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">
            <com.huami.watch.companion.firstbeat.DialView
                android:layout_gravity="center_horizontal"
                android:id="@+id/dv_vo2max"
                android:layout_width="195dp"
                android:layout_height="wrap_content"
                app:dv_stroke_width="13.3dp"/>
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="50dp">
                <com.huami.watch.companion.ui.view.HuaMiFontTextView
                    android:textSize="48sp"
                    android:textColor="@color/s1"
                    android:id="@+id/tv_vo2max_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/empty_value"
                    style="@style/Rainbow.TextAppearance.Number1"/>
                <TextView
                    android:textColor="@color/s2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/vo2max_unit"
                    style="@style/Rainbow.TextAppearance.Body5"/>
                <TextView
                    android:textStyle="bold"
                    android:textColor="@color/s1"
                    android:id="@+id/tv_vo2max_level"
                    android:visibility="invisible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/empty_value"
                    style="@style/Rainbow.TextAppearance.Body1"/>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</RelativeLayout>
