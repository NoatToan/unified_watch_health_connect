<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/s36"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="20sp"
        android:textColor="@color/s1"
        android:gravity="center"
        android:id="@+id/fw_failed_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="98dp"
        android:text="@string/fw_failed_title"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/s2"
        android:gravity="center"
        android:id="@+id/fw_failed_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:text="@string/fw_failed_tips"
        android:layout_below="@+id/fw_failed_title"
        android:layout_centerHorizontal="true"/>
    <com.huami.lib.view.progress.ProgressView
        android:id="@+id/bind_chart"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_marginTop="82dp"
        android:src="@drawable/img_dfu"
        android:progress="100"
        android:layout_below="@+id/fw_failed_tips"
        android:layout_centerHorizontal="true"
        app:backgroundColor="@color/s4"
        app:progressColor="@color/s14"
        app:strokeWidth="1.8dp"
        app:style="cycle"/>
    <TextView
        android:textSize="@dimen/size_14sp"
        android:textColor="@color/s14"
        android:gravity="center"
        android:id="@+id/fw_upgrade_log"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="291dp"
        android:text="@string/fw_upgrade_log"
        android:layout_below="@+id/fw_failed_tips"/>
    <ImageView
        android:id="@+id/phone_img"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="82dp"
        android:src="@drawable/img_phone"
        android:layout_below="@+id/fw_failed_tips"
        android:layout_centerHorizontal="true"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/bluetooth_img"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="136dp"
        android:src="@drawable/img_bluetooth"
        android:tint="@color/s3"
        android:layout_below="@+id/fw_failed_tips"
        android:layout_centerHorizontal="true"/>
    <ImageView
        android:id="@+id/accept_img"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="118dp"
        android:src="@drawable/img_accept"
        android:layout_below="@+id/fw_failed_tips"
        android:layout_marginStart="192dp"/>
    <include
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        layout="@layout/device_layout_bottom_common_btn"/>
</RelativeLayout>
