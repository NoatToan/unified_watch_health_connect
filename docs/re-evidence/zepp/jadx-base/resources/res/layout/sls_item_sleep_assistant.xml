<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="209dp"
    android:layout_height="329dp">
    <ImageView
        android:id="@+id/item_background"
        android:background="@drawable/sls_sleep_item_bg"
        android:layout_width="209dp"
        android:layout_height="329dp"
        android:contentDescription="@string/app_name"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/item_icon"
        android:background="@drawable/sls_sleep_item_icon"
        android:layout_width="31dp"
        android:layout_height="31dp"
        android:layout_marginTop="19dp"
        android:contentDescription="@string/app_name"
        android:layout_marginStart="23dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="23sp"
        android:textColor="@color/white100"
        android:ellipsize="end"
        android:id="@+id/item_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="29dp"
        android:singleLine="true"
        android:fontFamily="lt-bold"
        android:layout_marginStart="23dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/item_icon"/>
    <com.huami.widget.typeface.TypefaceTextView
        android:textSize="15sp"
        android:textColor="@color/white100"
        android:ellipsize="end"
        android:id="@+id/item_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="lt"
        android:layout_marginStart="23dp"
        android:layout_marginEnd="15dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/item_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
