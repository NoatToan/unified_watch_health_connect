<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout-large-port/activity_indoor_running_0"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/common_list"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/view_indoor_sport"/>
    <include
        android:id="@+id/running_posture_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_40dp"
        android:layout_marginHorizontal="@dimen/page_content_padding_horizontal_large"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/common_list"
        layout="@layout/view_out_sport_data_realtime_running_posture"/>
    <com.xiaomi.fitness.sport.view.widget.SportCommandView
        android:id="@+id/sport_command_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.airbnb.lottie.LottieAnimationView
        android:layout_gravity="center"
        android:id="@+id/lottie"
        android:background="@color/common_white"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:lottie_fileName="lottie/countdown_white.json"/>
</androidx.constraintlayout.widget.ConstraintLayout>
