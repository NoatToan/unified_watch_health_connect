<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout-port/activity_indoor_running_0"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:fitsSystemWindows="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/sport_command_view"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.core.widget.NestedScrollView
            android:paddingBottom="70dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/common_data_layout"
                android:tag="binding_1"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <include
                    android:id="@+id/view_indoor_sport"
                    app:layout_constraintTop_toTopOf="parent"
                    layout="@layout/view_indoor_sport"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
        <androidx.core.widget.NestedScrollView
            android:id="@+id/bottom_sheet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            app:behavior_fitToContents="false"
            app:behavior_peekHeight="70dp"
            app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/realtime_running_posture_layout"
                android:tag="binding_2"
                android:background="@color/page_white_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/scroll_trigger_view"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="@dimen/dimen_margin_30dp"
                    app:layout_constraintTop_toTopOf="parent">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:orientation="vertical"
                        android:id="@+id/container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <ImageView
                            android:id="@+id/arrow_up"
                            android:background="@drawable/sport_ic_arrow_up"
                            android:layout_width="@dimen/dimen_margin_14dp"
                            android:layout_height="@dimen/dimen_margin_14dp"
                            android:importantForAccessibility="no"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <TextView
                            android:textSize="11dp"
                            android:textColor="@color/text_color_30"
                            android:gravity="center"
                            android:layout_gravity="center_horizontal"
                            android:id="@+id/scroll_trigger"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/sport_scroll_up_to_check_realtime_running_posture"
                            app:layout_constraintTop_toBottomOf="@+id/arrow_up"
                            style="@style/FontRegular"/>
                        <ImageView
                            android:id="@+id/arrow_down"
                            android:background="@drawable/sport_ic_arrow_down"
                            android:visibility="gone"
                            android:layout_width="@dimen/dimen_margin_14dp"
                            android:layout_height="@dimen/dimen_margin_14dp"
                            android:importantForAccessibility="no"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/scroll_trigger"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <TextView
                    android:textSize="30sp"
                    android:id="@+id/realtime_running_posture_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sport_realtime_running_posture"
                    android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/scroll_trigger_view"
                    style="@style/FontMedium"/>
                <ImageView
                    android:id="@+id/landing_style_iv"
                    android:background="@color/page_white_bg"
                    android:layout_width="@dimen/size_306"
                    android:layout_height="243dp"
                    android:layout_marginTop="@dimen/dimen_margin_25dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/realtime_running_posture_title"/>
                <include
                    android:id="@+id/running_posture_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_margin_40dp"
                    android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/landing_style_iv"
                    layout="@layout/view_out_sport_data_realtime_running_posture"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <com.xiaomi.fitness.sport.view.widget.SportCommandView
        android:id="@+id/sport_command_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.airbnb.lottie.LottieAnimationView
        android:layout_gravity="center"
        android:id="@+id/lottie"
        android:background="@color/common_white"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:lottie_fileName="lottie/countdown_white.json"/>
</androidx.constraintlayout.widget.ConstraintLayout>
