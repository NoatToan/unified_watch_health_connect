<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="BaseButton" parent="">
        <item name="android:textSize">@dimen/text_size_16</item>
        <item name="android:gravity">0x11</item>
        <item name="android:layout_gravity">0x1</item>
        <item name="android:paddingTop">@dimen/btn_padding_v</item>
        <item name="android:paddingBottom">@dimen/btn_padding_v</item>
        <item name="android:layout_width">@dimen/common_btn_single_line_width</item>
        <item name="android:layout_height">-2</item>
    </style>
    <style name="Button.FullWidth" parent="@style/Button">
        <item name="android:layout_gravity">0x1</item>
        <item name="android:layout_width">@dimen/common_btn_single_line_width</item>
        <item name="android:layout_marginStart">@dimen/login_size_26_67</item>
        <item name="android:layout_marginEnd">@dimen/login_size_2</item>
    </style>
    <style name="CommonBtn" parent="">
        <item name="android:textSize">@dimen/common_btn_text_size</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:gravity">0x11</item>
        <item name="android:layout_gravity">0x1</item>
        <item name="android:layout_width">@dimen/common_btn_single_line_width</item>
        <item name="android:layout_height">@dimen/common_btn_height</item>
        <item name="android:layout_marginBottom">@dimen/common_btn_margin</item>
        <item name="android:layout_marginStart">@dimen/common_btn_margin</item>
        <item name="android:layout_marginEnd">@dimen/common_btn_margin</item>
    </style>
    <style name="DeviceTabUnbindBtn" parent="@style/FontMedium.16sp">
        <item name="android:textColor">@color/device_unbind_btn_text</item>
        <item name="android:gravity">0x11</item>
        <item name="android:layout_gravity">0x1</item>
        <item name="android:background">@drawable/device_selector_unbind_btn</item>
        <item name="android:layout_width">@dimen/common_btn_single_line_width</item>
        <item name="android:layout_height">@dimen/common_btn_height</item>
    </style>
    <style name="userinfo_Button.FullWidth" parent="@style/userinfo_Button">
        <item name="android:layout_gravity">0x1</item>
        <item name="android:layout_width">@dimen/common_btn_single_line_width</item>
        <item name="android:layout_marginStart">@dimen/userinfo_size_26_67</item>
        <item name="android:layout_marginEnd">@dimen/userinfo_size_26_67</item>
    </style>
</resources>
