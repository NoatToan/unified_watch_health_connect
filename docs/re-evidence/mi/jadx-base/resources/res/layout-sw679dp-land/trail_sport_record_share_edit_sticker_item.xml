<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/edit_drawable_item"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:background="@drawable/share_card_item_bg_dis_pressed"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_centerInParent="true"
        android:layout_marginHorizontal="@dimen/dimen_margin_5dp"
        android:layout_marginVertical="@dimen/dimen_margin_5dp">
        <FrameLayout
            android:id="@+id/edit_view"
            android:paddingTop="@dimen/margin_10dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="@dimen/dimen_margin_10dp"/>
        <ImageView
            android:background="@drawable/sport_share_customize_shape_card_bg_normal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ImageView
            android:gravity="center"
            android:id="@+id/drawable_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"/>
    </RelativeLayout>
</RelativeLayout>
