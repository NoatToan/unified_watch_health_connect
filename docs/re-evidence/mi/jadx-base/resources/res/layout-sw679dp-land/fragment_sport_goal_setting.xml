<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/linear_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="2"
        app:layout_constraintBottom_toTopOf="@+id/startSport"
        app:layout_constraintTop_toTopOf="parent">
        <RelativeLayout
            android:layout_gravity="center_vertical"
            android:id="@+id/target_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:layout_constraintStart_toStartOf="parent">
            <TextView
                android:textSize="60sp"
                android:id="@+id/target"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="300dp"
                android:maxLines="1"
                android:layout_centerInParent="true"
                android:autoSizeTextType="uniform"
                style="@style/FontLatinSemiBold"/>
            <TextView
                android:textSize="@dimen/dimen_20sp"
                android:id="@+id/goal_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignBaseline="@+id/target"
                android:layout_toEndOf="@+id/target"
                style="@style/FontLatinSemiBold"/>
        </RelativeLayout>
        <com.xiaomi.fitness.sport.baseui.SportNumberPicker
            android:textSize="43sp"
            android:layout_gravity="center_vertical"
            android:id="@+id/goalValuePicker"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </LinearLayout>
    <com.xiaomi.fitness.widget.view.DividerView
        android:id="@+id/dividerView"
        android:layout_width="1dp"
        android:layout_height="313.2969dp"
        app:isHorizontal="true"
        app:layout_constraintBottom_toBottomOf="@+id/linear_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/linear_layout"/>
    <TextView
        android:textSize="@dimen/text_size_18_67"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/startSport"
        android:background="@drawable/selector_bottom_btn_positive_bg"
        android:layout_width="@dimen/common_btn_single_line_width"
        android:layout_height="46.7dp"
        android:layout_marginBottom="30dp"
        android:text="@string/sport_go_sport"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_goneMarginStart="20dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
