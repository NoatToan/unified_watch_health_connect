<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout-sw679dp-land/adapter_running_route_recommend_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minWidth="217.3dp"
    android:minHeight="100dp">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/bg"
        android:background="@drawable/ic_running_route_recommend_card_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:shapeAppearance="@style/RoundedStyle"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:id="@+id/group"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_margin_14dp"
        android:layout_marginEnd="@dimen/dimen_margin_10dp"
        android:paddingVertical="@dimen/dimen_margin_13dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/routeBg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="16dp"
            android:textColor="@color/black"
            android:gravity="start"
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:fontFamily="@font/misanslatin_semibold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="20dp"
            android:textColor="@color/black"
            android:gravity="start"
            android:id="@+id/route_length"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/misanslatin_demibold"
            app:layout_constraintStart_toStartOf="@+id/name"
            app:layout_constraintTop_toBottomOf="@+id/name"/>
        <TextView
            android:textSize="10.67dp"
            android:textColor="@color/black"
            android:id="@+id/unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            android:layout_marginStart="2dp"
            app:layout_constraintBottom_toBottomOf="@+id/route_length"
            app:layout_constraintStart_toEndOf="@+id/route_length"/>
        <TextView
            android:textSize="10.67dp"
            android:textColor="@color/sport_color_08c59A"
            android:gravity="center"
            android:id="@+id/routeType"
            android:background="@drawable/shape_e0f4ee"
            android:layout_width="54.6dp"
            android:layout_height="18.66dp"
            android:layout_marginTop="2dp"
            app:layout_constraintStart_toStartOf="@+id/name"
            app:layout_constraintTop_toBottomOf="@+id/route_length"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/routeBg"
        android:layout_width="73.3dp"
        android:layout_height="73.3dp"
        android:layout_marginEnd="@dimen/dimen_margin_14dp"
        android:layout_marginVertical="@dimen/dimen_margin_13dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
