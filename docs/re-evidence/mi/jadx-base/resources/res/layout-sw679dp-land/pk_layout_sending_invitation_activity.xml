<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:tag="layout-sw679dp-land/pk_layout_sending_invitation_activity_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/page_padding_horizontal_large">
    <RelativeLayout
        android:id="@+id/network_connected"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:id="@+id/pictures"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.xiaomi.fitness.health.threetarget.model.ThreeTargetView
                android:id="@+id/rainbow"
                android:layout_width="267dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="64dp"
                android:layout_centerHorizontal="true"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/character_view"
                android:background="@drawable/ic_active_female"
                android:layout_width="94dp"
                android:layout_height="203dp"
                android:layout_marginTop="@dimen/size_13_3"
                android:layout_marginEnd="62dp"
                android:layout_alignEnd="@+id/rainbow"/>
        </RelativeLayout>
        <TextView
            android:textColor="@color/pk_text_color"
            android:gravity="center"
            android:id="@+id/pk_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="13.3dp"
            android:text="@string/pk_lets_pk_with_friends"
            android:layout_below="@+id/pictures"
            android:layout_centerHorizontal="true"
            style="@style/FontMedium.20sp"/>
        <TextView
            android:textSize="@dimen/text_size_12"
            android:textColor="@color/pk_subtitle_text"
            android:id="@+id/tv_recommended_friends"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pk_recommended_friends"
            android:layout_above="@+id/friends_recommended_recycler_view"
            android:fontFamily="@font/misanslatin_regular"
            android:layout_marginStart="11dp"
            android:layout_alignStart="@+id/friends_recommended_recycler_view"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/friends_recommended_recycler_view"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14.67dp"
            android:layout_marginBottom="14.3dp"
            android:layout_above="@+id/divider"
            android:layout_centerHorizontal="true"/>
        <com.xiaomi.fitness.widget.view.DividerView
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:layout_above="@+id/instruction"
            android:layout_marginHorizontal="11dp"/>
        <TextView
            android:textColor="#999999"
            android:gravity="center_horizontal"
            android:id="@+id/instruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="93.33dp"
            android:text="@string/pk_start_instruction"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginHorizontal="11dp"
            style="@style/FontRegular.12sp"/>
        <Button
            android:textColor="@color/white"
            android:id="@+id/btn_invite_friends"
            android:background="@drawable/selector_bottom_btn_positive_bg"
            android:layout_width="@dimen/common_btn_single_line_width"
            android:layout_height="46.67dp"
            android:layout_marginBottom="26.67dp"
            android:text="@string/pk_invite_friends"
            android:layout_alignParentBottom="true"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/pk_no_network_text_color"
        android:id="@+id/no_network"
        android:visibility="gone"
        android:layout_width="100dp"
        android:layout_height="150dp"
        android:text="@string/pk_network_connection_failed_tip"
        android:drawableTop="@drawable/icon_no_network"
        android:layout_centerInParent="true"/>
</RelativeLayout>
