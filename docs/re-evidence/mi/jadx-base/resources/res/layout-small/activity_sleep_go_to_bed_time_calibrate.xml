<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout-small/activity_sleep_go_to_bed_time_calibrate_0"
    android:background="@color/page_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/duration_group"
        android:background="@drawable/shape_card_bg_normal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_20dp"
        android:layout_marginHorizontal="@dimen/page_padding_horizontal_large"
        android:paddingHorizontal="@dimen/page_extra_padding_horizontal_large"
        android:paddingVertical="@dimen/dimen_margin_16dp"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textColor="@color/text_color"
            android:id="@+id/duration_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/health_sleep_go_to_bed_time"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/FontMedium.16sp"/>
        <TextView
            android:textColor="@color/text_color_40"
            android:gravity="end"
            android:id="@+id/duration_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/duration_label"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/FontRegular.14sp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/button"
        app:layout_constraintTop_toBottomOf="@+id/duration_group">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bed_wake_card"
            android:background="@drawable/shape_card_bg_normal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_12dp"
            android:layout_marginHorizontal="@dimen/page_padding_horizontal_large"
            android:paddingHorizontal="@dimen/dimen_margin_12dp"
            android:paddingVertical="18dp">
            <TextView
                android:textColor="@color/text_color"
                android:id="@+id/enter_sleep_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/enter_sleep_time"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/FontDemiBold.16sp"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_20dp"
                app:layout_constraintTop_toBottomOf="@+id/enter_sleep_time">
                <androidx.cardview.widget.CardView
                    android:id="@+id/go_to_bed_time_card"
                    android:tag="binding_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:foreground="@null"
                    app:cardCornerRadius="@dimen/size_15_3"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/CardView.Default">
                    <include
                        android:id="@+id/go_to_bed_layout"
                        layout="@layout/layout_edit_sleep_record"/>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView
                    android:id="@+id/wakeup_time_card"
                    android:tag="binding_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_margin_12dp"
                    android:foreground="@null"
                    app:cardCornerRadius="@dimen/size_15_3"
                    app:layout_constraintStart_toEndOf="@+id/go_to_bed_time_card"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/CardView.Default">
                    <include
                        android:id="@+id/leave_bed_layout"
                        layout="@layout/layout_edit_sleep_record"/>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <TextView
        android:textSize="17.42sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/button"
        android:background="@drawable/selector_bottom_btn_positive_bg"
        android:layout_width="@dimen/common_btn_single_line_width"
        android:layout_height="@dimen/common_btn_height"
        android:layout_marginBottom="26.67dp"
        android:text="@string/confirm"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
