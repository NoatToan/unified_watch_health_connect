<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout-small/health_activity_share_calo_consum_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/bgContainnerView"
        android:paddingBottom="@dimen/dimen_margin_20dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="@dimen/page_content_padding_horizontal_large">
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/share_area"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/food_bg"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    app:layout_constraintDimensionRatio="H, 1:1.55"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/bgView"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/dimen_margin_20dp"
                    android:paddingHorizontal="@dimen/dimen_margin_20dp"
                    app:layout_constraintBottom_toBottomOf="@+id/food_bg"
                    app:layout_constraintTop_toTopOf="@+id/food_bg">
                    <com.xiaomi.fitness.health.threetarget.view.ShareAccountInfoView
                        android:id="@+id/accountInfoView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="20sp"
                        android:textColor="@color/black"
                        android:id="@+id/stepView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/size_8"
                        android:fontFamily="@font/misanslatin_medium"
                        app:layout_constraintStart_toStartOf="@+id/accountInfoView"
                        app:layout_constraintTop_toBottomOf="@+id/accountInfoView"/>
                    <TextView
                        android:textSize="32sp"
                        android:textColor="@color/black"
                        android:id="@+id/caloView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/size_5"
                        app:layout_constraintStart_toStartOf="@+id/accountInfoView"
                        app:layout_constraintTop_toBottomOf="@+id/stepView"
                        style="@style/FontLatinDemiBold"/>
                    <TextView
                        android:textSize="32sp"
                        android:textColor="@color/black"
                        android:id="@+id/thingView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/size_2"
                        app:layout_constraintStart_toStartOf="@+id/accountInfoView"
                        app:layout_constraintTop_toBottomOf="@+id/caloView"
                        style="@style/FontLatinDemiBold"/>
                    <ImageView
                        android:id="@+id/logoView"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginBottom="@dimen/dimen_margin_20dp"
                        android:src="@drawable/icon_share_calo_consum"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/black"
                        android:gravity="center_vertical"
                        android:id="@+id/nameView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:fontFamily="@font/misanslatin_regular"
                        android:layout_marginStart="@dimen/size_5"
                        app:layout_constraintBottom_toBottomOf="@+id/logoView"
                        app:layout_constraintStart_toEndOf="@+id/logoView"
                        app:layout_constraintTop_toTopOf="@+id/logoView"/>
                    <ImageView
                        android:id="@+id/qr_code"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginBottom="@dimen/dimen_margin_16dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/bottomView"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include
            android:id="@+id/shareContannerView"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            layout="@layout/health_view_share_bottom_operation_view"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/btnContainnerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.xiaomi.fitness.widget.SingleLineMarqueeableTextView
                android:layout_gravity="center_horizontal"
                android:id="@+id/sportTargetView"
                android:layout_width="0dp"
                android:layout_height="@dimen/common_btn_height"
                android:text="@string/health_goto_sport_target"
                android:layout_weight="1"
                android:layout_marginEnd="0dp"
                android:paddingHorizontal="@dimen/dimen_margin_30dp"
                style="@style/CommonBtn.DarkTheme"/>
            <com.xiaomi.fitness.widget.SingleLineMarqueeableTextView
                android:layout_gravity="center_horizontal"
                android:id="@+id/shareView"
                android:layout_width="0dp"
                android:layout_height="@dimen/common_btn_height"
                android:text="@string/web_share"
                android:layout_weight="1"
                android:paddingHorizontal="@dimen/dimen_margin_30dp"
                style="@style/CommonBtn.Primary"/>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
