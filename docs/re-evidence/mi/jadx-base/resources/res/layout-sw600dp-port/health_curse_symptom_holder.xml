<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/icon"
        android:tag="layout-sw600dp-port/health_curse_symptom_holder_0"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:src="@drawable/health_curse_symptom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/text_color"
        android:id="@+id/recordLabel"
        android:tag="layout-sw600dp-port/health_curse_symptom_holder_1"
        android:text="@string/health_curse_symptom"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toTopOf="@+id/recordPeriodView"
        app:layout_constraintStart_toEndOf="@+id/icon"
        app:layout_constraintTop_toTopOf="@+id/icon"
        style="@style/HealthCurseTitle"/>
    <TextView
        android:id="@+id/recordPeriodView"
        android:tag="layout-sw600dp-port/health_curse_symptom_holder_2"
        android:text="@string/health_curse_state_tip"
        app:layout_constraintBottom_toBottomOf="@+id/icon"
        app:layout_constraintStart_toStartOf="@+id/recordLabel"
        app:layout_constraintTop_toBottomOf="@+id/recordLabel"
        style="@style/HealthCurseDesc"/>
    <com.xiaomi.fitness.widget.view.DividerView
        android:id="@+id/divider"
        android:tag="layout-sw600dp-port/health_curse_symptom_holder_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@+id/icon"/>
    <com.xiaomi.fitness.health.curse.view.SymptomSelectView
        android:id="@+id/symHurtView"
        android:tag="layout-sw600dp-port/health_curse_symptom_holder_4"
        android:layout_marginTop="10dp"
        app:healthSymptomType="hurt"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/guideLine"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider"
        style="@style/HealthSymptom"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideLine"
        android:tag="layout-sw600dp-port/health_curse_symptom_holder_5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <com.xiaomi.fitness.health.curse.view.SymptomSelectView
        android:id="@+id/symBloodView"
        android:tag="layout-sw600dp-port/health_curse_symptom_holder_6"
        android:layout_marginTop="10dp"
        app:healthSymptomType="blood"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/guideLine"
        app:layout_constraintTop_toBottomOf="@+id/divider"
        style="@style/HealthSymptom"/>
    <com.xiaomi.fitness.health.curse.view.SymptomSelectView
        android:id="@+id/symMotionView"
        android:tag="layout-sw600dp-port/health_curse_symptom_holder_7"
        app:healthSymptomType="motion"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/guideLine"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/symHurtView"
        style="@style/HealthSymptom"/>
</merge>
