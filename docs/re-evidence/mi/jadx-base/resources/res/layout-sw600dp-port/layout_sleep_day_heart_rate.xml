<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_sleep_day_heart_rate"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include
        android:id="@+id/divide_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/layout_division_line"/>
    <include
        android:id="@+id/top_bar_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_20"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divide_line"
        layout="@layout/layout_common_icon_title"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.3"/>
    <com.xiaomi.fitness.view.DataTitleView
        android:id="@+id/dataTitleView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_8"
        android:layout_marginStart="@dimen/health_card_data_title_margin_start"
        app:layout_constraintBottom_toBottomOf="@+id/line_recycler"
        app:layout_constraintEnd_toEndOf="@+id/guideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_bar_title"/>
    <com.xiaomi.fitness.chart.view.BarChartRecyclerView
        android:id="@+id/line_recycler"
        android:paddingTop="79.6dp"
        android:layout_width="0dp"
        android:layout_height="311dp"
        android:paddingStart="0dp"
        android:paddingEnd="31dp"
        app:barChartMaxWidth="@dimen/size_5"
        app:barChartRoundRectRadiusRatio="0.03"
        app:barChartSegment="1"
        app:chartColor="@color/health_hrm_chart"
        app:contentPaddingBottom="31.3dp"
        app:enableEndDayXAxis="true"
        app:enableStartYAxisLabel="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/guideline"
        app:layout_constraintTop_toTopOf="@+id/top_bar_title"
        app:rateChartDarkColor="@color/fitness_pai_chart"
        style="@style/ChartBaseStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
