<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_sleep_snore_dream_talk"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include
        android:id="@+id/divide_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/layout_division_line"/>
    <TextView
        android:textColor="@color/text_color"
        android:layout_gravity="center_vertical"
        android:id="@+id/tv_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_30"
        android:layout_marginStart="@dimen/size_18"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divide_line"
        style="@style/FontMedium.16sp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.3"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/tv_empty_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_8"
        android:layout_marginStart="@dimen/size_18"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_label">
        <TextView
            android:textSize="@dimen/font_24"
            android:textColor="@color/text_color"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_12"
            android:text="@string/common_data_empty"
            style="@style/FontMedium"/>
        <TextView
            android:textColor="@color/text_color_40"
            android:id="@+id/empty_txt_click"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_12"
            android:layout_marginBottom="@dimen/dimen_margin_20dp"
            android:text="@string/health_sleep_snore_dream_talk_title_desc"
            android:drawablePadding="2dp"
            app:drawableRightCompat="@drawable/arrow_right"/>
    </LinearLayout>
    <com.xiaomi.fitness.view.DataTitleView
        android:id="@+id/snore_data_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_8"
        android:layout_marginStart="@dimen/health_card_data_title_margin_start"
        app:layout_constraintBottom_toBottomOf="@+id/snore_bar_recycler"
        app:layout_constraintEnd_toEndOf="@+id/guideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_label"/>
    <com.xiaomi.fitness.chart.view.BarChartRecyclerView
        android:id="@+id/snore_bar_recycler"
        android:paddingTop="75.6dp"
        android:layout_width="0dp"
        android:layout_height="307dp"
        android:paddingStart="0dp"
        android:paddingEnd="@dimen/size_18"
        app:barChartRoundRectRadiusRatio="0.25"
        app:chartColor="@color/sleep_snore_chart_color"
        app:contentPaddingBottom="31.3dp"
        app:displayNumbers="48"
        app:enableEndYAxisLabel="false"
        app:enableStartYAxisLabel="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/guideline"
        app:layout_constraintTop_toTopOf="@+id/tv_label"
        style="@style/BarChartRecyclerViewStyle"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/snore_bar_recycler">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/snore_dream_talk_recyclerview"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
