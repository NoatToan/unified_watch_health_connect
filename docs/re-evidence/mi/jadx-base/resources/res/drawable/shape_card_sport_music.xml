<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#99d8ffe8"
                android:endColor="#99d5fcff"
                android:angle="360"/>
            <stroke
                android:width="0.5dp"
                android:color="#afefea"/>
            <corners android:radius="14dp"/>
        </shape>
    </item>
</layer-list>
