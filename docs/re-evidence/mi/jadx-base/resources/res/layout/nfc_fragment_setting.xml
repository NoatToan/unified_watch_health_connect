<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/layoutView"
    android:tag="layout/nfc_fragment_setting_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/page_content_padding_horizontal_large"
    android:paddingEnd="@dimen/page_content_padding_horizontal_large">
    <com.xiaomi.fitness.nfc.widget.SetRightArrowView
        android:id="@+id/returnCardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:nfc_arrow_desShow="false"
        app:nfc_arrow_lineShow="false"
        app:nfc_arrow_name="@string/nfc_retrun_card_query_list"/>
    <com.xiaomi.fitness.nfc.widget.SetRightArrowView
        android:id="@+id/autoSwitchCardView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:nfc_arrow_desShow="false"
        app:nfc_arrow_lineShow="false"
        app:nfc_arrow_name="@string/nfc_auto_switch_card"/>
    <com.xiaomi.fitness.widget.SwitchButtonTwoLineTextView
        android:id="@+id/backupDoorView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:subtitle="@string/nfc_backup_door_switch_desc"
        app:title="@string/nfc_backup_door_switch_title"/>
    <View
        android:background="@color/common_divider_line"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"/>
    <com.xiaomi.fitness.nfc.widget.SetRightArrowView
        android:id="@+id/syncView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:nfc_arrow_desShow="false"
        app:nfc_arrow_lineShow="false"
        app:nfc_arrow_name="@string/nfc_syncese_title_global"/>
    <com.xiaomi.fitness.nfc.widget.SetRightArrowView
        android:id="@+id/faqView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:nfc_arrow_desShow="false"
        app:nfc_arrow_lineShow="false"
        app:nfc_arrow_name="@string/nfc_card_detail_more_settings_help"/>
</LinearLayout>
