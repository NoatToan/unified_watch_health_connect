<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="16.7dp"
        android:textColor="@color/sport_color_black"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sport_phone_plaec"
        android:fontFamily="@font/misanslatin_heavy"
        android:paddingStart="@dimen/margin_40dp"
        android:paddingEnd="@dimen/margin_40dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/about_font_12"
        android:textColor="@color/sport_color_8C93B0"
        android:id="@+id/recommend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/sport_recommended_use"
        android:layout_marginStart="40dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <TextView
        android:textSize="14.5dp"
        android:textColor="@color/sport_color_black"
        android:gravity="center_vertical"
        android:id="@+id/arm_bag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_17dp"
        android:text="@string/sport_arm_bag"
        android:drawablePadding="8dp"
        android:drawableStart="@drawable/sport_ic_sport_check"
        android:fontFamily="@font/misanslatin_heavy"
        app:layout_constraintStart_toStartOf="@+id/recommend"
        app:layout_constraintTop_toBottomOf="@+id/recommend"/>
    <TextView
        android:textSize="14.5dp"
        android:textColor="@color/sport_color_black"
        android:gravity="center_vertical"
        android:id="@+id/waist_bag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_17dp"
        android:text="@string/sport_waist_bag"
        android:drawablePadding="8dp"
        android:drawableStart="@drawable/sport_ic_sport_check"
        android:fontFamily="@font/misanslatin_heavy"
        app:layout_constraintStart_toStartOf="@+id/arm_bag"
        app:layout_constraintTop_toBottomOf="@+id/arm_bag"/>
    <TextView
        android:textSize="14.5dp"
        android:textColor="@color/sport_color_black"
        android:gravity="center_vertical"
        android:id="@+id/hand_bag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_17dp"
        android:text="@string/sport_hand_phone"
        android:drawablePadding="8dp"
        android:drawableStart="@drawable/sport_ic_sport_check"
        android:fontFamily="@font/misanslatin_heavy"
        app:layout_constraintStart_toStartOf="@+id/waist_bag"
        app:layout_constraintTop_toBottomOf="@+id/waist_bag"/>
    <View
        android:id="@+id/line"
        android:background="@color/black_10_transparent"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/hand_bag"/>
    <TextView
        android:textSize="@dimen/about_font_12"
        android:textColor="@color/sport_color_8C93B0"
        android:id="@+id/avoid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/sport_avoid"
        android:layout_marginStart="40dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/line"/>
    <TextView
        android:textSize="14.5dp"
        android:textColor="@color/sport_color_black"
        android:gravity="center_vertical"
        android:id="@+id/gym"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_17dp"
        android:text="@string/sport_gym"
        android:drawablePadding="8dp"
        android:drawableStart="@drawable/sport_ic_sport_also"
        android:fontFamily="@font/misanslatin_heavy"
        app:layout_constraintStart_toStartOf="@+id/avoid"
        app:layout_constraintTop_toBottomOf="@+id/avoid"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/sport_color_black"
        android:gravity="center"
        android:id="@+id/know_btn"
        android:background="@drawable/sport_shape_0f000000"
        android:layout_width="0dp"
        android:layout_height="46dp"
        android:layout_marginTop="35.3dp"
        android:text="@string/common_known"
        android:fontFamily="@font/misanslatin_heavy"
        android:layout_marginStart="26.6dp"
        android:layout_marginEnd="26.6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gym"/>
    <TextView
        android:visibility="gone"
        android:layout_width="1dp"
        android:layout_height="26.7dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/know_btn"/>
</androidx.constraintlayout.widget.ConstraintLayout>
