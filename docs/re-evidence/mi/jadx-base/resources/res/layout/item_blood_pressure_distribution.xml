<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:tag="layout/item_blood_pressure_distribution_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/font_22"
        android:textColor="@color/text_color"
        android:id="@+id/tv_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/FontMedium"/>
    <TextView
        android:textColor="@color/text_color"
        android:id="@+id/tv_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="%"
        android:layout_alignBaseline="@+id/tv_value"
        android:layout_marginStart="@dimen/size_2"
        android:layout_toEndOf="@+id/tv_value"
        style="@style/FontMedium.12sp"/>
    <ImageView
        android:id="@+id/iv_color_shape"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_3"
        android:layout_below="@+id/tv_value"
        android:importantForAccessibility="no"/>
    <TextView
        android:textColor="@color/text_color_40"
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tv_value"
        android:layout_marginStart="@dimen/size_6"
        android:layout_toEndOf="@+id/iv_color_shape"
        style="@style/FontRegular.12sp"/>
    <ImageView
        android:id="@+id/iv_go"
        android:background="@drawable/ic_base_right_arrow_icon"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_4_6"
        android:layout_below="@+id/tv_value"
        android:importantForAccessibility="no"
        android:layout_marginStart="@dimen/size_6_7"
        android:layout_toEndOf="@+id/tv_status"/>
</RelativeLayout>
