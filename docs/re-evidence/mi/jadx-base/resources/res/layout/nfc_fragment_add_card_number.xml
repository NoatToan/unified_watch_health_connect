<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/nfc_fragment_add_card_number_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <miuix.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="@dimen/nfc_common_layout_padding"
            android:paddingEnd="@dimen/nfc_common_layout_padding">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/card_info_view"
                android:background="@drawable/nfc_add_card_bg"
                android:padding="26dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/dimen_margin_200dp">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="19sp"
                    android:textColor="@color/white"
                    android:id="@+id/card_info_bank_name_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nfc_add_bank_name"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="19sp"
                    android:textColor="@color/white"
                    android:id="@+id/card_info_card_number_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="3dp"
                    android:text="@string/nfc_add_card_number"
                    app:layout_constraintBottom_toTopOf="@+id/card_info_card_time_tv"
                    app:layout_constraintStart_toStartOf="parent"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:id="@+id/card_info_card_time_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="3dp"
                    android:text="@string/nfc_add_card_time"
                    app:layout_constraintBottom_toTopOf="@+id/card_info_card_hold_name_tv"
                    app:layout_constraintStart_toStartOf="parent"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:id="@+id/card_info_card_hold_name_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nfc_add_cardholder_name"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/supportCardListContainnerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:layout_below="@+id/safeView">
                <TextView
                    android:textSize="11sp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/nfc_bind_bank_card_num_title_normal_new"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/text_color"
                    android:autoLink="all"
                    android:id="@+id/supportBankList"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardNumberRootView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:layout_below="@+id/supportCardListContainnerView">
                <miuix.androidbasewidget.widget.EditText
                    android:textSize="16sp"
                    android:textColor="@color/text_color"
                    android:textColorHint="@color/nfc_safe_keyboard_hint_txt_color"
                    android:id="@+id/cardNumberView"
                    android:background="@null"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/nfc_bind_bank_card_num_hint_global"
                    android:cursorVisible="true"
                    android:singleLine="true"
                    android:inputType="number"
                    android:textDirection="locale"
                    android:textAlignment="viewStart"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/add_card_visa_mark_icon"
                    android:background="@drawable/add_card_visa_mark_icon"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="@+id/cardNumberView"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/cardNumberView"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:textSize="12sp"
                android:id="@+id/alertView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/nfc_unionpay_show_msg"
                android:layout_below="@+id/cardNumberRootView"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/masterProperView"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:layout_below="@+id/cardNumberRootView">
                <TextView
                    android:textSize="11sp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/nfc_card_holder_name"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <miuix.androidbasewidget.widget.EditText
                        android:textSize="16sp"
                        android:textColor="@color/text_color"
                        android:textColorHint="@color/nfc_safe_keyboard_hint_txt_color"
                        android:id="@+id/ownerNameView"
                        android:background="@null"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:hint="@string/nfc_open_card_holder_name"
                        android:cursorVisible="true"
                        android:singleLine="true"
                        android:maxLength="50"
                        android:layout_weight="1"
                        android:textDirection="locale"
                        android:textAlignment="viewStart"/>
                    <ImageView
                        android:id="@+id/ownerNameHelperView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/cnv2_helper"/>
                </LinearLayout>
                <TextView
                    android:textSize="11sp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="17dp"
                    android:text="@string/nfc_bind_bank_card_valid_title_global"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <miuix.androidbasewidget.widget.EditText
                        android:textSize="16sp"
                        android:textColor="@color/text_color"
                        android:textColorHint="#39000000"
                        android:id="@+id/validateView"
                        android:background="@null"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:hint="@string/nfc_bind_bank_card_valid_hint_global"
                        android:cursorVisible="true"
                        android:singleLine="true"
                        android:maxLength="5"
                        android:layout_weight="1"
                        android:inputType="number"
                        android:textDirection="locale"
                        android:textAlignment="viewStart"/>
                    <ImageView
                        android:id="@+id/validateHelperView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/cnv2_helper"/>
                </LinearLayout>
                <TextView
                    android:textSize="11sp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="17dp"
                    android:text="@string/nfc_add_card_security_code"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <miuix.androidbasewidget.widget.EditText
                        android:textSize="16sp"
                        android:textColor="@color/text_color"
                        android:textColorHint="#39000000"
                        android:id="@+id/nfc_add_card_security_code_et"
                        android:background="@null"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:hint="@string/nfc_add_card_security_code_limit"
                        android:cursorVisible="true"
                        android:singleLine="true"
                        android:maxLength="3"
                        android:layout_weight="1"
                        android:inputType="number"
                        android:textDirection="locale"
                        android:textAlignment="viewStart"/>
                    <ImageView
                        android:id="@+id/nfc_add_card_security_code_help"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/cnv2_helper"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </miuix.core.widget.NestedScrollView>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/protolView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="11dp"
        android:layout_centerInParent="true"
        android:paddingStart="@dimen/nfc_common_layout_padding"
        android:paddingEnd="@dimen/nfc_common_layout_padding"
        app:layout_constraintBottom_toTopOf="@+id/nextView"
        app:layout_constraintStart_toStartOf="parent">
        <CheckBox
            android:textSize="@dimen/nfc_tsm_text_size_content_small"
            android:gravity="center_vertical"
            android:id="@+id/checkView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false"
            android:button="@drawable/selector_check"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/text_color"
            android:autoLink="web"
            android:layout_gravity="center_vertical"
            android:id="@+id/protoView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"/>
    </LinearLayout>
    <TextView
        android:enabled="false"
        android:gravity="center"
        android:id="@+id/nextView"
        android:text="@string/nfc_common_step_next"
        android:layout_marginStart="@dimen/nfc_common_layout_padding"
        android:layout_marginEnd="@dimen/nfc_common_layout_padding"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/CommonBtn.Primary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
