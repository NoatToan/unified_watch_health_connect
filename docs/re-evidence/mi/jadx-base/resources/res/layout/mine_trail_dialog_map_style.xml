<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/size_30"
    android:paddingEnd="@dimen/size_30">
    <TextView
        android:textColor="@color/text_color"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/trail_sport_map_edit"
        style="@style/FontMedium.17sp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="120dp">
        <com.xiaomi.fitness.route.track.utils.MapStyleItemView
            android:layout_gravity="center"
            android:id="@+id/mapStyleItem1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <com.xiaomi.fitness.route.track.utils.MapStyleItemView
            android:layout_gravity="center"
            android:id="@+id/mapStyleItem2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <com.xiaomi.fitness.route.track.utils.MapStyleItemView
            android:layout_gravity="center"
            android:id="@+id/mapStyleItem3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/rlMailPoints"
        android:layout_width="match_parent"
        android:layout_height="60dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/trail_open_mail_points"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            style="@style/FontMedium.16sp"/>
        <com.xiaomi.fitness.widget.button.SwitchButton
            android:id="@+id/switchBtn"
            android:layout_width="@dimen/lib_sb_width"
            android:layout_height="@dimen/lib_sb_height"
            android:button="@drawable/checkbox_green"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</LinearLayout>
