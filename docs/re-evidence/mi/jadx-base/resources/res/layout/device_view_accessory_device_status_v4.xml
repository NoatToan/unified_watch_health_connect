<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/device_shape_setting_list_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/dimen_margin_8dp">
    <ImageView
        android:id="@+id/device_icon"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/device_settings_bean_preview"
        android:layout_marginStart="@dimen/dimen_margin_8dp"
        android:layout_marginVertical="@dimen/dimen_margin_10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="17sp"
        android:id="@+id/device_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_margin_4dp"
        android:text="@string/device_accessory_mode_running"
        app:layout_constraintBottom_toTopOf="@+id/device_status_msg"
        app:layout_constraintStart_toEndOf="@+id/device_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/FontDemiBold"/>
    <TextView
        android:id="@+id/device_status_msg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/device_icon"
        app:layout_constraintTop_toBottomOf="@+id/device_name"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/FontMedium.14sp"/>
    <TextView
        android:textColor="@color/colorPrimary"
        android:id="@+id/accessory_device_tv_synchronize"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/device_accessory_switch"
        android:layout_marginEnd="@dimen/dimen_margin_20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/FontDemiBold.14sp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
