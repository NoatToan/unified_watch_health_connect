<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:background="@drawable/shape_card_bg_normal"
    android:paddingTop="@dimen/dimen_margin_4dp"
    android:paddingBottom="@dimen/dimen_margin_8dp"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/dimen_margin_24dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/title_cl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/dimen_margin_14dp"
        android:paddingVertical="@dimen/dimen_margin_12dp"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textColor="@color/text_color_40"
            android:gravity="center_vertical"
            android:id="@+id/check_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sport_tab_all"
            android:drawablePadding="2dp"
            android:drawableEnd="@drawable/ic_right_arrow"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/FontMedium.14sp"/>
        <TextView
            android:textSize="17sp"
            android:textColor="@color/text_color"
            android:id="@+id/section_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/sport_sport_record"
            android:textAlignment="viewStart"
            app:layout_constraintBottom_toBottomOf="@+id/check_all"
            app:layout_constraintEnd_toStartOf="@+id/check_all"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/check_all"
            style="@style/FontDemiBold"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.xiaomi.fitness.widget.view.DividerView
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dimen_margin_14dp"
        app:layout_constraintTop_toBottomOf="@+id/title_cl"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/latest_sport_record_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/divider">
        <ImageView
            android:id="@+id/sport_icon"
            android:layout_width="@dimen/dimen_margin_40dp"
            android:layout_height="@dimen/dimen_margin_40dp"
            android:layout_marginStart="@dimen/dimen_margin_14dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/sport_detail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_margin_16dp"
            android:layout_marginEnd="@dimen/dimen_margin_14dp"
            android:paddingVertical="@dimen/dimen_margin_16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/sport_icon"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textColor="@color/text_color"
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textDirection="locale"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/FontMedium.16sp"/>
            <TextView
                android:textColor="@color/text_color_40"
                android:id="@+id/detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/title"
                style="@style/FontNormal.14sp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
