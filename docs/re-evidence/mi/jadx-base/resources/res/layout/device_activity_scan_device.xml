<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/device_cl_scan_device_root"
    android:tag="layout/device_activity_scan_device_0"
    android:background="@color/page_white_bg"
    android:paddingTop="@dimen/dimen_margin_20dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ViewStub
        android:id="@+id/device_vs_normal_scan_guide"
        android:tag="binding_1"
        android:layout="@layout/device_view_normal_scan_guide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ViewStub
        android:id="@+id/device_vs_huami_scan_guide"
        android:tag="binding_2"
        android:layout="@layout/device_view_huami_scan_guide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.xiaomi.fitness.device.manager.ui.scan.ScanningView
        android:id="@+id/device_sv_scanning"
        android:tag="binding_3"
        android:background="@drawable/selector_card_bg"
        android:paddingTop="@dimen/dimen_margin_20dp"
        android:paddingBottom="@dimen/dimen_margin_20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dimen_margin_23dp"
        android:paddingEnd="@dimen/dimen_margin_18dp"
        android:layout_marginStart="@dimen/device_add_device_margin_start"
        android:layout_marginEnd="@dimen/device_add_device_margin_start"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/device_fl_scan_content"
        android:tag="binding_4"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dimen_margin_12dp"
        android:layout_marginBottom="@dimen/dimen_margin_26dp"
        android:layout_marginStart="@dimen/device_add_device_margin_start"
        android:layout_marginEnd="@dimen/device_add_device_margin_end"
        app:layout_constraintBottom_toTopOf="@+id/device_tv_add_by_model"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/device_sv_scanning">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/device_rv_scan_device_list"
            android:tag="binding_5"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <TextView
        android:textColor="@color/text_color"
        android:id="@+id/device_tv_add_by_model"
        android:tag="binding_6"
        android:layout_marginBottom="@dimen/dimen_margin_20dp"
        android:text="@string/device_add_by_model"
        android:layout_marginHorizontal="@dimen/page_content_padding_horizontal_large"
        app:layout_constraintBottom_toTopOf="@+id/device_tv_scan_device_help"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/BaseButton.Native"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/device_lav_scan_device_scanning"
        android:tag="binding_7"
        android:layout_width="wrap_content"
        android:layout_height="25dp"
        android:layout_marginBottom="@dimen/dimen_margin_16dp"
        app:layout_constraintBottom_toTopOf="@+id/device_tv_scan_device_again"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:lottie_autoPlay="true"
        app:lottie_fileName="lottie/scanning.json"
        app:lottie_loop="true"/>
    <TextView
        android:id="@+id/device_tv_scan_device_again"
        android:tag="binding_8"
        android:layout_marginBottom="@dimen/dimen_margin_16dp"
        android:layout_marginHorizontal="@dimen/page_content_padding_horizontal_large"
        app:layout_constraintBottom_toTopOf="@+id/device_tv_scan_device_help"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/BaseButton.Positive"/>
    <TextView
        android:textColor="@color/device_link_color"
        android:id="@+id/device_tv_scan_device_help"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_margin_26dp"
        android:text="@string/device_search_help"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/FontMedium.12sp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
