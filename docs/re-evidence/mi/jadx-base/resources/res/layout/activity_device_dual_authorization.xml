<?xml version="1.0" encoding="utf-8"?>
<miuix.springback.view.SpringBackLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_device_dual_authorization_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:scrollableView="@+id/spring_back_target">
    <miuix.core.widget.NestedScrollView
        android:id="@+id/spring_back_target"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:background="@color/about_white"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="@dimen/page_content_padding_horizontal_large">
            <com.xiaomi.fitness.widget.SwitchButtonBindingTwoLineTextView
                android:id="@+id/dual_authorization"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:subtitle="@string/privacy_device_dual_authorization_subtitle"
                app:title="@string/privacy_device_dual_authorization_title"/>
            <View
                android:id="@+id/divider_line"
                android:background="@color/about_item_divide_color"
                android:layout_width="match_parent"
                android:layout_height="@dimen/about_item_divide_height"
                android:layout_marginTop="@dimen/about_size_20"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/text_color_40"
                android:id="@+id/tv_device_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_30dp"
                android:text="@string/privacy_device_list"
                android:fontFamily="@font/misanslatin_regular"
                android:paddingVertical="8dp"/>
            <androidx.recyclerview.widget.RecyclerView
                android:orientation="vertical"
                android:id="@+id/rv_device_list"
                android:tag="binding_1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
            <ImageView
                android:id="@+id/iv_empty"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_47dp"
                android:src="@drawable/icon_common_empty"
                android:scaleType="center"/>
            <TextView
                android:textSize="@dimen/dimen_14sp"
                android:textColor="@color/text_color_40"
                android:id="@+id/tv_empty"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_10dp"
                android:text="@string/privacy_no_device_dual_authorization"
                android:fontFamily="@font/misanslatin_regular"/>
        </LinearLayout>
    </miuix.core.widget.NestedScrollView>
</miuix.springback.view.SpringBackLayout>
