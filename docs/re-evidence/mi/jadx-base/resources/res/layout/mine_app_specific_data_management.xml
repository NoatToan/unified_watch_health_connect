<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/mine_app_specific_data_management_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textColor="@color/text_color_40"
            android:id="@+id/description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/page_content_padding_horizontal_large"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/FontRegular.14sp"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/dimen_margin_25dp"
            android:layout_marginHorizontal="@dimen/page_content_padding_horizontal_large"
            app:layout_constraintBottom_toTopOf="@+id/switch_all_on_or_off_btn"
            app:layout_constraintTop_toBottomOf="@+id/description"/>
        <TextView
            android:textColor="@color/text_color"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/switch_all_on_or_off_btn"
            android:background="@drawable/shape_bottom_btn_native_bg_pressed"
            android:layout_width="306.6641dp"
            android:layout_height="46.67dp"
            android:layout_marginTop="@dimen/dimen_margin_20dp"
            android:layout_marginBottom="26dp"
            android:text="@string/mine_switch_all_on"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/FontMedium.16sp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/mine_no_network_text_color"
        android:gravity="center_horizontal"
        android:id="@+id/no_network"
        android:visibility="gone"
        android:layout_width="100dp"
        android:layout_height="150dp"
        android:text="@string/mine_network_connection_failed"
        android:drawableTop="@drawable/icon_no_network"
        android:drawablePadding="@dimen/dimen_margin_10dp"
        android:layout_centerInParent="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
