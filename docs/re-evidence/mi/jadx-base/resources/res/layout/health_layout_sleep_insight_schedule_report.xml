<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/health_layout_sleep_insight_schedule_report_0"
    android:paddingBottom="@dimen/size_26"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/sleep_level_desc_recyclerview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16.3dp"
        android:text="@string/health_sleep_schedule_time"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sleep_level_desc_recyclerview"
        style="@style/HealthSleepAnimalReportTitle"/>
    <TextView
        android:id="@+id/tv_time_tag"
        app:layout_constraintBottom_toBottomOf="@+id/tv_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/tv_title"
        app:layout_constraintTop_toTopOf="@+id/tv_title"
        style="@style/HealthSleepAnimalReportImproved"/>
    <TextView
        android:id="@+id/tv_time_subtitle"
        android:drawableStart="@drawable/health_ic_sleep_schedule_time"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        style="@style/HealthSleepAnimalReportSubtitle"/>
    <TextView
        android:id="@+id/tv_schedule_time_desc"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_time_subtitle"
        style="@style/HealthSleepAnimalReportDesc"/>
    <com.xiaomi.fitness.chart.view.BarChartRecyclerView
        android:id="@+id/bar_recycler_view"
        android:layout_marginTop="@dimen/size_10"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_schedule_time_desc"
        style="@style/HealthSleepAnimalBarChartRecyclerStyle.SleepSchedule"/>
</androidx.constraintlayout.widget.ConstraintLayout>
