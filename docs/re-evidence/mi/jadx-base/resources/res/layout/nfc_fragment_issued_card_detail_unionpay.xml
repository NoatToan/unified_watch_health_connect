<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:background="@drawable/selector_white"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nfc_issued_card_list_detail_item_height"
        android:layout_marginTop="20dp"
        android:paddingStart="@dimen/common_title_left_margin"
        android:paddingEnd="@dimen/common_title_left_margin">
        <TextView
            android:textSize="@dimen/common_item_set_title_text_size"
            android:textColor="@color/setting_item_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/nfc_bank_type"
            android:includeFontPadding="false"
            android:layout_weight="1"
            style="@style/nfc_TextAppearance.List.Primary"/>
        <TextView
            android:textSize="12.7dp"
            android:textColor="@color/text_color_40"
            android:id="@+id/bankTypeView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:background="@drawable/selector_white"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nfc_issued_card_list_detail_item_height"
        android:paddingStart="@dimen/common_title_left_margin"
        android:paddingEnd="@dimen/common_title_left_margin">
        <TextView
            android:textSize="@dimen/common_item_set_title_text_size"
            android:textColor="@color/setting_item_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/nfc_card_number_global"
            android:includeFontPadding="false"
            android:layout_weight="1"
            style="@style/nfc_TextAppearance.List.Primary"/>
        <TextView
            android:textSize="12.7dp"
            android:textColor="@color/text_color_40"
            android:id="@+id/cardNumberView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:background="@drawable/selector_white"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nfc_issued_card_list_detail_item_height"
        android:paddingStart="@dimen/common_title_left_margin"
        android:paddingEnd="@dimen/common_title_left_margin">
        <TextView
            android:textSize="@dimen/common_item_set_title_text_size"
            android:textColor="@color/setting_item_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/nfc_device_card_number_mul"
            android:includeFontPadding="false"
            android:layout_weight="1"
            style="@style/nfc_TextAppearance.List.Primary"/>
        <TextView
            android:textSize="12.7dp"
            android:textColor="@color/text_color_40"
            android:id="@+id/virtualCardNumberView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:background="@drawable/selector_white"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nfc_issued_card_list_detail_item_height"
        android:paddingStart="@dimen/common_title_left_margin"
        android:paddingEnd="@dimen/common_title_left_margin">
        <TextView
            android:textSize="@dimen/common_item_set_title_text_size"
            android:textColor="@color/setting_item_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/nfc_card_detail_more_settings_help"
            android:includeFontPadding="false"
            android:layout_weight="1"
            style="@style/nfc_TextAppearance.List.Primary"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/nfc_arrow_right_dark"/>
    </LinearLayout>
</LinearLayout>
