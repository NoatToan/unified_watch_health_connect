<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/health_layout_ecg_analyze_entrance_0"
    android:background="@drawable/shape_card_bg_normal"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/size_18"
    android:paddingEnd="13.3dp">
    <ImageView
        android:id="@+id/iv_image"
        android:background="@drawable/health_ic_ecg_entrance_image"
        android:layout_width="138dp"
        android:layout_height="127dp"
        android:layout_marginEnd="-4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/text_color_40"
        android:id="@+id/tv_ecg_provider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14.7dp"
        android:text="@string/health_ecg_national_center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/FontRegular"/>
    <TextView
        android:textSize="21.3sp"
        android:textColor="@color/text_color"
        android:id="@+id/tv_ecg_service"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="200dp"
        android:text="@string/health_n60_ecg_expert_analyze_service"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_ecg_provider"
        style="@style/FontDemiBold"/>
    <TextView
        android:textSize="12.7sp"
        android:textColor="@color/health_ecg_banner_info_text_color"
        android:id="@+id/tv_ecg_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="150dp"
        android:text="@string/health_ecg_new_user"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_ecg_service"
        style="@style/FontMedium"/>
    <TextView
        android:textSize="9.3sp"
        android:textColor="@color/blue"
        android:id="@+id/tv_ecg_tips"
        android:background="@drawable/shape_ecg_blue_tips"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/health_ecg_in_effect"
        android:layout_marginStart="4dp"
        android:paddingHorizontal="2.6dp"
        android:paddingVertical="2dp"
        app:layout_constraintStart_toEndOf="@+id/tv_ecg_info"
        app:layout_constraintTop_toTopOf="@+id/tv_ecg_info"
        style="@style/FontMedium"/>
    <TextView
        android:textColor="@color/health_ecg_banner_action_text_color"
        android:id="@+id/tv_ecg_action"
        android:background="@drawable/shape_ecg_banner_action_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_18"
        android:layout_marginBottom="@dimen/size_16"
        android:text="@string/health_ecg_activate_now"
        android:paddingHorizontal="18dp"
        android:paddingVertical="5.3dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_ecg_info"
        app:layout_constraintVertical_bias="0"
        style="@style/FontMedium.12sp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
