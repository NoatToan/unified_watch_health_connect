<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/nfc_popwindow"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/page_content_padding_horizontal_large"
    android:paddingVertical="10dp">
    <TextView
        android:textSize="15sp"
        android:textColor="@color/text_color"
        android:id="@+id/myTransCardView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/nfc_retrun_card_query_list"
        android:paddingVertical="15dp"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/text_color"
        android:id="@+id/faqView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/nfc_card_detail_more_settings_help"
        android:paddingVertical="15dp"/>
</LinearLayout>
