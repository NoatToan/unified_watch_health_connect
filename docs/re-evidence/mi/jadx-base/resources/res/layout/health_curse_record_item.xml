<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/health_curse_record_item_0"
    android:paddingTop="13dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.xiaomi.fitness.widget.view.DividerView
        android:id="@+id/divider"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:layout_marginStart="26dp"
        android:layout_marginEnd="26dp"/>
    <TextView
        android:textColor="@color/text_color_40"
        android:gravity="center_vertical"
        android:id="@+id/yearView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="33dp"
        android:layout_marginStart="26dp"
        style="@style/FontRegular.12sp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contentView"
        android:background="@drawable/selector_white"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:paddingStart="26dp"
        android:paddingEnd="20dp">
        <TextView
            android:textSize="17sp"
            android:textColor="@color/text_color"
            android:id="@+id/periodView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/stateView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            style="@style/FontMedium"/>
        <TextView
            android:id="@+id/stateView"
            android:layout_marginTop="3dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/periodView"
            app:layout_constraintTop_toBottomOf="@+id/periodView"
            style="@style/HealthCurseDesc"/>
        <TextView
            android:textColor="@color/text_color_40"
            android:id="@+id/daysView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/arrowView"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginEnd="27dp"
            style="@style/FontRegular.14sp"/>
        <ImageView
            android:id="@+id/arrowView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_base_right_arrow_icon"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
