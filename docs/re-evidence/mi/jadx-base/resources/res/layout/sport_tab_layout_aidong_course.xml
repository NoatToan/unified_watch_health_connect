<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/sport_tab_layout_aidong_course_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:id="@+id/courseInlet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/right_arrow"
            android:background="@drawable/ic_right_arrow_course"
            android:layout_width="@dimen/dimen_margin_28dp"
            android:layout_height="@dimen/dimen_margin_28dp"
            android:layout_marginBottom="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/section_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/section_title"/>
        <TextView
            android:textColor="@color/text_color_40"
            android:gravity="end|center_vertical"
            android:id="@+id/all_right_arrow"
            android:paddingBottom="@dimen/dimen_margin_12dp"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:text="@string/sport_tab_all"
            app:layout_constraintBottom_toBottomOf="@+id/section_title"
            app:layout_constraintEnd_toStartOf="@+id/right_arrow"
            app:layout_constraintTop_toTopOf="@+id/section_title"
            style="@style/FontNormal.14sp"/>
        <TextView
            android:textSize="17sp"
            android:textColor="@color/text_color"
            android:id="@+id/section_title"
            android:paddingBottom="@dimen/dimen_margin_12dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textAlignment="viewStart"
            android:layout_marginEnd="@dimen/dimen_margin_10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/all_right_arrow"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/FontDemiBold"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="vertical"
        android:id="@+id/course_list_recycler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/aidong_entrance_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/bg_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/bg_img_default"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"/>
            <ImageView
                android:id="@+id/bg_img_large"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                app:layout_constraintTop_toTopOf="parent"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/dimen_margin_16dp"
            android:textColor="@color/white"
            android:gravity="start"
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_14dp"
            android:text="@string/global_sport_motion_sensing_interactive_game"
            android:includeFontPadding="false"
            android:textDirection="locale"
            android:layout_marginStart="@dimen/dimen_margin_18dp"
            app:layout_constraintEnd_toStartOf="@+id/instruction_for_use"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/bg_group"
            style="@style/FontLatinSemiBold"/>
        <TextView
            android:textSize="@dimen/dimen_margin_12dp"
            android:textColor="@color/white_60"
            android:gravity="start"
            android:id="@+id/subtitle"
            android:visibility="invisible"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/global_sport_aidong_description"
            android:includeFontPadding="false"
            android:textDirection="locale"
            android:layout_marginStart="@dimen/dimen_margin_18dp"
            app:layout_constraintEnd_toStartOf="@+id/instruction_for_use"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/logo_group"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginBottom="@dimen/dimen_margin_14dp"
            android:layout_marginStart="@dimen/dimen_margin_18dp"
            app:layout_constraintBottom_toBottomOf="@+id/aidong_entrance_card"
            app:layout_constraintStart_toStartOf="parent">
            <ImageView
                android:id="@+id/mi_logo"
                android:background="@drawable/sport_mi_health_logo_rounded_corner_square"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:contentDescription="@string/app_name"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="10dp"
                android:textColor="@color/white"
                android:id="@+id/mi_app_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/global_sport_app_name"
                android:layout_marginStart="3dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/mi_logo"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textColor="@color/white"
                android:id="@+id/vertical_divider"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="|"
                android:layout_marginStart="5.39dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/mi_app_name"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/aidong_logo"
                android:background="@drawable/sport_aidong_logo"
                android:layout_width="44.67dp"
                android:layout_height="12dp"
                android:layout_marginStart="4.33dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/vertical_divider"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/white_70"
            android:id="@+id/instruction_for_use"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_12dp"
            android:maxWidth="100dp"
            android:text="@string/global_sport_instruction_for_use"
            android:layout_marginStart="@dimen/dimen_margin_10dp"
            android:layout_marginEnd="@dimen/dimen_margin_16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/bg_group"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
