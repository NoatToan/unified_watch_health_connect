<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/relative_care_my_qr_code_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/account_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_20dp"
                android:layout_marginHorizontal="@dimen/page_content_padding_horizontal_large"
                app:layout_constraintTop_toTopOf="parent">
                <com.xiaomi.fitness.widget.view.RoundImageView
                    android:id="@+id/relative_avatar"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:importantForAccessibility="no"
                    android:layout_marginVertical="@dimen/dimen_margin_20dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dimen_margin_16dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/relative_avatar"
                    app:layout_constraintTop_toTopOf="parent">
                    <TextView
                        android:textColor="@color/selector_feature_item_title_text_color"
                        android:id="@+id/relative_username"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:singleLine="true"
                        style="@style/FontDemiBold.16sp"/>
                    <TextView
                        android:textColor="@color/selector_feature_item_subtitle_text_color"
                        android:id="@+id/xiaomi_account"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:singleLine="true"
                        style="@style/FontRegular.12sp"/>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <com.xiaomi.fitness.widget.view.DividerView
                android:id="@+id/horizontal_divider"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/page_content_padding_horizontal_large"
                android:layout_marginVertical="@dimen/dimen_margin_20dp"
                app:layout_constraintTop_toBottomOf="@+id/account_group"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:background="@drawable/shape_bottom_btn_native_bg_pressed"
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_30dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/horizontal_divider">
                <ImageView
                    android:id="@+id/bg_card"
                    android:background="@drawable/relative_care_qr_code_shape_card_bg_normal"
                    android:layout_width="240dp"
                    android:layout_height="240dp"
                    android:layout_marginTop="@dimen/dimen_margin_20dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="13sp"
                    android:gravity="center"
                    android:id="@+id/instruction"
                    android:padding="@dimen/dimen_margin_20dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/relative_care_qr_code_valid_for_72_hours"
                    android:drawablePadding="@dimen/dimen_margin_16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/bg_card"
                    style="@style/FontRegular"/>
                <ImageView
                    android:id="@+id/my_qr_code"
                    android:layout_width="@dimen/dimen_margin_200dp"
                    android:layout_height="@dimen/dimen_margin_200dp"
                    android:layout_marginTop="@dimen/dimen_margin_20dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/bg_card"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/relative_care_no_network_text_color"
        android:gravity="center_horizontal"
        android:id="@+id/no_network"
        android:visibility="gone"
        android:layout_width="100dp"
        android:layout_height="150dp"
        android:text="@string/relative_care_network_connection_failed_tip"
        android:drawableTop="@drawable/icon_no_network"
        android:drawablePadding="@dimen/dimen_margin_10dp"
        android:layout_centerInParent="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
