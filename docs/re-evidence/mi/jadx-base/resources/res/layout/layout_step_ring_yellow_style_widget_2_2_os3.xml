<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:background="@drawable/widget_default_corners_background_radius_20"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:maxWidth="170dp"
    android:maxHeight="170dp">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@android:id/widget_frame"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="12"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="136">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="12"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="62">
                <TextView
                    android:id="@+id/widgetStepDefaultStartPadding"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/widgetStepDefaultTextLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="90">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="#ff8c00"
                        android:gravity="start|center_vertical"
                        android:id="@+id/widgetStepTitle16"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:text="@string/provider_step_label"
                        android:layout_weight="24"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="2sp"
                        android:autoSizeMaxTextSize="16sp"
                        android:textFontWeight="600"/>
                    <TextView
                        android:textSize="13.87sp"
                        android:textColor="@color/text_color"
                        android:gravity="start|center_vertical"
                        android:id="@+id/widgetStepSubTitle"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:text="@string/widget_start_record"
                        android:layout_weight="18"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="2sp"
                        android:autoSizeMaxTextSize="12sp"
                        android:textFontWeight="380"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:layout_weight="19"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/widgetStepTextLayout"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="92">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#ff8c00"
                        android:gravity="start|center_vertical"
                        android:id="@+id/widgetStepTitle"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:text="@string/widget_todays_step"
                        android:includeFontPadding="false"
                        android:layout_weight="16"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="2sp"
                        android:autoSizeMaxTextSize="12sp"
                        android:textFontWeight="450"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="24sp"
                        android:textColor="@color/text_color"
                        android:gravity="start|center_vertical"
                        android:id="@+id/widgetStepValue"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:text="--"
                        android:maxLines="1"
                        android:includeFontPadding="false"
                        android:layout_weight="28"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="2sp"
                        android:autoSizeMaxTextSize="24sp"
                        android:textFontWeight="380"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/text_color_30"
                        android:gravity="start|center_vertical"
                        android:id="@+id/widgetStepGoal"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:text=" "
                        android:maxLines="1"
                        android:includeFontPadding="false"
                        android:layout_weight="16"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="2sp"
                        android:autoSizeMaxTextSize="12sp"
                        android:textFontWeight="380"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/ivRingImageDefaultLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="44">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="11.59"/>
                    <ImageView
                        android:id="@+id/ivRingImageDefault"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:src="@drawable/widget_step_walking_man_ic"
                        android:adjustViewBounds="true"
                        android:layout_weight="21.67"
                        android:importantForAccessibility="no"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="11.59"/>
                </LinearLayout>
                <ImageView
                    android:id="@+id/ivRingImage"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:layout_weight="44"
                    android:importantForAccessibility="no"/>
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="8"/>
            <LinearLayout
                android:gravity="bottom"
                android:orientation="vertical"
                android:id="@+id/barChartLayout"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="66">
                <ImageView
                    android:id="@+id/barChartImage"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:scaleType="fitXY"
                    android:layout_weight="52"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="2"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/xAxisView"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="12"
                    android:layoutDirection="ltr">
                    <TextView
                        android:textSize="10sp"
                        android:textColor="@color/text_color_30"
                        android:gravity="start|center_vertical"
                        android:id="@+id/txt1"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:text="@string/data_xaxis_time_0"
                        android:includeFontPadding="false"
                        android:layout_weight="1"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="2sp"
                        android:autoSizeMaxTextSize="10sp"
                        android:textFontWeight="380"/>
                    <TextView
                        android:textSize="10sp"
                        android:textColor="@color/text_color_30"
                        android:gravity="end|center_vertical"
                        android:id="@+id/txt3"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:text="@string/data_xaxis_time_24"
                        android:includeFontPadding="false"
                        android:layout_weight="1"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="2sp"
                        android:autoSizeMaxTextSize="10sp"
                        android:textFontWeight="380"/>
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="12"/>
        </LinearLayout>
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="12"/>
    </LinearLayout>
</FrameLayout>
