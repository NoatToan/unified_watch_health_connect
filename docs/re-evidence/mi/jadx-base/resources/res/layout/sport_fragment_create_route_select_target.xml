<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/contentLayout"
    android:tag="layout/sport_fragment_create_route_select_target_0"
    android:background="@drawable/sport_route_ai_create_bg"
    android:paddingTop="20dp"
    android:paddingBottom="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="29dp">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/confirmRouteTitleLayout"
        android:paddingBottom="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="0">
        <TextView
            android:textSize="23sp"
            android:textColor="@color/text_color"
            android:gravity="center"
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sport_select_running_target"
            android:fontFamily="@font/misanslatin_semibold"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/text_color_40"
            android:gravity="center"
            android:id="@+id/subTitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sport_set_your_running_target"
            android:fontFamily="@font/misanslatin_regular"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/midContentView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/midFiexedHeightLayout"
            android:layout_width="match_parent"
            android:layout_height="272dp"
            android:contentDescription="@string/sport_select_running_target">
            <TextView
                android:textSize="13dp"
                android:textColor="@color/text_color"
                android:id="@+id/targetHintText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="20dp"
                android:text="@string/sport_distance_from_target"
                android:fontFamily="@font/misanslatin_regular"
                android:layout_marginEnd="-3dp"
                app:autoSizeMaxTextSize="13sp"
                app:autoSizeMinTextSize="3sp"
                app:autoSizeStepGranularity="0.1sp"
                app:autoSizeTextType="uniform"
                app:layout_constraintBottom_toBottomOf="@+id/sportRunningTargetNumberPicker"
                app:layout_constraintEnd_toStartOf="@+id/sportRunningTargetNumberPicker"
                app:layout_constraintTop_toTopOf="@+id/sportRunningTargetNumberPicker"/>
            <com.xiaomi.fitness.sport.baseui.SportNumberPicker
                android:textSize="30sp"
                android:layout_gravity="center"
                android:id="@+id/sportRunningTargetNumberPicker"
                android:focusable="true"
                android:layout_width="130dp"
                android:layout_height="match_parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="10dp"
                android:id="@+id/unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/sportRunningTargetNumberPicker"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="bottom|center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/bottomButtonLayout"
        android:paddingTop="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="0">
        <Button
            android:textSize="18dp"
            android:gravity="center"
            android:layout_gravity="start"
            android:id="@+id/button_prev"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/btn_pre"
            android:layout_weight="162"
            style="@style/SportCreateRouteGreyButtonStyle"/>
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="12"/>
        <Button
            android:textSize="18dp"
            android:gravity="center"
            android:layout_gravity="end"
            android:id="@+id/button_next"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/btn_next"
            android:layout_weight="162"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            style="@style/SportCreateRouteOrangeButtonStyle"/>
    </LinearLayout>
</LinearLayout>
