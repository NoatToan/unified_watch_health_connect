<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_running_indicator_detail_0"
    android:background="@color/page_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:paddingBottom="@dimen/margin_20dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:tag="binding_1"
            android:paddingBottom="@dimen/health_detail_page_common_margin_vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintTop_toTopOf="parent">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.xiaomi.fitness.chart.view.LineChartRecyclerView
                    android:id="@+id/line_recycler"
                    app:chartColor="@color/green_yellow"
                    app:displayNumbers="30"
                    app:dynamicAdjustItemFillWidth="true"
                    app:enableEndDayXAxis="true"
                    app:enableEndYAxisLabel="true"
                    app:enableScrollToScale="true"
                    app:enableStartYAxisLabel="false"
                    app:enableXAxisFirstGridLine="false"
                    app:enableXAxisLineCircle="true"
                    app:enableXAxisThirdGridLine="false"
                    app:lineColor="@color/green_yellow"
                    app:linePointRadius="@dimen/size_2"
                    app:linePointSelectCircleStroke="true"
                    app:linePointSelectRadius="@dimen/size_2"
                    app:linePointSelectStrokeWidth="@dimen/size_2"
                    app:lineSelectCircles="1"
                    app:lineShaderBeginColor="@color/energy_shader_begin"
                    app:lineShaderEndColor="@color/energy_shader_end"
                    app:lineStrokeWidth="6"
                    style="@style/ChartBaseStyle"/>
                <com.xiaomi.fitness.view.DataTitleView
                    android:id="@+id/dataTitleView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </FrameLayout>
            <include
                android:id="@+id/running_indicator_widget"
                layout="@layout/layout_running_indicator_widget"/>
            <include
                android:id="@+id/running_indicator_grade_prediction"
                android:visibility="gone"
                layout="@layout/health_running_indicator_grade_prediction"/>
            <com.xiaomi.fitness.view.CardUnderstandView
                android:id="@+id/understandCard"
                android:background="@drawable/selector_card_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_12"
                android:layout_marginHorizontal="@dimen/page_padding_horizontal_large"
                app:txtUnderstand="@string/health_running_ability_index_understand"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
