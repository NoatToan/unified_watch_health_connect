<?xml version="1.0" encoding="utf-8"?>
<miuix.springback.view.SpringBackLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/device_settings_aod_setting_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:scrollableView="@+id/scrollview">
    <miuix.core.widget.NestedScrollView
        android:id="@+id/scrollview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.xiaomi.fitness.widget.RightArrowTwoLineTextView
                android:id="@+id/stateView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_13dp"
                android:paddingStart="@dimen/page_content_padding_horizontal_large"
                android:paddingEnd="@dimen/page_content_padding_horizontal_large"
                app:layout_constraintTop_toTopOf="parent"
                app:title="@string/device_settings_aod"/>
            <com.xiaomi.fitness.widget.RightArrowTwoLineTextView
                android:id="@+id/startView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/page_content_padding_horizontal_large"
                android:paddingEnd="@dimen/page_content_padding_horizontal_large"
                app:layout_constraintTop_toBottomOf="@+id/stateView"
                app:title="@string/device_settings_wrist_screen_wake_start"/>
            <com.xiaomi.fitness.widget.RightArrowTwoLineTextView
                android:id="@+id/endView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/page_content_padding_horizontal_large"
                android:paddingEnd="@dimen/page_content_padding_horizontal_large"
                app:layout_constraintTop_toBottomOf="@+id/startView"
                app:title="@string/device_settings_wrist_screen_wake_end"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </miuix.core.widget.NestedScrollView>
</miuix.springback.view.SpringBackLayout>
