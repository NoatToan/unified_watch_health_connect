<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/shape_card_bg_normal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/sport_icon"
        android:layout_width="@dimen/dimen_round_33.33dp"
        android:layout_height="@dimen/dimen_round_33.33dp"
        android:layout_marginStart="@dimen/dimen_margin_18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="@dimen/dimen_margin_0dp"
        android:layout_height="wrap_content"
        android:weightSum="2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/sport_icon"
        app:layout_constraintTop_toTopOf="parent">
        <RelativeLayout
            android:id="@+id/description_group"
            android:layout_width="@dimen/dimen_margin_0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/dimen_margin_12dp"
            android:layout_marginVertical="@dimen/dimen_margin_13dp">
            <TextView
                android:textColor="@color/text_color"
                android:id="@+id/sport_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                style="@style/FontDemiBold.16sp"/>
            <TextView
                android:textColor="@color/text_color"
                android:id="@+id/max_depth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/sport_name"
                style="@style/FontMedium.20sp"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dimen_11sp"
                android:textColor="@color/text_color_40"
                android:gravity="center_vertical"
                android:id="@+id/diving_point"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_3dp"
                android:drawablePadding="3.3dp"
                android:layout_below="@+id/max_depth"
                app:drawableStartCompat="@drawable/icon_diving_point"
                style="@style/FontNormal"/>
        </RelativeLayout>
        <TextView
            android:textColor="@color/text_color_40"
            android:gravity="end|center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/date_tv"
            android:layout_width="@dimen/dimen_margin_0dp"
            android:layout_height="wrap_content"
            android:drawablePadding="6dp"
            android:layout_weight="1"
            android:drawableEnd="@drawable/ic_trail_arrow_icon"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="@dimen/dimen_margin_16dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
