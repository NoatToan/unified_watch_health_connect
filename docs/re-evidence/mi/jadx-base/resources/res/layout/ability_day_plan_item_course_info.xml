<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:tag="layout/ability_day_plan_item_course_info_0"
    android:background="@drawable/training_course_bg"
    android:layout_width="match_parent"
    android:layout_height="70dp">
    <ImageView
        android:id="@+id/courseIndicator"
        android:layout_width="5dp"
        android:layout_height="match_parent"
        android:src="@drawable/course_left_running_indicator"/>
    <FrameLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="70dp">
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/courseContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="22dp">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/black"
                android:layout_gravity="center_vertical"
                android:id="@+id/courseName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/misanslatin_bold"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp">
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/subtitle_text_color"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/courseTypeName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/misanslatin_bold"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/subtitle_text_color"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/courseDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/misanslatin_bold"
                    android:layout_marginStart="6dp"/>
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/desc_text_color"
            android:layout_gravity="center_vertical"
            android:id="@+id/noCourseTip"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/misanslatin_bold"
            android:layout_marginStart="22dp"/>
    </FrameLayout>
</LinearLayout>
