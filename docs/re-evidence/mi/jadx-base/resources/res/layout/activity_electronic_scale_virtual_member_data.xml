<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_electronic_scale_virtual_member_data_0"
    android:background="@color/page_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:id="@+id/linearlayout_compat"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.xiaomi.fitness.electronic.scale.widget.titlebar.TitleBarAlphaView
            android:id="@+id/title_alpha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_user_manager"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginLeft="18dp"
        android:layout_marginTop="25dp"
        android:layout_marginRight="18dp"
        android:layout_below="@+id/linearlayout_compat">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view_gallery"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_user_manager"
            android:background="@drawable/electronic_scale_white_gradient"
            android:paddingLeft="15dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="@+id/recycler_view_gallery"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/recycler_view_gallery">
            <ImageView
                android:background="@color/page_bg"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/electronic_scale_icon_more_virtual_member"
                android:scaleType="centerCrop"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <RelativeLayout
        android:id="@+id/rl_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/dimen_margin_36dp"
        android:layout_below="@+id/cl_user_manager">
        <miuix.miuixbasewidget.widget.FilterSortView
            android:theme="@style/FilterSortViewStyle"
            android:id="@+id/filter_sort_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_13dp"
            android:layout_marginBottom="@dimen/dimen_margin_10dp"
            android:layoutDirection="ltr"
            android:layout_marginStart="@dimen/common_set_margin_start"
            android:layout_marginEnd="@dimen/common_set_margin_start"/>
        <com.xiaomi.fitness.electronic.scale.widget.NoSwipeViewPager
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/filter_sort_view"/>
    </RelativeLayout>
</RelativeLayout>
