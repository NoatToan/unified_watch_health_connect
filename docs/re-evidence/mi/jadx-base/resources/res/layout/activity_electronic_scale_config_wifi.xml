<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_electronic_scale_config_wifi_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_input_wifi"
        android:paddingTop="@dimen/electronic_scale_dimen_margin_27dp"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/electronic_scale_dimen_margin_27dp"
        android:paddingEnd="@dimen/electronic_scale_dimen_margin_27dp">
        <TextView
            android:textSize="@dimen/dimen_19sp"
            android:textStyle="bold"
            android:id="@+id/some_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/electronic_scale_config_wifi_select_target_wifi"/>
        <TextView
            android:textSize="@dimen/dimen_14sp"
            android:paddingTop="@dimen/dimen_margin_10dp"
            android:paddingBottom="@dimen/dimen_round_33.33dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/electronic_scale_config_wifi_select_target_wifi_descr"/>
        <RelativeLayout
            android:id="@+id/ssid_container"
            android:layout_width="match_parent"
            android:layout_height="67dp">
            <AutoCompleteTextView
                android:textSize="@dimen/electronic_scale_content_text_size"
                android:textColor="@color/text_color"
                android:id="@+id/ssid"
                android:background="@android:color/transparent"
                android:scrollbars="none"
                android:nextFocusDown="@+id/password"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text=""
                android:hint="@string/electronic_scale_common_wifi_name"
                android:maxLines="1"
                android:singleLine="true"
                android:completionThreshold="1"
                android:popupBackground="@drawable/electronic_scale_bg_editor"
                android:inputType="text"
                android:imeOptions="actionNext"
                android:dropDownHeight="wrap_content"
                android:layout_toStartOf="@+id/tv_search_wifi"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#ff898f9a"
                android:gravity="center_vertical"
                android:id="@+id/tv_search_wifi"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:scaleType="center"
                android:text="@string/electronic_scale_search_wifi"
                android:layout_centerVertical="true"
                android:drawableEnd="@drawable/electronic_scale_ic_right_arrow"
                android:layout_alignParentEnd="true"/>
            <View
                android:background="@color/divider_color"
                android:layout_width="match_parent"
                android:layout_height="@dimen/electronic_scale_common_divider_line_size"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/identity_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="67dp">
            <miuix.androidbasewidget.widget.EditText
                android:textSize="@dimen/electronic_scale_content_text_size"
                android:textColor="@color/text_color"
                android:textColorHint="@color/electronic_scale_color_c1"
                android:id="@+id/identity"
                android:background="@android:color/transparent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text=""
                android:hint="@string/electronic_scale_common_wifi_identity"
                android:maxLength="64"
                android:layout_weight="1"
                android:inputType="text"/>
            <View
                android:background="@color/divider_color"
                android:layout_width="match_parent"
                android:layout_height="@dimen/electronic_scale_common_divider_line_size"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/passwordContainer"
            android:layout_width="match_parent"
            android:layout_height="67dp">
            <miuix.androidbasewidget.widget.EditText
                android:textSize="@dimen/electronic_scale_content_text_size"
                android:textColor="@color/switch_black"
                android:gravity="start|center_vertical"
                android:id="@+id/password"
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="@string/electronic_scale_common_wifi_pwd"
                android:singleLine="true"
                android:inputType="textPassword"
                android:textAlignment="viewStart"/>
            <View
                android:background="@color/divider_color"
                android:layout_width="match_parent"
                android:layout_height="@dimen/electronic_scale_common_divider_line_size"
                android:layout_alignParentBottom="true"/>
            <CheckBox
                android:id="@+id/password_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:button="@drawable/electronic_scale_icon_toggle"
                android:src="@drawable/electronic_scale_unwear_pwd_show_pwd"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <CheckBox
            android:textSize="@dimen/electronic_scale_regular_text_size"
            android:textColor="@color/text_color"
            android:gravity="center_vertical"
            android:id="@+id/remember_pwd"
            android:paddingLeft="10dp"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="14dp"
            android:checked="true"
            android:button="@drawable/electronic_scale_wifi_setting_checkbox"
            android:text="@string/electronic_scale_common_wifi_remember_password"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <TextView
            android:id="@+id/tv_next_step"
            android:layout_width="match_parent"
            android:layout_marginBottom="@dimen/electronic_scale_dimen_margin_27dp"
            android:text="@string/electronic_scale_config_wifi_next_step"
            android:layout_marginStart="@dimen/dimen_margin_0dp"
            android:layout_marginEnd="@dimen/dimen_margin_0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/CommonBtn.Primary"/>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/ll_configuring"
        android:paddingTop="160dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/electronic_scale_dimen_margin_27dp"
        android:paddingEnd="@dimen/electronic_scale_dimen_margin_27dp">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/electronic_scale_icon_electronic_scale_wifi_info"/>
        <TextView
            android:textSize="@dimen/dimen_19sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"
            android:paddingTop="@dimen/dimen_margin_40dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/config_wifi_configuring"/>
        <TextView
            android:textSize="@dimen/dimen_14sp"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_near_by_router"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/electronic_scale_config_wifi_set_device_near_by_router"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/ll_configure_success"
        android:paddingTop="160dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/electronic_scale_dimen_margin_27dp"
        android:paddingEnd="@dimen/electronic_scale_dimen_margin_27dp">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/electronic_scale_icon_config_success"/>
        <TextView
            android:textSize="@dimen/dimen_19sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"
            android:paddingTop="@dimen/dimen_margin_40dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/electronic_scale_config_wifi_configure_success"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <TextView
            android:layout_gravity="bottom"
            android:id="@+id/tv_finish"
            android:layout_width="match_parent"
            android:layout_marginBottom="@dimen/electronic_scale_dimen_margin_27dp"
            android:text="@string/electronic_scale_config_wifi_finish"
            android:layout_marginStart="@dimen/dimen_margin_0dp"
            android:layout_marginEnd="@dimen/dimen_margin_0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/CommonBtn.Normal"/>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/ll_configure_fail"
        android:paddingTop="160dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/electronic_scale_dimen_margin_27dp"
        android:paddingEnd="@dimen/electronic_scale_dimen_margin_27dp">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/electronic_scale_icon_config_fail"/>
        <TextView
            android:textSize="@dimen/dimen_19sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"
            android:paddingTop="@dimen/dimen_margin_40dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/electronic_scale_config_wifi_configure_fail"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <TextView
            android:layout_gravity="bottom"
            android:id="@+id/tv_retry"
            android:layout_width="match_parent"
            android:layout_marginBottom="@dimen/electronic_scale_dimen_margin_27dp"
            android:text="@string/electronic_scale_config_wifi_retry"
            android:layout_marginStart="@dimen/dimen_margin_0dp"
            android:layout_marginEnd="@dimen/dimen_margin_0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/CommonBtn.Primary"/>
        <TextView
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_check_help"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/electronic_scale_dimen_margin_27dp"
            android:text="@string/electronic_scale_config_wifi_check_help"
            android:layout_marginStart="@dimen/dimen_margin_0dp"
            android:layout_marginEnd="@dimen/dimen_margin_0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </LinearLayout>
</FrameLayout>
