<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/device_dialog_switch_wear_mode_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/dimen_margin_24dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/band_group"
        android:background="@drawable/device_shape_wear_mode_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/band_img"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/device_wear_mode_band"
            android:layout_marginStart="@dimen/dimen_margin_16dp"
            android:layout_marginVertical="@dimen/dimen_margin_28dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:id="@+id/band_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/device_wear_mode_band"
            android:layout_marginStart="@dimen/dimen_margin_12dp"
            app:layout_constraintBottom_toTopOf="@+id/band_desc"
            app:layout_constraintEnd_toStartOf="@+id/band_check"
            app:layout_constraintStart_toEndOf="@+id/band_img"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            style="@style/FontDemiBold.16sp"/>
        <TextView
            android:textSize="@dimen/dimen_12sp"
            android:id="@+id/band_desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/device_wear_mode_band_func"
            app:layout_constraintBottom_toTopOf="@+id/band_hint"
            app:layout_constraintEnd_toStartOf="@+id/band_check"
            app:layout_constraintStart_toStartOf="@+id/band_title"
            app:layout_constraintTop_toBottomOf="@+id/band_title"/>
        <TextView
            android:textSize="@dimen/dimen_12sp"
            android:textColor="@color/footer_desc"
            android:id="@+id/band_hint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/device_wear_mode_band_tips"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/band_check"
            app:layout_constraintStart_toStartOf="@+id/band_title"
            app:layout_constraintTop_toBottomOf="@+id/band_desc"/>
        <CheckBox
            android:id="@+id/band_check"
            android:background="@drawable/selector_check"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:button="@null"
            android:layout_marginEnd="@dimen/dimen_margin_20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bean_group"
        android:background="@drawable/device_shape_wear_mode_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_12dp"
        app:layout_constraintTop_toBottomOf="@+id/band_group">
        <ImageView
            android:id="@+id/bean_img"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/device_wear_mode_bean"
            android:layout_marginStart="@dimen/dimen_margin_16dp"
            android:layout_marginVertical="@dimen/dimen_margin_28dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:id="@+id/bean_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/device_wear_mode_bean"
            android:layout_marginStart="@dimen/dimen_margin_12dp"
            app:layout_constraintBottom_toTopOf="@+id/bean_desc"
            app:layout_constraintEnd_toStartOf="@+id/bean_check"
            app:layout_constraintStart_toEndOf="@+id/bean_img"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            style="@style/FontDemiBold.16sp"/>
        <TextView
            android:textSize="@dimen/dimen_12sp"
            android:id="@+id/bean_desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/device_wear_mode_bean_func"
            app:layout_constraintBottom_toTopOf="@+id/bean_hint"
            app:layout_constraintEnd_toStartOf="@+id/bean_check"
            app:layout_constraintStart_toStartOf="@+id/bean_title"
            app:layout_constraintTop_toBottomOf="@+id/bean_title"/>
        <TextView
            android:textSize="@dimen/dimen_12sp"
            android:textColor="@color/footer_desc"
            android:id="@+id/bean_hint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/device_wear_mode_bean_tips"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/bean_check"
            app:layout_constraintStart_toStartOf="@+id/bean_title"
            app:layout_constraintTop_toBottomOf="@+id/bean_desc"/>
        <CheckBox
            android:id="@+id/bean_check"
            android:background="@drawable/selector_check"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:button="@null"
            android:layout_marginEnd="@dimen/dimen_margin_20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ring_group"
        android:background="@drawable/device_shape_wear_mode_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_12dp"
        app:layout_constraintTop_toBottomOf="@+id/bean_group">
        <ImageView
            android:id="@+id/ring_img"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/device_wear_mode_ring"
            android:layout_marginStart="@dimen/dimen_margin_16dp"
            android:layout_marginVertical="@dimen/dimen_margin_28dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:id="@+id/ring_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/device_wear_mode_ring"
            android:layout_marginStart="@dimen/dimen_margin_12dp"
            app:layout_constraintBottom_toTopOf="@+id/ring_desc"
            app:layout_constraintEnd_toStartOf="@+id/ring_check"
            app:layout_constraintStart_toEndOf="@+id/ring_img"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            style="@style/FontDemiBold.16sp"/>
        <TextView
            android:textSize="@dimen/dimen_12sp"
            android:id="@+id/ring_desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/device_wear_mode_ring_func"
            app:layout_constraintBottom_toTopOf="@+id/ring_hint"
            app:layout_constraintEnd_toStartOf="@+id/ring_check"
            app:layout_constraintStart_toStartOf="@+id/ring_title"
            app:layout_constraintTop_toBottomOf="@+id/ring_title"/>
        <TextView
            android:textSize="@dimen/dimen_12sp"
            android:textColor="@color/footer_desc"
            android:id="@+id/ring_hint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/device_wear_mode_ring_tips"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/ring_check"
            app:layout_constraintStart_toStartOf="@+id/ring_title"
            app:layout_constraintTop_toBottomOf="@+id/ring_desc"/>
        <CheckBox
            android:id="@+id/ring_check"
            android:background="@drawable/selector_check"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:button="@null"
            android:layout_marginEnd="@dimen/dimen_margin_20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
