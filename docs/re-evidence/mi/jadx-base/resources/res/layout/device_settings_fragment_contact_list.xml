<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/layoutView"
    android:tag="layout/device_settings_fragment_contact_list_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/page_content_padding_horizontal_large"
    android:paddingEnd="@dimen/page_content_padding_horizontal_large">
    <EditText
        android:textSize="14sp"
        android:textColor="@color/text_color"
        android:textColorHint="@color/device_settings_search_hint"
        android:gravity="center_vertical"
        android:id="@+id/searchView"
        android:background="@drawable/device_settings_shape_search_bg"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="@dimen/dimen_margin_12dp"
        android:hint="@string/device_settings_contact_search"
        android:drawablePadding="9dp"
        android:inputType="text"
        android:drawableStart="@drawable/ic_search"
        android:textDirection="locale"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/dimen_margin_10dp">
        <androidx.recyclerview.widget.RecyclerView
            android:orientation="vertical"
            android:id="@+id/listView"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/dimen_margin_10dp"
            app:layout_constraintEnd_toStartOf="@+id/sidebarView"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:textSize="20sp"
            android:gravity="center"
            android:id="@+id/dialog"
            android:background="@color/black_10_transparent"
            android:visibility="gone"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:text="A"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.xiaomi.fitness.devicesettings.widget.SideBar
            android:id="@+id/sidebarView"
            android:layout_width="30dp"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
