<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/ftp_test_introduce_activity_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/back"
        android:background="@drawable/ic_back"
        android:layout_width="@dimen/dimen_margin_40dp"
        android:layout_height="@dimen/dimen_margin_40dp"
        android:layout_marginTop="@dimen/dimen_margin_50dp"
        android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintEnd_toStartOf="@+id/sport_guideline2"
            app:layout_constraintStart_toStartOf="@+id/sport_guideline2">
            <ImageView
                android:id="@+id/post_view"
                android:padding="45dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ftp_test_icon"
                android:scaleType="centerCrop"
                app:layout_constraintBottom_toTopOf="@+id/ftp_title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearance="@style/CourseShapeImage"/>
            <TextView
                android:textSize="@dimen/font_50"
                android:textColor="@color/text_color"
                android:id="@+id/ftp_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp"
                android:text="@string/sport_eco_ftp_ability_test"
                android:maxLines="2"
                android:fontFamily="@font/misanslatin_bold"
                android:paddingStart="@dimen/dimen_margin_26dp"
                android:paddingEnd="@dimen/dimen_margin_26dp"
                app:layout_constraintBottom_toTopOf="@+id/tip_view"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/text_color"
                android:id="@+id/tip_view"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/sport_ftp_test_introduce_des"
                android:lineSpacingExtra="10dp"
                android:paddingStart="@dimen/dimen_margin_26dp"
                android:paddingEnd="@dimen/dimen_margin_26dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
    <TextView
        android:id="@+id/ftp_start_view"
        android:layout_marginTop="@dimen/size_33_33"
        android:text="@string/sport_start_testing"
        style="@style/CommonBtn.Red"/>
</LinearLayout>
