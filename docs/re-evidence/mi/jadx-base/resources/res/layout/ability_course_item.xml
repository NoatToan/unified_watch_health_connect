<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/ability_course_item_shape"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/courseIndicator"
        android:layout_width="6dp"
        android:layout_height="match_parent"
        android:src="@drawable/course_left_running_indicator"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/courseList"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_16dp"
        android:layout_marginBottom="@dimen/dimen_margin_16dp"
        android:layout_marginStart="17dp"/>
    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1"/>
    <TextView
        android:textSize="@dimen/text_size_14"
        android:textColor="@color/text_color_60"
        android:id="@+id/loopCount"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/misanslatin_regular"
        android:layout_marginEnd="@dimen/dimen_margin_10dp"/>
</LinearLayout>
