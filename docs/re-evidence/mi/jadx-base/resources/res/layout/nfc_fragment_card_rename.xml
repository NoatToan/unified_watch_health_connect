<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="bottom"
    android:orientation="vertical"
    android:tag="layout/nfc_fragment_card_rename_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/layoutView"
            android:paddingTop="@dimen/nfc_nextpay_mifare_card_rename_padding_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/nfc_common_title_left_margin"
            android:paddingEnd="@dimen/nfc_common_title_left_margin">
            <TextView
                android:textSize="11.3sp"
                android:textColor="@color/text_color_80"
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="@string/nfc_entrance_card_rename"
                style="@style/nfc_TextAppearance.List.Secondary"/>
            <EditText
                android:textSize="13sp"
                android:textColor="@color/text_color_40"
                android:gravity="start|center_vertical"
                android:id="@+id/nameView"
                android:background="@drawable/nfc_rename_input_bg"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:maxLines="1"
                android:imeOptions="actionNext"
                android:paddingStart="10dp"/>
            <GridView
                android:id="@+id/nameListView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:listSelector="@color/common_transparent"
                android:horizontalSpacing="@dimen/nfc_nextpay_mifare_card_rename_name_options_horizontal_spacing"
                android:stretchMode="columnWidth"
                android:numColumns="4"/>
            <View
                android:background="@color/nfc_line"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"/>
            <TextView
                android:textSize="11.3sp"
                android:textColor="@color/text_color_40"
                android:gravity="center_vertical"
                android:id="@+id/faceTipView"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="@string/nfc_nextpay_door_card_select_face"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/faceView"
                android:visibility="gone"
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/nfc_nextpay_mifare_card_rename_face_options_margin_top"
                android:horizontalSpacing="@dimen/nfc_nextpay_mifare_card_rename_face_options_horizontal_spacing"
                android:verticalSpacing="@dimen/nfc_nextpay_mifare_card_rename_face_options_vertical_spacing"/>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/nfc_common_layout_padding"
        android:paddingEnd="@dimen/nfc_common_layout_padding">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/text_color_80"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/hintView"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/nfc_card_issue_hint_success_default"/>
        <TextView
            android:layout_gravity="center_horizontal"
            android:id="@+id/submitView"
            android:layout_marginTop="20dp"
            android:text="@string/nfc_common_complete"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp"
            style="@style/CommonBtn.Primary"/>
        <TextView
            android:id="@+id/holdback"
            android:layout_width="match_parent"
            android:layout_height="0dp"/>
    </LinearLayout>
</LinearLayout>
