<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/relative_care_home_activity_0"
    android:background="@color/page_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/add_relative_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <miuix.core.widget.NestedScrollView
            android:id="@+id/container"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:overScrollMode="never"
            app:layout_constraintBottom_toTopOf="@+id/check_rules"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/banner_iv"
                    android:layout_width="306dp"
                    android:layout_height="243dp"
                    android:layout_marginTop="@dimen/dimen_margin_25dp"
                    android:src="@drawable/relative_care_banner_pic"
                    android:scaleType="fitCenter"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/relative_recycler_view"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_margin_20dp"
                    android:overScrollMode="never"
                    android:nestedScrollingEnabled="false"
                    android:layout_marginHorizontal="@dimen/page_content_padding_horizontal_large"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/banner_iv"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/invitation_approach_recycler_view"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_margin_20dp"
                    android:overScrollMode="never"
                    android:nestedScrollingEnabled="false"
                    android:layout_marginHorizontal="@dimen/page_content_padding_horizontal_large"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/relative_recycler_view"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </miuix.core.widget.NestedScrollView>
        <TextView
            android:textColor="@color/text_color_40"
            android:gravity="center"
            android:id="@+id/check_rules"
            android:paddingTop="@dimen/dimen_margin_10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dimen_margin_18dp"
            android:text="@string/relative_care_check_rules"
            app:layout_constraintBottom_toBottomOf="parent"
            style="@style/FontRegular.14sp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:id="@+id/relative_list_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:paddingHorizontal="@dimen/page_padding_horizontal_large"
            app:layout_constraintTop_toTopOf="parent">
            <miuix.springback.view.SpringBackLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:scrollOrientation="vertical"
                app:scrollableView="@+id/relative_list_recycler">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/relative_list_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="@dimen/dimen_margin_25dp"/>
            </miuix.springback.view.SpringBackLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
