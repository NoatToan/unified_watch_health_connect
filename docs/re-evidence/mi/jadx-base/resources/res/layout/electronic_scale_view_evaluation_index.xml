<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/electronic_scale_view_evaluation_index_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="8sp"
        android:textColor="@color/text_color"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="9dp"
        android:layout_marginTop="9dp"
        android:text="@string/electronic_scale_evaluation_index"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guide_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_left"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toStartOf="@+id/guide_line"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title">
        <TextView
            android:textSize="4.5sp"
            android:textColor="@color/text_color_60"
            android:id="@+id/tv_shape"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/electronic_scale_body_shape"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/iv_shape_img"
            android:layout_width="20dp"
            android:layout_height="50dp"
            android:src="@drawable/electronic_scale_icon_shape_even"
            app:layout_constraintBottom_toBottomOf="@+id/tv_shape_frame"
            app:layout_constraintEnd_toEndOf="@+id/tv_shape_frame"
            app:layout_constraintStart_toStartOf="@+id/tv_shape_frame"
            app:layout_constraintTop_toTopOf="@+id/tv_shape_frame"/>
        <ImageView
            android:id="@+id/tv_shape_frame"
            android:background="@drawable/electronic_scale_shape_frame"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_shape"/>
        <TextView
            android:textSize="6sp"
            android:textColor="@color/text_color"
            android:id="@+id/tv_shape_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5.5dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_shape_frame"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_right"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/guide_line"
        app:layout_constraintTop_toBottomOf="@+id/tv_title">
        <TextView
            android:textSize="4.5sp"
            android:textColor="@color/text_color_60"
            android:id="@+id/tv_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/electronic_scale_body_type"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.xiaomi.fitness.electronic.scale.widget.BodyShapeView
            android:id="@+id/view_body_shape"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_type"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/electronic_scale_bg_black_alpha2_radius_8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:paddingStart="5dp">
            <TextView
                android:textSize="5sp"
                android:textColor="@color/text_color_60"
                android:gravity="center_vertical"
                android:id="@+id/tv_waist_hip"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="0.25dp"
                android:text="@string/electronic_scale_waist_hip"
                android:layout_weight="1"/>
            <View
                android:background="@color/page_bg"
                android:layout_width="0.5dp"
                android:layout_height="match_parent"/>
            <TextView
                android:textSize="5sp"
                android:textColor="@color/text_color"
                android:gravity="center_vertical"
                android:id="@+id/tv_waist_hip_value"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
            <View
                android:background="@color/page_bg"
                android:layout_width="0.5dp"
                android:layout_height="match_parent"/>
            <TextView
                android:textSize="5sp"
                android:textColor="@color/text_color_60"
                android:gravity="center_vertical"
                android:id="@+id/tv_body_age"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/electronic_scale_body_age"
                android:layout_weight="1"/>
            <View
                android:background="@color/page_bg"
                android:layout_width="0.5dp"
                android:layout_height="match_parent"/>
            <TextView
                android:textSize="5sp"
                android:textColor="@color/text_color"
                android:gravity="center_vertical"
                android:id="@+id/tv_body_age_value"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
        </LinearLayout>
        <View
            android:background="@color/page_bg"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:paddingStart="5dp">
            <TextView
                android:textSize="5sp"
                android:textColor="@color/text_color_60"
                android:gravity="center_vertical"
                android:id="@+id/tv_skeletal_muscle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="0.25dp"
                android:text="@string/electronic_scale_skeletal_muscle"
                android:layout_weight="1"/>
            <View
                android:background="@color/page_bg"
                android:layout_width="0.5dp"
                android:layout_height="match_parent"/>
            <TextView
                android:textSize="5sp"
                android:textColor="@color/text_color"
                android:gravity="center_vertical"
                android:id="@+id/tv_skeletal_muscle_value"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
            <View
                android:background="@color/page_bg"
                android:layout_width="0.5dp"
                android:layout_height="match_parent"/>
            <TextView
                android:textSize="5sp"
                android:textColor="@color/text_color_60"
                android:gravity="center_vertical"
                android:id="@+id/tv_calorie_intake"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/electronic_scale_calorie_intake"
                android:layout_weight="1"/>
            <View
                android:background="@color/page_bg"
                android:layout_width="0.5dp"
                android:layout_height="match_parent"/>
            <TextView
                android:textSize="5sp"
                android:textColor="@color/text_color"
                android:gravity="center_vertical"
                android:id="@+id/tv_calorie_intake_value"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
