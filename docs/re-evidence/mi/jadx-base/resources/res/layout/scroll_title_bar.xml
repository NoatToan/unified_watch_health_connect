<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/constraint"
    android:layout_width="match_parent"
    android:layout_height="53.3dp"
    android:paddingStart="@dimen/page_padding_horizontal_large"
    android:paddingEnd="@dimen/page_padding_horizontal_large">
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/scroll_black"
        android:gravity="center"
        android:id="@+id/title_tv_title"
        android:layout_width="206dp"
        android:layout_height="wrap_content"
        android:minLines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/FontRegular.20sp"/>
    <ImageView
        android:id="@+id/title_iv_menu"
        android:background="@drawable/button_add_white"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
