<?xml version="1.0" encoding="utf-8"?>
<com.xiaomi.fitness.nfc.widget.IssuedTransCardDetailOptionView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/detailView"
    android:tag="layout/nfc_fragment_transition_detail_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.xiaomi.fitness.nfc.widget.MarqueeTextView
        android:id="@+id/tipsView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/nfc_TextAppearance.BulletinTextView"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/page_content_padding_horizontal_large"
            android:paddingEnd="@dimen/page_content_padding_horizontal_large">
            <FrameLayout
                android:paddingTop="@dimen/nfc_tsm_watch_icon_padding_top"
                android:paddingBottom="@dimen/nfc_tsm_watch_icon_padding_bottom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.xiaomi.fitness.nfc.widget.DeviceImageView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/watch_iv"
                    android:layout_width="@dimen/nfc_device_icon_width"
                    android:layout_height="@dimen/nfc_device_icon_height"/>
                <com.xiaomi.fitness.nfc.widget.InnerCardImageView
                    android:id="@+id/card_detail_iv"
                    android:layout_width="86.4dp"
                    android:layout_height="48.6dp"/>
            </FrameLayout>
            <View
                android:background="@color/common_divider_color"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginTop="20dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="@dimen/nfc_issued_card_list_detail_item_height"
                android:layout_marginTop="20dp">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/red"
                    android:id="@+id/tv_card_invalid_balance"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nfc_invalid_value"
                    android:layout_marginEnd="@dimen/nfc_issued_card_list_detail_invalid_balance_margin_right"
                    style="@style/nfc_TextAppearance.List.Primary"/>
                <TextView
                    android:textSize="@dimen/nfc_common_item_set_title_text_size"
                    android:textColor="@color/text_color"
                    android:gravity="center"
                    android:id="@+id/tv_card_balance"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:layout_marginEnd="@dimen/nfc_issued_card_list_detail_balance_margin_right"/>
                <TextView
                    android:textColor="@color/text_color"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/nfc_card_balance_des"
                    android:includeFontPadding="false"
                    android:layout_weight="1"
                    style="@style/FontMedium.16sp"/>
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/nfc_tsm_text_size_content_medium"
                        android:textColor="@color/nfc_blue_text_selector"
                        android:id="@+id/tv_top_up"
                        android:paddingTop="@dimen/nfc_issued_card_list_detail_top_up_padding_vertical"
                        android:paddingBottom="@dimen/nfc_issued_card_list_detail_top_up_padding_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/nfc_card_detail_recharge_now"
                        android:paddingStart="@dimen/nfc_issued_card_list_detail_item_padding_horizontal"
                        style="@style/nfc_TextAppearance.List.Primary"/>
                    <TextView
                        android:textSize="@dimen/nfc_tsm_text_size_content_medium"
                        android:textColor="@color/nfc_blue_text_selector"
                        android:id="@+id/tv_refresh"
                        android:background="@drawable/nfc_blue_border_selector"
                        android:paddingTop="@dimen/nfc_issued_card_list_detail_top_up_padding_vertical"
                        android:paddingBottom="@dimen/nfc_issued_card_list_detail_top_up_padding_vertical"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/nfc_card_detail_refresh_now"
                        android:paddingStart="@dimen/nfc_issued_card_list_detail_item_padding_horizontal"
                        android:paddingEnd="@dimen/nfc_issued_card_list_detail_item_padding_horizontal"
                        style="@style/nfc_TextAppearance.List.Primary"/>
                </FrameLayout>
            </LinearLayout>
            <com.xiaomi.fitness.nfc.widget.CardSwitcherView
                android:id="@+id/cardSwitchView"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/selectCityView"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/nfc_issued_card_list_detail_item_height">
                    <TextView
                        android:textSize="@dimen/nfc_common_item_set_title_text_size"
                        android:textColor="@color/nfc_setting_item_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/nfc_nextpay_choose_city_title"
                        android:includeFontPadding="false"
                        android:layout_weight="1"
                        style="@style/nfc_TextAppearance.List.Primary"/>
                    <TextView
                        android:textColor="@color/black_70_transparent"
                        android:gravity="end"
                        android:id="@+id/city_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        style="@style/nfc_TextAppearance.List.Secondary"/>
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_base_right_arrow_icon"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:id="@+id/moreView"
                android:layout_width="match_parent"
                android:layout_height="@dimen/nfc_issued_card_list_detail_item_height">
                <TextView
                    android:textColor="@color/text_color"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/nfc_card_detail_more_settings"
                    android:includeFontPadding="false"
                    android:layout_weight="1"
                    style="@style/FontMedium.16sp"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_base_right_arrow_icon"/>
            </LinearLayout>
            <TextView
                android:id="@+id/defaultView"
                android:visibility="gone"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="0dp"
                android:text="@string/nfc_set_default_card"
                android:layout_marginStart="0dp"
                android:layout_marginEnd="0dp"
                style="@style/CommonBtn.Normal"/>
            <TextView
                android:id="@+id/removeCardView"
                android:visibility="visible"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="0dp"
                android:text="@string/nfc_remove_transit_card"
                android:layout_marginStart="0dp"
                android:layout_marginEnd="0dp"
                style="@style/CommonBtn.Normal"/>
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginBottom="60dp"/>
        </LinearLayout>
    </ScrollView>
</com.xiaomi.fitness.nfc.widget.IssuedTransCardDetailOptionView>
