<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/layout_face_category_item_0"
    android:background="@drawable/bg_face_market_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:ellipsize="end"
        android:id="@+id/category_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_22dp"
        android:maxLines="1"
        android:layout_marginStart="@dimen/dimen_margin_18dp"
        app:layout_constraintEnd_toStartOf="@+id/category_all_img"
        app:layout_constraintHorizontal_weight="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/FontMedium.16sp"/>
    <ImageView
        android:id="@+id/category_all_img"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/face_category_more_ic"
        android:layout_marginEnd="@dimen/dimen_margin_9dp"
        app:layout_constraintBottom_toBottomOf="@+id/category_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/category_name"/>
    <com.xiaomi.fitness.watch.face.export.exportview.FaceInfoView
        android:id="@+id/preview_3"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_20dp"
        android:layout_marginBottom="@dimen/dimen_margin_20dp"
        android:tint="#80ffffff"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/category_name"/>
    <com.xiaomi.fitness.watch.face.export.exportview.FaceInfoView
        android:id="@+id/preview_2"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:tint="#4dffffff"
        app:layout_constraintBottom_toBottomOf="@+id/preview_3"
        app:layout_constraintEnd_toEndOf="@+id/preview_3"
        app:layout_constraintTop_toTopOf="@+id/preview_3"/>
    <com.xiaomi.fitness.watch.face.export.exportview.FaceInfoView
        android:id="@+id/preview_1"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/preview_2"
        app:layout_constraintEnd_toEndOf="@+id/preview_2"
        app:layout_constraintTop_toTopOf="@+id/preview_2"/>
</androidx.constraintlayout.widget.ConstraintLayout>
