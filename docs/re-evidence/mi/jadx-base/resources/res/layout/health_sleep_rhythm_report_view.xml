<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:theme="@style/FontMedium.16sp"
        android:gravity="start"
        android:id="@+id/pdf_rhythm_chart_list_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/health_sleep_rhythm"/>
    <include
        android:id="@+id/health_sleep_rhythm_title_des"
        layout="@layout/health_sleep_rhythm_title_des"/>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="vertical"
        android:id="@+id/pdf_rhythm_chart_list_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/text_color"
        android:gravity="start"
        android:id="@+id/pdf_rhythm_diary_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/health_sleep_diary"/>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="horizontal"
        android:id="@+id/pdf_diary_list_rv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/text_color"
        android:gravity="start"
        android:id="@+id/pdf_sleep_detail_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/health_sleep_long_sleep"/>
    <include
        android:id="@+id/health_sleep_detail_title_des"
        layout="@layout/health_sleep_detail_title_des"/>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="vertical"
        android:id="@+id/pdf_sleep_detail_rv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintStart_toStartOf="parent"/>
</LinearLayout>
