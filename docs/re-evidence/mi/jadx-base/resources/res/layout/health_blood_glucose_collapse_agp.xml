<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/blood_glucose_collapse_agp"
    android:background="@drawable/selector_card_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/dimen_margin_12dp"
    android:layout_marginHorizontal="@dimen/page_padding_horizontal_large">
    <include
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dimen_margin_18dp"
        layout="@layout/health_blood_glucose_agp_title"/>
    <include
        android:id="@+id/agp_chart_guide"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_20dp"
        android:layout_marginEnd="@dimen/margin_20dp"
        layout="@layout/layout_blood_glucose_agp_guide"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.xiaomi.fitness.chart.view.LineChartRecyclerView
            android:id="@+id/sport_line_chart_recycler"
            android:paddingTop="10dp"
            android:layout_height="311dp"
            android:paddingStart="@dimen/size_18"
            android:paddingEnd="31.67dp"
            app:displayNumbers="4"
            app:enableEndDayXAxis="true"
            app:enableLineFill="false"
            app:enableStartYAxisLabel="false"
            app:enableXAxisLineCircle="false"
            app:lineHighLightType="4"
            app:lineShaderBeginColor="@color/health_blood_glucose_chart_fill"
            app:lineShaderEndColor="@color/health_blood_glucose_chart_fill"
            app:lineStrokeWidth="3"
            app:xAxisLabelPosition="0"
            style="@style/ChartBaseStyle"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="end|top"
            android:id="@+id/iv_expand"
            android:padding="@dimen/dimen_margin_3dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:paddingStart="@dimen/dimen_margin_18dp"
            android:paddingEnd="@dimen/dimen_margin_10dp"
            android:layout_marginEnd="@dimen/dimen_margin_18dp"
            app:srcCompat="@drawable/iv_health_chart_expand"/>
    </FrameLayout>
    <View
        android:background="@color/common_divider_bg_color"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_0_33"
        android:layout_marginBottom="20dp"
        android:layout_marginHorizontal="@dimen/dimen_margin_18dp"/>
    <TextView
        android:textColor="@color/text_color_40"
        android:id="@+id/health_blood_glucose_agp_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:text="@string/health_blood_glucose_agp_description"
        android:layout_marginHorizontal="@dimen/dimen_margin_18dp"
        style="@style/FontNormal.12sp"/>
    <View
        android:id="@+id/blood_glucose_agp_no_data_divider"
        android:background="@color/common_divider_bg_color"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_0_33"
        android:layout_marginBottom="20dp"
        android:layout_marginHorizontal="@dimen/dimen_margin_18dp"/>
    <TextView
        android:textSize="13.33sp"
        android:textColor="@color/text_color"
        android:id="@+id/blood_glucose_agp_no_data"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_20dp"
        android:text="@string/health_blood_glucose_no_date"
        android:layout_marginHorizontal="@dimen/dimen_margin_12dp"
        style="@style/FontDemiBold.12sp"/>
</LinearLayout>
