<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ll_parent"
    android:tag="layout/health_item_sleep_short_segment_0"
    android:background="@drawable/selector_card_bg"
    android:paddingTop="@dimen/size_20"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/size_12"
    android:paddingHorizontal="@dimen/size_18">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_top_title"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_top_icon"
            android:background="@drawable/health_ic_sleep_short"
            android:layout_width="@dimen/size_30"
            android:layout_height="@dimen/size_30"/>
        <TextView
            android:textColor="@color/text_color"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_top_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/health_sleep_nap_title"
            android:layout_marginStart="@dimen/size_10"
            style="@style/FontMedium.18sp"/>
    </LinearLayout>
    <View
        android:id="@+id/split_line_view"
        android:background="@color/common_divider_bg_color"
        android:paddingTop="-13dp"
        android:paddingBottom="@dimen/size_11_67"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_0_33"/>
    <com.xiaomi.fitness.widget.view.DurationTextView
        android:id="@+id/duration_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_13"
        app:dtv_bold="true"
        app:dtv_dataFont="@font/misanslatin_medium"
        app:dtv_dataTextColor="@color/text_color"
        app:dtv_dataTextSize="@dimen/font_33_3"
        app:dtv_unitTextColor="@color/text_color"
        app:dtv_unitTextFontFamily="@string/mipro_regular"
        app:dtv_unitTextSize="@dimen/font_16_7"
        app:dtv_unitTextStyle="bold"/>
    <TextView
        android:textColor="@color/text_color"
        android:id="@+id/tv_time_range"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/FontMedium.13sp"/>
    <TextView
        android:textColor="@color/text_color_40"
        android:id="@+id/tv_origin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_7"
        android:layout_marginBottom="@dimen/size_21"
        style="@style/FontRegular.12sp"/>
</LinearLayout>
