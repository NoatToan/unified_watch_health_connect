<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/mine_fragment_mine_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <View
                android:id="@+id/mine_view_deep_bg"
                android:background="@color/mine_header_color"
                android:layout_width="match_parent"
                android:layout_height="138dp"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/mine_view_gradient_bg"
                android:layout_width="match_parent"
                android:layout_height="62dp"
                app:layout_constraintTop_toBottomOf="@+id/mine_view_deep_bg"/>
            <com.xiaomi.fitness.widget.view.HomeHeaderView
                android:id="@+id/mine_header"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/dimen_margin_47dp"
                app:header_title="@string/mine_tab_status_name"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:orientation="vertical"
                android:id="@+id/layout_list"
                android:background="@drawable/mine_label_bg_white"
                android:paddingBottom="@dimen/dimen_margin_13dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_32dp"
                android:layout_marginBottom="@dimen/dimen_margin_12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/mine_header">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:orientation="horizontal"
                    android:id="@+id/layout_user"
                    android:background="@drawable/right_arrow_white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/dimen_margin_18dp"
                    android:paddingEnd="@dimen/dimen_margin_18dp">
                    <com.xiaomi.fitness.widget.view.RoundImageView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/user_photo"
                        android:background="@drawable/mine_default_icon"
                        android:layout_width="@dimen/mine_margin_46"
                        android:layout_height="@dimen/mine_margin_46"
                        android:layout_marginTop="@dimen/dimen_margin_20dp"
                        android:layout_marginBottom="@dimen/dimen_margin_20dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <ImageView
                        android:id="@+id/card_set_right_img"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_base_right_arrow_icon"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dimen_margin_16dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/user_photo"
                        app:layout_constraintTop_toTopOf="parent">
                        <TextView
                            android:textColor="@color/mine_black"
                            android:ellipsize="end"
                            android:gravity="start"
                            android:id="@+id/user_name"
                            android:layout_width="208dp"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:textDirection="locale"
                            style="@style/FontMedium.16sp"/>
                        <TextView
                            android:textColor="@color/mine_black"
                            android:id="@+id/user_info"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/mine_margin_2dp"
                            style="@style/FontRegular.12sp"/>
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:orientation="horizontal"
                    android:id="@+id/layout_medal"
                    android:background="@drawable/mine_label_bg_cyan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14.33dp"
                    android:layout_marginStart="@dimen/dimen_margin_18dp"
                    android:layout_marginEnd="@dimen/dimen_margin_18dp"
                    android:paddingHorizontal="@dimen/page_extra_padding_horizontal_large"
                    android:paddingVertical="@dimen/dimen_margin_15dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/layout_user">
                    <ImageView
                        android:id="@+id/medal_img"
                        android:layout_width="wrap_content"
                        android:layout_height="96dp"
                        android:src="@drawable/mine_medal_pic"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/dimen_margin_20dp"
                        app:layout_constraintBottom_toBottomOf="@+id/medal_img"
                        app:layout_constraintEnd_toStartOf="@+id/medal_img"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/medal_img">
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <androidx.appcompat.widget.AppCompatTextView
                                android:textSize="23sp"
                                android:textStyle="bold"
                                android:textColor="@color/mine_line_color"
                                android:id="@+id/medal_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/mine_data_type_medal"
                                android:drawablePadding="@dimen/dimen_margin_4dp"
                                android:drawableEnd="@drawable/mine_medal_icon_dark"/>
                        </LinearLayout>
                        <View
                            android:id="@+id/medal_line"
                            android:background="@drawable/mine_divider_sharp"
                            android:layout_width="@dimen/dimen_margin_125dp"
                            android:layout_height="@dimen/mine_item_divide_height"
                            android:layout_marginTop="@dimen/mine_margin_7dp"/>
                        <TextView
                            android:textSize="@dimen/mine_text_size_13"
                            android:textColor="@color/mine_line_color"
                            android:id="@+id/medal_text_desc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/mine_margin_7dp"
                            style="@style/FontNormal"/>
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_banner"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/dimen_margin_12dp"
                    android:layout_marginHorizontal="@dimen/dimen_margin_18dp"
                    app:layout_constraintDimensionRatio="3.45:1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/layout_medal"/>
                <com.xiaomi.fitness.widget.RightArrowBindingTwoLineTextView
                    android:id="@+id/company_exclusive_entrance"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/page_extra_padding_horizontal_large"
                    app:card_rightValue="update"
                    app:icon="@drawable/ic_company_exclusive_entrance"
                    app:layout_constraintTop_toBottomOf="@+id/iv_banner"
                    app:showMore="true"
                    app:title="@string/mine_company_exclusive_entrance"/>
                <com.xiaomi.fitness.widget.RightArrowBindingTwoLineTextView
                    android:id="@+id/active_pk"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/page_extra_padding_horizontal_large"
                    app:card_rightValue="update"
                    app:icon="@drawable/mine_active_pk"
                    app:layout_constraintTop_toBottomOf="@+id/company_exclusive_entrance"
                    app:showMore="true"
                    app:title="@string/mine_pk_my_pk"/>
                <com.xiaomi.fitness.widget.RightArrowBindingTwoLineTextView
                    android:id="@+id/motion_sensing_course_member"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/page_extra_padding_horizontal_large"
                    app:card_rightValue="update"
                    app:icon="@drawable/mine_weekday_report"
                    app:layout_constraintTop_toBottomOf="@+id/active_pk"
                    app:showMore="true"
                    app:title="@string/mine_motion_sensing_course_vip"/>
                <com.xiaomi.fitness.widget.RightArrowBindingTwoLineTextView
                    android:id="@+id/relative_care"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/page_extra_padding_horizontal_large"
                    app:card_rightValue="update"
                    app:icon="@drawable/relative_care"
                    app:layout_constraintTop_toBottomOf="@+id/motion_sensing_course_member"
                    app:showMore="true"
                    app:title="@string/mine_my_relatives"/>
                <com.xiaomi.fitness.widget.RightArrowBindingTwoLineTextView
                    android:id="@+id/weekly_report"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/page_extra_padding_horizontal_large"
                    app:card_rightValue="update"
                    app:icon="@drawable/mine_weekday_report"
                    app:layout_constraintTop_toBottomOf="@+id/relative_care"
                    app:showMore="true"
                    app:title="@string/mine_weekly_report"/>
                <com.xiaomi.fitness.widget.RightArrowBindingTwoLineTextView
                    android:id="@+id/health_visit_doctor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/page_extra_padding_horizontal_large"
                    app:card_rightValue="update"
                    app:icon="@drawable/pingan_health_care"
                    app:layout_constraintTop_toBottomOf="@+id/weekly_report"
                    app:showMore="true"
                    app:title="@string/mine_health_visit_doctor"/>
                <com.xiaomi.fitness.widget.RightArrowBindingTwoLineTextView
                    android:id="@+id/activity_mine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/page_extra_padding_horizontal_large"
                    app:card_rightValue="update"
                    app:icon="@drawable/mine_activity_icon"
                    app:layout_constraintTop_toBottomOf="@+id/health_visit_doctor"
                    app:showMore="true"
                    app:title="@string/mine_activity"/>
                <com.xiaomi.fitness.widget.RightArrowBindingTwoLineTextView
                    android:id="@+id/course_mine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/page_extra_padding_horizontal_large"
                    app:card_rightValue="update"
                    app:icon="@drawable/mine_course"
                    app:layout_constraintTop_toBottomOf="@+id/activity_mine"
                    app:showMore="true"
                    app:title="@string/mine_my_course_list_title"/>
                <com.xiaomi.fitness.widget.RightArrowBindingTwoLineTextView
                    android:id="@+id/my_track"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/page_extra_padding_horizontal_large"
                    app:card_rightValue="update"
                    app:icon="@drawable/mine_track"
                    app:layout_constraintTop_toBottomOf="@+id/course_mine"
                    app:showMore="true"
                    app:title="@string/mine_my_track"/>
                <com.xiaomi.fitness.widget.RightArrowBindingTwoLineTextView
                    android:id="@+id/habitView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/page_extra_padding_horizontal_large"
                    app:icon="@drawable/mine_habit"
                    app:layout_constraintTop_toBottomOf="@+id/my_track"
                    app:remindTextEnable="true"
                    app:showMore="true"
                    app:title="@string/mine_habit"/>
                <com.xiaomi.fitness.widget.RightArrowBindingTwoLineTextView
                    android:id="@+id/order_page_list"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/page_extra_padding_horizontal_large"
                    app:icon="@drawable/mine_order_list"
                    app:layout_constraintTop_toBottomOf="@+id/habitView"
                    app:remindTextEnable="true"
                    app:showMore="true"
                    app:title="@string/mine_my_order"/>
                <com.xiaomi.fitness.widget.RightArrowBindingTwoLineTextView
                    android:id="@+id/personal_data_management"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/page_extra_padding_horizontal_large"
                    app:icon="@drawable/mine_ic_personal_data_management"
                    app:layout_constraintTop_toBottomOf="@+id/order_page_list"
                    app:showMore="true"
                    app:title="@string/mine_personal_data_management"/>
                <View
                    android:id="@+id/divider_line"
                    android:background="@color/mine_item_divide_color"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/mine_item_divide_height"
                    android:layout_marginTop="@dimen/dimen_margin_20dp"
                    android:layout_marginBottom="@dimen/mine_size_35"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="@dimen/dimen_margin_20dp"
                    app:layout_constraintBottom_toTopOf="@+id/bugreport_mine"
                    app:layout_constraintTop_toBottomOf="@+id/personal_data_management"/>
                <com.xiaomi.fitness.widget.RightArrowBindingTwoLineTextView
                    android:id="@+id/bugreport_mine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_margin_15dp"
                    android:paddingHorizontal="@dimen/page_extra_padding_horizontal_large"
                    app:icon="@drawable/mine_bugreport_icon"
                    app:layout_constraintTop_toBottomOf="@+id/divider_line"
                    app:showMore="true"
                    app:title="@string/mine_bugreport"/>
                <com.xiaomi.fitness.widget.RightArrowBindingTwoLineTextView
                    android:id="@+id/deviceShareView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/page_extra_padding_horizontal_large"
                    app:icon="@drawable/mine_ic_device_share"
                    app:layout_constraintTop_toBottomOf="@+id/bugreport_mine"
                    app:showMore="true"
                    app:title="@string/mine_device_share"/>
                <com.xiaomi.fitness.widget.RightArrowBindingTwoLineTextView
                    android:id="@+id/device_authorization_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/page_extra_padding_horizontal_large"
                    app:icon="@drawable/mine_ic_device_authorization"
                    app:layout_constraintTop_toBottomOf="@+id/deviceShareView"
                    app:showMore="true"
                    app:title="@string/mine_device_authorization"/>
                <com.xiaomi.fitness.widget.RightArrowBindingTwoLineTextView
                    android:id="@+id/setting_mine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/page_extra_padding_horizontal_large"
                    app:icon="@drawable/mine_setting_icon"
                    app:layout_constraintTop_toBottomOf="@+id/device_authorization_view"
                    app:showMore="true"
                    app:title="@string/mine_setting"/>
                <com.xiaomi.fitness.widget.RightArrowBindingTwoLineTextView
                    android:id="@+id/system_permission"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/page_extra_padding_horizontal_large"
                    app:icon="@drawable/mine_ic_system_permission"
                    app:layout_constraintTop_toBottomOf="@+id/setting_mine"
                    app:showMore="true"
                    app:title="@string/mine_system_permission"/>
                <com.xiaomi.fitness.widget.RightArrowBindingTwoLineTextView
                    android:id="@+id/version_mine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/page_extra_padding_horizontal_large"
                    app:icon="@drawable/mine_update_icon"
                    app:layout_constraintTop_toBottomOf="@+id/system_permission"
                    app:remindTextEnable="true"
                    app:showMore="true"
                    app:title="@string/mine_update_version"/>
                <com.xiaomi.fitness.widget.RightArrowBindingTwoLineTextView
                    android:id="@+id/about_mine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/page_extra_padding_horizontal_large"
                    app:icon="@drawable/mine_about_icon"
                    app:layout_constraintTop_toBottomOf="@+id/version_mine"
                    app:showMore="true"
                    app:title="@string/mine_about"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <com.xiaomi.fitness.baseui.widget.ScrollTitleBar
        android:id="@+id/title_bar"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/mine_tab_status_name"/>
</androidx.constraintlayout.widget.ConstraintLayout>
