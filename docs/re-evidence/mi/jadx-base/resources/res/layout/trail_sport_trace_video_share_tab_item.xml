<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/trail_sport_trace_video_share_tab_item_0"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="70dp"
    android:layout_marginVertical="@dimen/dimen_margin_30dp">
    <ImageView
        android:id="@+id/tab_icon"
        android:layout_width="@dimen/dimen_margin_18dp"
        android:layout_height="@dimen/dimen_margin_18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/text_color_30"
        android:id="@+id/tab_item_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4.67dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tab_icon"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/FontMedium.12sp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
