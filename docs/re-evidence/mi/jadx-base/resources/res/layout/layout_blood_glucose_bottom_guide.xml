<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingTop="@dimen/size_6"
    android:paddingBottom="@dimen/size_4"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/chart_common_padding_start"
    android:layout_marginEnd="@dimen/chart_common_padding_start">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                android:layout_gravity="center_vertical"
                android:background="@drawable/shape_blood_glucose_extra_low"
                android:layout_width="@dimen/size_10"
                android:layout_height="@dimen/size_10"/>
            <TextView
                android:textColor="@color/text_color_40"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/health_blood_glucose_extra_low"
                android:paddingStart="@dimen/size_6"
                android:paddingEnd="@dimen/size_10"
                style="@style/FontRegular.12sp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                android:layout_gravity="center_vertical"
                android:background="@drawable/shape_blood_glucose_low"
                android:layout_width="@dimen/size_10"
                android:layout_height="@dimen/size_10"/>
            <TextView
                android:textColor="@color/text_color_40"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/health_blood_glucose_low"
                android:paddingStart="@dimen/size_6"
                android:paddingEnd="@dimen/size_10"
                style="@style/FontRegular.12sp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="end"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                android:layout_gravity="center_vertical"
                android:background="@drawable/shape_blood_glucose_normal"
                android:layout_width="@dimen/size_10"
                android:layout_height="@dimen/size_10"/>
            <TextView
                android:textColor="@color/text_color_40"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/health_blood_glucose_normal"
                android:layout_marginStart="@dimen/size_6"
                style="@style/FontRegular.12sp"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_6dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                android:layout_gravity="center_vertical"
                android:background="@drawable/shape_blood_glucose_high"
                android:layout_width="@dimen/size_10"
                android:layout_height="@dimen/size_10"/>
            <TextView
                android:textColor="@color/text_color_40"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/health_blood_glucose_high"
                android:paddingStart="@dimen/size_6"
                android:paddingEnd="@dimen/size_10"
                style="@style/FontRegular.12sp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                android:layout_gravity="center_vertical"
                android:background="@drawable/shape_blood_glucose_extra_high"
                android:layout_width="@dimen/size_10"
                android:layout_height="@dimen/size_10"/>
            <TextView
                android:textColor="@color/text_color_40"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/health_blood_glucose_extra_high"
                android:paddingStart="@dimen/size_6"
                android:paddingEnd="@dimen/size_10"
                style="@style/FontRegular.12sp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="left"
            android:layout_gravity="center_vertical"
            android:visibility="invisible"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                android:layout_gravity="center_vertical"
                android:background="@drawable/shape_blood_glucose_extra_high"
                android:layout_width="@dimen/size_10"
                android:layout_height="@dimen/size_10"/>
            <TextView
                android:textColor="@color/text_color_40"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/health_blood_glucose_extra_high"
                android:layout_marginStart="@dimen/size_6"
                style="@style/FontRegular.12sp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
