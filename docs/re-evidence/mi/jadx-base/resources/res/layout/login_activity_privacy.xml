<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:tag="layout/login_activity_privacy_0"
    android:background="@color/login_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="@dimen/login_dimen_margin_88dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_margin_26dp"
            android:layout_marginEnd="@dimen/dimen_margin_26dp">
            <TextView
                android:textSize="@dimen/dimen_29sp"
                android:textColor="@color/login_black"
                android:id="@+id/privacy_title_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/FontNormal"/>
            <TextView
                android:textColor="@color/login_black"
                android:id="@+id/privacy_rights_des"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/login_dimen_margin_45dp"
                style="@style/FontRegular.14sp"/>
            <TextView
                android:textColor="@color/login_text_color_999"
                android:id="@+id/common_hint_des"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/login_privacy_necessary_authority"
                style="@style/FontRegular.12sp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/bluetooth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/login_size_30">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dimen_margin_5dp">
                    <ImageView
                        android:layout_width="@dimen/login_dimen_margin_33dp"
                        android:layout_height="@dimen/login_dimen_margin_33dp"
                        android:src="@drawable/bluetooth_icon"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dimen_margin_14dp">
                        <TextView
                            android:textColor="@color/login_black"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/login_bluetooth_title"
                            style="@style/FontMedium.14sp"/>
                        <TextView
                            android:textSize="@dimen/dimen_13sp"
                            android:textColor="@color/login_black_60"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dimen_margin_2dp"
                            android:text="@string/login_bluetooth_title_des"
                            style="@style/FontRegular"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/login_size_30">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dimen_margin_5dp">
                    <ImageView
                        android:layout_gravity="center_horizontal"
                        android:layout_width="@dimen/login_dimen_margin_33dp"
                        android:layout_height="@dimen/login_dimen_margin_33dp"
                        android:src="@drawable/location_icon"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dimen_margin_14dp">
                        <TextView
                            android:textColor="@color/login_black"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/login_location_title"
                            style="@style/FontMedium.14sp"/>
                        <TextView
                            android:textSize="@dimen/dimen_13sp"
                            android:textColor="@color/login_black_60"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dimen_margin_2dp"
                            android:text="@string/login_location_title_des"
                            style="@style/FontRegular"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/login_size_30">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dimen_margin_5dp">
                    <ImageView
                        android:layout_gravity="center_horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/permission_icon"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dimen_margin_14dp">
                        <TextView
                            android:textColor="@color/login_black"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/login_body_title"
                            style="@style/FontMedium.14sp"/>
                        <TextView
                            android:textSize="@dimen/dimen_13sp"
                            android:textColor="@color/login_black_60"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dimen_margin_2dp"
                            android:text="@string/login_body_title_des"
                            style="@style/FontRegular"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp">
                <CheckBox
                    android:id="@+id/agree_all_radio"
                    android:background="@drawable/login_selector_privacy_check"
                    android:padding="5dp"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:checked="false"
                    android:button="@null"/>
                <TextView
                    android:textColor="@color/login_black"
                    android:id="@+id/privacy_agree_all_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_privacy_agree_all"
                    android:layout_marginStart="@dimen/dimen_margin_10dp"
                    style="@style/FontRegular.13sp"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">
                <CheckBox
                    android:id="@+id/agree_miwear_policy_radio"
                    android:background="@drawable/login_selector_privacy_check"
                    android:padding="5dp"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:checked="false"
                    android:button="@null"/>
                <TextView
                    android:autoLink="web"
                    android:id="@+id/agree_miwear_policy_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_privacy_required_agree_policy"
                    android:layout_marginStart="@dimen/dimen_margin_10dp"
                    style="@style/FontRegular.13sp"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">
                <CheckBox
                    android:id="@+id/agree_collect_user_info_radio"
                    android:background="@drawable/login_selector_privacy_check"
                    android:padding="5dp"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:checked="false"
                    android:button="@null"/>
                <TextView
                    android:textColor="@color/login_black"
                    android:autoLink="web"
                    android:id="@+id/agree_collect_user_info_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_privacy_required_agree_collect_info"
                    android:layout_marginStart="@dimen/dimen_margin_10dp"
                    style="@style/FontRegular.13sp"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">
                <CheckBox
                    android:id="@+id/agree_use_location_info_radio"
                    android:background="@drawable/login_selector_privacy_check"
                    android:padding="5dp"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:checked="false"
                    android:button="@null"/>
                <TextView
                    android:textColor="@color/login_black"
                    android:autoLink="web"
                    android:id="@+id/agree_use_location_info_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_privacy_optional_agree_use_location"
                    android:layout_marginStart="@dimen/dimen_margin_10dp"
                    style="@style/FontRegular.13sp"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/experience_kr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">
                <CheckBox
                    android:layout_gravity="top"
                    android:id="@+id/experience_radio_kr"
                    android:background="@drawable/login_selector_privacy_check"
                    android:padding="5dp"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:checked="false"
                    android:button="@null"/>
                <TextView
                    android:autoLink="all"
                    android:id="@+id/privacy_experience_tv_kr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_privacy_add_experience_tips"
                    android:layout_marginStart="@dimen/dimen_margin_10dp"
                    style="@style/FontRegular.13sp"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <TextView
        android:textColor="@color/login_black_60"
        android:id="@+id/privacy_agree_tips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_10dp"
        android:text="@string/login_privacy_agree_tips"
        android:layout_marginStart="@dimen/dimen_margin_26dp"
        android:layout_marginEnd="@dimen/dimen_margin_26dp"
        style="@style/FontRegular.12sp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/privacy_agree_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_14dp"
        android:layout_marginStart="@dimen/dimen_margin_26dp">
        <CheckBox
            android:layout_gravity="center"
            android:id="@+id/privacy_agree_checkbox"
            android:background="@drawable/login_selector_privacy_check"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false"
            android:button="@null"/>
        <TextView
            android:textColor="@color/login_black_60"
            android:autoLink="all"
            android:id="@+id/privacy_agree_action_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_privacy_agree_protocol_and_policy"
            android:layout_marginStart="@dimen/dimen_margin_10dp"
            android:layout_marginEnd="26dp"
            style="@style/FontRegular.12sp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/user_experience"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_14dp"
        android:layout_marginStart="@dimen/dimen_margin_26dp">
        <CheckBox
            android:layout_gravity="center"
            android:id="@+id/experience_radio"
            android:background="@drawable/login_selector_privacy_check"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false"
            android:button="@null"/>
        <TextView
            android:textColor="@color/login_black_60"
            android:autoLink="all"
            android:id="@+id/privacy_experience_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_privacy_add_experience_tips"
            android:layout_marginStart="@dimen/dimen_margin_10dp"
            android:layout_marginEnd="26dp"
            style="@style/FontRegular.12sp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_20dp"
        android:layout_marginBottom="@dimen/login_size_27">
        <TextView
            android:textColor="@color/login_text_white"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/privacy_agree_btn"
            android:background="@drawable/selector_bottom_btn_positive_bg"
            android:layout_width="@dimen/common_btn_single_line_width"
            android:layout_height="wrap_content"
            android:text="@string/agree"
            android:layout_weight="1"
            android:paddingHorizontal="@dimen/size_10"
            android:paddingVertical="12.7dp"
            style="@style/FontMedium.16sp"/>
        <TextView
            android:textColor="@color/login_black"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/privacy_cancel_btn"
            android:background="@drawable/selector_bottom_button_normal"
            android:layout_width="@dimen/common_btn_single_line_width"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_10"
            android:text="@string/common_exit"
            android:layout_weight="1"
            android:paddingHorizontal="@dimen/size_10"
            android:paddingVertical="12.7dp"
            style="@style/FontMedium.16sp"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/font_12"
        android:textColor="@color/text_color_40"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_exit_app"
        android:paddingBottom="@dimen/dimen_margin_5dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_margin_20dp"
        android:paddingHorizontal="@dimen/size_10"/>
</LinearLayout>
