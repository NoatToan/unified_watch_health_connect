<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_ftp_test_result_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/ftpResultClose"
        android:padding="8dp"
        android:layout_width="55dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dimen_margin_50dp"
        android:src="@drawable/ic_close"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.xiaomi.fitness.widget.view.RatioImageView
        android:id="@+id/riderIcon"
        android:padding="5dp"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/ic_ftp_result_common"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toTopOf="@+id/goSportReport"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.364"
        app:layout_constraintVertical_chainStyle="packed"
        app:ratio="1"
        app:shapeAppearance="@style/CourseShapeImage"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/goSportReport"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/font_20"
            android:textStyle="bold"
            android:textColor="@color/sport_detail_color"
            android:id="@+id/tip_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"/>
        <TextView
            android:textSize="@dimen/font_22"
            android:textStyle="bold"
            android:textColor="@color/sport_detail_color"
            android:id="@+id/ftpValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:layout_marginStart="@dimen/margin_5dp"/>
        <ImageView
            android:id="@+id/tip_view_info"
            android:visibility="gone"
            android:layout_width="20.66dp"
            android:layout_height="20.66dp"
            android:layout_marginLeft="10dp"
            android:src="@drawable/ic_rider_level_info"/>
    </LinearLayout>
    <TextView
        android:id="@+id/goSportReport"
        android:text="@string/sport_view_exercise_report"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/CommonBtn.Red"/>
</androidx.constraintlayout.widget.ConstraintLayout>
