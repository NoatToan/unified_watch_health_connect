<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/dimen_margin_15dp"
    android:paddingStart="@dimen/dimen_margin_18dp"
    android:paddingEnd="@dimen/dimen_margin_18dp">
    <TextView
        android:textColor="@color/text_color"
        android:gravity="start|center_vertical"
        android:id="@+id/texDistance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="62dp"
        android:layout_marginEnd="@dimen/size_10"
        style="@style/FontMedium.14sp"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.xiaomi.fitness.health.bloodglucose.HealthSegmentView
            android:id="@+id/paceSegmentView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.xiaomi.fitness.baseui.widget.CircularCoverView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            app:cover_color="@color/common_circular_cover_bg_color"
            app:left_bottom_radius="10dp"
            app:left_top_radius="10dp"
            app:right_bottom_radius="10dp"
            app:right_top_radius="10dp"/>
    </RelativeLayout>
</LinearLayout>
