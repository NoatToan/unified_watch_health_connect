<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:tag="layout/activity_ability_plan_date_0"
    android:background="@color/page_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.xiaomi.fitness.training_plan_export.widget.TrainingPlanTitleBar
        android:id="@+id/titlebar"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginTop="@dimen/dimen_margin_36dp"
        android:layout_alignParentTop="true"
        android:layout_marginStart="21dp"/>
    <include
        android:id="@+id/progressLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_10dp"
        android:layout_below="@+id/titlebar"
        android:layout_marginStart="@dimen/dimen_margin_12dp"
        android:layout_marginEnd="@dimen/dimen_margin_12dp"
        layout="@layout/ability_plan_create_progress_layout"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/dataContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_12dp"
        android:layout_below="@+id/progressLayout"
        android:layout_marginStart="@dimen/dimen_margin_12dp"
        android:layout_marginEnd="@dimen/dimen_margin_12dp"/>
    <TextView
        android:textSize="17sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/nextStep"
        android:background="@drawable/bottom_button_selector"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="29dp"
        android:text="@string/training_plan_ability_generate"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="29dp"
        android:layout_marginEnd="29dp"/>
    <Button
        android:id="@+id/stopDemo"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
