<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutView"
    android:tag="layout/nfc_fragment_tsm_result_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/page_content_padding_horizontal_large"
    android:paddingEnd="@dimen/page_content_padding_horizontal_large">
    <LinearLayout
        android:orientation="vertical"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/resultLayoutView"
            android:paddingTop="@dimen/nfc_tsm_content_margin_default"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignWithParentIfMissing="true"
            android:paddingStart="@dimen/nfc_tsm_content_margin_default"
            android:paddingEnd="@dimen/nfc_tsm_content_margin_default">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/nfc_card_recharge_image_margin_top"
                android:src="@drawable/nfc_card_issue_success_big"/>
            <TextView
                android:textAppearance="@style/nfc_TextAppearance.Large"
                android:textSize="24sp"
                android:textColor="@color/nfc_nextpay_transit_result_success_content_color"
                android:id="@+id/resultTitleView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/nfc_card_recharge_text_margin_top"
                android:layout_marginBottom="@dimen/nfc_card_recharge_text_interval_margin"
                android:text="@string/nfc_common_complete"/>
            <TextView
                android:textAppearance="@style/nfc_TextAppearance.Normal.Grey"
                android:id="@+id/resultSubView"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nfc_card_recharge_success_sub"/>
            <TextView
                android:textAppearance="@style/nfc_TextAppearance.Normal.Grey"
                android:id="@+id/resultMoreView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/nfc_card_recharge_text_margin_below"/>
        </LinearLayout>
        <include
            android:id="@+id/rechargeResultLayoutView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            layout="@layout/nfc_fragment_recharge_result"/>
    </LinearLayout>
    <TextView
        android:id="@+id/finishView"
        android:visibility="gone"
        android:layout_marginBottom="20dp"
        android:text="@string/nfc_common_complete"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        style="@style/BaseButton.Positive"/>
</RelativeLayout>
