<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="70dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:layout_marginEnd="@dimen/size_12">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="start|bottom"
        android:background="@drawable/common_card_bg_white"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp">
        <ImageView
            android:id="@+id/icon"
            android:layout_width="@dimen/dimen_margin_30dp"
            android:layout_height="@dimen/dimen_margin_30dp"
            android:layout_marginStart="@dimen/dimen_margin_18dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:ellipsize="end"
            android:id="@+id/name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="@dimen/dimen_margin_20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/icon"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/FontMedium.14sp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:layout_gravity="end|top"
        android:id="@+id/icon_saved"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/health_show_all_health_data_icon_add"/>
</FrameLayout>
