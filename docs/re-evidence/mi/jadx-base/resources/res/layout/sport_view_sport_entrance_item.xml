<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="113dp">
    <ImageView
        android:id="@+id/sportLogo"
        android:layout_width="37dp"
        android:layout_height="37dp"
        android:layout_marginTop="@dimen/dimen_margin_20dp"
        android:layout_marginStart="@dimen/page_extra_padding_horizontal_large"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/startGo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="21.7dp"
        android:layout_marginEnd="@dimen/dimen_margin_18dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="16.5dp"
        android:textStyle="bold"
        android:textColor="@color/sport_color_black"
        android:gravity="bottom"
        android:id="@+id/sportTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_19"
        android:layout_marginBottom="@dimen/dimen_margin_23dp"
        android:text="@{normalSportBean.titleLeft}"
        android:fontFamily="@font/misanslatin_medium"
        android:paddingEnd="@dimen/margin_40dp"
        android:layout_marginStart="@dimen/page_extra_padding_horizontal_large"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sportLogo"/>
    <TextView
        android:textSize="16.5dp"
        android:textStyle="bold"
        android:textColor="@color/sport_color_black"
        android:gravity="bottom"
        android:id="@+id/sportTitleSpace"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_19"
        android:layout_marginBottom="@dimen/dimen_margin_23dp"
        android:fontFamily="@font/misanslatin_medium"
        android:paddingEnd="@dimen/margin_40dp"
        android:layout_marginStart="@dimen/page_extra_padding_horizontal_large"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sportLogo"/>
</androidx.constraintlayout.widget.ConstraintLayout>
