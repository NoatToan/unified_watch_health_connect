<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/training_plan_layout_report_basic_info_0"
    android:padding="5dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/root_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ability_basic_view"
            android:paddingBottom="@dimen/dimen_margin_10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="@color/text_color"
                android:id="@+id/train_condition_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_20dp"
                android:text="@string/training_plan_ability_finish_percent"
                android:layout_marginStart="@dimen/dimen_margin_20dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/FontMedium.15sp"/>
            <TextView
                android:textSize="52dp"
                android:textColor="@color/text_color"
                android:id="@+id/train_condition_probability"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_2dp"
                android:fontFamily="@font/misanslatin_demibold"
                app:layout_constraintStart_toStartOf="@+id/train_condition_title"
                app:layout_constraintTop_toBottomOf="@+id/train_condition_title"/>
            <TextView
                android:textColor="@color/text_color"
                android:id="@+id/train_condition_probability_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp"
                android:text="%"
                android:layout_marginStart="@dimen/dimen_margin_5dp"
                app:layout_constraintBottom_toBottomOf="@+id/train_condition_probability"
                app:layout_constraintStart_toEndOf="@+id/train_condition_probability"
                style="@style/FontMedium.16sp"/>
            <com.xiaomi.fitness.widget.view.RoundImageView
                android:id="@+id/train_user_icon"
                android:background="@drawable/ic_common_avatar_default"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="@dimen/dimen_margin_20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/text_color_40"
                android:ellipsize="end"
                android:gravity="end"
                android:id="@+id/train_user_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:layout_marginEnd="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/train_user_icon"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/text_color_40"
                android:gravity="end"
                android:id="@+id/train_condition_probability_des"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_5dp"
                android:layout_marginEnd="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/train_user_name"/>
            <miuix.androidbasewidget.widget.ProgressBar
                android:id="@+id/train_condition_probability_progress"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="16dp"
                android:progress="20"
                android:progressDrawable="@drawable/ability_plan_create_progress"
                android:layout_marginHorizontal="20dp"
                app:layout_constraintTop_toBottomOf="@+id/train_condition_probability_des"
                style="?attr/progressBarHorizontalStyle"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/habit_basic_view"
            android:padding="@dimen/dimen_margin_20dp"
            android:paddingBottom="@dimen/dimen_margin_10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.xiaomi.fitness.widget.view.RoundImageView
                android:id="@+id/habit_train_user_icon"
                android:background="@drawable/ic_common_avatar_default"
                android:layout_width="35dp"
                android:layout_height="35dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/text_color_40"
                android:ellipsize="end"
                android:gravity="end"
                android:id="@+id/habit_train_user_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:layout_marginStart="@dimen/dimen_margin_5dp"
                app:layout_constraintStart_toEndOf="@+id/habit_train_user_icon"
                app:layout_constraintTop_toTopOf="@+id/habit_train_user_icon"/>
            <TextView
                android:textColor="@color/text_color_40"
                android:gravity="end"
                android:id="@+id/habit_train_user_icon_train_condition_probability_des"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@+id/habit_train_user_icon"
                app:layout_constraintStart_toStartOf="@+id/habit_train_user_name"
                style="@style/FontRegular.12sp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/train_plan_basic_info_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_16dp"
        android:overScrollMode="never"
        android:layout_marginStart="@dimen/dimen_margin_20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/root_view"/>
</androidx.constraintlayout.widget.ConstraintLayout>
