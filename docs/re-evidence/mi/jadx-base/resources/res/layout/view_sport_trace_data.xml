<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/trace_data_contain"
    android:tag="layout/view_sport_trace_data_0"
    android:background="@drawable/shape_sport_trace_bg"
    android:paddingBottom="@dimen/dimen_margin_22dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/dimen_margin_20dp"
    android:paddingEnd="@dimen/dimen_margin_20dp">
    <com.xiaomi.fitness.share.view.TraceAMapDistanceView
        android:textSize="47dp"
        android:textColor="@color/white"
        android:id="@+id/distanceView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="73dp"
        android:text="--"
        android:fontFamily="@font/misanslatin_bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/font_10"
        android:id="@+id/sportType"
        android:background="@drawable/shape_sporttype_bg"
        android:padding="@dimen/dimen_margin_2dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_25dp"
        android:text="--"
        android:fontFamily="@font/misanslatin_semibold"
        android:layout_marginStart="@dimen/dimen_margin_15dp"
        app:layout_constraintStart_toEndOf="@+id/distanceView"
        app:layout_constraintTop_toTopOf="@+id/distanceView"/>
    <TextView
        android:textSize="@dimen/font_17"
        android:textColor="@color/white"
        android:id="@+id/distance_unit"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_margin_15dp"
        android:text="@string/trail_label_km"
        android:fontFamily="@font/misanslatin_medium"
        app:layout_constraintBottom_toBottomOf="@+id/distanceView"
        app:layout_constraintStart_toStartOf="@+id/sportType"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="132.3dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/distance_unit"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView
            android:textSize="10dp"
            android:textColor="@color/trail_sport_min_speed"
            android:id="@+id/slow_speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/trail_sport_low_speed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:background="@drawable/trail_sport_trace_speed"
            android:layout_width="0dp"
            android:layout_height="1.3dp"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            app:layout_constraintBottom_toBottomOf="@+id/slow_speed"
            app:layout_constraintEnd_toStartOf="@+id/fast_speed"
            app:layout_constraintStart_toEndOf="@+id/slow_speed"
            app:layout_constraintTop_toTopOf="@+id/slow_speed"/>
        <TextView
            android:textSize="10dp"
            android:textColor="@color/trail_sport_max_speed"
            android:id="@+id/fast_speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/trail_sport_fast_speed"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.xiaomi.fitness.share.view.TrackLineView
        android:id="@+id/trackLineView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/sport_data_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/distanceView"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/sport_data_layout"
        android:tag="binding_1"
        android:layout_width="@dimen/dimen_margin_0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/trackLineView">
        <include
            android:id="@+id/trace_item_data"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            layout="@layout/view_trace_item_data"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/editLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_20dp"
        android:layout_marginStart="@dimen/dimen_margin_6dp"
        android:layout_marginEnd="@dimen/dimen_margin_6dp"
        app:layout_constraintTop_toBottomOf="@+id/sport_data_layout">
        <TextView
            android:textSize="@dimen/text_size_16"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/saveVideo"
            android:background="@drawable/selector_bottom_button_red"
            android:layout_width="0dp"
            android:layout_height="@dimen/dimen_margin_47dp"
            android:text="@string/trail_sport_save_video"
            android:fontFamily="@font/misanslatin_heavy"
            app:layout_constraintEnd_toStartOf="@+id/edit"
            app:layout_constraintHorizontal_weight="4"
            app:layout_constraintStart_toStartOf="parent"/>
        <ImageView
            android:id="@+id/edit"
            android:background="@drawable/view_edit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/trail_sport_edit"
            android:layout_marginStart="@dimen/dimen_margin_13dp"
            app:layout_constraintBottom_toBottomOf="@+id/saveVideo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@+id/saveVideo"
            app:layout_constraintTop_toTopOf="@+id/saveVideo"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
