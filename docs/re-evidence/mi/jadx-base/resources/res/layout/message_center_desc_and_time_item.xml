<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/message_center_desc_and_time_item_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/message_center_horizontal_padding">
    <FrameLayout
        android:id="@+id/fl_avatar"
        android:background="@drawable/message_center_avatar_divider_color"
        android:layout_width="40.3dp"
        android:layout_height="40.3dp"
        android:layout_marginVertical="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.xiaomi.fitness.widget.view.RoundImageView
            android:layout_gravity="center"
            android:id="@+id/iv_avatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_common_avatar_default"/>
    </FrameLayout>
    <TextView
        android:textColor="@color/text_color"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/tv_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="3"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/barrier2"
        app:layout_constraintStart_toEndOf="@+id/fl_avatar"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/FontRegular.14sp"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:constraint_referenced_ids="tv_time,tv_status"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:constraint_referenced_ids="tv_time,tv_status,iv_dot"/>
    <TextView
        android:textColor="@color/text_color_40"
        android:id="@+id/tv_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/tv_status"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/FontNormal.12sp"/>
    <TextView
        android:textColor="@color/text_color_40"
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_time"
        style="@style/FontNormal.12sp"/>
    <ImageView
        android:id="@+id/iv_dot"
        android:visibility="gone"
        android:layout_width="7dp"
        android:layout_height="7dp"
        android:src="@drawable/icon_feature_item_remind"
        android:translationY="@dimen/dimen_margin_1dp"
        android:importantForAccessibility="no"
        android:layout_marginEnd="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/barrier1"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
