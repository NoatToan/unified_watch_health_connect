<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/course_eco_launch_layout_video_0"
    android:background="@drawable/course_selector_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginEnd="23dp"
    android:layout_marginVertical="13.33dp">
    <com.xiaomi.fitness.widget.view.RatioImageView
        android:id="@+id/imgView"
        android:layout_width="118dp"
        android:layout_height="67dp"
        android:scaleType="centerCrop"
        android:layout_marginStart="@dimen/page_padding_horizontal_large"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearance="@style/CourseShapeImage"/>
    <TextView
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/course_black"
        android:ellipsize="end"
        android:id="@+id/titleView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toTopOf="@+id/dataView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/imgView"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/course_desc"
        android:id="@+id/dataView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/titleView"
        app:layout_constraintTop_toBottomOf="@+id/titleView"/>
</androidx.constraintlayout.widget.ConstraintLayout>
