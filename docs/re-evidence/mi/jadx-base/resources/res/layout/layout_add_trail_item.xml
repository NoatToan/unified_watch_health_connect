<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/trail_select_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/dimen_margin_12dp"
    android:layout_marginBottom="@dimen/dimen_margin_18dp"
    android:layout_marginStart="@dimen/dimen_margin_12dp"
    android:layout_marginEnd="@dimen/dimen_margin_12dp">
    <TextView
        android:id="@+id/type_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_20dp"
        android:layout_marginStart="@dimen/dimen_margin_18dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/FontRegular.12sp"/>
    <TextView
        android:textSize="@dimen/dimen_29sp"
        android:id="@+id/type_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_20dp"
        android:paddingEnd="@dimen/margin_10dp"
        app:layout_constraintStart_toStartOf="@+id/type_name"
        app:layout_constraintTop_toBottomOf="@+id/type_name"
        style="@style/FontRegular"/>
    <TextView
        android:id="@+id/type_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_margin_2dp"
        app:layout_constraintBottom_toBottomOf="@+id/type_value"
        app:layout_constraintStart_toEndOf="@+id/type_value"
        style="@style/FontRegular.14sp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
