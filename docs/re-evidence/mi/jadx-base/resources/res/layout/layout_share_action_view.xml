<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/img_play"
        android:visibility="gone"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/ic_play_circle_outline_black_24dp"
        android:scaleType="center"
        android:layout_centerInParent="true"
        android:contentDescription="play button"/>
    <com.xiaomi.fitness.share.view.ShareLogoContainer
        android:id="@+id/shareLogoContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_margin_25dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="23dp"
        app:img_width="33dp"
        app:txt_size="@dimen/dimen_16sp"/>
    <RelativeLayout
        android:id="@+id/rl_share_wx"
        android:background="@drawable/share_path_video_bottom_bg_gradient"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_alignParentBottom="true">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_share_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_15dp"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true">
            <TextView
                android:textSize="@dimen/dimen_12sp"
                android:textColor="@color/common_white"
                android:gravity="center_vertical"
                android:layout_gravity="center"
                android:id="@+id/share_save_ablum"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/trail_sport_share_video_save_ablum"/>
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/img_share_wx"
                android:layout_width="@dimen/dimen_margin_40dp"
                android:layout_height="@dimen/dimen_margin_40dp"
                android:layout_marginTop="@dimen/dimen_margin_5dp"
                android:src="@drawable/share_wx_session"/>
        </LinearLayout>
    </RelativeLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/btn_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_margin_25dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true">
        <TextView
            android:textSize="12sp"
            android:id="@+id/btn_share_save_video"
            android:visibility="gone"
            android:layout_width="246.67dp"
            android:layout_height="45dp"
            android:layout_margin="20dp"
            android:text="@string/trail_share_save_path_video"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/CommonBtn.Primary"/>
        <ImageView
            android:id="@+id/btn_edit_video"
            android:background="@drawable/ic_trail_share_video_edit"
            android:layout_width="46.67dp"
            android:layout_height="46.67dp"
            android:contentDescription="@string/trail_sport_map_edit"
            android:layout_marginStart="13.33dp"
            app:layout_constraintBottom_toBottomOf="@+id/btn_share_save_video"
            app:layout_constraintStart_toEndOf="@+id/btn_share_save_video"
            app:layout_constraintTop_toTopOf="@+id/btn_share_save_video"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</RelativeLayout>
