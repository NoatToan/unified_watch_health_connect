<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="14dp"
        android:textColor="@color/sport_indoor_run"
        android:id="@+id/detail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_15dp"
        android:text="@string/sport_gym_plaec"
        android:paddingStart="@dimen/dimen_margin_25dp"
        android:paddingEnd="@dimen/dimen_margin_25dp"
        android:layout_marginStart="@dimen/dimen_margin_25dp"
        android:layout_marginEnd="@dimen/dimen_margin_25dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ImageView
        android:id="@+id/bg"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="34dp"
        android:src="@drawable/gym_place"
        android:layout_marginStart="@dimen/dimen_margin_25dp"
        android:layout_marginEnd="@dimen/dimen_margin_25dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/detail"/>
    <TextView
        android:textSize="15dp"
        android:textColor="@color/common_white"
        android:gravity="center"
        android:id="@+id/notSport"
        android:background="@drawable/shape_ff612e"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="46dp"
        android:layout_marginTop="34dp"
        android:text="@string/common_known"
        android:layout_marginStart="@dimen/dimen_margin_25dp"
        android:layout_marginEnd="@dimen/dimen_margin_25dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bg"/>
    <View
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="@dimen/dimen_margin_25dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/notSport"/>
</androidx.constraintlayout.widget.ConstraintLayout>
