<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rl_login"
    android:tag="layout/layout_data_login_info_0"
    android:background="@drawable/selector_round"
    android:paddingBottom="@dimen/size_20"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/img_login"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="@dimen/margin_20dp"
        android:src="@drawable/health_login_def_avatar"
        android:scaleType="fitXY"
        android:layout_marginStart="@dimen/margin_20dp"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textColor="@color/health_home_txt_color"
        android:id="@+id/txt_login_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_18"
        android:layout_marginStart="@dimen/size_10"
        android:layout_marginEnd="@dimen/size_40"
        android:layout_toEndOf="@+id/img_login"
        style="@style/FontMedium.16sp"/>
    <TextView
        android:textSize="@dimen/dimen_12sp"
        android:textColor="@color/health_home_txt_color"
        android:id="@+id/txt_login_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_below="@+id/txt_login_title"
        android:layout_marginStart="@dimen/size_10"
        android:layout_marginEnd="@dimen/size_40"
        android:layout_toEndOf="@+id/img_login"
        style="@style/FontRegular.11sp"/>
    <ImageView
        android:id="@+id/arrow_right_arrow_imgv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_right_arrow_icon"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/size_18"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
