<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/dimen_margin_26dp">
    <ImageView
        android:id="@+id/power_low_img"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/face_detail_power_level_low_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:id="@+id/power_low_tips"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/face_detail_power_level_low_desc"
        android:layout_marginStart="@dimen/dimen_margin_4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/power_low_img"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/power_mid_img"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/face_detail_power_level_mid_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/power_mid_tips"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:id="@+id/power_mid_tips"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/face_detail_power_level_mid_desc"
        android:layout_marginStart="@dimen/dimen_margin_4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/power_mid_img"
        app:layout_constraintTop_toBottomOf="@+id/power_low_tips"/>
    <ImageView
        android:id="@+id/power_high_img"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/face_detail_power_level_high_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/power_high_tips"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:id="@+id/power_high_tips"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/face_detail_power_level_high_desc"
        android:layout_marginStart="@dimen/dimen_margin_4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/power_low_img"
        app:layout_constraintTop_toBottomOf="@+id/power_mid_tips"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:id="@+id/power_tips"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/face_detail_power_level_tips"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="@+id/power_high_tips"
        app:layout_constraintTop_toBottomOf="@+id/power_high_tips"/>
</androidx.constraintlayout.widget.ConstraintLayout>
