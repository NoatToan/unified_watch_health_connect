<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/right_arrow_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/page_content_padding_horizontal_large"
    android:paddingEnd="@dimen/page_content_padding_horizontal_large">
    <View
        android:id="@+id/divider_view"
        android:background="@color/black_10_transparent"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"/>
    <TextView
        android:textSize="@dimen/dimen_12sp"
        android:textColor="@color/selector_feature_item_title_text_color"
        android:gravity="start|center_vertical"
        android:id="@+id/label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="33dp"
        android:text="@string/device_settings_ble_watch_widget_disable_label"
        android:textDirection="locale"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tip_info"
        android:background="@drawable/right_arrow_white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="@dimen/dimen_margin_20dp">
        <View
            android:id="@+id/bg"
            android:background="@drawable/item_tool_invisible"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/icon"
            android:layout_width="wrap_content"
            android:layout_height="31dp"
            android:layout_marginTop="24dp"
            android:src="@drawable/tool_invisible"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/bg"/>
        <TextView
            android:textColor="@color/selector_feature_item_title_text_color"
            android:id="@+id/desc_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="@string/device_settings_widget_disable_info"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/icon"
            style="@style/DataItemTxt10sp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
