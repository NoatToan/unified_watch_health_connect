<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.xiaomi.fitness.widget.view.RoundImageView
        android:id="@+id/avatarView"
        android:layout_width="28.6dp"
        android:layout_height="28.6dp"
        app:layout_constraintBottom_toBottomOf="@+id/des_group"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/des_group"/>
    <RelativeLayout
        android:id="@+id/des_group"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/avatarView"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="13sp"
            android:textColor="@color/white"
            android:id="@+id/nameView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_marginStart="5dp"
            style="@style/FontMedium"/>
        <TextView
            android:textSize="@dimen/dimen_11sp"
            android:textColor="@color/white_90_transparent"
            android:id="@+id/timeView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/nameView"
            android:layout_marginStart="5dp"/>
        <TextView
            android:textSize="@dimen/dimen_11sp"
            android:textColor="@color/white_80_transparent"
            android:id="@+id/desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/health_target_dynamic_indicators"
            android:layout_below="@+id/nameView"
            android:layout_toEndOf="@+id/timeView"
            app:layout_constraintStart_toEndOf="@+id/timeView"
            app:layout_constraintTop_toTopOf="@+id/timeView"/>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
