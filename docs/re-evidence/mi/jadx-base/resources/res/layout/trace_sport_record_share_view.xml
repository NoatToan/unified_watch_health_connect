<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/topLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.tabs.TabLayout
            android:textSize="@dimen/text_size_12"
            android:id="@+id/tabLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:tabGravity="center"
            app:tabIndicatorFullWidth="false"
            app:tabIndicatorHeight="0dp"
            app:tabMode="fixed"
            app:tabTextColor="@color/white_90"
            style="@style/FontNormal"/>
        <TextView
            android:textSize="@dimen/font_12_7"
            android:textColor="@color/health_share_card_item_confirm_color"
            android:layout_gravity="center"
            android:id="@+id/confirmTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/common_complete"
            android:paddingHorizontal="20dp"/>
    </LinearLayout>
    <View
        android:background="@color/white_15_transparent"
        android:layout_width="match_parent"
        android:layout_height="0.3dp"
        android:layout_below="@+id/topLayout"/>
    <include
        android:id="@+id/first_recyclerView"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/topLayout"
        android:layout_marginStart="@dimen/dimen_margin_20dp"
        layout="@layout/trace_sport_record_share_two_text_view"/>
    <include
        android:id="@+id/second_recyclerView"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/topLayout"
        android:layout_marginStart="@dimen/dimen_margin_20dp"
        layout="@layout/trace_sport_record_share_two_text_view"/>
    <include
        android:id="@+id/third_recyclerView"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/topLayout"
        android:layout_marginStart="@dimen/dimen_margin_20dp"
        layout="@layout/trace_sport_record_share_two_text_view"/>
    <include
        android:id="@+id/four_recyclerView"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/topLayout"
        android:layout_marginStart="@dimen/dimen_margin_20dp"
        layout="@layout/trace_sport_record_share_two_text_view"/>
</RelativeLayout>
