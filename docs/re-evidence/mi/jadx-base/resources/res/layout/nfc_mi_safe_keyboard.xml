<?xml version="1.0" encoding="utf-8"?>
<com.xiaomi.fitness.nfc.widget.SafeKeyboardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/keyboard"
    android:focusable="false"
    android:focusableInTouchMode="false"
    android:visibility="gone"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/keyboard_bar"
        android:background="@drawable/nfc_safe_keyboard_bar_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nfc_safe_keyboard_bar_height">
        <TextView
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nfc_safe_keyboard_title"
            style="@style/nfc_TextAppearance.Keyboard.Title"/>
        <ImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/hide_icon"
            android:background="@android:color/transparent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/nfc_safe_keyboard_key_hide"
            android:layout_marginEnd="@dimen/nfc_safe_keyboard_bar_hide_icon_margin_right"/>
    </FrameLayout>
    <TableLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stretchColumns="*">
        <TableRow>
            <TextView
                android:id="@+id/key1"
                android:tag="@integer/nfc_keyboard_keycode_1"
                style="@style/nfc_Keyboard.Key"/>
            <TextView
                android:id="@+id/key2"
                android:tag="@integer/nfc_keyboard_keycode_2"
                style="@style/nfc_Keyboard.Key"/>
            <TextView
                android:id="@+id/key3"
                android:tag="@integer/nfc_keyboard_keycode_3"
                style="@style/nfc_Keyboard.Key"/>
        </TableRow>
        <TableRow>
            <TextView
                android:id="@+id/key4"
                android:tag="@integer/nfc_keyboard_keycode_4"
                style="@style/nfc_Keyboard.Key"/>
            <TextView
                android:id="@+id/key5"
                android:tag="@integer/nfc_keyboard_keycode_5"
                style="@style/nfc_Keyboard.Key"/>
            <TextView
                android:id="@+id/key6"
                android:tag="@integer/nfc_keyboard_keycode_6"
                style="@style/nfc_Keyboard.Key"/>
        </TableRow>
        <TableRow>
            <TextView
                android:id="@+id/key7"
                android:tag="@integer/nfc_keyboard_keycode_7"
                style="@style/nfc_Keyboard.Key"/>
            <TextView
                android:id="@+id/key8"
                android:tag="@integer/nfc_keyboard_keycode_8"
                style="@style/nfc_Keyboard.Key"/>
            <TextView
                android:id="@+id/key9"
                android:tag="@integer/nfc_keyboard_keycode_9"
                style="@style/nfc_Keyboard.Key"/>
        </TableRow>
        <TableRow>
            <TextView
                android:id="@+id/key_special"
                style="@style/nfc_Keyboard.Key.Special"/>
            <TextView
                android:id="@+id/key0"
                android:tag="@integer/nfc_keyboard_keycode_0"
                style="@style/nfc_Keyboard.Key"/>
            <ImageButton
                android:id="@+id/key_del"
                android:tag="67"
                android:src="@drawable/safe_keyboard_key_delete"
                android:contentDescription="@string/common_delete"
                style="@style/nfc_Keyboard.Key.Special"/>
        </TableRow>
    </TableLayout>
</com.xiaomi.fitness.nfc.widget.SafeKeyboardView>
