<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:ui="http://schemas.android.com/apk/res-auto"
    android:tag="layout/nfc_fragment_issue_recharg_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/contentLayoutView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/page_content_padding_horizontal_large"
        android:paddingEnd="@dimen/page_content_padding_horizontal_large">
        <com.xiaomi.fitness.nfc.widget.MarqueeTextView
            android:id="@+id/tipsView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/nfc_TextAppearance.BulletinTextView"/>
        <RelativeLayout
            android:id="@+id/nextpay_card_recharge_rl_content"
            android:paddingBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/cardFaceView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:layout_centerHorizontal="true"/>
            <View
                android:id="@+id/lineView1"
                android:background="@color/nfc_line"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:layout_below="@+id/cardFaceView"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/nextpay_card_recharge_fee_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lineView1">
                <com.xiaomi.fitness.nfc.widget.PhoneNumVerifyView
                    android:id="@+id/phoneVerifyNumView"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:minHeight="100dp"/>
                <TextView
                    android:textSize="@dimen/nfc_tsm_text_size_content_medium"
                    android:textColor="@color/nfc_issue_recharge_subtitle"
                    android:id="@+id/nextpay_card_recharge_fee_list_title_tv"
                    android:text="@string/nfc_nextpay_card_recharge_recharge_info"
                    android:layout_alignParentTop="true"
                    style="@style/nfc_TextAppearance.Content.Light"/>
                <com.xiaomi.fitness.nfc.widget.ScrollEmbeddedGridView
                    android:id="@+id/feeListView"
                    android:scrollbars="none"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/nfc_card_recharge_grid_margin_top"
                    android:layout_marginBottom="@dimen/nfc_nextpay_card_recharge_fee_list_margin_bottom"
                    android:horizontalSpacing="@dimen/nfc_nextpay_card_recharge_fee_list_horizontal_spacing"
                    android:verticalSpacing="@dimen/nfc_nextpay_card_recharge_fee_list_vertical_spacing"
                    android:numColumns="3"/>
            </LinearLayout>
            <View
                android:id="@+id/lineView2"
                android:background="@color/nfc_line"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:layout_below="@+id/nextpay_card_recharge_fee_layout"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lineView2">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/card_recharge_transfer_layout"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.xiaomi.fitness.nfc.widget.RechargeItemView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        ui:nfc_leftText="@string/nfc_card_recharge_transfer_in_op_item_left_text"
                        ui:nfc_leftTextColor="@color/nfc_setting_item_title"
                        ui:nfc_leftTextSize="@dimen/common_item_set_title_text_size"
                        ui:nfc_rightText="@string/nfc_card_recharge_transfer_in_op_item_right_text"
                        ui:nfc_rightTextColor="@color/nfc_card_issue_list_text_color_gray"
                        ui:nfc_rightTextSize="@dimen/nfc_card_issue_list_item_second_title_text_size"/>
                    <com.xiaomi.fitness.nfc.widget.RechargeItemView
                        android:id="@+id/card_recharge_item_transfer_in_balance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        ui:nfc_leftText="@string/nfc_card_recharge_transfer_in_balance_item_left_text"
                        ui:nfc_leftTextColor="@color/nfc_setting_item_title"
                        ui:nfc_leftTextSize="@dimen/common_item_set_title_text_size"
                        ui:nfc_rightTextColor="@color/nfc_card_issue_list_text_color_gray"
                        ui:nfc_rightTextSize="@dimen/nfc_card_issue_list_item_second_title_text_size"/>
                    <com.xiaomi.fitness.nfc.widget.RechargeItemView
                        android:id="@+id/card_recharge_item_transfer_in_fee"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        ui:nfc_leftText="@string/nfc_card_recharge_transfer_in_fee_item_text"
                        ui:nfc_leftTextColor="@color/nfc_setting_item_title"
                        ui:nfc_leftTextSize="@dimen/common_item_set_title_text_size"
                        ui:nfc_rightTextColor="@color/nfc_card_issue_list_text_color_gray"
                        ui:nfc_rightTextSize="@dimen/nfc_card_issue_list_item_second_title_text_size"/>
                </LinearLayout>
                <com.xiaomi.fitness.nfc.widget.RechargeItemView
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    ui:nfc_leftText="@string/nfc_card_recharge_issue_quantity_item_text"
                    ui:nfc_leftTextColor="@color/nfc_setting_item_title"
                    ui:nfc_leftTextSize="@dimen/common_item_set_title_text_size"
                    ui:nfc_rightTextColor="@color/nfc_card_issue_list_text_color_gray"
                    ui:nfc_rightTextSize="@dimen/nfc_card_issue_list_item_second_title_text_size"
                    ui:nfc_showRightArrow="true"/>
                <com.xiaomi.fitness.nfc.widget.RechargeItemView
                    android:id="@+id/serviceFeeView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    ui:nfc_leftText="@string/nfc_common_tsm_card_service_cost"
                    ui:nfc_leftTextColor="@color/nfc_setting_item_title"
                    ui:nfc_leftTextSize="@dimen/common_item_set_title_text_size"
                    ui:nfc_rightTextColor="@color/nfc_card_issue_list_text_color_gray"
                    ui:nfc_rightTextSize="@dimen/nfc_card_issue_list_item_second_title_text_size"/>
                <com.xiaomi.fitness.nfc.widget.RechargeItemView
                    android:id="@+id/couponView"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    ui:nfc_leftText="@string/nfc_nextpay_card_recharge_coupon_item_text"
                    ui:nfc_leftTextColor="@color/nfc_setting_item_title"
                    ui:nfc_leftTextSize="@dimen/common_item_set_title_text_size"
                    ui:nfc_rightTextColor="@color/orange"
                    ui:nfc_rightTextSize="@dimen/nfc_nextpay_card_recharge_item_coupon_right_text_size"
                    ui:nfc_showRightArrow="true"/>
            </LinearLayout>
        </RelativeLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/nextpay_card_intro_ll_protocols"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <CheckBox
                    android:textSize="@dimen/nfc_tsm_text_size_content_small"
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/agreeView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:button="@drawable/selector_check"/>
                <TextView
                    android:textSize="@dimen/nfc_tsm_text_size_content_small"
                    android:textStyle="bold"
                    android:textColor="@color/text_color"
                    android:gravity="center_vertical"
                    android:autoLink="web"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/protocolsView"
                    android:layout_width="wrap_content"
                    android:layout_height="60dp"
                    android:layout_marginStart="3.3dp"/>
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:enabled="false"
            android:id="@+id/payView"
            android:layout_marginTop="@dimen/nfc_nextpay_card_intro_ll_protocols_margin_top"
            android:text="@string/nfc_card_recharge_pay_now"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp"
            style="@style/CommonBtn.Primary"/>
    </LinearLayout>
</ScrollView>
