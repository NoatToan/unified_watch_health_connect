<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/notify_open_notify_remind_activity_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <miuix.springback.view.SpringBackLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scrollableView="@+id/scrollview">
        <miuix.core.widget.NestedScrollView
            android:id="@+id/scrollview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/dimen_15sp"
                    android:textStyle="bold"
                    android:textColor="@color/switch_black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="21dp"
                    android:text="@string/notify_open_remind_text"
                    android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
                    android:layout_marginEnd="@dimen/page_content_padding_horizontal_large"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/notify_open_view"
                    android:background="@drawable/notify_remind_bg"
                    android:layout_width="match_parent"
                    android:layout_height="81dp"
                    android:layout_marginTop="@dimen/margin_27dp"
                    android:layoutDirection="locale"
                    android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
                    android:layout_marginEnd="@dimen/page_content_padding_horizontal_large">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:background="@drawable/notify_remind_inner_bg"
                        android:layout_width="0dp"
                        android:layout_height="53dp"
                        android:layout_marginStart="@dimen/dimen_margin_1dp"
                        android:layout_marginEnd="@dimen/dimen_margin_1dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="37.7dp"
                        android:layout_height="37.7dp"
                        android:src="@drawable/notify_remind_app_logo"
                        android:layout_marginStart="23dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/dimen_15sp"
                        android:textStyle="bold"
                        android:textColor="@color/switch_black"
                        android:ellipsize="end"
                        android:id="@+id/notify_app_full_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/notify_app_full_name"
                        android:layout_marginStart="70dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/notify_remind_mark"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/notify_remind_mark"
                        android:layout_width="27.3dp"
                        android:layout_height="27.3dp"
                        android:src="@drawable/notify_remind_mark"
                        android:layout_marginEnd="28dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/notify_remind_btn_bg"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/notify_remind_btn_bg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/notify_remind_btn_bg"
                        android:layout_marginEnd="23dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
        </miuix.core.widget.NestedScrollView>
    </miuix.springback.view.SpringBackLayout>
    <Button
        android:id="@+id/open_button"
        android:layout_width="@dimen/common_btn_single_line_width"
        android:layout_height="@dimen/common_btn_height"
        android:text="@string/notify_message_remind_to_open"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/CommonBtn.Primary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
