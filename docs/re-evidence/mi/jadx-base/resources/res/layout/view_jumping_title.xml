<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/view_jumping_title_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="28dp"
        android:textColor="@color/sport_detail_color"
        android:id="@+id/sportType"
        android:tag="binding_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/FontNormal"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/sport_detail_color"
        android:id="@+id/bindDevice"
        android:tag="binding_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sportType"
        style="@style/FontRegular"/>
    <TextView
        android:gravity="center"
        android:id="@+id/line"
        android:visibility="gone"
        android:layout_width="@dimen/size_20"
        android:layout_height="wrap_content"
        android:text="|"
        app:layout_constraintBottom_toBottomOf="@+id/bindDevice"
        app:layout_constraintEnd_toStartOf="@+id/connect_tv"
        app:layout_constraintStart_toEndOf="@+id/bindDevice"
        app:layout_constraintTop_toTopOf="@+id/bindDevice"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/sport_detail_color"
        android:gravity="start"
        android:id="@+id/connect_tv"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/sport_connected"
        android:textDirection="locale"
        app:layout_constraintBottom_toBottomOf="@+id/bindDevice"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/line"
        app:layout_constraintTop_toTopOf="@+id/bindDevice"
        style="@style/FontRegular"/>
    <ImageView
        android:id="@+id/switchScreen"
        android:background="@drawable/vectorswitch"
        android:visibility="invisible"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="@dimen/margin_5dp"
        android:layout_marginEnd="@dimen/dimen_margin_24dp"
        app:layout_constraintEnd_toStartOf="@+id/sportConfig"
        app:layout_constraintTop_toTopOf="@+id/sportType"/>
    <ImageView
        android:id="@+id/sportConfig"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/sporting_set"
        android:contentDescription="@string/sport_config"
        app:layout_constraintBottom_toBottomOf="@+id/sportType"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/sportType"/>
</androidx.constraintlayout.widget.ConstraintLayout>
