<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/layout_sport_feed_back_0"
    android:paddingBottom="@dimen/dimen_margin_20dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.xiaomi.fitness.widget.view.DataTitleSimpleView
        android:id="@+id/titleFeedback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/text_color"
        android:id="@+id/txtFeedback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleFeedback"
        style="@style/FontDemiBold.24sp"/>
    <RatingBar
        android:id="@+id/ratingBar"
        android:layout_width="wrap_content"
        android:layout_height="26dp"
        android:layout_marginTop="9dp"
        android:stepSize="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtFeedback"
        style="@style/feedbackRatingBar"/>
    <TextView
        android:id="@+id/txtLabelTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_25dp"
        android:text="@string/trail_sport_feedback_lable_title_new"
        android:layout_marginStart="@dimen/dimen_margin_20dp"
        android:layout_marginEnd="@dimen/dimen_margin_20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ratingBar"
        style="@style/FontMedium.13sp"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:layout_marginStart="@dimen/dimen_margin_18dp"
        android:layout_marginEnd="@dimen/dimen_margin_20dp"
        app:layout_constraintTop_toBottomOf="@+id/txtLabelTitle"/>
    <EditText
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/text_color"
        android:textColorHint="@color/text_color_30"
        android:gravity="top"
        android:id="@+id/editFeedback"
        android:background="@drawable/trail_feedback_label_bg_cyan"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_marginTop="@dimen/dimen_margin_10dp"
        android:hint="@string/trail_sport_feedback_edit_hint_new"
        android:minLines="5"
        android:inputType="textMultiLine"
        android:paddingStart="@dimen/dimen_margin_10dp"
        android:layout_marginStart="@dimen/dimen_margin_20dp"
        android:layout_marginEnd="@dimen/dimen_margin_20dp"
        app:layout_constraintTop_toBottomOf="@+id/recyclerContainer"
        style="@style/TextViewStyle.TextDirection"/>
    <EditText
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/text_color"
        android:textColorHint="@color/text_color_30"
        android:gravity="top"
        android:id="@+id/editPhone"
        android:background="@drawable/trail_feedback_label_bg_cyan"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_10dp"
        android:hint="@string/trail_sport_feedback_phone_num"
        android:minLines="1"
        android:paddingStart="@dimen/dimen_margin_10dp"
        android:layout_marginStart="@dimen/dimen_margin_20dp"
        android:layout_marginEnd="@dimen/dimen_margin_20dp"
        app:layout_constraintTop_toBottomOf="@+id/editFeedback"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:id="@+id/mCommitBtn"
        android:layout_marginTop="@dimen/dimen_margin_20dp"
        android:layout_marginBottom="@dimen/dimen_margin_20dp"
        android:text="@string/trail_feedback_upload"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/editPhone"
        style="@style/CommonBtn.Red"/>
</androidx.constraintlayout.widget.ConstraintLayout>
