<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/device_settings_huami_spo2_setting_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/page_content_padding_horizontal_large"
        android:paddingEnd="@dimen/page_content_padding_horizontal_large">
        <com.xiaomi.fitness.widget.SwitchButtonBindingTwoLineTextView
            android:id="@+id/spo2View"
            android:tag="binding_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:subtitle="@string/device_settings_spo2_detection_all_dat_des"
            app:title="@string/device_settings_spo2_detection_all_day_title"/>
        <com.xiaomi.fitness.widget.RightArrowBindingTwoLineTextView
            android:id="@+id/lowView"
            android:tag="binding_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:subtitle="@string/device_settings_hypoxemia_notice_des"
            app:title="@string/device_settings_hypoxemia_notice_title"/>
        <com.xiaomi.fitness.widget.view.DividerView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_36dp"/>
        <com.xiaomi.fitness.devicesettings.widget.DeviceReminderView
            android:tag="binding_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_40dp"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
