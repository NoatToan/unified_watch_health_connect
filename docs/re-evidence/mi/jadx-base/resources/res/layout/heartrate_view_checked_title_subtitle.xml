<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minHeight="70dp"
    android:paddingStart="@dimen/dimen_margin_26dp"
    android:paddingEnd="@dimen/dimen_margin_26dp">
    <RelativeLayout
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toStartOf="@+id/checkbox">
        <TextView
            android:textColor="@color/white_90"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/size_10"
            style="@style/FontDemiBold.16sp"/>
        <TextView
            android:textSize="@dimen/font_12_7"
            android:textColor="@color/white_50"
            android:gravity="start"
            android:id="@+id/tv_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_1_3"
            android:layout_below="@+id/tv_title"
            android:layout_marginEnd="@dimen/size_10"/>
    </RelativeLayout>
    <RadioButton
        android:id="@+id/checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:button="@drawable/selector_common_circle_check"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
