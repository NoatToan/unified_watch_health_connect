<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="45dp">
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/common_black"
        android:gravity="center"
        android:id="@+id/txt_header_title1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/trail_sport_golf_score"
        android:layout_weight="1"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/common_black"
        android:gravity="center"
        android:id="@+id/txt_header_title2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/trail_sport_golf_swing_speed"
        android:layout_weight="1"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/common_black"
        android:gravity="center"
        android:id="@+id/txt_header_title3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/trail_sport_golf_swing_time"
        android:layout_weight="1"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/common_black"
        android:gravity="center"
        android:id="@+id/txt_header_title4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/trail_sport_golf_down_swing_time"
        android:layout_weight="1"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/common_black"
        android:gravity="center"
        android:id="@+id/txt_header_title5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/trail_sport_golf_swing_rhythm"
        android:layout_weight="1"/>
</LinearLayout>
