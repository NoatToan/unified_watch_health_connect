<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/layout_sleep_wm_score_0"
    android:background="@drawable/shape_data_item_bg"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include
        android:id="@+id/layout_common_icon_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_20"
        android:layout_marginBottom="@dimen/size_13_3"
        layout="@layout/layout_common_icon_title"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp">
        <TextView
            android:textSize="13.3sp"
            android:textColor="@color/text_color"
            android:layout_gravity="bottom"
            android:id="@+id/tv_avg"
            android:paddingBottom="6.7dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/health_sleep_avg"
            android:layout_alignBottom="@+id/tv_score_value"
            style="@style/FontMedium"/>
        <TextView
            android:textSize="33.3sp"
            android:textColor="@color/text_color"
            android:id="@+id/tv_score_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@+id/tv_avg"
            style="@style/FontLatinSemiBold"/>
        <TextView
            android:textSize="13.3sp"
            android:textColor="@color/text_color"
            android:layout_gravity="bottom"
            android:id="@+id/tv_score_unit"
            android:paddingBottom="6.7dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/health_sleep_avg"
            android:layout_alignBottom="@+id/tv_score_value"
            android:layout_toEndOf="@+id/tv_score_value"
            style="@style/FontMedium"/>
        <TextView
            android:textSize="13.3sp"
            android:textColor="@color/text_color"
            android:id="@+id/tv_score_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tv_score_value"
            style="@style/FontMedium"/>
    </RelativeLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5.3dp">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_chart_interactive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/size_18"
            android:layout_marginEnd="@dimen/size_18">
            <TextView
                android:textSize="11sp"
                android:textColor="#6750f1"
                android:gravity="start"
                android:id="@+id/tv_high_light_tip"
                android:background="@drawable/health_sleep_tip_purple_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="1dp"
                android:paddingHorizontal="@dimen/size_8"
                android:paddingVertical="4.3dp"
                style="@style/FontMedium"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/text_color_40"
                android:gravity="start"
                android:id="@+id/tv_avg_score_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_13"
                android:text="@string/health_sleep_avg_score_desc"
                android:drawableLeft="@drawable/health_ic_level_desc_dot_line"
                android:drawablePadding="6dp"
                style="@style/FontMedium"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_score_recycler_parent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </FrameLayout>
</LinearLayout>
