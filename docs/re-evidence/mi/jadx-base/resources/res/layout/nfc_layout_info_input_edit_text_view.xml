<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/nfc_font_11_35"
        android:textColor="@color/text_color_80"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/nfc_size_6_68"
        android:text="@string/nfc_retrun_card_user_info_name"/>
    <EditText
        android:textSize="@dimen/nfc_font_16"
        android:textStyle="bold"
        android:textColor="@color/text_color"
        android:textColorHint="@color/text_color_40"
        android:id="@+id/et_info_input"
        android:background="@null"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/nfc_retrun_card_user_info_hint"
        android:maxLines="1"
        android:singleLine="true"/>
</LinearLayout>
