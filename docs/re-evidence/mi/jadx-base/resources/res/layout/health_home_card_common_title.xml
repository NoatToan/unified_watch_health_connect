<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/homeCardTitle"
    android:tag="layout/health_home_card_common_title_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivHomeCardIcon"
        android:layout_width="26dp"
        android:layout_height="26dp"/>
    <TextView
        android:textSize="17sp"
        android:textColor="@color/text_color"
        android:id="@+id/tvHomeCardTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textDirection="locale"
        style="@style/FontMedium"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/llValueContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="18sp"
            android:textColor="@color/text_color"
            android:gravity="start"
            android:id="@+id/tvHomeCardValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="2dp"
            android:textDirection="locale"
            style="@style/FontMedium"/>
    </LinearLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/text_color"
        android:id="@+id/tvHomeCardEmptyDesc"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:drawableEnd="@drawable/health_home_card_arrow"
        android:textDirection="locale"
        style="@style/FontNormal"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/text_color_40"
        android:id="@+id/tvHomeCardDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textDirection="locale"
        style="@style/FontNormal"/>
</LinearLayout>
