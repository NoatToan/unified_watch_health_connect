<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/pay_fragment_pay_channel_0"
    android:background="@color/pay_channel_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/dimen_13sp"
        android:textColor="@color/footer_desc"
        android:id="@+id/timer"
        android:tag="binding_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_26dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="33sp"
        android:id="@+id/price"
        android:paddingTop="3dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_10dp"
        android:includeFontPadding="false"
        android:layout_marginEnd="0.67dp"
        app:layout_constraintEnd_toStartOf="@+id/price_unit"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/timer"
        style="@style/FontLatinSemiBold"/>
    <TextView
        android:textSize="@dimen/text_size_20"
        android:id="@+id/price_unit"
        android:tag="binding_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/pay_checkout_mibi_unit"
        android:includeFontPadding="false"
        android:layout_marginStart="0.67dp"
        app:layout_constraintBottom_toBottomOf="@+id/price"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/price"
        style="@style/FontLatinSemiBold"/>
    <TextView
        android:textColor="@color/footer_desc"
        android:id="@+id/pay_channel_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_24dp"
        android:text="@string/pay_checkout_payment_instrument"
        android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
        android:paddingVertical="@dimen/dimen_margin_8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/price"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/pay_channel"
        android:background="@drawable/pay_bg_result_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_3dp"
        android:layout_marginHorizontal="@dimen/page_padding_horizontal_large"
        android:paddingVertical="@dimen/dimen_margin_6dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintTop_toBottomOf="@+id/pay_channel_title"/>
    <TextView
        android:id="@+id/pay_confirm"
        android:tag="binding_3"
        android:text="@string/pay_checkout_confirm_pay"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/CommonBtn.Primary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
