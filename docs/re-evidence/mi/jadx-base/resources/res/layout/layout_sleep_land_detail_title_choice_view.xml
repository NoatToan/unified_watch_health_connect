<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="start"
    android:orientation="horizontal"
    android:id="@+id/detail_item_layout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/detail_choice_image"
        android:background="@drawable/sleep_detail_deep_selected"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_31_3"/>
    <TextView
        android:textSize="@dimen/text_size_14"
        android:textColor="@color/text_color"
        android:layout_gravity="center"
        android:id="@+id/detail_choice_txt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/health_sleep_deep"
        android:layout_marginStart="@dimen/dimen_margin_3dp"/>
</LinearLayout>
