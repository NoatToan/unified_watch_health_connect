<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/dimen_margin_40dp"
    android:paddingEnd="@dimen/dimen_margin_40dp">
    <TextView
        android:textSize="@dimen/dimen_16sp"
        android:textColor="@color/text_color"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_margin_16dp"
        android:text="@string/device_switch_wear_mode_success_desc_first"
        android:lineSpacingExtra="2sp"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/text_color"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_margin_16dp"
        android:text="@string/device_switch_wear_mode_success_desc_second"
        android:lineSpacingExtra="2sp"/>
</LinearLayout>
