<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textColor="@color/rn_settings_device_rename_desc_color"
        android:id="@+id/tv_rename_device"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/rn_settings_set_name_desc"
        android:layout_marginHorizontal="@dimen/page_content_padding_horizontal_large"
        android:layout_marginVertical="@dimen/size_8"
        style="@style/FontNormal.12sp"/>
    <EditText
        android:id="@+id/edit_device_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/size_10"
        android:layout_below="@+id/tv_rename_device"
        style="@style/CommonEditText"/>
    <TextView
        android:textColor="@color/red"
        android:id="@+id/tv_error_desc"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/edit_device_name"
        android:layout_marginHorizontal="@dimen/size_26_67"
        style="@style/FontNormal.12sp"/>
    <Button
        android:textSize="@dimen/dimen_16sp"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/btn_action"
        android:layout_marginBottom="@dimen/size_26_67"
        android:text="@string/btn_next"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        style="@style/CommonBtn.Red"/>
</RelativeLayout>
