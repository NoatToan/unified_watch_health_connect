<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_step_hrm_detail_0"
    android:background="@color/page_bg"
    android:paddingBottom="@dimen/size_20"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/page_padding_horizontal_large">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@drawable/selector_card_bg"
            android:paddingTop="@dimen/size_20"
            android:paddingBottom="@dimen/size_20"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_13"
            android:paddingStart="@dimen/size_18"
            android:paddingEnd="@dimen/size_18">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_icon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_heart_rate_in_sleep_card"/>
            <TextView
                android:textColor="@color/text_color"
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/health_sleep_average_heart_rate"
                android:layout_marginStart="@dimen/size_6_7"
                app:layout_constraintBottom_toBottomOf="@+id/iv_icon"
                app:layout_constraintStart_toEndOf="@+id/iv_icon"
                app:layout_constraintTop_toTopOf="@+id/iv_icon"
                style="@style/FontMedium.14sp"/>
            <TextView
                android:textSize="@dimen/font_21_3"
                android:id="@+id/tv_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_13"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/iv_icon"
                style="@style/FontMedium"/>
            <TextView
                android:textColor="@color/text_color_40"
                android:id="@+id/tv_time_range"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_value"
                style="@style/FontRegular.12sp"/>
            <TextView
                android:textColor="@color/text_color_40"
                android:id="@+id/tv_tip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/health_sleep_average_heart_rate_desc"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_time_range"
                style="@style/FontRegular.12sp"/>
            <View
                android:id="@+id/split_line_view"
                android:background="@color/common_divider_bg_color"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_0_33"
                android:layout_marginTop="@dimen/size_20"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_tip"/>
            <FrameLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/split_line_view">
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/chart_title_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/iv_chart_icon"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        app:srcCompat="@drawable/ic_heart_rate_in_sleep_card"/>
                    <TextView
                        android:textColor="@color/text_color"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/tv_chart_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/health_sleep_heart_rate"
                        android:layout_marginStart="@dimen/size_6_7"
                        app:layout_constraintBottom_toBottomOf="@+id/iv_icon"
                        app:layout_constraintStart_toEndOf="@+id/iv_icon"
                        app:layout_constraintTop_toTopOf="@+id/iv_icon"
                        style="@style/FontMedium.14sp"/>
                </LinearLayout>
                <com.xiaomi.fitness.chart.view.BarChartRecyclerView
                    android:id="@+id/bar_recycler"
                    android:paddingTop="79.6dp"
                    android:layout_height="311dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="32dp"
                    app:barChartMaxWidth="@dimen/size_3"
                    app:barChartRoundRectRadiusRatio="0.5"
                    app:barChartSegment="1"
                    app:chartColor="@color/health_hrm_chart"
                    app:displayNumbers="48"
                    app:enableEndDayXAxis="true"
                    app:enableStartYAxisLabel="false"
                    style="@style/ChartBaseStyle"/>
            </FrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
