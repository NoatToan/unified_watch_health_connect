<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:gravity="center"
        android:id="@+id/tv_dialog_description"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Dialog.Text.Description"/>
    <com.xiaomi.fitness.baseui.widget.NumberPickerView
        android:id="@+id/num_picker"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_162"
        android:layout_marginTop="@dimen/size_4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_dialog_description"
        app:layout_goneMarginTop="0dp"
        app:npv_NumberDigits="1"
        style="@style/Picker.Number.Dialog"/>
</androidx.constraintlayout.widget.ConstraintLayout>
