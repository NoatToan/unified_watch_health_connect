<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/mine_activity_weekly_report_auth_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginBottom="5dp">
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="255dp"
        android:layout_marginTop="@dimen/dimen_margin_23dp"
        android:layout_marginBottom="@dimen/dimen_margin_26dp"
        android:src="@drawable/mine_weeklysport_icon"
        android:layout_marginStart="@dimen/dimen_margin_26dp"
        android:layout_marginEnd="@dimen/dimen_margin_26dp"
        app:layout_constraintBottom_toTopOf="@+id/weekly_report_welcome_tv"/>
    <TextView
        android:textColor="@color/mine_black"
        android:gravity="center"
        android:id="@+id/weekly_report_welcome_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="@string/mine_weekly_report_auth_welcome"
        app:layout_constraintBottom_toTopOf="@+id/weekly_report_desc_tv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/FontNormal.20sp"/>
    <TextView
        android:textColor="@color/mine_black_40"
        android:gravity="center"
        android:id="@+id/weekly_report_desc_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/mine_weekly_report_auth_desc"
        android:layout_marginStart="@dimen/mine_margin_40dp"
        android:layout_marginEnd="@dimen/mine_margin_40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/weekly_report_welcome_tv"
        style="@style/FontNormal.14sp"/>
    <LinearLayout
        android:gravity="bottom"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_20dp"
        android:layout_marginBottom="@dimen/mine_size_27"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:textSize="@dimen/dimen_16sp"
            android:textColor="@color/mine_black"
            android:gravity="center"
            android:id="@+id/cancel_btn"
            android:background="@drawable/selector_bottom_btn_native_bg"
            android:layout_width="@dimen/common_btn_two_column_width"
            android:layout_height="@dimen/common_btn_height"
            android:text="@string/mine_cancle"/>
        <TextView
            android:textSize="@dimen/dimen_16sp"
            android:textColor="@color/mine_text_white"
            android:gravity="center"
            android:id="@+id/agree_btn"
            android:background="@drawable/selector_bottom_btn_positive_bg"
            android:layout_width="@dimen/common_btn_two_column_width"
            android:layout_height="@dimen/common_btn_height"
            android:text="@string/mine_agree"
            android:layout_marginStart="@dimen/dimen_margin_14dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
