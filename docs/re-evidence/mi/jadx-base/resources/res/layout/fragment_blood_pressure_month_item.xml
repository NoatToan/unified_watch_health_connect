<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/blood_pressure_container"
    android:tag="layout/fragment_blood_pressure_month_item_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/top_guide"
        android:visibility="gone"
        layout="@layout/layout_blood_pressure_top_guide"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.xiaomi.fitness.chart.view.BarChartRecyclerView
            android:id="@+id/recycler"
            style="@style/BarChartRecyclerViewStyle.BloodPressure.Month"/>
        <com.xiaomi.fitness.health.bloodpressure.ui.BloodPressureDataTitleView
            android:id="@+id/dataTitleView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_detail"
        android:background="@drawable/shape_data_item_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/health_detail_page_common_margin_vertical"
        android:overScrollMode="never"
        android:layout_marginHorizontal="@dimen/health_detail_page_common_margin_horizontal"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_distribute"
        android:background="@drawable/shape_data_item_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/health_detail_page_common_margin_vertical"
        android:overScrollMode="never"
        android:layout_marginHorizontal="@dimen/health_detail_page_common_margin_horizontal"/>
    <com.xiaomi.fitness.view.HealthBannerCardSetView
        android:id="@+id/health_banner_card_set"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/health_detail_page_common_margin_vertical"
        android:layout_marginHorizontal="@dimen/health_detail_page_common_margin_horizontal"/>
    <com.xiaomi.fitness.view.CardUnderstandView
        android:id="@+id/understandCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/health_detail_page_common_margin_horizontal"
        app:txtUnderstand="@string/health_blood_pressure_understand"/>
</LinearLayout>
