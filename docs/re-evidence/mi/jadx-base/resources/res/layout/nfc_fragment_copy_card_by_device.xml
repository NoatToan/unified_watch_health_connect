<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:tag="layout/nfc_fragment_copy_card_by_device_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:paddingStart="@dimen/nfc_common_layout_padding"
            android:paddingEnd="@dimen/nfc_common_layout_padding">
            <TextView
                android:textSize="20sp"
                android:textColor="@color/text_color_30"
                android:gravity="bottom"
                android:id="@+id/cardView"
                android:background="@drawable/nfc_card_mifare_issue_bg"
                android:paddingBottom="20dp"
                android:layout_width="@dimen/nfc_card_width"
                android:layout_height="@dimen/nfc_card_height"
                android:text="@string/nfc_door_card"
                android:layout_centerHorizontal="true"
                android:paddingStart="20dp"/>
            <FrameLayout
                android:id="@+id/watch_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="33dp"
                android:layout_centerHorizontal="true">
                <com.xiaomi.fitness.nfc.widget.DeviceImageView
                    android:id="@+id/deviceView"
                    android:layout_width="@dimen/nfc_device_icon_width"
                    android:layout_height="@dimen/nfc_device_icon_height"/>
                <ProgressBar
                    android:layout_gravity="center"
                    android:id="@+id/progressView"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:indeterminateDrawable="@drawable/nfc_card_issuing_indeterminate"
                    android:indeterminateDuration="2000"
                    android:interpolator="@android:interpolator/accelerate_decelerate"/>
            </FrameLayout>
        </RelativeLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingBottom="@dimen/nfc_common_view_btn_margin_top"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="24sp"
                android:textColor="@color/text_color"
                android:gravity="center"
                android:id="@+id/titleView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:text="@string/nfc_new_mifare_v3_title_start"/>
            <TextView
                android:textSize="@dimen/nfc_common_textsize_4"
                android:textColor="@color/text_color_80"
                android:gravity="center_horizontal"
                android:id="@+id/descView"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/nfc_card_intro_chk_margin_bottom"
                android:text="@string/nfc_entrance_card_read_desc"
                android:paddingStart="@dimen/page_content_padding_horizontal_large"
                android:paddingEnd="@dimen/page_content_padding_horizontal_large"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingBottom="@dimen/nfc_common_content_miui_title_margin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <TextView
            android:id="@+id/retryView"
            android:visibility="gone"
            android:text="@string/nfc_common_retry"
            style="@style/CommonBtn.Normal"/>
        <TextView
            android:id="@+id/finishView"
            android:visibility="gone"
            android:text="@string/nfc_copy_card_by_device_finish"
            style="@style/CommonBtn.Primary"/>
        <TextView
            android:id="@+id/copyCardView"
            android:visibility="gone"
            android:text="@string/nfc_copy_card_by_device_copy_card"
            style="@style/CommonBtn.Normal"/>
        <TextView
            android:textSize="@dimen/nfc_tsm_text_size_button_normal"
            android:textStyle="bold"
            android:textColor="@color/text_color_80"
            android:id="@+id/support_list_tip"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nfc_entrance_card_support_alert"/>
    </LinearLayout>
</RelativeLayout>
