<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_electronic_scale_data_report_0"
    android:background="@color/page_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/view_report"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/view_bottom"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_report"
            android:background="@color/card_bg_normal"
            android:paddingBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_color"
                android:id="@+id/tv_report_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/electronic_scale_body_composition_analysis_report"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ll_base_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="13dp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="13dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_report_name">
                <TextView
                    android:textSize="7sp"
                    android:textColor="@color/text_color_80"
                    android:id="@+id/tv_id"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="7sp"
                    android:textColor="@color/text_color_80"
                    android:id="@+id/tv_sex"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="7sp"
                    android:textColor="@color/text_color_80"
                    android:id="@+id/tv_age"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="7sp"
                    android:textColor="@color/text_color_80"
                    android:id="@+id/tv_height"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="7sp"
                    android:textColor="@color/text_color_80"
                    android:id="@+id/tv_measurement_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
            </LinearLayout>
            <com.xiaomi.fitness.electronic.scale.widget.BodyIndexScoreView
                android:id="@+id/view_body_index_score"
                android:background="@drawable/electronic_scale_bg_fa_radius_8dp"
                android:layout_width="match_parent"
                android:layout_height="101dp"
                android:layout_marginLeft="13dp"
                android:layout_marginTop="5dp"
                android:layout_marginRight="13dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ll_base_info"/>
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/guide_line"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_percent="0.5"/>
            <com.xiaomi.fitness.electronic.scale.widget.BodyCompositionAnalysisView
                android:id="@+id/view_body_composition_analysis"
                android:background="@drawable/electronic_scale_bg_fa_radius_8dp"
                android:layout_width="0dp"
                android:layout_height="162dp"
                android:layout_marginLeft="13dp"
                android:layout_marginTop="7dp"
                android:layout_marginRight="3dp"
                app:layout_constraintEnd_toStartOf="@+id/guide_line"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/view_body_index_score"/>
            <com.xiaomi.fitness.electronic.scale.widget.EvaluationIndexView
                android:id="@+id/view_evaluation_index"
                android:background="@drawable/electronic_scale_bg_fa_radius_8dp"
                android:layout_width="0dp"
                android:layout_height="162dp"
                android:layout_marginLeft="3dp"
                android:layout_marginTop="7dp"
                android:layout_marginRight="13dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/guide_line"
                app:layout_constraintTop_toBottomOf="@+id/view_body_index_score"/>
            <com.xiaomi.fitness.electronic.scale.widget.FatAnalysisView
                android:id="@+id/view_fat_analysis"
                android:background="@drawable/electronic_scale_bg_fa_radius_8dp"
                android:layout_width="0dp"
                android:layout_height="145dp"
                android:layout_marginLeft="13dp"
                android:layout_marginTop="7dp"
                android:layout_marginRight="3dp"
                app:layout_constraintEnd_toStartOf="@+id/guide_line"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/view_body_composition_analysis"/>
            <com.xiaomi.fitness.electronic.scale.widget.SkeletalMuscleAnalysisView
                android:id="@+id/view_skeletal_muscle_analysis"
                android:background="@drawable/electronic_scale_bg_fa_radius_8dp"
                android:layout_width="0dp"
                android:layout_height="145dp"
                android:layout_marginLeft="3dp"
                android:layout_marginTop="7dp"
                android:layout_marginRight="13dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/guide_line"
                app:layout_constraintTop_toBottomOf="@+id/view_evaluation_index"/>
            <TextView
                android:textSize="4.5sp"
                android:textColor="@color/text_color_40"
                android:id="@+id/tv_statement"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="13dp"
                android:layout_marginTop="5.7dp"
                android:text="@string/electronic_scale_statement"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/view_fat_analysis"/>
            <ImageView
                android:id="@+id/iv_sports_health"
                android:background="@drawable/electronic_scale_icon_sports_health_logo"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginLeft="13dp"
                android:layout_marginTop="11dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_statement"/>
            <TextView
                android:textSize="7sp"
                android:textColor="@color/text_color"
                android:id="@+id/tv_sports_health"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="7dp"
                android:layout_marginTop="8dp"
                android:text="@string/electronic_scale_xiaomi_sports_health"
                app:layout_constraintStart_toEndOf="@+id/iv_sports_health"
                app:layout_constraintTop_toBottomOf="@+id/tv_statement"/>
            <TextView
                android:textSize="6sp"
                android:textColor="@color/text_color_60"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1.5dp"
                android:text="@string/electronic_scale_your_personal_health_assistant"
                app:layout_constraintStart_toStartOf="@+id/tv_sports_health"
                app:layout_constraintTop_toBottomOf="@+id/tv_sports_health"/>
            <TextView
                android:textSize="6sp"
                android:textColor="@color/text_color"
                android:gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="2dp"
                android:text="@string/electronic_scale_scan_code_download_tips"
                app:layout_constraintBottom_toBottomOf="@+id/iv_sports_health_qrcode"
                app:layout_constraintEnd_toStartOf="@+id/iv_sports_health_qrcode"
                app:layout_constraintTop_toTopOf="@+id/iv_sports_health_qrcode"/>
            <ImageView
                android:id="@+id/iv_sports_health_qrcode"
                android:background="@drawable/electronic_scale_icon_sports_health_qrcode"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/view_skeletal_muscle_analysis"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.github.chrisbanes.photoview.PhotoView
            android:id="@+id/photo_view"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/cl_report"
            app:layout_constraintTop_toTopOf="@+id/cl_report"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/view_bottom"
        android:background="@drawable/electronic_scale_bg_download_report"
        android:paddingTop="26dp"
        android:paddingBottom="25dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">
        <ImageView
            android:id="@+id/iv_download"
            android:tag="binding_1"
            android:background="@drawable/electronic_scale_icon_download_report"
            android:layout_width="50dp"
            android:layout_height="50dp"
            app:layout_constraintEnd_toEndOf="parent"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/text_color_60"
            android:id="@+id/tv_download"
            android:tag="binding_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/electronic_scale_download"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
