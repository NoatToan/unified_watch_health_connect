<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="horizontal"
    android:id="@+id/slide_up_widget"
    android:background="@drawable/share_bottom_bg"
    android:paddingTop="@dimen/dimen_margin_26dp"
    android:paddingBottom="@dimen/dimen_margin_26dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/page_padding_horizontal_large">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="11sp"
        android:textColor="@color/share_text_color"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/rl_download"
        android:layout_width="48.67dp"
        android:layout_height="wrap_content"
        android:text="@string/share_download"
        android:drawableTop="@drawable/share_download"
        android:layout_marginEnd="@dimen/share_dimen_margin_share_path_item"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="11sp"
        android:textColor="@color/share_text_color"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/rl_share_wx_session"
        android:layout_width="48.67dp"
        android:layout_height="wrap_content"
        android:text="@string/share_wx_session"
        android:drawableTop="@drawable/share_wx_session"
        android:layout_marginEnd="@dimen/share_dimen_margin_share_path_item"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="11sp"
        android:textColor="@color/share_text_color"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/rl_share_timeline"
        android:layout_width="48.67dp"
        android:layout_height="wrap_content"
        android:text="@string/share_wx_timeline"
        android:drawableTop="@drawable/share_wx_timeline"
        android:layout_marginEnd="@dimen/share_dimen_margin_share_path_item"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="11sp"
        android:textColor="@color/share_text_color"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/rl_more"
        android:layout_width="48.67dp"
        android:layout_height="wrap_content"
        android:text="@string/more"
        android:drawableTop="@drawable/ic_share_more"/>
</LinearLayout>
