<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/main_container"
    android:tag="layout/health_layout_sleep_rhythm_record_item_0"
    android:background="@drawable/selector_card_bg"
    android:paddingTop="@dimen/size_17_3"
    android:paddingBottom="@dimen/size_17_3"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:layout_marginHorizontal="@dimen/size_12"
    android:paddingHorizontal="@dimen/page_content_padding_horizontal_large">
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="4">
        <TextView
            android:textColor="@color/text_color"
            android:gravity="start"
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:autoSizeTextType="uniform"
            style="@style/FontMedium.17sp"/>
        <TextView
            android:textColor="@color/text_color_40"
            android:gravity="start"
            android:id="@+id/tv_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingEnd="@dimen/size_2"
            android:autoSizeTextType="uniform"
            style="@style/FontRegular.14sp"/>
    </LinearLayout>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.5">
        <TextView
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/text_color_40"
            android:layout_gravity="end"
            android:id="@+id/tv_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/iv_arrow"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/ic_base_right_arrow_icon"
        android:importantForAccessibility="no"/>
</LinearLayout>
