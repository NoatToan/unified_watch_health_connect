<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_view"
    android:tag="layout/layout_sleep_day_animal_entrance_0"
    android:background="@drawable/health_sleep_animal_entrance_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/dimen_margin_12dp"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_card_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            app:srcCompat="@drawable/health_sleep_animal_bg_default"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_animal_bg"
            android:paddingTop="@dimen/size_10"
            android:paddingBottom="@dimen/size_8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/dimen_14sp"
                android:textColor="@color/health_sleep_entrance_top_title_text_color_default"
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/health_sleep_no_animal_report_card_title"
                android:layout_marginStart="@dimen/size_18"
                android:letterSpacing="0.06"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/FontLatinSemiBold"/>
            <androidx.cardview.widget.CardView
                android:id="@+id/card_no_report"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_10"
                android:layout_marginHorizontal="@dimen/size_8"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="@dimen/size_12"
                app:cardElevation="0dp">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_no_report"
                    android:background="@color/health_sleep_entrance_bg_color_default"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="149dp"
                    android:paddingHorizontal="@dimen/size_10"
                    android:paddingVertical="26dp">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/iv_no_report_animal"
                        android:focusable="true"
                        android:layout_width="96.7dp"
                        android:layout_height="96.7dp"
                        android:scaleType="centerInside"
                        android:importantForAccessibility="no"
                        android:layout_marginStart="16.7dp"
                        app:layout_constraintBottom_toBottomOf="@+id/tv_no_report_subtitle"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/tv_no_report_title"
                        app:srcCompat="@drawable/health_sleep_animal_sheep"/>
                    <TextView
                        android:textSize="@dimen/dimen_14sp"
                        android:textColor="@color/text_color"
                        android:id="@+id/tv_no_report_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/health_sleep_no_animal_report_content_title"
                        android:layout_marginStart="22.7dp"
                        app:layout_constraintBottom_toTopOf="@+id/tv_no_report_subtitle"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0"
                        app:layout_constraintStart_toEndOf="@+id/iv_no_report_animal"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_chainStyle="packed"
                        style="@style/FontLatinSemiBold"/>
                    <TextView
                        android:textSize="11.3sp"
                        android:textColor="@color/text_color_60"
                        android:id="@+id/tv_no_report_subtitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5.3dp"
                        android:text="@string/health_sleep_no_animal_report_content_desc"
                        android:lineSpacingMultiplier="1.1"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0"
                        app:layout_constraintStart_toStartOf="@+id/tv_no_report_title"
                        app:layout_constraintTop_toBottomOf="@+id/tv_no_report_title"
                        app:layout_constraintVertical_chainStyle="packed"
                        style="@style/FontMedium"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:id="@+id/card_has_report"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_10"
                android:layout_marginHorizontal="@dimen/size_8"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="@dimen/size_12"
                app:cardElevation="0dp">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_animal_report"
                    android:background="@color/health_sleep_entrance_bg_color_default"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="149dp"
                    android:paddingHorizontal="@dimen/size_10"
                    android:paddingVertical="9dp">
                    <com.xiaomi.fitness.health.sleep.view.SleepAnimalShadowLayout
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/has_report_shadow_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:shadowColor="@color/health_sleep_animal_shadow_sheep"
                        app:shadowDx="7dp"
                        app:shadowDy="7dp"
                        app:shadowRadius="10dp"
                        app:shadowShape="oval">
                        <com.xiaomi.fitness.widget.view.RoundImageView
                            android:id="@+id/iv_report_animal"
                            android:layout_width="96.7dp"
                            android:layout_height="96.7dp"
                            android:scaleType="centerInside"
                            android:importantForAccessibility="no"
                            app:innerStrokeColor="@color/health_sleep_animal_stroke_sheep"
                            app:innerStrokeWidth="0.33dp"
                            app:srcCompat="@drawable/health_sleep_animal_sheep"/>
                    </com.xiaomi.fitness.health.sleep.view.SleepAnimalShadowLayout>
                    <TextView
                        android:textSize="24sp"
                        android:textColor="@color/text_color"
                        android:id="@+id/tv_report_animal_detail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/health_sleep_animal_shark"
                        android:drawablePadding="2.7dp"
                        android:drawableEnd="@drawable/health_ic_sleep_animal_go_end"
                        android:layout_marginStart="9.3dp"
                        app:layout_constrainedWidth="true"
                        app:layout_constraintBottom_toTopOf="@+id/tv_report_subtitle"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0"
                        app:layout_constraintStart_toEndOf="@+id/has_report_shadow_view"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_chainStyle="packed"
                        style="@style/FontLatinSemiBold"/>
                    <TextView
                        android:textSize="11.3sp"
                        android:textColor="@color/text_color_60"
                        android:id="@+id/tv_report_subtitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12.7dp"
                        android:text="@string/health_sleep_has_animal_report_content_desc"
                        android:lineSpacingMultiplier="1.1"
                        app:layout_constraintBottom_toTopOf="@+id/tv_report_update_time"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0"
                        app:layout_constraintStart_toStartOf="@+id/tv_report_animal_detail"
                        app:layout_constraintTop_toBottomOf="@+id/tv_report_animal_detail"
                        app:layout_constraintVertical_bias="0"
                        style="@style/FontMedium"/>
                    <TextView
                        android:textSize="11.3sp"
                        android:textColor="@color/text_color_60"
                        android:id="@+id/tv_report_update_time"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/size_4"
                        android:text="@string/health_sleep_has_animal_report_last_update"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0"
                        app:layout_constraintStart_toStartOf="@+id/tv_report_subtitle"
                        app:layout_constraintTop_toBottomOf="@+id/tv_report_subtitle"
                        app:layout_constraintVertical_bias="0"
                        app:layout_constraintVertical_chainStyle="packed"
                        style="@style/FontMedium"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </FrameLayout>
</androidx.cardview.widget.CardView>
