<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/sport_activity_create_route_detail_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.mi.health.sport.CreateRouteMap
        android:id="@+id/mapView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/route_info_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/action_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.cardview.widget.CardView
            android:id="@+id/backCard"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginTop="9dp"
            android:foregroundGravity="center"
            android:contentDescription="@string/back"
            android:layout_marginStart="15dp"
            app:cardBackgroundColor="@color/card_bg_normal"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:layout_gravity="center"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_left_back_black"
                android:scaleType="centerInside"
                android:contentDescription="@string/back"/>
        </androidx.cardview.widget.CardView>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/to_device_card"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/sport_ic_save_route"
            android:scaleType="centerInside"
            android:contentDescription="@string/sport_route_save_to_device_title"
            android:layout_marginEnd="15dp"
            app:layout_constraintBottom_toBottomOf="@+id/backCard"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/backCard"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.cardview.widget.CardView
        android:id="@+id/locationBtn"
        android:layout_width="53.5dp"
        android:layout_height="53.5dp"
        android:layout_marginBottom="15dp"
        android:layout_marginStart="6dp"
        android:elevation="2dp"
        app:cardBackgroundColor="@color/card_bg_normal"
        app:cardCornerRadius="15dp"
        app:cardElevation="0.3dp"
        app:cardMaxElevation="0.6dp"
        app:cardPreventCornerOverlap="true"
        app:cardUseCompatPadding="true"
        app:layout_constraintBottom_toTopOf="@+id/notice_layout"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:gravity="center"
            android:background="@drawable/location_btn_no"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/text_color"/>
    </androidx.cardview.widget.CardView>
    <TextView
        android:textSize="@dimen/dimen_16sp"
        android:textColor="@color/text_color"
        android:gravity="center"
        android:id="@+id/route_intro"
        android:background="@drawable/sport_route_bg_intro"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/dimen_margin_14dp"
        android:text="@string/sport_running_route_create_detail_intro"
        android:drawableLeft="@drawable/sport_detail_ic_route_intro"
        android:drawablePadding="@dimen/dimen_margin_6dp"
        android:fontFamily="@font/misanslatin_bold"
        android:drawableTint="@color/text_color"
        app:layout_constraintBottom_toBottomOf="@+id/locationBtn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/locationBtn"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/text_color_10"
        android:id="@+id/sportRouteByAiText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="@string/sport_route_by_ai"
        android:fontFamily="@font/misanslatin_medium"
        app:layout_constraintBottom_toTopOf="@+id/notice_layout"
        app:layout_constraintStart_toEndOf="@+id/locationBtn"/>
    <FrameLayout
        android:id="@+id/notice_layout"
        android:background="@drawable/sport_route_ai_create_detail_notice"
        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:layout_marginBottom="-24dp"
        app:layout_constraintBottom_toTopOf="@+id/route_info_layout">
        <TextView
            android:textSize="@dimen/dimen_margin_13dp"
            android:textColor="#566c88"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/sport_running_route_create_detail_notice"
            android:drawableLeft="@drawable/sport_ic_ai_create_route_detail_notice"
            android:drawablePadding="7dp"
            android:layout_marginHorizontal="@dimen/size_26"/>
    </FrameLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/route_info_layout"
        android:background="@drawable/sport_route_ai_create_bg"
        android:paddingLeft="13dp"
        android:paddingTop="24dp"
        android:paddingRight="13dp"
        android:paddingBottom="18.6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:id="@+id/verify_failed"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/create_route_detail_verify_failed"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/dimen_23sp"
            android:id="@+id/route_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:fontFamily="@font/misanslatin_demibold"
            android:layout_marginHorizontal="@dimen/page_padding_horizontal_large"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/FontMedium"/>
        <TextView
            android:textSize="@dimen/dimen_13sp"
            android:textColor="@color/text_color_80"
            android:id="@+id/route_length"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_10dp"
            android:layout_marginHorizontal="@dimen/page_padding_horizontal_large"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/route_name"
            style="@style/FontMedium"/>
        <com.xiaomi.fitness.widget.view.DividerView
            android:id="@+id/length_popularity_divider"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_marginHorizontal="8dp"
            app:isHorizontal="true"
            app:layout_constraintBottom_toBottomOf="@+id/route_length"
            app:layout_constraintStart_toEndOf="@+id/route_length"
            app:layout_constraintTop_toTopOf="@+id/route_length"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@drawable/shape_card_bg_f9f9f9"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_20dp"
            android:layout_marginBottom="20dp"
            android:layout_marginHorizontal="@dimen/page_padding_horizontal_large_cut_12_dp"
            android:paddingVertical="@dimen/dimen_margin_10dp"
            app:layout_constraintBottom_toTopOf="@+id/start_running_btn"
            app:layout_constraintTop_toBottomOf="@+id/route_length">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dimen_13sp"
                android:textColor="@color/colorPrimary"
                android:id="@+id/navigation_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sport_navigate_start"
                android:drawablePadding="4dp"
                android:drawableStart="@drawable/orange_arrow_up"
                android:layout_marginEnd="@dimen/dimen_margin_12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/FontMedium"/>
            <com.xiaomi.fitness.widget.view.DividerView
                android:id="@+id/dividerView"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dimen_margin_20dp"
                android:layout_marginEnd="@dimen/dimen_margin_20dp"
                app:isHorizontal="true"
                app:layout_constraintBottom_toBottomOf="@+id/navigation_tv"
                app:layout_constraintEnd_toStartOf="@+id/navigation_tv"
                app:layout_constraintTop_toTopOf="@+id/navigation_tv"/>
            <RelativeLayout
                android:id="@+id/route_address_info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dimen_margin_12dp"
                app:layout_constraintBottom_toBottomOf="@+id/navigation_tv"
                app:layout_constraintEnd_toStartOf="@+id/dividerView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/navigation_tv">
                <TextView
                    android:textSize="@dimen/dimen_12sp"
                    android:textColor="@color/text_color_80"
                    android:id="@+id/route_address_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/FontMedium.12sp"/>
                <TextView
                    android:textColor="@color/text_color_60"
                    android:id="@+id/distance_from_starting_point"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5.3dp"
                    android:layout_below="@+id/route_address_tv"/>
            </RelativeLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:textSize="@dimen/dimen_16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/start_running_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sport_start_running"
            android:layout_centerInParent="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/SportCreateRouteOrangeButtonStyle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/not_activated_group"
        android:background="@drawable/shape_sporting_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/route_info_layout">
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/text_color_40"
            android:gravity="center"
            android:id="@+id/not_activated_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:translationY="-40dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/FontNormal.14sp"/>
        <Button
            android:textSize="13sp"
            android:textColor="@color/color_ff612e"
            android:id="@+id/goOpenPermissions"
            android:background="@drawable/shape_19ff612e"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sport_open_hr_check"
            android:translationY="-20dp"
            android:paddingHorizontal="17dp"
            android:paddingVertical="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/not_activated_tv"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
