<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/health_curse_edit_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/page_padding_horizontal_large">
    <com.xiaomi.fitness.health.curse.view.CurseSetItemView
        android:id="@+id/startView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/page_extra_padding_horizontal_large"/>
    <com.xiaomi.fitness.health.curse.view.CurseSetItemView
        android:id="@+id/endView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/page_extra_padding_horizontal_large"
        app:layout_constraintTop_toBottomOf="@+id/startView"/>
    <TextView
        android:id="@+id/syncTwo"
        android:visibility="gone"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:text="syncTwo"
        app:layout_constraintBottom_toTopOf="@+id/sync"
        style="@style/CommonBtn.Black"/>
    <TextView
        android:id="@+id/sync"
        android:visibility="gone"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:text="sync "
        app:layout_constraintBottom_toTopOf="@+id/get"
        style="@style/CommonBtn.Black"/>
    <TextView
        android:id="@+id/get"
        android:visibility="gone"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:text="get"
        app:layout_constraintBottom_toTopOf="@+id/set"
        style="@style/CommonBtn.Black"/>
    <TextView
        android:id="@+id/set"
        android:visibility="gone"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:text="set"
        app:layout_constraintBottom_toTopOf="@+id/saveView"
        style="@style/CommonBtn.Black"/>
    <Button
        android:id="@+id/cancelView"
        android:layout_width="0dp"
        android:text="@string/cancel"
        android:layout_marginEnd="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/saveView"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/CommonBtn.Normal"/>
    <Button
        android:id="@+id/saveView"
        android:layout_width="0dp"
        android:text="@string/confirm"
        android:layout_marginStart="13dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/cancelView"
        style="@style/CommonBtn.Primary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
