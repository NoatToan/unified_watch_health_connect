<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:tag="layout/layout_sleep_interfere_create_entry_0"
    android:background="@drawable/shape_card_bg_normal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/dimen_margin_16dp"
    android:paddingVertical="@dimen/dimen_margin_8dp">
    <TextView
        android:textSize="17sp"
        android:textColor="@color/text_color"
        android:gravity="start"
        android:id="@+id/sleepInterfereTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_6dp"
        android:text="@string/health_sleep_interfere_title"
        android:textDirection="locale"
        android:layout_marginEnd="@dimen/dimen_margin_10dp"
        app:layout_constraintEnd_toStartOf="@+id/sleepInterferePicture"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/FontMedium"/>
    <ImageView
        android:id="@+id/sleepInterfereBrand1"
        android:layout_width="59dp"
        android:layout_height="22dp"
        android:layout_marginBottom="8dp"
        android:src="@drawable/world_sleep_society_logo_59_22_4x"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/sleepInterfereTitle"/>
    <ImageView
        android:id="@+id/sleepInterfereBrand2"
        android:layout_width="47dp"
        android:layout_height="22dp"
        android:layout_marginBottom="8dp"
        android:src="@drawable/asian_society_of_sleep_medicine_logo_47_22_4x"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/sleepInterfereBrand1"/>
    <ImageView
        android:id="@+id/sleepInterfereBrand3"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginBottom="8dp"
        android:src="@drawable/chinese_sleep_research_society_logo_22_4x"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/sleepInterfereBrand2"/>
    <ImageView
        android:id="@+id/sleepInterferePicture"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/sleep_interfere_entry"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/text_color_40"
        android:gravity="start"
        android:id="@+id/sleepInterfereSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textDirection="locale"
        android:layout_marginEnd="@dimen/dimen_margin_10dp"
        app:layout_constraintEnd_toStartOf="@+id/sleepInterferePicture"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sleepInterfereTitle"
        style="@style/FontNormal"/>
</androidx.constraintlayout.widget.ConstraintLayout>
