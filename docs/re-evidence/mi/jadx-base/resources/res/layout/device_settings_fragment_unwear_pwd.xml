<?xml version="1.0" encoding="utf-8"?>
<miuix.springback.view.SpringBackLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/device_settings_fragment_unwear_pwd_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:scrollableView="@+id/scrollview">
    <miuix.core.widget.NestedScrollView
        android:id="@+id/scrollview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <RelativeLayout
            android:fitsSystemWindows="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/switch_black"
                android:gravity="center"
                android:id="@+id/alertView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/device_settings_unwear_set_pwd_huami_alert"
                android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
                android:layout_marginEnd="@dimen/page_content_padding_horizontal_large"/>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_below="@+id/alertView"
                android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
                android:layout_marginEnd="@dimen/page_content_padding_horizontal_large">
                <EditText
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/switch_black"
                    android:gravity="start|center_vertical"
                    android:id="@+id/pwdView"
                    android:background="@null"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:singleLine="true"
                    android:maxLength="6"
                    android:inputType="numberPassword"
                    android:textAlignment="viewStart"/>
                <View
                    android:background="@color/device_settings_unwear_edit_line_color"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_below="@+id/pwdView"/>
                <ImageView
                    android:id="@+id/showOrHidenPwdView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/unwear_pwd_show_pwd"
                    android:layout_centerVertical="true"
                    android:contentDescription="@string/device_settings_show_pwd"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="23dp"
                android:layout_alignParentBottom="true">
                <Button
                    android:id="@+id/cancleView"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:text="@string/cancel"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
                    style="@style/CommonBtn.Normal"/>
                <Button
                    android:enabled="false"
                    android:id="@+id/nextView"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:text="@string/device_settings_continue"
                    android:layout_weight="1"
                    android:layout_marginStart="13dp"
                    android:layout_marginEnd="@dimen/page_content_padding_horizontal_large"
                    style="@style/CommonBtn.Normal"/>
            </LinearLayout>
        </RelativeLayout>
    </miuix.core.widget.NestedScrollView>
</miuix.springback.view.SpringBackLayout>
