<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:tag="layout/ability_course_item_single_detail_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="16sp"
        android:id="@+id/itemName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/misanslatin_bold"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="13sp"
            android:textColor="@color/text_color_60"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/misanslatin_regular"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/text_color_60"
            android:id="@+id/duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/misanslatin_regular"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/text_color_60"
            android:id="@+id/unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/misanslatin_regular"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/paceLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="13sp"
                android:textColor="@color/divider_color"
                android:id="@+id/paceDivider"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="|"
                android:fontFamily="@font/misanslatin_regular"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/text_color_60"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/training_plan_ability_course_item_pace"
                android:fontFamily="@font/misanslatin_regular"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/text_color_60"
                android:id="@+id/minPace"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/misanslatin_regular"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/text_color_60"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-"
                android:fontFamily="@font/misanslatin_regular"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/text_color_60"
                android:id="@+id/maxPace"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/misanslatin_regular"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
