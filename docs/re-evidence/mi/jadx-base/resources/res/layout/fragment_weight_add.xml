<?xml version="1.0" encoding="utf-8"?>
<miuix.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll_view"
    android:tag="layout/fragment_weight_add_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/page_content_padding_horizontal_large"
        android:paddingEnd="@dimen/page_content_padding_horizontal_large">
        <RelativeLayout
            android:id="@+id/rl_record_time"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_53_3">
            <ImageView
                android:id="@+id/iv_record_time_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_right_arrow"
                android:layout_centerVertical="true"
                android:importantForAccessibility="no"
                android:layout_alignParentEnd="true"/>
            <TextView
                android:id="@+id/tv_record_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/health_weight_measure_time"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"
                style="@style/PreferenceItem.Title"/>
            <TextView
                android:gravity="end"
                android:id="@+id/tv_record_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:paddingEnd="@dimen/size_8"
                android:layout_toStartOf="@+id/iv_record_time_arrow"
                android:layout_toEndOf="@+id/tv_record_label"
                style="@style/PreferenceItem.Content"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_weight"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_53_3">
            <ImageView
                android:id="@+id/iv_weight_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_right_arrow"
                android:layout_centerVertical="true"
                android:importantForAccessibility="no"
                android:layout_alignParentEnd="true"/>
            <TextView
                android:id="@+id/tv_weight_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/health_body_weight"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"
                style="@style/PreferenceItem.Title"/>
            <TextView
                android:gravity="end"
                android:id="@+id/tv_weight_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:paddingEnd="@dimen/size_8"
                android:layout_toStartOf="@+id/iv_weight_arrow"
                android:layout_toEndOf="@+id/tv_weight_label"
                style="@style/PreferenceItem.Content"/>
        </RelativeLayout>
        <View
            android:background="@color/divider_line_color"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_0_66"
            android:layout_marginTop="@dimen/size_20"
            android:layout_marginBottom="@dimen/size_20"/>
        <RelativeLayout
            android:id="@+id/ryt_fat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/size_53_3">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/health_body_fat_ratio"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@+id/txv_fat"
                android:layout_alignParentStart="true"
                style="@style/PreferenceItem.Title"/>
            <TextView
                android:id="@+id/txv_fat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/health_weight_please_choose"
                android:layout_centerVertical="true"
                android:paddingEnd="@dimen/size_8"
                android:layout_toStartOf="@+id/img_fat_arrow"
                style="@style/PreferenceItem.Content"/>
            <ImageView
                android:id="@+id/img_fat_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_right_arrow"
                android:layout_centerVertical="true"
                android:importantForAccessibility="no"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/ryt_muscle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/size_53_3">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/health_body_muscle_ratio"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@+id/txv_muscle"
                android:layout_alignParentStart="true"
                style="@style/PreferenceItem.Title"/>
            <TextView
                android:id="@+id/txv_muscle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/health_weight_please_choose"
                android:layout_centerVertical="true"
                android:paddingEnd="@dimen/size_8"
                android:layout_toStartOf="@+id/img_muscle_arrow"
                style="@style/PreferenceItem.Content"/>
            <ImageView
                android:id="@+id/img_muscle_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_right_arrow"
                android:layout_centerVertical="true"
                android:importantForAccessibility="no"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/ryt_body_water"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/size_53_3">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/health_body_water"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@+id/txv_body_water"
                android:layout_alignParentStart="true"
                style="@style/PreferenceItem.Title"/>
            <TextView
                android:id="@+id/txv_body_water"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/health_weight_please_choose"
                android:layout_centerVertical="true"
                android:paddingEnd="@dimen/size_8"
                android:layout_toStartOf="@+id/img_body_water_arrow"
                style="@style/PreferenceItem.Content"/>
            <ImageView
                android:id="@+id/img_body_water_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_right_arrow"
                android:layout_centerVertical="true"
                android:importantForAccessibility="no"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/ryt_protein"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/size_53_3">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/health_body_protein_rate"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@+id/txv_protein"
                android:layout_alignParentStart="true"
                style="@style/PreferenceItem.Title"/>
            <TextView
                android:id="@+id/txv_protein"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/health_weight_please_choose"
                android:layout_centerVertical="true"
                android:paddingEnd="@dimen/size_8"
                android:layout_toStartOf="@+id/img_protein_arrow"
                style="@style/PreferenceItem.Content"/>
            <ImageView
                android:id="@+id/img_protein_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_right_arrow"
                android:layout_centerVertical="true"
                android:importantForAccessibility="no"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/ryt_visceral_fat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/size_53_3">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/health_body_visceral_fat"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@+id/txv_visceral_fat"
                android:layout_alignParentStart="true"
                style="@style/PreferenceItem.Title"/>
            <TextView
                android:id="@+id/txv_visceral_fat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/health_weight_please_choose"
                android:layout_centerVertical="true"
                android:paddingEnd="@dimen/size_8"
                android:layout_toStartOf="@+id/img_visceral_fat_arrow"
                style="@style/PreferenceItem.Content"/>
            <ImageView
                android:id="@+id/img_visceral_fat_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_right_arrow"
                android:layout_centerVertical="true"
                android:importantForAccessibility="no"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/ryt_bone_mass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/size_53_3">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/health_body_bone_mass"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@+id/txv_bone_mass"
                android:layout_alignParentStart="true"
                style="@style/PreferenceItem.Title"/>
            <TextView
                android:id="@+id/txv_bone_mass"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/health_weight_please_choose"
                android:layout_centerVertical="true"
                android:paddingEnd="@dimen/size_8"
                android:layout_toStartOf="@+id/img_bone_mass_arrow"
                style="@style/PreferenceItem.Content"/>
            <ImageView
                android:id="@+id/img_bone_mass_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_right_arrow"
                android:layout_centerVertical="true"
                android:importantForAccessibility="no"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </LinearLayout>
</miuix.core.widget.NestedScrollView>
