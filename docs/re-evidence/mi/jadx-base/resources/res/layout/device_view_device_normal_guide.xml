<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="@dimen/dimen_margin_20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.xiaomi.fitness.widget.SquareBindingImageView
            android:id="@+id/device_iv_normal_scan_device_icon"
            android:layout_width="@dimen/device_normal_guide_device_icon_size"
            android:layout_height="wrap_content"
            android:scaleType="centerCrop"/>
        <TextView
            android:textSize="@dimen/dimen_18sp"
            android:textStyle="bold"
            android:textColor="@color/device_text_color_black"
            android:id="@+id/device_tv_normal_guide_device_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_20dp"/>
        <TextView
            android:textSize="@dimen/dimen_14sp"
            android:textColor="@color/device_sub_text_color_black"
            android:id="@+id/device_tv_normal_guide_des"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_10dp"/>
    </LinearLayout>
</merge>
