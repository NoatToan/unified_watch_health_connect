<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/sport_activity_just_dance_launch_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/logo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp"
        android:layout_marginHorizontal="@dimen/dimen_margin_36dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/scan_join_bg"
        android:background="@drawable/sport_bg_jd_scan_join"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="@dimen/dimen_margin_20dp"
        android:layout_marginHorizontal="56dp"
        app:layout_constraintBottom_toTopOf="@+id/scan_desc"/>
    <ImageView
        android:id="@+id/scan_join_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/sport_jd_scan_icon"
        android:layout_marginEnd="@dimen/dimen_margin_4dp"
        app:layout_constraintBottom_toBottomOf="@+id/scan_join_bg"
        app:layout_constraintEnd_toStartOf="@+id/scan_join_text"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/scan_join_bg"
        app:layout_constraintTop_toTopOf="@+id/scan_join_bg"/>
    <TextView
        android:textSize="@dimen/dimen_20sp"
        android:textColor="@color/white"
        android:id="@+id/scan_join_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sport_jd_launch_scan_join"
        android:layout_marginStart="@dimen/dimen_margin_4dp"
        app:layout_constraintBottom_toBottomOf="@+id/scan_join_bg"
        app:layout_constraintEnd_toEndOf="@+id/scan_join_bg"
        app:layout_constraintStart_toEndOf="@+id/scan_join_icon"
        app:layout_constraintTop_toTopOf="@+id/scan_join_bg"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/footer_desc"
        android:gravity="center_horizontal"
        android:id="@+id/scan_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="56dp"
        android:text="@string/sport_jd_launch_scan_desc"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
