<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minHeight="53.33dp">
    <TextView
        android:textColor="@color/selector_feature_item_title_text_color"
        android:id="@+id/title_tv"
        android:tag="layout/device_settings_layout_set_radio_group_0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        style="@style/FontMedium.16sp"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view"
        android:tag="layout/device_settings_layout_set_radio_group_1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
</merge>
