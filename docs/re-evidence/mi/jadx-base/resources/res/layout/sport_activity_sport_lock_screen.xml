<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/sport_activity_sport_lock_screen_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.xiaomi.fitness.sport.view.lockscreen.ui.LockUnderView
        android:id="@+id/lock_under_view"
        android:background="@color/black"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/size_43_33"
        android:layout_marginHorizontal="@dimen/size_24"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/font_16"
                android:textColor="@color/white_60"
                android:id="@+id/tv_sport_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="户外跑步"
                android:layout_alignParentTop="true"
                android:layout_alignParentStart="true"/>
            <TextView
                android:textSize="@dimen/font_16_7"
                android:textColor="@color/white_90"
                android:id="@+id/tv_system_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="08:16"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                style="@style/FontLatinDemiBold"/>
            <TextView
                android:textSize="@dimen/font_16_7"
                android:textColor="@color/white_90"
                android:id="@+id/device_connection"
                android:tag="binding_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/tv_system_time"
                android:fontFamily="@font/misanslatin_regular"
                android:layout_alignParentStart="true"/>
        </RelativeLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/include"
            android:tag="binding_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_33_33"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/headView">
            <include
                android:id="@+id/sport_tracker"
                android:background="@color/black"
                layout="@layout/lock_view_sport_title"/>
            <include
                android:id="@+id/sport_data"
                layout="@layout/lock_view_out_sport_data"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/font_16"
        android:textColor="@color/white_90"
        android:gravity="center_horizontal"
        android:id="@+id/tv_unlock"
        android:paddingBottom="@dimen/size_45_67"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/sport_lock_screen_swipe_unlcok"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/FontLatinRegular"/>
</androidx.constraintlayout.widget.ConstraintLayout>
