<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <CheckBox
            android:id="@+id/device_cb_agree_all"
            android:background="@drawable/selector_check"
            android:padding="5dp"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:checked="false"
            android:button="@null"/>
        <TextView
            android:textSize="@dimen/dimen_14sp"
            android:textColor="@color/black"
            android:id="@+id/device_tv_privacy_agree_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/device_agree_all"
            android:layout_marginStart="@dimen/dimen_margin_10dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp">
        <CheckBox
            android:id="@+id/device_cb_agree_collect_user_info"
            android:background="@drawable/selector_check"
            android:padding="5dp"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:checked="false"
            android:button="@null"/>
        <TextView
            android:textSize="@dimen/dimen_14sp"
            android:textColor="@color/black"
            android:id="@+id/device_tv_agree_collect_user_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/device_required_agree_collect_info"
            android:layout_marginStart="@dimen/dimen_margin_10dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp">
        <CheckBox
            android:id="@+id/device_cb_agree_use_location_info"
            android:background="@drawable/selector_check"
            android:padding="5dp"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:checked="false"
            android:button="@null"/>
        <TextView
            android:textSize="@dimen/dimen_14sp"
            android:textColor="@color/black"
            android:id="@+id/device_tv_agree_use_location_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/device_required_agree_use_location"
            android:layout_marginStart="@dimen/dimen_margin_10dp"/>
    </LinearLayout>
</LinearLayout>
