<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/dimen_16sp"
        android:textColor="@color/common_white"
        android:id="@+id/txtSportName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:layout_marginStart="15dp"/>
    <com.xiaomi.fitness.share.view.TraceDistanceView
        android:id="@+id/viewDistance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="13dp"/>
    <com.xiaomi.fitness.baseui.widget.SportDetailItemView
        android:id="@+id/detailItemView1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_margin_15dp"
        app:itemGravity="1"
        app:itemHeight="60dp"
        app:txtNameColor="@color/white_90_transparent"
        app:txtNameSize="12sp"
        app:txtValueColor="@color/common_white"
        app:txtValueSize="20sp"/>
    <com.xiaomi.fitness.baseui.widget.SportDetailItemView
        android:id="@+id/detailItemView2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_margin_15dp"
        app:itemGravity="1"
        app:itemHeight="60dp"
        app:txtNameColor="@color/white_90_transparent"
        app:txtNameSize="12sp"
        app:txtValueColor="@color/common_white"
        app:txtValueSize="20sp"/>
    <com.xiaomi.fitness.baseui.widget.SportDetailItemView
        android:id="@+id/detailItemView3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_margin_15dp"
        app:itemGravity="1"
        app:itemHeight="60dp"
        app:txtNameColor="@color/white_90_transparent"
        app:txtNameSize="12sp"
        app:txtValueColor="@color/common_white"
        app:txtValueSize="20sp"/>
</LinearLayout>
