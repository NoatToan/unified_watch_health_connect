<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/device_settings_item_audio_list_phone_0"
    android:background="@drawable/selector_card_bg"
    android:paddingTop="16dp"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="23dp"
    android:paddingEnd="23dp">
    <TextView
        android:id="@+id/nameView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/FontDemiBold.16sp"/>
    <TextView
        android:textColor="@color/text_color_40"
        android:id="@+id/timeView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_margin_16dp"
        app:layout_constraintStart_toEndOf="@+id/dutationView"
        app:layout_constraintTop_toBottomOf="@+id/nameView"
        app:layout_constraintTop_toTopOf="@+id/dutationView"
        style="@style/FontRegular.12sp"/>
    <TextView
        android:textColor="@color/text_color_40"
        android:id="@+id/dutationView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_6dp"
        app:layout_constraintStart_toStartOf="@+id/nameView"
        app:layout_constraintTop_toBottomOf="@+id/nameView"
        style="@style/FontRegular.12sp"/>
    <TextView
        android:textColor="@color/text_color_40"
        android:ellipsize="end"
        android:id="@+id/contentView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_16dp"
        android:singleLine="true"
        app:layout_constraintStart_toStartOf="@+id/dutationView"
        app:layout_constraintTop_toBottomOf="@+id/dutationView"
        style="@style/FontRegular.13sp"/>
    <TextView
        android:id="@+id/statusView"
        android:background="@drawable/device_settings_audio_trans_failed_bg"
        android:paddingTop="1dp"
        android:paddingBottom="1dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="3dp"
        android:paddingEnd="3dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/nameView"
        style="@style/FontRegular.11sp"/>
    <View
        android:id="@+id/dividerView"
        android:background="@color/black_20"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="@+id/nameView"
        app:layout_constraintTop_toBottomOf="@+id/contentView"/>
    <ImageView
        android:id="@+id/shareView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        android:src="@drawable/device_settings_audio_share"
        android:contentDescription="@string/device_settings_share_audio"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dividerView"/>
    <ImageView
        android:id="@+id/deleteView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/device_settings_audio_delete"
        android:contentDescription="@string/device_settings_audio_delete"
        android:layout_marginStart="15dp"
        app:layout_constraintStart_toEndOf="@+id/shareView"
        app:layout_constraintTop_toTopOf="@+id/shareView"/>
    <ImageView
        android:id="@+id/trans2txtView"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/device_settings_audio_trans_image_bg"
        android:layout_marginStart="15dp"
        app:layout_constraintStart_toEndOf="@+id/playView"
        app:layout_constraintTop_toTopOf="@+id/shareView"/>
    <ImageView
        android:id="@+id/playView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/device_settings_audio_stop"
        android:layout_marginStart="15dp"
        app:layout_constraintStart_toEndOf="@+id/deleteView"
        app:layout_constraintTop_toTopOf="@+id/shareView"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/audioPlayLayout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/shareView">
        <SeekBar
            android:id="@+id/progressBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_15dp"
            android:max="1000"
            android:progress="27"
            android:progressDrawable="@drawable/device_settings_progress_player"
            android:thumb="@drawable/device_settings_seek_bar"
            android:thumbOffset="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:splitTrack="false"
            android:paddingVertical="6dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"/>
        <TextView
            android:textColor="@color/text_color_60"
            android:id="@+id/currentTimeView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/progressBar"/>
        <TextView
            android:textColor="@color/text_color_60"
            android:id="@+id/totalTimeView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBaseline_toBaselineOf="@+id/currentTimeView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/progressBar"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
