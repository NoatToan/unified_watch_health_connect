<?xml version="1.0" encoding="utf-8"?>
<miuix.springback.view.SpringBackLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/userInfoSpringback"
    android:tag="layout/userinfo_layout_activity_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:scrollableView="@+id/spring_back_target">
    <miuix.core.widget.NestedScrollView
        android:id="@+id/spring_back_target"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/layout_activity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/commonUserInfo"
                android:background="@color/userinfo_white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/page_content_padding_horizontal_large">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:orientation="horizontal"
                    android:id="@+id/layout_user"
                    android:background="@drawable/right_arrow_white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:layout_constraintTop_toBottomOf="parent">
                    <com.xiaomi.fitness.widget.view.RoundImageView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/user_photo"
                        android:background="@drawable/mine_default_icon"
                        android:layout_width="@dimen/userinfo_margin_46"
                        android:layout_height="@dimen/userinfo_margin_46"
                        android:layout_marginTop="@dimen/dimen_margin_20dp"
                        android:layout_marginBottom="@dimen/dimen_margin_20dp"
                        android:contentDescription="@string/userinfo_icon"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dimen_margin_16dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/user_photo"
                        app:layout_constraintTop_toTopOf="parent">
                        <TextView
                            android:textColor="@color/userinfo_black"
                            android:ellipsize="end"
                            android:gravity="start"
                            android:id="@+id/user_name"
                            android:layout_width="208dp"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:textDirection="locale"
                            style="@style/FontMedium.16sp"/>
                        <TextView
                            android:textSize="@dimen/text_size_12"
                            android:textColor="@color/userinfo_black_50"
                            android:id="@+id/user_info"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/userinfo_margin_2dp"
                            android:fontFamily="mipro"
                            style="@style/FontRegular.12sp"/>
                    </LinearLayout>
                    <ImageView
                        android:id="@+id/user_iv_right_img"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_base_right_arrow_icon"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <com.xiaomi.fitness.userinfo.medicalid.baseui.MedicalCardEntranceView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/layout_card_entrance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/userinfo_size_20"
                    android:layout_marginBottom="@dimen/dimen_margin_20dp"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:orientation="vertical"
                    android:id="@+id/recycler_view"
                    android:tag="binding_1"
                    android:background="@color/userinfo_white"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:layout_constraintTop_toBottomOf="@+id/layout_user"
                    app:reverseLayout="false"
                    app:spanCount="1"/>
            </LinearLayout>
            <RelativeLayout
                android:id="@+id/abilityRoot"
                android:tag="binding_2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">
                <com.xiaomi.fitness.training_plan_export.widget.TrainingPlanTitleBar
                    android:id="@+id/planTitle"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="36dp"
                    android:layout_alignParentTop="true"/>
                <include
                    android:id="@+id/planProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_below="@+id/planTitle"
                    layout="@layout/ability_plan_create_progress_layout"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:orientation="vertical"
                    android:id="@+id/planRecycler"
                    android:tag="binding_3"
                    android:background="@drawable/training_card_shape"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_margin_12dp"
                    android:layout_below="@+id/planProgress"
                    android:paddingStart="@dimen/dimen_margin_17dp"
                    android:paddingEnd="@dimen/dimen_margin_14dp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:reverseLayout="false"
                    app:spanCount="1"/>
                <TextView
                    android:textSize="17sp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/createAbilityNext"
                    android:background="@drawable/bottom_button_selector"
                    android:layout_width="@dimen/common_btn_single_line_width"
                    android:layout_height="50dp"
                    android:layout_marginBottom="29dp"
                    android:text="@string/userinfo_confirm_user_info"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"
                    android:fontFamily="@font/misanslatin_regular"
                    android:layout_marginStart="@dimen/dimen_margin_17dp"
                    android:layout_marginEnd="@dimen/dimen_margin_17dp"/>
            </RelativeLayout>
        </LinearLayout>
    </miuix.core.widget.NestedScrollView>
</miuix.springback.view.SpringBackLayout>
