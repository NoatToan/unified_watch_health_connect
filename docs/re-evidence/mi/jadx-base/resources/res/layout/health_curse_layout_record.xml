<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/shape_data_item_bg_white"
    android:paddingBottom="24dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/infoView"
        android:tag="layout/health_curse_layout_record_0"
        android:paddingBottom="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/health_content_padding"
        android:paddingEnd="@dimen/health_content_padding">
        <ImageView
            android:id="@+id/icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:src="@drawable/health_curse_record"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:id="@+id/recordLabel"
            android:text="@string/health_curse_record"
            android:layout_marginStart="10dp"
            app:layout_constraintBottom_toTopOf="@+id/periodView"
            app:layout_constraintStart_toEndOf="@+id/icon"
            app:layout_constraintTop_toTopOf="@+id/icon"
            style="@style/HealthCurseTitle"/>
        <TextView
            android:id="@+id/periodView"
            app:layout_constraintBottom_toBottomOf="@+id/icon"
            app:layout_constraintStart_toStartOf="@+id/recordLabel"
            app:layout_constraintTop_toBottomOf="@+id/recordLabel"
            style="@style/HealthCurseDesc"/>
        <ImageView
            android:id="@+id/moreView"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_base_right_arrow_icon"
            app:layout_constraintBottom_toBottomOf="@+id/icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/icon"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.xiaomi.fitness.widget.view.DividerView
        android:id="@+id/divider"
        android:tag="layout/health_curse_layout_record_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/health_content_padding"
        android:layout_marginEnd="@dimen/health_content_padding"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/infoView"/>
    <com.xiaomi.fitness.health.curse.view.SymRecordLatestView
        android:id="@+id/hisHurtView"
        android:tag="layout/health_curse_layout_record_2"
        android:layout_marginTop="25dp"
        app:healthRecordType="hurt"
        app:layout_constraintTop_toBottomOf="@+id/divider"
        style="@style/HealthCurseRecordSymptom"/>
    <com.xiaomi.fitness.health.curse.view.SymRecordLatestView
        android:id="@+id/hisBloodView"
        android:tag="layout/health_curse_layout_record_3"
        android:layout_marginTop="30dp"
        app:healthRecordType="blood"
        app:layout_constraintTop_toBottomOf="@+id/hisHurtView"
        style="@style/HealthCurseRecordSymptom"/>
    <com.xiaomi.fitness.health.curse.view.SymRecordLatestView
        android:id="@+id/hisMotionView"
        android:tag="layout/health_curse_layout_record_4"
        android:layout_marginTop="30dp"
        app:healthRecordType="motion"
        app:layout_constraintTop_toBottomOf="@+id/hisBloodView"
        style="@style/HealthCurseRecordSymptom"/>
</merge>
