<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/shape_white_gray"
        android:padding="@dimen/launch_sport_edge"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="8dp">
        <com.xiaomi.fitness.widget.view.RatioImageView
            android:id="@+id/sport_img"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@mipmap/ic_launcher_small"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearance="@style/CourseShapeImage"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/course_black"
            android:ellipsize="end"
            android:id="@+id/sport_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/sport_current_mode"
            android:layout_marginStart="12dp"
            app:layout_constraintBottom_toTopOf="@+id/sport_des"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/sport_img"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/course_desc"
            android:ellipsize="end"
            android:id="@+id/sport_des"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/sport_fitness_mode_txt"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/sport_title"
            app:layout_constraintStart_toStartOf="@+id/sport_title"
            app:layout_constraintTop_toBottomOf="@+id/sport_title"/>
        <ImageView
            android:id="@+id/sport_icon"
            android:background="@drawable/sport_arrow_more"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/sport_mask"
        android:background="@drawable/shape_sport_dynamic_bg_mask"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="74dp"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="8dp"/>
</merge>
