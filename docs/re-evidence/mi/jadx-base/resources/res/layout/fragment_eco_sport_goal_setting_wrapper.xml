<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.xiaomi.fitness.sport_eco.baseui.TitleBar
        android:id="@+id/titleView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/range"
        android:background="@drawable/shape_record_range_bg"
        android:layout_width="match_parent"
        android:layout_height="37dp"
        android:layout_marginTop="30dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleView"/>
    <RadioGroup
        android:orientation="horizontal"
        android:id="@+id/radioGroup"
        android:layout_width="0dp"
        android:layout_height="30dp"
        android:layout_margin="3dp"
        app:layout_constraintBottom_toBottomOf="@+id/range"
        app:layout_constraintEnd_toEndOf="@+id/range"
        app:layout_constraintStart_toStartOf="@+id/range"
        app:layout_constraintTop_toTopOf="@+id/range">
        <RadioButton
            android:textColor="@color/text_color"
            android:id="@+id/radioDistance"
            android:checked="true"
            android:text="@string/sport_distance"
            style="@style/FaceTab"/>
        <RadioButton
            android:textColor="@color/text_color"
            android:id="@+id/radioMinute"
            android:text="@string/sport_time_duration"
            style="@style/FaceTab"/>
        <RadioButton
            android:textColor="@color/text_color"
            android:id="@+id/radioCalories"
            android:text="@string/sport_tab_calorie"
            style="@style/FaceTab"/>
    </RadioGroup>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/range"/>
</androidx.constraintlayout.widget.ConstraintLayout>
