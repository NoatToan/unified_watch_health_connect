<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/player_next_tip"
    android:background="#66000000"
    android:layout_width="match_parent"
    android:layout_height="33.3dp"
    android:paddingStart="12.3dp">
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_centerVertical="true">
        <TextView
            android:textSize="11.3sp"
            android:textColor="#fb3144"
            android:id="@+id/tip_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="11.3sp"
            android:textColor="@android:color/white"
            android:ellipsize="end"
            android:id="@+id/tip_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_centerVertical="true"
            android:paddingEnd="53.3dp"
            android:layout_toEndOf="@+id/tip_time"/>
    </LinearLayout>
    <TextView
        android:textSize="11.3sp"
        android:textColor="#ff9800"
        android:id="@+id/tip_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="立即播放"
        android:layout_centerVertical="true"
        android:paddingEnd="14.1dp"
        android:layout_alignParentEnd="true"/>
</LinearLayout>
