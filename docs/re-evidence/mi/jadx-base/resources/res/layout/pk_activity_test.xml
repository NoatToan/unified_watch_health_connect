<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/pk_activity_test_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:id="@+id/tv_jump_pk_list"
            android:padding="@dimen/size_10"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/size_10"
            android:text="跳转PK列表页"
            style="@style/CommonBtn.Normal"/>
        <com.xiaomi.fitness.active.pk.widget.PkScoreView
            android:id="@+id/pk_score_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.xiaomi.fitness.active.pk.widget.PkBarChart
            android:id="@+id/pk_bar_chart"
            android:paddingTop="23.3dp"
            android:paddingBottom="41.3dp"
            android:layout_width="match_parent"
            android:layout_height="145dp"
            android:layout_marginTop="@dimen/size_20"
            android:paddingStart="18dp"
            android:paddingEnd="32dp"
            app:pkEmptyStr="@string/pk_chart_tomorrow_start"/>
        <com.xiaomi.fitness.active.pk.widget.PkBarChart
            android:id="@+id/pk_bar_chart_2"
            android:paddingTop="23.3dp"
            android:paddingBottom="71.3dp"
            android:layout_width="match_parent"
            android:layout_height="178dp"
            android:layout_marginTop="@dimen/size_20"
            android:paddingStart="18dp"
            android:paddingEnd="32dp"
            app:pkBarShowBottomScoreEnable="true"/>
        <TextView
            android:id="@+id/tv_jump_invite_receive"
            android:padding="@dimen/size_10"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/size_10"
            android:text="跳转邀请接收页"
            style="@style/CommonBtn.Normal"/>
        <TextView
            android:textSize="@dimen/font_16_7"
            android:textColor="@color/text_color_80"
            android:id="@+id/tv_pk_entrance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/size_10"/>
        <TextView
            android:textSize="@dimen/font_16_7"
            android:textColor="@color/text_color_80"
            android:id="@+id/tv_recommend_friends"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/size_10"/>
        <TextView
            android:id="@+id/tv_create_invite"
            android:padding="@dimen/size_10"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="点击创建PK邀请"
            style="@style/CommonBtn.Normal"/>
        <TextView
            android:id="@+id/tv_invite_share_jump"
            android:padding="@dimen/size_10"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="web jump"
            style="@style/CommonBtn.Normal"/>
        <TextView
            android:textSize="@dimen/font_16_7"
            android:textColor="@color/text_color_80"
            android:id="@+id/tv_invite_user_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/size_10"/>
        <TextView
            android:textSize="@dimen/font_16_7"
            android:textColor="@color/text_color_80"
            android:id="@+id/tv_invite_records"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/size_10"/>
    </LinearLayout>
</ScrollView>
