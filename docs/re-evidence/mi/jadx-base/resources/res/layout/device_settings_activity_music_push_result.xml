<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/device_settings_activity_music_push_result_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/page_content_padding_horizontal_large"
    android:paddingEnd="@dimen/page_content_padding_horizontal_large">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="5dp"
        android:layout_weight="1"/>
    <TextView
        android:id="@+id/retryView"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="30dp"
        android:text="@string/device_settings_push_result_retry"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp"
        style="@style/CommonBtn.Primary"/>
</LinearLayout>
