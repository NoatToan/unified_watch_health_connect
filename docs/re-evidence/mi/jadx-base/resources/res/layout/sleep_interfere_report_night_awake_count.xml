<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    app:cardBackgroundColor="@color/common_card_bg_color"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/sleepInterfereReportNightAwakeCountLinearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="20dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/sleepInterfereReportNightAwakeCountTitleLinearLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp">
            <ImageView
                android:id="@+id/sleepInterfereReportNightAwakeCountTitleImageView"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/night_awake_count_icon"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="20sp"
                android:textColor="@color/text_color"
                android:id="@+id/sleepInterfereReportNightAwakeCountTitleTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/health_sleep_interfere_sleep_average_awake_times_title"
                android:paddingHorizontal="8dp"
                android:textFontWeight="500"/>
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="36sp"
            android:textColor="@color/text_color"
            android:id="@+id/sleepInterfereReportSleepNightAwakeCountTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="20dp"/>
        <com.xiaomi.fitness.health.sleep.interfere.report.charts.SleepInterfereReportChartCompareInfoView
            android:id="@+id/sleepChartCompareInfoView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginHorizontal="20dp"/>
        <com.xiaomi.fitness.health.sleep.interfere.report.charts.SleepInterfereLineChartView
            android:id="@+id/sleepRegularityChartView"
            android:layout_width="match_parent"
            android:layout_height="246dp"
            android:layout_marginTop="22dp"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
