<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/device_settings_todo_remind_edit_fragment_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.cardview.widget.CardView
        android:id="@+id/card_high"
        android:layout_width="match_parent"
        android:layout_height="144dp"
        android:foreground="@null"
        android:layout_marginHorizontal="@dimen/size_12"
        app:cardBackgroundColor="@color/device_settings_edit_card_bg"
        app:cardCornerRadius="15.3dp"
        app:cardElevation="0dp">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/edit_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="18dp"
            android:layout_marginVertical="20dp">
            <miuix.androidbasewidget.widget.EditText
                android:textSize="16.7dp"
                android:textColor="@color/text_color"
                android:textColorHint="@color/text_color_40"
                android:gravity="start|top"
                android:id="@+id/edit_content"
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:hint="@string/device_settings_todo_remind_hint"
                android:maxLines="3"
                android:maxLength="30"
                android:layout_weight="1"
                android:inputType="textMultiLine"
                style="@style/FontMedium"/>
            <TextView
                android:textSize="12.6dp"
                android:textColor="@color/device_settings_edit_exceeded_text_color"
                android:id="@+id/edit_content_exceeded_text"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/device_settings_todo_words_limit_tip"
                style="@style/FontMedium"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <com.xiaomi.fitness.widget.SwitchButtonTwoLineTextView
        android:id="@+id/switch_btn_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/page_content_padding_horizontal_large"
        android:paddingEnd="@dimen/page_content_padding_horizontal_large"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/device_settings_todo_remind_label"/>
    <com.xiaomi.fitness.widget.RightArrowTwoLineTextView
        android:id="@+id/edit_todo_time_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/page_content_padding_horizontal_large"
        android:paddingEnd="@dimen/page_content_padding_horizontal_large"
        app:title="@string/device_settings_todo_remind_time"/>
    <com.xiaomi.fitness.widget.RightArrowTwoLineTextView
        android:id="@+id/edit_todo_period_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/page_content_padding_horizontal_large"
        android:paddingEnd="@dimen/page_content_padding_horizontal_large"
        app:title="@string/device_settings_todo_repeat_cycle"/>
</LinearLayout>
