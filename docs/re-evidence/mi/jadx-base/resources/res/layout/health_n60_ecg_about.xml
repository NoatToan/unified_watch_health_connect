<?xml version="1.0" encoding="utf-8"?>
<miuix.springback.view.SpringBackLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/health_n60_ecg_about_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:scrollableView="@+id/spring_back_target">
    <miuix.core.widget.NestedScrollView
        android:id="@+id/spring_back_target"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/about_ecg_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_40dp"
            android:paddingHorizontal="@dimen/page_content_padding_horizontal_large">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/img_view"
                android:layout_width="@dimen/size_100"
                android:layout_height="@dimen/size_100"
                android:src="@drawable/health_data_ecg_about"
                android:importantForAccessibility="no"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:gravity="center_horizontal"
                android:id="@+id/text_view_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_10dp"
                android:text="@string/health_n60_ecg"
                app:layout_constraintEnd_toStartOf="parent"
                app:layout_constraintStart_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/img_view"
                style="@style/FontMedium.20sp"/>
            <View
                android:id="@+id/divider_line"
                android:background="@color/black_10"
                android:layout_width="match_parent"
                android:layout_height="0.3dp"
                android:layout_marginTop="@dimen/dimen_margin_40dp"
                android:layout_marginStart="@dimen/dimen_margin_20dp"
                android:layout_marginEnd="@dimen/dimen_margin_20dp"
                app:layout_constraintBottom_toTopOf="@+id/about_right_switch_layout"
                app:layout_constraintTop_toBottomOf="@+id/text_view_title"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/about_right_switch_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_30dp"
                app:layout_constraintTop_toBottomOf="@+id/divider_line">
                <com.xiaomi.fitness.widget.RightArrowBindingTwoLineTextView
                    android:id="@+id/product_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:remindText="@string/health_n60_product_name_desc"
                    app:showMore="false"
                    app:showRemind="true"
                    app:title="@string/health_n60_product_name"/>
                <com.xiaomi.fitness.widget.RightArrowBindingSingleLineTextView
                    android:id="@+id/specification_and_model"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/product_name"
                    app:remindText="@string/health_n60_specification_and_model_desc"
                    app:showMore="false"
                    app:showRemind="true"
                    app:title="@string/health_n60_specification_and_model"/>
                <com.xiaomi.fitness.widget.RightArrowBindingSingleLineTextView
                    android:id="@+id/common_privacy_brief"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/specification_and_model"
                    app:remindText="@string/health_n60_release_version_desc"
                    app:showMore="false"
                    app:showRemind="true"
                    app:title="@string/health_n60_release_version"/>
                <com.xiaomi.fitness.widget.RightArrowBindingSingleLineTextView
                    android:id="@+id/privacy_experience"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/common_privacy_brief"
                    app:remindText="@string/health_n60_full_version_desc"
                    app:showMore="false"
                    app:showRemind="true"
                    app:title="@string/health_n60_full_version"/>
                <com.xiaomi.fitness.widget.RightArrowBindingSingleLineTextView
                    android:id="@+id/medical_device_certificate_number"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/privacy_experience"
                    app:remindText="@string/health_n60_medical_device_certificate_number_desc"
                    app:showMore="false"
                    app:showRemind="true"
                    app:title="@string/health_n60_medical_device_certificate_number"/>
                <com.xiaomi.fitness.widget.RightArrowBindingSingleLineTextView
                    android:id="@+id/medical_device_produce_number"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/medical_device_certificate_number"
                    app:remindText="@string/health_n60_medical_device_produce_number_desc"
                    app:showMore="false"
                    app:showRemind="true"
                    app:title="@string/health_n60_medical_device_produce_number"/>
                <com.xiaomi.fitness.widget.RightArrowBindingSingleLineTextView
                    android:id="@+id/medical_device_technical_number"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/medical_device_produce_number"
                    app:remindText="@string/health_n60_medical_device_technical_number_desc"
                    app:showMore="false"
                    app:showRemind="true"
                    app:title="@string/health_n60_medical_device_technical_number"/>
                <com.xiaomi.fitness.widget.RightArrowBindingSingleLineTextView
                    android:id="@+id/about_company_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/medical_device_technical_number"
                    app:showMore="false"
                    app:showRemind="false"
                    app:title="@string/health_n60_about_company_name"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </miuix.core.widget.NestedScrollView>
</miuix.springback.view.SpringBackLayout>
