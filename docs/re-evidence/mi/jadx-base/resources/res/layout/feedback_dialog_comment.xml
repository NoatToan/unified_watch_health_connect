<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:tag="layout/feedback_dialog_comment_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/dimen_20sp"
            android:textColor="@color/text_color"
            android:gravity="center"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/feedback_comment_title"
            android:layout_marginHorizontal="@dimen/dimen_margin_30dp"
            style="@style/FontMedium"/>
        <TextView
            android:textSize="@dimen/dimen_16sp"
            android:textColor="@color/text_color"
            android:gravity="center"
            android:id="@+id/des"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_10dp"
            android:text="@string/feedback_comment_desc"
            android:layout_marginHorizontal="@dimen/dimen_margin_30dp"
            style="@style/FontRegular"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/feedback_comment_btn_color"
            android:gravity="center"
            android:id="@+id/complainView"
            android:background="@drawable/feedback_selector_comment"
            android:layout_width="match_parent"
            android:layout_height="53dp"
            android:layout_marginTop="16dp"
            android:text="@string/feedback_comment_complaint"
            android:fontFamily="@font/misanslatin_regular"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/feedback_comment_btn_color"
            android:gravity="center"
            android:id="@+id/nextView"
            android:background="@drawable/feedback_selector_comment"
            android:layout_width="match_parent"
            android:layout_height="53dp"
            android:text="@string/feedback_comment_cancel"
            android:fontFamily="@font/misanslatin_regular"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/feedback_comment_btn_color"
            android:gravity="center"
            android:id="@+id/okView"
            android:background="@drawable/feedback_selector_comment"
            android:layout_width="match_parent"
            android:layout_height="53dp"
            android:text="@string/feedback_comment_ok"
            android:fontFamily="@font/misanslatin_regular"/>
    </LinearLayout>
</ScrollView>
