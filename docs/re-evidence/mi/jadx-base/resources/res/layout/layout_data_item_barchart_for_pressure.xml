<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/GradientView"
    android:tag="layout/layout_data_item_barchart_for_pressure_0"
    android:background="@drawable/selector_round"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/img_sport_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_20dp"
        android:scaleType="center"
        android:layout_marginStart="@dimen/margin_20dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_7dp"
        android:layout_marginStart="@dimen/dimen_margin_20dp">
        <TextView
            android:textColor="@color/health_home_txt_color"
            android:id="@+id/pressure_value_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/FontMedium.16sp"/>
        <TextView
            android:textColor="#00d6ba"
            android:id="@+id/pressure_status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_margin_5dp"
            app:layout_constraintStart_toEndOf="@+id/pressure_value_text"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/FontMedium.16sp"/>
        <ImageView
            android:id="@+id/pressure_status_icon"
            android:layout_width="@dimen/dimen_margin_15dp"
            android:layout_height="@dimen/dimen_margin_15dp"
            android:layout_marginTop="3dp"
            android:layout_marginStart="3dp"
            app:layout_constraintBottom_toBottomOf="@+id/pressure_value_text"
            app:layout_constraintStart_toEndOf="@+id/pressure_status_text"
            app:layout_constraintTop_toTopOf="@+id/pressure_value_text"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textColor="@color/health_home_txt_color"
        android:id="@+id/txt_data_content_str"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_20dp"
        style="@style/FontRegular.11sp"/>
    <androidx.appcompat.widget.LinearLayoutCompat style="@style/healthHomeBottomLayout">
        <com.xiaomi.fitness.chart.mpchart.barchart.CustomBarChart
            android:id="@+id/bar_chart"
            app:done_color="@color/health_calorie_chart"
            app:duty_cycle="0.3"
            app:max_points="23"
            app:none_done_alpha="0.1"
            app:none_done_color="@color/common_transparent"
            app:rect_bar_radius="3dp"
            style="@style/healthHomeChart"/>
        <com.xiaomi.fitness.homepage.viewholder.XAxisView
            android:id="@+id/XAxisView"
            style="@style/healthHomeXAxisView"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.appcompat.widget.LinearLayoutCompat>
