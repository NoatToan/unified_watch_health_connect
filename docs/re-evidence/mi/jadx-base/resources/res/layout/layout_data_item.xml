<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:tag="layout/layout_data_item_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/rl_sport_record"
        android:background="@drawable/selector_white_top_round1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/img_sport_type"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="@dimen/margin_20dp"
            android:src="@drawable/sport_data_run_outdoor"
            android:scaleType="fitXY"
            android:layout_marginStart="@dimen/margin_20dp"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textColor="@color/health_home_txt_color"
            android:id="@+id/txt_sport_type_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_7dp"
            android:layout_below="@+id/img_sport_type"
            android:layout_marginStart="@dimen/dimen_margin_18dp"
            android:layout_alignParentStart="true"
            style="@style/FontMedium.16sp"/>
        <TextView
            android:textSize="@dimen/dimen_12sp"
            android:textColor="@color/health_home_txt_color"
            android:id="@+id/txt_data_content_str"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dimen_margin_22dp"
            android:layout_below="@+id/txt_sport_type_name"
            android:layout_marginStart="@dimen/dimen_margin_18dp"
            android:layout_alignParentStart="true"
            style="@style/FontRegular.11sp"/>
    </RelativeLayout>
    <View
        android:id="@+id/sport_card_divider"
        android:background="@color/divider_line_color"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginStart="@dimen/dimen_margin_18dp"
        android:layout_marginEnd="@dimen/dimen_margin_18dp"/>
    <RelativeLayout
        android:id="@+id/rl_sport_record_all"
        android:background="@drawable/selector_white_bottom_round"
        android:paddingTop="@dimen/margin_20dp"
        android:paddingBottom="@dimen/margin_20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dimen_margin_18dp"
        android:paddingEnd="@dimen/dimen_margin_18dp">
        <TextView
            android:textColor="@color/health_home_txt_color"
            android:gravity="center"
            android:id="@+id/txt_sport_all_list"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/health_sport_list_record"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            style="@style/FontMedium.16sp"/>
        <ImageView
            android:id="@+id/arrow_right_arrow_imgv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_right_arrow_icon"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</LinearLayout>
