<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/view_indoor_sport_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="35dp"
    android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
    android:layout_marginEnd="@dimen/page_content_padding_horizontal_large">
    <include
        android:id="@+id/title"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/view_indoor_title"/>
    <TextView
        android:textSize="64dp"
        android:textColor="@color/sport_detail_color"
        android:id="@+id/targetData"
        android:tag="binding_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="62dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"
        style="@style/FontDemiBold"/>
    <TextView
        android:textSize="18dp"
        android:textStyle="bold"
        android:textColor="@color/sport_detail_color"
        android:id="@+id/unit"
        android:tag="binding_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        app:layout_constraintBottom_toBottomOf="@+id/targetData"
        app:layout_constraintStart_toEndOf="@+id/targetData"
        style="@style/FontDemiBold"/>
    <FrameLayout
        android:id="@+id/percentage"
        android:tag="binding_3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/targetData">
        <include
            app:layout_constraintBottom_toBottomOf="parent"
            layout="@layout/view_indoor_sport_target"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/fl_container"
        android:tag="binding_4"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/percentage">
        <include layout="@layout/view_sport_data"/>
    </FrameLayout>
    <com.xiaomi.fitness.sport.view.widget.RunningSportMusicView
        android:id="@+id/indoorRunningMusicView"
        android:background="@drawable/bg_indoor_running_music"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="45dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fl_container"/>
</androidx.constraintlayout.widget.ConstraintLayout>
