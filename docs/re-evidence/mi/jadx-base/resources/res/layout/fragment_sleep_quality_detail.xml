<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_sleep_quality_detail_0"
    android:background="@color/page_bg"
    android:paddingBottom="@dimen/size_20"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="never">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/page_padding_horizontal_large">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_score_analyze"
            android:background="@drawable/selector_card_bg"
            android:paddingTop="@dimen/size_20"
            android:paddingBottom="@dimen/size_20"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_13"
            android:paddingStart="@dimen/size_18"
            android:paddingEnd="@dimen/size_18">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_analyze_icon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginBottom="24.6dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/health_ic_sleep_quality"/>
            <TextView
                android:textColor="@color/text_color"
                android:id="@+id/tv_analyze_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/health_sleep_quality_indicators_key"
                android:layout_marginStart="@dimen/size_6_7"
                app:layout_constraintBottom_toBottomOf="@+id/iv_analyze_icon"
                app:layout_constraintStart_toEndOf="@+id/iv_analyze_icon"
                app:layout_constraintTop_toTopOf="@+id/iv_analyze_icon"
                style="@style/FontMedium.14sp"/>
            <androidx.recyclerview.widget.RecyclerView
                android:layout_gravity="center_horizontal"
                android:id="@+id/level_desc_recyclerview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_21_3"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_analyze_title"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/analyze_recycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_10"
                android:overScrollMode="never"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintTop_toBottomOf="@+id/level_desc_recyclerview"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@drawable/selector_card_bg"
            android:paddingTop="@dimen/size_20"
            android:paddingBottom="@dimen/size_20"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_13"
            android:paddingStart="@dimen/size_18"
            android:paddingEnd="@dimen/size_18">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_icon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginBottom="24.6dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/health_ic_sleep_quality"/>
            <TextView
                android:textColor="@color/text_color"
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/health_sleep_how_to_improve"
                android:layout_marginStart="@dimen/size_6_7"
                app:layout_constraintBottom_toBottomOf="@+id/iv_icon"
                app:layout_constraintStart_toEndOf="@+id/iv_icon"
                app:layout_constraintTop_toTopOf="@+id/iv_icon"
                style="@style/FontMedium.14sp"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_dot_line_1"
                android:layout_marginTop="24.6dp"
                app:layout_constraintTop_toBottomOf="@+id/iv_icon"
                style="@style/HealthSleepQualityIcon"/>
            <TextView
                android:id="@+id/tv_desc_line_1"
                android:layout_marginTop="-5dp"
                android:text="@string/health_sleep_tip_avoid_stimulating_food"
                app:layout_constraintStart_toEndOf="@+id/iv_dot_line_1"
                app:layout_constraintTop_toTopOf="@+id/iv_dot_line_1"
                style="@style/HealthSleepQualityDesc"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_dot_line_2"
                app:layout_constraintTop_toTopOf="@+id/tv_desc_line_2"
                style="@style/HealthSleepQualityIcon"/>
            <TextView
                android:id="@+id/tv_desc_line_2"
                android:text="@string/health_sleep_tip_eat_less_before_bed"
                app:layout_constraintStart_toEndOf="@+id/iv_dot_line_2"
                app:layout_constraintTop_toBottomOf="@+id/tv_desc_line_1"
                style="@style/HealthSleepQualityDesc"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_dot_line_3"
                app:layout_constraintTop_toTopOf="@+id/tv_desc_line_3"
                style="@style/HealthSleepQualityIcon"/>
            <TextView
                android:id="@+id/tv_desc_line_3"
                android:text="@string/health_sleep_tip_relax_brain_before_sleep"
                app:layout_constraintStart_toEndOf="@+id/iv_dot_line_3"
                app:layout_constraintTop_toBottomOf="@+id/tv_desc_line_2"
                style="@style/HealthSleepQualityDesc"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_dot_line_4"
                app:layout_constraintTop_toTopOf="@+id/tv_desc_line_4"
                style="@style/HealthSleepQualityIcon"/>
            <TextView
                android:id="@+id/tv_desc_line_4"
                android:text="@string/health_sleep_tip_avoid_emotional_excitement"
                app:layout_constraintStart_toEndOf="@+id/iv_dot_line_4"
                app:layout_constraintTop_toBottomOf="@+id/tv_desc_line_3"
                style="@style/HealthSleepQualityDesc"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_dot_line_5"
                app:layout_constraintTop_toTopOf="@+id/tv_desc_line_5"
                style="@style/HealthSleepQualityIcon"/>
            <TextView
                android:id="@+id/tv_desc_line_5"
                android:text="@string/health_sleep_tip_maintain_comfortable_environment"
                app:layout_constraintStart_toEndOf="@+id/iv_dot_line_5"
                app:layout_constraintTop_toBottomOf="@+id/tv_desc_line_4"
                style="@style/HealthSleepQualityDesc"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_dot_line_6"
                app:layout_constraintTop_toTopOf="@+id/tv_desc_line_6"
                style="@style/HealthSleepQualityIcon"/>
            <TextView
                android:id="@+id/tv_desc_line_6"
                android:text="@string/health_sleep_tip_maintain_regular_sleep_schedule"
                app:layout_constraintStart_toEndOf="@+id/iv_dot_line_6"
                app:layout_constraintTop_toBottomOf="@+id/tv_desc_line_5"
                style="@style/HealthSleepQualityDesc"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_dot_line_7"
                app:layout_constraintTop_toTopOf="@+id/tv_desc_line_7"
                style="@style/HealthSleepQualityIcon"/>
            <TextView
                android:id="@+id/tv_desc_line_7"
                android:text="@string/health_sleep_tip_regular_exercise"
                app:layout_constraintStart_toEndOf="@+id/iv_dot_line_7"
                app:layout_constraintTop_toBottomOf="@+id/tv_desc_line_6"
                style="@style/HealthSleepQualityDesc"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:textColor="@color/text_color_60"
            android:id="@+id/tv_guide_assist_tip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_12"
            android:text="@string/health_sleep_open_assist_tip"
            android:paddingHorizontal="@dimen/size_18"
            style="@style/FontNormal.12sp"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
