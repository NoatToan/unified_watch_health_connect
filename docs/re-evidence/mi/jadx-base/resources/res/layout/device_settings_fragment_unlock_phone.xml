<?xml version="1.0" encoding="utf-8"?>
<miuix.springback.view.SpringBackLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/device_settings_fragment_unlock_phone_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:scrollableView="@+id/scrollview">
    <miuix.core.widget.NestedScrollView
        android:id="@+id/scrollview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <RelativeLayout
            android:paddingTop="@dimen/device_settings_list_padding_top"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="@dimen/page_content_padding_horizontal_large"
            android:paddingEnd="@dimen/page_content_padding_horizontal_large">
            <TextView
                android:textColor="@color/setting_item_second"
                android:id="@+id/unlockTipView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:layout_marginBottom="15dp"
                android:text="@string/device_settings_unlock_phone_open_bluetooth_tip"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/FontRegular.12sp"/>
            <com.xiaomi.fitness.widget.SwitchButtonTwoLineTextView
                android:id="@+id/unlockPhoneSwitchView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/unlockTipView"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/unlockTipView"
                app:title="@string/device_settings_unlock_phone"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/stepView"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/unlockPhoneSwitchView">
                <com.xiaomi.fitness.widget.RightArrowTwoLineTextView
                    android:id="@+id/setScreenPwdView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:title="@string/device_settings_unlock_phone_set_screen_pwd"/>
                <com.xiaomi.fitness.widget.RightArrowTwoLineTextView
                    android:id="@+id/setDeviceUnlockView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:title="@string/device_settings_unlock_phone_set_device_unlock"/>
            </LinearLayout>
            <RelativeLayout
                android:orientation="vertical"
                android:id="@+id/unlockDistanceView"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/stepView">
                <com.xiaomi.fitness.widget.RightArrowTwoLineTextView
                    android:id="@+id/setDeviceUnlockDistanceView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:subtitle="@string/device_settings_unlock_phone_set_unlock_distance"
                    app:title="@string/device_settings_unlock_phone_unlock_distance"/>
            </RelativeLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/bottomView"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="90dp"
                android:layout_alignParentBottom="true">
                <TextView
                    android:textColor="@color/text_color"
                    android:gravity="center"
                    android:id="@+id/unlockResetLable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/device_settings_unlock_phone_not_success_part1"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    style="@style/FontRegular.14sp"/>
                <TextView
                    android:textColor="@color/text_color"
                    android:id="@+id/reSetView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/device_settings_unlock_phone_not_success_part2"
                    style="@style/FontRegular.14sp"/>
                <TextView
                    android:textColor="@color/text_color"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_margin_5dp"
                    android:text="@string/device_settings_unlock_phone_remove"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    style="@style/FontRegular.14sp"/>
            </LinearLayout>
        </RelativeLayout>
    </miuix.core.widget.NestedScrollView>
</miuix.springback.view.SpringBackLayout>
