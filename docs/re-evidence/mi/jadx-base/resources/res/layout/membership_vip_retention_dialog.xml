<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/membership_vip_retention_dialog_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/icon"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:src="@drawable/membership_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/dimen_18sp"
        android:textColor="@color/membership_dialog_combo_item_text"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/icon"
        style="@style/FontDemiBold"/>
    <TextView
        android:textSize="@dimen/dimen_16sp"
        android:textColor="@color/membership_retention_dialog_desc_color"
        android:id="@+id/desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_16dp"
        android:text="@string/membership_vip_retention_desc"
        android:layout_marginHorizontal="@dimen/dimen_margin_26dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/button_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_28dp"
        app:layout_constraintTop_toBottomOf="@+id/desc">
        <TextView
            android:id="@+id/negative"
            android:layout_width="0dp"
            android:text="@string/cancel"
            android:layout_marginEnd="@dimen/dimen_margin_8dp"
            app:layout_constraintEnd_toStartOf="@+id/positive"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/CommonBtn.Normal"/>
        <TextView
            android:id="@+id/positive"
            android:layout_width="0dp"
            android:text="@string/membership_vip_retention_positive"
            android:layout_marginStart="@dimen/dimen_margin_8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/negative"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/CommonBtn.Membership"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
