<?xml version="1.0" encoding="utf-8"?>
<miuix.springback.view.SpringBackLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:scrollOrientation="angle|vertical"
    app:scrollableView="@+id/scroll_view">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="@dimen/size_10"
            android:paddingBottom="@dimen/userinfo_size_20"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/size_16_7"
            android:paddingEnd="@dimen/size_16_7">
            <TextView
                android:textSize="@dimen/text_size_18_67"
                android:textColor="@color/text_color_60"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/userinfo_lock_show_solve_description"/>
            <TextView
                android:textSize="@dimen/text_size_18_67"
                android:textColor="@color/text_color"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/userinfo_size_20"
                android:text="@string/userinfo_lock_show_solve_path"/>
            <TextView
                android:id="@+id/tv_go_open"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/userinfo_size_20"
                android:text="@string/userinfo_lock_show_solve_go"
                style="@style/userinfo_Button.FullWidth.LockScreenSolve"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/userinfo_size_20"
                android:src="@drawable/lock_show_guide"
                android:adjustViewBounds="true"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</miuix.springback.view.SpringBackLayout>
