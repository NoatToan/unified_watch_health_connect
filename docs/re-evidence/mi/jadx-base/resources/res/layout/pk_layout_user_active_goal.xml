<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/pk_layout_user_active_goal_0"
    android:background="@drawable/pk_active_goal_card_shape"
    android:paddingTop="@dimen/size_16_7"
    android:paddingBottom="@dimen/size_20"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/size_5">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guide_line_opp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.3"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guide_line_own"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.7"/>
    <TextView
        android:textColor="@color/text_color_40"
        android:ellipsize="end"
        android:gravity="end"
        android:id="@+id/tv_opp_nick_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="--"
        android:maxLines="1"
        android:layout_marginEnd="@dimen/size_23"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="9sp"
        app:layout_constraintEnd_toEndOf="@+id/guide_line_opp"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/FontRegular.12sp"/>
    <TextView
        android:textColor="@color/text_color_40"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/tv_own_nick_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="--"
        android:maxLines="1"
        android:layout_marginStart="@dimen/size_23"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="9sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="@+id/guide_line_own"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/FontRegular.12sp"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="tv_opp_nick_name,tv_own_nick_name"/>
    <TextView
        android:id="@+id/tv_opp_goal_first"
        android:layout_marginTop="@dimen/size_10"
        android:text="--"
        android:drawableEnd="@drawable/ic_pk_active_calories"
        app:layout_constraintTop_toBottomOf="@+id/barrier"
        style="@style/PkActiveGoalNumber.Opp"/>
    <TextView
        android:id="@+id/tv_opp_goal_second"
        android:layout_marginTop="@dimen/size_8"
        android:text="--"
        android:drawableEnd="@drawable/ic_pk_active_step"
        app:layout_constraintTop_toBottomOf="@+id/tv_opp_goal_first"
        style="@style/PkActiveGoalNumber.Opp"/>
    <TextView
        android:id="@+id/tv_opp_goal_third"
        android:layout_marginTop="@dimen/size_8"
        android:text="--"
        android:drawableEnd="@drawable/ic_pk_active_strength"
        app:layout_constraintTop_toBottomOf="@+id/tv_opp_goal_second"
        style="@style/PkActiveGoalNumber.Opp"/>
    <TextView
        android:id="@+id/tv_own_goal_first"
        android:layout_marginTop="@dimen/size_10"
        android:text="--"
        android:drawableStart="@drawable/ic_pk_active_calories"
        app:layout_constraintTop_toBottomOf="@+id/barrier"
        style="@style/PkActiveGoalNumber.Own"/>
    <TextView
        android:id="@+id/tv_own_goal_second"
        android:layout_marginTop="@dimen/size_8"
        android:text="--"
        android:drawableStart="@drawable/ic_pk_active_step"
        app:layout_constraintTop_toBottomOf="@+id/tv_own_goal_first"
        style="@style/PkActiveGoalNumber.Own"/>
    <TextView
        android:id="@+id/tv_own_goal_third"
        android:layout_marginTop="@dimen/size_8"
        android:text="--"
        android:drawableStart="@drawable/ic_pk_active_strength"
        app:layout_constraintTop_toBottomOf="@+id/tv_own_goal_second"
        style="@style/PkActiveGoalNumber.Own"/>
    <TextView
        android:textSize="@dimen/font_12"
        android:textColor="@color/text_color_20"
        android:id="@+id/tv_vs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12.67dp"
        android:text="@string/pk_vs"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/FontLatinHeavy"/>
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_26_67"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.xiaomi.fitness.widget.view.RoundImageView
            android:id="@+id/iv_opp_avatar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_pk_avatar_default"/>
        <FrameLayout
            android:background="@drawable/pk_avatar_divider_circle"
            android:layout_width="46dp"
            android:layout_height="44dp"
            android:layout_marginStart="@dimen/size_26_67">
            <com.xiaomi.fitness.widget.view.RoundImageView
                android:id="@+id/iv_own_avatar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_pk_avatar_default"
                android:layout_marginStart="2dp"/>
        </FrameLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
