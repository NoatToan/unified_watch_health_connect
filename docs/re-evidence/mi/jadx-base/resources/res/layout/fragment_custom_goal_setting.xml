<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_custom_goal_setting_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.xiaomi.fitness.sport.baseui.TitleBar
        android:id="@+id/titleView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.xiaomi.fitness.sport.view.widget.CustomGoalView
        android:id="@+id/customDistance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="90dp"
        app:layout_constraintBottom_toTopOf="@+id/recyclerView"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="94dp"
        android:layout_marginStart="26.7dp"
        android:layout_marginEnd="26.7dp"
        app:layout_constraintTop_toBottomOf="@+id/customDistance"/>
    <TextView
        android:textSize="@dimen/font_15"
        android:textColor="@color/common_white"
        android:gravity="center"
        android:id="@+id/start_sport"
        android:background="@drawable/shape_bg_black"
        android:layout_width="match_parent"
        android:layout_height="46.7dp"
        android:layout_marginBottom="26.7dp"
        android:text="@string/sport_go_sport"
        android:layout_marginStart="26.7dp"
        android:layout_marginEnd="26.7dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_goneMarginStart="20dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
