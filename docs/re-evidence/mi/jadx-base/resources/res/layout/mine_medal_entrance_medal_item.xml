<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/mine_medal_entrance_medal_item_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp">
    <ImageView
        android:id="@+id/medal_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="fitCenter"
        android:layout_centerHorizontal="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/medal_name"
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_5dp"
        android:lines="2"
        android:textAlignment="center"
        app:layout_constraintEnd_toEndOf="@+id/medal_icon"
        app:layout_constraintStart_toStartOf="@+id/medal_icon"
        app:layout_constraintTop_toBottomOf="@+id/medal_icon"
        style="@style/FontRegular.12sp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
