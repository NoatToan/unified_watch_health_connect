<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/health_layout_card_indicator_style_0"
    android:background="@drawable/selector_round"
    android:paddingTop="14dp"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="220dp"
    android:paddingHorizontal="@dimen/size_14">
    <com.xiaomi.fitness.v2.view.HomeCardCommonTitleView
        android:id="@+id/cardTitleView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/llCardChart"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardTitleView">
        <com.xiaomi.fitness.baseui.widget.LevelBarView
            android:layout_gravity="bottom"
            android:id="@+id/levelBarView"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_margin_40dp"
            app:enableRtl="true"
            app:layout_constraintBottom_toTopOf="@+id/xAxisView"
            app:levelBarHeight="10dp"
            app:levelBarRadius="5dp"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivEmpty"
            android:background="@drawable/shape_health_card_empty_bg"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginBottom="8dp"
            app:layout_constraintBottom_toTopOf="@+id/xAxisView"/>
        <com.xiaomi.fitness.homepage.viewholder.XAxisView
            android:id="@+id/xAxisView"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:xAxisEnableRTL="true"
            style="@style/healthHomeXAxisView"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
