<?xml version="1.0" encoding="utf-8"?>
<miuix.springback.view.SpringBackLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/device_settings_fragment_heart_setting_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:scrollableView="@+id/spring_back_target">
    <miuix.core.widget.NestedScrollView
        android:id="@+id/spring_back_target"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="@dimen/device_settings_list_padding_top"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="@dimen/page_content_padding_horizontal_large"
            android:paddingEnd="@dimen/page_content_padding_horizontal_large">
            <com.xiaomi.fitness.widget.RightArrowTwoLineTextView
                android:id="@+id/modeView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:subtitle="@string/device_settings_detection_mode_des"
                app:title="@string/device_settings_detection_mode"/>
            <com.xiaomi.fitness.widget.RightArrowTwoLineTextView
                android:id="@+id/intervalView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:subtitle="@string/device_settings_detection_frequency_des"
                app:title="@string/device_settings_detection_frequency"/>
            <com.xiaomi.fitness.widget.SwitchButtonTwoLineTextView
                android:id="@+id/activeView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:subtitle="@string/device_settings_heart_desc_active"
                app:title="@string/device_settings_heart_active"/>
            <com.xiaomi.fitness.widget.SwitchButtonTwoLineTextView
                android:id="@+id/pressureView"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:subtitle="@string/device_settings_desc_pressure"
                app:title="@string/device_settings_pressure_detection"/>
            <com.xiaomi.fitness.widget.view.DividerView
                android:layout_marginStart="0dp"
                android:layout_marginEnd="0dp"
                style="@style/SettingDivider"/>
            <com.xiaomi.fitness.widget.SwitchButtonTwoLineTextView
                android:id="@+id/warnSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:subtitle="@string/device_settings_detection_heart_rate_warning_des"
                app:title="@string/device_settings_detection_heart_rate_warning"/>
            <com.xiaomi.fitness.widget.RightArrowTwoLineTextView
                android:id="@+id/warnView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:title="@string/device_settings_detection_rate_warning_value"/>
            <com.xiaomi.fitness.devicesettings.widget.DeviceReminderView
                android:tag="binding_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_40dp"/>
        </LinearLayout>
    </miuix.core.widget.NestedScrollView>
</miuix.springback.view.SpringBackLayout>
