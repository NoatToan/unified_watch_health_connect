<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.cardview.widget.CardView
        android:id="@+id/card_view"
        android:background="@color/page_bg"
        android:layout_width="match_parent"
        android:layout_height="400dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:cardMaxElevation="@dimen/dimen_margin_10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@color/page_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/info_view"
                android:background="@drawable/share_just_dance_basic_info_bg"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:paddingHorizontal="@dimen/page_padding_horizontal_large"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/bg">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:id="@+id/song_name_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/white"
                    android:id="@+id/song_arc_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/song_name_tv"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/mask_iv"
                android:background="@drawable/share_just_dance_logo_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@+id/info_view"
                app:layout_constraintEnd_toEndOf="@+id/bg"/>
            <TextView
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/text_color"
                android:id="@+id/just_dance_score_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_16dp"
                android:fontFamily="@string/mipro_medium"
                android:layout_marginStart="16dp"
                app:layout_constraintStart_toStartOf="@+id/info_view"
                app:layout_constraintTop_toBottomOf="@+id/info_view"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/text_color_40"
                android:id="@+id/just_dance_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/trail_sports_report_just_dance_score"
                android:layout_marginStart="2dp"
                app:layout_constraintStart_toStartOf="@+id/just_dance_score_tv"
                app:layout_constraintTop_toBottomOf="@+id/just_dance_score_tv"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/text_color_40"
                android:id="@+id/just_dance_calorie"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/trail_sports_report_just_dance_calorie"
                android:layout_marginEnd="60dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/just_dance_calorie_tv"/>
            <TextView
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/text_color"
                android:id="@+id/just_dance_calorie_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_16dp"
                android:fontFamily="@string/mipro_medium"
                app:layout_constraintStart_toStartOf="@+id/just_dance_calorie"
                app:layout_constraintTop_toBottomOf="@+id/info_view"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/text_color"
                android:id="@+id/just_dance_calorie_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp"
                android:text="kcal"
                android:layout_marginStart="2dp"
                app:layout_constraintBottom_toBottomOf="@+id/just_dance_calorie_tv"
                app:layout_constraintStart_toEndOf="@+id/just_dance_calorie_tv"/>
            <com.xiaomi.fitness.detail.view.JustDanceScoreLevelView
                android:id="@+id/just_dance_score_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:minWidth="80dp"
                android:layout_marginStart="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/just_dance_score"/>
            <TextView
                android:textSize="@dimen/font_10"
                android:textColor="@color/text_color"
                android:id="@+id/app_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_15dp"
                android:layout_marginBottom="16dp"
                android:text="@string/app_name"
                android:drawablePadding="4dp"
                android:fontFamily="@font/misanslatin_semibold"
                android:layout_marginStart="@dimen/page_extra_padding_horizontal_large"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:background="@color/white"
                android:padding="3dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:layout_marginEnd="@dimen/page_extra_padding_horizontal_large"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent">
                <ImageView
                    android:id="@+id/qr_code"
                    android:layout_width="30.3dp"
                    android:layout_height="30.3dp"
                    android:contentDescription="qr code"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
