<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:background="@drawable/selector_card_bg"
    android:paddingTop="@dimen/size_17_3"
    android:paddingBottom="@dimen/size_17_3"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/page_content_padding_horizontal_large">
    <TextView
        android:textStyle="bold"
        android:gravity="start"
        android:layout_gravity="center_vertical"
        android:id="@+id/tv_record_time"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        style="@style/CardTextAppearance.LabelTitle"/>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:gravity="end"
            android:id="@+id/tv_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/CardTextAppearance.ItemStatus"/>
        <TextView
            android:gravity="end"
            android:id="@+id/tv_second_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/CardTextAppearance.ItemStatus"/>
    </LinearLayout>
    <TextView
        android:background="@drawable/ic_base_right_arrow_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</LinearLayout>
