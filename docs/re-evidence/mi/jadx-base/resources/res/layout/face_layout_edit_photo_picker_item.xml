<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/face_layout_edit_photo_picker_item_0"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/preview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/duration_layout"
        android:background="@drawable/face_bg_video_duration"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dimen_margin_7dp"
        android:paddingEnd="@dimen/dimen_margin_6dp"
        android:paddingVertical="@dimen/dimen_margin_6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/face_video_preview_icon"/>
        <TextView
            android:textSize="@dimen/dimen_11sp"
            android:textColor="@color/white"
            android:id="@+id/duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_margin_4dp"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/checkView"
        android:background="@drawable/selector_face_check"
        android:visibility="gone"
        android:layout_width="@dimen/dimen_margin_24dp"
        android:layout_height="@dimen/dimen_margin_24dp"
        android:layout_marginBottom="@dimen/dimen_margin_5dp"
        android:layout_marginEnd="@dimen/dimen_margin_4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
