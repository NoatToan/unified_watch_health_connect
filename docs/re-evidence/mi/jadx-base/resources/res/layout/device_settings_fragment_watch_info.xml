<?xml version="1.0" encoding="utf-8"?>
<miuix.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/spring_back_target"
    android:tag="layout/device_settings_fragment_watch_info_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/device_debug_info_btn"
            android:background="@drawable/icon_common_more"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/page_content_padding_horizontal_large"
            android:layout_marginEnd="@dimen/page_content_padding_horizontal_large"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/layoutView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/page_content_padding_horizontal_large"
            android:paddingEnd="@dimen/page_content_padding_horizontal_large"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/device_imageview"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_marginTop="13dp"
                android:scaleType="centerCrop"/>
            <TextView
                android:textColor="@color/feature_item_title_text_color"
                android:layout_gravity="center_horizontal"
                android:id="@+id/device_name_tv"
                android:tag="binding_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_16sp"
                style="@style/FontMedium.16sp"/>
            <com.xiaomi.fitness.widget.view.DividerView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="20dp"/>
            <com.xiaomi.fitness.widget.RightArrowBindingTwoLineTextView
                android:id="@+id/device_model_view"
                android:tag="binding_2"
                app:title="@string/device_settings_device_info_model"
                style="@style/DeviceSettingsInfoListItem"/>
            <com.xiaomi.fitness.widget.RightArrowBindingTwoLineTextView
                android:id="@+id/device_mac_view"
                android:tag="binding_3"
                app:title="@string/device_settings_device_mac"
                style="@style/DeviceSettingsInfoListItem"/>
            <com.xiaomi.fitness.widget.RightArrowBindingTwoLineTextView
                android:id="@+id/device_version_view"
                android:tag="binding_4"
                app:title="@string/device_settings_device_version"
                style="@style/DeviceSettingsInfoListItem"/>
            <com.xiaomi.fitness.widget.RightArrowBindingTwoLineTextView
                android:id="@+id/device_serial_number_view"
                android:tag="binding_5"
                app:title="@string/device_settings_device_serial_number"
                style="@style/DeviceSettingsInfoListItem"/>
            <com.xiaomi.fitness.widget.RightArrowBindingSingleLineTextView
                android:id="@+id/device_law_info_view"
                android:tag="binding_6"
                android:visibility="gone"
                app:title="@string/device_settings_device_law_info"
                style="@style/DeviceSettingsInfoListItem"/>
            <com.xiaomi.fitness.widget.RightArrowTwoLineTextView
                android:id="@+id/device_privacy_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:title="@string/device_settings_device_privacy_policy"/>
            <com.xiaomi.fitness.widget.RightArrowTwoLineTextView
                android:id="@+id/device_user_agreement"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:title="@string/device_settings_device_user_agreement"/>
            <com.xiaomi.fitness.widget.RightArrowTwoLineTextView
                android:id="@+id/privacy_revoke_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:title="@string/device_settings_privacy_revoke"/>
            <com.xiaomi.fitness.widget.RightArrowTwoLineTextView
                android:id="@+id/dump_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:title="@string/device_settings_dump_device_log"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</miuix.core.widget.NestedScrollView>
