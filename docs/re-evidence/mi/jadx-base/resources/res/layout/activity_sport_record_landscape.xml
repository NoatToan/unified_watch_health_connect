<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/activity_sport_record_landscape_0"
    android:background="@color/page_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="10dp">
    <ImageView
        android:id="@+id/ic_back"
        android:background="@drawable/ic_base_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_25dp"
        android:contentDescription="@string/back"
        android:paddingStart="@dimen/dimen_margin_18dp"
        android:paddingEnd="@dimen/dimen_margin_18dp"
        android:layout_marginHorizontal="@dimen/dimen_margin_18dp"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="80dp">
        <androidx.recyclerview.widget.RecyclerView
            android:layout_gravity="center"
            android:id="@+id/title_choice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/fl_chart"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="-80dp">
        <com.xiaomi.fitness.chart.view.SportRecordChartRecyclerView
            android:id="@+id/line_recycler"
            android:paddingTop="80dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="55dp"
            android:paddingEnd="55dp"
            app:barSpace="0"
            app:contentPaddingTop="0dp"
            app:displayNumbers="80"
            app:enableEndYAxisLabel="false"
            app:enableLineFill="false"
            app:enableScrollToScale="true"
            app:enableStartYAxisLabel="false"
            app:enableXAxisLineCircle="false"
            app:enableYAxisLineDash="true"
            app:layoutManagerReverseLayout="false"
            app:lineColor="@color/bar_chart_pink"
            app:lineStrokeWidth="4"
            app:recyclerPaddingRight="3dp"
            app:xAxisScaleDistance="8"/>
    </FrameLayout>
</LinearLayout>
