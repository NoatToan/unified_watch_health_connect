    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/weight_measure"
            android:background="@color/electronic_scale_userinfo_white"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/layout_weight"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_centerInParent="true">
                <TextView
                    android:textSize="60sp"
                    android:textStyle="bold"
                    android:textColor="@color/electronic_scale_weight_black"
                    android:layout_gravity="bottom"
                    android:id="@+id/measure_weight_integer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"/>
                <TextView
                    android:textSize="60sp"
                    android:textStyle="bold"
                    android:textColor="@color/electronic_scale_weight_black"
                    android:layout_gravity="bottom"
                    android:id="@+id/measure_weight_point"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=".2"/>
                <TextView
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/electronic_scale_weight_black"
                    android:layout_gravity="bottom"
                    android:id="@+id/measure_weight_unit"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dimen_margin_5dp"
                    android:text="kg"/>
            </LinearLayout>
            <RelativeLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="4">
                <com.xiaomi.fitness.electronic.scale.widget.banner.EcoBanner
                    android:id="@+id/bannerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="@dimen/dimen_margin_20dp"
                    android:scaleType="centerInside"
                    android:layout_above="@+id/measure_title"
                    android:layout_marginHorizontal="@dimen/dimen_margin_30dp"/>
