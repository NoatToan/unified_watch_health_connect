<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:background="@drawable/device_settings_selector_widget_edit_card_bg"
    android:paddingTop="20dp"
    android:paddingBottom="20dp"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:minHeight="98.7dp"
    android:paddingStart="18dp"
    android:paddingEnd="18dp">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/img_function"
        android:layout_width="58.7dp"
        android:layout_height="58.7dp"
        android:src="@drawable/device_settings_bg_black_04_radius_12"
        android:layout_centerVertical="true"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textStyle="bold"
        android:textColor="@color/text_color"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="12dp"
        android:layout_toStartOf="@+id/img_state_icon"
        android:layout_toEndOf="@+id/img_function"
        style="@style/FontRegular.16sp"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/img_state_icon"
        android:layout_width="@dimen/size_30"
        android:layout_height="@dimen/size_30"
        android:src="@drawable/device_settings_ic_widget_add"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
