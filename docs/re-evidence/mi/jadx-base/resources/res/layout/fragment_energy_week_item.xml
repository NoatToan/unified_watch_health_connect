<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/energy_container"
    android:tag="layout/fragment_energy_week_item_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.xiaomi.fitness.chart.view.BarChartRecyclerView
            android:id="@+id/bar_recycler"
            app:barChartMaxWidth="@dimen/size_10"
            app:barChartRoundRectRadiusRatio="0.4"
            app:barSpace="0.75"
            app:chartColor="@color/data_energy"
            app:displayNumbers="7"
            app:enableAverageRectF="false"
            app:enableCharValueDisplay="false"
            app:enableEndYAxisLabel="true"
            app:enableStartYAxisLabel="false"
            app:enableXAxisBg="true"
            app:rateChartLightColor="@color/data_energy"
            style="@style/ChartBaseStyle"/>
        <com.xiaomi.fitness.view.DataTitleView
            android:id="@+id/dataTitleView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <include
        android:id="@+id/ll_card"
        layout="@layout/layout_energy_dwm_common"/>
</LinearLayout>
