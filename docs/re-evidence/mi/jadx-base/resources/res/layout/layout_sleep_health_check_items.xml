<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/health_sleep_banner_card_set"
    android:tag="layout/layout_sleep_health_check_items_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/healthSleepResearchLayoutSet"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/healthSleepResearchEntityLayout"
            android:background="@drawable/shape_card_bg_normal"
            android:padding="16dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/dimen_margin_16dp"
            android:paddingVertical="@dimen/dimen_margin_8dp"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/dividerView"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textColor="@color/health_sleep_rhythm_monitor_entrance_title_color"
                android:id="@+id/healthSleepResearchEntityTopTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/health_peking_university_third_hospital_united"
                android:layout_marginEnd="5dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/FontMedium.14sp"/>
            <TextView
                android:textSize="17sp"
                android:textColor="@color/text_color"
                android:gravity="start"
                android:id="@+id/healthSleepResearchEntityTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/health_sleep_research_entity_title"
                android:textDirection="locale"
                android:layout_marginEnd="5dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/healthSleepResearchEntityTopTitle"
                style="@style/FontMedium"/>
            <TextView
                android:textSize="@dimen/dimen_14sp"
                android:textColor="@color/text_color_40"
                android:gravity="start"
                android:id="@+id/healthSleepResearchEntitySubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/health_sleep_research_entity_desc"
                android:textDirection="locale"
                android:layout_marginEnd="5dp"
                app:layout_constraintEnd_toStartOf="@+id/healthSleepResearchEntityPicture"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/healthSleepResearchEntityTitle"
                style="@style/FontNormal"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/healthSleepResearchEntityPicture"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/healthSleepResearchEntitySubtitle">
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:layout_width="29dp"
                    android:layout_height="29dp"
                    android:src="@drawable/health_research_logo"
                    android:scaleType="centerInside"
                    android:layout_marginStart="-3dp"/>
                <View
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/layer_divider_line"
                    android:layout_width="1dp"
                    android:layout_height="16dp"
                    android:layout_marginHorizontal="8dp"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:layout_width="80dp"
                    android:layout_height="20dp"
                    android:src="@drawable/health_ic_peking_university_third_hospital"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:id="@+id/dividerView"
            android:layout_width="10dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/card_sleep_rhythm_monitor_entrance"
            app:layout_constraintStart_toEndOf="@+id/healthSleepResearchEntityLayout"
            app:layout_constraintTop_toTopOf="parent"/>
        <include
            android:id="@+id/card_sleep_rhythm_monitor_entrance"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@+id/dividerView"
            app:layout_constraintTop_toTopOf="parent"
            layout="@layout/layout_sleep_rhythm_monitor_entrance"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <include
        android:id="@+id/sleepInterfereLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        layout="@layout/layout_sleep_interfere_create_entry"/>
    <com.xiaomi.fitness.view.HealthBannerCardSetView
        android:id="@+id/health_banner_card_set"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_12dp"/>
</LinearLayout>
