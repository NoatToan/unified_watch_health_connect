<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/remind_root_view"
        android:background="@drawable/device_settings_banner_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14sp"
            android:textColor="@color/device_banner_setting_title"
            android:id="@+id/remind_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_16dp"
            android:layout_marginStart="@dimen/dimen_margin_18dp"
            android:layout_marginEnd="54dp"
            app:layout_constraintEnd_toStartOf="@+id/open_remind_btn"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/FontMedium"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="12sp"
            android:textColor="@color/device_banner_setting_title"
            android:id="@+id/remind_des"
            android:paddingBottom="@dimen/dimen_margin_16dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_margin_18dp"
            android:layout_marginEnd="54dp"
            app:layout_constraintEnd_toStartOf="@+id/open_remind_btn"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/remind_title"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="12sp"
            android:textColor="@color/device_banner_setting_button_text"
            android:gravity="center"
            android:id="@+id/open_remind_btn"
            android:background="@drawable/device_settings_remind_open_btn_bg"
            android:layout_width="64dp"
            android:layout_height="36dp"
            android:text="@string/device_manager_device_setting_remind_to_open"
            android:layout_marginEnd="@dimen/dimen_margin_18dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/close_icon"
            android:background="@drawable/device_remind_banner_close_icon"
            android:padding="@dimen/dimen_margin_10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_5dp"
            android:contentDescription="@string/close"
            android:layout_marginEnd="@dimen/dimen_margin_5dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
