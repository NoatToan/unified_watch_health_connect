<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/shape_card_bg_normal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/dimen_margin_14dp"
    android:paddingVertical="@dimen/dimen_margin_12dp">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/card_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_8dp"
        android:layout_marginHorizontal="@dimen/dimen_margin_6dp">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/image_abnormal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="17sp"
            android:layout_gravity="center_vertical"
            android:id="@+id/abnormal_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/health_today_health_long_sleep"
            android:layout_marginStart="@dimen/dimen_margin_6dp"
            style="@style/FontDemiBold"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/guide_view"
            android:background="@drawable/today_health_guide_view"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_margin_4dp"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/size_26"
        android:textColor="@color/text_color"
        android:id="@+id/title_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_16dp"
        android:layout_marginStart="@dimen/dimen_margin_6dp"
        style="@style/FontDemiBold"/>
    <TextView
        android:textSize="@dimen/dimen_15sp"
        android:textColor="@color/text_color_40"
        android:id="@+id/ref_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_margin_2dp"
        android:layout_marginStart="@dimen/dimen_margin_6dp"/>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="vertical"
        android:id="@+id/abnormal_record_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
</LinearLayout>
