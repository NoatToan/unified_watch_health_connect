<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/long_sleep_container"
        android:background="@drawable/common_card_bg_white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="yes"
        android:screenReaderFocusable="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="horizontal"
            android:id="@+id/card_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_20dp"
            android:paddingStart="@dimen/dimen_margin_20dp">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/image_view"
                android:background="@drawable/health_data_sleep_square"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="17sp"
                android:layout_gravity="center_vertical"
                android:id="@+id/title_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/health_today_health_long_sleep"
                android:layout_marginStart="@dimen/dimen_margin_6dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/image_view"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/FontMedium"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/guide_view"
                android:background="@drawable/today_health_guide_view"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dimen_margin_4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/title_view"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/detail_view"
                android:background="@drawable/today_health_right_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/dimen_margin_10dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <include
            android:id="@+id/detail_title"
            layout="@layout/layout_sleep_chart_detail_title_check"/>
        <FrameLayout
            android:id="@+id/chart_frame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-100dp">
            <com.xiaomi.fitness.chart.view.SleepChartRecyclerView
                android:id="@+id/chart_recycler"
                android:paddingTop="100dp"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="337dp"
                android:importantForAccessibility="yes"
                android:paddingStart="@dimen/dimen_margin_20dp"
                android:paddingEnd="@dimen/dimen_margin_30dp"
                android:screenReaderFocusable="true"
                app:contentPaddingBottom="@dimen/size_53"
                app:sleepItemHeight="@dimen/health_sleep_chart_item_height"
                style="@style/ChartBaseStyle"/>
        </FrameLayout>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/sleep_rate_recycler"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_20dp"/>
</LinearLayout>
