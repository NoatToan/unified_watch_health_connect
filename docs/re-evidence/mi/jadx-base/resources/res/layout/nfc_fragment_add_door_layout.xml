<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:tag="layout/nfc_fragment_add_door_layout_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/layoutView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/nfc_common_layout_padding"
            android:paddingEnd="@dimen/nfc_common_layout_padding">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/cloudContainnerListView"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/nfc_tsm_text_size_content_medium"
                    android:textColor="@color/text_color_40"
                    android:ellipsize="end"
                    android:gravity="start|center_vertical"
                    android:id="@+id/cardGroupNameView"
                    android:layout_width="match_parent"
                    android:layout_height="33dp"
                    android:text="@string/nfc_backup_door_cloud"
                    android:singleLine="true"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/cloudListView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <View
                android:id="@+id/lineView"
                android:visibility="gone"
                android:layout_height="1px"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                style="@style/HorizontalSeparatorLine"/>
            <TextView
                android:textSize="@dimen/nfc_tsm_text_size_content_medium"
                android:textColor="@color/text_color_40"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:id="@+id/addCardGroupNameView"
                android:layout_width="match_parent"
                android:layout_height="33dp"
                android:text="@string/nfc_add_door_title"
                android:singleLine="true"/>
            <RelativeLayout
                android:id="@+id/copyCardView"
                android:background="@drawable/selector_white"
                android:paddingTop="15dp"
                android:paddingBottom="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/door_card_mifare_logo_iv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/nfc_add_door_card_mifare_icon"
                    android:layout_centerVertical="true"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="17dp"
                    android:layout_toEndOf="@+id/door_card_mifare_logo_iv">
                    <TextView
                        android:textSize="@dimen/nfc_common_textsize_2"
                        android:textColor="@color/text_color"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/nfc_add_door_card_mifare_title"/>
                    <TextView
                        android:textSize="@dimen/nfc_common_textsize_4"
                        android:textColor="@color/text_color_50"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="@string/nfc_add_door_card_mifare_desc"/>
                </LinearLayout>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_base_right_arrow_icon"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/blankCardView"
                android:background="@drawable/selector_white"
                android:paddingTop="15dp"
                android:paddingBottom="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/door_card_custom_logo_iv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/nfc_add_door_card_custom_icon"
                    android:layout_centerVertical="true"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="17dp"
                    android:layout_toEndOf="@+id/door_card_custom_logo_iv">
                    <TextView
                        android:textSize="@dimen/nfc_common_textsize_2"
                        android:textColor="@color/text_color"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/nfc_add_door_card_custom_title"/>
                    <TextView
                        android:textSize="@dimen/nfc_common_textsize_4"
                        android:textColor="@color/text_color_50"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="@string/nfc_add_door_card_custom_desc"/>
                </LinearLayout>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_base_right_arrow_icon"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/miLockView"
                android:background="@drawable/selector_white"
                android:paddingTop="15dp"
                android:paddingBottom="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/door_card_lock_logo_iv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/nfc_add_door_card_lock_icon"
                    android:layout_centerVertical="true"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="17dp"
                    android:layout_toEndOf="@+id/door_card_lock_logo_iv">
                    <TextView
                        android:textSize="@dimen/nfc_common_textsize_2"
                        android:textColor="@color/text_color"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/nfc_add_door_card_lock_title"/>
                    <TextView
                        android:textSize="@dimen/nfc_common_textsize_4"
                        android:textColor="@color/text_color_50"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="@string/nfc_add_door_card_lock_desc"/>
                </LinearLayout>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_base_right_arrow_icon"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="60dp">
        <CheckBox
            android:textSize="@dimen/nfc_tsm_text_size_content_small"
            android:gravity="center_vertical"
            android:id="@+id/add_door_card_check"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:button="@drawable/selector_check"
            android:text="@string/nfc_common_agree"
            android:drawablePadding="2dp"
            style="@style/nfc_TextAppearance.Content.Light"/>
        <TextView
            android:textSize="@dimen/nfc_tsm_text_size_content_small"
            android:textStyle="bold"
            android:textColor="@color/text_color_80"
            android:id="@+id/add_door_card_protocols"
            android:text="@string/nfc_add_door_card_protocol"
            android:layout_marginStart="3.3dp"
            style="@style/nfc_TextAppearance.Content"/>
    </LinearLayout>
</LinearLayout>
