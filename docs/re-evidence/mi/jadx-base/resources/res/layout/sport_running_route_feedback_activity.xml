<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/sport_running_route_feedback_activity_0"
    android:paddingTop="@dimen/dimen_margin_40dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.xiaomi.fitness.widget.SlidableScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dimen_margin_16dp"
        android:layout_marginBottom="@dimen/dimen_margin_40dp"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@+id/submit_btn"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <EditText
                android:textColor="@color/text_color_60"
                android:textColorHint="@color/text_color_40"
                android:gravity="start"
                android:id="@+id/problem_desc_et"
                android:background="@drawable/shape_card_bg_pressed"
                android:paddingTop="@dimen/dimen_margin_10dp"
                android:paddingBottom="@dimen/dimen_margin_40dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:minHeight="140dp"
                android:hint="@string/sport_feedback_advice_hint"
                android:inputType="textMultiLine"
                android:layout_marginHorizontal="@dimen/page_padding_horizontal_large"
                android:paddingHorizontal="@dimen/dimen_margin_10dp"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/FontNormal.14sp"/>
            <TextView
                android:id="@+id/word_count_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dimen_margin_15dp"
                android:layout_marginEnd="@dimen/dimen_margin_15dp"
                app:layout_constraintBottom_toBottomOf="@+id/problem_desc_et"
                app:layout_constraintEnd_toEndOf="@+id/problem_desc_et"
                style="@style/FontNormal.14sp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.xiaomi.fitness.widget.SlidableScrollView>
    <TextView
        android:textColor="@color/text_color_30"
        android:gravity="center"
        android:id="@+id/submit_btn"
        android:background="@drawable/shape_bottom_btn_native_bg_normal"
        android:layout_width="306.6641dp"
        android:layout_height="46.67dp"
        android:layout_marginBottom="18.3dp"
        android:text="@string/common_submit"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
