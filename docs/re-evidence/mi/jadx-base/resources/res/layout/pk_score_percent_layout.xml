<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/parent"
    android:tag="layout/pk_score_percent_layout_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="50.7dp"
    android:layout_marginStart="@dimen/dimen_margin_18dp"
    android:layout_marginEnd="@dimen/dimen_margin_18dp">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guide_line_own"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.49"/>
    <ImageView
        android:id="@+id/iv_opp_rect"
        android:background="@drawable/ic_pk_opp_default_rect"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="0.5"/>
    <ImageView
        android:id="@+id/iv_own_rect"
        android:background="@drawable/ic_pk_own_default_rect"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/guide_line_own"/>
    <ImageView
        android:id="@+id/iv_opp_win"
        android:background="@drawable/ic_pk_win"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size_23_3"
        android:layout_marginEnd="@dimen/size_4_5"
        app:layout_constraintBottom_toBottomOf="@+id/iv_own_rect"
        app:layout_constraintEnd_toEndOf="@+id/iv_opp_rect"/>
    <ImageView
        android:id="@+id/iv_own_win"
        android:background="@drawable/ic_pk_win"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size_23_3"
        android:layout_marginStart="@dimen/size_7"
        app:layout_constraintBottom_toBottomOf="@+id/iv_own_rect"
        app:layout_constraintStart_toStartOf="@+id/iv_own_rect"/>
    <TextView
        android:textSize="@dimen/font_16"
        android:textColor="@color/pk_score_view_empty_text_color"
        android:id="@+id/tv_opp_score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="2"
        android:layout_marginStart="@dimen/size_13_3"
        app:layout_constraintBottom_toBottomOf="@+id/iv_opp_rect"
        app:layout_constraintEnd_toEndOf="@+id/iv_opp_rect"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_opp_rect"/>
    <TextView
        android:textSize="@dimen/font_16"
        android:textColor="@color/pk_score_view_empty_text_color"
        android:id="@+id/tv_own_score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/size_13_3"
        app:layout_constraintBottom_toBottomOf="@+id/iv_own_rect"
        app:layout_constraintEnd_toEndOf="@+id/iv_own_rect"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="@+id/iv_own_rect"
        app:layout_constraintTop_toTopOf="@+id/iv_own_rect"/>
</androidx.constraintlayout.widget.ConstraintLayout>
