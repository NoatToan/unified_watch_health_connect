<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/eco_course_activity_bike_audio_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/sport_data_layout"
        android:paddingTop="17.66dp"
        android:paddingBottom="17.66dp"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:minWidth="240dp"
        android:paddingStart="35dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/title_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/sport_time_tv"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="13.33sp"
            android:textColor="@color/text_color"
            android:id="@+id/audio_title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="128dp"
            android:includeFontPadding="false"
            app:layout_constraintBottom_toTopOf="@+id/curDeviceView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/dimen_12sp"
            android:textColor="@color/text_color"
            android:gravity="center"
            android:id="@+id/curDeviceView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            app:layout_constraintBottom_toTopOf="@+id/sport_time_tv"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/audio_title_tv"/>
        <TextView
            android:textSize="@dimen/dimen_12sp"
            android:textColor="@color/text_color"
            android:gravity="center"
            android:id="@+id/sportDeviceView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/curDeviceView"/>
        <ImageView
            android:id="@+id/link_status_iv"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginLeft="5dp"
            android:src="@drawable/course_audio_link_open"
            app:layout_constraintBottom_toBottomOf="@+id/sportDeviceView"
            app:layout_constraintStart_toEndOf="@+id/sportDeviceView"
            app:layout_constraintTop_toTopOf="@+id/sportDeviceView"/>
        <TextView
            android:textSize="33.33sp"
            android:textColor="@color/text_color"
            android:id="@+id/sport_time_tv"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="00:00:00"
            android:includeFontPadding="false"
            android:fontFamily="@font/misanslatin_demibold"
            app:layout_constraintBottom_toTopOf="@+id/data_container_all"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/curDeviceView"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/data_container_all"
            android:layout_width="255dp"
            android:layout_height="wrap_content"
            android:minWidth="100dp"
            android:minHeight="30dp"
            app:layout_constraintBottom_toTopOf="@+id/heartrate_layout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/sport_time_tv">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/data_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_20dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/data_container1"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="@+id/data_container"
                app:layout_constraintTop_toBottomOf="@+id/data_container"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/heartrate_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/data_container_all">
            <TextView
                android:textSize="@dimen/dialog_text_size_30"
                android:textColor="@color/text_color"
                android:id="@+id/heartrate_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:drawableRight="@drawable/course_audio_heartrate_img"
                android:drawablePadding="@dimen/course_dimen_2dp"
                android:fontFamily="@font/misanslatin_demibold"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/course_hr"
                android:includeFontPadding="false"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/heartrate_tv"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:textColor="@color/text_color"
            android:id="@+id/body_condition_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="64dp"
            android:text="@string/course_hr_stage_warmup"
            android:includeFontPadding="false"
            app:layout_constraintBottom_toBottomOf="@+id/heartrate_layout"
            app:layout_constraintStart_toEndOf="@+id/heartrate_layout"
            app:layout_constraintTop_toTopOf="@+id/heartrate_layout"
            style="@style/FontDemiBold.24sp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/body_condition_ll"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/body_condition_tv"
            app:layout_constraintStart_toEndOf="@+id/body_condition_tv"
            app:layout_constraintTop_toTopOf="@+id/body_condition_tv">
            <View
                android:id="@+id/label0"
                android:background="@color/black_15_transparent"
                android:layout_width="4dp"
                android:layout_height="match_parent"/>
            <View
                android:id="@+id/label1"
                android:background="@color/black_15_transparent"
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:layout_marginStart="2dp"/>
            <View
                android:id="@+id/label2"
                android:background="@color/black_15_transparent"
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:layout_marginStart="2dp"/>
            <View
                android:id="@+id/label3"
                android:background="@color/black_15_transparent"
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:layout_marginStart="2dp"/>
            <View
                android:id="@+id/label4"
                android:background="@color/black_15_transparent"
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:layout_marginStart="2dp"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="43dp"
        android:layout_marginEnd="23dp"
        app:layout_constraintEnd_toStartOf="@+id/sport_operation_layout"
        app:layout_constraintStart_toEndOf="@+id/sport_data_layout">
        <TextView
            android:textSize="17sp"
            android:textColor="@color/text_color"
            android:id="@+id/audio_subtitle_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="106dp"
            android:includeFontPadding="false"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/FontDemiBold"/>
        <com.mi.health.course.eco.widget.LineChartView
            android:id="@+id/speed_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/course_share_bottom"
            android:layout_marginBottom="60dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/audio_subtitle_tv"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/sport_operation_layout"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:paddingEnd="@dimen/margin_27dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/audio_stop_iv"
            android:background="@drawable/course_stop_bg"
            android:visibility="gone"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_marginTop="60dp"
            android:src="@drawable/course_audio_stop_img"
            android:scaleType="center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/audio_pause_iv"
            android:background="@drawable/course_start_or_pause_bg"
            android:visibility="gone"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_marginBottom="60dp"
            android:src="@drawable/course_audio_pause_img"
            android:scaleType="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <ImageView
            android:id="@+id/audio_start_iv"
            android:background="@drawable/course_start_or_pause_bg"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:src="@drawable/course_audio_starting_img"
            android:scaleType="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.airbnb.lottie.LottieAnimationView
        android:layout_gravity="center"
        android:id="@+id/countdown_lottie_view"
        android:background="@color/common_white"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:lottie_fileName="lottie/countdown_white.json"/>
</androidx.constraintlayout.widget.ConstraintLayout>
