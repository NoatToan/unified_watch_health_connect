<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/ability_medal_progress_layout_tablet_0"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/anchor1"
            android:layout_width="1dp"
            android:layout_height="1dp"
            app:layout_constraintEnd_toEndOf="@+id/medal1_layout"
            app:layout_constraintStart_toStartOf="@+id/medal1_layout"
            app:layout_constraintTop_toTopOf="@+id/medal1_layout"/>
        <View
            android:id="@+id/anchor2"
            android:layout_width="1dp"
            android:layout_height="1dp"
            app:layout_constraintEnd_toEndOf="@+id/medal4_layout"
            app:layout_constraintStart_toStartOf="@+id/medal4_layout"
            app:layout_constraintTop_toTopOf="@+id/medal1_layout"/>
        <miuix.androidbasewidget.widget.ProgressBar
            android:id="@+id/progress_no"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_marginBottom="34dp"
            android:progress="0"
            android:progressDrawable="@drawable/ability_plan_achievement_progress"
            app:layout_constraintBottom_toBottomOf="@+id/medal1_layout"
            app:layout_constraintEnd_toEndOf="@+id/anchor2"
            app:layout_constraintStart_toStartOf="@+id/anchor1"
            style="?attr/progressBarHorizontalStyle"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/medal1_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="@dimen/dimen_13sp"
                android:textColor="@color/text_color"
                android:id="@+id/medal1_tip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="23dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">
                <View
                    android:layout_gravity="center"
                    android:id="@+id/status1_big"
                    android:background="@drawable/ability_medal_point_outter"
                    android:layout_width="26dp"
                    android:layout_height="26dp"/>
                <View
                    android:layout_gravity="center"
                    android:id="@+id/status1_small"
                    android:background="@drawable/ability_medal_point"
                    android:layout_width="12dp"
                    android:layout_height="12dp"/>
            </FrameLayout>
            <ImageView
                android:id="@+id/medal1_image_small"
                android:layout_width="66dp"
                android:layout_height="66dp"
                android:layout_marginBottom="58dp"
                app:layout_constraintBottom_toTopOf="@+id/medal1_tip"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <ImageView
                android:id="@+id/medal1_image_big"
                android:layout_width="170dp"
                android:layout_height="152dp"
                android:layout_marginBottom="37dp"
                app:layout_constraintBottom_toTopOf="@+id/medal1_tip"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/medal2_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toEndOf="@+id/medal1_layout"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="@dimen/dimen_13sp"
                android:textColor="@color/text_color"
                android:id="@+id/medal2_tip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="23dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">
                <View
                    android:layout_gravity="center"
                    android:id="@+id/status2_big"
                    android:background="@drawable/ability_medal_point_outter"
                    android:layout_width="26dp"
                    android:layout_height="26dp"/>
                <View
                    android:layout_gravity="center"
                    android:id="@+id/status2_small"
                    android:background="@drawable/ability_medal_point"
                    android:layout_width="12dp"
                    android:layout_height="12dp"/>
            </FrameLayout>
            <ImageView
                android:id="@+id/medal2_image_small"
                android:layout_width="66dp"
                android:layout_height="66dp"
                android:layout_marginBottom="58dp"
                app:layout_constraintBottom_toTopOf="@+id/medal2_tip"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <ImageView
                android:id="@+id/medal2_image_big"
                android:layout_width="170dp"
                android:layout_height="152dp"
                android:layout_marginBottom="37dp"
                app:layout_constraintBottom_toTopOf="@+id/medal2_tip"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/medal3_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toEndOf="@+id/medal2_layout"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="@dimen/dimen_13sp"
                android:textColor="@color/text_color"
                android:id="@+id/medal3_tip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="23dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">
                <View
                    android:layout_gravity="center"
                    android:id="@+id/status3_big"
                    android:background="@drawable/ability_medal_point_outter"
                    android:layout_width="26dp"
                    android:layout_height="26dp"/>
                <View
                    android:layout_gravity="center"
                    android:id="@+id/status3_small"
                    android:background="@drawable/ability_medal_point"
                    android:layout_width="12dp"
                    android:layout_height="12dp"/>
            </FrameLayout>
            <ImageView
                android:id="@+id/medal3_image_small"
                android:layout_width="66dp"
                android:layout_height="66dp"
                android:layout_marginBottom="58dp"
                app:layout_constraintBottom_toTopOf="@+id/medal3_tip"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <ImageView
                android:id="@+id/medal3_image_big"
                android:layout_width="170dp"
                android:layout_height="152dp"
                android:layout_marginBottom="37dp"
                app:layout_constraintBottom_toTopOf="@+id/medal3_tip"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/medal4_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toEndOf="@+id/medal3_layout"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="@dimen/dimen_13sp"
                android:textColor="@color/text_color"
                android:id="@+id/medal4_tip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="23dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">
                <View
                    android:layout_gravity="center"
                    android:id="@+id/status4_big"
                    android:background="@drawable/ability_medal_point_outter"
                    android:layout_width="26dp"
                    android:layout_height="26dp"/>
                <View
                    android:layout_gravity="center"
                    android:id="@+id/status4_small"
                    android:background="@drawable/ability_medal_point"
                    android:layout_width="12dp"
                    android:layout_height="12dp"/>
            </FrameLayout>
            <ImageView
                android:id="@+id/medal4_image_small"
                android:layout_width="66dp"
                android:layout_height="66dp"
                android:layout_marginBottom="58dp"
                app:layout_constraintBottom_toTopOf="@+id/medal4_tip"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <ImageView
                android:id="@+id/medal4_image_big"
                android:layout_width="170dp"
                android:layout_height="152dp"
                android:layout_marginBottom="37dp"
                app:layout_constraintBottom_toTopOf="@+id/medal4_tip"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
