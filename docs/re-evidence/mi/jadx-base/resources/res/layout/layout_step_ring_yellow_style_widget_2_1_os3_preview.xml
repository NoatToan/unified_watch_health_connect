<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:background="@drawable/widget_default_corners_transparent_background_20"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:maxWidth="170dp"
    android:maxHeight="65dp">
    <ImageView
        android:id="@+id/backgroundImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_step_2_1_bg_os3"
        android:scaleType="centerCrop"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@android:id/widget_frame"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false">
        <TextView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="12"/>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="96">
            <TextView
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="12.5"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#ff8c00"
                android:gravity="start|center_vertical"
                android:id="@+id/widgetStepTitle"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:text="@string/provider_step_label"
                android:maxLines="1"
                android:layout_weight="16"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="2sp"
                android:autoSizeMaxTextSize="12sp"
                android:textFontWeight="450"/>
            <TextView
                android:textSize="13.87sp"
                android:textColor="@color/text_color"
                android:gravity="start|center_vertical"
                android:id="@+id/widgetStepValue"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:text="@string/widget_start_record"
                android:maxLines="1"
                android:layout_weight="18"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="2sp"
                android:autoSizeMaxTextSize="13.87sp"
                android:textFontWeight="380"/>
            <TextView
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="13.5"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="46">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="8.5"/>
            <ImageView
                android:layout_gravity="bottom"
                android:id="@+id/ivRingImage"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:src="@drawable/widget_step_walking_man_ic"
                android:adjustViewBounds="true"
                android:layout_weight="51.5"
                android:translationY="7.5dp"/>
        </LinearLayout>
        <TextView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="16.48"/>
    </LinearLayout>
</FrameLayout>
