<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_health_ecg_item_detail_0"
    android:background="@color/page_bg"
    android:fitsSystemWindows="true"
    android:scrollbars="none"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:orientation="vertical"
        android:paddingBottom="@dimen/size_20"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="@dimen/page_padding_horizontal_large">
        <com.xiaomi.fitness.view.TitleBarAlphaView
            android:id="@+id/titleAlpha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <RelativeLayout
            android:id="@+id/hrm_layout"
            android:background="@drawable/shape_data_item_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_13_3"
            android:paddingHorizontal="@dimen/size_18"
            android:paddingVertical="@dimen/size_20">
            <TextView
                android:textSize="@dimen/font_22"
                android:textColor="@color/text_color"
                android:id="@+id/tv_avg_hrm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/FontMedium"/>
            <TextView
                android:textColor="@color/text_color_40"
                android:id="@+id/tv_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/tv_avg_hrm"
                style="@style/FontRegular.12sp"/>
            <FrameLayout
                android:id="@+id/ecg_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_16_3"
                android:layout_below="@+id/tv_desc">
                <com.xiaomi.fitness.health.ecg.view.EcgCombineView
                    android:id="@+id/ecg_combine_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:first_flag="true"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="end|top"
                    android:id="@+id/iv_expand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:srcCompat="@drawable/iv_health_ecg_expand"/>
            </FrameLayout>
        </RelativeLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_symptom"
            android:background="@drawable/shape_data_item_bg"
            android:paddingTop="@dimen/size_20"
            android:paddingBottom="@dimen/size_10"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_12"
            android:paddingHorizontal="@dimen/size_18">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_symptom"
                android:focusable="false"
                android:clickable="false"
                android:duplicateParentState="true"
                android:layout_width="@dimen/size_30"
                android:layout_height="@dimen/size_30"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_ecg_symptom"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_jump"
                android:focusable="false"
                android:clickable="false"
                android:duplicateParentState="true"
                android:layout_width="@dimen/size_30"
                android:layout_height="@dimen/size_30"
                android:contentDescription="@string/health_n60_ecg_edit"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_base_right_arrow_icon"/>
            <TextView
                android:id="@+id/tv_symptom_card_edit"
                android:focusable="false"
                android:clickable="false"
                android:duplicateParentState="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/health_n60_ecg_edit"
                app:layout_constraintBottom_toBottomOf="@+id/iv_jump"
                app:layout_constraintEnd_toStartOf="@+id/iv_jump"
                app:layout_constraintTop_toTopOf="@+id/iv_jump"
                style="@style/FontRegular.14sp"/>
            <TextView
                android:textColor="@color/text_color"
                android:id="@+id/tv_symptom_card_title"
                android:focusable="false"
                android:clickable="false"
                android:duplicateParentState="true"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/health_n60_ecg_symptom"
                android:layout_marginStart="@dimen/size_10"
                android:layout_marginEnd="@dimen/size_10"
                app:layout_constraintBottom_toTopOf="@+id/tv_symptom_card_subtitle"
                app:layout_constraintEnd_toStartOf="@+id/tv_symptom_card_edit"
                app:layout_constraintStart_toEndOf="@+id/iv_symptom"
                app:layout_constraintTop_toTopOf="@+id/iv_symptom"
                app:layout_constraintVertical_chainStyle="packed"
                style="@style/FontMedium.14sp"/>
            <TextView
                android:textColor="@color/text_color_40"
                android:id="@+id/tv_symptom_card_subtitle"
                android:focusable="false"
                android:visibility="visible"
                android:clickable="false"
                android:duplicateParentState="true"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/health_n60_ecg_detail_symptom_addition_guide"
                app:layout_constraintBottom_toBottomOf="@+id/iv_symptom"
                app:layout_constraintEnd_toEndOf="@+id/tv_symptom_card_title"
                app:layout_constraintStart_toStartOf="@+id/tv_symptom_card_title"
                app:layout_constraintTop_toBottomOf="@+id/tv_symptom_card_title"
                style="@style/FontRegular.12sp"/>
            <View
                android:id="@+id/divider_line"
                android:background="@color/common_divider_bg_color"
                android:layout_width="0dp"
                android:layout_height="@dimen/size_0_33"
                android:layout_marginTop="@dimen/size_20"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/iv_symptom"/>
            <TextView
                android:textColor="@color/text_color"
                android:ellipsize="end"
                android:id="@+id/tv_symptom_label"
                android:paddingTop="15.7dp"
                android:focusable="false"
                android:clickable="false"
                android:duplicateParentState="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="73dp"
                android:text="@string/health_n60_ecg_symptom"
                app:layout_constraintStart_toStartOf="@+id/divider_line"
                app:layout_constraintTop_toBottomOf="@+id/divider_line"
                style="@style/FontMedium.14sp"/>
            <TextView
                android:textColor="@color/text_color"
                android:ellipsize="end"
                android:id="@+id/tv_scenes_label"
                android:paddingTop="15.7dp"
                android:focusable="false"
                android:clickable="false"
                android:duplicateParentState="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="73dp"
                android:text="@string/health_n60_ecg_detail_symptom_scene"
                app:layout_constraintStart_toStartOf="@+id/divider_line"
                app:layout_constraintTop_toBottomOf="@+id/tv_symptom_value"
                style="@style/FontMedium.14sp"/>
            <TextView
                android:textColor="@color/text_color"
                android:ellipsize="end"
                android:id="@+id/tv_frequency_label"
                android:paddingTop="15.7dp"
                android:focusable="false"
                android:clickable="false"
                android:duplicateParentState="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="73dp"
                android:text="@string/health_n60_ecg_detail_symptom_occurrence"
                app:layout_constraintStart_toStartOf="@+id/divider_line"
                app:layout_constraintTop_toBottomOf="@+id/tv_scenes_value"
                style="@style/FontMedium.14sp"/>
            <TextView
                android:textColor="@color/text_color_80"
                android:id="@+id/tv_symptom_value"
                android:paddingTop="15.7dp"
                android:paddingBottom="15.7dp"
                android:focusable="false"
                android:clickable="false"
                android:duplicateParentState="true"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.2"
                android:layout_marginStart="@dimen/size_20"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/label_barrier"
                app:layout_constraintTop_toTopOf="@+id/tv_symptom_label"
                style="@style/FontRegular.14sp"/>
            <TextView
                android:textColor="@color/text_color_80"
                android:id="@+id/tv_scenes_value"
                android:paddingTop="15.7dp"
                android:paddingBottom="15.7dp"
                android:focusable="false"
                android:clickable="false"
                android:duplicateParentState="true"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.2"
                android:layout_marginStart="@dimen/size_20"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/label_barrier"
                app:layout_constraintTop_toTopOf="@+id/tv_scenes_label"
                style="@style/FontRegular.14sp"/>
            <TextView
                android:textColor="@color/text_color_80"
                android:id="@+id/tv__frequency_value"
                android:paddingTop="15.7dp"
                android:paddingBottom="15.7dp"
                android:focusable="false"
                android:clickable="false"
                android:duplicateParentState="true"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.2"
                android:layout_marginStart="@dimen/size_20"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/label_barrier"
                app:layout_constraintTop_toTopOf="@+id/tv_frequency_label"
                style="@style/FontRegular.14sp"/>
            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/label_barrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="70dp"
                app:barrierDirection="end"
                app:constraint_referenced_ids="tv_scenes_label,tv_symptom_label,tv_frequency_label"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_analyze"
            android:background="@drawable/shape_data_item_bg"
            android:paddingTop="@dimen/size_20"
            android:paddingBottom="@dimen/size_20"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_12"
            android:paddingHorizontal="@dimen/size_18">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/text_view"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toStartOf="@+id/tv_analyze_action"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textColor="@color/text_color"
                    android:id="@+id/tv_expert_service"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/health_n60_ecg_expert_analyze_service"
                    android:layout_marginEnd="@dimen/size_10"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/FontMedium.16sp"/>
                <TextView
                    android:textColor="@color/text_color"
                    android:id="@+id/tv_analyze_time_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_4"
                    android:text="@string/health_n60_ecg_expert_analyze_result_time_label"
                    app:layout_constraintEnd_toEndOf="@+id/tv_expert_service"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_expert_service"
                    style="@style/FontRegular.12sp"/>
                <TextView
                    android:textColor="@color/text_color"
                    android:id="@+id/tv_analyze_time_detail"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_4"
                    android:text="@string/health_n60_ecg_expert_analyze_result_time_detail"
                    app:layout_constraintEnd_toEndOf="@+id/tv_expert_service"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_analyze_time_label"
                    style="@style/FontRegular.12sp"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:textSize="@dimen/font_12"
                android:textColor="@color/selector_common_btn_primary_text_color"
                android:id="@+id/tv_analyze_action"
                android:background="@drawable/selector_bottom_button_red"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="11.7dp"
                android:text="@string/health_n60_ecg_expert_analyze_watch_report"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/FontMedium.12sp"/>
            <View
                android:id="@+id/divider_analyze_line"
                android:background="@color/common_divider_bg_color"
                android:layout_width="0dp"
                android:layout_height="@dimen/size_0_33"
                android:layout_marginTop="@dimen/size_20"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/text_view"/>
            <TextView
                android:textColor="@color/text_color_40"
                android:id="@+id/tv_service_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_20"
                android:text="@string/health_n60_ecg_expert_analyze_service_description"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/divider_analyze_line"
                style="@style/FontRegular.12sp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.xiaomi.fitness.view.HealthBannerCardSetView
            android:id="@+id/health_banner_card_set"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
