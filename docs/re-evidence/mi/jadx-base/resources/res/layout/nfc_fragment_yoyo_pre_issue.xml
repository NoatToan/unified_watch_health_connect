<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/nfc_fragment_yoyo_pre_issue_0"
    android:paddingBottom="@dimen/page_content_padding_horizontal_large"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/page_content_padding_horizontal_large"
    android:paddingEnd="@dimen/page_content_padding_horizontal_large">
    <ImageView
        android:id="@+id/cardFaceView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:scaleType="fitXY"/>
    <View
        android:id="@+id/lineView1"
        android:background="@color/nfc_line"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginTop="20dp"
        android:layout_below="@+id/cardFaceView"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/protoContainnerView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size_10"
        android:layout_above="@+id/nextView"
        android:layout_centerHorizontal="true">
        <CheckBox
            android:textSize="@dimen/nfc_tsm_text_size_content_small"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/agreeView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false"
            android:button="@drawable/selector_check"/>
        <TextView
            android:textSize="@dimen/nfc_tsm_text_size_content_small"
            android:textStyle="bold"
            android:textColor="@color/text_color"
            android:gravity="center_vertical"
            android:autoLink="web"
            android:layout_gravity="center_vertical"
            android:id="@+id/protocolsView"
            android:layout_width="wrap_content"
            android:layout_height="60dp"
            android:layout_marginStart="3.3dp"/>
    </LinearLayout>
    <TextView
        android:enabled="false"
        android:id="@+id/nextView"
        android:text="@string/nfc_youyou_card_issue_btn"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp"
        style="@style/CommonBtn.Primary"/>
</RelativeLayout>
