<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_sport_detail_gps_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.xiaomi.fitness.share.view.ShareLogoContainer
        android:id="@+id/shareLogo"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.xiaomi.fitness.detail.view.SportShareBottomView
        android:id="@+id/shareBottomView"
        android:paddingBottom="@dimen/dimen_margin_40dp"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.xiaomi.fitness.detail.view.FixMapDragLayout
        android:id="@+id/fixMapDragLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.mi.health.data.sportmodel.view.SportPathMapView
            android:id="@+id/sportPathView"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/noPathView"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/sport_record_no_gps_data_bg"
                android:background="@drawable/sport_record_no_gps_data_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scaleType="center"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/sport_no_gps_location_icon"
                android:background="@drawable/sport_no_gps_location_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="120dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dimen_16sp"
                android:textColor="@color/text_color"
                android:gravity="center"
                android:id="@+id/trail_record_gps_no_data_remind_content"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/trail_record_gps_no_data_remind_content"
                android:layout_marginHorizontal="@dimen/page_content_padding_horizontal_large"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/sport_no_gps_location_icon"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dimen_12sp"
                android:textColor="#329dff"
                android:id="@+id/trail_record_gps_no_data_remind_des"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/trail_record_gps_no_data_remind_des"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/trail_record_gps_no_data_remind_content"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:layout_gravity="bottom"
            android:id="@+id/bottomView"
            android:background="@drawable/trail_shape_gradient"
            android:layout_width="match_parent"
            android:layout_height="300dp"/>
    </com.xiaomi.fitness.detail.view.FixMapDragLayout>
    <View
        android:id="@+id/videoMarginView"
        android:layout_width="match_parent"
        android:layout_height="400dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/trace_video_btn"
        android:background="@drawable/selector_white_round_32dp"
        android:paddingTop="@dimen/dimen_margin_10dp"
        android:paddingBottom="@dimen/dimen_margin_10dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_margin_20dp"
        android:layout_marginEnd="@dimen/dimen_margin_20dp"
        app:layout_constraintBottom_toBottomOf="@+id/videoMarginView"
        app:layout_constraintEnd_toEndOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ic_sport_trace_play"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_4dp"
            android:src="@drawable/ic_sport_trace_play"
            android:contentDescription="@string/trail_sport_report_trace_video_button_des"
            android:layout_marginStart="@dimen/dimen_margin_16dp"/>
        <TextView
            android:textSize="@dimen/dimen_15sp"
            android:textColor="@color/text_color"
            android:ellipsize="end"
            android:id="@+id/trail_sport_report_trace_video_button_des"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="113dp"
            android:text="@string/trail_sport_report_trace_video_button_des"
            android:lines="1"
            android:contentDescription="@string/trail_sport_report_trace_video_button_des"
            android:layout_marginStart="@dimen/dimen_margin_7dp"
            android:layout_marginEnd="@dimen/dimen_margin_16dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/diving_desc"
        android:background="@drawable/selector_black_round_32dp"
        android:paddingTop="@dimen/dimen_margin_10dp"
        android:paddingBottom="@dimen/dimen_margin_10dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_margin_20dp"
        android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
        app:layout_constraintBottom_toBottomOf="@+id/videoMarginView"
        app:layout_constraintStart_toStartOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:id="@+id/diving_desc_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_sport_diving_point"
            android:contentDescription="@string/trail_sport_report_trace_video_button_des"
            android:layout_marginStart="10dp"/>
        <TextView
            android:textSize="@dimen/dimen_13sp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:id="@+id/diving_desc_image_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="113dp"
            android:text="@string/trail_sport_report_trace_video_button_des"
            android:lines="1"
            android:contentDescription="@string/trail_sport_report_trace_video_button_des"
            android:layout_marginStart="@dimen/dimen_margin_7dp"
            android:layout_marginEnd="@dimen/dimen_margin_16dp"/>
    </LinearLayout>
    <com.xiaomi.fitness.detail.view.MapScrollView
        android:orientation="vertical"
        android:id="@+id/mapScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:id="@+id/outContainter"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <View
                android:id="@+id/marginView"
                android:layout_width="match_parent"
                android:layout_height="450dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/recordDetailContent"
                android:background="@color/page_bg"
                android:paddingBottom="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/page_padding_horizontal_large"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/marginView">
                <com.xiaomi.fitness.detail.view.SportRecordBasicInfoView
                    android:id="@+id/sportRecordBasic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <FrameLayout
                    android:id="@+id/container_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.xiaomi.fitness.detail.view.MapScrollView>
    <TextView
        android:textColor="@color/common_transparent"
        android:gravity="center"
        android:id="@+id/sportTitle"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/FontMedium.16sp"/>
    <ImageView
        android:id="@+id/imgBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/img_sport_back"
        android:scaleType="center"
        android:contentDescription="@string/back"
        android:layout_marginStart="25dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/imgDelete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/img_sport_delete"
        android:contentDescription="@string/trail_sport_record_more_settings"
        android:layout_marginEnd="25dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/imgShare"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/img_sport_share"
        android:contentDescription="@string/trail_share"
        android:layout_marginEnd="@dimen/dimen_margin_13dp"
        app:layout_constraintEnd_toStartOf="@+id/imgDelete"
        app:layout_constraintTop_toTopOf="@+id/imgDelete"/>
    <ImageView
        android:id="@+id/imgMapLocation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:src="@drawable/location"
        android:scaleType="center"
        android:contentDescription="@string/trail_sport_map_location_reset"
        app:layout_constraintEnd_toEndOf="@+id/imgDelete"
        app:layout_constraintTop_toBottomOf="@+id/imgDelete"/>
    <ImageView
        android:id="@+id/imgMapDialog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:src="@drawable/map_gps"
        android:scaleType="center"
        android:contentDescription="@string/trail_sport_map_style_edit"
        app:layout_constraintEnd_toEndOf="@+id/imgDelete"
        app:layout_constraintTop_toBottomOf="@+id/imgMapLocation"/>
    <com.xiaomi.fitness.detail.view.SportShareLongView
        android:id="@+id/sport_share_long_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
