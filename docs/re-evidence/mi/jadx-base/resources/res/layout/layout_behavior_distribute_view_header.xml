<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="@dimen/dimen_margin_20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">
        <com.xiaomi.fitness.baseui.widget.DistributeView
            android:id="@+id/behaviorDistributeView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"/>
        <com.xiaomi.fitness.baseui.widget.CircularCoverView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            app:cover_color="@color/card_bg_normal"
            app:left_bottom_radius="@dimen/dimen_margin_10dp"
            app:left_top_radius="@dimen/dimen_margin_10dp"
            app:right_bottom_radius="@dimen/dimen_margin_10dp"
            app:right_top_radius="@dimen/dimen_margin_10dp"/>
    </RelativeLayout>
</RelativeLayout>
