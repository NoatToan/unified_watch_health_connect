<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/disconnect"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="26dp">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/icon"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_marginTop="@dimen/dimen_margin_30dp"/>
            <View
                android:layout_gravity="center_horizontal"
                android:id="@+id/divider"
                android:background="@color/black_10"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginTop="@dimen/margin_27dp"
                android:layout_marginHorizontal="@dimen/margin_27dp"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/text_color"
                android:id="@+id/data_access"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/access_health_connect_data_and_access"
                android:fontFamily="@font/misanslatin_medium"
                app:layout_constraintStart_toStartOf="parent"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/text_color_40"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_20dp"
                android:text="@string/access_health_connect_allow_write"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/authed_write_permissions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </ScrollView>
    <TextView
        android:textSize="@dimen/dimen_16sp"
        android:textColor="@color/text_color"
        android:gravity="center"
        android:id="@+id/disconnect"
        android:background="@drawable/health_disconnect_btn_bg"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="@dimen/margin_27dp"
        android:text="@string/access_health_connect_disconnect"
        android:fontFamily="@font/misanslatin_medium"
        android:layout_marginHorizontal="@dimen/margin_27dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
