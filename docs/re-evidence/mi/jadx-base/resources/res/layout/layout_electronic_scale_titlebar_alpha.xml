<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rl_container"
    android:layout_width="match_parent"
    android:layout_height="63.3dp">
    <ImageView
        android:id="@+id/img_back_white"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_10"
        android:src="@drawable/ic_left_back_black"
        android:scaleType="center"
        android:contentDescription="image back button!"
        android:layout_marginStart="@dimen/dimen_margin_18dp"
        android:layout_alignParentStart="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <TextView
            android:textColor="@color/text_color"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/txt_title_alpha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/FontMedium.19sp"/>
        <TextView
            android:textColor="@color/text_color"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/txt_desc_alpha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableRight="@drawable/electronic_scale_ic_health_arrow_down"
            android:drawablePadding="3.6dp"
            style="@style/FontRegular.14sp"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/img_share_alpha"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/electronic_scale_ic_health_more"
        android:scaleType="center"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/dimen_margin_10dp"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
