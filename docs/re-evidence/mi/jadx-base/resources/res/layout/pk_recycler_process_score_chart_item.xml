<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/pk_card_white_bg_radius_48"
    android:paddingBottom="3.3dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/size_12">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <com.xiaomi.fitness.widget.view.RoundImageView
        android:id="@+id/iv_opp_avatar"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="@dimen/size_20"
        android:src="@drawable/ic_pk_avatar_default"
        android:layout_marginStart="@dimen/size_18"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.xiaomi.fitness.widget.view.RoundImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/iv_own_avatar"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="@dimen/size_20"
        android:src="@drawable/ic_pk_avatar_default"
        android:layout_marginEnd="@dimen/size_18"
        android:layout_alignParentEnd="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_opp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_7"
        android:layout_marginEnd="@dimen/size_10"
        app:layout_constraintBottom_toBottomOf="@+id/iv_opp_avatar"
        app:layout_constraintEnd_toEndOf="@+id/guideline"
        app:layout_constraintStart_toEndOf="@+id/iv_opp_avatar"
        app:layout_constraintTop_toTopOf="@+id/iv_opp_avatar">
        <TextView
            android:textColor="@color/text_color_40"
            android:ellipsize="end"
            android:id="@+id/tv_opp_nick_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            style="@style/FontRegular.10sp"/>
        <TextView
            android:textColor="@color/text_color_80"
            android:id="@+id/tv_opp_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/FontRegular.10sp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_own"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_10"
        android:layout_marginEnd="@dimen/size_7"
        app:layout_constraintBottom_toBottomOf="@+id/iv_own_avatar"
        app:layout_constraintEnd_toStartOf="@+id/iv_own_avatar"
        app:layout_constraintStart_toStartOf="@+id/guideline"
        app:layout_constraintTop_toTopOf="@+id/iv_own_avatar">
        <TextView
            android:textColor="@color/text_color_40"
            android:ellipsize="end"
            android:gravity="end"
            android:id="@+id/tv_own_nick_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            style="@style/FontRegular.10sp"/>
        <TextView
            android:textColor="@color/text_color_80"
            android:gravity="end"
            android:id="@+id/tv_own_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/FontRegular.10sp"/>
    </LinearLayout>
    <com.xiaomi.fitness.active.pk.widget.PkScoreView
        android:id="@+id/pk_score_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_own"/>
    <com.xiaomi.fitness.active.pk.widget.PkBarChart
        android:id="@+id/pk_bar_chart"
        android:paddingTop="23.3dp"
        android:paddingBottom="38dp"
        android:layout_width="match_parent"
        android:layout_height="142dp"
        android:paddingStart="18dp"
        android:paddingEnd="32dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pk_score_view"
        app:pkEmptyStr="@string/pk_chart_tomorrow_start"/>
    <TextView
        android:textSize="11sp"
        android:textColor="@color/text_color_30"
        android:id="@+id/tv_settle_time"
        android:paddingBottom="@dimen/size_16_7"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pk_bar_chart"
        style="@style/FontLatinSemiBold"/>
</androidx.constraintlayout.widget.ConstraintLayout>
