<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/tv_data_first"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tv_unit_first"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:gravity="bottom|center_horizontal"
        android:id="@+id/tv_unit_first"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginStart="0.67dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tv_data_second"
        app:layout_constraintStart_toEndOf="@+id/tv_data_first"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/tv_data_second"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:layout_marginStart="0.67dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tv_unit_second"
        app:layout_constraintStart_toEndOf="@+id/tv_unit_first"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:gravity="bottom|center_horizontal"
        android:id="@+id/tv_unit_second"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginStart="0.67dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_data_second"
        app:layout_constraintTop_toTopOf="parent"/>
</merge>
