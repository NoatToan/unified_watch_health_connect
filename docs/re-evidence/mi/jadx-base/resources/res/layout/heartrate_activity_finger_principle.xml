<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/scroll_view"
    android:background="@color/black"
    android:scrollbars="none"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/img_icon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_4_7"
            android:src="@drawable/heartrate_img_fp_principle_bg"
            android:importantForAccessibility="no"/>
        <TextView
            android:id="@+id/tv_desc_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_40dp"
            android:text="@string/heartrate_fp_detect_principle_desc"
            style="@style/HeartRatePrinciple"/>
        <TextView
            android:id="@+id/tv_desc_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/heartrate_fp_detect_principle_desc_3"
            style="@style/HeartRatePrinciple"/>
        <TextView
            android:id="@+id/tv_desc_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/heartrate_fp_detect_principle_desc_2"
            style="@style/HeartRatePrinciple"/>
        <Space
            android:layout_width="1px"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <com.google.android.flexbox.FlexboxLayout
            android:id="@+id/fbl_reference_layout"
            android:paddingTop="@dimen/dimen_margin_23dp"
            android:paddingBottom="@dimen/dimen_margin_23dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_margin_26dp"
            android:layout_marginEnd="@dimen/dimen_margin_26dp"
            app:flexWrap="wrap"
            app:justifyContent="center">
            <TextView
                android:textColor="@color/white_40"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/size_1_3"
                android:layout_marginEnd="@dimen/size_1_3"
                style="@style/HeartRatePageProvider"/>
            <TextView
                android:id="@+id/heartrate_tv_reference"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/size_1_3"
                android:layout_marginEnd="@dimen/size_1_3"
                style="@style/HeartRateReference"/>
        </com.google.android.flexbox.FlexboxLayout>
    </LinearLayout>
</ScrollView>
