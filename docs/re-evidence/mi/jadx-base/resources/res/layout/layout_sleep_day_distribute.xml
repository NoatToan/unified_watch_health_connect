<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:flexbox="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/layout_sleep_day_distribute"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_20dp"
        android:layout_marginStart="@dimen/dimen_margin_18dp">
        <ImageView
            android:layout_gravity="center_vertical"
            android:background="@drawable/sleep_detail_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textColor="@color/text_color"
            android:gravity="start"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/health_sleep_long_sleep"
            android:layout_marginStart="@dimen/size_6"
            style="@style/FontMedium.18sp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include
            android:id="@+id/detail_title"
            layout="@layout/layout_sleep_chart_detail_title"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-100dp">
            <com.xiaomi.fitness.chart.view.SleepChartRecyclerView
                android:id="@+id/chart_recycler"
                android:paddingTop="100dp"
                android:layout_width="match_parent"
                android:layout_height="337dp"
                android:paddingStart="@dimen/size_18"
                android:paddingEnd="@dimen/size_18"
                flexbox:contentPaddingBottom="@dimen/size_53"
                flexbox:sleepItemHeight="@dimen/health_sleep_chart_item_height"
                style="@style/ChartBaseStyle"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="end|top"
                android:id="@+id/iv_expand"
                android:padding="@dimen/size_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="100dp"
                android:paddingStart="@dimen/size_18"
                android:paddingEnd="@dimen/size_18"
                flexbox:srcCompat="@drawable/iv_health_chart_expand"/>
        </FrameLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/shop_guide"
        android:background="@drawable/health_sleep_shop_guide_view_bg_shape"
        android:padding="9dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="31dp"
        android:layout_marginStart="@dimen/dimen_margin_18dp"
        android:layout_marginEnd="@dimen/dimen_margin_18dp">
        <ImageView
            android:layout_gravity="start|center_vertical"
            android:id="@+id/health_sleep_shop_guide_watch_ic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/health_sleep_shop_guide_watch_ic"/>
        <com.google.android.flexbox.FlexboxLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            flexbox:alignContent="center"
            flexbox:alignItems="center"
            flexbox:flexWrap="nowrap"
            flexbox:justifyContent="flex_end">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                flexbox:layout_alignSelf="center"
                flexbox:layout_flexGrow="1">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/health_sleep_shop_guide_text_color"
                    android:id="@+id/tv_guide_main_message"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/health_sleep_shop_guide_main_text"
                    android:maxLines="1"
                    android:lineSpacingExtra="0dp"
                    android:lineSpacingMultiplier="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeStepGranularity="0.5sp"
                    android:autoSizeMinTextSize="10sp"
                    android:autoSizeMaxTextSize="14sp"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/health_sleep_shop_guide_text_color"
                    android:id="@+id/tv_guide_sub_message"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/health_sleep_shop_guide_sub_text"
                    android:maxLines="1"
                    android:alpha="0.78"
                    android:autoSizeTextType="uniform"
                    android:autoSizeStepGranularity="0.5sp"
                    android:autoSizeMinTextSize="8sp"
                    android:autoSizeMaxTextSize="12sp"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="end|center_vertical"
                android:orientation="horizontal"
                android:id="@+id/btn_shop_now"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                flexbox:layout_flexBasisPercent="25%"
                flexbox:layout_flexGrow="0"
                flexbox:layout_minWidth="69dp">
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/health_sleep_floating_text_color"
                    android:gravity="end|center_vertical"
                    android:layout_gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/health_sleep_shop_guide_view_now"
                    android:maxLines="1"
                    android:layout_weight="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeStepGranularity="0.5sp"
                    android:autoSizeMinTextSize="8sp"
                    android:autoSizeMaxTextSize="12sp"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/iv_arrow"
                    android:background="@drawable/health_sleep_shop_guide_arrow_ic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-4dp"/>
            </LinearLayout>
        </com.google.android.flexbox.FlexboxLayout>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_distribute"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"/>
</LinearLayout>
