<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/eco_item_other_device_v4_0"
    android:background="@drawable/eco_device_shape_item_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/dimen_margin_12dp">
    <ImageView
        android:id="@+id/iv_icon"
        android:tag="binding_1"
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:scaleType="fitXY"
        android:layout_marginStart="16dp"
        android:layout_marginVertical="@dimen/dimen_margin_16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="17sp"
        android:textColor="@color/text_color"
        android:id="@+id/tv_name"
        android:tag="binding_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_margin_4dp"
        android:layout_marginStart="@dimen/dimen_margin_10dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_electric_quantity"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_icon"
        app:layout_constraintTop_toTopOf="@+id/iv_icon"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/FontDemiBold"/>
    <TextView
        android:textSize="14sp"
        android:id="@+id/tv_electric_quantity"
        android:tag="binding_3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_4dp"
        android:layout_marginBottom="@dimen/dimen_margin_6dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_synchronize"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/tv_name"
        app:layout_constraintTop_toBottomOf="@+id/tv_name"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_goneMarginBottom="0dp"/>
    <TextView
        android:textColor="#0088ff"
        android:id="@+id/tv_share"
        android:tag="binding_4"
        android:background="@drawable/eco_device_share_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_6dp"
        android:text="@string/eco_device_tab_share"
        android:paddingHorizontal="@dimen/dimen_margin_4dp"
        android:paddingVertical="@dimen/dimen_margin_2dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_icon"
        app:layout_constraintStart_toStartOf="@+id/tv_name"
        app:layout_constraintTop_toBottomOf="@+id/tv_electric_quantity"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textColor="@color/colorPrimary"
        android:gravity="center"
        android:id="@+id/tv_synchronize"
        android:tag="binding_5"
        android:background="@drawable/shape_btn_bg_ff612e"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dimen_margin_40dp"
        android:layout_marginTop="@dimen/dimen_margin_6dp"
        android:paddingHorizontal="19dp"
        android:paddingVertical="@dimen/dimen_margin_9dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_icon"
        app:layout_constraintStart_toStartOf="@+id/tv_name"
        app:layout_constraintTop_toBottomOf="@+id/tv_electric_quantity"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/FontMedium.17sp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
