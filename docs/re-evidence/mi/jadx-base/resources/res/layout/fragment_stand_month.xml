<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_stand_month_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.xiaomi.fitness.chart.view.BarChartRecyclerView
        android:id="@+id/recycler"
        app:barChartRoundRectRadiusRatio="0.5"
        app:chartColor="@color/health_stand_chart"
        app:chartEdgeColor="@color/black_2"
        app:displayNumbers="31"
        app:enableCharValueDisplay="false"
        app:enableStartYAxisLabel="false"
        app:xAxisLabelPosition="1"
        app:xAxisScaleDistance="7"
        app:xFirstLinePosition="2"
        style="@style/ChartBaseStyle"/>
    <com.xiaomi.fitness.view.DataTitleView
        android:id="@+id/dataTitleView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</FrameLayout>
