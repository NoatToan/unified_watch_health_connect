<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/blood_pressure_container"
    android:tag="layout/fragment_blood_glucose_all_day_item_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include
        android:id="@+id/blood_glucose_guide"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_20dp"
        android:layout_marginBottom="12dp"
        android:layout_marginHorizontal="12dp"
        layout="@layout/sleep_permission_setting_instruction"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.xiaomi.fitness.chart.view.BloodSugarLineChartRecyclerView
            android:id="@+id/line_chart_recycler"
            app:displayNumbers="1"
            app:enableEndDayXAxis="true"
            app:enableLineFill="false"
            app:enableStartYAxisLabel="false"
            app:enableXAxisLineCircle="false"
            app:lineHighLightType="4"
            app:linePointRadius="@dimen/size_2"
            app:linePointSelectCircleStroke="true"
            app:linePointSelectRadius="@dimen/size_2"
            app:linePointSelectStrokeWidth="@dimen/size_2"
            app:lineSelectCircles="1"
            app:lineShaderBeginColor="@color/health_blood_glucose_chart_fill"
            app:lineShaderEndColor="@color/health_blood_glucose_chart_fill"
            app:lineStrokeWidth="3"
            app:xAxisLabelPosition="0"
            style="@style/ChartBaseStyle"/>
        <com.xiaomi.fitness.view.DataTitleView
            android:id="@+id/dataTitleView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <include
        android:visibility="gone"
        layout="@layout/layout_blood_glucose_bottom_guide"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_distribute"
        android:background="@drawable/shape_data_item_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/health_detail_page_common_margin_vertical"
        android:layout_marginBottom="@dimen/health_detail_page_common_margin_vertical"
        android:overScrollMode="never"
        android:layout_marginHorizontal="@dimen/health_detail_page_common_margin_horizontal"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_blood_glucose_detail"
        android:background="@drawable/shape_data_item_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size_12"
        android:overScrollMode="never"
        android:layout_marginHorizontal="@dimen/health_detail_page_common_margin_horizontal"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/blood_glucose_detail_recycler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.xiaomi.fitness.view.HealthBannerCardSetView
        android:id="@+id/health_banner_card_set"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/health_detail_page_common_margin_vertical"/>
    <com.xiaomi.fitness.view.CardUnderstandView
        android:id="@+id/understandCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/health_detail_page_common_margin_horizontal"
        app:txtUnderstand="@string/health_blood_glucose_understand"/>
</LinearLayout>
