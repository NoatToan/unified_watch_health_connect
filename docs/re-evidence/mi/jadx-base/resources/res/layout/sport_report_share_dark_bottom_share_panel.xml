<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@drawable/sport_report_share_bottom_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/share_panel"
        android:paddingTop="@dimen/dimen_margin_26dp"
        android:paddingBottom="@dimen/dimen_margin_26dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:weightSum="4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="11sp"
            android:textColor="@color/white_60"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/rl_download"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minWidth="48.7dp"
            android:text="@string/share_download"
            android:drawableTop="@drawable/share_download"
            android:drawablePadding="5dp"
            android:layout_weight="1"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="11sp"
            android:textColor="@color/white_60"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/rl_share_wx_session"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minWidth="48.7dp"
            android:text="@string/share_wx_session"
            android:drawableTop="@drawable/share_wx_session"
            android:drawablePadding="5dp"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/dimen_margin_40dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="11sp"
            android:textColor="@color/white_60"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/rl_share_timeline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minWidth="48.7dp"
            android:text="@string/share_wx_timeline"
            android:drawableTop="@drawable/share_wx_timeline"
            android:drawablePadding="5dp"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/dimen_margin_40dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="11sp"
            android:textColor="@color/white_60"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/rl_more"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minWidth="48.7dp"
            android:text="@string/more"
            android:drawableTop="@drawable/ic_share_more"
            android:drawablePadding="5dp"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/dimen_margin_40dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
