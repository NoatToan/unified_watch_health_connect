<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/device_settings_widget_select_dialog_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/select_widget_view"
        android:tag="binding_1"
        android:background="@drawable/device_settings_widget_select_dialog_radius"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include
            android:id="@+id/widget_select_title_bar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/select_widget_view"
            layout="@layout/device_settings_widget_select_title"/>
        <TextView
            android:theme="@style/FontMedium.22sp"
            android:textColor="@color/textColorPrimary"
            android:id="@+id/tv_widget_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/misanslatin_bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/widget_select_title_bar"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="97dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_widget_name">
            <androidx.viewpager.widget.ViewPager
                android:id="@+id/vp_select_widget"
                android:layout_width="match_parent"
                android:layout_height="350dp"/>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="horizontal"
                android:id="@+id/ll_dot"
                android:layout_width="match_parent"
                android:layout_height="22dp"/>
        </LinearLayout>
        <Button
            android:id="@+id/btn_widget_confirm"
            android:text="@string/device_settings_widget_dialog_add"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/CommonBtn.Primary"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
