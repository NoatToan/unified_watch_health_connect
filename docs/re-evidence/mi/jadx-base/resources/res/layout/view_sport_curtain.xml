<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/greenRipple"
        android:layout_width="120dp"
        android:layout_height="160dp"
        android:layout_marginTop="50dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:lottie_autoPlay="true"
        app:lottie_fileName="green_ripple.zip"/>
    <TextView
        android:id="@+id/welcome2"
        android:background="@drawable/ic_sport_welcome2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/greenRipple"/>
    <TextView
        android:id="@+id/welcome1"
        android:background="@drawable/ic_sport_welcome1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/welcome2"/>
    <com.airbnb.lottie.LottieAnimationView
        android:layout_width="50dp"
        android:layout_height="50dp"
        app:layout_constraintBottom_toBottomOf="@+id/welcome1"
        app:layout_constraintEnd_toStartOf="@+id/welcome1"
        app:layout_constraintTop_toTopOf="@+id/welcome2"
        app:lottie_autoPlay="true"
        app:lottie_fileName="green_star.zip"
        app:lottie_loop="true"/>
    <com.airbnb.lottie.LottieAnimationView
        android:layout_width="50dp"
        android:layout_height="50dp"
        app:layout_constraintStart_toEndOf="@+id/welcome1"
        app:layout_constraintTop_toTopOf="@+id/welcome1"
        app:lottie_autoPlay="true"
        app:lottie_fileName="blue_star.zip"
        app:lottie_loop="true"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/white"
        android:id="@+id/know_btn"
        android:background="@drawable/shape_sport_tab_known"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="@string/common_known"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        app:layout_constraintBottom_toTopOf="@+id/blueRipple"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/blueRipple"
        android:layout_width="120dp"
        android:layout_height="240dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:lottie_autoPlay="true"
        app:lottie_fileName="blue_ripple.zip"/>
</androidx.constraintlayout.widget.ConstraintLayout>
