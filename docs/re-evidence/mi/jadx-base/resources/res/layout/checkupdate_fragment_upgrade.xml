<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/checkupdate_fragment_upgrade_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <miuix.springback.view.SpringBackLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:scrollableView="@+id/nested_scorll_view">
        <androidx.core.widget.NestedScrollView
            android:id="@+id/nested_scorll_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/status_icon"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_marginTop="40dp"
                    android:src="@drawable/ic_new_version"/>
                <TextView
                    android:textColor="@color/text_color"
                    android:ellipsize="end"
                    android:id="@+id/status_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:text="@string/update_discover_new_version"
                    android:maxLines="1"
                    style="@style/FontMedium.20sp"/>
                <TextView
                    android:textSize="@dimen/dimen_14sp"
                    android:textColor="@color/text_color"
                    android:ellipsize="end"
                    android:id="@+id/version_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:maxLines="1"/>
                <View
                    android:layout_marginTop="25dp"
                    android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
                    android:layout_marginEnd="@dimen/page_content_padding_horizontal_large"
                    style="@style/SettingsLineStyle"/>
                <TextView
                    android:textSize="@dimen/dimen_14sp"
                    android:textColor="@color/text_color"
                    android:layout_gravity="start"
                    android:id="@+id/change_log_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="35dp"
                    android:text="@string/firmware_update_log"
                    android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
                    android:layout_marginEnd="@dimen/page_content_padding_horizontal_large"
                    style="@style/FontMedium"/>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="vertical"
                    android:id="@+id/change_log_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/dimen_14sp"
                        android:textColor="@color/text_color_60"
                        android:id="@+id/change_log"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
                        android:layout_marginEnd="@dimen/page_content_padding_horizontal_large"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.core.widget.NestedScrollView>
    </miuix.springback.view.SpringBackLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:id="@+id/bottomView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@+id/update_progress_dialog_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/progress_height"
            app:layout_constraintBottom_toBottomOf="parent">
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/page_content_padding_horizontal_large">
                <ProgressBar
                    android:layout_gravity="center_vertical"
                    android:id="@+id/xq_progress_dialog_indeterminate"
                    style="@style/ProgressDialogIndeterminateProgressbar"/>
                <com.xiaomi.fitness.baseui.dialog.CustomCircleProgressBar
                    android:layout_gravity="center_vertical"
                    android:id="@+id/xq_progress_dialog_determinate"
                    android:background="@drawable/dialog_loading"
                    android:visibility="gone"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    app:inside_indent="0"
                    app:paint_color="@color/white"
                    app:paint_width="3"/>
            </FrameLayout>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/text_color"
                android:layout_gravity="center_vertical"
                android:id="@+id/xq_progress_dialog_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/common_installing"
                android:layout_marginStart="15dp"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/dimen_12sp"
            android:textColor="@color/text_color_60"
            android:gravity="center"
            android:id="@+id/tv_update_tips"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dimen_margin_20dp"
            android:text="@string/firmware_update_tips_on_updating"
            android:layout_marginStart="@dimen/dimen_margin_26dp"
            android:layout_marginEnd="@dimen/dimen_margin_26dp"
            app:layout_constraintBottom_toTopOf="@+id/upgrade_pb"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:id="@+id/upgrade_btn"
            android:text="@string/firmware_download_upgrade_packet"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/CommonBtn.Primary"/>
        <ProgressBar
            android:id="@+id/upgrade_pb"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/common_btn_height"
            android:layout_marginBottom="@dimen/common_btn_margin"
            android:progressDrawable="@drawable/download_progress_horizontal"
            android:minHeight="10dp"
            android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
            android:layout_marginEnd="@dimen/page_content_padding_horizontal_large"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/Base.Widget.AppCompat.ProgressBar.Horizontal"/>
        <TextView
            android:textColor="@color/white"
            android:id="@+id/progress_info"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
            android:layout_marginEnd="@dimen/page_content_padding_horizontal_large"
            app:layout_constraintBottom_toBottomOf="@+id/upgrade_pb"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/upgrade_pb"
            style="@style/FontMedium.16sp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
