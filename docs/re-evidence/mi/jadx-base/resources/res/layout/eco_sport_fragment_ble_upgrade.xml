<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:tag="layout/eco_sport_fragment_ble_upgrade_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/status_icon"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginTop="40dp"
            android:src="@drawable/sport_ic_new_version"/>
        <TextView
            android:textSize="@dimen/dimen_15sp"
            android:textColor="@color/text_color"
            android:ellipsize="end"
            android:layout_gravity="center_horizontal"
            android:id="@+id/version_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:maxLines="1"/>
        <TextView
            android:textSize="@dimen/dimen_12sp"
            android:textColor="@color/text_color"
            android:ellipsize="end"
            android:layout_gravity="center_horizontal"
            android:id="@+id/status_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/sport_update_discover_new_version"
            android:maxLines="1"/>
        <View
            android:layout_marginTop="25dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            style="@style/SettingsLineStyle"/>
        <TextView
            android:textSize="@dimen/dimen_15sp"
            android:textColor="@color/text_color"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="35dp"
            android:text="@string/sport_firmware_update_log"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"/>
        <TextView
            android:textSize="@dimen/dimen_14sp"
            android:textColor="@color/text_color"
            android:id="@+id/change_log"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"/>
    </LinearLayout>
    <include
        android:id="@+id/bottom_layout"
        layout="@layout/eco_sport_ble_update_fragment_bottom"/>
</LinearLayout>
