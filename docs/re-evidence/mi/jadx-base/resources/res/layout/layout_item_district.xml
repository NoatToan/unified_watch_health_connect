<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/dimen_margin_20dp"
    android:paddingEnd="@dimen/dimen_margin_10dp"
    android:paddingVertical="@dimen/dimen_14sp">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textColor="@color/text_color"
            android:id="@+id/district_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="@dimen/dimen_margin_4dp"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/FontMedium.18sp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/text_color_40"
            android:id="@+id/district_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_2dp"
            android:text="700mb"
            android:fontFamily="@font/misanslatin_regular"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/district_download"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_offline_map_download"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/progress_layout"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="7dp"
        android:layout_marginBottom="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/colorPrimary"
            android:layout_gravity="center"
            android:id="@+id/progress_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="7dp"
            android:text="下载中"/>
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.xiaomi.fitness.baseui.widget.CustomCircleProgressBar
                android:id="@+id/progressView"
                android:background="@drawable/map_downloading_progress_bg"
                android:layout_width="23dp"
                android:layout_height="23dp"
                app:inside_indent="0"
                app:paint_color="@color/colorPrimary"
                app:paint_width="5"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/download_small_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/offline_map_downloading_small_icon"/>
        </FrameLayout>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/dimen_12sp"
        android:textColor="@color/text_color_40"
        android:id="@+id/district_installed"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
