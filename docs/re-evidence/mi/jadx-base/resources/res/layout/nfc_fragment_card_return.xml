<?xml version="1.0" encoding="utf-8"?>
<miuix.springback.view.SpringBackLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/nfc_fragment_card_return_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:scrollableView="@+id/scrollview">
    <miuix.core.widget.NestedScrollView
        android:id="@+id/scrollview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="@dimen/text_size_14"
                android:textColor="@color/text_color"
                android:id="@+id/nfc_return_card_need_account"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_16dp"
                android:text="@string/nfc_return_card_need_account"
                android:paddingStart="@dimen/page_content_padding_horizontal_large"
                android:paddingEnd="@dimen/page_content_padding_horizontal_large"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/nfc_alipay_auth_btn_gray"
                android:background="@drawable/nfc_alipay_auth_btn_gray"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="@dimen/dimen_margin_16dp"
                android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
                android:layout_marginEnd="@dimen/page_content_padding_horizontal_large"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/nfc_return_card_need_account">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/mine_ic_alipay"
                    android:background="@drawable/nfc_alipay_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="16sp"
                    android:textColor="@color/text_color"
                    android:gravity="center"
                    android:id="@+id/nfc_alipay_account"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nfc_alipay_account"
                    android:layout_marginStart="10dp"
                    app:layout_constraintBottom_toTopOf="@+id/auth_text"
                    app:layout_constraintStart_toEndOf="@+id/mine_ic_alipay"
                    app:layout_constraintTop_toTopOf="@+id/mine_ic_alipay"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="13sp"
                    android:textColor="@color/text_color_40"
                    android:gravity="start"
                    android:id="@+id/auth_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/nfc_has_link_alipay"
                    android:layout_marginStart="10dp"
                    app:layout_constraintBottom_toBottomOf="@+id/mine_ic_alipay"
                    app:layout_constraintEnd_toStartOf="@+id/to_auth"
                    app:layout_constraintStart_toEndOf="@+id/mine_ic_alipay"
                    app:layout_constraintTop_toBottomOf="@+id/nfc_alipay_account"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/dimen_13sp"
                    android:textColor="#0d84ff"
                    android:gravity="center"
                    android:id="@+id/to_auth"
                    android:background="@drawable/nfc_alipay_auth_btn_bg"
                    android:layout_width="72dp"
                    android:layout_height="39dp"
                    android:text="@string/nfc_to_auth"
                    android:layout_marginEnd="@dimen/page_content_padding_horizontal_large"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="13sp"
                android:textColor="@color/text_color_60"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="100dp"
                android:text="@string/nfc_auth_remind_text"
                android:paddingStart="@dimen/page_content_padding_horizontal_large"
                android:paddingEnd="@dimen/page_content_padding_horizontal_large"
                app:layout_constraintTop_toBottomOf="@+id/nfc_alipay_auth_btn_gray"/>
            <TextView
                android:enabled="false"
                android:id="@+id/confirmView"
                android:layout_marginBottom="@dimen/nfc_size_26_7"
                android:text="@string/nfc_retrun_card_btn_title"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                style="@style/CommonBtn.Primary"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </miuix.core.widget.NestedScrollView>
</miuix.springback.view.SpringBackLayout>
