<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/energy_container"
    android:tag="layout/fragment_energy_day_item_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.xiaomi.fitness.view.DispatchMaskDownLinearLayout
        android:orientation="vertical"
        android:id="@+id/dispatchMaskDownLinearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.xiaomi.fitness.chart.view.LineChartRecyclerView
                android:id="@+id/line_recycler"
                app:chartColor="@color/data_energy"
                app:displayNumbers="48"
                app:dynamicAdjustItemFillWidth="true"
                app:enableEndDayXAxis="true"
                app:enableEndYAxisLabel="true"
                app:enableScrollToScale="true"
                app:enableStartYAxisLabel="false"
                app:enableXAxisFirstGridLine="false"
                app:enableXAxisLineCircle="true"
                app:enableXAxisThirdGridLine="false"
                app:lineColor="@color/data_energy"
                app:linePointRadius="@dimen/size_2"
                app:linePointSelectCircleStroke="true"
                app:linePointSelectRadius="@dimen/size_2"
                app:linePointSelectStrokeWidth="@dimen/size_2"
                app:lineSelectCircles="1"
                app:lineShaderBeginColor="@color/energy_shader_begin"
                app:lineShaderEndColor="@color/energy_shader_end"
                app:lineStrokeWidth="6"
                style="@style/ChartBaseStyle"/>
            <com.xiaomi.fitness.view.DataTitleView
                android:id="@+id/dataTitleView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:focusable="true"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_34"
            android:baselineAligned="false">
            <LinearLayout
                android:gravity="start"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:paddingStart="@dimen/chart_common_padding_start">
                <TextView
                    android:textSize="@dimen/font_12"
                    android:textColor="@color/text_color_40"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/health_energy_type_recovery"
                    android:drawablePadding="@dimen/size_6"
                    android:drawableStart="@drawable/ic_energy_recovery_drawable"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <TextView
                    android:textSize="@dimen/font_12"
                    android:textColor="@color/text_color_40"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/health_energy_type_consume"
                    android:drawablePadding="@dimen/size_6"
                    android:drawableStart="@drawable/ic_energy_consume_drawable"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="end"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:paddingEnd="@dimen/chart_common_padding_start">
                <TextView
                    android:textSize="@dimen/font_12"
                    android:textColor="@color/text_color_40"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/health_energy_type_activity"
                    android:drawablePadding="@dimen/size_6"
                    android:drawableStart="@drawable/ic_energy_activity_drawable"/>
            </LinearLayout>
        </LinearLayout>
        <com.xiaomi.fitness.chart.view.BarChartRecyclerView
            android:id="@+id/bottom_bar_chart"
            android:layout_width="match_parent"
            android:layout_height="108dp"
            android:paddingStart="@dimen/chart_common_padding_start"
            android:paddingEnd="@dimen/chart_common_padding_end"
            app:barSpace="0.5"
            app:chartColor="@color/data_energy"
            app:contentPaddingBottom="@dimen/size_41"
            app:contentPaddingTop="0dp"
            app:displayNumbers="48"
            app:dynamicAdjustItemFillWidth="true"
            app:enableEndDayXAxis="true"
            app:enableEndYAxisLabel="false"
            app:enableStartYAxisLabel="false"/>
    </com.xiaomi.fitness.view.DispatchMaskDownLinearLayout>
    <include
        android:id="@+id/ll_card"
        layout="@layout/layout_energy_dwm_common"/>
</LinearLayout>
