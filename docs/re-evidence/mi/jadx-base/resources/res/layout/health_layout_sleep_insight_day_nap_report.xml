<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/health_layout_sleep_insight_day_nap_report_0"
    android:paddingBottom="@dimen/size_26"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/health_sleep_daytime_nap"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/HealthSleepAnimalReportTitle"/>
    <TextView
        android:id="@+id/tv_time_tag"
        app:layout_constraintBottom_toBottomOf="@+id/tv_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/tv_title"
        app:layout_constraintTop_toTopOf="@+id/tv_title"
        style="@style/HealthSleepAnimalReportImproved"/>
    <TextView
        android:id="@+id/tv_time_subtitle"
        android:drawableStart="@drawable/health_ic_sleep_day_nap"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        style="@style/HealthSleepAnimalReportSubtitle"/>
    <TextView
        android:id="@+id/tv_schedule_time_desc"
        android:text="@string/health_sleep_daytime_nap_common_explain"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_time_subtitle"
        style="@style/HealthSleepAnimalReportDesc"/>
    <com.xiaomi.fitness.chart.view.BarChartRecyclerView
        android:id="@+id/bar_recycler_view"
        android:visibility="gone"
        android:layout_marginTop="@dimen/size_10"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_schedule_time_desc"
        style="@style/HealthSleepAnimalBarChartRecyclerStyle.SleepContinuityAndNap"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_empty"
        android:background="@drawable/health_sleep_insight_no_data_bg_shape"
        android:paddingTop="@dimen/size_14"
        android:paddingBottom="@dimen/size_14_7"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_10"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_schedule_time_desc">
        <TextView
            android:textSize="10.7sp"
            android:textColor="@color/health_sleep_insight_report_no_data_text_color"
            android:layout_gravity="center"
            android:id="@+id/tv_no_data_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/health_sleep_no_daytime_nap_record"
            android:drawableTop="@drawable/health_ic_insight_sleep_no_data"
            android:drawablePadding="4.7dp"
            style="@style/FontRegular"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
