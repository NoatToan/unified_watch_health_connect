<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:background="@drawable/widget_default_corners_background_12_67"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@android:id/widget_frame"
        android:background="@color/common_card_bg_color"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:paddingHorizontal="12dp">
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <TextView
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="8"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/text_color"
                android:gravity="start|center_vertical"
                android:id="@+id/widgetStepTitle"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:text="@string/provider_step_label"
                android:maxLines="1"
                android:layout_weight="16"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="2sp"
                android:autoSizeMaxTextSize="12sp"
                android:textFontWeight="600"/>
            <TextView
                android:textSize="22sp"
                android:textColor="@color/text_color"
                android:gravity="start|center_vertical"
                android:id="@+id/widgetStepValue"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:text="--"
                android:maxLines="1"
                android:layout_weight="28"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="2sp"
                android:autoSizeMaxTextSize="22sp"
                android:textFontWeight="600"/>
            <TextView
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="7"/>
        </LinearLayout>
        <FrameLayout
            android:layout_gravity="center_vertical"
            android:id="@+id/widgetStepRingImage"
            android:clipChildren="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp">
            <ImageView
                android:id="@+id/iv_ring_image"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_widget_step_yellow_ring_loading"
                android:importantForAccessibility="no"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/iv_step_image"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/ic_widget_step_icon_loading"
                android:importantForAccessibility="no"/>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
