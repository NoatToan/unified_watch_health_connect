<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_sport_trace_show_pic_and_feelings_0"
    android:background="@drawable/shape_card_bg_normal"
    android:layout_width="290dp"
    android:layout_height="448.3281dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/view_pager_container"
        android:layout_width="290dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/record_feelings"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/view_pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/dimen_margin_2dp"
            android:layout_marginHorizontal="@dimen/dimen_margin_2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:id="@+id/record_feelings"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_margin_40dp"
        android:layout_marginHorizontal="@dimen/dimen_margin_12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/FontRegular.14sp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
