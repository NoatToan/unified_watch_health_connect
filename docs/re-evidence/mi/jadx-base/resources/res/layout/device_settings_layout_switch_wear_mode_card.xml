<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/common_card_bg_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/dimen_margin_12dp">
    <ImageView
        android:id="@+id/mode_icon"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="@dimen/size_26_67"
        android:layout_marginBottom="@dimen/size_26_67"
        android:scaleType="centerInside"
        android:layout_marginStart="@dimen/dimen_margin_18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/text_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_36dp"
        android:layout_marginBottom="@dimen/dimen_margin_36dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/mode_icon"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:id="@+id/mode_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/FontMedium.16sp"/>
        <TextView
            android:id="@+id/mode_func"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_4"
            app:layout_constraintStart_toStartOf="@+id/mode_title"
            app:layout_constraintTop_toBottomOf="@+id/mode_title"
            style="@style/FontRegular.12sp"/>
        <TextView
            android:textColor="@color/footer_desc"
            android:id="@+id/mode_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/mode_title"
            app:layout_constraintTop_toBottomOf="@+id/mode_func"
            style="@style/FontRegular.12sp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/mode_switch"
        android:background="@drawable/device_settings_selector_clock_check"
        android:layout_width="@dimen/size_21_3"
        android:layout_height="@dimen/size_21_3"
        android:layout_marginEnd="@dimen/dimen_margin_18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
