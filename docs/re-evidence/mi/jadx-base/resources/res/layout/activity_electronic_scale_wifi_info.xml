<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/activity_electronic_scale_wifi_info_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/wifi_info_icon"
        android:background="@drawable/electronic_scale_icon_electronic_scale_wifi_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/text_color_40"
        android:id="@+id/wifi_info_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/electronic_scale_wifi_info_desc_good"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/wifi_info_icon"/>
    <com.xiaomi.fitness.widget.RightArrowBindingSingleLineTextView
        android:id="@+id/wifi_info_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:layout_marginHorizontal="@dimen/page_content_padding_horizontal_large"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/wifi_info_desc"
        app:showMore="false"
        app:showRemind="true"
        app:title="@string/electronic_scale_wifi_info_name"/>
    <Button
        android:id="@+id/wifi_info_reset"
        android:layout_marginBottom="27dp"
        android:text="@string/electronic_scale_wifi_info_reset"
        android:layout_marginHorizontal="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/CommonBtn.Normal"/>
</androidx.constraintlayout.widget.ConstraintLayout>
