<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:tag="layout/device_settings_item_pangu_shortcut_settings_0"
    android:background="@drawable/device_settings_selector_list_item_round"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:paddingStart="@dimen/page_content_padding_horizontal_large"
    android:paddingEnd="@dimen/page_content_padding_horizontal_large">
    <ImageView
        android:id="@+id/icon"
        android:layout_width="@dimen/dimen_margin_22dp"
        android:layout_height="@dimen/dimen_margin_22dp"
        android:scaleType="center"/>
    <TextView
        android:textColor="@color/selector_feature_item_title_text_color"
        android:gravity="center_vertical"
        android:id="@+id/name_tv"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_weight="1"
        android:textDirection="locale"
        android:layout_marginStart="@dimen/dimen_margin_10dp"
        style="@style/FontMedium.16sp"/>
    <ImageView
        android:id="@+id/swipe_iv"
        android:layout_width="wrap_content"
        android:layout_height="60dp"
        android:src="@drawable/icon_common_item_sort"
        android:scaleType="center"
        android:layout_marginStart="@dimen/dimen_margin_26dp"/>
</LinearLayout>
