<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutView"
    android:tag="layout/nfc_fragment_szt_return_card_manager_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/page_content_padding_horizontal_large"
    android:paddingEnd="@dimen/page_content_padding_horizontal_large">
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/text_color"
        android:id="@+id/serviceFeeTitleView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="@string/nfc_retrun_card_only_service_fee"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/text_color_80"
        android:id="@+id/serviceFeeDescView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/nfc_retrun_card_only_service_msg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/serviceFeeTitleView"/>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/text_color"
        android:id="@+id/returnCardView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="35dp"
        android:text="@string/nfc_retrun_card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/serviceFeeDescView"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/text_color_80"
        android:id="@+id/returnCardDescView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/nfc_retrun_card_msg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/returnCardView"/>
    <TextView
        android:id="@+id/returnServiceView"
        android:layout_width="0dp"
        android:text="@string/nfc_retrun_card_only_service_fee"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/returnView"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/BaseButton.Positive"/>
    <TextView
        android:id="@+id/returnView"
        android:layout_width="0dp"
        android:text="@string/nfc_retrun_card"
        android:layout_marginStart="13dp"
        android:layout_marginEnd="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/returnServiceView"
        style="@style/BaseButton.Positive"/>
</androidx.constraintlayout.widget.ConstraintLayout>
