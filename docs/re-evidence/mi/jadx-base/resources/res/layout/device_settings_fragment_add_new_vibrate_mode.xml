<?xml version="1.0" encoding="utf-8"?>
<miuix.springback.view.SpringBackLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/device_settings_fragment_add_new_vibrate_mode_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:scrollableView="@+id/scrollview">
    <miuix.core.widget.NestedScrollView
        android:id="@+id/scrollview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <RelativeLayout
            android:id="@+id/vibrateBgView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="@dimen/page_content_padding_horizontal_large"
            android:paddingEnd="@dimen/page_content_padding_horizontal_large">
            <RelativeLayout
                android:id="@+id/deviceContainnerView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true">
                <com.xiaomi.fitness.devicesettings.huami.vibratemode.DeviceImageView
                    android:id="@+id/deviceView"
                    android:layout_width="@dimen/dimen_margin_200dp"
                    android:layout_height="@dimen/dimen_margin_200dp"
                    android:layout_marginTop="@dimen/dimen_margin_20dp"/>
                <ImageView
                    android:id="@+id/vibrateIconView"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/device_setting_ic_vibrate"
                    android:layout_centerInParent="true"/>
            </RelativeLayout>
            <TextView
                android:textSize="@dimen/dimen_16sp"
                android:textStyle="bold"
                android:textColor="@color/switch_black"
                android:gravity="center"
                android:id="@+id/showClickView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_13dp"
                android:text="@string/device_settings_add_new_click_alert"
                android:layout_below="@+id/deviceContainnerView"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="@dimen/dimen_12sp"
                android:textColor="@color/switch_black"
                android:id="@+id/battryAlertView"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/device_settings_add_new_battry_alert"
                android:layout_below="@+id/showClickView"
                android:layout_centerHorizontal="true"/>
            <com.xiaomi.fitness.devicesettings.huami.vibratemode.VibrateModeProgressBar
                android:id="@+id/progressView"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimen_margin_26dp"
                android:layout_marginBottom="@dimen/dimen_margin_30dp"
                android:layout_above="@+id/bottomView"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/bottomView"
                android:paddingBottom="@dimen/dimen_margin_10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:paddingStart="@dimen/page_content_padding_horizontal_large"
                android:paddingEnd="@dimen/page_content_padding_horizontal_large">
                <Button
                    android:enabled="false"
                    android:id="@+id/vibrateView"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/common_btn_height"
                    android:text="@string/device_settings_add_new_vibrate_in_device"
                    android:layout_weight="1"
                    android:layout_marginStart="0dp"
                    android:layout_marginEnd="0dp"
                    style="@style/CommonBtn.Normal"/>
                <Button
                    android:enabled="false"
                    android:id="@+id/stopView"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/common_btn_height"
                    android:text="@string/device_settings_add_new_vibrate_stop"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/common_set_item_margin"
                    android:layout_marginEnd="0dp"
                    style="@style/CommonBtn.Normal"/>
            </LinearLayout>
        </RelativeLayout>
    </miuix.core.widget.NestedScrollView>
</miuix.springback.view.SpringBackLayout>
