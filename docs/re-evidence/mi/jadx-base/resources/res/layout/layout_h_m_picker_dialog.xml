<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:gravity="center"
        android:id="@+id/tv_dialog_description"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Dialog.Text.Description"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_picker"
        android:focusable="true"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_174"
        android:layout_marginStart="@dimen/size_18"
        android:layout_marginEnd="@dimen/size_18"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_dialog_description">
        <com.xiaomi.fitness.baseui.widget.NumberPickerView
            android:id="@+id/picker_hour"
            android:focusable="true"
            android:layout_width="0dp"
            android:layout_height="@dimen/size_174"
            android:layout_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:npv_DividerColor="@color/transparent"
            app:npv_HintText="@string/unit_hour"
            app:npv_NumberDigits="1"
            app:npv_SelectItemBackgroundColor="@color/pressed_common_item_bg_color"
            app:npv_TextColorOuter="@color/divider_color"
            app:npv_WrapSelectorWheel="true"
            style="@style/Picker.Number.DateDialog"/>
        <com.xiaomi.fitness.baseui.widget.NumberPickerView
            android:id="@+id/picker_minute"
            android:focusable="true"
            android:layout_width="0dp"
            android:layout_height="@dimen/size_174"
            android:layout_weight="1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_dialog_description"
            app:npv_DividerColor="@color/transparent"
            app:npv_HintText="@string/unit_min"
            app:npv_NumberDigits="1"
            app:npv_SelectItemBackgroundColor="@color/pressed_common_item_bg_color"
            app:npv_TextColorOuter="@color/divider_color"
            app:npv_WrapSelectorWheel="true"
            style="@style/Picker.Number.DateDialog"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
