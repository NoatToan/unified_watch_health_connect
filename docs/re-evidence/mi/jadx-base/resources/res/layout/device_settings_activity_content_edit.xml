<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/device_settings_activity_content_edit_0"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/cancel_iv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/device_settings_audio_record_edit_back_disable"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/recovery_iv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/device_settings_audio_record_edit_next_disable"
        android:layout_marginStart="20dp"
        app:layout_constraintStart_toEndOf="@+id/cancel_iv"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/save_iv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/device_settings_audio_record_edit_save"
        android:layout_marginStart="20dp"
        app:layout_constraintStart_toEndOf="@+id/recovery_iv"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
