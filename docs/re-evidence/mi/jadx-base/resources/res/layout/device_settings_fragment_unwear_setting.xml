<?xml version="1.0" encoding="utf-8"?>
<miuix.springback.view.SpringBackLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/device_settings_fragment_unwear_setting_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:scrollableView="@+id/scrollview">
    <miuix.core.widget.NestedScrollView
        android:id="@+id/scrollview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.xiaomi.fitness.devicesettings.huami.vibratemode.DeviceImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/bigIconView"
                android:layout_width="@dimen/dimen_margin_200dp"
                android:layout_height="@dimen/dimen_margin_200dp"
                android:layout_marginTop="13dp"/>
            <TextView
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/switch_black"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/device_settings_unwear_alert"
                android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
                android:layout_marginEnd="@dimen/page_content_padding_horizontal_large"/>
            <com.xiaomi.fitness.widget.view.DividerView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
                android:layout_marginEnd="@dimen/page_content_padding_horizontal_large"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/enableContainnerView"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <com.xiaomi.fitness.widget.RightArrowTwoLineTextView
                    android:id="@+id/closePwdView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/page_content_padding_horizontal_large"
                    android:paddingEnd="@dimen/page_content_padding_horizontal_large"
                    app:showRemind="false"
                    app:title="@string/device_settings_unwear_close_pwd"/>
                <com.xiaomi.fitness.widget.RightArrowTwoLineTextView
                    android:id="@+id/updatePwdView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/page_content_padding_horizontal_large"
                    android:paddingEnd="@dimen/page_content_padding_horizontal_large"
                    app:showRemind="false"
                    app:title="@string/device_settings_unwear_update_pwd"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/unEnableContainnerView"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <com.xiaomi.fitness.widget.RightArrowTwoLineTextView
                    android:id="@+id/setPwdView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/page_content_padding_horizontal_large"
                    android:paddingEnd="@dimen/page_content_padding_horizontal_large"
                    app:remindText="@string/device_settings_unwear_no_set"
                    app:showRemind="true"
                    app:title="@string/device_settings_unwear_set_pwd"/>
            </LinearLayout>
        </LinearLayout>
    </miuix.core.widget.NestedScrollView>
</miuix.springback.view.SpringBackLayout>
