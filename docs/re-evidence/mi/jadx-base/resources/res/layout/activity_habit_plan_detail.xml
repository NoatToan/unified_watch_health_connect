<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/main"
    android:tag="layout/activity_habit_plan_detail_0"
    android:background="@color/page_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.xiaomi.fitness.training_plan_export.widget.TrainingPlanTitleBar
        android:id="@+id/titlebar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/title_bar_height"
        android:layout_marginTop="@dimen/dimen_margin_36dp"
        android:layout_marginHorizontal="21dp"/>
    <FrameLayout
        android:id="@+id/contentRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="@dimen/dimen_margin_12dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_10dp">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:background="@drawable/training_card_shape"
                    android:paddingTop="@dimen/dimen_margin_14dp"
                    android:paddingBottom="@dimen/dimen_margin_14dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="@dimen/dimen_margin_14dp"
                    android:layout_marginEnd="@dimen/dimen_margin_10dp">
                    <TextView
                        android:textSize="@dimen/dimen_14sp"
                        android:textColor="@color/text_color"
                        android:id="@+id/dayCountLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/training_plan_habit_every_week_count_label"
                        android:fontFamily="@font/misanslatin_medium"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="36sp"
                        android:textColor="@color/text_color"
                        android:id="@+id/dayCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimen_margin_14dp"
                        android:fontFamily="@font/misanslatin_medium"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/dayCountLabel"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/text_color"
                        android:id="@+id/dayCountUnit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimen_margin_14dp"
                        android:layout_marginBottom="@dimen/dimen_margin_4dp"
                        android:fontFamily="@font/misanslatin_medium"
                        android:layout_marginStart="@dimen/dimen_margin_4dp"
                        app:layout_constraintBottom_toBottomOf="@+id/dayCount"
                        app:layout_constraintStart_toEndOf="@+id/dayCount"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:background="@drawable/training_card_shape"
                    android:paddingTop="@dimen/dimen_margin_14dp"
                    android:paddingBottom="@dimen/dimen_margin_14dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="@dimen/dimen_margin_14dp">
                    <TextView
                        android:textSize="@dimen/dimen_14sp"
                        android:textColor="@color/text_color"
                        android:id="@+id/distanceLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/training_plan_habit_every_day_distance_label"
                        android:fontFamily="@font/misanslatin_medium"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="36sp"
                        android:textColor="@color/text_color"
                        android:id="@+id/distance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimen_margin_14dp"
                        android:fontFamily="@font/misanslatin_medium"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/distanceLabel"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/text_color"
                        android:id="@+id/distanceUnit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimen_margin_14dp"
                        android:layout_marginBottom="@dimen/dimen_margin_4dp"
                        android:fontFamily="@font/misanslatin_medium"
                        android:layout_marginStart="@dimen/dimen_margin_4dp"
                        app:layout_constraintBottom_toBottomOf="@+id/distance"
                        app:layout_constraintStart_toEndOf="@+id/distance"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/training_card_shape"
                android:paddingTop="@dimen/dimen_margin_20dp"
                android:paddingBottom="@dimen/dimen_margin_20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_12dp"
                android:paddingStart="@dimen/dimen_margin_14dp">
                <TextView
                    android:textSize="17sp"
                    android:textColor="@color/text_color"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/training_plan_label"
                    android:fontFamily="@font/misanslatin_medium"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/planList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_margin_24dp"
                    android:layout_marginEnd="@dimen/dimen_margin_12dp"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
