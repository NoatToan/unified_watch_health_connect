<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:tag="layout/userinfo_display_item_view_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/page_content_padding_horizontal_large"
    android:paddingVertical="@dimen/dimen_margin_10dp">
    <TextView
        android:textColor="@color/userinfo_grey_color"
        android:ellipsize="marquee"
        android:id="@+id/item_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="3"
        style="@style/FontRegular.12sp"/>
    <TextView
        android:ellipsize="marquee"
        android:id="@+id/item_detail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_2dp"
        android:maxLines="3"
        android:layout_below="@+id/item_title"
        style="@style/FontDemiBold.16sp"/>
</RelativeLayout>
