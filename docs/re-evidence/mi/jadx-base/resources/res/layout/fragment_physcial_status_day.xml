<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/fragment_physcial_status_day_0"
    android:paddingBottom="@dimen/health_detail_page_common_margin_vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.xiaomi.fitness.chart.view.LineChartRecyclerView
            android:id="@+id/recycler"
            android:paddingHorizontal="20dp"
            app:displayNumbers="42"
            app:enableScrollToScale="true"
            app:enableStartYAxisLabel="false"
            app:enableXAxisLineCircle="true"
            app:enableYAxisZero="true"
            app:lineColor="@color/health_physical_status_level_color"
            app:lineHighLightType="4"
            app:linePointRadius="@dimen/size_3"
            app:linePointSelectCircleStroke="true"
            app:linePointSelectRadius="@dimen/size_3"
            app:linePointSelectStrokeWidth="@dimen/size_2"
            app:lineSelectCircles="1"
            app:lineShaderBeginColor="@color/health_physical_status_level_end_color"
            app:lineShaderEndColor="@color/health_physical_status_level_color"
            app:lineStrokeWidth="6"
            app:yAxisLineColor="@color/black_15"
            style="@style/ChartBaseStyle"/>
        <com.xiaomi.fitness.view.DataTitleView
            android:id="@+id/dataTitleView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/today_train_load_card"
        android:background="@drawable/selector_card_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_margin_12dp"
        android:layout_marginHorizontal="@dimen/health_detail_page_common_margin_horizontal">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"/>
        <View
            android:id="@+id/divider"
            android:background="@color/common_divider_bg_color"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_0_33"
            android:layout_marginBottom="@dimen/size_10"
            android:layout_marginStart="@dimen/size_18"
            android:layout_marginEnd="@dimen/size_18"/>
        <com.xiaomi.fitness.baseui.widget.LevelBarView
            android:id="@+id/levelBarView"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_40"
            android:layout_marginTop="@dimen/dimen_margin_12dp"
            android:layout_marginStart="@dimen/size_18"
            android:layout_marginEnd="@dimen/size_18"/>
        <androidx.recyclerview.widget.RecyclerView
            android:layout_gravity="center_horizontal"
            android:id="@+id/level_desc_recyclerview"
            android:paddingBottom="@dimen/size_10"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginStart="@dimen/size_18"
            android:layout_marginEnd="@dimen/size_18"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/data_ctl_atl_view"
        android:background="@drawable/selector_card_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_12dp"
        android:layout_marginBottom="@dimen/dimen_margin_12dp"
        android:layout_marginHorizontal="@dimen/health_detail_page_common_margin_horizontal">
        <com.xiaomi.fitness.widget.view.DataTitleSimpleView
            android:id="@+id/dataSimpleTitleView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textColor="@color/text_color_40"
            android:gravity="center_vertical"
            android:id="@+id/levelViewCTL"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/health_physical_status_ctl"
            android:drawablePadding="@dimen/size_6"
            android:drawableStart="@drawable/bg_level_desc_color_hint"
            android:layout_marginStart="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dataSimpleTitleView"
            style="@style/FontRegular.12sp"/>
        <TextView
            android:textColor="@color/text_color_40"
            android:gravity="center_vertical"
            android:id="@+id/levelViewATL"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/health_physical_status_atl"
            android:drawablePadding="@dimen/size_6"
            android:drawableStart="@drawable/bg_level_desc_color_hint"
            android:layout_marginStart="30dp"
            app:layout_constraintStart_toEndOf="@+id/levelViewCTL"
            app:layout_constraintTop_toBottomOf="@+id/dataSimpleTitleView"
            style="@style/FontRegular.12sp"/>
        <com.xiaomi.fitness.view.DataTitleView
            android:id="@+id/dataTitleViewCTL"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="-10dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/levelViewCTL"/>
        <com.xiaomi.fitness.view.DataTitleView
            android:id="@+id/dataTitleViewATL"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:layout_marginStart="-10dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/levelViewCTL"/>
        <com.xiaomi.fitness.chart.view.LineChartRecyclerView
            android:id="@+id/line_recycler_ctl"
            android:paddingTop="91dp"
            android:layout_marginStart="-10dp"
            android:layout_marginEnd="-10dp"
            app:displayNumbers="42"
            app:enableScrollToScale="true"
            app:enableStartYAxisLabel="false"
            app:enableXAxisLineCircle="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/dataTitleViewATL"
            app:lineColor="@color/health_physical_status_ctl_color"
            app:lineHighLightType="4"
            app:linePointRadius="@dimen/size_3"
            app:linePointSelectCircleStroke="true"
            app:linePointSelectRadius="@dimen/size_3"
            app:linePointSelectStrokeWidth="@dimen/size_2"
            app:lineSelectCircles="1"
            app:lineShaderBeginColor="@color/health_physical_status_ctl_end_color"
            app:lineShaderEndColor="@color/health_physical_status_ctl_color"
            app:lineStrokeWidth="6"
            app:yAxisLineColor="@color/black_15"
            style="@style/ChartBaseStyle"/>
        <com.xiaomi.fitness.chart.view.LineDetailChartRecyclerView
            android:id="@+id/line_recycler_atl"
            android:paddingTop="91dp"
            android:layout_marginStart="-10dp"
            android:layout_marginEnd="-10dp"
            app:displayNumbers="42"
            app:enableScrollToScale="true"
            app:enableStartYAxisLabel="false"
            app:enableXAxisLineCircle="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/dataTitleViewATL"
            app:lineColor="@color/health_physical_status_atl_color"
            app:lineHighLightType="4"
            app:linePointRadius="@dimen/size_3"
            app:linePointSelectCircleStroke="true"
            app:linePointSelectRadius="@dimen/size_3"
            app:linePointSelectStrokeWidth="@dimen/size_2"
            app:lineSelectCircles="1"
            app:lineShaderBeginColor="@color/health_physical_status_atl_end_color"
            app:lineShaderEndColor="@color/health_physical_status_atl_color"
            app:lineStrokeWidth="6"
            app:yAxisLineColor="@color/black_15"
            style="@style/ChartBaseStyle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.xiaomi.fitness.common.devicelist.SportsDeviceListView
        android:id="@+id/deviceListView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-12dp"
        android:layout_marginBottom="@dimen/size_12"
        android:layout_marginHorizontal="@dimen/health_detail_page_common_margin_horizontal"/>
    <com.xiaomi.fitness.view.CardUnderstandView
        android:id="@+id/understandCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size_12"
        android:layout_marginHorizontal="@dimen/health_detail_page_common_margin_horizontal"
        app:txtUnderstand="@string/health_physical_status_understand"/>
</LinearLayout>
