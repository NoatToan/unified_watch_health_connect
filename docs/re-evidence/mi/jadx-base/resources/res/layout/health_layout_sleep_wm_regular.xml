<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_sleep_regular"
    android:tag="layout/health_layout_sleep_wm_regular_0"
    android:background="@drawable/shape_data_item_bg"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/size_18"
    android:paddingEnd="@dimen/size_18">
    <include
        android:id="@+id/layout_common_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_10"
        android:layout_marginStart="-18dp"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/layout_common_icon_title"/>
    <TextView
        android:textSize="13.3sp"
        android:textColor="@color/text_color"
        android:id="@+id/tv_avg_bed_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/health_sleep_avg_bed_time"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_common_title"
        style="@style/FontMedium"/>
    <TextView
        android:textSize="14.7sp"
        android:textColor="@color/text_color"
        android:id="@+id/tv_avg_bed_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_7"
        app:layout_constraintBottom_toBottomOf="@+id/tv_avg_bed_label"
        app:layout_constraintStart_toEndOf="@+id/tv_avg_bed_label"
        style="@style/FontLatinSemiBold"/>
    <TextView
        android:textSize="13.3sp"
        android:textColor="@color/text_color"
        android:id="@+id/tv_avg_wake_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6.3dp"
        android:text="@string/health_sleep_avg_wake_time"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_avg_bed_label"
        style="@style/FontMedium"/>
    <TextView
        android:textSize="14.7sp"
        android:textColor="@color/text_color"
        android:id="@+id/tv_avg_wake_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_7"
        app:layout_constraintBottom_toBottomOf="@+id/tv_avg_wake_label"
        app:layout_constraintStart_toEndOf="@+id/tv_avg_wake_label"
        style="@style/FontLatinSemiBold"/>
    <TextView
        android:textSize="11sp"
        android:textColor="#6750f1"
        android:gravity="start"
        android:id="@+id/tv_high_light_tip"
        android:background="@drawable/health_sleep_tip_purple_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="21dp"
        android:paddingHorizontal="@dimen/size_8"
        android:paddingVertical="4.3dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_avg_wake_label"
        style="@style/FontMedium"/>
    <com.xiaomi.fitness.health.sleep.view.wm.SleepRegularView
        android:id="@+id/sleep_regular_view"
        android:paddingTop="@dimen/size_26_6"
        android:paddingBottom="@dimen/size_31_3"
        android:layout_width="match_parent"
        android:layout_height="258dp"
        android:paddingEnd="@dimen/size_41"
        app:bcl_bg_line_color="@color/common_divider_bg_color"
        app:bcl_bg_line_width="@dimen/size_0_33"
        app:bcl_column_color="@color/health_sleep_regular_chart_color"
        app:bcl_prompt_bg_height="@dimen/size_24"
        app:bcl_prompt_line_color="@color/health_sleep_regular_chart_color"
        app:bcl_prompt_line_width="@dimen/size_0_67"
        app:bcl_prompt_text_size="@dimen/font_12"
        app:bcl_x_text_color="@color/text_color_30"
        app:bcl_x_text_size="@dimen/size_10"
        app:bcl_y_text_color="@color/text_color_30"
        app:bcl_y_text_size="@dimen/size_10"
        app:layout_constraintTop_toBottomOf="@+id/tv_high_light_tip"/>
</androidx.constraintlayout.widget.ConstraintLayout>
