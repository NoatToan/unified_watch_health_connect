<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/health_fragment_sleep_setting_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/page_content_padding_horizontal_large">
    <TextView
        android:text="@string/health_sleep_target_title"
        style="@style/HealthListGroupTitle"/>
    <com.xiaomi.fitness.widget.RightArrowBindingTwoLineTextView
        android:id="@+id/sleep_target_view"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/health_daily_sleep_target"/>
    <com.xiaomi.fitness.widget.view.DividerView
        android:tag="binding_2"
        style="@style/HealthListDivider"/>
    <TextView
        android:tag="binding_3"
        android:text="@string/health_sleep_assistant_title"
        style="@style/HealthListGroupTitle"/>
    <com.xiaomi.fitness.widget.SwitchButtonBindingTwoLineTextView
        android:id="@+id/sleepSwitchView"
        android:tag="binding_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:subtitle="@string/health_sleep_assistant_switch_des"
        app:title="@string/health_sleep_assistant_switch_title"/>
    <com.xiaomi.fitness.widget.SwitchButtonBindingTwoLineTextView
        android:id="@+id/sleepBreathView"
        android:tag="binding_5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:subtitle="@string/health_settings_detection_sleep_respiration_des"
        app:title="@string/health_settings_detection_sleep_respiration"/>
    <com.xiaomi.fitness.widget.SwitchButtonTwoLineTextView
        android:id="@+id/breathRateview"
        android:tag="binding_6"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:subtitle="@string/health_settings_detection_sleep_rate_desc"
        app:title="@string/health_settings_detection_sleep_rate"/>
    <com.xiaomi.fitness.widget.view.DividerView
        android:tag="binding_7"
        style="@style/HealthListDivider"/>
    <TextView
        android:tag="binding_8"
        android:text="@string/health_phone_sleep_assistant_title"
        style="@style/HealthListGroupTitle"/>
    <com.xiaomi.fitness.widget.RightArrowSingleLineTextView
        android:tag="binding_9"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/health_sleep_schedule"/>
    <com.xiaomi.fitness.widget.SwitchButtonBindingTwoLineTextView
        android:id="@+id/sleep_track_view"
        android:tag="binding_10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:subtitle="@string/health_sleep_tracking_des"
        app:title="@string/health_sleep_tracking_title"/>
    <com.xiaomi.fitness.widget.RightArrowBindingTwoLineTextView
        android:id="@+id/deep_sleep_detection_view"
        android:tag="binding_11"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/health_sleep_detection"/>
    <com.xiaomi.fitness.widget.RightArrowBindingTwoLineTextView
        android:id="@+id/sleep_snore_detection_view"
        android:tag="binding_12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:subtitle="@string/health_sleep_snore_detection_tips"
        app:title="@string/health_sleep_snore_detection"/>
</LinearLayout>
