<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/medal_activity_detail_0"
    android:background="@drawable/medal_share_gradient_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/back"
        android:background="@drawable/ic_back_white"
        android:layout_width="@dimen/dimen_round_33.33dp"
        android:layout_height="@dimen/dimen_round_33.33dp"
        android:layout_marginTop="@dimen/dimen_margin_50dp"
        android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dimen_16sp"
        android:textColor="#ff612e"
        android:id="@+id/medal_wear_tv"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_50dp"
        android:layout_marginEnd="@dimen/page_content_padding_horizontal_large"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/data"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/back">
        <com.xiaomi.fitness.widget.SlidableScrollView
            android:id="@+id/spring_back_target"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/medal_detail_group"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:orientation="vertical"
                android:id="@+id/viewpagerContent"
                android:paddingTop="100dp"
                android:clipChildren="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/coverViewPager"
                    android:clipChildren="false"
                    android:layout_width="240dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/dimen_margin_30dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/dimen_10sp"
                    android:textColor="@color/common_white"
                    android:gravity="center"
                    android:id="@+id/medal_wear_icon"
                    android:background="@drawable/medal_wear_bg"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/medal_detai_remind_wear"
                    android:paddingHorizontal="5dp"
                    android:paddingVertical="3dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/coverViewPager"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.xiaomi.fitness.widget.SlidableScrollView>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/medal_detail_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/page_content_padding_horizontal_large"
            android:paddingHorizontal="@dimen/page_padding_horizontal_large"
            app:layout_constraintBottom_toTopOf="@+id/button_group"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <TextView
                android:textSize="46.67sp"
                android:textColor="@color/white"
                android:ellipsize="marquee"
                android:id="@+id/medalName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_10dp"
                android:layout_marginBottom="6.67dp"
                android:maxLines="2"
                app:layout_constraintBottom_toTopOf="@+id/medal_achieve_condition"/>
            <TextView
                android:textColor="@color/white_50"
                android:id="@+id/medal_achieve_condition"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dimen_margin_13dp"
                app:layout_constraintBottom_toTopOf="@+id/progress_bar_and_got_count"
                style="@style/FontRegular.14sp"/>
            <RelativeLayout
                android:id="@+id/progress_bar_and_got_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="37.33dp"
                app:layout_constraintBottom_toBottomOf="parent">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/progress_layout"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="26dp"
                    android:layout_centerVertical="true"
                    android:paddingEnd="@dimen/dimen_margin_8dp"
                    android:layout_alignParentStart="true">
                    <com.xiaomi.fitness.medal.widget.CustomCustomProgressBar
                        android:id="@+id/progress_bar"
                        android:layout_width="113dp"
                        android:layout_height="7.3dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:medal_normalColor="#3c3c3c"
                        app:medal_reachColor="#ff612e"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <TextView
                    android:textSize="@dimen/dimen_14sp"
                    android:textColor="@color/white"
                    android:id="@+id/gotCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_margin_15dp"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@+id/progress_layout"/>
            </RelativeLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/button_group"
            android:paddingBottom="26.67dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/page_content_padding_horizontal_large"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <TextView
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/share_btn"
                android:background="@drawable/selector_bottom_btn_positive_bg"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/common_btn_height"
                android:layout_marginBottom="26dp"
                android:maxWidth="@dimen/common_btn_single_line_width"
                android:text="@string/medal_go_share"
                android:layout_marginHorizontal="@dimen/page_padding_horizontal_large"
                style="@style/FontMedium.16sp"/>
            <TextView
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/challenge_btn"
                android:background="@drawable/selector_bottom_btn_positive_bg"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/common_btn_height"
                android:maxWidth="@dimen/common_btn_single_line_width"
                android:text="@string/medal_go_challenge"
                android:layout_marginHorizontal="@dimen/page_padding_horizontal_large"
                style="@style/FontMedium.16sp"/>
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:id="@+id/share_and_challenge"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="2">
                <TextView
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/go_and_share_small"
                    android:background="@drawable/shape_bottom_btn_neutral_bg_normal"
                    android:layout_width="@dimen/dimen_margin_0dp"
                    android:layout_height="@dimen/common_btn_height"
                    android:maxWidth="@dimen/common_btn_two_column_width"
                    android:text="@string/medal_go_share"
                    android:layout_weight="1"
                    style="@style/FontMedium.16sp"/>
                <TextView
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/go_and_challenge_small"
                    android:background="@drawable/selector_bottom_btn_positive_bg"
                    android:layout_width="@dimen/dimen_margin_0dp"
                    android:layout_height="@dimen/common_btn_height"
                    android:text="@string/medal_go_challenge"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/page_extra_padding_horizontal_large"
                    style="@style/FontMedium.16sp"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <RelativeLayout
        android:id="@+id/no_network"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/no_network_icon"
            android:background="@drawable/medal_icon_no_network"
            android:layout_width="93.3dp"
            android:layout_height="60dp"
            android:layout_centerHorizontal="true"
            android:contentDescription="@string/medal_network_connection_failed_tip"/>
        <TextView
            android:textColor="#8b8b8b"
            android:id="@+id/no_network_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_10dp"
            android:text="@string/medal_network_connection_failed_tip"
            android:layout_below="@+id/no_network_icon"
            android:layout_centerHorizontal="true"
            style="@style/FontRegular.14sp"/>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
