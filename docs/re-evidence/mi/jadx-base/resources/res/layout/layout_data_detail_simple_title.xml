<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="65dp">
    <ImageView
        android:id="@+id/img_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="center"
        android:layout_centerVertical="true"
        android:layout_marginStart="18dp"/>
    <TextView
        android:textColor="@color/text_color"
        android:gravity="start|center_vertical"
        android:id="@+id/txt_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/dimen_margin_14dp"
        android:layout_toEndOf="@+id/img_title"
        style="@style/FontMedium.14sp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/text_color_50"
        android:id="@+id/tv_state_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginEnd="50dp"
        android:layout_alignParentEnd="true"/>
    <ImageView
        android:id="@+id/iv_step_guide"
        android:padding="@dimen/dimen_margin_3dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_pai_guide"
        android:layout_centerVertical="true"
        android:layout_toEndOf="@+id/txt_title"/>
    <ImageView
        android:id="@+id/iv_right_arrow"
        android:padding="@dimen/dimen_margin_3dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/right_arrow_icon_fit_rtl"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/dimen_margin_12dp"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
