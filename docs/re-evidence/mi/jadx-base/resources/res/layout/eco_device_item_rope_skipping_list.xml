<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/device_item_layout"
    android:tag="layout/eco_device_item_rope_skipping_list_0"
    android:background="@drawable/selector_card_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/dimen_margin_12dp"
    android:paddingStart="@dimen/dimen_margin_18dp"
    android:paddingEnd="@dimen/dimen_margin_18dp">
    <ImageView
        android:id="@+id/device_iv_item_bound_device_icon"
        android:tag="binding_1"
        android:layout_width="@dimen/eco_device_item_device_dial_size"
        android:layout_height="@dimen/eco_device_item_device_dial_size"
        android:layout_marginTop="@dimen/eco_device_bound_device_item_padding_v"
        android:layout_marginBottom="@dimen/eco_device_bound_device_item_padding_v"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/eco_device_text_color_black"
        android:gravity="start|center_vertical"
        android:id="@+id/device_tv_item_bound_device_name"
        android:tag="binding_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="3"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toTopOf="@+id/device_tv_item_bound_device_mac"
        app:layout_constraintEnd_toStartOf="@+id/device_tv_item_bound_device_switch"
        app:layout_constraintStart_toEndOf="@+id/device_iv_item_bound_device_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/FontMedium.16sp"/>
    <TextView
        android:textColor="@color/eco_device_text_color_unable"
        android:gravity="start|center_vertical"
        android:id="@+id/device_tv_item_bound_device_mac"
        android:tag="binding_3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/device_tv_item_bound_device_name"
        app:layout_constraintStart_toStartOf="@+id/device_tv_item_bound_device_name"
        app:layout_constraintTop_toBottomOf="@+id/device_tv_item_bound_device_name"
        style="@style/FontRegular.12sp"/>
    <TextView
        android:textColor="@color/eco_device_text_color_black"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/device_tv_item_bound_device_switch"
        android:tag="binding_4"
        android:background="@drawable/selector_bottom_btn_native_bg"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/eco_device_switch_btn_height"
        android:minWidth="@dimen/eco_device_switch_btn_min_width"
        android:text="@string/eco_device_switch"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/FontMedium.14sp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
