<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/pk_layout_process_detail_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/pk_in_progress_header"
        android:background="@color/pk_deep_orange"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/btn_back"
            android:background="@drawable/ic_back_pk_process_detail_white"
            android:layout_width="@dimen/dimen_round_33.33dp"
            android:layout_height="@dimen/dimen_round_33.33dp"
            android:layout_centerVertical="true"
            android:translationY="@dimen/dimen_margin_20dp"
            android:layout_marginStart="19.33dp"
            android:layout_alignParentStart="true"/>
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:translationY="@dimen/dimen_margin_20dp">
            <TextView
                android:textColor="@color/white"
                android:ellipsize="middle"
                android:id="@+id/pk_with_opponent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="214.67dp"
                android:singleLine="true"
                android:layout_centerHorizontal="true"
                style="@style/FontMedium.18sp"/>
            <TextView
                android:textSize="@dimen/text_size_14"
                android:textColor="@color/pk_process_estimated_checkout_time_color"
                android:id="@+id/estimated_checkout_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_2dp"
                android:layout_below="@+id/pk_with_opponent"
                android:layout_centerHorizontal="true"
                style="@style/FontLatinMedium"/>
        </RelativeLayout>
        <ImageView
            android:id="@+id/info"
            android:background="@drawable/ic_info"
            android:layout_width="@dimen/dimen_round_33.33dp"
            android:layout_height="@dimen/dimen_round_33.33dp"
            android:layout_marginBottom="@dimen/dimen_margin_10dp"
            android:layout_centerVertical="true"
            android:translationY="@dimen/dimen_margin_20dp"
            android:layout_marginEnd="19.33dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:tag="binding_1"
            android:background="@color/page_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <View
                android:id="@+id/top_view"
                android:background="@color/pk_deep_orange"
                android:layout_width="match_parent"
                android:layout_height="97.33dp"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/pk_view_gradient_bg"
                android:layout_width="match_parent"
                android:layout_height="161.33dp"
                android:layout_marginTop="58dp"
                app:layout_constraintTop_toBottomOf="@+id/top_view"/>
            <RelativeLayout
                android:id="@+id/header_compare_score"
                android:background="@color/pk_deep_orange"
                android:paddingTop="15.33dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/top_view">
                <RelativeLayout
                    android:id="@+id/opponent_stub"
                    android:paddingTop="10.67dp"
                    android:paddingBottom="@dimen/dimen_margin_17dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true">
                    <ImageView
                        android:id="@+id/oppo_leading_highlight"
                        android:background="@drawable/ic_pk_oppo_lead_bg"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:textSize="@dimen/dimen_12sp"
                        android:textColor="@color/white_60"
                        android:ellipsize="end"
                        android:id="@+id/opponent_name"
                        android:layout_width="129.67dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="11.3dp"
                        android:singleLine="true"
                        android:layout_marginStart="@dimen/pk_process_detail_score_card_padding"
                        android:layout_alignParentStart="true"
                        style="@style/FontLatinMedium"/>
                    <TextView
                        android:textSize="35.33sp"
                        android:textColor="@color/white"
                        android:id="@+id/opponent_current_total_score"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/opponent_name"
                        android:layout_marginStart="@dimen/pk_process_detail_score_card_padding"
                        android:layout_alignParentStart="true"
                        style="@style/FontLatinSemiBold"/>
                    <TextView
                        android:textSize="@dimen/text_size_12"
                        android:textColor="@color/white_80"
                        android:id="@+id/opponent_today_score"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/opponent_current_total_score"
                        android:layout_marginStart="@dimen/pk_process_detail_score_card_padding"
                        android:layout_alignParentStart="true"
                        style="@style/FontLatinSemiBold"/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/opponent_lead_crown"
                        android:visibility="gone"
                        android:layout_width="@dimen/dimen_margin_30dp"
                        android:layout_height="@dimen/dimen_margin_30dp"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="@dimen/pk_process_detail_crown_padding"
                        android:layout_alignEnd="@+id/oppo_leading_highlight"
                        app:srcCompat="@drawable/ic_lead_crown"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/my_stub"
                    android:paddingTop="10.67dp"
                    android:paddingBottom="@dimen/dimen_margin_17dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true">
                    <ImageView
                        android:id="@+id/my_leading_highlight"
                        android:background="@drawable/ic_pk_my_lead_bg"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"/>
                    <TextView
                        android:textColor="@color/white_60"
                        android:id="@+id/my_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="11.3dp"
                        android:layout_marginEnd="@dimen/pk_process_detail_score_card_padding"
                        android:layout_alignParentEnd="true"
                        style="@style/FontMedium.12sp"/>
                    <TextView
                        android:textSize="35.33sp"
                        android:textColor="@color/white"
                        android:id="@+id/my_current_total_score"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/my_name"
                        android:layout_marginEnd="@dimen/pk_process_detail_score_card_padding"
                        android:layout_alignParentEnd="true"
                        style="@style/FontLatinSemiBold"/>
                    <TextView
                        android:textSize="@dimen/text_size_12"
                        android:textColor="@color/white_80"
                        android:id="@+id/my_today_score"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/my_current_total_score"
                        android:layout_marginEnd="@dimen/pk_process_detail_score_card_padding"
                        android:layout_alignParentEnd="true"
                        style="@style/FontLatinSemiBold"/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/my_lead_crown"
                        android:visibility="gone"
                        android:layout_width="@dimen/dimen_margin_30dp"
                        android:layout_height="@dimen/dimen_margin_30dp"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="@dimen/pk_process_detail_crown_padding"
                        android:layout_alignStart="@+id/my_leading_highlight"
                        app:srcCompat="@drawable/ic_lead_crown"/>
                </RelativeLayout>
            </RelativeLayout>
            <View
                android:id="@+id/gradient_bg"
                android:background="@drawable/pk_process_gradient_head"
                android:layout_width="match_parent"
                android:layout_height="69.33dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/header_compare_score"/>
            <RelativeLayout
                android:id="@+id/everyday_score_card"
                android:background="@drawable/shape_card_bg_normal"
                android:layout_width="match_parent"
                android:layout_height="334dp"
                android:layout_marginTop="@dimen/dimen_margin_20dp"
                android:layout_marginHorizontal="@dimen/page_padding_horizontal_large"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/header_compare_score">
                <RelativeLayout
                    android:id="@+id/cup_and_title"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:layout_marginTop="@dimen/dimen_margin_20dp"
                    android:layout_alignParentTop="true">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ic_cup"
                        android:background="@drawable/ic_cup"
                        android:layout_width="@dimen/dimen_margin_30dp"
                        android:layout_height="@dimen/dimen_margin_30dp"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="18dp"
                        android:layout_alignParentStart="true"/>
                    <TextView
                        android:textSize="@dimen/dimen_14sp"
                        android:textColor="@color/text_color"
                        android:id="@+id/title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pk_every_score"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="@dimen/dimen_margin_10dp"
                        android:layout_toEndOf="@+id/ic_cup"
                        style="@style/FontMedium"/>
                </RelativeLayout>
                <RelativeLayout
                    android:orientation="horizontal"
                    android:id="@+id/indicator_three_items"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dimen_margin_20dp"
                    android:layout_marginTop="@dimen/size_23"
                    android:weightSum="9"
                    android:layout_below="@+id/cup_and_title"
                    android:layout_marginEnd="@dimen/dimen_margin_20dp">
                    <RelativeLayout
                        android:id="@+id/opponent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dimen_margin_20dp"
                        android:layout_alignParentStart="true">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/opponent_rec"
                            android:background="@drawable/ic_opponent_rec"
                            android:layout_width="@dimen/dimen_margin_10dp"
                            android:layout_height="@dimen/dimen_margin_10dp"
                            android:layout_centerVertical="true"
                            android:layout_alignParentStart="true"/>
                        <TextView
                            android:textColor="@color/text_color_60"
                            android:ellipsize="end"
                            android:id="@+id/oppo_indicator_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="@dimen/dimen_margin_6dp"
                            android:layout_toEndOf="@+id/opponent_rec"
                            style="@style/FontRegular.12sp"/>
                    </RelativeLayout>
                    <RelativeLayout
                        android:id="@+id/me_and_extra_bonus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@+id/opponent">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/my_rec"
                            android:background="@drawable/ic_my_rec"
                            android:layout_width="@dimen/dimen_margin_10dp"
                            android:layout_height="@dimen/dimen_margin_10dp"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="@dimen/dimen_margin_20dp"/>
                        <TextView
                            android:textColor="@color/text_color_60"
                            android:id="@+id/my_indicator_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/pk_me"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="7.33dp"
                            android:layout_toEndOf="@+id/my_rec"
                            style="@style/FontRegular.12sp"/>
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/extra_bonus_rec"
                            android:background="@drawable/ic_extra_bonus"
                            android:layout_width="@dimen/dimen_margin_10dp"
                            android:layout_height="@dimen/dimen_margin_10dp"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="@dimen/dimen_margin_20dp"
                            android:layout_toEndOf="@+id/my_indicator_name"
                            app:layout_constraintStart_toStartOf="parent"/>
                        <TextView
                            android:textColor="@color/text_color_60"
                            android:gravity="center_vertical"
                            android:id="@+id/extra_bonus_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/pk_extra_bonus"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="7.33dp"
                            android:layout_toEndOf="@+id/extra_bonus_rec"
                            style="@style/FontRegular.12sp"/>
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/extra_bonus_icon"
                            android:background="@drawable/ic_info_gray"
                            android:layout_width="@dimen/dimen_margin_16dp"
                            android:layout_height="@dimen/dimen_margin_16dp"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="4.67dp"
                            android:layout_toEndOf="@+id/extra_bonus_text"
                            app:layout_constraintTop_toTopOf="parent"/>
                    </RelativeLayout>
                </RelativeLayout>
                <com.xiaomi.fitness.active.pk.widget.PkBarChart
                    android:id="@+id/barchart"
                    android:paddingTop="23.3dp"
                    android:paddingBottom="71.3dp"
                    android:layout_width="match_parent"
                    android:layout_height="250dp"
                    android:layout_below="@+id/indicator_three_items"
                    android:paddingStart="18dp"
                    android:paddingEnd="31.3dp"
                    app:pkBarShowBottomScoreEnable="true"
                    app:pkEmptyStr="@string/pk_chart_tomorrow_start"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/sport_record_view"
                android:tag="binding_2"
                android:background="@drawable/shape_card_bg_normal"
                android:paddingBottom="@dimen/dimen_margin_20dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_12dp"
                android:layout_marginHorizontal="@dimen/page_padding_horizontal_large"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/everyday_score_card">
                <include
                    android:id="@+id/pk_opponent_sport_records_stub"
                    android:background="@color/yellow_light"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:layout_marginTop="@dimen/dimen_margin_12dp"
                    android:layout_marginHorizontal="@dimen/dimen_margin_12dp"
                    layout="@layout/pk_layout_arrow_single_line_text_view"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:orientation="vertical"
                    android:id="@+id/opponent_sport_records"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_below="@+id/pk_opponent_sport_records_stub"
                    android:layout_marginHorizontal="@dimen/dimen_margin_12dp"/>
            </RelativeLayout>
            <include
                android:id="@+id/pk_historical_record"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginTop="@dimen/dimen_margin_12dp"
                android:layout_marginHorizontal="@dimen/page_padding_horizontal_large"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/sport_record_view"
                layout="@layout/pk_layout_arrow_single_line_text_view"/>
            <include
                android:id="@+id/pk_rule"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginTop="@dimen/dimen_margin_12dp"
                android:layout_marginHorizontal="@dimen/page_padding_horizontal_large"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/pk_historical_record"
                layout="@layout/pk_layout_arrow_single_line_text_view"/>
            <View
                android:id="@+id/bottom_line_placeholder"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/pk_rule"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <com.xiaomi.fitness.baseui.widget.ScrollTitleBar
        android:id="@+id/title_bar"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="与%s的竞赛"/>
</androidx.constraintlayout.widget.ConstraintLayout>
