<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/sport_layout_select_map_dialog_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textColor="@color/colorPrimary"
        android:gravity="center"
        android:id="@+id/map_gaode"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/sport_map_gaode"
        android:paddingVertical="@dimen/dimen_margin_10dp"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/FontMedium.16sp"/>
    <TextView
        android:gravity="center"
        android:id="@+id/map_baidu"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/sport_map_baidu"
        android:paddingVertical="@dimen/dimen_margin_10dp"
        app:layout_constraintTop_toBottomOf="@+id/map_gaode"
        style="@style/FontMedium.16sp"/>
    <TextView
        android:gravity="center"
        android:id="@+id/map_tencent"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/sport_map_tengxun"
        android:paddingVertical="@dimen/dimen_margin_10dp"
        app:layout_constraintTop_toBottomOf="@+id/map_baidu"
        style="@style/FontMedium.16sp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
