<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_habit_plan_suggest_0"
    android:background="@color/page_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.xiaomi.fitness.training_plan_export.widget.TrainingPlanTitleBar
        android:id="@+id/titlebar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/title_bar_height"
        android:layout_marginTop="@dimen/dimen_margin_36dp"
        android:layout_marginHorizontal="21dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/habit_suggest_content"
        android:background="@drawable/habit_card_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/size_12"
        android:layout_marginTop="@dimen/size_10"
        android:layout_marginRight="@dimen/size_12"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titlebar">
        <com.xiaomi.fitness.widget.view.RoundImageView
            android:id="@+id/user_avatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_common_avatar_default"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/user_info_tip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_margin_12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/user_avatar"
            app:layout_constraintTop_toTopOf="@+id/user_avatar">
            <TextView
                android:ellipsize="end"
                android:gravity="start"
                android:id="@+id/user_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:maxLines="1"
                style="@style/habit_main_textStyle"/>
            <TextView
                android:id="@+id/user_suggest_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_4dp"
                android:text="@string/training_plan_habit_suggest_tip"
                style="@style/habit_secondary_textStyle"/>
        </LinearLayout>
        <View
            android:id="@+id/divider1"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@+id/user_info_tip"
            style="@style/habit_dividerStyle"/>
        <com.xiaomi.fitness.training_plan.widget.HabitSuggestCard
            android:id="@+id/sport_week_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:layout_marginRight="5dp"
            app:layout_constraintEnd_toStartOf="@+id/guide_line"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/divider1"/>
        <com.xiaomi.fitness.training_plan.widget.HabitSuggestCard
            android:id="@+id/sport_time_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/guide_line"
            app:layout_constraintTop_toTopOf="@+id/sport_week_card"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/guide_line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.5"/>
        <View
            android:id="@+id/divider2"
            android:layout_marginTop="30dp"
            app:layout_constraintTop_toBottomOf="@+id/sport_week_card"
            style="@style/habit_dividerStyle"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/training_plan_habit_suggest_change_tip"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/divider2"
            style="@style/habit_secondary_textStyle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:paddingBottom="30dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/confirm"
            android:background="@drawable/bottom_button_selector"
            android:layout_width="306dp"
            android:layout_height="44dp"
            android:text="@string/training_plan_habit_suggest_start"
            style="@style/FontMedium"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/text_color"
            android:gravity="center"
            android:id="@+id/manual"
            android:background="@drawable/selector_bottom_btn_native_bg"
            android:layout_width="306dp"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:text="@string/training_plan_habit_suggest_manually_adjust"
            style="@style/FontMedium"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
