<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:tag="layout/nfc_fragment_active_card_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/common_title_left_margin"
        android:paddingEnd="@dimen/common_title_left_margin">
        <TextView
            android:textSize="20sp"
            android:textColor="@color/text_color"
            android:id="@+id/alertView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="@string/nfc_validate_code_alert_global"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/black_60_transparent"
            android:id="@+id/sendAlertView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/alertView"/>
        <RelativeLayout
            android:id="@+id/codeContainnerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_below="@+id/sendAlertView">
            <com.xiaomi.fitness.nfc.widget.SafeEditText
                android:textSize="16sp"
                android:textColor="@color/text_color"
                android:textColorHint="#39000000"
                android:id="@+id/codeView"
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/nfc_bind_bank_card_validate_code_hint_global"
                android:cursorVisible="true"
                android:singleLine="true"
                android:maxLength="6"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/text_color"
                android:id="@+id/sendView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <View
            android:id="@+id/lineView"
            android:background="@color/common_divider_line"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_marginTop="15dp"
            android:layout_below="@+id/codeContainnerView"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/text_color"
            android:autoLink="all"
            android:id="@+id/helpView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_below="@+id/lineView"
            android:layout_alignParentEnd="true"/>
        <TextView
            android:id="@+id/nextView"
            android:text="@string/nfc_setting_done"
            android:layout_above="@+id/bottomView"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp"
            style="@style/CommonBtn.Primary"/>
        <View
            android:id="@+id/bottomView"
            android:layout_width="match_parent"
            android:layout_height="@dimen/common_title_left_margin"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
</ScrollView>
