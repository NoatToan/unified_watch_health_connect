<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/access_wechat_sport_settings_no_devices_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/page_content_padding_horizontal_large">
    <TextView
        android:textSize="@dimen/dimen_16sp"
        android:textColor="@color/text_color_40"
        android:gravity="center_horizontal"
        android:id="@+id/no_devices_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="160dp"
        android:text="@string/access_no_devices"
        android:drawableTop="@drawable/icon_nothing"
        android:drawablePadding="@dimen/dimen_margin_10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/text_color_40"
        android:id="@+id/no_devices_des"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/page_extra_padding_horizontal_large"
        android:layout_marginTop="@dimen/dimen_margin_4dp"
        app:layout_constraintTop_toBottomOf="@+id/no_devices_icon"
        app:layout_goneMarginTop="@dimen/dimen_margin_20dp"
        style="@style/FontNormal.14sp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
