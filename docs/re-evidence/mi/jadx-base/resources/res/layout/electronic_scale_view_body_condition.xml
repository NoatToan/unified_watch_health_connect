<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:tag="layout/electronic_scale_view_body_condition_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="6sp"
        android:textColor="@color/text_color_60"
        android:id="@+id/tv_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="6sp"
        android:textColor="@color/text_color"
        android:gravity="right"
        android:id="@+id/tv_value"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_name"
        app:layout_constraintTop_toTopOf="parent"/>
    <RelativeLayout
        android:id="@+id/result_balance_rl"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="11dp"
        android:layout_weight="2"
        app:layout_constraintStart_toEndOf="@+id/tv_value"
        app:layout_constraintTop_toTopOf="parent">
        <com.xiaomi.fitness.electronic.scale.widget.sliding.BodyIndexSlidingView
            android:id="@+id/view_body_index"
            android:layout_width="80dp"
            android:layout_height="20dp"
            app:color_circle_radius="16dp"
            app:color_height="3.5dp"
            app:layout_constraintTop_toTopOf="parent"
            app:show_text_color="false"
            app:text_color="@color/text_color_60"
            app:text_color_circle_radius="0dp"
            app:text_color_height="0dp"
            app:text_offset="1.5dp"
            app:text_size="4.5sp"/>
        <ImageView
            android:id="@+id/result_balance_iv"
            android:paddingRight="1dp"
            android:layout_width="4dp"
            android:layout_height="3dp"
            android:layout_marginTop="5dp"
            android:src="@drawable/arrow_down_barlevel"/>
    </RelativeLayout>
</LinearLayout>
