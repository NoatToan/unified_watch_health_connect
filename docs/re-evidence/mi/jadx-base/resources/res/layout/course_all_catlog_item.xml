<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/course_all_catlog_item_0"
    android:layout_width="match_parent"
    android:layout_height="101dp"
    android:layout_marginBottom="12dp"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="20dp">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_course_pic"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        app:shapeAppearance="@style/CourseAllCatalog"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_course_tag"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="11dp"
        android:text="限免"
        android:paddingHorizontal="6.7dp"
        android:paddingVertical="1.7dp"
        app:layout_constraintStart_toStartOf="@+id/iv_course_pic"
        app:layout_constraintTop_toTopOf="@+id/iv_course_pic"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_course_tag_series"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="系列课"
        android:layout_marginStart="7dp"
        android:paddingHorizontal="6.7dp"
        android:paddingVertical="1.7dp"
        app:layout_constraintStart_toEndOf="@+id/tv_course_tag"
        app:layout_constraintTop_toTopOf="@+id/tv_course_tag"
        app:layout_goneMarginStart="11dp"
        app:layout_goneMarginTop="11dp"/>
    <View
        android:id="@+id/view_course_mask"
        android:layout_width="match_parent"
        android:layout_height="73dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:id="@+id/tv_course_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2.7dp"
        android:maxLines="1"
        android:layout_marginEnd="11dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/tv_course_sub_info"
        app:layout_constraintEnd_toEndOf="@+id/iv_course_pic"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/tv_course_sub_info"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/white"
        android:id="@+id/tv_course_sub_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="11dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_course_pic"
        app:layout_constraintStart_toStartOf="@+id/iv_course_pic"/>
</androidx.constraintlayout.widget.ConstraintLayout>
