<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootView"
    android:tag="layout/face_fragment_face_detail_0"
    android:background="@color/face_detail_page_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.xiaomi.fitness.watch.face.widget.FaceDetailScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/button_group"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_weight="1">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:tag="binding_1"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <include
                android:id="@+id/header"
                layout="@layout/face_layout_detail_header"/>
            <TextView
                android:textSize="@dimen/dimen_21sp"
                android:textStyle="bold"
                android:gravity="start|center_vertical"
                android:id="@+id/mNameView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_24dp"
                android:layout_marginHorizontal="@dimen/page_content_padding_horizontal_large"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/header"/>
            <TextView
                android:textSize="@dimen/dimen_13sp"
                android:id="@+id/mSizeAuthorView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_8dp"
                app:layout_constraintStart_toStartOf="@+id/mNameView"
                app:layout_constraintTop_toBottomOf="@+id/mNameView"/>
            <ImageView
                android:id="@+id/power_level"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@+id/mSizeAuthorView"
                app:layout_constraintStart_toEndOf="@+id/mSizeAuthorView"
                app:layout_constraintTop_toTopOf="@+id/mSizeAuthorView"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/label_list"
                android:tag="binding_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_10dp"
                android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
                app:layout_constraintTop_toBottomOf="@+id/mSizeAuthorView"/>
            <TextView
                android:textSize="@dimen/dimen_13sp"
                android:id="@+id/mDescView"
                android:tag="binding_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_18dp"
                android:layout_marginHorizontal="@dimen/page_content_padding_horizontal_large"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/label_list"
                style="@style/FontNormal"/>
            <TextView
                android:id="@+id/recommend_tab_title"
                android:tag="binding_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_28dp"
                android:text="@string/face_recommend_tab"
                android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/mDescView"
                style="@style/FontDemiBold.18sp"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recommend_tab"
                android:tag="binding_5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dimen_margin_40dp"
                android:layout_marginHorizontal="@dimen/page_padding_horizontal_large"
                app:layout_constraintTop_toBottomOf="@+id/recommend_tab_title"/>
            <View
                android:id="@+id/empty_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/recommend_tab"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.xiaomi.fitness.watch.face.widget.FaceDetailScrollView>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/button_group"
        android:background="@color/face_detail_page_bg"
        android:paddingTop="@dimen/dimen_margin_13dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/button_group_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/edit_group"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dimen_margin_24dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:id="@+id/edit_img"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/face_edit"
                    app:layout_constraintEnd_toEndOf="@+id/edit_txt"
                    app:layout_constraintStart_toStartOf="@+id/edit_txt"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:id="@+id/edit_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_margin_3dp"
                    android:text="@string/face_detail_go_edit"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/edit_img"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:id="@+id/actionUseView"
                android:layout_width="0dp"
                android:text="@string/face_detail_set_current"
                android:layout_marginStart="@dimen/dimen_margin_15dp"
                android:layout_marginEnd="@dimen/dimen_margin_3dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/install_edit_upgrade"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toEndOf="@+id/edit_group"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_goneMarginEnd="@dimen/margin_27dp"
                app:layout_goneMarginStart="@dimen/margin_27dp"
                style="@style/CommonBtn.Normal"/>
            <TextView
                android:id="@+id/install_edit_upgrade"
                android:layout_width="0dp"
                android:layout_marginStart="@dimen/dimen_margin_3dp"
                android:layout_marginEnd="@dimen/margin_27dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toEndOf="@+id/actionUseView"
                app:layout_goneMarginEnd="@dimen/margin_27dp"
                app:layout_goneMarginStart="@dimen/margin_27dp"
                style="@style/CommonBtn.Primary"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/purchase_button_new"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <TextView
                android:id="@+id/try_out_new"
                android:layout_width="0dp"
                android:text="@string/face_pay_try_out"
                android:layout_marginStart="@dimen/margin_27dp"
                android:layout_marginEnd="@dimen/dimen_margin_6dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/purchase_new"
                app:layout_constraintHorizontal_weight="288"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/CommonBtn.Normal"/>
            <TextView
                android:id="@+id/purchase_new"
                android:layout_width="0dp"
                android:layout_marginStart="@dimen/dimen_margin_6dp"
                android:layout_marginEnd="@dimen/margin_27dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_weight="596"
                app:layout_constraintStart_toEndOf="@+id/try_out_new"
                app:layout_goneMarginEnd="@dimen/margin_27dp"
                app:layout_goneMarginStart="@dimen/margin_27dp"
                style="@style/CommonBtn.Primary"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.xiaomi.fitness.watch.face.view.FaceWaterMarkView
        android:id="@+id/water_mark"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
