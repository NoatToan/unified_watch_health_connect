<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/contentCardView"
    android:tag="layout/sport_fragment_create_route_detail_0"
    android:background="@drawable/sport_route_ai_create_bg"
    android:paddingLeft="13dp"
    android:paddingTop="20dp"
    android:paddingRight="13dp"
    android:paddingBottom="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/dimen_21sp"
        android:id="@+id/create_route_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:layout_marginHorizontal="@dimen/page_padding_horizontal_large"
        app:layout_constraintBottom_toTopOf="@+id/create_route_length"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/FontMedium"/>
    <TextView
        android:textSize="@dimen/dimen_13sp"
        android:textColor="@color/text_color_80"
        android:id="@+id/create_route_length"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_10dp"
        android:layout_marginHorizontal="@dimen/page_padding_horizontal_large"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/create_route_name"
        style="@style/FontMedium"/>
    <com.xiaomi.fitness.widget.view.DividerView
        android:id="@+id/create_length_popularity_divider"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginHorizontal="8dp"
        app:isHorizontal="true"
        app:layout_constraintBottom_toBottomOf="@+id/create_route_length"
        app:layout_constraintStart_toEndOf="@+id/create_route_length"
        app:layout_constraintTop_toTopOf="@+id/create_route_length"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/shape_card_bg_f9f9f9"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_20dp"
        android:layout_marginBottom="20dp"
        android:layout_marginHorizontal="@dimen/page_padding_horizontal_large_cut_12_dp"
        android:paddingVertical="@dimen/dimen_margin_10dp"
        app:layout_constraintBottom_toTopOf="@+id/create_route_save"
        app:layout_constraintTop_toBottomOf="@+id/create_route_length">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dimen_13sp"
            android:textColor="@color/colorPrimary"
            android:id="@+id/create_navigation_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sport_navigate_start"
            android:drawablePadding="4dp"
            android:drawableStart="@drawable/orange_arrow_up"
            android:layout_marginEnd="@dimen/dimen_margin_12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/FontMedium"/>
        <com.xiaomi.fitness.widget.view.DividerView
            android:id="@+id/dividerView"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dimen_margin_20dp"
            android:layout_marginEnd="@dimen/dimen_margin_20dp"
            app:isHorizontal="true"
            app:layout_constraintBottom_toBottomOf="@+id/create_navigation_tv"
            app:layout_constraintEnd_toStartOf="@+id/create_navigation_tv"
            app:layout_constraintTop_toTopOf="@+id/create_navigation_tv"/>
        <RelativeLayout
            android:id="@+id/create_route_address_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_margin_12dp"
            app:layout_constraintBottom_toBottomOf="@+id/create_navigation_tv"
            app:layout_constraintEnd_toStartOf="@+id/dividerView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/create_navigation_tv">
            <TextView
                android:textSize="@dimen/dimen_12sp"
                android:textColor="@color/text_color_80"
                android:id="@+id/create_route_address_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/FontMedium.12sp"/>
            <TextView
                android:textColor="@color/text_color_60"
                android:id="@+id/distance_from_starting_point"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5.3dp"
                android:layout_below="@+id/create_route_address_tv"/>
        </RelativeLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="17sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/create_route_save"
        android:background="@drawable/selector_bottom_btn_positive_bg"
        android:layout_width="336dp"
        android:layout_height="48dp"
        android:text="@string/sport_finish_create_and_save"
        android:layout_centerInParent="true"
        android:fontFamily="@font/misanslatin_medium"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/FontMedium"/>
</androidx.constraintlayout.widget.ConstraintLayout>
