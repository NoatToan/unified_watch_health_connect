<?xml version="1.0" encoding="utf-8"?>
<miuix.springback.view.SpringBackLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/userinfo_fragment_first_aid_edit_0"
    android:background="@color/userinfo_windowBackground_light"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:scrollOrientation="angle|vertical"
    app:scrollableView="@+id/scroll_view">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:orientation="vertical"
            android:tag="binding_1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="@dimen/page_content_padding_horizontal_large">
            <com.xiaomi.fitness.userinfo.medicalid.baseui.AvatarNameView
                android:id="@+id/layout_avatar_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.xiaomi.fitness.userinfo.medicalid.baseui.GenderView
                android:id="@+id/layout_gender"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAccessibility="yes"/>
            <com.xiaomi.fitness.userinfo.medicalid.baseui.UserInfoRightArrowSingleLineTextView
                android:id="@+id/layout_birth"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAccessibility="yes"
                app:title="@string/userinfo_user_birthdate"/>
            <com.xiaomi.fitness.userinfo.medicalid.baseui.BloodTypeView
                android:id="@+id/layout_blood"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.xiaomi.fitness.userinfo.medicalid.baseui.OrganDonorView
                android:id="@+id/layout_donor"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAccessibility="yes"/>
            <com.xiaomi.fitness.userinfo.medicalid.baseui.EmergencyContactView
                android:id="@+id/layout_emergency"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAccessibility="yes"/>
            <com.xiaomi.fitness.userinfo.medicalid.baseui.UserInfoRightArrowSingleLineTextView
                android:id="@+id/layout_emergency_filled"
                android:focusable="true"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAccessibility="yes"/>
            <include layout="@layout/userinfo_layout_edit_item_divider"/>
            <com.xiaomi.fitness.userinfo.medicalid.baseui.TextFieldView
                android:id="@+id/layout_allergic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:title="@string/userinfo_allergic_drugs"/>
            <com.xiaomi.fitness.userinfo.medicalid.baseui.TextFieldView
                android:id="@+id/layout_chronic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:title="@string/userinfo_chronic"/>
            <com.xiaomi.fitness.userinfo.medicalid.baseui.TextFieldView
                android:id="@+id/layout_treatment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/userinfo_size_26_7"
                app:title="@string/userinfo_medication_and_treatment"/>
            <include
                android:id="@+id/lock_screen_divider"
                layout="@layout/userinfo_layout_edit_item_divider"/>
            <com.xiaomi.fitness.widget.SwitchButtonTwoLineTextView
                android:id="@+id/lock_screen_show_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/userinfo_size_29_43"
                app:subtitle="@string/userinfo_lock_screen_show_description"
                app:title="@string/userinfo_lock_screen_show"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</miuix.springback.view.SpringBackLayout>
