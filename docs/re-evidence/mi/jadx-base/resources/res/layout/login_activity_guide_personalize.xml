<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="20dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@+id/bt_enter_app"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/layout_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/login_size_36_3"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/personalize_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <FrameLayout
                        android:id="@+id/personal_frame_imag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <com.xiaomi.fitness.widget.view.RatioImageView
                            android:id="@+id/personalize_mode_img"
                            android:layout_width="@dimen/login_guide_person_mode_img_width"
                            android:layout_height="wrap_content"
                            android:scaleType="centerCrop"
                            app:ratio="0.5"
                            app:shapeAppearanceOverlay="@style/login_roundedCornerStyle"/>
                        <com.xiaomi.fitness.widget.view.RatioImageView
                            android:background="@drawable/login_btn_angle_frame"
                            android:layout_width="@dimen/login_guide_person_mode_img_width"
                            android:layout_height="wrap_content"
                            android:scaleType="centerCrop"
                            app:ratio="0.5"
                            app:shapeAppearanceOverlay="@style/login_roundedCornerStyle"/>
                    </FrameLayout>
                    <TextView
                        android:textColor="@color/login_color_main_vibrant_theme"
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/personalize_mode_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimen_margin_12dp"
                        android:text="@string/login_personalize_mode"
                        style="@style/FontNormal.14sp"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/concise_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dimen_margin_6dp">
                    <FrameLayout
                        android:id="@+id/concise_frame_imag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <com.xiaomi.fitness.widget.view.RatioImageView
                            android:id="@+id/concise_mode_img"
                            android:layout_width="@dimen/login_guide_person_mode_img_width"
                            android:layout_height="wrap_content"
                            android:scaleType="centerCrop"
                            app:ratio="0.5"
                            app:shapeAppearanceOverlay="@style/login_roundedCornerStyle"/>
                        <com.xiaomi.fitness.widget.view.RatioImageView
                            android:background="@drawable/login_btn_angle_frame"
                            android:layout_width="@dimen/login_guide_person_mode_img_width"
                            android:layout_height="wrap_content"
                            android:scaleType="centerCrop"
                            app:ratio="0.5"
                            app:shapeAppearanceOverlay="@style/login_roundedCornerStyle"/>
                    </FrameLayout>
                    <TextView
                        android:textColor="@color/login_color_main_vibrant_theme"
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/concise_mode_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimen_margin_12dp"
                        android:text="@string/login_concise_mode"
                        style="@style/FontNormal.14sp"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/layout_hint"
                android:background="@drawable/login_label_bg_gray"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_16dp"
                app:layout_constraintEnd_toEndOf="@+id/layout_mode"
                app:layout_constraintStart_toStartOf="@+id/layout_mode"
                app:layout_constraintTop_toBottomOf="@+id/layout_mode">
                <TextView
                    android:textSize="@dimen/login_font_12"
                    android:textColor="@color/login_black_40"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_margin_10dp"
                    android:text="@string/login_common_hint"
                    android:singleLine="true"
                    android:layout_marginStart="@dimen/dimen_margin_18dp"/>
                <TextView
                    android:textSize="@dimen/dimen_16sp"
                    android:textStyle="bold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_margin_10dp"
                    android:text="@string/login_concise_title"
                    android:singleLine="true"
                    android:layout_marginStart="@dimen/dimen_margin_18dp"/>
                <TextView
                    android:textSize="@dimen/dimen_12sp"
                    android:textColor="@color/login_black_40"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dimen_margin_18dp"
                    android:layout_marginTop="@dimen/dimen_margin_2dp"
                    android:layout_marginRight="@dimen/dimen_margin_18dp"
                    android:layout_marginBottom="@dimen/dimen_margin_20dp"
                    android:text="@string/login_concise_desc_sub"
                    android:singleLine="true"/>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/login_font_14"
                android:id="@+id/pass"
                android:visibility="gone"
                android:text="@string/login_common_skip"
                android:contentDescription="@string/login_common_skip"
                android:layout_marginStart="@dimen/login_size_25_5"
                app:layout_constraintStart_toStartOf="parent"
                style="@style/login_guide_subtitle_text"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <TextView
        android:id="@+id/bt_enter_app"
        android:layout_width="306dp"
        android:layout_marginBottom="@dimen/dimen_margin_26dp"
        android:text="@string/login_enter_app"
        android:layout_marginStart="@dimen/dimen_margin_26dp"
        android:layout_marginEnd="@dimen/dimen_margin_26dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/Button.FullWidth.Menstrual.Orange"/>
</androidx.constraintlayout.widget.ConstraintLayout>
