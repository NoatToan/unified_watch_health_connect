<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/ll_quality"
    android:paddingTop="@dimen/dimen_margin_18dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="12sp"
        android:textColor="@color/common_black"
        android:id="@+id/txt_sleep_quality_fraction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dimen_margin_18dp"
        android:paddingEnd="@dimen/dimen_margin_18dp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/common_black"
        android:id="@+id/txt_sleep_quality_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="19dp"
        android:paddingEnd="19dp"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/black_40"
        android:id="@+id/txt_sleep_quality_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"/>
    <View
        android:id="@+id/sleep_qulity_divider"
        android:background="@color/common_divider_color"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginTop="@dimen/dimen_margin_18dp"
        android:layout_marginStart="@dimen/dimen_margin_18dp"
        android:layout_marginEnd="@dimen/dimen_margin_18dp"/>
</LinearLayout>
