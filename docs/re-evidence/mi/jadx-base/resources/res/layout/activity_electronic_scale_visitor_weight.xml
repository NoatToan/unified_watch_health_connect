<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/activity_electronic_scale_visitor_weight_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.xiaomi.fitness.widget.view.RoundImageView
        android:id="@+id/visitor_photo"
        android:background="@drawable/electronic_scale_user_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/text_color_40"
        android:id="@+id/visitor_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:text="@string/electronic_scale_visitor_weight_info"
        android:layout_marginStart="25dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/visitor_photo"/>
    <com.xiaomi.fitness.widget.RightArrowBindingSingleLineTextView
        android:id="@+id/visitor_name"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/page_content_padding_horizontal_large"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/visitor_info"
        app:showMore="true"
        app:showRemind="true"
        app:title="@string/electronic_scale_visitor_name"/>
    <com.xiaomi.fitness.widget.RightArrowBindingSingleLineTextView
        android:id="@+id/visitor_sex"
        android:tag="binding_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/page_content_padding_horizontal_large"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/visitor_name"
        app:showMore="true"
        app:showRemind="true"
        app:title="@string/electronic_scale_sex"/>
    <com.xiaomi.fitness.widget.RightArrowBindingSingleLineTextView
        android:id="@+id/visitor_birthday"
        android:tag="binding_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/page_content_padding_horizontal_large"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/visitor_sex"
        app:showMore="true"
        app:showRemind="true"
        app:title="@string/electronic_scale_birthday"/>
    <com.xiaomi.fitness.widget.RightArrowBindingSingleLineTextView
        android:id="@+id/visitor_height"
        android:tag="binding_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/page_content_padding_horizontal_large"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/visitor_birthday"
        app:showMore="true"
        app:showRemind="true"
        app:title="@string/electronic_scale_height"/>
    <Button
        android:id="@+id/visitor_measure"
        android:layout_marginBottom="27dp"
        android:text="@string/electronic_scale_visitor_start_measure"
        android:alpha="0.6"
        android:layout_marginHorizontal="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/CommonBtn.Primary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
