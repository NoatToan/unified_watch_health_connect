<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/nfc_fragment_reiusse_master_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/watch_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="47dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.xiaomi.fitness.nfc.widget.CardImageView
            android:id="@+id/cardView"
            android:layout_width="match_parent"
            android:layout_height="186dp"/>
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true">
            <com.xiaomi.fitness.nfc.widget.DeviceImageView
                android:id="@+id/deviceView"
                android:layout_width="@dimen/nfc_device_icon_width"
                android:layout_height="@dimen/nfc_device_icon_width"/>
            <ProgressBar
                android:layout_gravity="center"
                android:id="@+id/progressView"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:indeterminateDrawable="@drawable/nfc_card_issuing_indeterminate"
                android:indeterminateDuration="2000"
                android:interpolator="@android:interpolator/accelerate_decelerate"/>
        </FrameLayout>
    </RelativeLayout>
    <TextView
        android:id="@+id/updateDescView"
        android:text="@string/nfc_bank_updating"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/watch_layout"
        style="@style/CommonBtn.Primary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
