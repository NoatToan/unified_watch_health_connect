<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/trail_time_item_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.Group
        android:id="@+id/label"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="label_duration,label_percent,label_type"/>
    <TextView
        android:id="@+id/label_type"
        android:text="@string/trail_label_type"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/TrailTimeLabel"/>
    <TextView
        android:id="@+id/label_percent"
        android:text="@string/trail_label_percent"
        app:layout_constraintBottom_toBottomOf="@+id/label_type"
        app:layout_constraintStart_toStartOf="@+id/percent_view"
        app:layout_constraintTop_toTopOf="@+id/label_type"
        style="@style/TrailTimeLabel"/>
    <TextView
        android:id="@+id/label_duration"
        android:text="@string/trail_label_time"
        app:layout_constraintBottom_toBottomOf="@+id/label_type"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/label_type"
        style="@style/TrailTimeLabel"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/trail_black_90white"
        android:id="@+id/name_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        android:maxWidth="@dimen/trail_name_max"
        android:textDirection="locale"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/label_type"
        app:layout_goneMarginTop="0dp"
        style="@style/FontMedium"/>
    <com.xiaomi.fitness.trail.widget.TimePercentView
        android:id="@+id/percent_view"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_marginStart="88dp"
        android:layout_marginEnd="100dp"
        app:layout_constraintBottom_toBottomOf="@+id/name_view"
        app:layout_constraintStart_toEndOf="@+id/name_view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/name_view"/>
    <TextView
        android:textSize="@dimen/dimen_13sp"
        android:textColor="@color/trail_black_90white"
        android:gravity="end"
        android:id="@+id/duration_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textDirection="locale"
        app:layout_constraintBottom_toBottomOf="@+id/name_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/name_view"
        style="@style/FontLatinMedium"/>
</androidx.constraintlayout.widget.ConstraintLayout>
