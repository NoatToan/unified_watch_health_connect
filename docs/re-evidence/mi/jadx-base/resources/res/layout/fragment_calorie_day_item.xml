<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/step_container"
    android:tag="layout/fragment_calorie_day_item_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.xiaomi.fitness.chart.view.BarChartRecyclerView
            android:id="@+id/recycler"
            app:barChartMaxWidth="@dimen/size_3"
            app:barChartRoundRectRadiusRatio="0.25"
            app:chartColor="@color/health_calorie_chart"
            app:displayNumbers="48"
            app:enableEndDayXAxis="true"
            app:enableStartYAxisLabel="false"
            style="@style/ChartBaseStyle"/>
        <com.xiaomi.fitness.view.DataTitleView
            android:id="@+id/dataTitleView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_calorie_detail"
        android:background="@drawable/shape_data_item_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size_10"
        android:overScrollMode="never"
        android:layout_marginHorizontal="@dimen/health_detail_page_common_margin_horizontal"/>
    <com.xiaomi.fitness.view.CardUnderstandView
        android:id="@+id/understandCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_12"
        android:layout_marginHorizontal="@dimen/health_detail_page_common_margin_horizontal"
        app:txtUnderstand="@string/health_calories_understand"/>
</LinearLayout>
