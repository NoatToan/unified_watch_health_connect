<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/trail_layout_sport_report_just_dance_data_item_0"
    android:background="@drawable/sport_detail_report_just_dance_data_item_bg"
    android:padding="@dimen/page_extra_padding_horizontal_large"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/dimen_margin_10dp">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/just_dance_cover_iv"
        android:layout_width="@dimen/dimen_margin_50dp"
        android:layout_height="@dimen/dimen_margin_50dp"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/text_color"
        android:ellipsize="end"
        android:id="@+id/just_dance_name_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="250dp"
        android:singleLine="true"
        android:layout_marginStart="@dimen/dimen_margin_16dp"
        app:layout_constraintBottom_toTopOf="@+id/just_dance_singer_tv"
        app:layout_constraintStart_toEndOf="@+id/just_dance_cover_iv"
        app:layout_constraintTop_toTopOf="@+id/just_dance_cover_iv"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/text_color_40"
        android:ellipsize="end"
        android:id="@+id/just_dance_singer_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="250dp"
        android:singleLine="true"
        android:layout_marginStart="@dimen/dimen_margin_16dp"
        app:layout_constraintBottom_toBottomOf="@+id/just_dance_cover_iv"
        app:layout_constraintStart_toEndOf="@+id/just_dance_cover_iv"
        app:layout_constraintTop_toBottomOf="@+id/just_dance_name_tv"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/text_color"
        android:id="@+id/just_dance_score_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_10dp"
        app:layout_constraintStart_toStartOf="@+id/just_dance_cover_iv"
        app:layout_constraintTop_toBottomOf="@+id/just_dance_cover_iv"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/text_color_40"
        android:id="@+id/just_dance_score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/trail_sports_report_just_dance_score"
        app:layout_constraintStart_toStartOf="@+id/just_dance_score_tv"
        app:layout_constraintTop_toBottomOf="@+id/just_dance_score_tv"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/text_color_40"
        android:id="@+id/just_dance_calorie"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/trail_sports_report_just_dance_calorie"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/just_dance_calorie_tv"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/text_color"
        android:id="@+id/just_dance_calorie_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_10dp"
        app:layout_constraintStart_toStartOf="@+id/just_dance_calorie"
        app:layout_constraintTop_toBottomOf="@+id/just_dance_cover_iv"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/text_color_60"
        android:id="@+id/just_dance_calorie_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="kcal"
        android:layout_marginStart="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/just_dance_calorie_tv"
        app:layout_constraintStart_toEndOf="@+id/just_dance_calorie_tv"/>
    <com.xiaomi.fitness.detail.view.JustDanceScoreLevelView
        android:id="@+id/just_dance_score_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="80dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/just_dance_calorie_tv"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/text_color_40"
        android:id="@+id/trail_sports_report_just_dance_level"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/trail_sports_report_just_dance_level"
        android:layout_marginEnd="50dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/just_dance_calorie"/>
</androidx.constraintlayout.widget.ConstraintLayout>
