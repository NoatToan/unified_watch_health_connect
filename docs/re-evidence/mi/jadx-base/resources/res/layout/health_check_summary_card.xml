<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/summary_card"
        android:background="@drawable/common_card_bg_white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/page_padding_horizontal_large"
        android:paddingVertical="@dimen/margin_20dp">
        <TextView
            android:textSize="@dimen/font_18"
            android:textColor="@color/text_color"
            android:id="@+id/title_check_count_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dimen_margin_20dp"
            style="@style/FontMedium"/>
        <TextView
            android:textSize="@dimen/dialog_text_size_30"
            android:textColor="@color/text_color"
            android:id="@+id/title_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/FontDemiBold"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/riskDetailLayout"
            android:background="@drawable/health_check_risk_card_gradient_background"
            android:padding="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_12dp"
            android:layout_marginStart="-6dp">
            <TextView
                android:id="@+id/riskCountTV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/FontMedium"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/risk_items_recycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_14dp"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/dimen_14sp"
            android:textColor="@color/text_color"
            android:id="@+id/suggestion_des"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_20dp"
            style="@style/FontRegular"/>
    </LinearLayout>
    <TextView
        android:textColor="@color/text_color"
        android:id="@+id/abnormal_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_26dp"
        android:text="@string/health_check_abnormal_items"
        android:layout_marginStart="@dimen/dimen_margin_12dp"
        style="@style/FontMedium.18sp"/>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="vertical"
        android:id="@+id/abnormal_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_12dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
    <TextView
        android:textColor="@color/text_color"
        android:id="@+id/summary_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_26dp"
        android:text="@string/health_check_normal_items"
        android:layout_marginStart="@dimen/dimen_margin_12dp"
        style="@style/FontMedium.18sp"/>
</LinearLayout>
