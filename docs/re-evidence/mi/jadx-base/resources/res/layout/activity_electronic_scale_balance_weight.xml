<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_electronic_scale_balance_weight_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/weight_measure"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/balance_layout"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="40sp"
                android:textColor="@color/text_color"
                android:id="@+id/guide_weight_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="0.0"
                android:layout_marginStart="25dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/text_color"
                android:id="@+id/guide_time_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/electronic_scale_balanced_measure_seconds"
                android:layout_marginStart="5dp"
                app:layout_constraintBaseline_toBaselineOf="@+id/guide_weight_time"
                app:layout_constraintBottom_toBottomOf="@+id/guide_weight_time"
                app:layout_constraintStart_toEndOf="@+id/guide_weight_time"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/tv_balance_des"
            android:layout_below="@+id/balance_layout">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/electronic_scale_icon_balance_guide"
                android:scaleType="centerInside"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/black_60"
            android:gravity="center"
            android:id="@+id/tv_balance_des"
            android:paddingBottom="60dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/electronic_scale_balanced_measure_intro"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:paddingHorizontal="20dp"/>
    </RelativeLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/weight_result"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="40sp"
            android:textColor="@color/text_color"
            android:id="@+id/result_weight_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="0.0"
            android:layout_marginStart="25dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/text_color"
            android:id="@+id/result_time_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/electronic_scale_balanced_measure_seconds"
            android:layout_marginStart="5dp"
            app:layout_constraintBaseline_toBaselineOf="@+id/result_weight_time"
            app:layout_constraintBottom_toBottomOf="@+id/result_weight_time"
            app:layout_constraintStart_toEndOf="@+id/result_weight_time"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/text_color_40"
            android:id="@+id/result_balance_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/electronic_scale_balanced_measure_time"
            app:layout_constraintStart_toStartOf="@+id/result_weight_time"
            app:layout_constraintTop_toBottomOf="@+id/result_time_unit"/>
        <RelativeLayout
            android:id="@+id/result_balance_rl"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:layout_marginHorizontal="30dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/result_balance_desc">
            <com.xiaomi.fitness.electronic.scale.widget.sliding.BodyIndexSlidingViewV2
                android:id="@+id/result_balance_img"
                android:layout_width="match_parent"
                android:layout_height="123dp"
                app:color_circle_radius="16dp"
                app:color_height="20dp"
                app:show_text_color="true"
                app:text_color="@color/text_color"
                app:text_color_circle_radius="2dp"
                app:text_color_height="10dp"
                app:text_offset="10dp"
                app:text_size="12sp"/>
            <ImageView
                android:id="@+id/result_balance_iv"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginTop="43dp"
                android:src="@drawable/arrow_down_barlevel"/>
        </RelativeLayout>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/text_color"
            android:gravity="start"
            android:id="@+id/result_balance_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="50dp"
            android:text="@string/electronic_scale_balanced_title"
            android:layout_marginStart="30dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/result_balance_rl"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/text_color_40"
            android:id="@+id/result_balance_result"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/electronic_scale_balanced_measure_result_desc"
            android:layout_marginHorizontal="30dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/result_balance_title"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
