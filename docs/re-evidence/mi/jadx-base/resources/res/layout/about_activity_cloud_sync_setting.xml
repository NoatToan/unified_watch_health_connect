<?xml version="1.0" encoding="utf-8"?>
<miuix.springback.view.SpringBackLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/about_activity_cloud_sync_setting_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:scrollableView="@+id/spring_back_target">
    <miuix.core.widget.NestedScrollView
        android:id="@+id/spring_back_target"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:background="@color/about_white"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="@dimen/page_content_padding_horizontal_large">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_sync_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.xiaomi.fitness.widget.SwitchButtonBindingSingleLineTextView
                    android:id="@+id/health_service"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:title="@string/about_open_port_health_service"/>
                <RelativeLayout
                    android:id="@+id/rl_sync_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/about_dimen_margin_70dp">
                    <TextView
                        android:textSize="@dimen/about_font_15_7"
                        android:textColor="@color/about_black"
                        android:gravity="start"
                        android:id="@+id/tv_sync_status_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/about_size_15_3"
                        android:text="@string/about_sync_status"
                        android:layout_marginEnd="@dimen/about_size_8"
                        android:layout_toStartOf="@+id/tv_sync_action"
                        android:layout_alignParentStart="true"
                        style="@style/TextAppearance.MiuiBold"/>
                    <TextView
                        android:textSize="@dimen/about_font_12_7"
                        android:textColor="@color/about_common_secondary_summary_color"
                        android:gravity="start"
                        android:id="@+id/tv_sync_status_detail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/tv_sync_status_label"
                        android:layout_toStartOf="@+id/tv_sync_action"
                        android:layout_alignStart="@+id/tv_sync_status_label"/>
                    <TextView
                        android:textSize="@dimen/about_size_12_67"
                        android:id="@+id/tv_sync_action"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="@dimen/dimen_margin_18dp"
                        android:layout_alignParentEnd="true"
                        style="@style/Button.EndButton"/>
                    <ImageView
                        android:id="@+id/iv_sync"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_sync_process"
                        android:layout_centerVertical="true"
                        android:layout_alignParentEnd="true"/>
                </RelativeLayout>
            </LinearLayout>
            <View
                android:id="@+id/divider_line"
                android:background="@color/about_item_divide_color"
                android:layout_width="match_parent"
                android:layout_height="@dimen/about_item_divide_height"
                android:layout_marginTop="@dimen/about_size_20"
                android:layout_marginBottom="@dimen/about_size_35"/>
            <TextView
                android:textSize="@dimen/about_font_12"
                android:textColor="@color/about_common_secondary_summary_color"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/about_setting_data_cloud_sync_tip"/>
        </LinearLayout>
    </miuix.core.widget.NestedScrollView>
</miuix.springback.view.SpringBackLayout>
