<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/mine_function_card_view_0"
    android:background="@drawable/mine_label_bg_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/page_extra_padding_horizontal_large">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/function_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/text_color"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/function_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:lines="1"
            android:layout_marginEnd="6dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/FontDemiBold"/>
        <ImageView
            android:id="@+id/function_remind_view"
            android:visibility="gone"
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:src="@drawable/mine_week_report_remind_icon"
            android:layout_marginEnd="-4dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="@+id/function_des"
            app:layout_constraintTop_toTopOf="@+id/function_des"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/text_color_40"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/function_des"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_4dp"
            android:lines="1"
            android:layout_marginEnd="6dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/function_name"
            style="@style/FontRegular"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/function_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
