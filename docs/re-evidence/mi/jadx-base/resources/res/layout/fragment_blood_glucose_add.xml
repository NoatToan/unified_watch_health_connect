<?xml version="1.0" encoding="utf-8"?>
<miuix.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll_view"
    android:tag="layout/fragment_blood_glucose_add_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/rl_blood_glucose"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_53_3"
            android:paddingStart="@dimen/page_content_padding_horizontal_large"
            android:paddingEnd="@dimen/page_content_padding_horizontal_large">
            <ImageView
                android:id="@+id/iv_blood_glucose_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_right_arrow"
                android:layout_centerVertical="true"
                android:importantForAccessibility="no"
                android:layout_alignParentEnd="true"/>
            <TextView
                android:id="@+id/tv_blood_glucose_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/health_blood_glucose"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"
                style="@style/PreferenceItem.Title"/>
            <TextView
                android:gravity="end"
                android:id="@+id/tv_blood_glucose_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:paddingEnd="@dimen/size_8"
                android:layout_toStartOf="@+id/iv_blood_glucose_arrow"
                android:layout_toEndOf="@+id/tv_blood_glucose_label"
                style="@style/PreferenceItem.Content"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_record_time"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_53_3"
            android:paddingStart="@dimen/page_content_padding_horizontal_large"
            android:paddingEnd="@dimen/page_content_padding_horizontal_large">
            <ImageView
                android:id="@+id/iv_record_time_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_right_arrow"
                android:layout_centerVertical="true"
                android:importantForAccessibility="no"
                android:layout_alignParentEnd="true"/>
            <TextView
                android:id="@+id/tv_record_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/health_weight_measure_time"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"
                style="@style/PreferenceItem.Title"/>
            <TextView
                android:gravity="end"
                android:id="@+id/tv_record_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:paddingEnd="@dimen/size_8"
                android:layout_toStartOf="@+id/iv_record_time_arrow"
                android:layout_toEndOf="@+id/tv_record_label"
                style="@style/PreferenceItem.Content"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_meal_time"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_53_3"
            android:paddingStart="@dimen/page_content_padding_horizontal_large"
            android:paddingEnd="@dimen/page_content_padding_horizontal_large">
            <ImageView
                android:id="@+id/iv_meal_time_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_right_arrow"
                android:layout_centerVertical="true"
                android:importantForAccessibility="no"
                android:layout_alignParentEnd="true"/>
            <TextView
                android:id="@+id/tv_meal_time_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/health_blood_glucose_add_time"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"
                style="@style/PreferenceItem.Title"/>
            <TextView
                android:gravity="end"
                android:id="@+id/tv_meal_time_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:paddingEnd="@dimen/size_8"
                android:layout_toStartOf="@+id/iv_meal_time_arrow"
                android:layout_toEndOf="@+id/tv_meal_time_label"
                style="@style/PreferenceItem.Content"/>
        </RelativeLayout>
    </LinearLayout>
</miuix.core.widget.NestedScrollView>
