<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/main_container"
    android:tag="layout/health_layout_expandable_common_data_0"
    android:background="@drawable/selector_card_bg"
    android:paddingTop="@dimen/size_17_3"
    android:paddingBottom="@dimen/size_17_3"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="26.67dp">
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:textColor="@color/text_color"
            android:gravity="start"
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autoSizeTextType="uniform"
            android:autoSizeMaxTextSize="14sp"
            style="@style/FontMedium.14sp"/>
        <com.google.android.flexbox.FlexboxLayout
            android:id="@+id/flex_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:flexWrap="wrap">
            <TextView
                android:textColor="@color/text_color_40"
                android:gravity="start"
                android:id="@+id/tv_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:paddingEnd="@dimen/size_2"
                android:autoSizeTextType="uniform"
                style="@style/FontRegular.12sp"/>
            <TextView
                android:id="@+id/tv_abnormal"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/HealthCardTextAbnormal"/>
        </com.google.android.flexbox.FlexboxLayout>
    </LinearLayout>
    <TextView
        android:textSize="12.6sp"
        android:textStyle="bold"
        android:textColor="@color/text_color_40"
        android:gravity="end"
        android:layout_gravity="center_vertical"
        android:id="@+id/tv_end"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_weight="1"
        style="@style/FontRegular"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/iv_arrow"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/ic_base_right_arrow_icon"
        android:importantForAccessibility="no"/>
</LinearLayout>
