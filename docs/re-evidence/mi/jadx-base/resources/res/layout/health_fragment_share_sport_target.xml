<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/health_fragment_share_sport_target_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingHorizontal="@dimen/page_content_padding_horizontal_large"
        app:layout_constraintBottom_toTopOf="@+id/bottomView"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.cardview.widget.CardView
                android:id="@+id/bgContainnerView"
                android:background="@color/transparent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardPreventCornerOverlap="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/bgView"
                    android:background="@color/text_revert_color"
                    android:layout_width="match_parent"
                    android:layout_height="386.6953dp">
                    <ImageView
                        android:id="@+id/imageView"
                        android:background="@color/text_revert_color"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitXY"/>
                    <com.xiaomi.fitness.health.threetarget.view.ShareAccountInfoView
                        android:id="@+id/accountInfoView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="23dp"
                        android:layout_marginStart="22dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <com.xiaomi.fitness.health.threetarget.view.ShareSportTargetDataInfoView
                        android:id="@+id/otherDataView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="13dp"
                        android:layout_marginStart="22dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>
                    <com.xiaomi.fitness.health.threetarget.view.ShareSportTargetDataInfoView
                        android:id="@+id/stepDataView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="13dp"
                        app:layout_constraintBottom_toTopOf="@+id/otherDataView"
                        app:layout_constraintStart_toStartOf="@+id/otherDataView"/>
                    <com.xiaomi.fitness.health.threetarget.view.ShareSportTargetDataInfoView
                        android:id="@+id/kaluliDataView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="13dp"
                        android:layout_alignParentStart="true"
                        app:layout_constraintBottom_toTopOf="@+id/stepDataView"
                        app:layout_constraintStart_toStartOf="@+id/stepDataView"/>
                    <com.xiaomi.fitness.health.threetarget.model.ThreeTargetView
                        android:id="@+id/targetView"
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="3dp"
                        android:layout_marginEnd="22dp"
                        app:layout_constraintBottom_toBottomOf="@+id/otherDataView"
                        app:layout_constraintEnd_toEndOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/text_color_60"
                android:id="@+id/bgTxtView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="@string/health_share_sport_target_day_bg"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/bgContainnerView"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/selectView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/bgTxtView"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <include
        android:id="@+id/bottomView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/page_padding_horizontal_large"
        app:layout_constraintBottom_toBottomOf="parent"
        layout="@layout/health_view_share_bottom_operation_view"/>
</androidx.constraintlayout.widget.ConstraintLayout>
