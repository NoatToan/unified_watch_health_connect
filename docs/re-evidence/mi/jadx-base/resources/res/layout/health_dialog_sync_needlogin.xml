<?xml version="1.0" encoding="utf-8"?>
<miuix.springback.view.SpringBackLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:scrollableView="@+id/spring_back_target">
    <miuix.core.widget.NestedScrollView
        android:id="@+id/spring_back_target"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="@dimen/size_20"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:gravity="center"
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/health_sync_needlogin_title"
                android:layout_marginStart="@dimen/size_26_6"
                android:layout_marginEnd="@dimen/size_26_6"
                style="@style/FontMedium.14sp"/>
            <TextView
                android:id="@+id/desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_10"
                android:text="@string/health_sync_needlogin_desc"
                android:layout_marginStart="@dimen/size_26_6"
                android:layout_marginEnd="@dimen/size_26_6"
                style="@style/FontRegular.14sp"/>
            <com.xiaomi.fitness.view.UnderstandItemView
                android:id="@+id/uiv_sleep_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_20"
                app:understand_detail="@string/health_sync_dialog_desc1"
                app:understand_title="@string/health_sync_dialog_title1"/>
            <com.xiaomi.fitness.view.UnderstandItemView
                android:id="@+id/uiv_sleep_distribute"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_20"
                app:understand_detail="@string/health_sync_dialog_desc2"
                app:understand_title="@string/health_sync_dialog_title2"/>
            <com.xiaomi.fitness.view.UnderstandItemView
                android:id="@+id/uiv_sleep_light"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_20"
                app:understand_detail="@string/health_sync_dialog_desc3"
                app:understand_title="@string/health_sync_dialog_title3"/>
        </LinearLayout>
    </miuix.core.widget.NestedScrollView>
</miuix.springback.view.SpringBackLayout>
