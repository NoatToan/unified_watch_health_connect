<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/request_wifi_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_margin_40dp"
        android:layout_marginEnd="@dimen/dimen_margin_40dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/FontNormal.16sp"/>
    <EditText
        android:id="@+id/identity_user_name"
        android:background="@drawable/sync_wifi_input"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/sync_user_name"
        android:maxLength="30"
        android:paddingStart="13dp"
        android:paddingEnd="13dp"
        android:layout_marginStart="@dimen/dimen_margin_16dp"
        android:layout_marginEnd="@dimen/dimen_margin_16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/request_wifi_title"/>
    <EditText
        android:id="@+id/wifi_password"
        android:background="@drawable/sync_wifi_input"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/sync_password"
        android:maxLength="30"
        android:inputType="textVisiblePassword"
        android:paddingStart="13dp"
        android:paddingEnd="13dp"
        android:layout_marginStart="@dimen/dimen_margin_26dp"
        android:layout_marginEnd="@dimen/dimen_margin_26dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/identity_user_name"/>
    <Button
        android:id="@+id/cancel_button"
        android:layout_width="146dp"
        android:layout_height="46dp"
        android:layout_marginTop="23dp"
        android:text="@string/cancel"
        android:layout_marginStart="26dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/wifi_password"
        style="@style/CommonBtn.Normal"/>
    <Button
        android:id="@+id/confirm_button"
        android:layout_width="146dp"
        android:layout_height="46dp"
        android:layout_marginTop="23dp"
        android:text="@string/confirm"
        android:layout_marginEnd="@dimen/dimen_margin_26dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/wifi_password"
        style="@style/CommonBtn.Primary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
