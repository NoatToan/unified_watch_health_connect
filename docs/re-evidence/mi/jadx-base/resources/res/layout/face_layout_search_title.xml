<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/face_layout_search_title_0"
    android:background="@color/app_4_0_bg_color"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/back_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_base_back"
        android:layout_marginVertical="@dimen/dimen_margin_10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.xiaomi.fitness.baseui.dialog.ClearEditText
        android:textSize="@dimen/dimen_15sp"
        android:textColor="@color/dialog_text_color"
        android:id="@+id/edit_text"
        android:background="@drawable/face_bg_search_edit_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:drawableLeft="@drawable/face_search_icon"
        android:drawableRight="@drawable/face_search_clear"
        android:drawablePadding="7dp"
        android:textCursorDrawable="@drawable/face_shape_search_cursor"
        android:layout_marginStart="@dimen/dimen_margin_12dp"
        android:layout_marginEnd="@dimen/dimen_margin_12dp"
        android:paddingHorizontal="@dimen/dimen_margin_15dp"
        android:paddingVertical="@dimen/dimen_margin_10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/search"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/back_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="@dimen/dimen_margin_16dp"/>
    <TextView
        android:enabled="false"
        android:textSize="@dimen/dimen_15sp"
        android:textColor="@color/face_market_search_disable"
        android:id="@+id/search"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/face_market_search_text"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/FontMedium"/>
</androidx.constraintlayout.widget.ConstraintLayout>
