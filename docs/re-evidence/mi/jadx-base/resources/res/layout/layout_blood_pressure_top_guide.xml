<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:paddingTop="@dimen/size_6"
    android:paddingBottom="@dimen/size_4"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="center_vertical"
        android:background="@drawable/shape_blood_pressure_high"
        android:layout_width="@dimen/size_10"
        android:layout_height="@dimen/size_10"
        android:layout_marginStart="@dimen/chart_common_padding_start"/>
    <TextView
        android:textColor="@color/text_color_40"
        android:gravity="start"
        android:layout_gravity="center_vertical"
        android:layout_width="@dimen/health_top_guide_indicator_text_width"
        android:layout_height="wrap_content"
        android:text="@string/health_blood_pressure_high_pressure2"
        android:paddingStart="@dimen/size_6"
        android:paddingEnd="@dimen/size_10"
        style="@style/FontRegular.12sp"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:background="@drawable/shape_blood_pressure_low"
        android:layout_width="@dimen/size_10"
        android:layout_height="@dimen/size_10"/>
    <TextView
        android:textColor="@color/text_color_40"
        android:layout_gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/health_blood_pressure_low_pressure2"
        android:layout_marginStart="@dimen/size_6"
        android:layout_marginEnd="@dimen/size_18"
        style="@style/FontRegular.12sp"/>
</LinearLayout>
