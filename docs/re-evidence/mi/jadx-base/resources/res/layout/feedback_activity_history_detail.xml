<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/feedback_activity_history_detail_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="@dimen/dimen_margin_12dp"
    android:paddingStart="@dimen/page_content_padding_horizontal_large"
    android:paddingEnd="@dimen/page_content_padding_horizontal_large">
    <TextView
        android:ellipsize="end"
        android:id="@+id/feedback_tv_detail_title"
        android:tag="binding_1"
        android:paddingTop="@dimen/dimen_margin_12dp"
        android:paddingBottom="@dimen/dimen_margin_12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        style="@style/FontDemiBold.18sp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="@dimen/dimen_margin_9dp"
        android:paddingBottom="@dimen/dimen_margin_9dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textColor="@color/feedback_black_60"
            android:id="@+id/feedback_tv_detail_num"
            android:tag="binding_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/FontMedium.14sp"/>
        <TextView
            android:textSize="@dimen/font_12"
            android:textColor="@color/colorPrimary"
            android:id="@+id/feedback_tv_detail_num_copy"
            android:background="@drawable/shape_btn_bg_ff612e"
            android:paddingTop="@dimen/dimen_margin_3dp"
            android:paddingBottom="@dimen/dimen_margin_3dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/feedback_copy"
            android:paddingStart="@dimen/dimen_margin_14dp"
            android:paddingEnd="@dimen/dimen_margin_14dp"
            android:layout_marginStart="@dimen/dimen_margin_8dp"/>
        <TextView
            android:textSize="@dimen/font_15_3"
            android:textColor="@color/colorPrimary"
            android:gravity="end|center_vertical"
            android:id="@+id/feedback_tv_detail_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/feedback_status_submitted_fb"
            android:layout_weight="1"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:tag="binding_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_20dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
</LinearLayout>
