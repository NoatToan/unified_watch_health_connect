<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutView"
    android:tag="layout/nfc_fragment_cloud_door_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/nfc_common_title_left_margin"
    android:paddingEnd="@dimen/nfc_common_title_left_margin">
    <FrameLayout
        android:paddingTop="@dimen/nfc_common_content_miui_title_margin"
        android:paddingBottom="@dimen/nfc_tsm_watch_icon_padding_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.xiaomi.fitness.nfc.widget.DeviceImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/deviceView"
            android:layout_width="@dimen/nfc_device_icon_width"
            android:layout_height="@dimen/nfc_device_icon_height"/>
        <com.xiaomi.fitness.nfc.widget.InnerCardImageView
            android:id="@+id/cardView"
            android:layout_width="86.4dp"
            android:layout_height="48.6dp"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:paddingBottom="@dimen/nfc_common_content_miui_title_margin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <TextView
            android:id="@+id/removeBackupView"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="0dp"
            android:text="@string/nfc_backup_door_delete_from_server"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp"
            style="@style/CommonBtn.Normal"/>
        <TextView
            android:id="@+id/issueView"
            android:visibility="gone"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="0dp"
            android:text="@string/nfc_backup_door_issue"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp"
            style="@style/CommonBtn.Primary"/>
    </LinearLayout>
</RelativeLayout>
