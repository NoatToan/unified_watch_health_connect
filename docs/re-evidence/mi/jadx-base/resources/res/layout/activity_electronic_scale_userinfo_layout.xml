<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/layout_root"
    android:tag="layout/activity_electronic_scale_userinfo_layout_0"
    android:background="@color/page_white_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="32sp"
        android:textColor="@color/electronic_scale_weight_black"
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:text="@string/electronic_scale_userinfo_personal_info"
        android:fontFamily="@font/misanslatin_regular"
        android:layout_marginStart="@dimen/page_content_padding_horizontal_large"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/text_color_40"
        android:gravity="center"
        android:id="@+id/tv_sub_title"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/electronic_scale_userinfo_personal_info_sub"
        android:layout_marginStart="@dimen/page_content_padding_horizontal_large"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="horizontal"
        android:id="@+id/layout_user"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/page_content_padding_horizontal_large"
        app:layout_constraintTop_toBottomOf="parent">
        <com.xiaomi.fitness.widget.view.RoundImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/user_photo"
            android:layout_width="@dimen/electronic_scale_size_46"
            android:layout_height="@dimen/electronic_scale_size_46"
            android:layout_marginTop="@dimen/dimen_margin_20dp"
            android:layout_marginBottom="@dimen/dimen_margin_20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_margin_16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/user_photo"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textColor="@color/electronic_scale_weight_black"
                android:ellipsize="end"
                android:gravity="start"
                android:id="@+id/user_name"
                android:layout_width="208dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textDirection="locale"
                style="@style/FontMedium.16sp"/>
            <TextView
                android:textSize="@dimen/text_size_12"
                android:textColor="@color/text_color_40"
                android:id="@+id/user_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_2dp"
                android:fontFamily="mipro"
                style="@style/FontRegular.12sp"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="@dimen/page_content_padding_horizontal_large">
        <com.xiaomi.fitness.widget.RightArrowSingleLineTextView
            android:id="@+id/line_sex"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:remindTextEnable="true"
            app:showRemind="false"/>
        <com.xiaomi.fitness.widget.RightArrowSingleLineTextView
            android:id="@+id/line_birthday"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:remindTextEnable="true"
            app:showRemind="false"/>
        <com.xiaomi.fitness.widget.RightArrowSingleLineTextView
            android:id="@+id/line_height"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:remindTextEnable="true"
            app:showRemind="false"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <Button
            android:id="@+id/btn_info_ok"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/page_content_padding_horizontal_large"
            android:text="@string/electronic_scale_config_wifi_finish"/>
    </LinearLayout>
</LinearLayout>
