<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:tag="layout/calendar_course_item_0"
    android:background="@drawable/ability_course_item_shape"
    android:layout_width="match_parent"
    android:layout_height="70dp">
    <ImageView
        android:id="@+id/courseTypeBadage"
        android:layout_width="6dp"
        android:layout_height="match_parent"
        android:src="@drawable/course_left_running_indicator"/>
    <RelativeLayout
        android:gravity="center_vertical"
        android:id="@+id/courseInfoRoot"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/dimen_margin_17dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/courseTypeLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_alignParentStart="true">
            <TextView
                android:textSize="16dp"
                android:id="@+id/courseType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="轻松跑"
                android:fontFamily="@font/misanslatin_medium"/>
            <TextView
                android:textSize="16dp"
                android:id="@+id/courseStrength"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EM强度"
                android:fontFamily="@font/misanslatin_medium"
                android:layout_marginStart="@dimen/dimen_margin_6dp"/>
            <TextView
                android:textSize="11dp"
                android:textColor="#08c59a"
                android:id="@+id/courseStatus"
                android:background="@drawable/ability_course_finished_bg"
                android:paddingTop="@dimen/dimen_margin_2dp"
                android:paddingBottom="@dimen/dimen_margin_2dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/training_plan_ability_course_finished_tip"
                android:fontFamily="@font/misanslatin_medium"
                android:paddingStart="@dimen/dimen_margin_8dp"
                android:paddingEnd="@dimen/dimen_margin_8dp"
                android:layout_marginStart="@dimen/dimen_margin_12dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/abilityDurationLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_5dp"
            android:layout_below="@+id/courseTypeLayout">
            <TextView
                android:textSize="13dp"
                android:textColor="@color/text_color_60"
                android:id="@+id/courseTypeInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/misanslatin_regular"/>
            <TextView
                android:textSize="13dp"
                android:textColor="@color/text_color_60"
                android:id="@+id/duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/misanslatin_regular"
                android:layout_marginStart="5dp"/>
        </LinearLayout>
    </RelativeLayout>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/text_color_40"
        android:id="@+id/restTip"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/training_plan_rest_day"
        android:fontFamily="@font/misanslatin_regular"
        android:layout_marginStart="@dimen/dimen_margin_17dp"/>
    <View
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"/>
    <TextView
        android:textSize="14dp"
        android:id="@+id/courseAction"
        android:background="@drawable/ability_course_action"
        android:paddingTop="@dimen/dimen_margin_6dp"
        android:paddingBottom="@dimen/dimen_margin_6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="查看报告"
        android:fontFamily="@font/misanslatin_medium"
        android:paddingStart="@dimen/dimen_margin_18dp"
        android:paddingEnd="@dimen/dimen_margin_18dp"
        android:layout_marginEnd="@dimen/dimen_margin_12dp"/>
</LinearLayout>
