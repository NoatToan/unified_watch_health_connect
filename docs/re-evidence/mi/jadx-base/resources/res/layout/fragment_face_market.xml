<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/refresh_view"
    android:tag="layout/fragment_face_market_0"
    android:background="@color/face_detail_page_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent">
    <com.xiaomi.fitness.watch.face.widget.StateLayout
        android:id="@+id/state_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.xiaomi.fitness.baseui.recyclerview.MoreRecyclerView
            android:id="@+id/mRecyclerView"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="@dimen/page_padding_horizontal_large"
            app:loadMoreThreshold="0"/>
    </com.xiaomi.fitness.watch.face.widget.StateLayout>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
