<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/health_layout_sleep_animal_schedule_suggest_0"
    android:background="@drawable/shape_data_item_bg"
    android:paddingTop="@dimen/size_22"
    android:paddingBottom="@dimen/size_25"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/size_15"
    android:paddingEnd="@dimen/size_18">
    <include
        android:id="@+id/layout_common_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="-18dp"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/layout_common_icon_title"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_schedule"
        android:layout_width="273dp"
        android:layout_height="273dp"
        android:layout_marginTop="16dp"
        android:scaleType="fitXY"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_common_title"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_schedule_animal"
        android:layout_width="80dp"
        android:layout_height="233dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_schedule"
        app:layout_constraintEnd_toEndOf="@+id/iv_schedule"
        app:layout_constraintStart_toStartOf="@+id/iv_schedule"
        app:layout_constraintTop_toTopOf="@+id/iv_schedule"
        app:srcCompat="@drawable/health_sleep_animal_night_owl"/>
    <TextView
        android:textColor="@color/text_color_40"
        android:gravity="center"
        android:id="@+id/tv_tips"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/health_sleep_daily_routine_recommendation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_schedule"
        style="@style/FontRegular.12sp"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/schedule_recycler_view"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        android:layout_marginEnd="-18dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_schedule"/>
</androidx.constraintlayout.widget.ConstraintLayout>
