<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/pk_activity_invite_receive_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/page_padding_horizontal_large">
    <RelativeLayout
        android:id="@+id/container"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ScrollView
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:tag="binding_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.xiaomi.fitness.health.threetarget.model.ThreeTargetView
                    android:id="@+id/rainbow"
                    android:layout_width="267dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="64dp"
                    android:layout_centerHorizontal="true"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_gender"
                    android:background="@drawable/ic_active_female"
                    android:layout_width="94dp"
                    android:layout_height="203dp"
                    android:layout_marginTop="@dimen/size_13_3"
                    android:layout_marginEnd="62dp"
                    android:layout_alignEnd="@+id/rainbow"/>
                <TextView
                    android:textSize="@dimen/font_20"
                    android:textColor="@color/text_color"
                    android:gravity="center_horizontal"
                    android:id="@+id/tv_invite_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="31dp"
                    android:layout_below="@+id/rainbow"
                    android:layout_marginHorizontal="@dimen/size_26_67"
                    style="@style/FontMedium"/>
                <include
                    android:id="@+id/layout_pk_user_active_goal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_26_67"
                    android:layout_below="@+id/tv_invite_description"
                    layout="@layout/pk_layout_user_active_goal"/>
            </RelativeLayout>
        </ScrollView>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/size_26_67"
            android:layout_alignParentBottom="true">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ll_rule"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/size_18_67">
                <CheckBox
                    android:layout_gravity="center_vertical"
                    android:id="@+id/checkbox"
                    android:background="@drawable/selector_checkbox"
                    android:padding="@dimen/size_4_5"
                    android:layout_width="@dimen/size_30"
                    android:layout_height="@dimen/size_30"
                    android:checked="false"
                    android:button="@null"/>
                <TextView
                    android:textColor="@color/text_color_60"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/tv_rule"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pk_start_instruction"
                    android:lineSpacingMultiplier="1.2"
                    android:layout_marginStart="@dimen/size_10"
                    style="@style/FontRegular.12sp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="@color/selector_common_btn_normal_text_color"
                    android:gravity="center"
                    android:id="@+id/tv_reject"
                    android:background="@drawable/selector_bottom_button_normal"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/size_46_67"
                    android:text="@string/pk_invite_reject"
                    android:layout_weight="1"
                    style="@style/FontMedium.16sp"/>
                <TextView
                    android:enabled="false"
                    android:textColor="@color/selector_common_btn_primary_text_color"
                    android:gravity="center"
                    android:id="@+id/tv_accept"
                    android:background="@drawable/selector_bottom_button_red"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/size_46_67"
                    android:text="@string/pk_invite_accept"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/size_13_3"
                    style="@style/FontMedium.16sp"/>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:id="@+id/page_fail_group"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:translationY="-100dp">
        <TextView
            android:textSize="@dimen/font_20"
            android:textColor="@color/pk_expired_label_text_color"
            android:id="@+id/tv_expired"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_50dp"
            android:text="@string/pk_completition_cannot_be_established"
            android:drawableTop="@drawable/ic_pk_expired"
            android:drawablePadding="@dimen/dimen_margin_50dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/FontMedium"/>
        <TextView
            android:textColor="@color/text_color_40"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/invitation_failed_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_10dp"
            android:text="@string/pk_fail_reason_different_region_or_expired"
            android:layout_marginHorizontal="26.67dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_expired"
            style="@style/FontRegular.14sp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
