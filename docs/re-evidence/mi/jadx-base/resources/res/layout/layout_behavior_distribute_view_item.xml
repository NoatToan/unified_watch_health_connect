<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="30dp"
    android:paddingStart="@dimen/dimen_margin_18dp">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/txtSummary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true">
        <TextView
            android:textSize="@dimen/font_22"
            android:id="@+id/txt_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            style="@style/FontLatinMedium"/>
        <TextView
            android:textSize="@dimen/font_12"
            android:textColor="@color/text_color"
            android:id="@+id/txt_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:layout_marginStart="@dimen/dimen_margin_2dp"
            style="@style/FontMedium.12sp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/txtSummary"
        android:layout_alignParentStart="true">
        <View
            android:layout_gravity="center_vertical"
            android:id="@+id/colorBlock"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginTop="@dimen/margin_1dp"
            android:layout_marginEnd="@dimen/dimen_margin_6dp"/>
        <TextView
            android:textColor="@color/text_color_40"
            android:layout_gravity="center_vertical"
            android:id="@+id/txtTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/FontRegular.12sp"/>
    </LinearLayout>
</RelativeLayout>
