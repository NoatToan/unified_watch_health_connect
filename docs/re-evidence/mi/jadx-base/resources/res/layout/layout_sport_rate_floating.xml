<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_floating"
    android:tag="layout/layout_sport_rate_floating_0"
    android:background="@drawable/sport_report_floating_view_bg_shape"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="72dp"
    android:paddingStart="14dp"
    android:paddingEnd="@dimen/dimen_18sp"
    android:paddingVertical="@dimen/dimen_margin_14dp">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_unlock"
        android:layout_width="21.3dp"
        android:layout_height="21.3dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/sport_report_rate_unlock"/>
    <TextView
        android:textSize="13.3sp"
        android:textColor="@color/text_select_color"
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/trail_sport_dialog_buy_device_desc"
        android:paddingStart="7dp"
        android:paddingEnd="@dimen/size_10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tv_buy"
        app:layout_constraintStart_toEndOf="@+id/iv_unlock"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/FontMedium"/>
    <TextView
        android:textColor="@color/text_select_color"
        android:id="@+id/tv_buy"
        android:background="@drawable/shape_btn_white_bg_normal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="100dp"
        android:text="@string/trail_sport_dialog_buy_device_button"
        android:paddingHorizontal="@dimen/dimen_margin_22dp"
        android:paddingVertical="@dimen/size_10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/FontMedium"/>
</androidx.constraintlayout.widget.ConstraintLayout>
