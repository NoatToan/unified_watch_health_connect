<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/guide_notify_select_app_activity_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dimen_12sp"
        android:textColor="@color/notify_guide_remind_has_open_color"
        android:id="@+id/remind_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/notify_select_app_remind"
        android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
        android:layout_marginEnd="@dimen/page_content_padding_horizontal_large"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <miuix.recyclerview.widget.RecyclerView
        android:orientation="vertical"
        android:id="@+id/app_list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
        android:layout_marginEnd="@dimen/page_content_padding_horizontal_large"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@+id/finish_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/remind_text"/>
    <Button
        android:id="@+id/finish_button"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:text="@string/notify_message_remind_finish"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        style="@style/CommonBtn.Primary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
