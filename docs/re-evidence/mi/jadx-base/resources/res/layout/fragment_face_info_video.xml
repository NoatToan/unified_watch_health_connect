<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_face_info_video_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/layout_face_layer"/>
    <com.xiaomi.fitness.widget.view.DividerView
        android:id="@+id/divider"
        android:layout_marginTop="@dimen/dimen_margin_20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mSizeAuthorView"
        style="@style/SettingDivider.Curse"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottom_button"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/mDescView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginStart="@dimen/dimen_margin_26dp"
                android:layout_marginEnd="@dimen/dimen_margin_26dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/FontNormal.12sp"/>
            <TextView
                android:textColor="@color/face_common_text"
                android:gravity="center_horizontal"
                android:id="@+id/screen_off_tips"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:paddingStart="@dimen/dimen_margin_26dp"
                android:paddingEnd="@dimen/dimen_margin_26dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/mDescView"
                style="@style/FontNormal.12sp"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/multi_photo_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/bgColorsView">
                <TextView
                    android:textColor="@color/face_common_gray_text"
                    android:id="@+id/style_tv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="29dp"
                    android:text="@string/face_photo_face_style"
                    android:layout_marginStart="@dimen/dimen_margin_26dp"
                    android:layout_marginEnd="@dimen/dimen_margin_26dp"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/FontRegular.12sp"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/style_recycler_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_margin_24dp"
                    android:layout_marginStart="@dimen/dimen_margin_26dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/style_tv"/>
                <com.xiaomi.fitness.watch.face.widget.VideoBgPicker
                    android:orientation="vertical"
                    android:id="@+id/photo_bg_picker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="23dp"
                    android:layout_marginStart="26dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/style_recycler_view"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <com.xiaomi.fitness.watch.face.view.FaceColorPickView
                android:orientation="vertical"
                android:id="@+id/bgColorsView"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@+id/screen_off_tips"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/imgLabelView"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="53dp"
                android:layout_marginTop="20dp"
                android:paddingStart="@dimen/dimen_margin_26dp"
                android:paddingEnd="@dimen/dimen_margin_26dp"
                app:layout_constraintTop_toBottomOf="@+id/bgColorsView">
                <TextView
                    android:textSize="15.33sp"
                    android:textColor="@color/face_common_text"
                    android:gravity="center_vertical"
                    android:id="@+id/imgLabelTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="53dp"
                    android:text="@string/face_bg_img"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ImageView
                    android:id="@+id/imgLabelImageView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_base_right_arrow_icon"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/bottom_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:id="@+id/actionDelView"
            android:text="@string/common_delete"
            android:layout_weight="1"
            android:layout_marginEnd="0dp"
            style="@style/CommonBtn.Normal"/>
        <View
            android:id="@+id/empty_view"
            android:layout_width="@dimen/dimen_margin_7dp"
            android:layout_height="@dimen/common_btn_height"/>
        <View
            android:id="@+id/apply_margin"
            android:visibility="gone"
            android:layout_width="@dimen/dimen_margin_26dp"
            android:layout_height="@dimen/common_btn_height"/>
        <TextView
            android:id="@+id/actionUseView"
            android:text="@string/common_use"
            android:layout_weight="1"
            android:layout_marginStart="0dp"
            style="@style/CommonBtn.Primary"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
