<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootView"
    android:tag="layout/face_fragment_face_edit_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.xiaomi.fitness.watch.face.widget.FaceEditScrollLayout
        android:id="@+id/scroll_view"
        android:background="@color/face_market_item_fill"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/preview_container"
                android:background="@drawable/face_shape_edit_preview_container_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-22dp"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:id="@+id/outlineView"
                    android:layout_width="320dp"
                    android:layout_height="320dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.cardview.widget.CardView
                    android:id="@+id/videoCardView"
                    android:visibility="invisible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardElevation="0dp"
                    app:layout_constraintBottom_toBottomOf="@+id/outlineView"
                    app:layout_constraintEnd_toEndOf="@+id/outlineView"
                    app:layout_constraintStart_toStartOf="@+id/outlineView"
                    app:layout_constraintTop_toTopOf="@+id/outlineView">
                    <TextureView
                        android:id="@+id/mVideoView"
                        android:layout_width="20dp"
                        android:layout_height="20dp"/>
                    <ImageView
                        android:id="@+id/video_placeholder"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                </androidx.cardview.widget.CardView>
                <com.xiaomi.fitness.watch.face.edit.ui.FaceEditPreviewView
                    android:id="@+id/mImageView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scaleType="centerInside"
                    app:layout_constraintBottom_toBottomOf="@+id/outlineView"
                    app:layout_constraintEnd_toEndOf="@+id/outlineView"
                    app:layout_constraintStart_toStartOf="@+id/outlineView"
                    app:layout_constraintTop_toTopOf="@+id/outlineView"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <ImageView
                android:id="@+id/aod_switch"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/face_edit_aod_preview"
                android:contentDescription="@string/face_aod_description"
                android:paddingHorizontal="@dimen/dimen_margin_22dp"
                android:paddingVertical="@dimen/dimen_margin_26dp"
                app:layout_constraintBottom_toTopOf="@+id/editor"
                app:layout_constraintEnd_toEndOf="parent"/>
            <ImageView
                android:id="@+id/slide_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dimen_margin_28dp"
                android:src="@drawable/face_edit_slide_group"
                app:layout_constraintBottom_toBottomOf="@+id/preview_container"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <com.xiaomi.fitness.watch.face.widget.FaceEditPicker
                android:id="@+id/editor"
                android:tag="binding_1"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="-22dp"
                app:layout_constraintTop_toBottomOf="@+id/preview_container"
                app:layout_constraintVertical_weight="1"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.xiaomi.fitness.watch.face.widget.FaceEditScrollLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/button_group"
        android:background="@color/face_market_item_fill"
        android:paddingTop="@dimen/dimen_margin_13dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">
        <TextView
            android:id="@+id/actionUseView"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/CommonBtn.Primary"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
