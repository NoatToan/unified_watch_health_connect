<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/mine_lab_collaboration_management_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:id="@+id/description"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginHorizontal="@dimen/page_content_padding_horizontal_large"
            app:layout_constraintBottom_toTopOf="@+id/divider"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/FontRegular.14sp"/>
        <com.xiaomi.fitness.widget.view.DividerView
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="40.67dp"
            android:layout_marginHorizontal="@dimen/page_content_padding_horizontal_large"
            android:layout_marginVertical="@dimen/dimen_margin_20dp"
            app:layout_constraintBottom_toTopOf="@+id/term_check_group"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/term_check_group"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14.3dp"
            android:layout_marginHorizontal="@dimen/page_content_padding_horizontal_large"
            app:layout_constraintBottom_toTopOf="@+id/button_groups">
            <CheckBox
                android:layout_gravity="center_vertical"
                android:id="@+id/checkbox"
                android:background="@drawable/selector_checkbox"
                android:padding="4.5dp"
                android:layout_width="@dimen/size_30"
                android:layout_height="@dimen/size_30"
                android:checked="false"
                android:button="@null"
                android:labelFor="@+id/check_to_agree_text"/>
            <TextView
                android:textSize="@dimen/dimen_15sp"
                android:textColor="@color/text_color_80"
                android:layout_gravity="center_vertical"
                android:id="@+id/check_to_agree_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dimen_margin_10dp"
                style="@style/FontRegular"/>
        </LinearLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/button_groups"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dimen_margin_20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/bottom_buttons"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="46.67dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">
                <TextView
                    android:textColor="@color/text_color_80"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/btn_cancel"
                    android:background="@drawable/shape_bottom_small_button_normal_bg"
                    android:layout_width="146.67dp"
                    android:layout_height="46.67dp"
                    android:text="@string/cancel"
                    android:layout_marginStart="@dimen/size_26_67"
                    style="@style/FontMedium.16sp"/>
                <TextView
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/btn_agree"
                    android:background="@drawable/shape_bottom_btn_positive_bg_normal"
                    android:layout_width="146.67dp"
                    android:layout_height="46.67dp"
                    android:text="@string/agree"
                    android:layout_marginStart="6.67dp"
                    android:layout_marginEnd="@dimen/size_26_67"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    style="@style/FontMedium.16sp"/>
            </LinearLayout>
            <TextView
                android:textColor="@color/text_color_80"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/btn_confirm"
                android:background="@drawable/shape_bottom_small_button_normal_bg"
                android:visibility="gone"
                android:layout_width="306.6641dp"
                android:layout_height="46.67dp"
                android:layout_marginBottom="@dimen/dimen_margin_20dp"
                android:text="@string/cancel"
                android:layout_weight="1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                style="@style/FontMedium.16sp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/mine_no_network_text_color"
        android:gravity="center_horizontal"
        android:id="@+id/no_network"
        android:visibility="gone"
        android:layout_width="100dp"
        android:layout_height="150dp"
        android:text="@string/mine_network_connection_failed"
        android:drawableTop="@drawable/icon_no_network"
        android:drawablePadding="@dimen/dimen_margin_10dp"
        android:layout_centerInParent="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
