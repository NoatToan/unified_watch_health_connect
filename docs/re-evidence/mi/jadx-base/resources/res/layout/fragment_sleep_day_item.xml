<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/container"
    android:tag="layout/fragment_sleep_day_item_0"
    android:paddingBottom="@dimen/size_20"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:contentDescription="@string/health_sleep_data"
    android:layout_marginHorizontal="@dimen/health_detail_page_common_margin_horizontal">
    <include
        android:id="@+id/sleep_permission_setting"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_20dp"
        android:layout_marginBottom="12dp"
        android:layout_marginHorizontal="12dp"
        layout="@layout/sleep_permission_setting_instruction"/>
    <include
        android:id="@+id/sleep_audio_no_data_instruction"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_20dp"
        android:layout_marginBottom="12dp"
        android:layout_marginHorizontal="12dp"
        layout="@layout/sleep_audio_no_data_instruction"/>
    <include
        android:id="@+id/card_score"
        layout="@layout/layout_sleep_score"/>
    <include
        android:id="@+id/card_sleep_animal_entrance"
        layout="@layout/layout_sleep_day_animal_entrance"/>
    <include
        android:id="@+id/sleep_interfere"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        layout="@layout/layout_sleep_interfere_day_entry"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/sleep_detail_recycler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"/>
    <include
        android:id="@+id/card_duration"
        layout="@layout/layout_sleep_duration"/>
    <com.xiaomi.fitness.health.sleep.ui.SleepHealthBannerCardSetLayout
        android:id="@+id/health_sleep_banner_card_set_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"/>
    <include
        android:id="@+id/sleepInterfereLayout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        layout="@layout/layout_sleep_interfere_create_entry"/>
    <com.xiaomi.fitness.view.CardUnderstandView
        android:id="@+id/understandCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_12"
        app:txtUnderstand="@string/health_sleep_understand"/>
</LinearLayout>
