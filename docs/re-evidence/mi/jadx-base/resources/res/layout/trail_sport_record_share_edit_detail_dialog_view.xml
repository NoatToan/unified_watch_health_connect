<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/trail_sport_record_share_edit_detail_dialog_view_0"
    android:background="@drawable/shape_card_bg_191919_upper_radius"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/action_bar"
        android:paddingTop="@dimen/dimen_margin_13dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/cancel"
            android:background="@drawable/ic_common_action_cancel"
            android:layout_width="@dimen/dimen_margin_22dp"
            android:layout_height="@dimen/dimen_margin_22dp"
            android:contentDescription="@string/cancel"
            android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textColor="@color/white_90"
            android:gravity="center"
            android:id="@+id/title_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toStartOf="@+id/done"
            app:layout_constraintStart_toEndOf="@+id/cancel"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/FontMedium.12sp"/>
        <ImageView
            android:id="@+id/done"
            android:background="@drawable/ic_common_action_done"
            android:layout_width="@dimen/dimen_margin_22dp"
            android:layout_height="@dimen/dimen_margin_22dp"
            android:contentDescription="@string/ui_save"
            android:layout_marginEnd="@dimen/page_content_padding_horizontal_large"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/horizontal_divider"
            android:background="@drawable/sport_trace_edit_divider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_13dp"
            android:importantForAccessibility="no"
            app:layout_constraintTop_toBottomOf="@+id/title_tv"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:orientation="vertical"
        android:tag="binding_1"
        android:paddingBottom="@dimen/dimen_margin_20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/action_bar">
        <include
            android:id="@+id/timeline_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/trail_sport_trace_video_share_timeline_layout"/>
        <include
            android:id="@+id/add_pic_recycler_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_18dp"
            app:layout_constraintTop_toBottomOf="@+id/timeline_view"
            layout="@layout/trail_sport_trace_video_share_add_pic_layout"/>
        <include
            android:id="@+id/moments_recycler"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_18dp"
            app:layout_constraintTop_toBottomOf="@+id/add_pic_recycler_layout"
            layout="@layout/trail_video_share_moments"/>
        <include
            android:id="@+id/record_feelings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_18dp"
            app:layout_constraintTop_toBottomOf="@+id/moments_recycler"
            layout="@layout/trail_video_share_record_feelings"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
