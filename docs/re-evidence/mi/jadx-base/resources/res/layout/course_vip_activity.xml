<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/course_vip_activity_0"
    android:background="@color/app_4_0_bg_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingBottom="65dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.utils.widget.ImageFilterView
            android:id="@+id/iv_vip_user_head"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginTop="30dp"
            android:layout_marginStart="28dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:roundPercent="1"/>
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_color"
            android:id="@+id/tv_vip_user_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toEndOf="@+id/iv_vip_user_head"
            app:layout_constraintTop_toTopOf="@+id/iv_vip_user_head"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/text_color"
            android:id="@+id/tv_vip_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            app:layout_constrainedHeight="true"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="@+id/iv_vip_user_head"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="@+id/tv_vip_user_name"
            app:layout_constraintTop_toBottomOf="@+id/tv_vip_user_name"/>
        <View
            android:id="@+id/view_vip_type_bg"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="24dp"
            android:layout_marginHorizontal="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/view_vip_type_position"
            app:layout_constraintTop_toBottomOf="@+id/iv_vip_user_head"/>
        <View
            android:id="@+id/view_vip_type_position"
            android:layout_width="@dimen/dimen_margin_1dp"
            android:layout_height="@dimen/dimen_margin_1dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view_vip_agreement_bg"/>
        <TextView
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="@color/text_color"
            android:id="@+id/tv_open_vip_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="42dp"
            android:text="@string/course_vip_open_title"
            android:textAlignment="viewStart"
            android:layout_marginStart="26dp"
            android:layout_marginEnd="26dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_vip_user_head"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/text_color_30"
            android:id="@+id/tv_open_vip_title_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="@string/course_vip_open_title_sub"
            android:layout_marginEnd="26dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="@+id/tv_open_vip_title"
            app:layout_constraintTop_toBottomOf="@+id/tv_open_vip_title"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcv_open_vip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:layout_constraintEnd_toEndOf="@+id/view_vip_type_bg"
            app:layout_constraintStart_toStartOf="@+id/view_vip_type_bg"
            app:layout_constraintTop_toBottomOf="@+id/tv_open_vip_title_sub"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_open_vip"
            android:background="@drawable/course_open_vip_bg"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="38dp"
            android:text="@string/course_vip_open"
            android:layout_marginHorizontal="27dp"
            app:layout_constraintTop_toBottomOf="@+id/rcv_open_vip"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/text_color_50"
            android:id="@+id/tv_vip_agreement"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/course_vip_agreement_pay"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_open_vip"/>
        <View
            android:id="@+id/view_vip_agreement_bg"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="17dp"
            android:layout_marginHorizontal="20dp"
            app:layout_constraintBottom_toBottomOf="@+id/tv_open_vip_agreement"
            app:layout_constraintTop_toBottomOf="@+id/tv_vip_agreement"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_color"
            android:id="@+id/tv_open_vip_agreement_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/course_vip_rights_title"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintEnd_toEndOf="@+id/view_vip_agreement_bg"
            app:layout_constraintStart_toStartOf="@+id/view_vip_agreement_bg"
            app:layout_constraintTop_toTopOf="@+id/view_vip_agreement_bg"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/text_color_60"
            android:id="@+id/tv_open_vip_agreement"
            android:paddingTop="10dp"
            android:paddingBottom="18dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/course_vip_rights_info"
            android:lineSpacingExtra="@dimen/dimen_margin_4dp"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintEnd_toEndOf="@+id/view_vip_agreement_bg"
            app:layout_constraintStart_toStartOf="@+id/view_vip_agreement_bg"
            app:layout_constraintTop_toBottomOf="@+id/tv_open_vip_agreement_title"/>
        <FrameLayout
            android:id="@+id/fl_status"
            android:tag="binding_1"
            android:background="@color/app_4_0_bg_color"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <include
                android:id="@+id/state_view"
                android:visibility="visible"
                layout="@layout/view_text_icon"/>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
