<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:tag="layout/ability_medal_progress_layout_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="10">
            <ImageView
                android:id="@+id/left_medal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="21dp"
                android:adjustViewBounds="true"
                android:layout_alignParentBottom="true"
                android:layout_marginHorizontal="16dp"/>
        </RelativeLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="17">
            <ImageView
                android:id="@+id/center_medal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_14dp"
                android:src="@drawable/ability_time0_medal"
                android:adjustViewBounds="true"/>
        </LinearLayout>
        <RelativeLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="10">
            <ImageView
                android:id="@+id/right_medal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="21dp"
                android:src="@drawable/ability_time5_medal_right"
                android:adjustViewBounds="true"
                android:layout_alignParentBottom="true"
                android:layout_marginHorizontal="16dp"/>
        </RelativeLayout>
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/no_progress_layout"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="11dp">
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
            <miuix.androidbasewidget.widget.ProgressBar
                android:id="@+id/progress_no"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:progress="20"
                android:progressDrawable="@drawable/ability_plan_achievement_progress"
                android:layout_weight="1"
                style="?attr/progressBarHorizontalStyle"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/max_progress_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="11dp">
            <miuix.androidbasewidget.widget.ProgressBar
                android:id="@+id/progress_max"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:progress="20"
                android:progressDrawable="@drawable/ability_plan_achievement_progress"
                android:layout_weight="1"
                style="?attr/progressBarHorizontalStyle"/>
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
        </LinearLayout>
        <miuix.androidbasewidget.widget.ProgressBar
            android:id="@+id/normal_progress"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="11dp"
            android:progress="20"
            android:progressDrawable="@drawable/ability_plan_achievement_progress"
            android:paddingStart="-10dp"
            android:paddingEnd="-10dp"
            style="?attr/progressBarHorizontalStyle"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="10">
                <View
                    android:id="@+id/left_medal_point"
                    android:background="@drawable/ability_medal_point"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginTop="8dp"/>
                <TextView
                    android:textSize="13sp"
                    android:id="@+id/left_medal_tip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:fontFamily="@font/misanslatin_regular"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="17">
                <FrameLayout
                    android:id="@+id/center_medal_point"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <View
                        android:layout_gravity="center"
                        android:background="@drawable/ability_medal_point_outter"
                        android:layout_width="26dp"
                        android:layout_height="26dp"/>
                    <View
                        android:layout_gravity="center"
                        android:background="@drawable/ability_medal_point"
                        android:layout_width="12dp"
                        android:layout_height="12dp"/>
                </FrameLayout>
                <TextView
                    android:textSize="13sp"
                    android:id="@+id/center_medal_tip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:fontFamily="@font/misanslatin_regular"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="10">
                <View
                    android:id="@+id/right_medal_point"
                    android:background="@drawable/ability_medal_point"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginTop="8dp"/>
                <TextView
                    android:textSize="13sp"
                    android:id="@+id/right_medal_tip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:fontFamily="@font/misanslatin_regular"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
