<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:tag="layout/fragment_sport_detail_bicycle_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textStyle="bold"
        android:textColor="@color/text_color"
        android:id="@+id/txt_title"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_container"
        android:background="@color/common_transparent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:id="@+id/container_rate"
            android:background="@drawable/sport_detail_item_bg"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"/>
        <FrameLayout
            android:id="@+id/container_power"
            android:background="@drawable/sport_detail_item_bg"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"/>
        <FrameLayout
            android:id="@+id/container_pace"
            android:background="@drawable/sport_detail_item_bg"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"/>
        <FrameLayout
            android:id="@+id/container_candence"
            android:background="@drawable/sport_detail_item_bg"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"/>
        <FrameLayout
            android:id="@+id/container_resistance"
            android:background="@drawable/sport_detail_item_bg"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"/>
        <FrameLayout
            android:id="@+id/trainingExperienceView"
            android:background="@drawable/sport_detail_item_bg"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"/>
        <com.xiaomi.fitness.detail.view.SportFeedbackView
            android:id="@+id/feedBackView"
            android:background="@drawable/sport_detail_item_bg"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"/>
        <FrameLayout
            android:id="@+id/data_from_layout"
            android:background="@drawable/sport_detail_item_bg"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"/>
    </LinearLayout>
</FrameLayout>
