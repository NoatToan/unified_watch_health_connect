<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:tag="layout/layout_edit_temperature_0"
    android:background="@color/health_common_edit_card_bg_color"
    android:paddingTop="@dimen/size_19_3"
    android:paddingBottom="@dimen/size_16_67"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/size_19"
    android:paddingEnd="@dimen/size_10">
    <TextView
        android:textSize="@dimen/font_12_67"
        android:textColor="@color/health_common_edit_title_text_color"
        android:ellipsize="end"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="2"/>
    <EditText
        android:id="@+id/edit_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_22_66"
        android:minWidth="@dimen/size_50"
        android:maxLength="4"
        android:numeric="decimal"
        android:layout_below="@+id/tv_title"
        android:inputType="numberDecimal"
        style="@style/HealthCommonEditTextStyle"/>
    <TextView
        android:textSize="13.3sp"
        android:textColor="@color/health_common_edit_unit_text_color"
        android:ellipsize="end"
        android:id="@+id/tv_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_alignBaseline="@+id/edit_content"
        android:layout_marginStart="@dimen/size_9_3"
        android:layout_toEndOf="@+id/edit_content"/>
</RelativeLayout>
