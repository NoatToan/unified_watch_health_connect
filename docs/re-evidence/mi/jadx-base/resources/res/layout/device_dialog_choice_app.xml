<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/device_title_text_size"
        android:textColor="@color/device_title_text_color"
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/device_connect_devices_common_app"
        android:layout_marginStart="@dimen/dimen_margin_26dp"
        android:layout_marginEnd="@dimen/dimen_margin_26dp"
        style="@style/FontMedium"/>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_30dp"
        android:layout_marginStart="@dimen/dimen_margin_40dp">
        <View
            android:id="@+id/select_sport_health"
            android:background="@drawable/device_selector_app_check"
            android:padding="5dp"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:checked="true"
            android:button="@null"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/device_sport_health_icon"
            android:layout_marginStart="@dimen/dimen_margin_10dp"/>
        <TextView
            android:textSize="@dimen/text_size_16"
            android:textColor="@color/device_text_black_color_80"
            android:id="@+id/sport_health_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/device_mi_sport_health"
            android:layout_marginStart="@dimen/dimen_margin_6dp"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_16dp"
        android:layout_marginStart="@dimen/dimen_margin_40dp">
        <CheckBox
            android:id="@+id/select_wearable"
            android:background="@drawable/device_selector_app_check"
            android:padding="5dp"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:checked="false"
            android:button="@null"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/device_wearable_icon"
            android:layout_marginStart="@dimen/dimen_margin_10dp"/>
        <TextView
            android:textSize="@dimen/text_size_16"
            android:textColor="@color/device_text_black_color_80"
            android:id="@+id/wearble_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/device_mi_wearable"
            android:layout_marginStart="@dimen/dimen_margin_6dp"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/text_size_16"
        android:textColor="@color/device_text_black_color_80"
        android:id="@+id/select_app_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_40dp"
        android:text="@string/device_connect_devices_common_app_desc"
        android:layout_marginStart="@dimen/dimen_margin_40dp"
        android:layout_marginEnd="@dimen/dimen_margin_40dp"/>
</LinearLayout>
