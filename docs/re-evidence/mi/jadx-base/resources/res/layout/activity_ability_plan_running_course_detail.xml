<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:tag="layout/activity_ability_plan_running_course_detail_0"
    android:background="@color/page_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/content_margin"
    android:paddingEnd="@dimen/content_margin">
    <com.xiaomi.fitness.training_plan_export.widget.TrainingPlanTitleBar
        android:id="@+id/titlebar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/title_bar_height"
        android:layout_marginTop="@dimen/dimen_margin_36dp"
        android:layout_alignParentTop="true"
        android:layout_marginHorizontal="9dp"/>
    <FrameLayout
        android:id="@+id/contentRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/titlebar">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.xiaomi.fitness.training_plan_export.widget.TrainingStartBtn
                android:id="@+id/training"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimen_margin_50dp"
                android:layout_marginBottom="29dp"
                android:layout_alignParentBottom="true"/>
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_10dp"
                android:layout_marginBottom="@dimen/dimen_margin_16dp"
                android:layout_above="@+id/training"
                android:layout_alignParentTop="true">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="vertical"
                        android:background="@drawable/training_card_shape"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp">
                        <TextView
                            android:textSize="14sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/training_plan_ability_course_duration"
                            android:fontFamily="@font/misanslatin_bold"/>
                        <TextView
                            android:textSize="36sp"
                            android:id="@+id/courseDuration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:fontFamily="@font/misanslatin_bold"
                            android:textFontWeight="430"/>
                        <TextView
                            android:textSize="14sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:text="@string/training_plan_ability_course_desc"
                            android:fontFamily="@font/misanslatin_bold"/>
                        <TextView
                            android:textSize="13sp"
                            android:textColor="@color/text_color_40"
                            android:id="@+id/courseDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:background="@drawable/training_card_shape"
                        android:paddingTop="20dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimen_margin_12dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">
                        <TextView
                            android:textSize="17sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/training_plan_ability_course_structure"
                            android:fontFamily="@font/misanslatin_bold"/>
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/courseList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"/>
                        <View
                            android:background="#14000000"
                            android:layout_width="match_parent"
                            android:layout_height="0.5dp"
                            android:layout_marginTop="25dp"/>
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="30dp">
                            <TextView
                                android:textSize="12sp"
                                android:textColor="@color/text_color_40"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/training_plan_ability_course_attention"/>
                            <ImageView
                                android:id="@+id/openAttention"
                                android:padding="7dp"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ability_plan_arrow_up"/>
                        </LinearLayout>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/text_color_40"
                            android:id="@+id/courseAttention"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:layout_marginBottom="28dp"/>
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </RelativeLayout>
    </FrameLayout>
</RelativeLayout>
