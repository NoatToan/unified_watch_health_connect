<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/dimen_margin_16dp">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.xiaomi.fitness.widget.view.DurationTextView
            android:id="@+id/duration_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_margin_18dp"
            android:layout_marginEnd="@dimen/dimen_margin_18dp"
            app:dtv_bold="true"
            app:dtv_dataFont="@font/misanslatin_medium"
            app:dtv_dataTextColor="@color/text_color"
            app:dtv_dataTextSize="@dimen/font_33_3"
            app:dtv_unitTextColor="@color/text_color"
            app:dtv_unitTextFontFamily="@string/mipro_regular"
            app:dtv_unitTextSize="@dimen/font_16_7"
            app:dtv_unitTextStyle="bold"/>
        <TextView
            android:textColor="@color/text_color"
            android:id="@+id/tv_time_range"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="7dp"
            android:layout_marginStart="@dimen/dimen_margin_18dp"
            android:layout_marginEnd="@dimen/dimen_margin_18dp"
            style="@style/FontMedium.13sp"/>
        <TextView
            android:textColor="@color/text_color_40"
            android:id="@+id/tv_origin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="7dp"
            android:layout_marginStart="@dimen/dimen_margin_18dp"
            android:layout_marginEnd="@dimen/dimen_margin_18dp"
            style="@style/FontRegular.12sp"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/chart_guide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/dimen_margin_18dp"
            android:paddingEnd="@dimen/dimen_margin_18dp">
            <com.google.android.flexbox.FlexboxLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_12dp"
                android:layout_marginBottom="@dimen/dimen_margin_12dp"
                app:flexWrap="wrap"
                app:justifyContent="flex_start">
                <LinearLayout
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/chart_sleep_deep"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/dimen_margin_25dp"
                    app:layout_flexShrink="1">
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/shape_sleep_deep_guide"
                        android:layout_width="@dimen/size_10"
                        android:layout_height="@dimen/size_10"/>
                    <TextView
                        android:textColor="@color/text_color_40"
                        android:gravity="center"
                        android:layout_gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="22dp"
                        android:text="@string/health_sleep_deep"
                        android:layout_marginStart="@dimen/size_6"
                        style="@style/FontRegular.12sp"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/chart_sleep_slumber"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/dimen_margin_25dp"
                    app:layout_flexShrink="1">
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/shape_sleep_slumber_guide"
                        android:layout_width="@dimen/size_10"
                        android:layout_height="@dimen/size_10"/>
                    <TextView
                        android:textColor="@color/text_color_40"
                        android:layout_gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="22dp"
                        android:text="@string/health_sleep_slumber"
                        android:layout_marginStart="@dimen/size_6"
                        style="@style/FontRegular.12sp"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/chart_sleep_rem"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/dimen_margin_25dp"
                    app:layout_flexShrink="1">
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/shape_sleep_rem_guide"
                        android:layout_width="@dimen/size_10"
                        android:layout_height="@dimen/size_10"/>
                    <TextView
                        android:textColor="@color/text_color_40"
                        android:layout_gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="22dp"
                        android:text="@string/health_sleep_eye_move"
                        android:layout_marginStart="@dimen/size_6"
                        style="@style/FontRegular.12sp"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/chart_sleep_wake"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_flexShrink="1">
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/shape_sleep_wake_guide"
                        android:layout_width="@dimen/size_10"
                        android:layout_height="@dimen/size_10"/>
                    <TextView
                        android:textColor="@color/text_color_40"
                        android:layout_gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="22dp"
                        android:text="@string/health_sleep_wake"
                        android:layout_marginStart="@dimen/size_6"
                        style="@style/FontRegular.12sp"/>
                </LinearLayout>
            </com.google.android.flexbox.FlexboxLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
