<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="@color/text_color_40"
        android:id="@+id/tv_date_range"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_10"
        android:layout_marginHorizontal="@dimen/size_18"
        android:paddingVertical="@dimen/size_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/FontRegular.12sp"/>
    <View
        android:id="@+id/vertical_line"
        android:background="@color/common_divider_bg_color"
        android:layout_width="1dp"
        android:layout_height="10dp"
        android:layout_marginTop="35.67dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_date_range"/>
    <TextView
        android:textSize="21.3sp"
        android:textColor="@color/pk_opp_main_color"
        android:gravity="center"
        android:id="@+id/tv_opp_score"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_20"
        android:text="11"
        android:layout_marginStart="@dimen/size_18"
        app:layout_constraintEnd_toEndOf="@+id/vertical_line"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_date_range"
        style="@style/FontLatinDemiBold"/>
    <TextView
        android:textSize="21.3sp"
        android:textColor="@color/pk_own_main_color"
        android:gravity="center"
        android:id="@+id/tv_own_score"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_20"
        android:text="11"
        android:layout_marginEnd="@dimen/size_18"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/vertical_line"
        app:layout_constraintTop_toBottomOf="@+id/tv_date_range"
        style="@style/FontLatinDemiBold"/>
    <ImageView
        android:id="@+id/iv_opp_win"
        android:background="@drawable/ic_pk_score_chart_win"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/tv_opp_score"
        app:layout_constraintStart_toStartOf="@+id/tv_opp_score"
        app:layout_constraintTop_toBottomOf="@+id/tv_date_range"/>
    <ImageView
        android:id="@+id/iv_own_win"
        android:background="@drawable/ic_pk_score_chart_win"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/tv_own_score"
        app:layout_constraintStart_toStartOf="@+id/tv_own_score"
        app:layout_constraintTop_toBottomOf="@+id/tv_date_range"/>
    <TextView
        android:textColor="@color/text_color_40"
        android:gravity="center"
        android:id="@+id/tv_opp_nick_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/tv_opp_score"
        app:layout_constraintStart_toStartOf="@+id/tv_opp_score"
        app:layout_constraintTop_toBottomOf="@+id/tv_opp_score"
        style="@style/FontRegular.10sp"/>
    <TextView
        android:textColor="@color/text_color_40"
        android:gravity="center"
        android:id="@+id/tv_own_nick_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/tv_own_score"
        app:layout_constraintStart_toStartOf="@+id/tv_own_score"
        app:layout_constraintTop_toBottomOf="@+id/tv_own_score"
        style="@style/FontRegular.10sp"/>
    <com.xiaomi.fitness.active.pk.widget.PkBarChart
        android:id="@+id/pk_bar_chart"
        android:paddingTop="20dp"
        android:paddingBottom="71.3dp"
        android:layout_width="match_parent"
        android:layout_height="171.3dp"
        android:paddingStart="18dp"
        android:paddingEnd="32dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_own_nick_name"
        app:pkBarShowBottomScoreEnable="true"/>
    <View
        android:id="@+id/horizontal_line"
        android:background="@color/common_divider_bg_color"
        android:layout_width="0dp"
        android:layout_height="0.3dp"
        android:layout_marginTop="@dimen/size_10"
        android:layout_marginBottom="@dimen/size_10"
        android:layout_marginHorizontal="@dimen/size_18"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pk_bar_chart"/>
</androidx.constraintlayout.widget.ConstraintLayout>
