<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_view"
    android:tag="layout/sport_activity_create_route_0"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.mi.health.sport.TrackShareRoutineView
        android:id="@+id/routineView"
        android:background="@drawable/mine_track_line_bg"
        android:visibility="invisible"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:elevation="-10dp"/>
    <FrameLayout
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/topFullView"
        android:tag="binding_1"
        android:fitsSystemWindows="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="10dp"
        app:layout_insetEdge="top">
        <include
            android:id="@+id/title"
            layout="@layout/layout_route_list_title"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/title_layout"
            android:background="@color/card_bg_normal"
            android:paddingTop="9dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="3dp">
            <com.xiaomi.fitness.sport.baseui.TitleBar
                android:id="@+id/title_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <miuix.miuixbasewidget.widget.FilterSortView
                android:theme="@style/FilterSortViewStyle"
                android:id="@+id/filter_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:layout_marginBottom="7dp"
                android:layoutDirection="ltr"
                android:layout_marginStart="@dimen/common_set_margin_start"
                android:layout_marginEnd="@dimen/common_set_margin_start"/>
        </LinearLayout>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/mapContent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="2dp"
        app:layout_behavior="com.xiaomi.fitness.sport.view.route.CreateRouteMapContentBehavior">
        <com.mi.health.sport.CreateRouteMap
            android:layout_gravity="center"
            android:id="@+id/mapView"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="500dp"/>
    </FrameLayout>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center"
        android:layout_gravity="top|center_horizontal"
        android:orientation="vertical"
        android:id="@+id/curLocationLayout"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="17dp"
        android:layout_height="wrap_content"
        android:elevation="7dp"
        app:layout_anchor="@+id/mapContent"
        app:layout_anchorGravity="clip_vertical|center">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/icon_cur_location_selected_top"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/sport_ic_location_selected_top"
            android:scaleType="centerCrop"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/icon_cur_location_selected_bottom"
            android:layout_width="2dp"
            android:layout_height="9dp"
            android:src="@drawable/sport_ic_location_selected_bottom"
            android:scaleType="centerCrop"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="top|center_horizontal"
        android:layout_gravity="top|center_horizontal"
        android:orientation="vertical"
        android:id="@+id/curLocationNameLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="10dp"
        app:layout_anchor="@+id/icon_cur_location_selected_bottom"
        app:layout_anchorGravity="clip_vertical|top|center_horizontal">
        <androidx.cardview.widget.CardView
            android:id="@+id/curLocationNameCardView"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:elevation="10dp"
            app:cardBackgroundColor="@color/card_bg_normal"
            app:cardCornerRadius="16dp">
            <TextView
                android:textSize="13sp"
                android:textColor="@color/text_color"
                android:id="@+id/curLocationName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:drawablePadding="2dp"
                android:drawableEnd="@drawable/ic_right_arrow_center_right_black_6dp"
                android:fontFamily="@font/misanslatin_medium"
                android:drawableTint="@color/text_color"
                android:paddingHorizontal="10dp"
                android:paddingVertical="7dp"/>
        </androidx.cardview.widget.CardView>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="top|center_horizontal"
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="vertical"
        android:id="@+id/start_point_notice"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="10dp"
        app:layout_anchor="@+id/icon_cur_location_selected_bottom"
        app:layout_anchorGravity="clip_vertical|bottom|center_horizontal">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_pop_up_arrow"/>
        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/black_60"
            app:cardCornerRadius="15dp"
            app:cardElevation="0dp">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:padding="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sport_create_route_start_point_notice"
                android:fontFamily="@font/misanslatin_regular"
                android:textAlignment="center"/>
        </androidx.cardview.widget.CardView>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="2dp"
        app:layout_anchor="@+id/mapContent"
        app:layout_anchorGravity="center">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/route_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_gravity="start|top"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="20dp"
        app:layout_anchor="@+id/bottomSheetContent"
        app:layout_anchorGravity="start|clip_vertical|top">
        <androidx.cardview.widget.CardView
            android:id="@+id/locationBtn"
            android:visibility="gone"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:layout_marginBottom="2dp"
            android:layout_marginStart="5dp"
            app:cardBackgroundColor="@color/card_bg_normal"
            app:cardCornerRadius="15dp"
            app:cardElevation="1.2dp"
            app:cardMaxElevation="1.8dp"
            app:cardPreventCornerOverlap="true"
            app:cardUseCompatPadding="true">
            <TextView
                android:gravity="center"
                android:background="@drawable/location_btn_no"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/text_color"/>
        </androidx.cardview.widget.CardView>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/bottomSheetContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="true"
        android:elevation="10dp"
        app:layout_behavior="com.xiaomi.fitness.sport.view.route.CreateRouteMidCompressionBottomSheetBehavior"/>
    <FrameLayout
        android:id="@+id/abnormalContent"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="100dp"
        android:elevation="58dp"/>
    <FrameLayout
        android:id="@+id/loadingFrameLayout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="50dp"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
