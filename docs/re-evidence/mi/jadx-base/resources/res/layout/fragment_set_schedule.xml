<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_set_schedule_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
    android:layout_marginEnd="@dimen/page_content_padding_horizontal_large">
    <com.xiaomi.fitness.widget.RightArrowSingleLineTextView
        android:id="@+id/go_set_phone_schedule"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:showRemind="true"
        app:title="@string/device_settings_sync_phone_schedule"/>
    <com.xiaomi.fitness.widget.SwitchButtonSingleLineTextView
        android:id="@+id/sync_phone_schedule"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/device_settings_sync_phone_schedule"/>
    <com.xiaomi.fitness.widget.SwitchButtonSingleLineTextView
        android:id="@+id/customize_schedule"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/device_settings_customize_schedule"/>
    <com.xiaomi.fitness.widget.RightArrowSingleLineTextView
        android:id="@+id/sleep_time_selector"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/customize_schedule"
        app:title="@string/device_settings_time_to_sleep"/>
    <com.xiaomi.fitness.widget.RightArrowSingleLineTextView
        android:id="@+id/wake_up_time_selector"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sleep_time_selector"
        app:title="@string/device_settings_time_to_wake_up"/>
</androidx.constraintlayout.widget.ConstraintLayout>
