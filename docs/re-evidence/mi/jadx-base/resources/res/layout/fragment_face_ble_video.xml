<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_face_ble_video_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.xiaomi.fitness.watch.face.view.XmsTextureView
        android:id="@+id/textureview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/mStyleLabel"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.xiaomi.fitness.watch.face.view.FaceStyleView
        android:id="@+id/styleImg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/rect"
        app:layout_constraintEnd_toEndOf="@+id/rect"
        app:layout_constraintStart_toStartOf="@+id/rect"
        app:layout_constraintTop_toTopOf="@+id/rect"/>
    <com.xiaomi.fitness.watch.face.export.exportview.RectView
        android:layout_gravity="center"
        android:id="@+id/rect"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/mImageView"
        app:layout_constraintEnd_toEndOf="@+id/mImageView"
        app:layout_constraintStart_toStartOf="@+id/mImageView"
        app:layout_constraintTop_toTopOf="@+id/mImageView"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#ff8c93b0"
        android:gravity="center_vertical"
        android:id="@+id/mStyleLabel"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="33dp"
        android:text="@string/face_style"
        android:paddingStart="23dp"
        app:layout_constraintBottom_toTopOf="@+id/mStyleView"
        app:layout_constraintTop_toBottomOf="@+id/mImageView"/>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="horizontal"
        android:id="@+id/mStyleView"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@+id/mConfirmView"
        app:layout_constraintTop_toBottomOf="@+id/mStyleLabel"/>
    <TextView
        android:id="@+id/mConfirmView"
        android:layout_marginTop="34dp"
        android:layout_marginBottom="20dp"
        android:text="@string/confirm"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mStyleView"
        style="@style/CommonBtn.Normal"/>
</androidx.constraintlayout.widget.ConstraintLayout>
