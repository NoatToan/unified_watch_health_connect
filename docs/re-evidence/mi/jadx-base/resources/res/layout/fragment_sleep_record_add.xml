<?xml version="1.0" encoding="utf-8"?>
<miuix.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/scroll_view"
    android:tag="layout/fragment_sleep_record_add_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/page_padding_horizontal_large">
        <androidx.cardview.widget.CardView
            android:id="@+id/bed_time"
            android:tag="binding_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_13_3"
            android:foreground="@null"
            android:layout_weight="1"
            app:cardCornerRadius="@dimen/size_15_3"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/CardView.Default">
            <include layout="@layout/layout_edit_sleep_record"/>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:id="@+id/wakeup_time"
            android:tag="binding_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_13_3"
            android:foreground="@null"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/dimen_margin_12dp"
            app:cardCornerRadius="@dimen/size_15_3"
            app:layout_constraintStart_toEndOf="@+id/bed_time"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/CardView.Default">
            <include layout="@layout/layout_edit_sleep_record"/>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</miuix.core.widget.NestedScrollView>
