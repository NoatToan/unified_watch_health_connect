<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:tag="layout/sleep_interfere_report_nap_duration_0"
    android:background="@drawable/selector_card_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:paddingVertical="20dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/sleepInterfereReportNapTitleLinearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp">
        <ImageView
            android:id="@+id/sleepInterfereReportNapTitleImageView"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/night_awake_count_icon"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="20sp"
            android:id="@+id/sleepInterfereReportNapTitleTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/health_sleep_interfere_day_sleep_count_title"
            android:paddingHorizontal="8dp"
            android:textFontWeight="500"/>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="36sp"
        android:textColor="@color/text_color"
        android:id="@+id/sleepInterfereReportNapAvgCountTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="20dp"
        android:paddingHorizontal="8dp"
        android:textFontWeight="600"/>
    <com.xiaomi.fitness.health.sleep.interfere.report.charts.SleepInterfereReportChartCompareInfoView
        android:id="@+id/napAvgCountChartCompareInfoView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginHorizontal="20dp"/>
    <com.xiaomi.fitness.health.sleep.interfere.report.charts.SleepInterfereLineChartView
        android:id="@+id/napAvgCountChartView"
        android:layout_width="match_parent"
        android:layout_height="246dp"
        android:layout_marginTop="22dp"/>
    <LinearLayout
        android:gravity="bottom"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp">
        <TextView
            android:textSize="36sp"
            android:textColor="@color/text_color"
            android:id="@+id/averageDurationTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/health_sleep_interfere_day_sleep_duration_unit"
            android:textFontWeight="600"/>
    </LinearLayout>
    <com.xiaomi.fitness.health.sleep.interfere.report.charts.SleepInterfereReportChartCompareInfoView
        android:id="@+id/napAvgDurationChartCompareInfoView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginHorizontal="20dp"/>
    <com.xiaomi.fitness.health.sleep.interfere.report.charts.NapDurationBarChart
        android:id="@+id/napAvgDurationChart"
        android:layout_width="match_parent"
        android:layout_height="195dp"
        android:layout_marginTop="20dp"/>
</LinearLayout>
