<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/trail_default_whole_report_layout_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.cardview.widget.CardView
        android:id="@+id/container"
        android:layout_width="286dp"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/dimen_margin_20dp"
        app:cardCornerRadius="@dimen/dimen_margin_16dp"
        app:cardElevation="4dp"
        app:cardMaxElevation="@dimen/dimen_margin_10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/rlImgShareLong"
            android:background="@color/page_white_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.core.widget.NestedScrollView
                android:id="@+id/scrollShare"
                android:background="@color/page_white_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:id="@+id/imgShareLong"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:layout_centerInParent="true"
                    android:contentDescription="@string/back"/>
            </androidx.core.widget.NestedScrollView>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/mask"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:importantForAccessibility="no"
                app:layout_constraintEnd_toEndOf="@+id/scrollShare"
                app:layout_constraintStart_toStartOf="@+id/scrollShare"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/upper_mask"/>
            <ImageView
                android:id="@+id/logo"
                android:background="@drawable/ic_launch_logo_rounded_corner"
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:layout_marginTop="@dimen/dimen_margin_15dp"
                android:contentDescription="@string/app_name"
                android:layout_marginStart="@dimen/dimen_margin_15dp"
                app:layout_constraintStart_toStartOf="@+id/mask"
                app:layout_constraintTop_toTopOf="@+id/mask"/>
            <TextView
                android:textColor="@color/white"
                android:id="@+id/app_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:layout_marginStart="6.33dp"
                app:layout_constraintBottom_toBottomOf="@+id/logo"
                app:layout_constraintStart_toEndOf="@+id/logo"
                app:layout_constraintTop_toTopOf="@+id/logo"
                style="@style/FontMedium.12sp"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:orientation="vertical"
                android:id="@+id/slide_up_widget"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="103dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/slide_up_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:translationY="@dimen/dimen_margin_20dp"
                    app:layout_constraintEnd_toEndOf="@+id/txtScroll"
                    app:layout_constraintStart_toStartOf="@+id/txtScroll"
                    app:srcCompat="@drawable/slide_up_mask"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/dimen_11sp"
                    android:textColor="@color/black_40"
                    android:gravity="center"
                    android:id="@+id/txtScroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/trail_slide_up_to_check_complete_sport_report"
                    android:drawableTop="@drawable/top_arrow"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
