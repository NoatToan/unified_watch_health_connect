<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:background="@drawable/widget_default_corners_background_12_67"
    android:paddingTop="13.3dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="13.3dp"
    android:paddingEnd="13.3dp">
    <ImageView
        android:id="@+id/iv_image"
        android:layout_width="33.3dp"
        android:layout_height="33.3dp"
        android:src="@drawable/ic_widget_menses_loading_2_2"
        android:importantForAccessibility="no"/>
    <TextView
        android:textSize="9.3dp"
        android:textColor="@color/text_color_30"
        android:id="@+id/tv_date_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawableLeft="@drawable/widget_placeholder_shape_size_32_10"
        android:layout_alignParentEnd="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/iv_image">
        <TextView
            android:textSize="16dp"
            android:textColor="@color/text_color"
            android:ellipsize="middle"
            android:gravity="start"
            android:id="@+id/tv_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8.7dp"
            android:maxLines="1"
            android:drawableLeft="@drawable/widget_placeholder_shape_size_40_16"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="10dp"
            style="@style/FontMedium"/>
        <TextView
            android:textSize="10dp"
            android:textColor="@color/text_color"
            android:ellipsize="middle"
            android:gravity="start"
            android:id="@+id/tv_tip"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5.7dp"
            android:maxLines="2"
            android:drawableLeft="@drawable/widget_placeholder_shape_size_40_16"
            style="@style/FontRegular"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/iv_menstrual_list"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="@dimen/size_8"
        android:src="@drawable/widget_placeholder_shape_size_120_36"
        android:scaleType="fitXY"
        android:layout_below="@+id/ll_container"
        android:importantForAccessibility="no"/>
    <TextView
        android:textSize="8.6dp"
        android:textColor="@color/text_color_30"
        android:id="@+id/tv_date_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="--"
        android:maxLines="1"
        android:layout_below="@+id/iv_menstrual_list"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textSize="8.6dp"
        android:textColor="@color/text_color_30"
        android:id="@+id/tv_date_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="--"
        android:maxLines="1"
        android:layout_below="@+id/iv_menstrual_list"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
