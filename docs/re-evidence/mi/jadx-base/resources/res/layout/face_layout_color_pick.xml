<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textColor="@color/face_common_text"
        android:gravity="center_vertical"
        android:id="@+id/labelView"
        android:layout_width="360dp"
        android:layout_height="33dp"
        android:text="@string/face_spirit_color"
        android:paddingStart="@dimen/dimen_margin_26dp"
        style="@style/FontRegular.12sp"/>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="horizontal"
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="@dimen/dimen_margin_26dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/labelView"/>
    <TextView
        android:textSize="15.33sp"
        android:textColor="@color/face_common_text"
        android:gravity="center_vertical"
        android:id="@+id/paletteView"
        android:layout_width="match_parent"
        android:layout_height="53dp"
        android:layout_marginTop="8dp"
        android:text="@string/face_customize_palette"
        android:paddingStart="@dimen/dimen_margin_26dp"
        android:paddingEnd="@dimen/dimen_margin_26dp"
        app:layout_constraintTop_toBottomOf="@+id/recyclerView"
        style="@style/FontMedium"/>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_palette_indicator"
        app:layout_constraintBottom_toBottomOf="@+id/paletteView"
        app:layout_constraintEnd_toStartOf="@+id/color_arrow_view"
        app:layout_constraintTop_toTopOf="@+id/paletteView"/>
    <ImageView
        android:id="@+id/color_arrow_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_base_right_arrow_icon"
        android:layout_marginEnd="@dimen/page_content_padding_horizontal_large"
        app:layout_constraintBottom_toBottomOf="@+id/paletteView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/paletteView"/>
    <com.xiaomi.fitness.widget.view.DividerView
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginStart="@dimen/dimen_margin_26dp"
        android:layout_marginEnd="@dimen/dimen_margin_26dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/paletteView"/>
</merge>
