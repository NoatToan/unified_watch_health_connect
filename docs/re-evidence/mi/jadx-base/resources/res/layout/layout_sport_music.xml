<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/container_sport_music"
    android:tag="layout/layout_sport_music_0"
    android:background="@drawable/shape_card_sport_music"
    android:layout_width="wrap_content"
    android:layout_height="33dp"
    android:paddingEnd="9dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center_vertical"
        android:id="@+id/rl_img_container"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/iv_music_url"
            android:visibility="gone"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:foreground="@drawable/ic_music_forehead"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/iv_symbol"
            android:visibility="visible"
            android:layout_width="13dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_music_symbol"
            android:layout_centerInParent="true"
            android:translationY="-1dp"
            android:layout_marginStart="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="11dp"
        android:textColor="@color/color_00a88a"
        android:layout_gravity="center_vertical"
        android:id="@+id/tv_music_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="4.67dp"
        style="@style/FontMedium"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/iv_music_arrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_sport_music_arrow"/>
</LinearLayout>
