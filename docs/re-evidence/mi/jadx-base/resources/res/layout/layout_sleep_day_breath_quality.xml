<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/layout_sleep_day_breath"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include layout="@layout/layout_division_line"/>
    <LinearLayout
        android:orientation="horizontal"
        android:paddingTop="@dimen/size_15"
        android:paddingBottom="@dimen/size_15"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/size_18"
        android:paddingEnd="@dimen/size_18">
        <ImageView
            android:layout_gravity="center_vertical"
            android:background="@drawable/ic_sleep_breath"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"/>
        <TextView
            android:textSize="@dimen/font_14"
            android:textColor="@color/text_color"
            android:gravity="start"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:layout_marginStart="@dimen/size_10"
            style="@style/FontMedium"/>
        <TextView
            android:textSize="@dimen/font_14"
            android:textColor="@color/text_color_80"
            android:gravity="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_tip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/size_5"
            style="@style/FontRegular"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_go"
            android:background="@drawable/ic_base_right_arrow_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:layout_marginEnd="@dimen/size_18"/>
    </LinearLayout>
</LinearLayout>
