<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/userinfo_activity_stand_times_goal_guid_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:gravity="left"
        android:id="@+id/stand_times_goal_desc_tv"
        android:layout_width="match_parent"
        android:text="@string/userinfo_target_stand_times_desc"
        android:layout_marginStart="@dimen/dimen_margin_24dp"
        android:layout_marginEnd="@dimen/dimen_margin_24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/userinfo_GuideSubTitleText"/>
    <com.xiaomi.fitness.baseui.widget.NumberPickerView
        android:id="@+id/stand_times_goal_setting_picker"
        android:layout_width="match_parent"
        android:layout_height="@dimen/userinfo_size_313"
        android:layout_marginBottom="@dimen/userinfo_size_80"
        app:layout_constraintBottom_toTopOf="@+id/standPageView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/stand_times_goal_desc_tv"
        app:npv_ItemPaddingVertical="@dimen/userinfo_size_320_67"
        app:npv_ShowCount="5"
        app:npv_ShowDivider="false"
        app:npv_TextColorNormal="@color/userinfo_black_20"
        app:npv_TextColorOuter="@color/userinfo_black_10"
        app:npv_TextColorSelected="@color/userinfo_black"
        app:npv_TextSizeNormal="@dimen/userinfo_font_37"
        app:npv_TextSizeOuter="@dimen/userinfo_font_33_1"
        app:npv_TextSizeSelected="@dimen/userinfo_font_46_67"
        app:npv_WrapSelectorWheel="true"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/userinfo_desc_black"
        android:gravity="center"
        android:id="@+id/standPageView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_margin_13dp"
        app:layout_constraintBottom_toTopOf="@+id/stand_times_goal_bottom_view"/>
    <LinearLayout
        android:gravity="bottom"
        android:orientation="horizontal"
        android:id="@+id/stand_times_goal_bottom_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/userinfo_size_27"
        app:layout_constraintBottom_toBottomOf="parent">
        <TextView
            android:textSize="@dimen/dimen_16sp"
            android:textColor="@color/userinfo_black"
            android:gravity="center"
            android:id="@+id/stand_times_goal_previous_view"
            android:background="@drawable/selector_bottom_btn_native_bg"
            android:layout_width="0dp"
            android:layout_height="@dimen/common_btn_height"
            android:text="@string/userinfo_previous_step"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/dimen_margin_26dp"/>
        <TextView
            android:textSize="@dimen/dimen_16sp"
            android:textColor="@color/userinfo_white"
            android:gravity="center"
            android:id="@+id/stand_times_goal_next_view"
            android:background="@drawable/selector_bottom_btn_positive_bg"
            android:layout_width="0dp"
            android:layout_height="@dimen/common_btn_height"
            android:text="@string/userinfo_common_complete"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/dimen_14sp"
            android:layout_marginEnd="@dimen/dimen_margin_26dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
