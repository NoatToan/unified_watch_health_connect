<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/trail_edit_sport_report_custom_share_activity_0"
    android:background="@color/black"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/action_bar"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_50dp"
        android:paddingHorizontal="@dimen/page_content_padding_horizontal_large"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/back"
            android:background="@drawable/icon_back_white"
            android:layout_width="@dimen/dimen_round_33.33dp"
            android:layout_height="@dimen/dimen_round_33.33dp"
            android:contentDescription="@string/back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/tab_bg"
            android:background="@drawable/edit_custom_tab_bg"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginHorizontal="@dimen/trail_customize_sport_report_share_tablayout_margin"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="3dp"
            app:layout_constraintBottom_toBottomOf="@+id/tab_bg"
            app:layout_constraintEnd_toEndOf="@+id/tab_bg"
            app:layout_constraintStart_toStartOf="@+id/tab_bg"
            app:layout_constraintTop_toTopOf="@+id/tab_bg"
            app:tabGravity="fill"
            app:tabIndicator="@drawable/edit_custom_tab_item_bg"
            app:tabIndicatorColor="#2d2d2d"
            app:tabIndicatorGravity="stretch"
            app:tabMode="fixed"
            app:tabRippleColor="@null"
            app:tabSelectedTextColor="@color/white"
            app:tabTextColor="#88ffffff"/>
        <TextView
            android:textSize="@dimen/dimen_12sp"
            android:textColor="@color/colorPrimary"
            android:gravity="end"
            android:id="@+id/preview_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/trail_preview"
            android:layout_marginStart="@dimen/dimen_margin_10dp"
            app:layout_constraintBottom_toBottomOf="@+id/back"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tab_bg"
            app:layout_constraintTop_toTopOf="@+id/back"
            style="@style/FontMedium"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/view_pager_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_margin_0dp"
        android:layout_marginTop="@dimen/dimen_margin_10dp"
        android:layout_marginBottom="246dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_bar">
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/view_pager"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="horizontal"
        android:id="@+id/bottom_window_recycler"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_margin_26dp"
        android:contentDescription="switch window mode"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@+id/sport_record_edit_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.xiaomi.fitness.detail.view.SportShareEditView
        android:id="@+id/sport_record_edit_view"
        android:background="@drawable/sport_detail_item_black_bg"
        android:layout_width="match_parent"
        android:layout_height="230dp"
        android:layout_marginHorizontal="@dimen/dimen_margin_25dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <include
        android:id="@+id/share_panel"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        layout="@layout/sport_report_share_dark_bottom_share_panel"/>
</androidx.constraintlayout.widget.ConstraintLayout>
