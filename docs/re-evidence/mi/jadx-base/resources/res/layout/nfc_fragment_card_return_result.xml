<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutView"
    android:tag="layout/nfc_fragment_card_return_result_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/page_content_padding_horizontal_large"
    android:paddingEnd="@dimen/page_content_padding_horizontal_large">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="@dimen/nfc_size_22"
        android:paddingBottom="@dimen/nfc_size_26_7"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/iconView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/nfc_size_91"
            android:src="@drawable/nfc_card_issue_success_big"/>
        <TextView
            android:textSize="@dimen/dimen_24sp"
            android:textStyle="bold"
            android:textColor="@color/nfc_color_7ED321"
            android:id="@+id/titleView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_30"
            android:text="@string/nfc_result_returncard_success"/>
        <TextView
            android:textSize="@dimen/nfc_font_14"
            android:textStyle="bold"
            android:textColor="@color/nfc_return_card_msg"
            android:id="@+id/descView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_10"/>
    </LinearLayout>
    <LinearLayout
        android:paddingBottom="@dimen/nfc_size_26_7"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <TextView
            android:textColor="@color/common_btn_normal_text_color"
            android:id="@+id/backView"
            android:layout_width="0dp"
            android:layout_marginBottom="0dp"
            android:text="@string/nfc_common_back"
            android:layout_weight="1"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="@dimen/nfc_size_6_68"
            style="@style/BaseButton.Native"/>
        <TextView
            android:id="@+id/retryOrFinishView"
            android:layout_width="0dp"
            android:layout_marginBottom="0dp"
            android:text="@string/nfc_common_retry"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/nfc_size_6_68"
            android:layout_marginEnd="0dp"
            style="@style/BaseButton.Positive"/>
    </LinearLayout>
</RelativeLayout>
