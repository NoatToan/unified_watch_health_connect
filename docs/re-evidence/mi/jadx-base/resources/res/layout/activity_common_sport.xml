<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_common_sport_0"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:tag="binding_1"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.mi.health.sport.AmapRealTimePathView
            android:id="@+id/amapRealTimePathView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="-40dp"
            app:layout_behavior="com.xiaomi.fitness.sport.view.behavior.MapViewBehavior"/>
        <include
            android:id="@+id/outdoor_running_title"
            layout="@layout/layout_outdoor_running_title"/>
        <androidx.core.widget.NestedScrollView
            android:id="@+id/mScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never"
            app:behavior_hideable="false"
            app:layout_behavior="@string/bottom_sheet_behavior">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:orientation="vertical"
                android:id="@+id/sport_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/running_posture"
                    android:background="@drawable/shape_00d393"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="109.3dp"
                    android:paddingStart="@dimen/dimen_margin_10dp"
                    android:paddingVertical="8dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <com.airbnb.lottie.LottieAnimationView
                        android:id="@+id/runningLottie"
                        android:layout_width="21.3dp"
                        android:layout_height="21.3dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:lottie_fileName="running.json"
                        app:lottie_loop="true"/>
                    <TextView
                        android:textSize="13.3dp"
                        android:textColor="@color/white"
                        android:gravity="center_vertical"
                        android:id="@+id/running_posture_arrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sport_running_form"
                        android:drawableEnd="@drawable/right_arrow_icon"
                        android:layout_marginStart="@dimen/dimen_margin_5dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/runningLottie"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/FontMedium"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <ImageView
                    android:id="@+id/locationBtn"
                    android:background="@drawable/sport_location"
                    android:layout_width="55dp"
                    android:layout_height="55dp"
                    android:layout_marginStart="@dimen/margin_15dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ImageView
                    android:id="@+id/noPlaylist"
                    android:background="@drawable/ic_no_playlist"
                    android:layout_width="85dp"
                    android:layout_height="85dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/locationBtn"/>
                <ImageView
                    android:id="@+id/line"
                    android:background="@drawable/sport_route_bottom_sheet_handler"
                    android:visibility="gone"
                    android:layout_width="37.3dp"
                    android:layout_height="4dp"
                    app:layout_constraintBottom_toTopOf="@+id/sport_group"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/noPlaylist"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/sport_group"
                    android:tag="binding_2"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/line">
                    <com.xiaomi.fitness.sport.view.widget.RunningSportMusicView
                        android:id="@+id/running_music_view"
                        android:background="@drawable/shape_bg_common_running_music"
                        android:paddingBottom="40dp"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <View
                        android:id="@+id/placeholder_view"
                        android:background="@color/transparent"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <include
                        android:id="@+id/outdoor_data"
                        android:background="@drawable/shape_card_bg_normal"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        app:layout_constraintBottom_toTopOf="@+id/sport_command_view"
                        app:layout_constraintTop_toBottomOf="@+id/dataLine"
                        layout="@layout/view_outdoor_sport_data"/>
                    <ImageView
                        android:id="@+id/dataLine"
                        android:background="@drawable/sport_route_bottom_sheet_handler"
                        android:layout_width="37.3dp"
                        android:layout_height="4dp"
                        app:layout_constraintBottom_toTopOf="@+id/outdoor_data"
                        app:layout_constraintEnd_toEndOf="@+id/outdoor_data"
                        app:layout_constraintStart_toStartOf="@+id/outdoor_data"
                        app:layout_constraintTop_toBottomOf="@+id/placeholder_view"/>
                    <com.xiaomi.fitness.sport.view.widget.SportCommandView
                        android:id="@+id/sport_command_view"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/countdown"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="-40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
