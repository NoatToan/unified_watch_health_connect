<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:gravity="right"
        android:id="@+id/muscle_lint_ll"
        android:layout_width="wrap_content"
        android:layout_height="73dp"
        android:layout_marginRight="1dp">
        <TextView
            android:textSize="3.2sp"
            android:textColor="@color/text_color"
            android:gravity="bottom"
            android:id="@+id/shape_musule_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BMI"
            android:layout_alignParentBottom="true"/>
        <TextView
            android:textSize="3sp"
            android:textColor="@color/text_color_30"
            android:id="@+id/shape_bmi_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="9.8dp"
            android:text="18.5"
            android:layout_above="@+id/shape_musule_tv"/>
        <TextView
            android:textSize="3sp"
            android:textColor="@color/text_color_30"
            android:id="@+id/shape_bmi_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24.7dp"
            android:text="24.0"
            android:layout_above="@+id/shape_bmi_1"/>
    </RelativeLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_body_shape"
        android:layout_width="73dp"
        android:layout_height="73dp"
        android:layout_toRightOf="@+id/muscle_lint_ll"
        android:layout_alignTop="@+id/muscle_lint_ll">
        <com.xiaomi.fitness.electronic.scale.widget.BodyShapeDiagram
            android:id="@+id/diagram_body_shape"
            android:layout_width="73dp"
            android:layout_height="73dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="3.7sp"
            android:textColor="@color/text_color_30"
            android:id="@+id/tv_athlete_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginBottom="55dp"
            android:text="@string/electronic_scale_athlete_type"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:textSize="3.7sp"
            android:textColor="@color/text_color_30"
            android:id="@+id/tv_muscle_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="13dp"
            android:layout_marginBottom="35dp"
            android:text="@string/electronic_scale_muscle_type"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:textSize="3.7sp"
            android:textColor="@color/text_color_30"
            android:id="@+id/tv_muscle_slim_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="3.1dp"
            android:layout_marginBottom="19.3dp"
            android:text="@string/electronic_scale_muscle_slim_type"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:textSize="3.7sp"
            android:textColor="@color/text_color_30"
            android:id="@+id/tv_emaciated_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8.3dp"
            android:layout_marginBottom="5dp"
            android:text="@string/electronic_scale_emaciated_type"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:textSize="3.7sp"
            android:textColor="@color/text_color_30"
            android:id="@+id/tv_lean_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32.9dp"
            android:layout_marginBottom="5dp"
            android:text="@string/electronic_scale_lean_type"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:textSize="3.7sp"
            android:textColor="@color/text_color_30"
            android:id="@+id/tv_slimline_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="26.5dp"
            android:layout_marginBottom="20dp"
            android:text="@string/electronic_scale_slimline_type"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:textSize="3.7sp"
            android:textColor="@color/text_color_30"
            android:id="@+id/tv_healthy_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="41.8dp"
            android:layout_marginBottom="22.3dp"
            android:text="@string/electronic_scale_healthy_type"
            android:ems="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:textSize="3.7sp"
            android:textColor="@color/text_color_30"
            android:id="@+id/tv_scale_overweight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="45.2dp"
            android:layout_marginBottom="48.1dp"
            android:text="@string/electronic_scale_overweight"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:textSize="3.7sp"
            android:textColor="@color/text_color_30"
            android:id="@+id/tv_scale_obesity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="50.1dp"
            android:layout_marginBottom="60.4dp"
            android:text="@string/electronic_scale_obesity"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:textSize="3.7sp"
            android:textColor="@color/text_color_30"
            android:id="@+id/tv_invisible_obesity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="57.9dp"
            android:layout_marginBottom="6.9dp"
            android:text="@string/electronic_scale_invisible_obesity"
            android:ems="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <RelativeLayout
        android:layout_width="68dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:layout_below="@+id/cl_body_shape"
        android:layout_alignLeft="@+id/cl_body_shape">
        <TextView
            android:textSize="3.2sp"
            android:textColor="@color/text_color"
            android:id="@+id/shape_fat_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/electronic_scale_fat_ratio"/>
        <TextView
            android:textSize="3sp"
            android:textColor="@color/text_color_30"
            android:id="@+id/shape_fat_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="14.5dp"
            android:text="10%"
            android:layout_toRightOf="@+id/shape_fat_tv"/>
        <TextView
            android:textSize="3sp"
            android:textColor="@color/text_color_30"
            android:id="@+id/shape_fat_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="18dp"
            android:text="20%"
            android:layout_toRightOf="@+id/shape_fat_1"/>
    </RelativeLayout>
</RelativeLayout>
