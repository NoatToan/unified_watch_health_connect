<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/containnerView"
    android:background="@drawable/nfc_coupon_list_item_bg"
    android:layout_width="match_parent"
    android:layout_height="95dp"
    android:paddingHorizontal="24dp"
    android:paddingVertical="17dp">
    <TextView
        android:textSize="29sp"
        android:textColor="@color/text_color"
        android:id="@+id/amountView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="22sp"
        android:textColor="@color/text_color"
        android:id="@+id/titleView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="36dp"
        app:layout_constraintBaseline_toBaselineOf="@+id/amountView"
        app:layout_constraintEnd_toStartOf="@+id/selectView"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/text_color_40"
        android:id="@+id/descView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@+id/amountView"
        app:layout_constraintTop_toBottomOf="@+id/amountView"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/text_color_40"
        android:id="@+id/timeView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBaseline_toBaselineOf="@+id/descView"
        app:layout_constraintEnd_toEndOf="@+id/titleView"/>
    <ImageView
        android:id="@+id/selectView"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/selector_check"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
