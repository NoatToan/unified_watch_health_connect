<?xml version="1.0" encoding="utf-8"?>
<miuix.springback.view.SpringBackLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/notify_fragment_call_notify_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:scrollableView="@+id/spring_back_target">
    <miuix.core.widget.NestedScrollView
        android:id="@+id/spring_back_target"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/text_color_40"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/notify_call_notify_notice"
                android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
                android:layout_marginEnd="@dimen/page_content_padding_horizontal_large"/>
            <com.xiaomi.fitness.widget.SwitchButtonTwoLineTextView
                android:id="@+id/btn_call_notify_open"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/page_content_padding_horizontal_large"
                android:paddingEnd="@dimen/page_content_padding_horizontal_large"
                app:singleLineTitle="false"
                app:subtitle="@string/notify_call_notify_open_notice"
                app:title="@string/notify_call_notify_open"/>
            <com.xiaomi.fitness.widget.SwitchButtonSingleLineTextView
                android:id="@+id/btn_strange_no_notify"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/page_content_padding_horizontal_large"
                android:paddingEnd="@dimen/page_content_padding_horizontal_large"
                app:title="@string/notify_call_notify_strange_no"/>
            <com.xiaomi.fitness.widget.SwitchButtonTwoLineTextView
                android:id="@+id/btn_call_notify_for_phone_state"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/page_content_padding_horizontal_large"
                android:paddingEnd="@dimen/page_content_padding_horizontal_large"
                app:singleLineTitle="false"
                app:subtitle="@string/notify_call_notify_for_phone_state_des"
                app:title="@string/notify_call_notify_for_phone_state"/>
            <com.xiaomi.fitness.widget.SwitchButtonTwoLineTextView
                android:id="@+id/btn_call_notify_show_name"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/page_content_padding_horizontal_large"
                android:paddingEnd="@dimen/page_content_padding_horizontal_large"
                app:singleLineTitle="false"
                app:subtitle="@string/notify_call_notify_show_name_notice"
                app:title="@string/notify_call_notify_show_name"/>
            <com.xiaomi.fitness.widget.SwitchButtonSingleLineTextView
                android:id="@+id/sms_reply_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/page_content_padding_horizontal_large"
                android:paddingEnd="@dimen/page_content_padding_horizontal_large"
                app:title="@string/notify_call_notify_sms_reply"/>
            <com.xiaomi.fitness.widget.RightArrowSingleLineTextView
                android:id="@+id/sms_manage_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/page_content_padding_horizontal_large"
                android:paddingEnd="@dimen/page_content_padding_horizontal_large"
                app:title="@string/notify_call_notify_sms_manage"/>
            <com.xiaomi.fitness.widget.SwitchButtonSingleLineTextView
                android:id="@+id/delay_notice_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/page_content_padding_horizontal_large"
                android:paddingEnd="@dimen/page_content_padding_horizontal_large"
                app:title="@string/notify_call_notify_delay_notice"/>
            <com.xiaomi.fitness.widget.RightArrowSingleLineTextView
                android:id="@+id/delay_time_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/page_content_padding_horizontal_large"
                android:paddingEnd="@dimen/page_content_padding_horizontal_large"
                app:title="@string/notify_call_notify_delay_time"/>
        </LinearLayout>
    </miuix.core.widget.NestedScrollView>
</miuix.springback.view.SpringBackLayout>
