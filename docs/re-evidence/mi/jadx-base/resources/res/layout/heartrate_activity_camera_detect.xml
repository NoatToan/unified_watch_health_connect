<?xml version="1.0" encoding="utf-8"?>
<miuix.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/heartrate_activity_camera_detect_0"
    android:scrollbars="none"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center_horizontal"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:keepScreenOn="true">
        <include
            android:id="@+id/layout_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22.67dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            layout="@layout/heartrate_layout_camera_detecting_title"/>
        <include
            android:id="@+id/layout_camera_preview"
            android:layout_width="match_parent"
            android:layout_height="326.6641dp"
            android:layout_marginTop="@dimen/hr_cam_video_margin_top"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/layout_title"
            layout="@layout/heartrate_layout_camera_circle_preview"/>
        <include
            android:id="@+id/layout_camera_img_anim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/hr_cam_video_margin_top"
            android:layout_marginBottom="@dimen/dimen_margin_12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/layout_title"
            layout="@layout/heartrate_layout_camera_img_anim"/>
        <include
            android:id="@+id/layout_camera_detect_finished"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            layout="@layout/heartrate_layout_camera_detect_finished"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</miuix.core.widget.NestedScrollView>
