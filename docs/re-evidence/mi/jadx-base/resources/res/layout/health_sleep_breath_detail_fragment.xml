<?xml version="1.0" encoding="utf-8"?>
<miuix.springback.view.SpringBackLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:scrollableView="@+id/spring_back_target">
    <miuix.core.widget.NestedScrollView
        android:id="@+id/spring_back_target"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@color/health_sleep_breath_quality_bg_color"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/page_padding_horizontal_large">
            <androidx.cardview.widget.CardView
                android:id="@+id/sleep_breath_quality"
                android:background="@color/red"
                android:paddingTop="@dimen/size_25"
                android:paddingBottom="@dimen/size_30"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="168.3dp"
                app:cardCornerRadius="@dimen/size_10"
                app:cardElevation="0dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/sleep_breath_quality_layout"
                    android:background="@color/health_sleep_background_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/size_18">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:orientation="horizontal"
                        android:id="@+id/icon_title_line"
                        android:background="@color/health_sleep_background_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_20dp"
                        android:layout_marginBottom="@dimen/size_12"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <ImageView
                            android:gravity="center_vertical"
                            android:id="@+id/icon"
                            android:background="@drawable/ic_sleep_breath"
                            android:layout_width="@dimen/dimen_margin_30dp"
                            android:layout_height="@dimen/dimen_margin_30dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <TextView
                            android:textSize="@dimen/dimen_14sp"
                            android:textColor="@color/text_color"
                            android:gravity="center_vertical"
                            android:id="@+id/title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/health_sleep_breath_quality"
                            android:layout_marginStart="10dp"
                            app:layout_constraintStart_toEndOf="@+id/icon"
                            app:layout_constraintTop_toTopOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:orientation="horizontal"
                        android:id="@+id/sleep_breath_quality_score_line"
                        android:background="@color/health_sleep_background_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/size_12"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/icon_title_line">
                        <TextView
                            android:textSize="@dimen/font_33_3"
                            android:textColor="@color/text_color"
                            android:id="@+id/sleep_breath_quality_score"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="82分"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <TextView
                        android:textSize="@dimen/font_12"
                        android:textColor="@color/text_color_80"
                        android:id="@+id/health_sleep_breath_quality_hint"
                        android:background="@color/health_sleep_background_card"
                        android:paddingBottom="@dimen/size_20"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimen_margin_10dp"
                        android:text="@string/health_sleep_breath_quality_hint"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/sleep_breath_quality_score_line"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:id="@+id/sleep_breath_essay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_12dp"
                app:cardCornerRadius="@dimen/size_10"
                app:cardElevation="0dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/sleep_breath_quality">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:background="@color/health_sleep_background_card"
                    android:paddingTop="@dimen/size_20"
                    android:paddingBottom="@dimen/size_20"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/size_18">
                    <TextView
                        android:textColor="@color/text_color"
                        android:id="@+id/sleep_breath_essay1_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/health_sleep_breath_essay1_title"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/FontMedium.14sp"/>
                    <TextView
                        android:textSize="@dimen/font_14"
                        android:textColor="@color/text_color_80"
                        android:id="@+id/sleep_breath_essay1_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimen_margin_10dp"
                        android:text="@string/health_sleep_breath_essay1_content"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/sleep_breath_essay1_title"/>
                    <TextView
                        android:textColor="@color/text_color"
                        android:id="@+id/sleep_breath_essay2_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_20dp"
                        android:text="@string/health_sleep_breath_essay2_title"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/sleep_breath_essay1_content"
                        style="@style/FontMedium.14sp"/>
                    <TextView
                        android:textSize="@dimen/font_14"
                        android:textColor="@color/text_color_80"
                        android:id="@+id/sleep_breath_essay2_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimen_margin_10dp"
                        android:text="@string/health_sleep_breath_essay2_content"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/sleep_breath_essay2_title"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </miuix.core.widget.NestedScrollView>
</miuix.springback.view.SpringBackLayout>
