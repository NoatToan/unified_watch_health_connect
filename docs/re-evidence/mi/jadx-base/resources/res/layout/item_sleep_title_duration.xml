<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/selector_card_bg"
    android:paddingTop="@dimen/size_20"
    android:paddingBottom="@dimen/size_20"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/size_13"
    android:paddingStart="@dimen/size_18">
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/iv_icon"
        android:background="@drawable/ic_sleep_manual"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:layout_marginStart="@dimen/size_18"/>
    <TextView
        android:textColor="@color/text_color"
        android:gravity="start"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingEnd="@dimen/size_20"
        style="@style/FontMedium.14sp"/>
    <TextView
        android:textColor="@color/text_color_40"
        android:id="@+id/tv_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingEnd="@dimen/size_20"
        style="@style/FontRegular.12sp"/>
</LinearLayout>
