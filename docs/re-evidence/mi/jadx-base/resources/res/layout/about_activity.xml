<?xml version="1.0" encoding="utf-8"?>
<miuix.springback.view.SpringBackLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/about_activity_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:scrollableView="@+id/spring_back_target">
    <miuix.core.widget.NestedScrollView
        android:id="@+id/spring_back_target"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/about_cl_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_28dp"
            android:paddingHorizontal="@dimen/page_content_padding_horizontal_large">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/img_view"
                android:layout_width="@dimen/about_margin_100dp"
                android:layout_height="@dimen/about_margin_100dp"
                android:importantForAccessibility="no"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textStyle="bold"
                android:gravity="center_horizontal"
                android:id="@+id/text_view_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_10dp"
                android:text="@string/about_sport_health"
                app:layout_constraintEnd_toStartOf="parent"
                app:layout_constraintStart_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/img_view"
                style="@style/FontNormal.20sp"/>
            <TextView
                android:textColor="@color/about_black_40"
                android:gravity="center_horizontal"
                android:id="@+id/text_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_10dp"
                app:layout_constraintEnd_toStartOf="parent"
                app:layout_constraintStart_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/text_view_title"
                style="@style/FontNormal.14sp"/>
            <TextView
                android:textColor="@color/about_black_40"
                android:gravity="center_horizontal"
                android:autoLink="all"
                android:id="@+id/recordNumberLableView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_5dp"
                app:layout_constraintEnd_toStartOf="parent"
                app:layout_constraintStart_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/text_view"
                style="@style/FontNormal.14sp"/>
            <View
                android:id="@+id/divider_line"
                android:background="@color/about_item_divide_color"
                android:layout_width="match_parent"
                android:layout_height="@dimen/about_item_divide_height"
                android:layout_marginTop="@dimen/dimen_margin_40dp"
                android:layout_marginStart="@dimen/dimen_margin_20dp"
                android:layout_marginEnd="@dimen/dimen_margin_20dp"
                app:layout_constraintBottom_toTopOf="@+id/about_right_switch_layout"
                app:layout_constraintTop_toBottomOf="@+id/text_view"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/about_right_switch_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_30dp"
                app:layout_constraintTop_toBottomOf="@+id/divider_line">
                <com.xiaomi.fitness.widget.RightArrowBindingSingleLineTextView
                    android:id="@+id/comment_go"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:showMore="true"
                    app:title="@string/about_comment_go"/>
                <com.xiaomi.fitness.widget.RightArrowBindingSingleLineTextView
                    android:id="@+id/common_agreement"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/comment_go"
                    app:showMore="true"
                    app:title="@string/about_privacy_license_agreement"/>
                <com.xiaomi.fitness.widget.RightArrowBindingSingleLineTextView
                    android:id="@+id/common_privacy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/common_agreement"
                    app:showMore="true"
                    app:title="@string/about_common_user_privacy_agreement"/>
                <com.xiaomi.fitness.widget.RightArrowBindingSingleLineTextView
                    android:id="@+id/common_privacy_brief"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/common_privacy"
                    app:showMore="true"
                    app:title="@string/about_common_user_privacy_agreement_brief"/>
                <com.xiaomi.fitness.widget.RightArrowBindingSingleLineTextView
                    android:id="@+id/privacy_experience"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/common_privacy_brief"
                    app:showMore="true"
                    app:title="@string/about_privacy_experience_program_title"/>
                <com.xiaomi.fitness.widget.RightArrowBindingSingleLineTextView
                    android:id="@+id/collect_personal_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/privacy_experience"
                    app:showMore="true"
                    app:title="@string/about_collected_personal_info_list"/>
                <com.xiaomi.fitness.widget.RightArrowBindingSingleLineTextView
                    android:id="@+id/third_party_shared_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/collect_personal_list"
                    app:showMore="true"
                    app:title="@string/about_third_party_shared_personal_info_list"/>
                <com.xiaomi.fitness.widget.RightArrowBindingSingleLineTextView
                    android:id="@+id/sensitive_protocol_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/third_party_shared_list"
                    app:showMore="true"
                    app:title="@string/about_privacy_sensitive_protocol_title"/>
                <com.xiaomi.fitness.widget.RightArrowBindingSingleLineTextView
                    android:id="@+id/workout_safety_precaution_and_warning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/sensitive_protocol_view"
                    app:showMore="true"
                    app:title="@string/about_workout_safety_precaution_and_warning"/>
                <com.xiaomi.fitness.widget.RightArrowBindingTwoLineTextView
                    android:id="@+id/app_privacy_revoke_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/workout_safety_precaution_and_warning"
                    app:remindTextEnable="true"
                    app:subtitle="@string/about_privacy_revoke_des"
                    app:title="@string/about_setting_privacy_revoke"/>
                <com.xiaomi.fitness.widget.SwitchButtonBindingTwoLineTextView
                    android:id="@+id/set_experience_plan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/app_privacy_revoke_view"
                    app:singleLineTitle="false"
                    app:subtitle="@string/about_privacy_improvement_desc"/>
                <com.xiaomi.fitness.widget.SwitchButtonBindingTwoLineTextView
                    android:id="@+id/set_not_upload_gps"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/set_experience_plan"
                    app:subtitle="@string/about_setting_not_upload_gps_detail"
                    app:title="@string/about_setting_not_upload_gps"/>
                <com.xiaomi.fitness.widget.RightArrowBindingSingleLineTextView
                    android:id="@+id/log_off"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/set_not_upload_gps"
                    app:title="@string/about_log_off_account"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </miuix.core.widget.NestedScrollView>
</miuix.springback.view.SpringBackLayout>
