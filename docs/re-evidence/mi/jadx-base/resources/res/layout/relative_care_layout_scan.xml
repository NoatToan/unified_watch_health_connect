<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/relative_care_layout_scan_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <SurfaceView
        android:id="@+id/surfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.xiaomi.fitness.widget.view.ViewfinderView
        android:id="@+id/viewfinderView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:labelTextColor="@color/white"
        app:labelTextLocation="bottom"
        app:labelTextSize="12sp"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/ivTorch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp"
        android:src="@drawable/zxl_torch_selector"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:layout_marginStart="@dimen/top_bar_ege_margin"
        app:layout_constraintTop_toTopOf="parent">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="50dp">
            <ImageView
                android:layout_gravity="start|center_vertical"
                android:id="@+id/title_bar_left_icon"
                android:layout_width="@dimen/top_bar_icon_size"
                android:layout_height="@dimen/top_bar_icon_size"
                android:src="@drawable/icon_left_back_white"
                android:scaleType="centerCrop"/>
        </FrameLayout>
        <TextView
            android:textSize="29.33sp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/title_bar_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12.66dp"
            android:singleLine="true"
            android:textDirection="locale"
            android:layout_marginStart="5dp"
            style="@style/FontRegular"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/dimen_16sp"
        android:textColor="@color/text_revert_color"
        android:gravity="center"
        android:id="@+id/choose_from_gallery"
        android:background="@drawable/relative_care_scan_button"
        android:layout_width="306.6641dp"
        android:layout_height="@dimen/common_btn_height"
        android:layout_marginBottom="@dimen/dimen_margin_10dp"
        android:text="@string/relative_care_choose_from_gallery"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/my_qr_code"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="@dimen/dimen_16sp"
        android:textColor="@color/text_revert_color"
        android:gravity="center"
        android:id="@+id/my_qr_code"
        android:background="@drawable/relative_care_scan_button"
        android:layout_width="306.6641dp"
        android:layout_height="@dimen/common_btn_height"
        android:layout_marginBottom="26.67dp"
        android:text="@string/relative_care_my_qr_code"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
