<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <ImageView
        android:id="@+id/delete"
        android:padding="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_common_item_delete"
        android:layout_centerVertical="true"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/switch_black"
        android:ellipsize="end"
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:maxLines="1"
        android:layout_alignParentTop="true"
        android:layout_marginEnd="78dp"
        android:layout_toStartOf="@+id/swipe"
        android:layout_toEndOf="@+id/delete"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/white"
        android:id="@+id/market"
        android:background="@drawable/bg_stock_market"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="12dp"
        android:layout_below="@+id/name"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:layout_toEndOf="@+id/delete"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#999999"
        android:ellipsize="end"
        android:id="@+id/symbol"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_alignBaseline="@+id/market"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="78dp"
        android:layout_toStartOf="@+id/swipe"
        android:layout_toEndOf="@+id/market"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/switch_black"
        android:id="@+id/price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginEnd="92dp"
        android:layout_toStartOf="@+id/arrow"/>
    <TextView
        android:textSize="13sp"
        android:textColor="#de342b"
        android:id="@+id/increase"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginEnd="52dp"
        android:layout_toStartOf="@+id/arrow"/>
    <TextView
        android:textSize="13sp"
        android:textColor="#de342b"
        android:id="@+id/increase_percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginEnd="4dp"
        android:layout_toStartOf="@+id/arrow"/>
    <ImageView
        android:id="@+id/arrow"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_stock_up_arrow"
        android:layout_centerVertical="true"
        android:layout_marginEnd="4dp"
        android:layout_toStartOf="@+id/swipe"/>
    <ImageView
        android:id="@+id/swipe"
        android:padding="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_common_item_sort"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
