<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:background="@drawable/widget_default_corners_background_12_67"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/widgetStepDefaultImage"
        android:background="@drawable/widget_step_2_2_no_grant_drawable"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToOutline="true">
        <ImageView
            android:layout_gravity="bottom"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/widget_step_default_412x412px_20corner"
            android:scaleType="fitEnd"
            android:adjustViewBounds="true"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@android:id/widget_frame"
        android:paddingTop="12dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="13dp">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="62">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/widgetStepDefaultTextLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/text_color"
                    android:gravity="start|center_vertical"
                    android:id="@+id/widgetStepTitle16"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:text="@string/provider_step_label"
                    android:layout_weight="16"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="2sp"
                    android:autoSizeMaxTextSize="16sp"
                    android:textFontWeight="600"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/text_color_40"
                    android:gravity="start|center_vertical"
                    android:id="@+id/widgetStepSubTitle"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:text="@string/click_to_record"
                    android:layout_weight="16"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="2sp"
                    android:autoSizeMaxTextSize="12sp"
                    android:textFontWeight="450"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/widgetStepTextLayout"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/text_color"
                    android:gravity="start|center_vertical"
                    android:id="@+id/widgetStepTitle"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:text="@string/provider_step_label"
                    android:layout_weight="16"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="2sp"
                    android:autoSizeMaxTextSize="13sp"
                    android:textFontWeight="600"/>
                <TextView
                    android:textSize="26sp"
                    android:textColor="@color/text_color"
                    android:gravity="start|center_vertical"
                    android:id="@+id/widgetStepValue"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="-1.5dp"
                    android:text="--"
                    android:maxLines="1"
                    android:layout_weight="30"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="2sp"
                    android:autoSizeMaxTextSize="26sp"
                    android:textFontWeight="600"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/text_color_60"
                    android:gravity="start|center_vertical"
                    android:id="@+id/widgetStepGoal"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="1.5dp"
                    android:maxLines="1"
                    android:layout_weight="16"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="2sp"
                    android:autoSizeMaxTextSize="13sp"
                    android:textFontWeight="380"/>
            </LinearLayout>
            <FrameLayout
                android:id="@+id/widgetStepRingImage"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp">
                <ImageView
                    android:id="@+id/iv_ring_image"
                    android:layout_width="@dimen/widget_normal_step_ring_size"
                    android:layout_height="@dimen/widget_normal_step_ring_size"
                    android:src="@drawable/ic_widget_step_yellow_ring_loading"
                    android:importantForAccessibility="no"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/iv_step_image"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_widget_step_icon_loading"
                    android:importantForAccessibility="no"/>
            </FrameLayout>
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="8"/>
        <LinearLayout
            android:gravity="bottom"
            android:orientation="vertical"
            android:id="@+id/barChartLayout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="60">
            <ImageView
                android:id="@+id/barChartImage"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:scaleType="fitXY"
                android:minHeight="50dp"
                android:layout_weight="40"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/xAxisView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="4dp"
                android:layout_weight="12"
                android:layoutDirection="ltr">
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/text_color_30"
                    android:gravity="start|center_vertical"
                    android:id="@+id/txt1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/data_xaxis_time_0"
                    android:layout_weight="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="2sp"
                    android:autoSizeMaxTextSize="10sp"
                    android:textFontWeight="380"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/text_color_30"
                    android:gravity="end|center_vertical"
                    android:id="@+id/txt3"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/data_xaxis_time_24"
                    android:layout_weight="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="2sp"
                    android:autoSizeMaxTextSize="10sp"
                    android:textFontWeight="380"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
