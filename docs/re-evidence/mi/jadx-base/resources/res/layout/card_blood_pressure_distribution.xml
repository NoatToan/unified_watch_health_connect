<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="@dimen/size_30"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_20"
        android:layout_marginStart="@dimen/size_18"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_blood_pressure_distribution"/>
    <TextView
        android:id="@+id/tv_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/health_blood_pressure_distribution"
        android:layout_marginStart="@dimen/size_10"
        app:layout_constraintBottom_toBottomOf="@+id/iv_icon"
        app:layout_constraintStart_toEndOf="@+id/iv_icon"
        app:layout_constraintTop_toTopOf="@+id/iv_icon"
        style="@style/CardTextAppearance.LabelTitle"/>
    <View
        android:id="@+id/divider_line"
        android:background="@color/common_divider_bg_color"
        android:layout_width="0dp"
        android:layout_height="@dimen/size_0_33"
        android:layout_marginTop="@dimen/size_20"
        android:layout_marginStart="@dimen/size_18"
        android:layout_marginEnd="@dimen/size_18"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_icon"/>
    <RelativeLayout
        android:id="@+id/rl_distribute"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_20"
        android:layout_marginTop="@dimen/size_30"
        android:layout_marginStart="@dimen/size_18"
        android:layout_marginEnd="@dimen/size_18"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider_line">
        <com.xiaomi.fitness.baseui.widget.DistributeView
            android:id="@+id/distributeView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"/>
        <com.xiaomi.fitness.baseui.widget.CircularCoverView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            app:cover_color="@color/common_circular_cover_bg_color"
            app:left_bottom_radius="@dimen/dimen_margin_10dp"
            app:left_top_radius="@dimen/dimen_margin_10dp"
            app:right_bottom_radius="@dimen/dimen_margin_10dp"
            app:right_top_radius="@dimen/dimen_margin_10dp"/>
    </RelativeLayout>
    <View
        android:id="@+id/divider_line_vertical"
        android:background="@color/common_divider_bg_color"
        android:layout_width="@dimen/size_0_33"
        android:layout_height="@dimen/size_36"
        android:layout_marginTop="@dimen/size_39_3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rl_distribute"/>
    <include
        android:id="@+id/layout_low_item"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_30"
        android:layout_marginStart="@dimen/size_18"
        app:layout_constraintEnd_toEndOf="@+id/divider_line_vertical"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rl_distribute"
        layout="@layout/item_blood_pressure_distribution"/>
    <include
        android:id="@+id/layout_middle_item"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_30"
        android:layout_marginStart="@dimen/size_18"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/divider_line_vertical"
        app:layout_constraintTop_toBottomOf="@+id/rl_distribute"
        layout="@layout/item_blood_pressure_distribution"/>
    <include
        android:id="@+id/layout_high_item"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_30"
        android:layout_marginStart="@dimen/size_18"
        app:layout_constraintEnd_toEndOf="@+id/divider_line_vertical"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_low_item"
        layout="@layout/item_blood_pressure_distribution"/>
</androidx.constraintlayout.widget.ConstraintLayout>
