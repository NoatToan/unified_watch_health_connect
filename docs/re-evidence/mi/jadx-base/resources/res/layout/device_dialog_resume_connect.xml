<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:tag="layout/device_dialog_resume_connect_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/text_size_16"
            android:textColor="@color/text_color"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/device_resume_connect_dialog_desc"
            android:layout_marginStart="@dimen/dimen_margin_40dp"
            android:layout_marginEnd="@dimen/dimen_margin_40dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/text_size_16"
            android:textStyle="bold"
            android:textColor="@color/text_color"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_16dp"
            android:text="@string/device_resume_connect_step_one"
            android:layout_marginStart="@dimen/dimen_margin_40dp"
            android:layout_marginEnd="@dimen/dimen_margin_40dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/text_size_16"
            android:textColor="@color/text_color"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/device_resume_connect_first_content"
            android:layout_marginStart="@dimen/dimen_margin_40dp"
            android:layout_marginEnd="@dimen/dimen_margin_40dp"/>
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_16dp"
            android:layout_marginStart="@dimen/dimen_margin_40dp"
            android:layout_marginEnd="@dimen/dimen_margin_40dp">
            <ImageView
                android:background="@drawable/device_bluetooth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <TextView
                android:textColor="@color/text_color"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/device_resume_connect_bluetooth"
                android:layout_marginStart="@dimen/dimen_margin_30dp"/>
        </FrameLayout>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/text_size_16"
            android:textStyle="bold"
            android:textColor="@color/text_color"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_16dp"
            android:text="@string/device_resume_connect_step_two"
            android:layout_marginStart="@dimen/dimen_margin_40dp"
            android:layout_marginEnd="@dimen/dimen_margin_40dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/text_size_16"
            android:textColor="@color/text_color"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/device_resume_connect_third_content"
            android:layout_marginStart="@dimen/dimen_margin_40dp"
            android:layout_marginEnd="@dimen/dimen_margin_40dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/text_size_16"
            android:textStyle="bold"
            android:textColor="@color/text_color"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_16dp"
            android:text="@string/device_resume_connect_step_three"
            android:layout_marginStart="@dimen/dimen_margin_40dp"
            android:layout_marginEnd="@dimen/dimen_margin_40dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/text_size_16"
            android:textColor="@color/text_color"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/device_resume_connect_second_content"
            android:layout_marginStart="@dimen/dimen_margin_40dp"
            android:layout_marginEnd="@dimen/dimen_margin_40dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/text_size_16"
            android:textColor="@color/text_color"
            android:id="@+id/resume_connect_tip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_20dp"
            android:layout_marginStart="@dimen/dimen_margin_40dp"
            android:layout_marginEnd="@dimen/dimen_margin_40dp"/>
    </LinearLayout>
</ScrollView>
