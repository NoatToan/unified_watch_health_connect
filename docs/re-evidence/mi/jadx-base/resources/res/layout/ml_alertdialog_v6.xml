<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/ml_alertdialog_parentPanel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ml_alertdialog_topPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/dimen_margin_40dp">
        <LinearLayout
            android:gravity="start|center_vertical"
            android:orientation="vertical"
            android:id="@+id/ml_alertdialog_title_template"
            android:paddingTop="26.66dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.xiaomi.fitness.baseui.widget.MLTextView
                android:textSize="16sp"
                android:textColor="@color/text_color"
                android:gravity="center"
                android:id="@+id/ml_alertdialog_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""/>
            <com.xiaomi.fitness.baseui.widget.MLTextView
                android:textSize="16sp"
                android:textColor="@color/text_color_50"
                android:gravity="center"
                android:id="@+id/ml_alertdialog_sub_title"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text=""/>
        </LinearLayout>
    </LinearLayout>
    <View
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dimen_margin_16dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ml_alertdialog_contentPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <ScrollView
            android:id="@+id/ml_alertdialog_scrollView"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ml_alertdialog_message_linear"
                android:paddingBottom="3.33dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dimen_margin_40dp"
                android:layout_marginEnd="@dimen/dimen_margin_40dp">
                <com.xiaomi.fitness.baseui.widget.MLTextView
                    android:textSize="@dimen/dimen_16sp"
                    android:textColor="@color/text_color"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/ml_alertdialog_third_title"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/dimen_margin_10dp"
                    android:text=""
                    android:lineSpacingExtra="3dp"/>
                <com.xiaomi.fitness.baseui.widget.MLTextView
                    android:textSize="@dimen/dimen_16sp"
                    android:textColor="@color/text_color"
                    android:gravity="start"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/ml_alertdialog_message"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""/>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/ml_alertdialog_customPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <RelativeLayout
            android:gravity="center"
            android:id="@+id/ml_alertdialog_custom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <include layout="@layout/ml_alertdialog_v6_bottom_btns_layout"/>
</LinearLayout>
