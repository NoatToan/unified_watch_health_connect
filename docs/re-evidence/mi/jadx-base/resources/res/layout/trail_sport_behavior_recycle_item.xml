<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/dimen_margin_20dp">
    <TextView
        android:textSize="@dimen/font_22"
        android:id="@+id/txt_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:layout_alignParentTop="true"
        android:layout_marginStart="@dimen/dimen_margin_18dp"
        android:layout_alignParentStart="true"
        style="@style/FontLatinMedium"/>
    <TextView
        android:textSize="@dimen/font_12"
        android:textColor="@color/text_color"
        android:id="@+id/txt_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:layout_alignBaseline="@+id/txt_value"
        android:layout_alignParentTop="true"
        android:layout_marginStart="@dimen/dimen_margin_2dp"
        android:layout_toEndOf="@+id/txt_value"
        style="@style/FontMedium.12sp"/>
    <TextView
        android:textSize="@dimen/font_12"
        android:textColor="@color/text_color_40"
        android:id="@+id/txt_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:layout_below="@+id/txt_value"
        android:layout_marginStart="@dimen/dimen_margin_18dp"
        android:layout_alignParentStart="true"
        style="@style/FontRegular.12sp"/>
</RelativeLayout>
