<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/relative_care_confirm_user_info_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/page_content_padding_horizontal_large"
            app:layout_constraintTop_toTopOf="parent">
            <com.xiaomi.fitness.widget.view.RoundImageView
                android:id="@+id/relative_avatar"
                android:layout_width="@dimen/dimen_margin_40dp"
                android:layout_height="@dimen/dimen_margin_40dp"
                android:importantForAccessibility="no"
                android:layout_marginVertical="@dimen/dimen_margin_20dp"
                app:innerStrokeWidth="@dimen/dimen_margin_1dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dimen_margin_16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/relative_avatar"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textColor="@color/selector_feature_item_title_text_color"
                    android:id="@+id/relative_username"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/FontMedium.16sp"/>
                <TextView
                    android:textColor="@color/selector_feature_item_subtitle_text_color"
                    android:id="@+id/xiaomi_account"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/relative_username"
                    style="@style/FontRegular.12sp"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:textSize="@dimen/dimen_16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/button"
            android:background="@drawable/selector_bottom_btn_positive_bg"
            android:layout_width="@dimen/common_btn_single_line_width"
            android:layout_height="@dimen/common_btn_height"
            android:layout_marginBottom="26.67dp"
            android:text="@string/relative_care_invite_them"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/relative_care_no_network_text_color"
        android:gravity="center_horizontal"
        android:id="@+id/no_network"
        android:visibility="gone"
        android:layout_width="100dp"
        android:layout_height="150dp"
        android:text="@string/relative_care_network_connection_failed_tip"
        android:drawableTop="@drawable/icon_no_network"
        android:drawablePadding="@dimen/dimen_margin_10dp"
        android:layout_centerInParent="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
