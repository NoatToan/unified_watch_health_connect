<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/health_activity_share_sport_target_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <miuix.miuixbasewidget.widget.FilterSortView
        android:theme="@style/FilterSortViewStyle"
        android:id="@+id/filterSortView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_10"
        android:layout_marginBottom="@dimen/size_10"
        android:layoutDirection="ltr"
        android:layout_marginStart="@dimen/common_set_margin_start"
        android:layout_marginEnd="@dimen/common_set_margin_start"/>
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/viewpager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"/>
</LinearLayout>
