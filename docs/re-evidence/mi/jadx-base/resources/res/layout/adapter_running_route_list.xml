<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/adapter_running_route_list_0"
    android:padding="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/route_icon"
        android:background="@drawable/shape_bottom_btn_bg_disable"
        android:layout_width="82dp"
        android:layout_height="82dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/recommend_icon_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="@+id/route_icon"
        app:layout_constraintTop_toTopOf="@+id/route_icon">
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:cardCornerRadius="4dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/recommend_icon"
            app:layout_constraintLeft_toLeftOf="@+id/recommend_icon"
            app:layout_constraintRight_toRightOf="@+id/recommend_icon"
            app:layout_constraintTop_toTopOf="@+id/recommend_icon">
            <ImageView
                android:id="@+id/recommend_icon_background"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/sport_route_recommend_ic_bg"
                android:scaleType="centerCrop"/>
        </androidx.cardview.widget.CardView>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/recommend_icon"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="15.5dp"
            android:text="@string/sport_running_route_recommand_label"
            android:maxLines="1"
            android:maxLength="5"
            android:autoSizeTextType="uniform"
            android:autoSizeStepGranularity="0.5sp"
            android:autoSizeMinTextSize="6sp"
            android:paddingHorizontal="4.5dp"
            android:paddingVertical="2dp"
            android:autoSizeMaxTextSize="10sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="16dp"
        android:textStyle="bold"
        android:textColor="@color/text_color"
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toEndOf="@+id/route_icon"
        app:layout_constraintTop_toBottomOf="@+id/route_length"
        app:layout_constraintTop_toTopOf="@+id/route_icon"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/text_color_60"
        android:id="@+id/route_length"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/start_point_dis"
        app:layout_constraintStart_toStartOf="@+id/name"
        app:layout_constraintTop_toBottomOf="@+id/name"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/text_color_60"
        android:id="@+id/heat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/route_length"
        app:layout_constraintStart_toEndOf="@+id/route_length"
        app:layout_constraintTop_toTopOf="@+id/route_length"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/text_color_60"
        android:id="@+id/start_point_dis"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/route_type"
        app:layout_constraintStart_toStartOf="@+id/name"
        app:layout_constraintTop_toBottomOf="@+id/route_length"/>
    <TextView
        android:textSize="10.67dp"
        android:gravity="center"
        android:id="@+id/route_type"
        android:paddingLeft="2dp"
        android:paddingRight="2dp"
        android:layout_width="wrap_content"
        android:layout_height="18.6dp"
        android:layout_marginTop="2dp"
        android:minWidth="54.6dp"
        app:layout_constraintBottom_toBottomOf="@+id/route_icon"
        app:layout_constraintStart_toStartOf="@+id/name"
        app:layout_constraintTop_toBottomOf="@+id/start_point_dis"/>
    <TextView
        android:background="@drawable/right_arrow_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
