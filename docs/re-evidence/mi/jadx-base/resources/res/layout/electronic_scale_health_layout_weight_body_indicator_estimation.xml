<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/body_container"
    android:background="@drawable/shape_card_bg_normal"
    android:paddingTop="19dp"
    android:paddingBottom="13.3dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="13.3dp"
    android:paddingHorizontal="@dimen/page_extra_padding_horizontal_large">
    <TextView
        android:textColor="@color/text_color"
        android:gravity="start"
        android:id="@+id/body_indicator_estimation_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/electronic_scale_health_body_indicator_estimation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/FontMedium.13sp"/>
    <RelativeLayout
        android:orientation="vertical"
        android:id="@+id/body_score_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/body_indicator_estimation_title">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@+id/somatotype_lin">
            <TextView
                android:textSize="@dimen/dimen_11sp"
                android:id="@+id/body_indicator_estimation_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6.67dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/FontLatinMedium"/>
            <TextView
                android:textColor="@color/text_color_40"
                android:id="@+id/body_indicator_estimation_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_13dp"
                android:layout_marginEnd="@dimen/dimen_margin_23dp"
                style="@style/FontRegular.13sp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/somatotype_lin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/somatotype_frame"
                    android:background="@drawable/electronic_scale_health_weight_ic_somatotype_img_frame"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_margin_12dp"
                    android:importantForAccessibility="no"
                    android:layout_marginEnd="17.6dp"
                    android:layout_alignParentEnd="true"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ImageView
                    android:id="@+id/somatotype_img"
                    android:visibility="gone"
                    android:layout_width="43.3dp"
                    android:layout_height="107dp"
                    android:importantForAccessibility="no"
                    android:layout_alignParentEnd="true"
                    app:layout_constraintBottom_toBottomOf="@+id/somatotype_frame"
                    app:layout_constraintEnd_toEndOf="@+id/somatotype_frame"
                    app:layout_constraintStart_toStartOf="@+id/somatotype_frame"
                    app:layout_constraintTop_toTopOf="@+id/somatotype_frame"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:textColor="@color/text_color"
                android:layout_gravity="center_horizontal"
                android:id="@+id/somatotype_name"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_12dp"
                android:layout_below="@+id/somatotype_frame"
                android:layout_centerHorizontal="true"
                style="@style/FontRegular.12sp"/>
        </LinearLayout>
    </RelativeLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_13dp"
        android:baselineAligned="false"
        android:weightSum="2"
        android:paddingVertical="@dimen/dimen_margin_14dp"
        app:layout_constraintTop_toBottomOf="@+id/body_score_content">
        <RelativeLayout
            android:id="@+id/bmi_group_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="@dimen/dimen_20sp"
                android:textColor="@color/text_color"
                android:id="@+id/bmi_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                style="@style/FontLatinMedium"/>
            <TextView
                android:id="@+id/bmi_indicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/bmi_value"
                android:layout_alignParentStart="true"
                style="@style/FontRegular.11sp"/>
            <ImageView
                android:id="@+id/bmi_arrow"
                android:background="@drawable/ic_base_right_arrow_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignTop="@+id/bmi_value"
                android:layout_alignBottom="@+id/bmi_indicator"
                android:layout_marginEnd="9.3dp"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <com.xiaomi.fitness.widget.view.DividerView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            app:isHorizontal="true"/>
        <RelativeLayout
            android:id="@+id/body_fat_rate_group"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/dimen_margin_20dp">
            <TextView
                android:textSize="@dimen/text_size_20"
                android:textColor="@color/text_color"
                android:id="@+id/body_fat_rate_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                style="@style/FontLatinMedium"/>
            <TextView
                android:id="@+id/body_fat_rate_indicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/body_fat_rate_value"
                android:layout_alignParentStart="true"
                style="@style/FontRegular.11sp"/>
            <ImageView
                android:id="@+id/body_fat_rate_arrow"
                android:background="@drawable/ic_base_right_arrow_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignTop="@+id/body_fat_rate_value"
                android:layout_alignBottom="@+id/body_fat_rate_indicator"
                android:layout_marginEnd="9.3dp"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
