<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/trail_sport_record_route_0"
    android:padding="@dimen/page_extra_padding_horizontal_large"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/route_icon"
        android:layout_width="72dp"
        android:layout_height="72dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/text_color"
        android:id="@+id/route_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="84dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/FontMedium.16sp"/>
    <TextView
        android:textColor="@color/text_color_60"
        android:id="@+id/route_entire_length"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6.67dp"
        app:layout_constraintStart_toStartOf="@+id/route_name"
        app:layout_constraintTop_toBottomOf="@+id/route_name"
        style="@style/FontMedium.16sp"/>
    <TextView
        android:id="@+id/route_status_card_tv"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_3dp"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        app:layout_constraintStart_toStartOf="@+id/route_name"
        app:layout_constraintTop_toBottomOf="@+id/route_entire_length"
        style="@style/FontMedium.12sp"/>
    <ImageView
        android:id="@+id/right_arrow"
        android:background="@drawable/right_arrow_icon"
        android:visibility="gone"
        android:layout_width="@dimen/dimen_margin_30dp"
        android:layout_height="@dimen/dimen_margin_30dp"
        android:layout_marginEnd="5.3dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/white"
        android:id="@+id/join_punching_in_btn"
        android:background="@drawable/shape_bottom_btn_positive_bg_normal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/trail_sports_record_route_join_punch"
        android:layout_marginEnd="@dimen/dimen_margin_15dp"
        android:paddingHorizontal="@dimen/dimen_margin_10dp"
        android:paddingVertical="9dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/FontMedium.14sp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
