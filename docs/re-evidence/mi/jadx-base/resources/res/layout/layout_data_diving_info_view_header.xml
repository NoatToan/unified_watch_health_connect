<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="45dp">
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/text_color"
        android:gravity="center"
        android:id="@+id/txt_header_title1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="#"
        android:layout_weight="1"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/text_color"
        android:gravity="center"
        android:id="@+id/txt_header_title2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/trail_time_duration"
        android:singleLine="true"
        android:layout_weight="1"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/text_color"
        android:gravity="center"
        android:id="@+id/txt_header_title3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/trail_sport_max_diving_depth_title"
        android:singleLine="true"
        android:layout_weight="1"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/text_color"
        android:gravity="center"
        android:id="@+id/txt_header_title4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/trail_sport_avg_diving_temperature_title"
        android:singleLine="true"
        android:layout_weight="1"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/text_color"
        android:gravity="center"
        android:id="@+id/txt_header_title5"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/trail_sport_avg_diving_depth_title"
        android:singleLine="true"
        android:layout_weight="1"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/text_color"
        android:gravity="center"
        android:id="@+id/txt_header_title6"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/trail_sport_min_diving_temperature_title"
        android:singleLine="true"
        android:layout_weight="1"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/text_color"
        android:gravity="center"
        android:id="@+id/txt_header_title7"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/trail_sport_diving_avg_ascent_speed"
        android:singleLine="true"
        android:layout_weight="1"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/text_color"
        android:gravity="center"
        android:id="@+id/txt_header_title8"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/trail_sport_diving_avg_dive_speed"
        android:singleLine="true"
        android:layout_weight="1"/>
</LinearLayout>
