<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:id="@+id/slide_up_widget"
    android:background="@color/page_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="@dimen/share_panel_vertical_margin">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:weightSum="4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="11sp"
            android:textColor="@color/share_text_color"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/rl_download"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/share_download"
            android:drawableTop="@drawable/share_download"
            android:drawablePadding="@dimen/dimen_margin_5dp"
            android:layout_weight="1"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="11sp"
            android:textColor="@color/share_text_color"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/rl_share_wx_session"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/share_wx_session"
            android:drawableTop="@drawable/share_wx_session"
            android:drawablePadding="@dimen/dimen_margin_5dp"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/dimen_margin_30dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="11sp"
            android:textColor="@color/share_text_color"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/rl_share_timeline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/share_wx_timeline"
            android:drawableTop="@drawable/share_wx_timeline"
            android:drawablePadding="@dimen/dimen_margin_5dp"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/dimen_margin_30dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="11sp"
            android:textColor="@color/share_text_color"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/rl_more"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/more"
            android:drawableTop="@drawable/ic_share_more"
            android:drawablePadding="@dimen/dimen_margin_5dp"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/dimen_margin_30dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
