<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:tag="layout/health_layout_weight_index_evaluation_0"
    android:background="@drawable/shape_data_item_bg"
    android:paddingTop="@dimen/dialog_text_size_20"
    android:paddingBottom="13.3dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/health_detail_page_common_margin_vertical">
    <TextView
        android:textColor="@color/text_color"
        android:gravity="center_vertical"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/health_estimation_index"
        android:drawablePadding="@dimen/dimen_margin_10dp"
        android:drawableStart="@drawable/ic_estimation_index"
        android:layout_marginStart="@dimen/page_extra_padding_horizontal_large"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/FontMedium.14sp"/>
    <com.xiaomi.fitness.widget.view.DividerView
        android:id="@+id/horizontal_divider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_20dp"
        android:layout_marginHorizontal="@dimen/page_extra_padding_horizontal_large"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <com.xiaomi.fitness.health.weight.ui.view.SomatoTypeTreemapView
        android:id="@+id/weight_treemap"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_23dp"
        android:paddingStart="50dp"
        android:paddingEnd="50dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/horizontal_divider"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/weight_somatotype_recycler"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="13.3dp"
        android:overScrollMode="never"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/weight_treemap"/>
</androidx.constraintlayout.widget.ConstraintLayout>
