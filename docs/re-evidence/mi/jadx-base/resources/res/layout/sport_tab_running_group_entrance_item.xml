<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/sport_tab_running_group_entrance_item_0"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/dimen_margin_12dp">
    <androidx.constraintlayout.utils.widget.ImageFilterView
        android:id="@+id/cover"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:round="@dimen/dimen_margin_14dp"/>
    <TextView
        android:textColor="@color/white"
        android:id="@+id/recommend"
        android:background="@drawable/bg_running_group_recommend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_margin_8dp"
        android:text="@string/sport_running_group_item_recommend"
        android:layout_marginStart="@dimen/dimen_margin_8dp"
        android:paddingHorizontal="@dimen/dimen_margin_5dp"
        android:paddingVertical="@dimen/dimen_margin_3dp"
        app:layout_constraintBottom_toBottomOf="@+id/cover"
        app:layout_constraintStart_toStartOf="@+id/cover"/>
    <View
        android:id="@+id/discover_bg"
        android:background="@drawable/bg_tab_running_group_entrance_discover"
        android:layout_width="90dp"
        android:layout_height="90dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.utils.widget.ImageFilterView
        android:id="@+id/group_1"
        android:layout_width="@dimen/dimen_margin_30dp"
        android:layout_height="@dimen/dimen_margin_30dp"
        android:layout_marginTop="@dimen/dimen_margin_12dp"
        android:layout_marginStart="@dimen/dimen_margin_12dp"
        app:layout_constraintStart_toStartOf="@+id/discover_bg"
        app:layout_constraintTop_toTopOf="@+id/discover_bg"
        app:round="@dimen/dimen_margin_30dp"/>
    <androidx.constraintlayout.utils.widget.ImageFilterView
        android:id="@+id/default_1"
        android:layout_width="@dimen/dimen_margin_30dp"
        android:layout_height="@dimen/dimen_margin_30dp"
        android:layout_marginTop="@dimen/dimen_margin_12dp"
        android:src="@drawable/running_group_discover_default"
        android:layout_marginEnd="@dimen/dimen_margin_12dp"
        app:layout_constraintEnd_toEndOf="@+id/discover_bg"
        app:layout_constraintTop_toTopOf="@+id/discover_bg"
        app:round="@dimen/dimen_margin_30dp"/>
    <androidx.constraintlayout.utils.widget.ImageFilterView
        android:id="@+id/default_2"
        android:layout_width="@dimen/dimen_margin_30dp"
        android:layout_height="@dimen/dimen_margin_30dp"
        android:layout_marginBottom="@dimen/dimen_margin_12dp"
        android:src="@drawable/running_group_discover_default"
        android:layout_marginStart="@dimen/dimen_margin_12dp"
        app:layout_constraintBottom_toBottomOf="@+id/discover_bg"
        app:layout_constraintStart_toStartOf="@+id/discover_bg"
        app:round="@dimen/dimen_margin_30dp"/>
    <androidx.constraintlayout.utils.widget.ImageFilterView
        android:id="@+id/group_2"
        android:layout_width="@dimen/dimen_margin_30dp"
        android:layout_height="@dimen/dimen_margin_30dp"
        android:layout_marginBottom="@dimen/dimen_margin_12dp"
        android:layout_marginEnd="@dimen/dimen_margin_12dp"
        app:layout_constraintBottom_toBottomOf="@+id/discover_bg"
        app:layout_constraintEnd_toEndOf="@+id/discover_bg"
        app:round="@dimen/dimen_margin_30dp"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/discover"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="discover_bg, group_1, group_2, default_1, default_2"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/text_color"
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_8dp"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="@+id/cover"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="@+id/cover"
        app:layout_constraintTop_toBottomOf="@+id/cover"
        style="@style/FontLatinDemiBold"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/footer_desc"
        android:ellipsize="end"
        android:id="@+id/desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_2dp"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="@+id/cover"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="@+id/cover"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
