<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:paddingTop="@dimen/size_26"
    android:paddingBottom="@dimen/size_36"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="10dp">
    <RelativeLayout
        android:orientation="vertical"
        android:id="@+id/downloadView"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <ImageView
            android:id="@+id/img_download"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:src="@drawable/share_download"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="@dimen/dimen_10sp"
            android:textColor="@color/text_color_60"
            android:gravity="center"
            android:id="@+id/txt_download"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_5dp"
            android:text="@string/share_download"
            android:layout_below="@+id/img_download"
            android:layout_centerHorizontal="true"
            style="@style/FontRegular"/>
    </RelativeLayout>
    <RelativeLayout
        android:orientation="vertical"
        android:id="@+id/wxView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <ImageView
            android:id="@+id/img_share_wx_session"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:src="@drawable/share_wx_session"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="@dimen/dimen_10sp"
            android:textColor="@color/text_color_60"
            android:gravity="center"
            android:id="@+id/txt_share_wx_session"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_5dp"
            android:text="@string/share_wx_session"
            android:layout_below="@+id/img_share_wx_session"
            android:layout_centerHorizontal="true"
            style="@style/FontRegular"/>
    </RelativeLayout>
    <RelativeLayout
        android:orientation="vertical"
        android:id="@+id/wxFriendView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <ImageView
            android:id="@+id/img_share_wx_timeline"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:src="@drawable/share_wx_timeline"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="@dimen/dimen_10sp"
            android:textColor="@color/text_color_60"
            android:gravity="center"
            android:id="@+id/txt_share_wx_timeline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_5dp"
            android:text="@string/share_wx_timeline"
            android:layout_below="@+id/img_share_wx_timeline"
            android:layout_centerHorizontal="true"
            style="@style/FontRegular"/>
    </RelativeLayout>
    <RelativeLayout
        android:orientation="vertical"
        android:id="@+id/moreView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <ImageView
            android:id="@+id/iv_more"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:src="@drawable/ic_share_more"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="@dimen/dimen_10sp"
            android:textColor="@color/text_color_60"
            android:gravity="center"
            android:id="@+id/tv_more"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_5dp"
            android:text="@string/more"
            android:layout_below="@+id/iv_more"
            android:layout_centerHorizontal="true"
            style="@style/FontRegular"/>
    </RelativeLayout>
</LinearLayout>
