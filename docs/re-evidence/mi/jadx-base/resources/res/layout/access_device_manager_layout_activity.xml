<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/access_device_manager_layout_activity_0"
    android:background="@color/page_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/device_layout_loading"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/access_common_loading_dialog"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/access_device_manager_recycleview"
        android:tag="binding_1"
        android:background="@drawable/shape_card_bg_normal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_10dp"
        android:layout_marginHorizontal="@dimen/page_padding_horizontal_large"
        android:paddingHorizontal="@dimen/page_extra_padding_horizontal_large"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintTop_toTopOf="parent"
        app:reverseLayout="false"
        app:spanCount="1"/>
    <FrameLayout
        android:id="@+id/faq_tv"
        android:background="@drawable/shape_card_bg_normal"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_20dp"
        android:layout_marginBottom="@dimen/dimen_margin_18dp"
        android:layout_marginHorizontal="@dimen/page_padding_horizontal_large"
        android:paddingHorizontal="@dimen/page_extra_padding_horizontal_large"
        app:layout_constraintTop_toBottomOf="@+id/access_device_manager_recycleview">
        <com.xiaomi.fitness.widget.RightArrowSingleLineTextView
            android:textColor="@color/text_color_40"
            android:gravity="center_horizontal"
            android:id="@+id/faq_tv_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:showBackground="false"
            app:title="@string/common_faq"
            style="@style/FontRegular.14sp"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
