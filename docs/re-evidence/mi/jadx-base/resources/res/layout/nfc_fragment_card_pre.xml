<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutView"
    android:tag="layout/nfc_fragment_card_pre_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:gravity="center_horizontal"
        android:id="@+id/card_intro_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/cardView"
            android:layout_width="@dimen/nfc_card_width"
            android:layout_height="@dimen/nfc_card_height"
            android:layout_marginTop="13.33dp"
            android:scaleType="fitXY"
            android:layout_centerHorizontal="true"/>
        <FrameLayout
            android:id="@+id/watch_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/nfc_tsm_watch_icon_padding_top"
            android:layout_centerHorizontal="true">
            <com.xiaomi.fitness.nfc.widget.DeviceImageView
                android:id="@+id/deviceView"
                android:layout_width="@dimen/nfc_device_icon_width"
                android:layout_height="@dimen/nfc_device_icon_height"/>
            <ProgressBar
                android:layout_gravity="center"
                android:id="@+id/loadingView"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:indeterminateDrawable="@drawable/nfc_card_issuing_indeterminate"
                android:indeterminateDuration="2000"
                android:interpolator="@android:interpolator/accelerate_decelerate"/>
        </FrameLayout>
        <RelativeLayout
            android:id="@+id/titleView"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="34.33dp"
            android:layout_below="@+id/watch_layout">
            <TextView
                android:textSize="24sp"
                android:textColor="@color/text_color"
                android:id="@+id/statusView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/keep_alive_notification_content_connecting"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="24sp"
                android:textColor="@color/text_color"
                android:id="@+id/dotView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@+id/statusView"/>
        </RelativeLayout>
        <TextView
            android:textSize="@dimen/nfc_common_textsize_4"
            android:textColor="@color/text_color_40"
            android:gravity="center_horizontal"
            android:id="@+id/descView"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="80dp"
            android:text="@string/nfc_card_issue_hint_connect"
            android:layout_below="@+id/watch_layout"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
</RelativeLayout>
