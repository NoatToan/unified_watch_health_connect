<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/font_22"
        android:id="@+id/txt_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:layout_alignParentTop="true"
        android:layout_marginStart="@dimen/size_18"
        android:layout_alignParentStart="true"
        style="@style/FontMedium"/>
    <TextView
        android:textSize="@dimen/font_12"
        android:textColor="@color/text_color"
        android:id="@+id/txt_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:layout_alignBaseline="@+id/txt_value"
        android:layout_alignParentTop="true"
        android:layout_marginStart="@dimen/size_2"
        android:layout_toEndOf="@+id/txt_value"
        style="@style/FontMedium.12sp"/>
    <TextView
        android:textSize="@dimen/font_12"
        android:textColor="@color/text_color_40"
        android:id="@+id/txt_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="110dp"
        android:maxLines="2"
        android:includeFontPadding="false"
        android:layout_below="@+id/txt_value"
        android:layout_marginStart="@dimen/size_18"
        android:layout_alignParentStart="true"
        style="@style/FontRegular.12sp"/>
</RelativeLayout>
