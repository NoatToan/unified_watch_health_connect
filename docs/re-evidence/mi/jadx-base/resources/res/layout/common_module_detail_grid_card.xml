<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/tv_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_10"
        app:layout_constraintBottom_toBottomOf="@+id/iv_icon"
        app:layout_constraintStart_toEndOf="@+id/iv_icon"
        app:layout_constraintTop_toTopOf="@+id/iv_icon"
        style="@style/CardTextAppearance.LabelTitle"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tv_bottom"
        android:background="@drawable/shape_bottom_btn_native_bg_normal"
        android:paddingTop="@dimen/size_14"
        android:paddingBottom="@dimen/size_14"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_20"
        android:layout_marginStart="@dimen/size_18"
        android:layout_marginEnd="@dimen/size_18"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider_line_bottom"/>
    <View
        android:id="@+id/divider_line_bottom"
        android:background="@color/common_divider_bg_color"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="@dimen/size_0_33"
        android:layout_marginStart="@dimen/size_18"
        android:layout_marginEnd="@dimen/size_18"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/recycler"/>
    <View
        android:id="@+id/divider_line_top"
        android:background="@color/common_divider_bg_color"
        android:layout_width="0dp"
        android:layout_height="@dimen/size_0_33"
        android:layout_marginTop="@dimen/size_20"
        android:layout_marginStart="@dimen/size_18"
        android:layout_marginEnd="@dimen/size_18"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_icon"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_20"
        android:layout_marginStart="@dimen/size_18"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_blood_pressure_distribution"/>
    <miuix.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider_line_top"/>
</androidx.constraintlayout.widget.ConstraintLayout>
