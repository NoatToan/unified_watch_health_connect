<?xml version="1.0" encoding="utf-8"?>
<miuix.springback.view.SpringBackLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/device_settings_fragment_ecg_measure_remind_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:scrollableView="@+id/spring_back_target">
    <miuix.core.widget.NestedScrollView
        android:id="@+id/spring_back_target"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.xiaomi.fitness.widget.SwitchButtonTwoLineTextView
                android:id="@+id/remind_enable_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/page_content_padding_horizontal_large"
                android:paddingEnd="@dimen/page_content_padding_horizontal_large"
                app:subtitle="@string/device_settings_ecg_measure_remind_subtitle_disable"
                app:title="@string/device_settings_ecg_measure_remind"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="vertical"
                android:id="@+id/remind_enable_content"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.xiaomi.fitness.widget.RightArrowSingleLineTextView
                    android:id="@+id/remind_repeat_switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/page_content_padding_horizontal_large"
                    android:paddingEnd="@dimen/page_content_padding_horizontal_large"
                    app:arrow_desShow="false"
                    app:arrow_lineShow="false"
                    app:arrow_rightValueShow="true"
                    app:title="@string/device_settings_ecg_measure_remind_repeat_type"/>
                <com.xiaomi.fitness.devicesettings.common.ecg.ECGMeasureRemindSelectCountView
                    android:id="@+id/remind_repeat_count"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="vertical"
                    android:id="@+id/remind_repeat_times_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/page_content_padding_horizontal_large"
                    android:paddingEnd="@dimen/page_content_padding_horizontal_large"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </miuix.core.widget.NestedScrollView>
</miuix.springback.view.SpringBackLayout>
