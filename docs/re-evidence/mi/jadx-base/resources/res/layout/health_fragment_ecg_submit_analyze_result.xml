<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/health_fragment_ecg_submit_analyze_result_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginHorizontal="26.67dp">
    <TextView
        android:textColor="@color/green"
        android:gravity="center"
        android:id="@+id/tv_submit_success"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/health_n60_ecg_analyze_submit_success"
        android:drawableTop="@drawable/common_ic_succeed"
        android:drawablePadding="@dimen/size_40"
        app:layout_constraintBottom_toTopOf="@+id/tv_detail"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/FontMedium.20sp"/>
    <TextView
        android:textColor="@color/text_color_40"
        android:gravity="center"
        android:id="@+id/tv_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_10"
        android:text="@string/health_n60_ecg_done_tip_after_one_minute"
        app:layout_constraintBottom_toTopOf="@+id/tv_finish"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_submit_success"
        style="@style/FontRegular.14sp"/>
    <TextView
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_finish"
        android:background="@drawable/selector_bottom_btn_positive_bg"
        android:layout_width="@dimen/common_btn_single_line_width"
        android:layout_height="wrap_content"
        android:layout_marginBottom="26.7dp"
        android:text="@string/health_n60_ecg_done"
        android:paddingHorizontal="10dp"
        android:paddingVertical="12.7dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/FontMedium.16sp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
