<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/selector_card_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/size_6_7"
    android:paddingStart="@dimen/size_15_3"
    android:paddingEnd="@dimen/size_18"
    android:paddingVertical="@dimen/size_15_3">
    <ImageView
        android:id="@+id/icon_animal"
        android:layout_width="@dimen/size_54_67"
        android:layout_height="@dimen/size_54_67"
        android:layout_marginEnd="@dimen/size_15_3"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:textSize="@dimen/font_13_3"
            android:textColor="@color/text_color"
            android:id="@+id/tv_name_animal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/FontLatinSemiBold"/>
        <TextView
            android:textSize="@dimen/font_13"
            android:textColor="@color/text_color_40"
            android:id="@+id/tv_animal_sample_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_3_3"
            style="@style/FontRegular"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/icon_arrow_right"
        android:background="@drawable/ic_base_right_arrow_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <CheckBox
        android:id="@+id/check_box_choose"
        android:background="@drawable/selector_check"
        android:visibility="gone"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:checked="false"
        android:button="@null"/>
</LinearLayout>
