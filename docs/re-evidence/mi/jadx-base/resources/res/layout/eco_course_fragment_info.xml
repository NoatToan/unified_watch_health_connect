<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/eco_course_fragment_info_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <miuix.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.xiaomi.fitness.widget.view.RatioImageView
                android:id="@+id/post_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:scaleType="centerCrop"
                android:layout_marginStart="@dimen/course_info_margin"
                android:layout_marginEnd="@dimen/course_info_margin"
                app:layout_constraintTop_toTopOf="parent"
                app:ratio="1.679"
                app:shapeAppearance="@style/CourseInfo"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="horizontal"
                android:id="@+id/triple_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_22dp"
                android:weightSum="3"
                android:layout_marginHorizontal="@dimen/margin_27dp"
                app:layout_constraintTop_toBottomOf="@+id/post_view">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/difficulty_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:translationX="-10dp">
                    <TextView
                        android:gravity="start"
                        android:id="@+id/difficulty_label_view"
                        android:text="@string/course_difficult"
                        style="@style/CourseInfoLabel"/>
                    <TextView
                        android:id="@+id/difficulty_value_view"
                        app:layout_constraintHorizontal_chainStyle="spread_inside"
                        app:layout_constraintTop_toBottomOf="@+id/difficulty_label_view"
                        style="@style/CourseInfoValue"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/consume_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:id="@+id/consume_label_view"
                        android:text="@string/course_share_calorie_desc"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        style="@style/CourseInfoLabel"/>
                    <TextView
                        android:id="@+id/consume_value_view"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/consume_label_view"
                        style="@style/CourseInfoValue"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/time_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:translationX="@dimen/dimen_margin_10dp">
                    <TextView
                        android:id="@+id/time_label_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/course_time"
                        app:layout_constraintEnd_toEndOf="parent"
                        style="@style/CourseInfoLabel"/>
                    <TextView
                        android:id="@+id/time_value_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimen_margin_5dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/time_label_view"
                        style="@style/CourseInfoValue"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <com.xiaomi.fitness.widget.expandable.ExpandableTextView
                android:textSize="12sp"
                android:textColor="@color/course_info_desc"
                android:id="@+id/desc_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="23dp"
                android:lineSpacingExtra="4dp"
                android:layout_marginStart="@dimen/course_info_margin"
                android:layout_marginEnd="@dimen/course_info_margin"
                app:expandLines="2"
                app:expandTextColor="@color/course_black"
                app:layout_constraintTop_toBottomOf="@+id/triple_group"/>
            <com.mi.health.course.widget.CourseReqLayout
                android:id="@+id/frequency_container"
                android:layout_marginStart="@dimen/course_info_margin"
                app:layout_constraintEnd_toStartOf="@+id/device_container"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/desc_view"
                style="@style/CourseFrequencyContainer">
                <TextView
                    android:id="@+id/frequency_label"
                    android:text="@string/course_frequency"
                    android:drawableStart="@drawable/course_info_frequency"
                    android:importantForAccessibility="no"
                    style="@style/CourseFrequencyLabel"/>
                <TextView
                    android:id="@+id/frequency_view"
                    android:importantForAccessibility="no"
                    style="@style/CourseInfoValue"/>
            </com.mi.health.course.widget.CourseReqLayout>
            <com.mi.health.course.widget.CourseReqLayout
                android:id="@+id/device_container"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="@dimen/course_info_margin"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/frequency_container"
                app:layout_constraintTop_toBottomOf="@+id/desc_view"
                style="@style/CourseFrequencyContainer">
                <TextView
                    android:text="@string/course_device"
                    android:drawableStart="@drawable/course_info_device"
                    android:importantForAccessibility="no"
                    style="@style/CourseFrequencyLabel"/>
                <TextView
                    android:id="@+id/device_view"
                    android:importantForAccessibility="no"
                    style="@style/CourseInfoValue"/>
            </com.mi.health.course.widget.CourseReqLayout>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/content_label_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="content_label,content_size_view"/>
            <TextView
                android:id="@+id/content_label"
                android:text="@string/course_content"
                android:layout_marginStart="@dimen/course_info_margin"
                app:layout_constraintStart_toStartOf="parent"
                style="@style/CourseContentLabel"/>
            <TextView
                android:id="@+id/content_size_view"
                android:layout_marginEnd="@dimen/course_info_margin"
                app:layout_constraintEnd_toEndOf="parent"
                style="@style/CourseContentLabel"/>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/content"
                android:paddingTop="7dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/content_size_view">
                <androidx.recyclerview.widget.RecyclerView
                    android:orientation="horizontal"
                    android:id="@+id/recycler_view"
                    android:visibility="gone"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="67dp"
                    android:paddingStart="@dimen/course_info_margin"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:layout_constraintTop_toBottomOf="@+id/content_size_view"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/audio_container"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/page_content_padding_horizontal_large"
                    app:layout_constraintTop_toBottomOf="@+id/content_size_view"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/course_black"
                    android:id="@+id/audio_more_view"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/course_info_all"
                    android:drawablePadding="12dp"
                    android:drawableStart="@drawable/course_arrow_down"/>
                <com.xiaomi.fitness.widget.view.DividerView
                    android:id="@+id/audio_divider"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="27dp"
                    android:layout_marginBottom="7dp"
                    android:layout_marginStart="@dimen/course_info_margin"
                    android:layout_marginEnd="@dimen/course_info_margin"/>
            </LinearLayout>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/course_notice"
                android:id="@+id/tip_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/course_attention"
                android:layout_marginStart="@dimen/course_info_margin"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/content"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/course_desc"
                android:id="@+id/tip_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="4dp"
                android:paddingStart="@dimen/course_info_margin"
                android:paddingEnd="@dimen/course_info_margin"
                app:layout_constraintTop_toBottomOf="@+id/tip_label"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </miuix.core.widget.NestedScrollView>
    <TextView
        android:id="@+id/start_view"
        android:layout_marginTop="10dp"
        style="@style/CommonBtn.Red"/>
</LinearLayout>
