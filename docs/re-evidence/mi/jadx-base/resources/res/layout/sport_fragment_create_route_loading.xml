<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/create_route_loading_container"
    android:tag="layout/sport_fragment_create_route_loading_0"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/create_route_loading_bg"
        android:background="@color/black"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.8"/>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/sport_create_route_bg_route_create_loading"
        android:focusable="true"
        android:fitsSystemWindows="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp">
        <ImageView
            android:id="@+id/route_creating"
            android:layout_width="@dimen/size_160"
            android:layout_height="wrap_content"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/white"
            android:id="@+id/route_creating_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_40dp"
            android:layout_marginBottom="40dp"
            android:text="@string/sport_running_route_create_loading"/>
    </LinearLayout>
</FrameLayout>
