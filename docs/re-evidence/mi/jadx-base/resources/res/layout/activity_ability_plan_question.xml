<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_ability_plan_question_0"
    android:background="@color/page_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">
    <com.xiaomi.fitness.training_plan_export.widget.TrainingPlanTitleBar
        android:id="@+id/titlebar"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginTop="@dimen/dimen_margin_36dp"
        android:layout_alignParentTop="true"/>
    <include
        android:id="@+id/createPlanProgressRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/titlebar"
        layout="@layout/ability_plan_create_progress_layout"/>
    <TextView
        android:textSize="17sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/submitInfo"
        android:background="@drawable/bottom_button_selector"
        android:layout_width="@dimen/common_btn_single_line_width"
        android:layout_height="50dp"
        android:layout_marginBottom="29dp"
        android:text="@string/training_plan_confirm"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:fontFamily="@font/misanslatin_regular"
        android:layout_marginStart="@dimen/dimen_margin_17dp"
        android:layout_marginEnd="@dimen/dimen_margin_17dp"/>
    <ScrollView
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_12dp"
        android:layout_marginBottom="@dimen/margin_27dp"
        android:layout_above="@+id/submitInfo"
        android:layout_below="@+id/createPlanProgressRoot">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/questionContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </ScrollView>
</RelativeLayout>
