<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rlDistance"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="47dp"
        android:textStyle="bold"
        android:textColor="@color/common_white"
        android:id="@+id/txtDistance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="105dp"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textSize="10dp"
        android:textColor="@color/common_black"
        android:id="@+id/sportType"
        android:background="@drawable/shape_sporttype_bg"
        android:padding="@dimen/dimen_margin_2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:text="--"
        android:layout_alignTop="@+id/txtDistance"
        android:fontFamily="@font/misanslatin_semibold"
        android:layout_marginStart="@dimen/dimen_margin_4dp"
        android:layout_toEndOf="@+id/txtDistance"
        app:strokeTextSize="40dp"
        app:strokeTextWidth="8"/>
    <TextView
        android:textSize="17dp"
        android:textColor="@color/common_white"
        android:id="@+id/txtUnit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_margin_8dp"
        android:text="@string/trail_label_km"
        android:layout_toRightOf="@+id/txtDistance"
        android:layout_below="@+id/sportType"
        android:layout_toEndOf="@+id/txtDistance"/>
</RelativeLayout>
