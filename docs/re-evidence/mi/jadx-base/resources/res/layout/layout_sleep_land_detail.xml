<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/layout_sleep_land_detail"
    android:tag="layout/layout_sleep_land_detail_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginHorizontal="@dimen/dimen_margin_18dp">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_25dp"
        android:paddingStart="@dimen/size_18"
        android:paddingEnd="@dimen/size_18">
        <ImageView
            android:id="@+id/ic_back"
            android:background="@drawable/ic_base_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="@dimen/text_size_16"
            android:textColor="@color/text_color"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/health_sleep_long_sleep"
            android:layout_marginStart="@dimen/dimen_margin_3dp"
            style="@style/FontMedium"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/layout_sleep_land_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:background="@drawable/common_loading_rotate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="@dimen/text_size_14"
                android:textColor="@color/text_color"
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_10dp"
                android:text="@string/health_sleep_land_detail_loading_txt"
                style="@style/FontMedium"/>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/layout_sleep_land_data"
            android:tag="binding_1"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="@dimen/dimen_margin_26dp">
            <com.xiaomi.fitness.chart.view.SleepChartRecyclerView
                android:id="@+id/chart_recycler"
                android:paddingTop="91dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="@dimen/chart_common_padding_start"
                android:paddingEnd="@dimen/chart_common_padding_start"
                app:sleepItemHeight="@dimen/health_sleep_chart_item_height"
                style="@style/ChartBaseStyle"/>
            <com.xiaomi.fitness.chart.view.LineDetailChartRecyclerView
                android:id="@+id/line_recycler"
                android:background="@color/white_04_transparent"
                android:paddingTop="91dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="@dimen/chart_common_padding_start"
                android:paddingEnd="@dimen/chart_common_padding_start"
                app:enableEndDayXAxis="true"
                app:enableEndYAxisLabel="false"
                app:enableLineFill="false"
                app:enableStartYAxisLabel="true"
                app:enableXAxisLineCircle="false"
                app:lineColor="@color/health_hrm_chart"
                app:linePointSelectStrokeWidth="@dimen/size_2"
                app:lineStrokeWidth="4"
                style="@style/ChartBaseStyle"/>
            <com.xiaomi.fitness.chart.view.LineDetailChartRecyclerView
                android:id="@+id/spo2_line_recycler"
                android:background="@color/white_04_transparent"
                android:paddingTop="91dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="@dimen/chart_common_padding_start"
                android:paddingEnd="@dimen/chart_common_padding_start"
                app:enableEndDayXAxis="true"
                app:enableLineFill="false"
                app:enableStartYAxisLabel="false"
                app:enableXAxisLineCircle="false"
                app:lineColor="@color/health_sleep_detail_spo2_line_color"
                app:linePointSelectStrokeWidth="@dimen/size_2"
                app:lineStrokeWidth="4"
                style="@style/ChartBaseStyle"/>
            <include
                android:id="@+id/detail_title"
                layout="@layout/layout_sleep_land_detail_title"/>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
