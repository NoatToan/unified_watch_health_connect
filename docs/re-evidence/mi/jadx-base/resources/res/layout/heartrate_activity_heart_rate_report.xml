<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/heartrate_activity_heart_rate_report_0"
    android:background="@color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/heartrate_scroll_view"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dimen_margin_25dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/button_group"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/dimen_margin_26dp"
            android:paddingEnd="@dimen/dimen_margin_26dp">
            <TextView
                android:textSize="@dimen/text_size_10"
                android:gravity="center"
                android:id="@+id/heartrate_tv_evaluation_state"
                android:paddingTop="@dimen/size_4"
                android:paddingBottom="@dimen/size_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dimen_margin_6dp"
                android:paddingStart="@dimen/size_10"
                android:paddingEnd="@dimen/size_10"
                android:layout_marginStart="@dimen/dimen_margin_3dp"
                app:layout_constraintBottom_toBottomOf="@+id/heartrate_dtv_hrm"
                app:layout_constraintStart_toEndOf="@+id/heartrate_dtv_hrm"
                style="@style/FontMedium"/>
            <TextView
                android:textColor="@color/white_50"
                android:id="@+id/heartrate_tv_detect_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="@+id/heartrate_dtv_hrm"
                app:layout_constraintTop_toBottomOf="@+id/heartrate_dtv_hrm"
                style="@style/FontMedium.12sp"/>
            <TextView
                android:textSize="@dimen/text_size_14"
                android:textColor="@color/white_50"
                android:gravity="top"
                android:id="@+id/heartrate_tv_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_28dp"
                android:lineSpacingMultiplier="1.1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/heartrate_indicator"/>
            <com.xiaomi.fitness.heartrate.ui.view.IndicatorView
                android:id="@+id/heartrate_indicator"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginTop="33.5dp"
                app:iv_segmentCount="3"
                app:iv_segmentGap="2dp"
                app:iv_segmentHeight="@dimen/dimen_margin_6dp"
                app:iv_segmentRadius="3.4dp"
                app:iv_tagMarginBottom="@dimen/dimen_margin_16dp"
                app:iv_tagTextColor="@color/white_50"
                app:iv_tagTextSize="@dimen/text_size_12"
                app:iv_triangleBottomLength="@dimen/dimen_margin_10dp"
                app:iv_triangleMarginTop="@dimen/dimen_margin_3dp"
                app:iv_triangleRadius="0.66dp"
                app:iv_triangleWaistLength="@dimen/dimen_margin_7dp"
                app:iv_valueTextColor="@color/white_50"
                app:iv_valueTextMarginTop="@dimen/dimen_margin_12dp"
                app:iv_valueTextSize="@dimen/text_size_12"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/heartrate_tv_detect_status"/>
            <com.xiaomi.fitness.widget.view.DurationTextView
                android:id="@+id/heartrate_dtv_hrm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:dtv_dataTextColor="@color/white_90"
                app:dtv_dataTextFontFamily="mitype-semibold"
                app:dtv_dataTextSize="54.4sp"
                app:dtv_hintText="@string/heartrate_per_time_minutes_heart_rate"
                app:dtv_unitMarginStart="@dimen/dimen_margin_3dp"
                app:dtv_unitTextColor="@color/white_50"
                app:dtv_unitTextFontFamily="mipro-medium"
                app:dtv_unitTextSize="@dimen/font_15_3"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/button_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">
        <TextView
            android:textSize="@dimen/text_size_12"
            android:textColor="#0073dd"
            android:id="@+id/heartrate_tv_reference"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/heartrate_reference"
            android:layout_marginStart="@dimen/size_1_3"
            android:layout_marginEnd="@dimen/size_1_3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/heartrate_tv_provider"
            app:layout_constraintTop_toTopOf="@+id/heartrate_tv_provider"/>
        <TextView
            android:textSize="@dimen/text_size_12"
            android:textColor="@color/white_40"
            android:id="@+id/heartrate_tv_provider"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dimen_margin_23dp"
            android:text="@string/heartrate_instructions_provider"
            android:layout_marginStart="@dimen/size_1_3"
            android:layout_marginEnd="@dimen/size_1_3"
            app:layout_constraintBottom_toTopOf="@+id/heartrate_tv_finished"
            app:layout_constraintEnd_toStartOf="@+id/heartrate_tv_reference"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:gravity="center"
            android:id="@+id/heartrate_tv_finished"
            android:background="@drawable/dialog_common_primary_button_bg"
            android:layout_marginBottom="@dimen/dimen_margin_26dp"
            android:text="@string/common_complete"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/BaseButton.Positive.DetectButton"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
