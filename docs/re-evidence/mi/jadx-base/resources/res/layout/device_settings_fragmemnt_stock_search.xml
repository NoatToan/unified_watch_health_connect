<?xml version="1.0" encoding="utf-8"?>
<miuix.springback.view.SpringBackLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/device_settings_fragmemnt_stock_search_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:scrollableView="@+id/scrollview">
    <miuix.core.widget.NestedScrollView
        android:id="@+id/scrollview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.xiaomi.fitness.baseui.dialog.ClearEditText
                android:textSize="14sp"
                android:textColor="@color/switch_black"
                android:textColorHint="@color/edit_hint_color"
                android:id="@+id/rl_search"
                android:background="@drawable/shape_search_bg"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="@dimen/dimen_margin_10dp"
                android:hint="@string/device_settings_stock_search_hint"
                android:maxLines="1"
                android:maxLength="99"
                android:drawablePadding="14dp"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:drawableStart="@drawable/ic_search"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginStart="@dimen/dimen_margin_23dp"
                android:layout_marginEnd="@dimen/dimen_margin_23dp"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@+id/rl_search"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/empty_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@+id/rl_search"
                android:paddingStart="25dp"
                android:paddingEnd="25dp">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="0.6">
                    <ImageView
                        android:id="@+id/info_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/icon_nothing"
                        android:layout_alignParentBottom="true"
                        android:layout_centerHorizontal="true"/>
                </RelativeLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="0.86">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="12sp"
                        android:textColor="@color/common_empty_text_color"
                        android:gravity="center"
                        android:id="@+id/info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="13dp"
                        android:text="@string/device_settings_stock_search_empty"
                        android:layout_marginStart="@dimen/dimen_margin_30dp"
                        android:layout_marginEnd="30dp"/>
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>
    </miuix.core.widget.NestedScrollView>
</miuix.springback.view.SpringBackLayout>
