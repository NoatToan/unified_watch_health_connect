<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/device_shape_setting_list_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="17sp"
        android:ellipsize="end"
        android:id="@+id/face_entrance_title"
        android:focusable="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textDirection="locale"
        android:layout_marginStart="@dimen/dimen_margin_14dp"
        app:layout_constraintBottom_toBottomOf="@+id/face_entrance_all_img"
        app:layout_constraintEnd_toStartOf="@+id/face_entrance_all_title"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/face_entrance_all_img"
        style="@style/FontDemiBold"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/footer_desc"
        android:id="@+id/face_entrance_all_title"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/device_manager_face_entrance_all"
        android:layout_marginEnd="-2dp"
        app:layout_constraintBottom_toBottomOf="@+id/face_entrance_all_img"
        app:layout_constraintEnd_toStartOf="@+id/face_entrance_all_img"
        app:layout_constraintTop_toTopOf="@+id/face_entrance_all_img"/>
    <ImageView
        android:id="@+id/face_entrance_all_img"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_12dp"
        android:src="@drawable/ic_right_arrow"
        android:layout_marginEnd="@dimen/dimen_margin_12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/red_point"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/device_face_entrance_red_point"
        app:layout_constraintStart_toEndOf="@+id/face_entrance_all_title"
        app:layout_constraintTop_toTopOf="@+id/face_entrance_all_title"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/face_entrance_list"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_18dp"
        android:layout_marginBottom="@dimen/dimen_margin_18dp"
        android:paddingHorizontal="@dimen/dimen_margin_9dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/face_entrance_all_img"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/slide_more"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:paddingEnd="@dimen/dimen_margin_30dp"
        android:layout_marginEnd="@dimen/dimen_margin_8dp"
        app:layout_constraintBottom_toBottomOf="@+id/face_entrance_list"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/face_entrance_list">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/common_entrance_slide_more"
            android:layout_marginStart="@dimen/dimen_margin_5dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
