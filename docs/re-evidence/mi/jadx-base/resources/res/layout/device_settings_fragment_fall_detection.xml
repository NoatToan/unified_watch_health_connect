<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/device_settings_fragment_fall_detection_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.xiaomi.fitness.widget.SwitchButtonBindingTwoLineTextView
                android:id="@+id/sos_contact_switch"
                android:tag="binding_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/page_content_padding_horizontal_large"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:subtitle="@string/device_settings_fall_sos_desc"
                app:title="@string/device_settings_fall_sos_title"/>
            <com.xiaomi.fitness.widget.SwitchButtonBindingTwoLineTextView
                android:id="@+id/sos_contact_sms_switch"
                android:tag="binding_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/page_content_padding_horizontal_large"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/sos_contact_switch"
                app:subtitle="@string/device_settings_emergency_contact_send_sms_subtitle"
                app:title="@string/device_settings_emergency_contact_send_sms_title"/>
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/device_img"
                android:visibility="invisible"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_marginTop="@dimen/dimen_margin_10dp"
                android:scaleType="centerCrop"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/sos_contact_sms_switch"
                app:lottie_loop="true"/>
            <com.xiaomi.fitness.widget.view.DividerView
                android:id="@+id/dividerView"
                android:tag="binding_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_20dp"
                android:layout_marginEnd="@dimen/common_set_margin_start"
                android:layout_marginHorizontal="@dimen/page_content_padding_horizontal_large"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/device_img"
                style="@style/SettingsLineStyle"/>
            <com.xiaomi.fitness.widget.SwitchButtonBindingTwoLineTextView
                android:id="@+id/share_location_switch"
                android:tag="binding_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/page_content_padding_horizontal_large"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/dividerView"
                app:subtitle="@string/device_settings_share_location_subtitle"
                app:title="@string/device_settings_share_location_title"/>
            <com.xiaomi.fitness.widget.SwitchButtonBindingTwoLineTextView
                android:id="@+id/fall_detection_switch"
                android:tag="binding_5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_20dp"
                android:layout_marginHorizontal="@dimen/page_content_padding_horizontal_large"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/share_location_switch"
                app:subtitle="@string/device_settings_fall_detection_desc"
                app:title="@string/device_settings_fall_detection_title"/>
            <com.xiaomi.fitness.widget.SwitchButtonBindingTwoLineTextView
                android:id="@+id/call_medical_switch"
                android:tag="binding_6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/page_content_padding_horizontal_large"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/fall_detection_switch"
                app:subtitle="@string/device_settings_fall_detection_call_desc"
                app:title="@string/device_settings_fall_detection_call_title"/>
            <com.xiaomi.fitness.widget.view.DividerView
                android:id="@+id/divider2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_20dp"
                android:layout_marginEnd="@dimen/common_set_margin_start"
                android:layout_marginHorizontal="@dimen/page_content_padding_horizontal_large"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/call_medical_switch"
                style="@style/SettingsLineStyle"/>
            <com.xiaomi.fitness.widget.RightArrowBindingSingleLineTextView
                android:id="@+id/sos_contact_count"
                android:tag="binding_7"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_20dp"
                android:layout_marginHorizontal="@dimen/page_content_padding_horizontal_large"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/divider2"
                app:showRemind="true"
                app:title="@string/device_settings_sos_contact_set_title"/>
            <TextView
                android:id="@+id/sos_desc_13"
                android:tag="binding_8"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="46dp"
                android:text="@string/device_settings_sos_contact_tips13"
                android:layout_marginHorizontal="@dimen/page_content_padding_horizontal_large"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/sos_contact_count"
                style="@style/FontRegular.14sp"/>
            <TextView
                android:id="@+id/sos_desc_4"
                android:tag="binding_9"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="@dimen/page_content_padding_horizontal_large"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/sos_desc_13"
                style="@style/FontRegular.14sp"/>
            <TextView
                android:id="@+id/sos_desc_5"
                android:tag="binding_10"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="@dimen/page_content_padding_horizontal_large"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/sos_desc_4"
                style="@style/FontRegular.14sp"/>
            <TextView
                android:id="@+id/sos_desc_cost"
                android:tag="binding_11"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/dimen_margin_20dp"
                android:text="@string/device_settings_sos_contact_tips_message_cost"
                android:layout_marginHorizontal="@dimen/page_content_padding_horizontal_large"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/sos_desc_5"
                style="@style/FontRegular.12sp"/>
            <TextView
                android:id="@+id/sos_120_cost"
                android:tag="binding_12"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/device_settings_sos_contact_tips_120_cost"
                android:layout_marginHorizontal="@dimen/page_content_padding_horizontal_large"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/sos_desc_cost"
                style="@style/FontRegular.12sp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <TextView
        android:id="@+id/sos_contact_empty"
        android:tag="binding_13"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_margin_20dp"
        android:text="@string/device_settings_sos_contact_empty"
        app:layout_constraintBottom_toTopOf="@+id/sos_contact_to_set"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/FontRegular.12sp"/>
    <TextView
        android:id="@+id/sos_contact_to_set"
        android:tag="binding_14"
        android:text="@string/device_settings_sos_contact_to_set"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/CommonBtn.Primary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
