<?xml version="1.0" encoding="utf-8"?>
<miuix.springback.view.SpringBackLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/device_settings_photo_set_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:scrollableView="@+id/scrollview">
    <miuix.core.widget.NestedScrollView
        android:id="@+id/scrollview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="@dimen/dimen_14sp"
                android:textColor="@color/device_settings_take_photo_tips_color"
                android:id="@+id/device_settings_photograph_report_tips"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/device_settings_photograph_report_tips"
                android:layout_centerHorizontal="true"
                android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
                android:layout_marginEnd="@dimen/page_content_padding_horizontal_large"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.xiaomi.fitness.devicesettings.huami.vibratemode.DeviceImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/device_icon"
                android:layout_width="280dp"
                android:layout_height="280dp"
                android:layout_marginTop="26.66dp"
                android:src="@drawable/icon_default_device_big"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/device_settings_photograph_report_tips"/>
            <TextView
                android:textSize="@dimen/dimen_16sp"
                android:textColor="@color/switch_black"
                android:gravity="center_horizontal"
                android:id="@+id/photographTipView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="33.33dp"
                android:text="@string/device_settings_photograph_pair_tips"
                android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
                android:layout_marginEnd="@dimen/page_content_padding_horizontal_large"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/device_icon"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/switch_black"
                android:id="@+id/open_take_picture_hint"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:text="@string/device_settings_open_hid_hint"
                android:fontFamily="@font/misanslatin_bold"
                android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
                android:layout_marginEnd="@dimen/page_content_padding_horizontal_large"
                app:layout_constraintBottom_toTopOf="@+id/photographBottomView"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <TextView
                android:id="@+id/photographBottomView"
                android:text="@string/device_settings_common_ble_pair"
                android:fontFamily="@font/misanslatin_bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                style="@style/CommonBtn.Primary"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </miuix.core.widget.NestedScrollView>
</miuix.springback.view.SpringBackLayout>
