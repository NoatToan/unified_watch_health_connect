<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollview"
    android:tag="layout/fragment_sleep_diary_update_0"
    android:background="@color/page_bg"
    android:scrollbars="none"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="@dimen/page_padding_horizontal_large">
        <com.xiaomi.fitness.widget.RightArrowSingleLineTextView
            android:textSize="@dimen/dimen_12sp"
            android:textColor="@color/text_color"
            android:id="@+id/diary_time_tv"
            android:background="@drawable/common_card_bg_white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_10dp"
            android:paddingStart="@dimen/page_extra_padding_horizontal_large"
            android:paddingEnd="@dimen/page_extra_padding_horizontal_large"
            app:showMore="false"
            app:title="@string/health_sleep_diary_time"/>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/common_card_bg_white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_10dp">
            <com.xiaomi.fitness.widget.RightArrowSingleLineTextView
                android:textSize="@dimen/dimen_12sp"
                android:textColor="@color/text_color"
                android:id="@+id/ready_to_sleep_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/page_extra_padding_horizontal_large"
                android:paddingEnd="@dimen/page_padding_horizontal_large"
                app:remindText="@string/health_sleep_diary_to_edit"
                app:showRemind="true"
                app:title="@string/health_ready_to_sleep_time"/>
            <com.xiaomi.fitness.widget.RightArrowSingleLineTextView
                android:textSize="@dimen/dimen_12sp"
                android:textColor="@color/text_color"
                android:id="@+id/light_off_to_sleep_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/page_extra_padding_horizontal_large"
                android:paddingEnd="@dimen/page_padding_horizontal_large"
                app:remindText="@string/health_sleep_diary_to_edit"
                app:showRemind="true"
                app:title="@string/health_sleep_diary_light_off_to_sleep_time"/>
            <com.xiaomi.fitness.widget.RightArrowSingleLineTextView
                android:textSize="@dimen/dimen_12sp"
                android:textColor="@color/text_color"
                android:id="@+id/in_day_wake_up_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/page_extra_padding_horizontal_large"
                android:paddingEnd="@dimen/page_padding_horizontal_large"
                app:remindText="@string/health_sleep_diary_to_edit"
                app:showRemind="true"
                app:title="@string/health_sleep_diary_in_day_wake_up_time"/>
            <com.xiaomi.fitness.widget.RightArrowSingleLineTextView
                android:textSize="@dimen/dimen_12sp"
                android:textColor="@color/text_color"
                android:id="@+id/in_day_get_up_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/page_extra_padding_horizontal_large"
                android:paddingEnd="@dimen/page_padding_horizontal_large"
                app:remindText="@string/health_sleep_diary_to_edit"
                app:showRemind="true"
                app:title="@string/health_sleep_diary_in_day_get_up_time"/>
        </LinearLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@drawable/common_card_bg_white"
            android:padding="@dimen/page_extra_padding_horizontal_large"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_10dp">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_color"
                android:id="@+id/add_medication_before_sleep_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/health_add_medication_before_sleep"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/add_medication_before_sleep_icon"
                android:padding="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/sleep_diary_add_icon"
                app:layout_constraintBottom_toBottomOf="@+id/add_medication_before_sleep_title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/add_medication_before_sleep_title"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/medication_rv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_10dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/add_medication_before_sleep_title"
                app:layout_goneMarginTop="@dimen/dimen_margin_0dp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@drawable/common_card_bg_white"
            android:padding="@dimen/page_extra_padding_horizontal_large"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_10dp">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_color"
                android:id="@+id/wake_up_in_night_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/health_wake_up_in_night"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/wake_up_in_night_icon"
                android:padding="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/sleep_diary_add_icon"
                app:layout_constraintBottom_toBottomOf="@+id/wake_up_in_night_title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/wake_up_in_night_title"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/wake_up_rv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/wake_up_in_night_title"
                app:layout_goneMarginTop="@dimen/dimen_margin_0dp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@drawable/common_card_bg_white"
            android:padding="@dimen/page_extra_padding_horizontal_large"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_10dp">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_color"
                android:id="@+id/sleep_in_day_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/health_sleep_diary_sleep_in_day"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/sleep_in_day_icon"
                android:padding="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/sleep_diary_add_icon"
                app:layout_constraintBottom_toBottomOf="@+id/sleep_in_day_title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/sleep_in_day_title"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/sleep_in_day_rv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/sleep_in_day_title"
                app:layout_goneMarginTop="@dimen/dimen_margin_0dp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@drawable/common_card_bg_white"
            android:paddingBottom="@dimen/dimen_margin_10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_10dp">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_color"
                android:id="@+id/sleep_difficulty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_10dp"
                android:text="@string/health_sleep_difficulty"
                android:layout_marginStart="@dimen/page_extra_padding_horizontal_large"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/text_color_40"
                android:id="@+id/sleep_difficulty_des"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_3dp"
                android:text="@string/health_sleep_difficulty_des"
                android:layout_marginStart="@dimen/page_extra_padding_horizontal_large"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/sleep_difficulty"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/sleep_difficulty_rv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_10dp"
                android:layout_marginStart="@dimen/page_extra_padding_horizontal_large"
                android:layout_marginEnd="7dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/sleep_difficulty_des"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/text_color_80"
                android:id="@+id/health_sleep_difficulty_des_easy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_10dp"
                android:text="@string/health_sleep_difficulty_des_easy"
                app:layout_constraintStart_toStartOf="@+id/sleep_difficulty_rv"
                app:layout_constraintTop_toBottomOf="@+id/sleep_difficulty_rv"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/text_color_80"
                android:id="@+id/health_sleep_difficulty_des_difficult"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_10dp"
                android:text="@string/health_sleep_difficulty_des_difficult"
                android:layout_marginEnd="@dimen/page_extra_padding_horizontal_large"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/sleep_difficulty_rv"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@drawable/common_card_bg_white"
            android:paddingBottom="@dimen/dimen_margin_10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_10dp">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_color"
                android:id="@+id/sleep_feeling"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_10dp"
                android:text="@string/health_sleep_feeling"
                android:layout_marginStart="@dimen/page_extra_padding_horizontal_large"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/text_color_40"
                android:id="@+id/sleep_feeling_des"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_3dp"
                android:text="@string/health_sleep_feeling_des"
                android:layout_marginStart="@dimen/page_extra_padding_horizontal_large"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/sleep_feeling"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/sleep_feeling_rv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_10dp"
                android:layout_marginStart="@dimen/page_extra_padding_horizontal_large"
                android:layout_marginEnd="7dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/sleep_feeling_des"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/text_color_80"
                android:id="@+id/health_sleep_feeling_des_easy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_10dp"
                android:text="@string/health_sleep_feeling_des_easy"
                app:layout_constraintStart_toStartOf="@+id/sleep_feeling_rv"
                app:layout_constraintTop_toBottomOf="@+id/sleep_feeling_rv"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/text_color_80"
                android:id="@+id/health_sleep_feeling_des_difficult"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_10dp"
                android:text="@string/health_sleep_feeling_des_difficult"
                android:layout_marginEnd="@dimen/page_extra_padding_horizontal_large"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/sleep_feeling_rv"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
