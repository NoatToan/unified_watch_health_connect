<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_electronic_scale_detail_0"
    android:background="@color/page_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/electronic_scale_top_bg_2"
        android:scaleType="fitXY"/>
    <com.xiaomi.fitness.electronic.scale.view.CustomScrollView
        android:id="@+id/custom_scroll_view"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:id="@+id/scale_no_weight"
                android:background="@drawable/electronic_scale_no_weight_bg"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="93dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginVertical="10dp">
                <ImageView
                    android:id="@+id/no_weight_iv_icon"
                    android:layout_width="@dimen/size_30"
                    android:layout_height="31dp"
                    android:src="@drawable/electronic_scale_error"
                    android:scaleType="fitCenter"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/dimen_margin_20dp"/>
                <TextView
                    android:textColor="@color/white_70"
                    android:gravity="center_vertical"
                    android:id="@+id/tv_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/electronic_scale_no_weight_prompt"
                    android:maxLines="3"
                    android:lines="3"
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@+id/scale_go_weight"
                    android:layout_toEndOf="@+id/no_weight_iv_icon"
                    android:layout_marginHorizontal="10dp"
                    style="@style/FontRegular.11sp"/>
                <TextView
                    android:textColor="@color/white"
                    android:id="@+id/scale_go_weight"
                    android:background="@drawable/electronic_scale_go_weight_bg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/electronic_scale_go_weight"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="20dp"
                    android:layout_alignParentEnd="true"
                    android:paddingHorizontal="15dp"
                    android:paddingVertical="5dp"/>
            </RelativeLayout>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/page_padding_horizontal_large"
                android:layout_marginVertical="5dp"
                app:cardBackgroundColor="@color/shape_item_bg"
                app:cardCornerRadius="30dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:paddingBottom="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/icon_device"
                        android:layout_width="198dp"
                        android:layout_height="208dp"
                        android:layout_marginTop="20dp"
                        android:src="@drawable/electronic_scale_icon_electronic_scale"/>
                    <TextView
                        android:textColor="@color/electronic_scale_connect_status"
                        android:gravity="center"
                        android:id="@+id/device_state"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="15dp"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:layout_marginHorizontal="10dp">
                        <com.xiaomi.fitness.electronic.scale.widget.VerticalItemView
                            android:id="@+id/electronic_scale_weight"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            app:vi_image="@drawable/electronic_scale_icon_electronic_weight"
                            app:vi_text="@string/electronic_scale_weight"/>
                        <com.xiaomi.fitness.electronic.scale.widget.VerticalItemView
                            android:id="@+id/electronic_scale_visitor"
                            android:visibility="visible"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            app:vi_image="@drawable/electronic_scale_icon_electronic_visitor"
                            app:vi_text="@string/electronic_scale_visitor"/>
                        <com.xiaomi.fitness.electronic.scale.widget.VerticalItemView
                            android:id="@+id/electronic_scale_baby"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            app:vi_image="@drawable/electronic_scale_icon_electronic_baby"
                            app:vi_text="@string/electronic_scale_baby"/>
                        <com.xiaomi.fitness.electronic.scale.widget.VerticalItemView
                            android:id="@+id/electronic_scale_balance"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            app:vi_image="@drawable/electronic_scale_icon_electronic_balance"
                            app:vi_text="@string/electronic_scale_balance"/>
                    </LinearLayout>
                    <View
                        android:background="@color/divider_color"
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_marginTop="@dimen/dimen_margin_25dp"
                        android:layout_marginHorizontal="@dimen/dimen_margin_20dp"/>
                    <com.xiaomi.fitness.widget.RightArrowTwoLineTextView
                        android:id="@+id/electronic_scale_data_report"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_10"
                        android:paddingStart="@dimen/electronic_scale_dimen_margin_27dp"
                        android:paddingEnd="@dimen/electronic_scale_dimen_margin_22dp"
                        app:icon="@drawable/electronic_scale_icon_data_report"
                        app:showMore="true"
                        app:subtitle="@string/electronic_scale_data_subtitle"
                        app:title="@string/electronic_scale_device_data_report"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/electronic_scale_main_subtitle"
                        android:id="@+id/tv_device_settings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/electronic_scale_device_setting"
                        android:layout_marginStart="20dp"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp">
                        <com.xiaomi.fitness.widget.RightArrowBindingSingleLineTextView
                            android:id="@+id/electronic_scale_unit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="@dimen/electronic_scale_dimen_margin_27dp"
                            android:paddingEnd="@dimen/electronic_scale_dimen_margin_22dp"
                            app:icon="@drawable/electronic_scale_icon_electronic_unit"
                            app:showMore="true"
                            app:title="@string/electronic_scale_unit"/>
                        <com.xiaomi.fitness.widget.SwitchButtonBindingTwoLineTextView
                            android:id="@+id/electronic_scale_small_objects"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="@dimen/electronic_scale_dimen_margin_27dp"
                            android:paddingEnd="@dimen/electronic_scale_dimen_margin_22dp"
                            app:icon="@drawable/electronic_scale_icon_electronic_small_objects"
                            app:subtitle="@string/electronic_scale_small_objects_desc"
                            app:title="@string/electronic_scale_small_objects"/>
                        <com.xiaomi.fitness.widget.SwitchButtonBindingTwoLineTextView
                            android:id="@+id/electronic_scale_merge_desc"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="@dimen/electronic_scale_dimen_margin_27dp"
                            android:paddingEnd="@dimen/electronic_scale_dimen_margin_22dp"
                            app:icon="@drawable/electronic_scale_icon_electronic_weight_merge"
                            app:subtitle="@string/electronic_scale_merge_desc"
                            app:title="@string/electronic_scale_merge"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/electronic_scale_main_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="@string/electronic_scale_other_setting"
                        android:layout_marginStart="20dp"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp">
                        <com.xiaomi.fitness.widget.RightArrowBindingSingleLineTextView
                            android:id="@+id/electronic_scale_to_be_claimed"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="@dimen/electronic_scale_dimen_margin_27dp"
                            android:paddingEnd="@dimen/electronic_scale_dimen_margin_22dp"
                            app:icon="@drawable/electronic_scale_icon_electronic_to_be_claimed"
                            app:showMore="true"
                            app:title="@string/electronic_scale_to_be_claimed"/>
                        <com.xiaomi.fitness.widget.RightArrowBindingSingleLineTextView
                            android:id="@+id/electronic_scale_device_shared"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="@dimen/electronic_scale_dimen_margin_27dp"
                            android:paddingEnd="@dimen/electronic_scale_dimen_margin_22dp"
                            app:icon="@drawable/electronic_scale_icon_electronic_device_shared"
                            app:showMore="true"
                            app:title="@string/electronic_scale_device_shared"/>
                        <com.xiaomi.fitness.widget.RightArrowBindingSingleLineTextView
                            android:id="@+id/electronic_scale_update"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="@dimen/electronic_scale_dimen_margin_27dp"
                            android:paddingEnd="@dimen/electronic_scale_dimen_margin_22dp"
                            app:icon="@drawable/electronic_scale_icon_electronic_update"
                            app:showMore="true"
                            app:title="@string/electronic_scale_update"/>
                        <com.xiaomi.fitness.widget.RightArrowBindingSingleLineTextView
                            android:id="@+id/electronic_scale_wifi_setting"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="@dimen/electronic_scale_dimen_margin_27dp"
                            android:paddingEnd="@dimen/electronic_scale_dimen_margin_22dp"
                            app:icon="@drawable/electronic_scale_icon_electronic_wifi"
                            app:showMore="true"
                            app:title="@string/electronic_scale_net_setting"/>
                        <com.xiaomi.fitness.widget.RightArrowBindingSingleLineTextView
                            android:id="@+id/electronic_scale_device_about"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="@dimen/electronic_scale_dimen_margin_27dp"
                            android:paddingEnd="@dimen/electronic_scale_dimen_margin_22dp"
                            app:icon="@drawable/electronic_scale_icon_electronic_about"
                            app:showMore="true"
                            app:title="@string/electronic_scale_device_about"/>
                        <com.xiaomi.fitness.widget.RightArrowBindingSingleLineTextView
                            android:id="@+id/electronic_scale_to_help"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="@dimen/electronic_scale_dimen_margin_27dp"
                            android:paddingEnd="@dimen/electronic_scale_dimen_margin_22dp"
                            app:icon="@drawable/electronic_scale_icon_electronic_feedback"
                            app:showMore="true"
                            app:title="@string/electronic_scale_device_help_and_feedback"/>
                        <TextView
                            android:textColor="@color/text_color_40"
                            android:gravity="center"
                            android:id="@+id/electronic_scale_firmware_version"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="@dimen/electronic_scale_dimen_margin_27dp"
                            android:paddingEnd="@dimen/electronic_scale_dimen_margin_22dp"
                            android:paddingVertical="5dp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <Button
                android:id="@+id/btn_unbind"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="27dp"
                android:text="@string/electronic_scale_device_unbind"
                style="@style/CommonBtn.Primary"/>
        </LinearLayout>
    </com.xiaomi.fitness.electronic.scale.view.CustomScrollView>
</RelativeLayout>
