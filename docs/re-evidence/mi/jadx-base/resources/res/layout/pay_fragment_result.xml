<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/pay_fragment_result_0"
    android:background="@color/pay_channel_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/status_icon"
        android:tag="binding_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/status"
        android:tag="binding_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_13dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/status_icon"
        style="@style/FontDemiBold.24sp"/>
    <TextView
        android:id="@+id/status_desc"
        android:tag="binding_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/status"/>
    <TextView
        android:id="@+id/view_order"
        android:tag="binding_4"
        android:layout_width="@dimen/common_btn_two_column_width"
        android:layout_height="@dimen/common_btn_height"
        android:layout_marginTop="@dimen/dimen_margin_28dp"
        android:text="@string/pay_result_view_order"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="@dimen/dimen_margin_7dp"
        app:layout_constraintEnd_toStartOf="@+id/do_next"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/status_desc"
        style="@style/CommonBtn.Normal"/>
    <TextView
        android:id="@+id/do_next"
        android:tag="binding_5"
        android:layout_width="@dimen/common_btn_two_column_width"
        android:layout_height="@dimen/common_btn_height"
        android:layout_marginTop="@dimen/dimen_margin_28dp"
        android:layout_marginStart="@dimen/dimen_margin_7dp"
        android:layout_marginEnd="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/view_order"
        app:layout_constraintTop_toBottomOf="@+id/status_desc"
        style="@style/CommonBtn.Primary"/>
    <TextView
        android:id="@+id/recommend_title"
        android:tag="binding_6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_40dp"
        android:text="@string/pay_result_recommend_title"
        android:layout_marginStart="@dimen/dimen_margin_24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/do_next"
        style="@style/FontDemiBold.14sp"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recommend_list"
        android:tag="binding_7"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dimen_margin_6dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/recommend_title"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:tag="binding_8"
        android:background="@drawable/pay_bg_result_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dimen_margin_12dp"
        app:layout_constraintTop_toBottomOf="@+id/recommend_title">
        <ImageView
            android:id="@+id/preview"
            android:tag="binding_9"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_marginTop="@dimen/dimen_margin_9dp"
            android:layout_marginStart="@dimen/dimen_margin_12dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:id="@+id/name"
            android:tag="binding_10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_margin_10dp"
            app:layout_constraintBottom_toBottomOf="@+id/preview"
            app:layout_constraintStart_toEndOf="@+id/preview"
            app:layout_constraintTop_toTopOf="@+id/preview"
            style="@style/FontNormal.14sp"/>
        <TextView
            android:textSize="@dimen/dimen_18sp"
            android:id="@+id/price"
            android:tag="binding_11"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dimen_margin_12dp"
            app:layout_constraintBottom_toBottomOf="@+id/preview"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/preview"/>
        <View
            android:id="@+id/divider"
            android:background="@color/black_10"
            android:layout_width="match_parent"
            android:layout_height="0.67dp"
            android:layout_marginTop="@dimen/dimen_margin_16dp"
            android:layout_marginHorizontal="@dimen/dimen_margin_12dp"
            app:layout_constraintTop_toBottomOf="@+id/preview"/>
        <TextView
            android:textSize="@dimen/dimen_12sp"
            android:id="@+id/order_id_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_20dp"
            android:text="@string/pay_result_order_id"
            app:layout_constraintStart_toStartOf="@+id/preview"
            app:layout_constraintTop_toBottomOf="@+id/divider"/>
        <TextView
            android:textSize="@dimen/dimen_12sp"
            android:tag="binding_12"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dimen_margin_12dp"
            app:layout_constraintBottom_toBottomOf="@+id/order_id_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/order_id_title"/>
        <TextView
            android:textSize="@dimen/dimen_12sp"
            android:id="@+id/start_time_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_15dp"
            android:layout_marginBottom="@dimen/dimen_margin_20dp"
            android:text="@string/pay_result_order_time"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/preview"
            app:layout_constraintTop_toBottomOf="@+id/order_id_title"/>
        <TextView
            android:textSize="@dimen/dimen_12sp"
            android:tag="binding_13"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dimen_margin_12dp"
            app:layout_constraintBottom_toBottomOf="@+id/start_time_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/start_time_title"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
