<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/size_18"
    android:paddingEnd="@dimen/size_18">
    <RelativeLayout
        android:id="@+id/rl_detail_container"
        android:paddingTop="13.3dp"
        android:paddingBottom="13.3dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textColor="@color/text_color"
            android:gravity="start"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="@dimen/size_40"
            style="@style/FontMedium.14sp"/>
        <TextView
            android:textSize="@dimen/font_11"
            android:textColor="@color/text_color_40"
            android:gravity="start"
            android:id="@+id/tv_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tv_title"
            android:paddingEnd="@dimen/size_40"
            style="@style/FontRegular"/>
        <ImageView
            android:id="@+id/iv_more"
            android:background="@drawable/ic_health_sleep_item_more"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/audio_play_container"
        android:paddingTop="@dimen/size_15"
        android:paddingBottom="@dimen/size_15"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_audio_control"
            android:background="@drawable/ic_health_sleep_item_more"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/size_11_3"
            android:layout_marginEnd="@dimen/size_10"/>
        <androidx.appcompat.widget.AppCompatSeekBar
            android:layout_gravity="center_vertical"
            android:id="@+id/seekbar_audio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxHeight="@dimen/size_5_3"
            android:indeterminateOnly="false"
            android:progressDrawable="@drawable/drawable_sleep_audio_seekbar_progress"
            android:minHeight="@dimen/size_5_3"
            android:thumb="@null"
            android:thumbOffset="0dp"
            android:layout_weight="1"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"/>
        <TextView
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/size_10"
            android:layout_marginEnd="@dimen/size_30"/>
    </LinearLayout>
</LinearLayout>
