<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/lock_view_sport_title_0"
    android:background="@color/black"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/targetAndUnit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="70sp"
            android:textColor="@color/white_90"
            android:id="@+id/targetData"
            android:tag="binding_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/misanslatin_heavy"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/white_90"
            android:id="@+id/targetDataUnit"
            android:tag="binding_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignBaseline="@+id/targetData"
            android:fontFamily="@font/misanslatin_semibold"
            android:layout_marginStart="3dp"
            android:layout_toEndOf="@+id/targetData"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/goal_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/targetAndUnit">
        <android.widget.ProgressBar
            android:id="@+id/goal_progress_bar"
            android:tag="binding_3"
            android:paddingTop="@dimen/size_20"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:progressDrawable="@drawable/lock_view_indoor_progress_horizontal"
            style="@style/ProgressDialog"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/white"
            android:id="@+id/target"
            android:tag="binding_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_below="@+id/goal_progress_bar"
            android:fontFamily="@font/misanslatin_heavy"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/white"
            android:id="@+id/progress_value"
            android:tag="binding_5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/goal_progress_bar"
            android:fontFamily="@font/misanslatin_heavy"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
