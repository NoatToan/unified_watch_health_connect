<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/device_cl_scan_device_root"
    android:tag="layout/device_activity_guide_keep_alive_setting_0"
    android:background="@color/page_white_bg"
    android:paddingTop="@dimen/dimen_margin_20dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/text_color"
        android:id="@+id/device_manager_device_guide_keep_alive_des"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/device_manager_device_guide_keep_alive_des"
        android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
        android:layout_marginEnd="@dimen/page_content_padding_horizontal_large"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dimen_12sp"
        android:textColor="@color/text_color_40"
        android:id="@+id/device_manager_device_guide_keep_alive_notify_example"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="@string/device_manager_device_guide_keep_alive_notify_example"
        android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
        android:layout_marginEnd="@dimen/page_content_padding_horizontal_large"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/device_manager_device_guide_keep_alive_des"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/text_color"
        android:gravity="start|center_vertical"
        android:id="@+id/device_manager_device_guide_keep_alive_notify_example_notification"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="@string/device_manager_device_guide_keep_alive_notify_example_notification"
        android:drawablePadding="@dimen/dimen_margin_13dp"
        android:drawableStart="@drawable/device_guide_keep_alive_notification_icon"
        android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
        android:layout_marginEnd="@dimen/page_content_padding_horizontal_large"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/device_manager_device_guide_keep_alive_notify_example"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/text_color"
        android:gravity="start|center_vertical"
        android:id="@+id/device_manager_device_guide_keep_alive_notify_example_call"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_22dp"
        android:text="@string/device_manager_device_guide_keep_alive_notify_example_call"
        android:drawablePadding="@dimen/dimen_margin_13dp"
        android:drawableStart="@drawable/device_guide_keep_alive_call_icon"
        android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
        android:layout_marginEnd="@dimen/page_content_padding_horizontal_large"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/device_manager_device_guide_keep_alive_notify_example_notification"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/text_color"
        android:gravity="start|center_vertical"
        android:id="@+id/device_manager_device_guide_keep_alive_notify_example_data"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_22dp"
        android:text="@string/device_manager_device_guide_keep_alive_notify_example_data"
        android:drawablePadding="@dimen/dimen_margin_13dp"
        android:drawableStart="@drawable/device_guide_keep_alive_data_icon"
        android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
        android:layout_marginEnd="@dimen/page_content_padding_horizontal_large"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/device_manager_device_guide_keep_alive_notify_example_call"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/text_color"
        android:gravity="start|center_vertical"
        android:id="@+id/device_manager_device_guide_keep_alive_notify_example_helper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_22dp"
        android:text="@string/device_manager_device_guide_keep_alive_notify_example_helper"
        android:drawablePadding="@dimen/dimen_margin_13dp"
        android:drawableStart="@drawable/device_guide_keep_alive_help_icon"
        android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
        android:layout_marginEnd="@dimen/page_content_padding_horizontal_large"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/device_manager_device_guide_keep_alive_notify_example_data"/>
    <Button
        android:id="@+id/finish_button"
        android:layout_width="@dimen/common_btn_two_column_width"
        android:layout_height="@dimen/common_btn_height"
        android:text="@string/device_manager_device_guide_keep_alive_finish"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/to_set_button"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/CommonBtn.Normal"/>
    <Button
        android:id="@+id/to_set_button"
        android:layout_width="@dimen/common_btn_two_column_width"
        android:layout_height="@dimen/common_btn_height"
        android:text="@string/device_manager_device_guide_keep_alive_to_set"
        android:layout_marginStart="@dimen/page_extra_padding_horizontal_large"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/finish_button"
        style="@style/CommonBtn.Primary"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dimen_12sp"
        android:textColor="@color/text_color_50"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_margin_20dp"
        android:text="@string/device_manager_device_guide_keep_alive_note"
        android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
        android:layout_marginEnd="@dimen/page_content_padding_horizontal_large"
        app:layout_constraintBottom_toTopOf="@+id/finish_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
