<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rl_actionbar_mipay_sdk_web"
    android:layout_width="match_parent"
    android:layout_height="@dimen/mipay_sdk_web_actionbar_height"
    android:layoutDirection="ltr"
    android:forceDarkAllowed="false">
    <ImageView
        android:id="@+id/iv_back_actionbar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/mipay_sdk_web_actionbar_arrow_left"
        android:scaleType="centerCrop"
        android:layout_centerVertical="true"
        android:contentDescription="@string/mipay_sdk_web_return"
        android:layout_marginStart="@dimen/mipay_sdk_web_actionbar_padding_start"
        android:layout_alignParentStart="true"/>
    <ImageView
        android:id="@+id/iv_close_actionbar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/mipay_sdk_web_actionbar_close"
        android:scaleType="centerCrop"
        android:layout_centerVertical="true"
        android:contentDescription="@string/mipay_sdk_web_close"
        android:layout_marginStart="8dp"
        android:layout_toEndOf="@+id/iv_back_actionbar"/>
    <TextView
        android:textSize="@dimen/mipay_sdk_web_actionbar_title_text_size"
        android:textStyle="bold"
        android:textColor="@color/mipay_sdk_web_actionbar_title_text_color"
        android:gravity="center"
        android:id="@+id/tv_title_actionbar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_centerVertical="true"
        android:paddingEnd="28dp"
        android:layout_toStartOf="@+id/iv_extend_actionbar"
        android:layout_toEndOf="@+id/iv_close_actionbar"/>
    <ImageView
        android:id="@+id/iv_extend_actionbar"
        android:visibility="invisible"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/mipay_sdk_web_actionbar_faq"
        android:scaleType="centerCrop"
        android:layout_centerVertical="true"
        android:contentDescription="@string/mipay_sdk_web_faq"
        android:layout_marginEnd="@dimen/mipay_sdk_web_actionbar_padding_end"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
