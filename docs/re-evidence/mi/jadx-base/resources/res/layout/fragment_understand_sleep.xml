<?xml version="1.0" encoding="utf-8"?>
<com.xiaomi.fitness.health.sleep.view.AnchorScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/anchor_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:orientation="vertical"
        android:paddingBottom="@dimen/size_20"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.xiaomi.fitness.view.UnderstandItemView
            android:id="@+id/uiv_sleep_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:understand_detail="@string/health_sleep_duration_detail"
            app:understand_title="@string/health_sleep_duration_title"/>
        <com.xiaomi.fitness.view.UnderstandItemView
            android:id="@+id/uiv_sleep_distribute"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_20"
            app:understand_detail="@string/health_sleep_distribute_detail"
            app:understand_title="@string/health_sleep_distribute_title"/>
        <com.xiaomi.fitness.view.UnderstandItemView
            android:id="@+id/uiv_sleep_light"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_20"
            app:understand_detail="@string/health_sleep_light_sleep_detail"
            app:understand_title="@string/health_sleep_light_sleep_title"/>
        <com.xiaomi.fitness.view.UnderstandItemView
            android:id="@+id/uiv_sleep_deep"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_20"
            app:understand_detail="@string/health_sleep_deep_sleep_detail"
            app:understand_title="@string/health_sleep_deep_sleep_title"/>
        <com.xiaomi.fitness.view.UnderstandItemView
            android:id="@+id/uiv_eye_move"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_20"
            app:understand_detail="@string/health_sleep_rapid_eye_movement_detail"
            app:understand_title="@string/health_sleep_rapid_eye_movement_title"/>
        <com.xiaomi.fitness.view.UnderstandItemView
            android:id="@+id/uiv_sleep_awake"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_20"
            app:understand_detail="@string/health_sleep_awake_detail"
            app:understand_title="@string/health_sleep_awake_title"/>
        <com.xiaomi.fitness.view.UnderstandItemView
            android:id="@+id/uiv_sleep_suggest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_20"
            app:understand_detail="@string/health_sleep_suggest_detail"
            app:understand_title="@string/health_sleep_suggest_title"/>
        <com.xiaomi.fitness.view.UnderstandItemView
            android:id="@+id/uiv_sleep_nap_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_20"
            app:understand_detail="@string/health_sleep_nap_duration_detail"
            app:understand_title="@string/health_sleep_nap_duration_title"/>
        <com.xiaomi.fitness.view.UnderstandItemView
            android:id="@+id/uiv_sleep_nap_need"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_20"
            android:layout_marginBottom="@dimen/size_20"
            app:understand_detail="@string/health_sleep_nap_need_detail"
            app:understand_title="@string/health_sleep_nap_need_title"/>
        <include
            android:id="@+id/line"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/size_20"
            layout="@layout/layout_division_line"/>
        <com.xiaomi.fitness.view.UnderstandItemView
            android:id="@+id/uiv_sleep_reference"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_20"
            app:understand_detail="@string/data_sleep_reference_detail"
            app:understand_title="@string/health_sleep_reference_title"/>
    </LinearLayout>
</com.xiaomi.fitness.health.sleep.view.AnchorScrollView>
