<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rl_profile"
    android:layout_width="match_parent"
    android:layout_height="45dp"
    android:layout_marginTop="@dimen/dimen_margin_10dp"
    android:layout_marginStart="@dimen/dimen_margin_15dp"
    android:layout_marginEnd="@dimen/dimen_margin_20dp">
    <com.xiaomi.fitness.widget.view.RoundImageView
        android:id="@+id/img_avatar"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:src="@drawable/main_tab_me_normal"
        android:scaleType="centerCrop"
        android:layout_centerVertical="true"
        android:layout_alignParentStart="true"/>
    <ImageView
        android:id="@+id/img_avatar_bg"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_centerVertical="true"
        android:contentDescription="@string/trail_head_sculpture"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textSize="15dp"
        android:textColor="@color/common_black"
        android:id="@+id/txt_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_5dp"
        android:layout_alignParentTop="true"
        android:layout_marginStart="@dimen/dimen_margin_10dp"
        android:layout_toEndOf="@+id/img_avatar"/>
    <TextView
        android:textSize="15dp"
        android:textColor="@color/black_80_transparent"
        android:id="@+id/txt_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/txt_name"
        android:layout_marginStart="@dimen/dimen_margin_10dp"
        android:layout_toEndOf="@+id/img_avatar"/>
</RelativeLayout>
