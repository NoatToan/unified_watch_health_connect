<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/trail_item_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:paddingHorizontal="@dimen/dimen_margin_6dp">
    <TextView
        android:textSize="12sp"
        android:textColor="@color/trail_item_year"
        android:gravity="bottom"
        android:id="@+id/monthView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="27dp"
        android:paddingEnd="23dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contentView"
        android:background="@drawable/trail_record_item"
        android:layout_width="match_parent"
        android:layout_height="93dp"
        android:layout_marginTop="11dp"
        app:layout_constraintTop_toBottomOf="@+id/monthView"
        app:layout_goneMarginTop="0dp">
        <ImageView
            android:id="@+id/icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:scaleType="centerCrop"
            android:layout_marginStart="18dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:weightSum="3"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/icon"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:layout_marginStart="11dp"
                android:layout_marginEnd="@dimen/dimen_margin_10dp"
                app:layout_constraintStart_toEndOf="@+id/icon"
                app:layout_constraintTop_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textColor="@color/trail_black"
                    android:id="@+id/nameView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/FontMedium.16sp"/>
                <TextView
                    android:textSize="20sp"
                    android:textColor="@color/trail_black"
                    android:id="@+id/infoView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    style="@style/FontDemiBold.20sp"/>
                <TextView
                    android:textColor="@color/text_color_40"
                    android:id="@+id/des_view"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="@dimen/dimen_margin_4dp"
                    android:drawableStart="@drawable/icon_diving_point"/>
            </LinearLayout>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/trail_item_date"
                android:gravity="end|center_vertical"
                android:layout_gravity="center_vertical"
                android:id="@+id/dateView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawableEnd="@drawable/ic_trail_arrow_icon"
                android:layout_marginEnd="18dp"
                style="@style/FontMedium"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
