<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/main_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/page_content_padding_horizontal_large"
    android:paddingEnd="@dimen/page_content_padding_horizontal_large">
    <ImageView
        android:id="@+id/icon"
        android:visibility="gone"
        android:layout_width="@dimen/feature_item_icon_size"
        android:layout_height="@dimen/feature_item_icon_size"
        android:layout_marginTop="@dimen/feature_item_icon_top_bottom_margin"
        android:layout_marginBottom="@dimen/feature_item_icon_top_bottom_margin"
        android:scaleType="centerCrop"
        android:layout_marginEnd="@dimen/feature_item_title_start_margin"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/feature_item_title_top_bottom_margin"
        android:layout_marginBottom="13.33dp"
        android:layout_weight="1">
        <TextView
            android:textColor="@color/selector_feature_item_title_text_color"
            android:id="@android:id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:singleLine="true"
            style="@style/FontMedium.16sp"/>
        <TextView
            android:textColor="@color/selector_feature_item_subtitle_text_color"
            android:id="@android:id/summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/FontRegular.12sp"/>
    </LinearLayout>
    <com.xiaomi.fitness.health.bloodpressure.ui.CustomerSwitchButton
        android:id="@+id/widget_frame"
        android:layout_width="@dimen/lib_sb_width"
        android:layout_height="@dimen/lib_sb_height"
        android:layout_marginTop="@dimen/feature_item_icon_top_bottom_margin"
        android:contentDescription="@string/common_switch_off_content"
        android:layout_marginStart="@dimen/feature_item_more_margin_start"/>
</LinearLayout>
