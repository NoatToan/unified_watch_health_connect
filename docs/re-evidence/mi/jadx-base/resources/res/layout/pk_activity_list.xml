<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:tag="layout/pk_activity_list_0"
    android:background="@color/page_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <miuix.core.widget.NestedScrollView
        android:id="@+id/container"
        android:visibility="gone"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/page_padding_horizontal_large">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_invite_list"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never"
                android:nestedScrollingEnabled="false"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_pk_list"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never"
                android:nestedScrollingEnabled="false"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_history_list"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never"
                android:nestedScrollingEnabled="false"/>
        </LinearLayout>
    </miuix.core.widget.NestedScrollView>
    <TextView
        android:textColor="@color/pk_no_network_text_color"
        android:layout_gravity="center"
        android:id="@+id/no_network"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/pk_network_connection_failed_tip"
        android:drawableTop="@drawable/icon_no_network"
        android:drawablePadding="@dimen/size_10"
        style="@style/FontRegular.14sp"/>
    <TextView
        android:textColor="@color/pk_no_network_text_color"
        android:layout_gravity="center"
        android:id="@+id/loading"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sport_common_loading"
        style="@style/FontRegular.14sp"/>
</FrameLayout>
