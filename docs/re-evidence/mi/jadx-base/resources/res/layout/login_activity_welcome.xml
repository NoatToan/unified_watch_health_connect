<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/welcome_layout"
    android:tag="layout/login_activity_welcome_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/login_welcome_gradient_bg"
        android:scaleType="fitXY"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guideline1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.195"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/ball_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/login_welcome_ball_bg"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toTopOf="@+id/guideline2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_default="wrap"
        app:layout_constraintHeight_max="911dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/guideline1"
        app:layout_constraintWidth_max="911dp"
        app:layout_constraintWidth_percent="0.844"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guideline2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.603"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guideline3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.69"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/welcome_app_name_version"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/guideline_app_name_version_bottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/guideline3"
        app:layout_constraintWidth_max="327dp"
        app:layout_constraintWidth_percent="0.415">
        <TextView
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/welcome_app_name"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="@string/welcome_app_name"
            android:fontFamily="@font/misanslatin_demibold"
            android:letterSpacing="0.4"
            android:autoSizeTextType="uniform"
            android:autoSizeStepGranularity="0.1sp"
            android:autoSizeMinTextSize="5sp"
            android:layout_marginHorizontal="1dp"
            android:autoSizeMaxTextSize="45sp"
            android:justificationMode="inter_word"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="327:56"
            app:layout_constraintEnd_toStartOf="@+id/welcome_app_version"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintHorizontal_weight="327"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/welcome_app_version"
            android:background="@drawable/login_welcome_app_version_bg"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="@string/welcome_version_4_0"
            android:fontFamily="@font/misanslatin_demibold"
            android:autoSizeTextType="uniform"
            android:autoSizeStepGranularity="0.1sp"
            android:autoSizeMinTextSize="5sp"
            android:layout_marginHorizontal="0.5dp"
            android:paddingVertical="1dp"
            android:autoSizeMaxTextSize="45sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="112:55"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="112"
            app:layout_constraintStart_toEndOf="@+id/welcome_app_name"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guideline_app_name_version_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.714"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guideline_welcome_textview_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.728"/>
    <TextView
        android:textSize="30sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/welcome_textview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/login_welcome_text"
        android:fontFamily="@font/misanslatin_demibold"
        android:autoSizeTextType="uniform"
        android:autoSizeStepGranularity="0.1sp"
        android:autoSizePresetSizes="50sp"
        android:autoSizeMinTextSize="15sp"
        android:autoSizeMaxTextSize="115sp"
        app:layout_constraintBottom_toTopOf="@+id/guideline_welcome_textview_bottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/guideline_welcome_textview_top"
        app:layout_constraintWidth_max="420dp"
        app:layout_constraintWidth_percent="0.637"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guideline_welcome_textview_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.786"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guideline_welcome_desc_textview_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.79"/>
    <TextView
        android:textSize="30sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/welcome_desc_textview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/login_welcome_text_desc"
        android:fontFamily="@font/misanslatin_demibold"
        android:letterSpacing="0.9"
        android:autoSizeTextType="uniform"
        android:autoSizeStepGranularity="0.1sp"
        android:autoSizePresetSizes="20sp"
        android:autoSizeMinTextSize="5sp"
        android:autoSizeMaxTextSize="42sp"
        app:layout_constraintBottom_toTopOf="@+id/guideline_welcome_desc_textview_bottom"
        app:layout_constraintEnd_toEndOf="@+id/welcome_textview"
        app:layout_constraintStart_toStartOf="@+id/welcome_textview"
        app:layout_constraintTop_toBottomOf="@+id/guideline_welcome_desc_textview_top"
        app:layout_constraintWidth_max="420dp"
        app:layout_constraintWidth_percent="0.637"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guideline_welcome_desc_textview_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.812"/>
    <Button
        android:textSize="24sp"
        android:textColor="@color/login_text_brown"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/welcome_button"
        android:background="@drawable/login_btn_bg_yellow"
        android:layout_width="0dp"
        android:layout_height="46.67dp"
        android:layout_marginBottom="@dimen/dimen_margin_50dp"
        android:maxWidth="@dimen/common_btn_single_line_width"
        android:text="@string/login_immediate_experience"
        android:fontFamily="@font/misanslatin_demibold"
        android:autoSizeTextType="uniform"
        android:autoSizeStepGranularity="0.1sp"
        android:autoSizePresetSizes="24sp"
        android:autoSizeMinTextSize="5sp"
        android:layout_marginHorizontal="@dimen/dimen_margin_12dp"
        android:paddingVertical="10dp"
        android:autoSizeMaxTextSize="35sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
