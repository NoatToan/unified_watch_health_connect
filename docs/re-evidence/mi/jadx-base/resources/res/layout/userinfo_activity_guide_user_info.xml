<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/userinfo_activity_guide_user_info_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <miuix.springback.view.SpringBackLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scrollableView="@+id/scroll_view">
        <miuix.core.widget.NestedScrollView
            android:id="@+id/scroll_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="@dimen/dimen_margin_28dp"
                android:paddingEnd="@dimen/dimen_margin_24dp">
                <TextView
                    android:textSize="@dimen/dimen_13sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/userinfo_guide_edit_subtitle"
                    android:alpha="0.4"
                    android:fontFamily="@font/misanslatin_regular"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/userinfo_margin_60dp"
                    android:layout_marginBottom="@dimen/feature_header_dimen_margin_18dp">
                    <TextView
                        android:textColor="@color/selector_feature_item_title_text_color"
                        android:ellipsize="end"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/tv_gender"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:layout_weight="1"
                        style="@style/FontMedium.16sp"/>
                    <RadioGroup
                        android:layout_gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/rg_gender"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <RadioButton
                            android:textColor="@color/widget_base_right_arrow_color"
                            android:id="@+id/rb_man"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:button="@null"
                            android:text="@string/userinfo_gender_male"
                            android:drawablePadding="5dp"
                            android:drawableStart="@drawable/userinfo_radiobutton_gender_man"/>
                        <RadioButton
                            android:textColor="@color/widget_base_right_arrow_color"
                            android:id="@+id/rb_female"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:button="@null"
                            android:text="@string/userinfo_gender_female"
                            android:drawablePadding="5dp"
                            android:drawableStart="@drawable/userinfo_radiobutton_gender_female"
                            android:layout_marginStart="@dimen/feature_header_dimen_margin_30dp"/>
                    </RadioGroup>
                </LinearLayout>
                <com.xiaomi.fitness.widget.RightArrowSingleLineTextView
                    android:id="@+id/line_height"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:remindTextEnable="true"
                    app:showMore="true"
                    app:title="@string/userinfo_common_height"/>
                <com.xiaomi.fitness.widget.RightArrowSingleLineTextView
                    android:id="@+id/line_weight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:remindTextEnable="true"
                    app:showMore="true"
                    app:title="@string/userinfo_data_type_weight"/>
                <com.xiaomi.fitness.widget.RightArrowSingleLineTextView
                    android:id="@+id/line_birthday"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:remindTextEnable="true"
                    app:showMore="true"
                    app:title="@string/userinfo_user_birthday"/>
            </LinearLayout>
        </miuix.core.widget.NestedScrollView>
    </miuix.springback.view.SpringBackLayout>
    <Button
        android:id="@+id/btn_continue"
        android:text="@string/common_continue"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/CommonBtn.Primary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
