<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="horizontal"
    android:tag="layout/fragmet_sport_detail_step_down_up_level_item_0"
    android:paddingTop="@dimen/dimen_margin_5dp"
    android:paddingBottom="@dimen/dimen_margin_5dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">
    <TextView
        android:textColor="@color/text_color"
        android:gravity="left"
        android:id="@+id/speed"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/trail_sport_summary_step_speed"
        android:layout_weight="1"/>
    <TextView
        android:textColor="@color/text_color"
        android:gravity="left"
        android:id="@+id/downUp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/trail_sport_summary_step_down_up"
        android:layout_weight="1"/>
    <RelativeLayout
        android:id="@+id/relativeView"
        android:layout_width="0dp"
        android:layout_height="20dp"
        android:layout_weight="1">
        <com.xiaomi.fitness.detail.view.SportPaceSegmentView
            android:id="@+id/downUpSegmentView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:segmentCommonColor="#ffbb00"
            app:segmentFastColor="#ff8a05"/>
        <com.xiaomi.fitness.baseui.widget.CircularCoverView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            app:cover_color="@color/trail_level_cover_bg"
            app:left_bottom_radius="5dp"
            app:left_top_radius="5dp"
            app:right_bottom_radius="5dp"
            app:right_top_radius="5dp"/>
    </RelativeLayout>
    <TextView
        android:textColor="@color/text_color"
        android:gravity="center"
        android:id="@+id/time"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/trail_sport_summary_step_time"
        android:layout_weight="1"/>
    <TextView
        android:textColor="@color/text_color"
        android:gravity="center"
        android:id="@+id/level"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/trail_sport_summary_step_level"
        android:layout_weight="1"/>
</LinearLayout>
