<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/layoutView"
    android:tag="layout/nfc_fragment_new_pay_0"
    android:paddingTop="0dp"
    android:paddingBottom="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="0dp"
    android:paddingStart="@dimen/page_content_padding_horizontal_large"
    android:paddingEnd="@dimen/page_content_padding_horizontal_large">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/nfc_nextpay_transit_result_center_layout_margin_top"
        android:minHeight="70dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true">
            <TextView
                android:textSize="@dimen/nfc_common_textsize_2"
                android:textColor="@color/text_color"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="交易金额"/>
            <TextView
                android:textSize="@dimen/nfc_common_textsize_5"
                android:textColor="@color/text_color_40"
                android:id="@+id/amountView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/nfc_common_textsize_5"
            android:textColor="@color/text_color_40"
            android:id="@+id/pay_coupon_tv"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="90dp">
        <TextView
            android:textSize="@dimen/nfc_common_textsize_2"
            android:textColor="@color/text_color"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="订单详情"/>
        <TextView
            android:textSize="@dimen/nfc_common_textsize_5"
            android:textColor="@color/text_color_40"
            android:id="@+id/payFeeView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="@dimen/nfc_common_textsize_5"
            android:textColor="@color/text_color_40"
            android:id="@+id/pay_order_tv"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <View
        android:background="@color/black_50_transparent"
        android:layout_width="match_parent"
        android:layout_height="0.67dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"/>
    <TextView
        android:textSize="@dimen/nfc_common_textsize_5"
        android:textColor="@color/text_color_60"
        android:gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="33dp"
        android:text="支付方式"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/alipayLayoutView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="53.33dp">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/nfc_pay_alipay_icon"
            android:layout_marginStart="5dp"/>
        <TextView
            android:textSize="@dimen/nfc_common_textsize_2"
            android:textColor="@color/text_color"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/nfc_pay_alipay"
            android:layout_weight="1"
            android:layout_marginStart="12dp"/>
        <ImageView
            android:enabled="false"
            android:gravity="center"
            android:id="@+id/alipayCheckView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/selector_check"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/pay_wechat_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="53.33dp">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/nfc_pay_wechat_icon"
            android:layout_marginStart="5dp"/>
        <TextView
            android:textSize="@dimen/nfc_common_textsize_2"
            android:textColor="@color/text_color"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="微信支付"
            android:layout_weight="1"
            android:layout_marginStart="12dp"/>
        <ImageView
            android:enabled="false"
            android:gravity="center"
            android:id="@+id/wechatCheckView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/selector_check"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/webAllPayView"
        android:layout_width="match_parent"
        android:layout_height="53.33dp">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/nfc_pay_mipay_icon"
            android:layout_marginStart="5dp"/>
        <TextView
            android:textSize="@dimen/nfc_common_textsize_2"
            android:textColor="@color/text_color"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/nfc_web_all_pay"
            android:layout_weight="1"
            android:layout_marginStart="12dp"/>
        <ImageView
            android:enabled="false"
            android:gravity="center"
            android:id="@+id/webAllPayCbView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/selector_check"/>
    </LinearLayout>
    <View
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <TextView
        android:id="@+id/payView"
        android:layout_width="match_parent"
        android:layout_marginBottom="@dimen/common_title_left_margin"
        android:text="去支付"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp"
        style="@style/CommonBtn.Primary"/>
</LinearLayout>
