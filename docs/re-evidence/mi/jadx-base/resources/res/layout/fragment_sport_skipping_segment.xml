<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/fragment_sport_skipping_segment_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.xiaomi.fitness.widget.view.DataTitleSimpleView
        android:id="@+id/dataSimpleTitleView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <View
        android:background="@color/common_divider_color"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginBottom="@dimen/dimen_margin_15dp"
        android:layout_marginStart="@dimen/dimen_margin_20dp"
        android:layout_marginEnd="@dimen/dimen_margin_20dp"/>
    <com.xiaomi.fitness.chart.mpchart.linechart.CustomLineChart
        android:id="@+id/chart"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/custom_chart_height_245dp"
        android:layout_marginTop="2dp"
        android:paddingStart="2dp"
        android:paddingEnd="@dimen/padding_1dp"
        app:maxYAxisRatio="0.2"
        app:minYAxisZero="false"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_skipping_segment"
        android:paddingBottom="@dimen/dimen_margin_20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
