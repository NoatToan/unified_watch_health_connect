<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/course_catalog_feed_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.mi.health.course.widget.NoNestScrollRecyclerView
        android:orientation="vertical"
        android:id="@+id/tabView"
        android:background="@drawable/common_tab_bg"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:minHeight="37dp"
        android:overScrollMode="never"
        android:paddingStart="@dimen/page_padding_horizontal_large"
        android:paddingEnd="@dimen/page_padding_horizontal_large"
        android:layout_marginStart="@dimen/page_padding_horizontal_large"
        android:layout_marginEnd="@dimen/page_padding_horizontal_large"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:spanCount="3"/>
    <FrameLayout
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="19dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tabView"
        app:layout_goneMarginTop="15dp">
        <include
            android:id="@+id/state_view"
            android:visibility="gone"
            layout="@layout/view_text_icon"/>
        <com.xiaomi.fitness.baseui.recyclerview.MoreRecyclerView
            android:orientation="vertical"
            android:id="@+id/recycler_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/selectView"
        android:background="@color/course_catalog_mask"
        android:paddingBottom="@dimen/dimen_margin_10dp"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tabView">
        <com.mi.health.course.widget.NoNestScrollRecyclerView
            android:id="@+id/tagsView"
            android:background="@color/course_white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:paddingStart="15dp"
            android:paddingEnd="27dp"/>
        <View
            android:id="@+id/holder"
            android:background="@drawable/course_catalog_bg"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="70dp"
            app:layout_constraintTop_toBottomOf="@+id/tagsView"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tagsView">
            <TextView
                android:id="@+id/resetView"
                android:layout_width="@dimen/common_btn_two_column_width"
                android:layout_height="@dimen/common_btn_height"
                android:text="@string/course_reset"
                app:layout_constraintBottom_toBottomOf="@+id/holder"
                app:layout_constraintEnd_toStartOf="@+id/confirmView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/holder"
                style="@style/CommonBtn.Normal"/>
            <TextView
                android:id="@+id/confirmView"
                android:layout_width="@dimen/common_btn_two_column_width"
                android:layout_height="@dimen/common_btn_height"
                android:text="@string/confirm"
                app:layout_constraintBottom_toBottomOf="@+id/resetView"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/resetView"
                app:layout_constraintTop_toTopOf="@+id/resetView"
                style="@style/CommonBtn.Primary"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
