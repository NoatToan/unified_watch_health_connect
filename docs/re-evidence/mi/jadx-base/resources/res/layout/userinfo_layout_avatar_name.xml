<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/userinfo_size_15_33">
    <com.xiaomi.fitness.widget.view.RoundImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/iv_avatar"
        android:layout_width="@dimen/userinfo_margin_60dp"
        android:layout_height="@dimen/userinfo_margin_60dp"
        android:layout_marginTop="34.15dp"
        android:layout_marginBottom="@dimen/userinfo_size_20"
        android:src="@drawable/ic_avatar_default"
        android:contentDescription="@string/userinfo_avatar"
        app:userinfo_riv_oval="true"/>
    <android.widget.EditText
        android:gravity="center"
        android:id="@+id/edit_name"
        android:paddingTop="@dimen/userinfo_size_20"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:maxLength="100"
        style="@style/userinfo_AidEditTextStyle"/>
</LinearLayout>
