<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/dimen_20sp"
        android:textStyle="bold"
        android:id="@+id/ftp_result_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sport_ftp_level"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/dimen_18sp"
        android:textStyle="bold"
        android:id="@+id/ftp_result_des"
        android:paddingLeft="32dp"
        android:paddingTop="16dp"
        android:paddingRight="32dp"
        android:paddingBottom="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_14dp"
        android:text="@string/sport_ftp_level_info"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.501"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ftp_result_title"/>
    <Button
        android:textColor="@color/white"
        android:id="@+id/ftp_result_button"
        android:background="@drawable/sport_selector_vector_bike_exception"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="@dimen/dimen_margin_16dp"
        android:layout_marginRight="32dp"
        android:text="@string/sport_switch_mode_sure"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ftp_result_des"/>
</androidx.constraintlayout.widget.ConstraintLayout>
