<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/nfc_settings_fragment_upgrade_pwd_security_level_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/watch_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="47dp"
        android:layout_centerHorizontal="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.xiaomi.fitness.nfc.widget.DeviceImageView
            android:id="@+id/watch_iv"
            android:layout_width="196dp"
            android:layout_height="196dp"/>
        <miuix.androidbasewidget.widget.ProgressBar
            android:layout_gravity="center"
            android:id="@+id/issue_loading_pb"
            android:visibility="gone"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:indeterminateDrawable="@drawable/nfc_card_issuing_indeterminate"
            android:indeterminateDuration="2000"
            android:interpolator="@android:interpolator/accelerate_decelerate"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/upgrade_status_img"
            android:visibility="gone"
            android:layout_width="50dp"
            android:layout_height="50dp"/>
    </FrameLayout>
    <TextView
        android:textSize="@dimen/dimen_24sp"
        android:textColor="@color/black"
        android:id="@+id/upgrade_status_txt"
        android:paddingBottom="3dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/watch_layout"/>
    <TextView
        android:textSize="@dimen/dialog_text_size_14"
        android:gravity="center"
        android:id="@+id/upgrade_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/nfc_settings_mastercard_pwd_upgrade_desc"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/upgrade_status_txt"/>
    <Button
        android:id="@+id/agree_btn"
        android:text="@string/passport_request_agree"
        app:layout_constraintBottom_toTopOf="@+id/cancleView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/CommonBtn.Black"/>
    <Button
        android:id="@+id/cancleView"
        android:text="@string/common_reject"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/CommonBtn.Gray"/>
    <Button
        android:id="@+id/status_btn"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/CommonBtn.Black"/>
</androidx.constraintlayout.widget.ConstraintLayout>
