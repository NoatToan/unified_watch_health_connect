<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:background="@drawable/widget_default_corners_background_radius_20"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:maxWidth="364dp"
    android:maxHeight="170dp">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@android:id/widget_frame"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="12"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="132">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="12"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="48">
                <ImageView
                    android:id="@+id/img_main"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_widget_rainbow_load_preview_2_2"
                    android:scaleType="fitXY"
                    android:layout_weight="96"
                    android:importantForAccessibility="no"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="34"/>
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="20"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="20"
                android:importantForAccessibility="no">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/img_type_calories"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_widget_calorie"
                    android:adjustViewBounds="true"
                    android:layout_weight="18"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="4"/>
                <TextView
                    android:textSize="18sp"
                    android:textColor="@color/text_color"
                    android:gravity="start|center_vertical"
                    android:id="@+id/tv_calories_progress"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text=" - "
                    android:maxLines="1"
                    android:layout_weight="128"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="2sp"
                    android:autoSizeMaxTextSize="18sp"
                    android:textFontWeight="450"/>
            </LinearLayout>
            <TextView
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="4"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="20"
                android:importantForAccessibility="no">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/img_type_step"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_widget_step"
                    android:adjustViewBounds="true"
                    android:layout_weight="18"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="4"/>
                <TextView
                    android:textSize="18sp"
                    android:textColor="@color/text_color"
                    android:gravity="start|center_vertical"
                    android:id="@+id/tv_step_progress"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text=" - "
                    android:maxLines="1"
                    android:layout_weight="128"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="2sp"
                    android:autoSizeMaxTextSize="18sp"
                    android:textFontWeight="450"/>
            </LinearLayout>
            <TextView
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="4"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="20"
                android:importantForAccessibility="no">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/img_type_third"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_widget_mh_strength"
                    android:adjustViewBounds="true"
                    android:layout_weight="18"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="4"/>
                <TextView
                    android:textSize="18sp"
                    android:textColor="@color/text_color"
                    android:gravity="start|center_vertical"
                    android:id="@+id/tv_third_progress"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text=" - "
                    android:maxLines="1"
                    android:layout_weight="128"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="2sp"
                    android:autoSizeMaxTextSize="18sp"
                    android:textFontWeight="450"/>
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="12"/>
        </LinearLayout>
        <TextView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="13"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="177">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="18"/>
            <ImageView
                android:id="@+id/calorieChart"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:scaleType="fitXY"
                android:minHeight="30dp"
                android:layout_weight="32"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="8"/>
            <ImageView
                android:id="@+id/stepChart"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:scaleType="fitXY"
                android:minHeight="30dp"
                android:layout_weight="32"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="8"/>
            <ImageView
                android:id="@+id/strengthChart"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:scaleType="fitXY"
                android:minHeight="30dp"
                android:layout_weight="32"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="5"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/xAxisView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="13"
                android:layoutDirection="ltr">
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/text_color_30"
                    android:gravity="start|center_vertical"
                    android:id="@+id/LabelStart"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/data_xaxis_time_0"
                    android:layout_weight="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="2sp"
                    android:autoSizeMaxTextSize="11sp"
                    android:textFontWeight="380"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/text_color_30"
                    android:gravity="end|center_vertical"
                    android:id="@+id/LabelEnd"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/data_xaxis_time_24"
                    android:layout_weight="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="2sp"
                    android:autoSizeMaxTextSize="11sp"
                    android:textFontWeight="380"/>
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="12"/>
        </LinearLayout>
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="12"/>
    </LinearLayout>
</FrameLayout>
