<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/dimen_16sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/device_add_discovery_paired"/>
    <TextView
        android:textSize="@dimen/dimen_16sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_gravity="center_horizontal"
        android:id="@+id/dialog_paird_device_name_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/dialog_device_imageView"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_marginTop="20dp"
        android:scaleType="fitXY"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/common_main_dark_gray_color"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/device_wearos_not_found_paired_tips"
        android:layout_marginStart="@dimen/common_btn_top_label_margin"
        android:layout_marginEnd="@dimen/common_btn_top_label_margin"/>
    <TextView
        android:id="@+id/dialog_known_btn"
        android:layout_marginTop="19dp"
        android:text="@string/common_known"
        style="@style/CommonBtn.Black"/>
    <TextView
        android:textSize="@dimen/dimen_12sp"
        android:textStyle="bold"
        android:textColor="@color/common_main_dark_gray_color"
        android:layout_gravity="center_horizontal"
        android:id="@+id/dialog_passed_wearos_process_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="26.6dp"
        android:text="@string/device_wearos_paired_process_passed"/>
</LinearLayout>
