<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/weight_body_composition_card"
    android:tag="layout/health_layout_weight_body_composition_0"
    android:background="@drawable/shape_data_item_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="13.3dp">
    <include
        android:id="@+id/layout_common_icon_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_20"
        layout="@layout/health_layout_common_card_icon_title"/>
    <include layout="@layout/layout_division_line"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/weight_body_composition_distribution_content"
        android:tag="binding_1"
        android:paddingTop="8.3dp"
        android:paddingBottom="23.3dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_body_distribution"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_weight_body_distribute_male"/>
        <include
            android:id="@+id/weight_item_fat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            app:layout_constraintEnd_toStartOf="@+id/iv_body_distribution"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/iv_body_distribution"
            layout="@layout/health_layout_card_data_item"/>
        <include
            android:id="@+id/weight_item_salt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="141.3dp"
            app:layout_constraintEnd_toStartOf="@+id/iv_body_distribution"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/iv_body_distribution"
            layout="@layout/health_layout_card_data_item"/>
        <include
            android:id="@+id/weight_item_protein"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="141.3dp"
            android:layout_marginStart="-7dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/iv_body_distribution"
            app:layout_constraintTop_toTopOf="@+id/iv_body_distribution"
            layout="@layout/health_layout_card_data_item"/>
        <include
            android:id="@+id/weight_item_water"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginStart="-7dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/iv_body_distribution"
            app:layout_constraintTop_toTopOf="@+id/iv_body_distribution"
            layout="@layout/health_layout_card_data_item"/>
        <TextView
            android:textColor="@color/text_color_40"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14.3dp"
            android:text="@string/health_weight_body_composition_distribution"
            android:layout_marginHorizontal="@dimen/size_10"
            app:layout_constraintTop_toBottomOf="@+id/iv_body_distribution"
            style="@style/FontNormal.12sp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/weight_body_composition_recycler"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="13.3dp"
        android:overScrollMode="never"/>
</LinearLayout>
