<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/relative_care_layout_edit_label_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/page_content_padding_horizontal_large">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/button"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:paddingBottom="@dimen/dimen_margin_40dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <EditText
                android:textSize="17sp"
                android:textColor="@color/text_color"
                android:textColorHint="@color/text_color_40"
                android:id="@+id/add_label_edit_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_40dp"
                android:layout_marginBottom="@dimen/dimen_margin_10dp"
                android:hint="@string/relative_care_add_a_note"
                android:inputType="text"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.xiaomi.fitness.widget.view.DividerView
                android:id="@+id/horizontal_divider"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/dimen_margin_20dp"
                app:layout_constraintTop_toBottomOf="@+id/add_label_edit_text"/>
            <TextView
                android:id="@+id/system_recommendation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="58.6dp"
                android:text="@string/relative_care_data_range_recommended_label"
                app:layout_constraintTop_toBottomOf="@+id/add_label_edit_text"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recommendation_tags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_20dp"
                android:overScrollMode="never"
                android:nestedScrollingEnabled="false"
                app:layout_constraintTop_toBottomOf="@+id/system_recommendation"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <TextView
        android:textSize="@dimen/dimen_16sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/button"
        android:background="@drawable/selector_bottom_btn_positive_bg"
        android:layout_width="@dimen/common_btn_single_line_width"
        android:layout_height="@dimen/common_btn_height"
        android:layout_marginBottom="26.67dp"
        android:text="@string/confirm"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
