<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/contentLayout"
    android:tag="layout/sport_fragment_empty_route_0"
    android:background="@drawable/sport_route_ai_create_bg"
    android:paddingTop="20dp"
    android:paddingBottom="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="29dp">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/noRouteTitleLayout"
        android:paddingBottom="15dp"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="23sp"
            android:textColor="@color/text_color"
            android:gravity="start|center_vertical"
            android:id="@+id/noAiRouteTitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sport_no_suitable_route_available"
            android:fontFamily="@font/misanslatin_semibold"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/text_color_40"
            android:gravity="start|center_vertical"
            android:id="@+id/noUserRouteSubTitleText"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sport_user_route_planning_failed_subtitle"
            android:fontFamily="@font/misanslatin_regular"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/text_color_40"
            android:gravity="start|center_vertical"
            android:id="@+id/noAiRouteSubTitleText"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sport_ai_route_planning_failed_subtitle"
            android:fontFamily="@font/misanslatin_regular"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/midContentView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <com.xiaomi.fitness.sport.view.tab.adapter.RunningRouteView
            android:id="@+id/runningRouteView"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="bottom|center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/bottomButtonLayout"
        android:paddingTop="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:textSize="18dp"
            android:gravity="center"
            android:layout_gravity="end"
            android:id="@+id/button_next"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/sport_re_create"
            android:layout_weight="1"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            style="@style/SportCreateRouteOrangeButtonStyle"/>
    </LinearLayout>
</LinearLayout>
