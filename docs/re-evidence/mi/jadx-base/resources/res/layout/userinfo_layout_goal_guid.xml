<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/userinfo_layout_goal_guid_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/imageView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:src="@drawable/userinfo_switch_mhs_goal_icon"
        app:layout_constraintBottom_toBottomOf="@+id/textViewDesc"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/userinfo_black"
        android:gravity="center"
        android:id="@+id/textViewDesc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_20dp"
        android:text="@string/userinfo_target_dynamic_indicators_desc"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView"
        style="@style/FontNormal.14sp"/>
    <TextView
        android:textColor="@color/userinfo_default_text_black"
        android:id="@+id/defaultGoalView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="13dp"
        android:text="@string/userinfo_target_use_default_value"
        app:layout_constraintBottom_toTopOf="@+id/goalDynamicIndicatorsView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/FontNormal.12sp"/>
    <TextView
        android:id="@+id/goalDynamicIndicatorsView"
        android:layout_marginBottom="@dimen/userinfo_size_27"
        android:text="@string/userinfo_set_target_dynamic_indicators"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/userinfo_Button.FullWidth.Menstrual.Orange"/>
</androidx.constraintlayout.widget.ConstraintLayout>
