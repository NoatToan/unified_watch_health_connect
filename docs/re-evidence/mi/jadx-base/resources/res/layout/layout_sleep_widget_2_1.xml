<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:background="@drawable/widget_default_corners_background_12_67"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@android:id/widget_frame"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:paddingHorizontal="12dp">
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <TextView
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="8"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/text_color"
                android:gravity="start|center_vertical"
                android:id="@+id/widgetSleepTitle"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:text="@string/widget_sleep_title"
                android:maxLines="1"
                android:layout_weight="16"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="2sp"
                android:autoSizeMaxTextSize="12sp"
                android:textFontWeight="600"/>
            <TextView
                android:textSize="22sp"
                android:textColor="@color/text_color"
                android:gravity="start|center_vertical"
                android:id="@+id/widgetSleepValue"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:text="--"
                android:maxLines="1"
                android:layout_weight="28"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="2sp"
                android:autoSizeMaxTextSize="22sp"
                android:textFontWeight="600"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/text_color"
                android:gravity="start|center_vertical"
                android:id="@+id/tv_sleep_tip"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:text="@string/no_record"
                android:layout_weight="28"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="2sp"
                android:autoSizeMaxTextSize="16sp"
                android:textFontWeight="550"/>
            <TextView
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="7"/>
        </LinearLayout>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_sleep_image"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_widget_sleep_bed"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no"
            android:layout_marginStart="3dp"/>
    </LinearLayout>
</FrameLayout>
