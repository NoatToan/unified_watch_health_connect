<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:id="@+id/root_container"
    android:background="@color/page_white_bg"
    android:paddingBottom="@dimen/dimen_margin_20dp"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:id="@+id/layout_back"
        android:layout_width="match_parent"
        android:layout_height="55dp">
        <androidx.appcompat.widget.AppCompatImageButton
            android:layout_gravity="center_vertical"
            android:id="@+id/back_iv"
            android:background="@drawable/ic_left_back_black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="22dp"/>
    </LinearLayout>
    <TextView
        android:textSize="32sp"
        android:textColor="@color/text_color_80"
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/electronic_scale_reset"
        android:layout_below="@+id/layout_back"
        android:fontFamily="@font/misanslatin_regular"
        android:layout_marginStart="28dp"/>
    <com.xiaomi.fitness.webview.CustomWebView
        android:id="@+id/webView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginBottom="@dimen/dimen_margin_20dp"
        android:layout_above="@+id/reset_btn"
        android:layout_below="@+id/tv_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/text_color_80"
        android:gravity="center"
        android:id="@+id/tv_sub_title"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/electronic_scale_name"
        android:layout_below="@+id/tv_title"
        android:layout_marginStart="30dp"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/text_color_80"
        android:id="@+id/tv_desc"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/electronic_scale_reset_desc"
        android:layout_below="@+id/tv_sub_title"
        android:layout_marginHorizontal="30dp"/>
    <ImageView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_below="@+id/tv_desc"
        android:layout_marginHorizontal="@dimen/dimen_margin_20dp"/>
    <Button
        android:id="@+id/reset_btn"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="@dimen/dimen_margin_40dp"
        android:text="@string/electronic_scale_reseted"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="@dimen/dimen_margin_30dp"
        style="@style/CommonBtn.Primary"/>
</RelativeLayout>
