<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_item"
    android:tag="layout/course_catalog_item_0"
    android:layout_width="match_parent"
    android:layout_height="52dp">
    <View
        android:id="@+id/view_catalog_selected"
        android:background="@color/colorPrimary"
        android:layout_width="@dimen/dimen_margin_2dp"
        android:layout_height="12dp"
        android:layout_marginEnd="1.6dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_course_catalog"
        app:layout_constraintEnd_toStartOf="@+id/tv_course_catalog"
        app:layout_constraintTop_toTopOf="@+id/tv_course_catalog"/>
    <TextView
        android:textSize="@dimen/dimen_13sp"
        android:textStyle="bold"
        android:textColor="@color/text_color"
        android:id="@+id/tv_course_catalog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="全部课程"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
