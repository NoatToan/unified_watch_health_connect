<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rooView"
    android:tag="layout/habit_activity_add_habit_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <miuix.springback.view.SpringBackLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:scrollableView="@+id/scrollview">
        <ScrollView
            android:id="@+id/scrollview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout
                android:orientation="vertical"
                android:paddingBottom="@dimen/habit_common_margin_100dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="314dp">
                    <ImageView
                        android:id="@+id/logoView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/habit_add_placeholder"
                        android:scaleType="centerCrop"/>
                    <TextView
                        android:textSize="29sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:id="@+id/titleView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="100dp"
                        android:layout_marginStart="@dimen/page_content_padding_horizontal_large"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/white"
                        android:ellipsize="end"
                        android:id="@+id/brefView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:maxWidth="130dp"
                        android:maxLines="3"
                        android:layout_below="@+id/titleView"
                        android:layout_alignStart="@+id/titleView"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/white"
                        android:id="@+id/peopleNumView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="30dp"
                        android:layout_alignParentBottom="true"
                        android:layout_alignStart="@+id/titleView"/>
                </RelativeLayout>
                <TextView
                    android:textSize="12dp"
                    android:textColor="@color/habit_add_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="33dp"
                    android:text="@string/habit_pass_day"
                    android:layout_marginStart="@dimen/page_content_padding_horizontal_large"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/dayListView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
                    android:layout_marginEnd="@dimen/page_content_padding_horizontal_large"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="@color/habit_add_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="33dp"
                    android:text="@string/habit_pass_time"
                    android:layout_marginStart="@dimen/page_content_padding_horizontal_large"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/timeListView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
                    android:layout_marginEnd="@dimen/page_content_padding_horizontal_large"/>
                <com.xiaomi.fitness.widget.view.DividerView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
                    android:layout_marginEnd="@dimen/page_content_padding_horizontal_large"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
                    android:layout_marginEnd="@dimen/page_content_padding_horizontal_large">
                    <TextView
                        android:textSize="16dp"
                        android:textStyle="bold"
                        android:textColor="@color/text_color"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/habit_calendar_sync_alert"
                        android:layout_weight="1"/>
                    <com.xiaomi.fitness.widget.button.SwitchButton
                        android:id="@+id/calendarSyncSwitchView"
                        android:focusable="true"
                        android:layout_width="50dp"
                        android:layout_height="25dp"
                        app:sbIsChecked="true"
                        app:sbIsNeedToggleAnim="true"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </miuix.springback.view.SpringBackLayout>
    <RelativeLayout
        android:layout_gravity="bottom"
        android:id="@+id/addHabitContainnerView"
        android:layout_width="match_parent"
        android:layout_height="86dp"
        android:layout_alignParentBottom="true">
        <TextView
            android:id="@+id/addHabitView"
            android:clickable="true"
            android:layout_width="@dimen/common_btn_single_line_width"
            android:layout_height="@dimen/common_btn_height"
            android:text="@string/habit_common_save"
            android:layout_centerInParent="true"
            style="@style/CommonBtn.Primary"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/titleBarView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/iconBackView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20.33dp"
            android:src="@drawable/habit_ic_base_back"
            android:layout_centerVertical="true"
            android:layout_marginStart="18dp"/>
        <ImageView
            android:id="@+id/iconShareView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20.33dp"
            android:src="@drawable/habit_share_white"
            android:layout_centerVertical="true"
            android:contentDescription="@string/habit_share_desc"
            android:layout_marginEnd="18dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</RelativeLayout>
