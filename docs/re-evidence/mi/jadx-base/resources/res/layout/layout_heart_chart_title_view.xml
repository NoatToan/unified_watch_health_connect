<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_3">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="@color/text_color"
                android:gravity="center_vertical"
                android:layout_gravity="start|bottom"
                android:id="@+id/txtValue"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:baselineAlignBottom="true"
                android:maxLines="1"
                android:includeFontPadding="false"
                app:autoSizeMaxTextSize="30sp"
                app:autoSizeMinTextSize="2sp"
                app:autoSizeTextType="uniform"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="10sp"
                android:textColor="#ff5050"
                android:gravity="center"
                android:layout_gravity="start|bottom"
                android:id="@+id/markingText"
                android:background="@drawable/health_check_bg_abnormal_mark"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:baselineAlignBottom="true"
                android:maxLines="1"
                android:layout_marginStart="5dp"
                android:paddingHorizontal="4dp"
                android:paddingVertical="2dp"
                app:autoSizeMaxTextSize="10sp"
                app:autoSizeMinTextSize="1sp"
                app:autoSizeTextType="uniform"/>
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="15sp"
            android:textColor="@color/text_color_80"
            android:gravity="center_vertical"
            android:id="@+id/tipText"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:maxLines="1"
            app:autoSizeMaxTextSize="15sp"
            app:autoSizeMinTextSize="2sp"
            app:autoSizeTextType="uniform"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14sp"
            android:textColor="@color/text_color_40"
            android:gravity="center_vertical"
            android:id="@+id/txtDesc"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:includeFontPadding="false"
            app:autoSizeMaxTextSize="14sp"
            app:autoSizeMinTextSize="2sp"
            app:autoSizeTextType="uniform"/>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="30sp"
        android:textStyle="bold"
        android:gravity="center_vertical"
        android:layout_gravity="start|center_vertical"
        android:id="@+id/emptyView"
        android:paddingTop="@dimen/size_5"
        android:paddingBottom="@dimen/size_5"
        android:layout_width="wrap_content"
        android:layout_height="82dp"
        android:maxLines="1"
        app:autoSizeMaxTextSize="30sp"
        app:autoSizeMinTextSize="3sp"
        app:autoSizeTextType="uniform"/>
</FrameLayout>
