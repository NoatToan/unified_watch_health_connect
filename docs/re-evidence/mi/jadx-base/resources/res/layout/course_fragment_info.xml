<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/course_fragment_info_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.xiaomi.fitness.widget.SlidableScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="@dimen/page_content_padding_horizontal_large">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.mi.health.course.widget.CourseInfoHeaderPreView
                android:id="@+id/course_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <LinearLayout
                android:id="@+id/freq_and_device"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="2"
                app:layout_constraintTop_toBottomOf="@+id/course_header">
                <LinearLayout
                    android:id="@+id/frequency_container"
                    android:paddingBottom="@dimen/dimen_margin_20dp"
                    android:layout_weight="1"
                    app:layout_constraintEnd_toStartOf="@+id/device_container"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/course_header"
                    style="@style/CourseFrequencyContainer">
                    <TextView
                        android:id="@+id/frequency_label"
                        android:text="@string/course_frequency"
                        android:drawableStart="@drawable/course_info_frequency"
                        android:importantForAccessibility="no"
                        style="@style/CourseFrequencyLabel"/>
                    <TextView
                        android:id="@+id/frequency_view"
                        android:importantForAccessibility="no"
                        style="@style/CourseInfoValue"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/device_container"
                    android:paddingBottom="@dimen/dimen_margin_20dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/frequency_container"
                    app:layout_constraintTop_toBottomOf="@+id/course_header"
                    style="@style/CourseFrequencyContainer">
                    <TextView
                        android:text="@string/course_device"
                        android:drawableStart="@drawable/course_info_device"
                        android:importantForAccessibility="no"
                        style="@style/CourseFrequencyLabel"/>
                    <TextView
                        android:id="@+id/device_view"
                        android:importantForAccessibility="no"
                        style="@style/CourseInfoValue"/>
                </LinearLayout>
            </LinearLayout>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/content_label_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="content_label,content_size_view"/>
            <TextView
                android:id="@+id/content_label"
                android:text="@string/course_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/freq_and_device"
                style="@style/CourseContentLabel"/>
            <TextView
                android:id="@+id/content_size_view"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/freq_and_device"
                style="@style/CourseContentLabel"/>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/content"
                android:paddingTop="7dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/content_size_view">
                <androidx.recyclerview.widget.RecyclerView
                    android:orientation="horizontal"
                    android:id="@+id/recycler_view"
                    android:visibility="gone"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/content_size_view"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/audio_container"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/content_size_view"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/course_black"
                    android:id="@+id/audio_more_view"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/course_info_all"
                    android:drawablePadding="12dp"
                    android:drawableStart="@drawable/course_arrow_down"/>
                <com.xiaomi.fitness.widget.view.DividerView
                    android:id="@+id/audio_divider"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="27dp"
                    android:layout_marginBottom="7dp"
                    android:layout_marginStart="@dimen/course_info_margin"
                    android:layout_marginEnd="@dimen/course_info_margin"/>
            </LinearLayout>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/course_notice"
                android:id="@+id/tip_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/course_attention"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/content"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/course_desc"
                android:id="@+id/tip_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="4dp"
                app:layout_constraintTop_toBottomOf="@+id/tip_label"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.xiaomi.fitness.widget.SlidableScrollView>
    <TextView
        android:id="@+id/start_view"
        android:visibility="gone"
        android:layout_marginTop="10dp"
        style="@style/CommonBtn.Red"/>
    <com.xiaomi.fitness.training_plan_export.widget.TrainingStartBtn
        android:id="@+id/trainingStart"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="@dimen/dimen_margin_26dp"
        android:layout_marginHorizontal="@dimen/dimen_margin_26dp"/>
</LinearLayout>
