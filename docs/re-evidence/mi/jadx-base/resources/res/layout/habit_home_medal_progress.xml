<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/level1_root"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/level1_icon"
            android:layout_width="43dp"
            android:layout_height="43dp"
            android:src="@drawable/habit_medal_icon_level1_selected"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/text_color"
            android:id="@+id/level1_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_6dp"
            android:text="@string/training_plan_habit_medal_first_title"/>
    </LinearLayout>
    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/level2_root"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/level2_icon"
            android:layout_width="43dp"
            android:layout_height="43dp"/>
        <TextView
            android:textSize="12dp"
            android:id="@+id/level2_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_6dp"
            android:text="@string/training_plan_habit_medal_first_title"/>
    </LinearLayout>
    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/level3_root"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/level3_icon"
            android:layout_width="43dp"
            android:layout_height="43dp"/>
        <TextView
            android:textSize="12dp"
            android:id="@+id/level3_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_6dp"/>
    </LinearLayout>
    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/level4_root"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/level4_icon"
            android:layout_width="43dp"
            android:layout_height="43dp"
            android:src="@drawable/habit_medal_icon_level4"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/text_color_30"
            android:id="@+id/level4_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_6dp"/>
    </LinearLayout>
</LinearLayout>
