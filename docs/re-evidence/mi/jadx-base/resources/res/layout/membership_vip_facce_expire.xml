<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/membership_vip_facce_expire_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_membership_expired"
        android:background="@drawable/member_vip_expired_bg"
        android:paddingBottom="29dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="28sp"
            android:textColor="@color/membership_expired_dialog_title"
            android:id="@+id/tv_membership_vip_expired_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_36dp"
            android:text="@string/membership_vip_has_expired"
            android:fontFamily="@font/misanslatin_demibold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/dimen_12sp"
            android:textColor="@color/membership_expired_dialog_title_sub"
            android:id="@+id/tv_membership_vip_expired_title_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_6dp"
            android:text="@string/membership_vip_has_expired_face_invalid"
            android:alpha="0.6"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_membership_vip_expired_title"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcv_membership_expired_face"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_membership_vip_expired_title_sub"/>
        <TextView
            android:textSize="@dimen/font_12"
            android:textColor="@color/membership_dialog_hint"
            android:gravity="center_horizontal"
            android:id="@+id/tv_membership_vip_expired_reuse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="172dp"
            android:text="@string/membership_vip_reinstall_face"
            android:layout_marginHorizontal="40dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_membership_vip_expired_title_sub"/>
        <TextView
            android:gravity="center"
            android:id="@+id/tv_membership_vip_expired_pay"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginTop="@dimen/dimen_margin_14dp"
            android:text="@string/membership_vip_renewal_pay"
            android:layout_marginHorizontal="29dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_membership_vip_expired_reuse"
            style="@style/MembershipExpiredBtnStyle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/iv_membership_expired_close"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_marginTop="36dp"
        android:src="@drawable/member_expired_face_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_membership_expired"/>
</androidx.constraintlayout.widget.ConstraintLayout>
