<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_sleep_interfere_day_0"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingHorizontal="12dp">
    <View
        android:id="@+id/week_day_selected_bg"
        android:background="@drawable/sleep_interfere_day_selected_bg"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="@dimen/dimen_margin_10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/dimen_15sp"
        android:textColor="@color/text_color"
        android:gravity="center"
        android:id="@+id/week_day"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/week_day_selected_bg"
        app:layout_constraintEnd_toEndOf="@+id/week_day_selected_bg"
        app:layout_constraintStart_toStartOf="@+id/week_day_selected_bg"
        app:layout_constraintTop_toTopOf="@+id/week_day_selected_bg"/>
    <View
        android:id="@+id/default_day_bg"
        android:background="@drawable/sleep_interfere_default_day_bg"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginTop="@dimen/dimen_margin_14dp"
        android:layout_marginBottom="@dimen/dimen_margin_10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/week_day"/>
    <com.xiaomi.fitness.health.sleep.interfere.widget.ProgressCircle
        android:id="@+id/progress"
        android:visibility="gone"
        android:layout_width="34dp"
        android:layout_height="34dp"
        app:layout_constraintBottom_toBottomOf="@+id/default_day_bg"
        app:layout_constraintEnd_toEndOf="@+id/default_day_bg"
        app:layout_constraintStart_toStartOf="@+id/default_day_bg"
        app:layout_constraintTop_toTopOf="@+id/default_day_bg"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/text_color"
        android:id="@+id/month_day"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/default_day_bg"
        app:layout_constraintEnd_toEndOf="@+id/default_day_bg"
        app:layout_constraintStart_toStartOf="@+id/default_day_bg"
        app:layout_constraintTop_toTopOf="@+id/default_day_bg"/>
    <ImageView
        android:id="@+id/complete_day"
        android:visibility="gone"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:src="@drawable/sleep_interfere_day_completed"
        app:layout_constraintBottom_toBottomOf="@+id/default_day_bg"
        app:layout_constraintEnd_toEndOf="@+id/default_day_bg"
        app:layout_constraintStart_toStartOf="@+id/default_day_bg"
        app:layout_constraintTop_toTopOf="@+id/default_day_bg"/>
</androidx.constraintlayout.widget.ConstraintLayout>
