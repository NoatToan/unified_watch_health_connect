<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/step_container"
    android:tag="layout/fragment_step_day_item_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.xiaomi.fitness.chart.view.BarChartRecyclerView
            android:id="@+id/recycler"
            android:paddingEnd="@dimen/chart_more_number_padding_end"
            app:barChartMaxWidth="@dimen/size_3"
            app:barChartRoundRectRadiusRatio="0.5"
            app:chartColor="@color/health_step_chart_color"
            app:displayNumbers="48"
            app:enableEndDayXAxis="true"
            app:enableStartYAxisLabel="false"
            style="@style/ChartBaseStyle"/>
        <com.xiaomi.fitness.view.DataTitleView
            android:id="@+id/dataTitleView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <include
        android:id="@+id/ll_card"
        layout="@layout/layout_step_dwm_common"/>
</LinearLayout>
