<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/mine_vip_entrance_view_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/title_group"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        app:layout_constraintTop_toTopOf="parent">
        <com.google.android.material.imageview.ShapeableImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/mine_vip_entrance_title_bg"
            android:scaleType="fitXY"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearance="@style/MineVipEntranceTitleBg"/>
        <ImageView
            android:id="@+id/vip_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/mine_vip_icon"
            android:layout_marginStart="@dimen/dimen_margin_14dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="17sp"
            android:textColor="@color/mine_vip_entrance_title"
            android:ellipsize="end"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/mine_vip_title"
            android:maxLines="1"
            android:fontFamily="@font/misanslatin_semibold"
            android:textAlignment="viewStart"
            android:layout_marginStart="@dimen/dimen_margin_4dp"
            app:layout_constraintBottom_toBottomOf="@+id/vip_icon"
            app:layout_constraintEnd_toStartOf="@+id/button"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/vip_icon"
            app:layout_constraintTop_toTopOf="@+id/vip_icon"
            app:layout_constraintVertical_weight="1"/>
        <TextView
            android:textColor="@color/mine_vip_entrance_button_text"
            android:id="@+id/button"
            android:background="@drawable/mine_vip_entrance_button_bg"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dimen_margin_14dp"
            android:paddingHorizontal="@dimen/dimen_margin_12dp"
            android:paddingVertical="@dimen/dimen_margin_9dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/operation_group"
        android:background="@drawable/mine_vip_entrance_operation_bg"
        android:paddingBottom="@dimen/dimen_margin_14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/title_group">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/operation1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            app:layout_constraintEnd_toStartOf="@+id/operation2"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/operation1_title_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textSize="@dimen/dimen_12sp"
                    android:textColor="@color/mine_vip_entrance_operation_title"
                    android:ellipsize="end"
                    android:id="@+id/operation1_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/dimen_margin_14dp"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/operation1_arrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/mine_vip_more_icon"
                    android:layout_marginStart="-2dp"
                    app:layout_constraintBottom_toBottomOf="@+id/operation1_title"
                    app:layout_constraintStart_toEndOf="@+id/operation1_title"
                    app:layout_constraintTop_toTopOf="@+id/operation1_title"/>
            </LinearLayout>
            <TextView
                android:textColor="@color/mine_vip_entrance_operation_desc"
                android:ellipsize="end"
                android:gravity="start"
                android:id="@+id/operation1_desc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_2dp"
                android:maxLines="1"
                android:textAlignment="viewStart"
                android:paddingStart="@dimen/dimen_margin_14dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toStartOf="@+id/operation1_title_group"
                app:layout_constraintTop_toBottomOf="@+id/operation1_title_group"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/operation2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@+id/operation1">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/operation2_title_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textSize="@dimen/dimen_12sp"
                    android:textColor="@color/mine_vip_entrance_operation_title"
                    android:ellipsize="end"
                    android:id="@+id/operation2_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/dimen_margin_14dp"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/operation2_arrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/mine_vip_more_icon"
                    android:layout_marginStart="-2dp"
                    app:layout_constraintBottom_toBottomOf="@+id/operation2_title"
                    app:layout_constraintStart_toEndOf="@+id/operation2_title"
                    app:layout_constraintTop_toTopOf="@+id/operation2_title"/>
            </LinearLayout>
            <TextView
                android:textColor="@color/mine_vip_entrance_operation_desc"
                android:gravity="start"
                android:id="@+id/operation2_desc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_2dp"
                android:maxLines="1"
                android:textAlignment="viewStart"
                android:paddingStart="14dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toStartOf="@+id/operation2_title_group"
                app:layout_constraintTop_toBottomOf="@+id/operation2_title_group"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
