<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/health_fragment_ecg_analyze_service_auth_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginHorizontal="26.67dp">
    <com.xiaomi.fitness.widget.view.RoundImageView
        android:id="@+id/iv_icon"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="30dp"
        android:src="@drawable/health_ic_hlw"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/text_color"
        android:gravity="center"
        android:id="@+id/tv_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_10"
        android:text="@string/health_n60_ecg_welcome_use_analyze_service"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_icon"
        style="@style/FontMedium.16sp"/>
    <TextView
        android:textColor="@color/text_color"
        android:id="@+id/tv_analyze_service_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_20"
        android:text="@string/health_n60_ecg_auth_analyze_service_description"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_label"
        style="@style/FontRegular.14sp"/>
    <TextView
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_agree"
        android:background="@drawable/selector_bottom_btn_positive_bg"
        android:layout_width="@dimen/common_btn_single_line_width"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="@string/health_n60_ecg_auth_agree"
        android:paddingHorizontal="10dp"
        android:paddingVertical="12.7dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_disagree"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/FontMedium.16sp"/>
    <TextView
        android:textColor="@color/text_color_80"
        android:gravity="center"
        android:id="@+id/tv_disagree"
        android:background="@drawable/selector_bottom_btn_native_bg"
        android:layout_width="@dimen/common_btn_single_line_width"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size_26_7"
        android:text="@string/health_n60_ecg_auth_disagree"
        android:paddingHorizontal="10dp"
        android:paddingVertical="12.7dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/FontMedium.16sp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
