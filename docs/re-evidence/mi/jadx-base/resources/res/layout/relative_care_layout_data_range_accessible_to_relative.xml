<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/relative_care_layout_data_range_accessible_to_relative_0"
    android:background="@color/page_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="@dimen/page_content_padding_horizontal_large">
        <TextView
            android:textColor="@color/text_color_40"
            android:id="@+id/accessible_range_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/relative_care_accessible_range_description"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/FontRegular.14sp"/>
        <RadioGroup
            android:id="@+id/radio_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_24dp"
            app:layout_constraintTop_toBottomOf="@+id/accessible_range_tv">
            <RadioButton
                android:id="@+id/of_all_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:button="@null"
                android:text="@string/relative_care_of_all_history"
                android:drawableEnd="@drawable/selector_check"
                android:paddingVertical="@dimen/dimen_margin_16dp"
                style="@style/FontMedium.17sp"/>
            <RadioButton
                android:id="@+id/recent_half_a_year"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:button="@null"
                android:text="@string/recent_half_a_year"
                android:drawableEnd="@drawable/selector_check"
                android:paddingVertical="@dimen/dimen_margin_16dp"
                style="@style/FontMedium.17sp"/>
            <RadioButton
                android:id="@+id/recent_one_month"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:button="@null"
                android:text="@string/relative_care_recent_one_month"
                android:drawableEnd="@drawable/selector_check"
                android:paddingVertical="@dimen/dimen_margin_16dp"
                style="@style/FontMedium.17sp"/>
        </RadioGroup>
        <TextView
            android:textSize="@dimen/dimen_16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/button"
            android:background="@drawable/selector_bottom_btn_positive_bg"
            android:layout_width="@dimen/common_btn_single_line_width"
            android:layout_height="@dimen/common_btn_height"
            android:layout_marginBottom="26.67dp"
            android:text="@string/confirm"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/relative_care_no_network_text_color"
        android:gravity="center_horizontal"
        android:id="@+id/no_network"
        android:visibility="gone"
        android:layout_width="100dp"
        android:layout_height="150dp"
        android:text="@string/relative_care_network_connection_failed_tip"
        android:drawableTop="@drawable/icon_no_network"
        android:drawablePadding="@dimen/dimen_margin_10dp"
        android:layout_centerInParent="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
