<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/health_layout_sleep_rhythm_diary_record_list_item_0"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:theme="@style/FontMedium.12sp"
        android:gravity="center_vertical"
        android:id="@+id/sleep_rhythm_diary_list_item_time_tv"
        android:background="@drawable/health_sleep_rhythm_diary_strock_one"
        android:padding="@dimen/dimen_margin_10dp"
        android:layout_width="140dp"
        android:layout_height="45dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/sleep_rhythm_diary_list_item_sleep_in_day_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-1dp">
        <TextView
            android:id="@+id/sleep_rhythm_diary_list_item_sleep_in_day_tv"
            android:text="@string/sleep_rhythm_diary_list_item_sleep_in_day_tv"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/HealthSleepDiaryListTextItem"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/sleep_rhythm_diary_list_item_sleep_in_day_rv"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/HealthSleepDiaryListRvItem"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/sleep_rhythm_diary_list_item_medication_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-1dp">
        <TextView
            android:id="@+id/sleep_rhythm_diary_list_item_medication_tv"
            android:text="@string/health_add_medication_before_sleep"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/HealthSleepDiaryListTextItem"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/sleep_rhythm_diary_list_item_medication_rv"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/HealthSleepDiaryListRvItem"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:id="@+id/sleep_rhythm_diary_list_item_sleep_off_light_time_tv"
        android:layout_marginTop="-1dp"
        android:text="@string/health_sleep_diary_light_off_time"
        style="@style/HealthSleepDiaryListTextItem"/>
    <TextView
        android:id="@+id/sleep_rhythm_diary_list_light_off_to_sleep_time_tv"
        android:layout_marginTop="-1dp"
        android:text="@string/health_sleep_diary_light_off_to_sleep_time"
        style="@style/HealthSleepDiaryListTextItem"/>
    <TextView
        android:id="@+id/sleep_rhythm_diary_wake_up_in_night_count"
        android:layout_marginTop="-1dp"
        android:text="@string/health_sleep_rhythm_diary_wake_up_in_night_count"
        style="@style/HealthSleepDiaryListTextItem"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/health_wake_up_in_night_need_time_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-1dp">
        <TextView
            android:id="@+id/health_wake_up_in_night_need_time_tv"
            android:text="@string/health_wake_up_in_night_need_time"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/HealthSleepDiaryListTextItem"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/health_wake_up_in_night_need_time_rv"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/HealthSleepDiaryListRvItem"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:id="@+id/health_sleep_diary_in_day_wake_up_time_tv"
        android:layout_marginTop="-1dp"
        android:text="@string/health_sleep_diary_in_day_wake_up_time"
        style="@style/HealthSleepDiaryListTextItem"/>
    <TextView
        android:id="@+id/health_sleep_diary_in_day_get_up_time"
        android:layout_marginTop="-1dp"
        android:text="@string/health_sleep_diary_in_day_get_up_time"
        style="@style/HealthSleepDiaryListTextItem"/>
    <TextView
        android:id="@+id/health_sleep_difficulty_tv"
        android:layout_marginTop="-1dp"
        android:text="@string/health_sleep_difficulty"
        style="@style/HealthSleepDiaryListTextItem"/>
    <TextView
        android:id="@+id/health_sleep_feeling_tv"
        android:layout_marginTop="-1dp"
        android:text="@string/health_sleep_feeling"
        style="@style/HealthSleepDiaryListTextItem"/>
</androidx.appcompat.widget.LinearLayoutCompat>
