<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/pic_thumbnail"
        android:layout_width="@dimen/dimen_margin_50dp"
        android:layout_height="@dimen/dimen_margin_50dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearance="@style/RoundCorner"/>
    <ImageView
        android:id="@+id/delete_pic_icon"
        android:background="@drawable/sport_route_feedback_delete_pic_icon"
        android:layout_width="@dimen/dimen_margin_18dp"
        android:layout_height="@dimen/dimen_margin_18dp"
        app:layout_constraintEnd_toEndOf="@+id/pic_thumbnail"
        app:layout_constraintTop_toTopOf="@+id/pic_thumbnail"/>
</androidx.constraintlayout.widget.ConstraintLayout>
