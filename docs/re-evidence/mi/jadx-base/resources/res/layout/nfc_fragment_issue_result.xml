<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutView"
    android:tag="layout/nfc_fragment_issue_result_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/nfc_common_title_left_margin"
    android:paddingEnd="@dimen/nfc_common_title_left_margin">
    <RelativeLayout
        android:orientation="vertical"
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/nfc_common_content_miui_title_margin">
        <com.xiaomi.fitness.nfc.widget.DeviceImageView
            android:id="@+id/deviceView"
            android:layout_width="@dimen/nfc_device_icon_width"
            android:layout_height="@dimen/nfc_device_icon_height"
            android:layout_centerHorizontal="true"/>
        <ImageView
            android:id="@+id/statusView"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/nfc_card_issue_success_big"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/nfc_nextpay_transit_result_center_layout_margin_top"
        android:layout_below="@+id/header_layout"
        android:layout_centerInParent="true">
        <TextView
            android:textSize="24sp"
            android:textColor="@color/nfc_nextpay_transit_result_success_content_color"
            android:id="@+id/contentView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="@dimen/nfc_common_textsize_4"
            android:textColor="@color/text_color_60"
            android:gravity="center"
            android:id="@+id/contentDescView"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/nfc_nextpay_transit_result_center_content_desc_margin_top"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/footerLayoutView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/bottomView"
        android:layout_centerHorizontal="true">
        <TextView
            android:textSize="@dimen/nfc_nextpay_transit_result_footer_op_text_size"
            android:textColor="@color/common_blue"
            android:layout_gravity="center"
            android:id="@+id/footerOpView"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <View
        android:id="@+id/bottomView"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
