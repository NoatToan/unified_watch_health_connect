<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/eco_course_layout_dialog_0"
    android:background="@drawable/course_dialog_bg"
    android:padding="27dp"
    android:layout_width="@dimen/course_dialog_width"
    android:layout_height="wrap_content">
    <ProgressBar
        android:id="@+id/progress_bar"
        android:visibility="gone"
        android:layout_marginEnd="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/title_view"
        app:layout_constraintEnd_toStartOf="@+id/title_view"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/title_view"
        style="@style/ProgressDialogIndeterminateProgressbar"/>
    <TextView
        android:textSize="17sp"
        android:textColor="@color/text_color"
        android:gravity="center"
        android:id="@+id/title_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/progress_bar"/>
    <TextView
        android:textColor="@color/text_color_80"
        android:gravity="center_horizontal"
        android:id="@+id/desc_view"
        android:paddingLeft="13dp"
        android:paddingRight="13dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="17dp"
        android:lineSpacingExtra="2sp"
        app:layout_constraintTop_toBottomOf="@+id/title_view"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/course_left_button_text_color"
        android:gravity="center"
        android:id="@+id/left_button"
        android:background="@drawable/eco_course_bg_bottom_corner_normal"
        android:layout_width="0dp"
        android:layout_height="47dp"
        android:layout_marginTop="27dp"
        android:maxLines="1"
        app:layout_constraintEnd_toStartOf="@+id/right_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/desc_view"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/common_white"
        android:gravity="center"
        android:id="@+id/right_button"
        android:background="@drawable/selector_bottom_button_red"
        android:layout_width="0dp"
        android:layout_height="47dp"
        android:layout_marginTop="27dp"
        android:maxLines="1"
        android:layout_marginStart="13dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/left_button"
        app:layout_constraintTop_toBottomOf="@+id/desc_view"/>
</androidx.constraintlayout.widget.ConstraintLayout>
