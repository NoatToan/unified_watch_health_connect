<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="@dimen/margin_20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/guide_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/sport_empty_map_new_guide_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/guide_tv"
        android:background="@drawable/newbie_guide_text_default_shape_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="50dp"
        android:layout_marginTop="@dimen/dimen_margin_10dp"
        android:maxWidth="240dp"
        android:text="挪动地图，将图形贴在合适的空地"
        android:paddingHorizontal="@dimen/dimen_margin_18dp"
        android:paddingVertical="@dimen/dimen_margin_16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/guide_icon"
        style="@style/FontNormal.14sp"/>
    <ImageView
        android:id="@+id/arrow_down"
        android:layout_width="@dimen/dimen_margin_22dp"
        android:layout_height="@dimen/dimen_margin_10dp"
        android:layout_marginLeft="50dp"
        android:layout_marginBottom="-1dp"
        android:src="@drawable/newbie_guide_arrow_up"
        app:layout_constraintBottom_toTopOf="@+id/guide_tv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ImageView
        android:id="@+id/small_star"
        android:background="@drawable/newbie_guide_star"
        android:layout_width="9dp"
        android:layout_height="@dimen/dimen_margin_10dp"
        android:layout_marginBottom="7dp"
        android:layout_marginEnd="2dp"
        app:layout_constraintBottom_toTopOf="@+id/guide_tv"
        app:layout_constraintEnd_toEndOf="@+id/guide_tv"/>
    <ImageView
        android:id="@+id/big_star"
        android:background="@drawable/newbie_guide_star"
        android:layout_width="@dimen/dimen_margin_13dp"
        android:layout_height="@dimen/dimen_margin_15dp"
        android:layout_marginBottom="-4dp"
        android:layout_marginStart="2dp"
        app:layout_constraintBottom_toTopOf="@+id/guide_tv"
        app:layout_constraintStart_toEndOf="@+id/guide_tv"
        app:layout_constraintTop_toTopOf="@+id/small_star"/>
</androidx.constraintlayout.widget.ConstraintLayout>
