<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/device_settings_fragment_sedentary_0"
    android:paddingTop="@dimen/device_settings_list_padding_top"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/page_content_padding_horizontal_large">
    <com.xiaomi.fitness.widget.SwitchButtonTwoLineTextView
        android:id="@+id/stateView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:subtitle="@string/device_settings_sedentary_tip"
        app:title="@string/device_settings_sedentary_state"/>
    <com.xiaomi.fitness.widget.RightArrowTwoLineTextView
        android:id="@+id/startView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/stateView"
        app:title="@string/device_settings_wrist_screen_wake_start"/>
    <com.xiaomi.fitness.widget.RightArrowTwoLineTextView
        android:id="@+id/endView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/startView"
        app:title="@string/device_settings_wrist_screen_wake_end"/>
    <com.xiaomi.fitness.widget.SwitchButtonTwoLineTextView
        android:id="@+id/siestaView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/endView"
        app:title="@string/device_settings_sedentary_siesta"/>
    <com.xiaomi.fitness.widget.RightArrowTwoLineTextView
        android:id="@+id/breakStartView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/stateView"
        app:title="@string/device_settings_nap_start"/>
    <com.xiaomi.fitness.widget.RightArrowTwoLineTextView
        android:id="@+id/breakEndView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/startView"
        app:title="@string/device_settings_nap_end"/>
    <com.xiaomi.fitness.widget.SwitchButtonTwoLineTextView
        android:id="@+id/stretchView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/siestaView"
        app:title="@string/device_settings_sedentary__stretch_guide"/>
</LinearLayout>
