<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="22dp">
    <TextView
        android:id="@+id/maxBg"
        android:background="@drawable/triathlon_change"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/maxtxt"
        app:layout_constraintEnd_toEndOf="@+id/maxtxt"
        app:layout_constraintStart_toStartOf="@+id/maxtxt"
        app:layout_constraintTop_toTopOf="@+id/maxtxt"/>
    <TextView
        android:textSize="@dimen/font_10"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/maxtxt"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:text="@plurals/trail_sport_max_heart"
        android:drawableLeft="@drawable/marker_swim"
        android:drawablePadding="@dimen/dimen_margin_3dp"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
