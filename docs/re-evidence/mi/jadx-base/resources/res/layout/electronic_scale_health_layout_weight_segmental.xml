<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/container"
        android:background="@drawable/shape_data_item_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="13.3dp">
        <include
            android:id="@+id/layout_common_icon_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_20dp"
            layout="@layout/electronic_scale_health_layout_common_card_icon_title"/>
        <include layout="@layout/electronic_scale_layout_division_line"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/level_recycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="13.3dp"
            android:overScrollMode="never"
            android:layout_marginHorizontal="@dimen/electronic_scale_health_detail_page_common_margin_horizontal"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:paddingBottom="26.67dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16.7dp">
            <com.xiaomi.fitness.electronic.scale.view.WeightSegmentalView
                android:id="@+id/iv_weight_segmental"
                android:layout_width="160.3dp"
                android:layout_height="210.67dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/electronic_scale_ic_weight_segmental_fat_vector"/>
            <include
                android:id="@+id/weight_item_left_upper"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="-5.6dp"
                app:layout_constraintEnd_toStartOf="@+id/iv_weight_segmental"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/iv_weight_segmental"
                layout="@layout/electronic_scale_health_layout_card_data_item"/>
            <include
                android:id="@+id/weight_item_left_lower"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="141dp"
                app:layout_constraintEnd_toStartOf="@+id/iv_weight_segmental"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/iv_weight_segmental"
                layout="@layout/electronic_scale_health_layout_card_data_item"/>
            <include
                android:id="@+id/weight_item_right_upper"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="-5.6dp"
                android:layout_marginStart="-6dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/iv_weight_segmental"
                app:layout_constraintTop_toTopOf="@+id/iv_weight_segmental"
                layout="@layout/electronic_scale_health_layout_card_data_item"/>
            <include
                android:id="@+id/weight_item_trunk"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="56dp"
                android:layout_marginStart="-6dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/iv_weight_segmental"
                app:layout_constraintTop_toTopOf="@+id/iv_weight_segmental"
                layout="@layout/electronic_scale_health_layout_card_data_item"/>
            <include
                android:id="@+id/weight_item_right_lower"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="141dp"
                android:layout_marginStart="-6dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/iv_weight_segmental"
                app:layout_constraintTop_toTopOf="@+id/iv_weight_segmental"
                layout="@layout/electronic_scale_health_layout_card_data_item"/>
            <TextView
                android:textColor="@color/text_color_40"
                android:gravity="center"
                android:id="@+id/tv_image_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14.3dp"
                android:text="@string/electronic_scale_health_weight_body_composition_distribution"
                android:layout_marginHorizontal="@dimen/size_10"
                app:layout_constraintTop_toBottomOf="@+id/iv_weight_segmental"
                style="@style/FontNormal.12sp"/>
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/guideline1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_percent="0.33"/>
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/guideline2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_percent="0.67"/>
            <View
                android:id="@+id/view_vertical_line1"
                android:background="@color/common_divider_bg_color"
                android:layout_width="@dimen/electronic_scale_size_0_33"
                android:layout_height="@dimen/electronic_scale_size_35"
                android:layout_marginTop="@dimen/dimen_margin_40dp"
                app:layout_constraintStart_toEndOf="@+id/guideline1"
                app:layout_constraintTop_toBottomOf="@+id/tv_image_desc"/>
            <View
                android:id="@+id/view_vertical_line2"
                android:background="@color/common_divider_bg_color"
                android:layout_width="@dimen/electronic_scale_size_0_33"
                android:layout_height="@dimen/electronic_scale_size_35"
                android:layout_marginTop="@dimen/electronic_scale_size_40"
                app:layout_constraintStart_toStartOf="@+id/guideline2"
                app:layout_constraintTop_toBottomOf="@+id/tv_image_desc"/>
            <TextView
                android:textSize="20dp"
                android:textColor="@color/text_color"
                android:ellipsize="end"
                android:id="@+id/tv_upper_balance"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginStart="@dimen/dimen_margin_18dp"
                android:autoSizeTextType="uniform"
                app:layout_constraintBottom_toTopOf="@+id/tv_upper_label"
                app:layout_constraintEnd_toStartOf="@+id/view_vertical_line1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/view_vertical_line1"
                app:layout_constraintVertical_chainStyle="packed"
                style="@style/FontMedium"/>
            <TextView
                android:textSize="10dp"
                android:textColor="@color/text_color_40"
                android:ellipsize="end"
                android:id="@+id/tv_upper_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/electronic_scale_health_upper_limb_balanced"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                app:layout_constraintBottom_toBottomOf="@+id/view_vertical_line1"
                app:layout_constraintEnd_toStartOf="@+id/view_vertical_line1"
                app:layout_constraintStart_toStartOf="@+id/tv_upper_balance"
                app:layout_constraintTop_toBottomOf="@+id/tv_upper_balance"/>
            <TextView
                android:textSize="20dp"
                android:textColor="@color/text_color"
                android:ellipsize="end"
                android:id="@+id/tv_lower_balance"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginStart="@dimen/dimen_margin_18dp"
                android:autoSizeTextType="uniform"
                app:layout_constraintBottom_toTopOf="@+id/tv_lower_label"
                app:layout_constraintEnd_toStartOf="@+id/view_vertical_line2"
                app:layout_constraintStart_toEndOf="@+id/view_vertical_line1"
                app:layout_constraintTop_toTopOf="@+id/view_vertical_line2"
                app:layout_constraintVertical_chainStyle="packed"
                style="@style/FontMedium"/>
            <TextView
                android:textSize="10dp"
                android:textColor="@color/text_color_40"
                android:ellipsize="end"
                android:id="@+id/tv_lower_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/electronic_scale_health_lower_limb_balanced"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                app:layout_constraintBottom_toBottomOf="@+id/view_vertical_line2"
                app:layout_constraintEnd_toStartOf="@+id/view_vertical_line2"
                app:layout_constraintStart_toStartOf="@+id/tv_lower_balance"
                app:layout_constraintTop_toBottomOf="@+id/tv_lower_balance"/>
            <TextView
                android:textSize="20dp"
                android:textColor="@color/text_color"
                android:ellipsize="end"
                android:id="@+id/tv_upper_lower_balance"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginStart="@dimen/dimen_margin_18dp"
                android:autoSizeTextType="uniform"
                app:layout_constraintBottom_toTopOf="@+id/tv_upper_lower_balance_label"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/view_vertical_line2"
                app:layout_constraintTop_toTopOf="@+id/view_vertical_line2"
                app:layout_constraintVertical_chainStyle="packed"
                style="@style/FontMedium"/>
            <TextView
                android:textSize="10dp"
                android:textColor="@color/text_color_40"
                android:ellipsize="end"
                android:id="@+id/tv_upper_lower_balance_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/electronic_scale_health_upper_lower_limb_balanced"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                app:layout_constraintBottom_toBottomOf="@+id/view_vertical_line2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/tv_upper_lower_balance"
                app:layout_constraintTop_toBottomOf="@+id/tv_upper_lower_balance"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</LinearLayout>
