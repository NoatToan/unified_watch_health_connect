<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="45dp">
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/text_color"
        android:gravity="center"
        android:id="@+id/txt_header_title1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/trail_sport_skiing_turn_count"
        android:layout_weight="1"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/text_color"
        android:gravity="center"
        android:id="@+id/txt_header_title2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/trail_sport_report_sports_ski_time"
        android:layout_weight="1"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:textSize="@dimen/dimen_14sp"
            android:textColor="@color/text_color"
            android:gravity="center"
            android:id="@+id/txt_header_title3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/trail_sport_skiing_distance"
            android:layout_weight="1"/>
        <TextView
            android:textSize="@dimen/dimen_10sp"
            android:textColor="@color/text_color_60"
            android:gravity="center"
            android:id="@+id/txt_header_title3_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/trail_label_ski_km"
            android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:textSize="@dimen/dimen_14sp"
            android:textColor="@color/text_color"
            android:gravity="center"
            android:id="@+id/txt_header_title4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/trail_sport_detail_avg_speed1"
            android:layout_weight="1"/>
        <TextView
            android:textSize="@dimen/dimen_10sp"
            android:textColor="@color/text_color_60"
            android:gravity="center"
            android:id="@+id/txt_header_title4_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/trail_sport_ski_unit_speed"
            android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/txt_header_max_speed"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:textSize="@dimen/dimen_14sp"
            android:textColor="@color/text_color"
            android:gravity="center"
            android:id="@+id/txt_header_title5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/trail_sport_max_speed"
            android:layout_weight="1"/>
        <TextView
            android:textSize="@dimen/dimen_10sp"
            android:textColor="@color/text_color_60"
            android:gravity="center"
            android:id="@+id/txt_header_title5_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/trail_sport_ski_unit_speed"
            android:layout_weight="1"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/text_color"
        android:gravity="center"
        android:id="@+id/txt_header_title6"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/trail_sport_summary_avg_hrm"
        android:layout_weight="1"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/text_color"
        android:gravity="center"
        android:id="@+id/txt_header_title7"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/trail_sport_snow_slope"
        android:layout_weight="1"/>
</LinearLayout>
