<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_address_search_0"
    android:paddingBottom="@dimen/dimen_margin_20dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/search_title_layout"
        android:paddingLeft="16dp"
        android:paddingRight="26dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_back"/>
        <com.xiaomi.fitness.baseui.dialog.ClearEditText
            android:textSize="14sp"
            android:textColor="@color/text_color"
            android:textColorHint="@color/edit_hint_color"
            android:id="@+id/rl_search"
            android:background="@drawable/sport_route_location_search_edit_bg"
            android:paddingLeft="@dimen/dimen_margin_12dp"
            android:paddingRight="@dimen/dimen_margin_12dp"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:hint="@string/sport_running_route_address_search_hint"
            android:drawableStart="@drawable/ic_search"
            app:layout_constraintTop_toTopOf="parent"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/address_list"
        android:paddingBottom="@dimen/dimen_margin_10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/search_title_layout"/>
</androidx.constraintlayout.widget.ConstraintLayout>
