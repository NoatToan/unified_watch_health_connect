<?xml version="1.0" encoding="utf-8"?>
<com.google.android.flexbox.FlexboxLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="top|center_horizontal"
    android:id="@+id/contentLayout"
    android:tag="layout/sport_fragment_create_route_select_style_char_0"
    android:background="@drawable/sport_route_ai_create_bg"
    android:paddingTop="20dp"
    android:paddingBottom="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="29dp"
    app:alignItems="center"
    app:flexDirection="column"
    app:justifyContent="space_between">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/confirmRouteTitleLayout"
        android:paddingBottom="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="23sp"
            android:textColor="@color/text_color"
            android:gravity="start|center_vertical"
            android:id="@+id/confirmRouteTitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sport_input_route_info"
            android:fontFamily="@font/misanslatin_semibold"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/text_color_40"
            android:gravity="start|center_vertical"
            android:id="@+id/confirmRouteSubTitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sport_input_1_4_num_or_char_to_gen_route"
            android:fontFamily="@font/misanslatin_regular"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center"
        android:id="@+id/midContentView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatEditText
            android:enabled="true"
            android:textSize="17sp"
            android:textColor="@color/text_color"
            android:textColorHint="@color/text_color_40"
            android:gravity="start|center_vertical"
            android:id="@+id/inputHintText"
            android:background="@drawable/edit_text_bg"
            android:padding="16dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/sport_please_input_1_4_num_or_char"
            android:maxLength="4"
            android:digits="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
            android:inputType="text"
            android:fontFamily="@font/misanslatin_medium"
            android:autofillHints="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.cardview.widget.CardView
            android:id="@+id/clearButton"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="16dp"
            app:cardBackgroundColor="#14000000"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/inputHintText"
            app:layout_constraintEnd_toEndOf="@+id/inputHintText"
            app:layout_constraintTop_toTopOf="@+id/inputHintText">
            <ImageView
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/miuix_appcompat_edit_text_clear_btn_light"
                android:contentDescription="@string/common_delete"/>
        </androidx.cardview.widget.CardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:gravity="bottom|center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/bottomButtonLayout"
        android:paddingTop="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:textSize="18dp"
            android:gravity="center"
            android:layout_gravity="start"
            android:id="@+id/button_prev"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/btn_pre"
            android:layout_weight="162"
            style="@style/SportCreateRouteGreyButtonStyle"/>
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="12"/>
        <Button
            android:textSize="18dp"
            android:gravity="center"
            android:layout_gravity="end"
            android:id="@+id/button_next_disable"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/sport_start_drawing"
            android:layout_weight="162"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            style="@style/SportCreateRouteGreyButtonStyle"/>
        <Button
            android:textSize="18sp"
            android:gravity="center"
            android:layout_gravity="end"
            android:id="@+id/button_next_enable"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/sport_start_drawing"
            android:layout_weight="162"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            style="@style/SportCreateRouteOrangeButtonStyle"/>
    </LinearLayout>
</com.google.android.flexbox.FlexboxLayout>
