<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/item_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/dimen_margin_10dp"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:id="@+id/ranking_tv"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/ranking_icon_iv"
            app:layout_constraintEnd_toEndOf="@+id/ranking_icon_iv"
            app:layout_constraintStart_toStartOf="@+id/ranking_icon_iv"
            app:layout_constraintTop_toTopOf="@+id/ranking_icon_iv"/>
        <ImageView
            android:id="@+id/ranking_icon_iv"
            android:layout_width="24dp"
            android:layout_height="27dp"
            android:layout_marginBottom="-10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.xiaomi.fitness.widget.view.RoundImageView
            android:id="@+id/user_icon_iv"
            android:layout_width="@dimen/size_29"
            android:layout_height="@dimen/size_29"
            android:layout_marginStart="9.3dp"
            app:layout_constraintBottom_toBottomOf="@+id/ranking_icon_iv"
            app:layout_constraintStart_toEndOf="@+id/ranking_icon_iv"
            app:layout_constraintTop_toTopOf="@+id/ranking_icon_iv"/>
        <TextView
            android:gravity="end"
            android:id="@+id/run_times"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/user_icon_iv"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/user_icon_iv"
            style="@style/FontMedium.18sp"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/user_device_duration_group"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_margin_10dp"
            android:layout_marginEnd="@dimen/dimen_margin_10dp"
            app:layout_constraintBottom_toBottomOf="@+id/user_icon_iv"
            app:layout_constraintEnd_toStartOf="@+id/run_times"
            app:layout_constraintStart_toEndOf="@+id/user_icon_iv"
            app:layout_constraintTop_toTopOf="@+id/user_icon_iv">
            <TextView
                android:ellipsize="end"
                android:id="@+id/username_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/FontMedium.12sp"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dimen_11sp"
                android:textColor="@color/text_color_40"
                android:id="@+id/device_name_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="@+id/username_tv"
                app:layout_constraintTop_toBottomOf="@+id/username_tv"
                style="@style/FontNormal"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.xiaomi.fitness.widget.view.DividerView
        android:id="@+id/bottom_divider"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/page_content_padding_horizontal_large"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
