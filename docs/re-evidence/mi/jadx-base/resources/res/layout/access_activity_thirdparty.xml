<?xml version="1.0" encoding="utf-8"?>
<miuix.springback.view.SpringBackLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/access_activity_thirdparty_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:scrollableView="@+id/spring_back_target">
    <miuix.core.widget.NestedScrollView
        android:id="@+id/spring_back_target"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingHorizontal="@dimen/page_content_padding_horizontal_large">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/dimen_margin_13dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp">
            <com.xiaomi.fitness.widget.RightArrowBindingSingleLineTextView
                android:id="@+id/thirdparty_wechat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_wechat"
                app:title="@string/access_thirdparty_wechat"/>
            <com.xiaomi.fitness.widget.RightArrowBindingSingleLineTextView
                android:id="@+id/thirdparty_alipay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_access_zhifubao"
                app:title="@string/access_thirdparty_alipay"/>
            <com.xiaomi.fitness.widget.RightArrowBindingSingleLineTextView
                android:id="@+id/thirdparty_google_fit"
                android:background="@drawable/selector_white"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_access_googlefit"
                app:title="@string/access_thirdparty_google_fit"/>
            <com.xiaomi.fitness.widget.RightArrowBindingSingleLineTextView
                android:id="@+id/thirdparty_strava"
                android:background="@drawable/selector_white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_access_strava"
                app:title="@string/access_thirdparty_strava"/>
        </LinearLayout>
    </miuix.core.widget.NestedScrollView>
</miuix.springback.view.SpringBackLayout>
