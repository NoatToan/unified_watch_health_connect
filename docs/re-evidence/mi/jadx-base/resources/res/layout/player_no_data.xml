<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/player_no_data"
    android:background="@color/color_212121"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.xiangkan.videoplayer.pgcplayer.PgcTopView
        android:id="@+id/player_no_data_top_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:gravity="bottom|center_horizontal"
        android:orientation="vertical"
        android:id="@+id/player_no_data_content_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true">
        <TextView
            android:textSize="13sp"
            android:textColor="@android:color/white"
            android:background="@drawable/player_video_delete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"/>
        <TextView
            android:textColor="#ffffff"
            android:id="@+id/movie_player_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="38.5dp"
            android:text="@string/common_exoplay_player_no_data"/>
    </LinearLayout>
</RelativeLayout>
