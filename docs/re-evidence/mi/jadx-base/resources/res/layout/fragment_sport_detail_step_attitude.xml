<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/fragment_sport_detail_step_attitude_0"
    android:paddingBottom="@dimen/dimen_margin_30dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.xiaomi.fitness.widget.view.DataTitleSimpleView
        android:id="@+id/dataSimpleTitleView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="horizontal"
        android:id="@+id/itemViewContainer"
        android:layout_width="match_parent"
        android:layout_height="130dp">
        <ImageView
            android:id="@+id/sport_image_type"
            android:layout_width="wrap_content"
            android:layout_height="101dp"
            android:src="@drawable/sport_detail_step_attitude_pre"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/line"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/line"
            android:background="@color/text_color_10"
            android:layout_width="1px"
            android:layout_height="@dimen/dimen_margin_38dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dimen_20sp"
            android:textColor="@color/text_color"
            android:id="@+id/touch_des_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="26dp"
            app:layout_constraintStart_toEndOf="@+id/line"
            app:layout_constraintTop_toTopOf="@+id/line"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dimen_12sp"
            android:textColor="@color/text_color_40"
            android:id="@+id/touch_des_title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            app:layout_constraintStart_toStartOf="@+id/touch_des_tv"
            app:layout_constraintTop_toBottomOf="@+id/touch_des_tv"/>
        <View
            android:background="@color/text_color_10"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_marginStart="@dimen/dimen_margin_18dp"
            android:layout_marginEnd="@dimen/dimen_margin_18dp"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/running_posture_rv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/page_extra_padding_horizontal_large"
        android:layout_marginEnd="@dimen/page_extra_padding_horizontal_large"/>
    <com.xiaomi.fitness.chart.mpchart.linechart.CustomLineChart
        android:id="@+id/chart"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/custom_chart_height_245dp"
        android:layout_marginTop="2dp"
        app:enableDrawCircle="true"
        app:enableMaxCircle="false"
        app:enableMaxPoup="false"
        app:enableSportYAxisLabel="true"
        app:enableTimeXAxisLabel="true"
        app:enableXAxisGridLine="false"
        app:enableYAxisGridLine="true"
        app:limitTextColor="@color/sport_step_color"
        app:lineColor="@color/common_transparent"
        app:lineFillColor="@color/sport_step_light_color"
        app:lineFillRes="@drawable/sport_fill_step"
        app:lineStrokeWidth="@integer/sport_chart_line_width"
        app:maxYAxisRatio="0.2"
        app:minYAxisZero="false"
        app:sportYAxisLabelType="0"/>
</LinearLayout>
