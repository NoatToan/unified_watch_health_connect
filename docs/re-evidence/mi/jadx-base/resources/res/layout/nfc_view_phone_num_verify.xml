<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:id="@+id/rl_verify_phone_num"
    android:tag="layout/nfc_view_phone_num_verify_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/text_size_12"
        android:textColor="@color/text_color_60"
        android:id="@+id/tv_phone_num_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/nfc_phone_num_verify_desc"/>
    <EditText
        android:id="@+id/et_phone_num"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/nfc_size_6_68"
        android:hint="@string/nfc_phone_num_input_hint"
        android:layout_below="@+id/tv_phone_num_desc"
        style="@style/nfc_EditTextVerify"/>
    <View
        android:id="@+id/v_separator_2"
        android:background="@color/common_divider_color"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="20dp"
        android:layout_below="@+id/et_phone_num"/>
    <TextView
        android:textSize="@dimen/text_size_12"
        android:textColor="@color/text_color_60"
        android:id="@+id/tv_captcha_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/nfc_phone_num_captcha_desc"
        android:layout_below="@+id/v_separator_2"/>
    <EditText
        android:id="@+id/et_captcha"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:hint="@string/nfc_phone_num_captcha_input_hint"
        android:layout_below="@+id/tv_captcha_desc"
        style="@style/nfc_EditTextVerify"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/text_color"
        android:gravity="center"
        android:id="@+id/tv_request_captcha"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/nfc_phone_num_captcha_btn_title"
        android:layout_alignTop="@+id/et_captcha"
        android:layout_alignBottom="@+id/et_captcha"
        android:layout_alignEnd="@+id/et_captcha"/>
    <View
        android:id="@+id/v_separator_3"
        android:background="@color/common_divider_color"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="20dp"
        android:layout_below="@+id/et_captcha"/>
</RelativeLayout>
