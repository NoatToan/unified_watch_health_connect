<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/device_settings_bg_vibrate_custom_touch_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/area_high"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/area_mid"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:background="@drawable/device_settings_stroke_vibrate_custom_touch_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/area_mid"
        app:layout_constraintTop_toBottomOf="@+id/area_high"/>
    <TextView
        android:textSize="@dimen/dimen_16sp"
        android:textColor="@color/dialog_text_color"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/device_settings_add_custom_vibrate_high"
        app:layout_constraintBottom_toBottomOf="@+id/area_high"
        app:layout_constraintEnd_toEndOf="@+id/area_high"
        app:layout_constraintStart_toStartOf="@+id/area_high"
        app:layout_constraintTop_toTopOf="@+id/area_high"/>
    <View
        android:id="@+id/area_mid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/area_low"
        app:layout_constraintTop_toBottomOf="@+id/area_high"/>
    <View
        android:background="@drawable/device_settings_stroke_vibrate_custom_touch_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/area_low"
        app:layout_constraintTop_toBottomOf="@+id/area_mid"/>
    <TextView
        android:textSize="@dimen/dimen_16sp"
        android:textColor="@color/dialog_text_color"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/device_settings_add_custom_vibrate_mid"
        app:layout_constraintBottom_toBottomOf="@+id/area_mid"
        app:layout_constraintEnd_toEndOf="@+id/area_mid"
        app:layout_constraintStart_toStartOf="@+id/area_mid"
        app:layout_constraintTop_toTopOf="@+id/area_mid"/>
    <View
        android:id="@+id/area_low"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/area_mid"/>
    <TextView
        android:textSize="@dimen/dimen_16sp"
        android:textColor="@color/dialog_text_color"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/device_settings_add_custom_vibrate_low"
        app:layout_constraintBottom_toBottomOf="@+id/area_low"
        app:layout_constraintEnd_toEndOf="@+id/area_low"
        app:layout_constraintStart_toStartOf="@+id/area_low"
        app:layout_constraintTop_toTopOf="@+id/area_low"/>
</androidx.constraintlayout.widget.ConstraintLayout>
