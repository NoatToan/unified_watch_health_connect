<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/common_title_left_margin"
    android:paddingEnd="@dimen/dimen_margin_16dp">
    <TextView
        android:textSize="15sp"
        android:textColor="@color/switch_black"
        android:ellipsize="end"
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:maxLines="1"
        android:layout_alignParentTop="true"
        android:layout_toStartOf="@+id/btn"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/common_white"
        android:id="@+id/market"
        android:background="@drawable/bg_stock_market"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="12dp"
        android:layout_below="@+id/name"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#999999"
        android:ellipsize="end"
        android:id="@+id/symbol"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_alignBaseline="@+id/market"
        android:layout_marginStart="2dp"
        android:layout_toStartOf="@+id/btn"
        android:layout_toEndOf="@+id/market"/>
    <ImageView
        android:id="@+id/btn"
        android:padding="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_common_item_add"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
