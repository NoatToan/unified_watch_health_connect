<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="24sp"
        android:textColor="@color/text_color"
        android:id="@+id/dateTv"
        android:tag="layout/health_curse_data_holder_0"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/health_common_today"
        android:layout_marginStart="@dimen/health_content_padding"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/FontRegular"/>
    <TextView
        android:textColor="@color/text_color_40"
        android:id="@+id/descView"
        android:tag="layout/health_curse_data_holder_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/health_content_padding"
        app:layout_constraintStart_toStartOf="@+id/dateTv"
        app:layout_constraintTop_toBottomOf="@+id/dateTv"
        style="@style/FontRegular.12sp"/>
    <com.xiaomi.fitness.widget.view.DividerView
        android:id="@+id/divider1"
        android:tag="layout/health_curse_data_holder_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginStart="@dimen/health_content_padding"
        android:layout_marginEnd="@dimen/health_content_padding"
        app:layout_constraintTop_toBottomOf="@+id/descView"/>
    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/curse_table_header_container"
        android:tag="layout/health_curse_data_holder_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginStart="@dimen/health_content_padding"
        android:layout_marginEnd="@dimen/health_content_padding"
        app:dividerDrawableVertical="@drawable/health_curse_sign_divider"
        app:flexDirection="row"
        app:flexWrap="wrap"
        app:justifyContent="space_between"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider1"
        app:showDividerVertical="middle">
        <com.xiaomi.fitness.health.curse.view.HealthCurseSignView
            android:id="@+id/curse"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:healthSignIcon="@drawable/curse_sign"
            app:healthSignTitle="@string/health_curse"/>
        <com.xiaomi.fitness.health.curse.view.HealthCurseSignView
            android:id="@+id/predictSign"
            app:healthSignIcon="@drawable/health_ic_curse_forecast_small"
            app:healthSignTitle="@string/health_curse_forecast"
            style="@style/HealthCurseSign"/>
        <com.xiaomi.fitness.health.curse.view.HealthCurseSignView
            android:id="@+id/ovulateSign"
            app:healthSignIcon="@drawable/health_ic_curse_ovum_small"
            app:healthSignTitle="@string/health_curse_ovum"
            style="@style/HealthCurseSign"/>
        <com.xiaomi.fitness.health.curse.view.HealthCurseSignView
            android:id="@+id/dangerSign"
            app:healthSignIcon="@drawable/health_ic_curse_danger_small"
            app:healthSignTitle="@string/health_curse_danger"
            style="@style/HealthCurseSign"/>
    </com.google.android.flexbox.FlexboxLayout>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/datePager"
        android:tag="layout/health_curse_data_holder_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@+id/curse_table_header_container"/>
    <com.xiaomi.fitness.widget.view.DividerView
        android:id="@+id/divider2"
        android:tag="layout/health_curse_data_holder_5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginStart="@dimen/health_content_padding"
        android:layout_marginEnd="@dimen/health_content_padding"
        app:layout_constraintTop_toBottomOf="@+id/datePager"/>
    <TextView
        android:textColor="@color/curse_color"
        android:gravity="center"
        android:id="@+id/actionView"
        android:tag="layout/health_curse_data_holder_6"
        android:background="@drawable/health_curse_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:maxWidth="260dp"
        android:text="@string/health_curse_action_start"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginEnd="18dp"
        android:paddingVertical="@dimen/size_5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_label"
        app:layout_constraintTop_toBottomOf="@+id/divider2"
        style="@style/FontMedium.12sp"/>
    <TextView
        android:textColor="@color/text_color"
        android:id="@+id/tv_label"
        android:tag="layout/health_curse_data_holder_7"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/health_curse_action"
        android:layout_marginStart="@dimen/health_content_padding"
        android:layout_marginEnd="@dimen/size_8"
        app:layout_constraintBottom_toBottomOf="@+id/actionView"
        app:layout_constraintEnd_toStartOf="@+id/actionView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/actionView"
        style="@style/FontMedium.14sp"/>
</merge>
