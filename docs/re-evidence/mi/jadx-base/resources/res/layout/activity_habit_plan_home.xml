<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/activity_habit_plan_home_0"
    android:background="@color/app_4_0_bg_color"
    android:paddingLeft="@dimen/dimen_margin_12dp"
    android:paddingRight="@dimen/dimen_margin_12dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.xiaomi.fitness.training_plan_export.widget.TrainingPlanTitleBar
        android:id="@+id/titlebar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/title_bar_height"
        android:layout_marginTop="@dimen/dimen_margin_36dp"/>
    <FrameLayout
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <miuix.springback.view.SpringBackLayout
            android:id="@+id/swipe_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:scrollableView="@+id/contentRoot">
            <miuix.core.widget.NestedScrollView
                android:id="@+id/contentRoot"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/train_improve"
                        android:background="@drawable/habit_train_improve_card_bg"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimen_margin_10dp">
                        <TextView
                            android:textSize="17sp"
                            android:textColor="#0d84ff"
                            android:id="@+id/train_improve_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/dimen_margin_20dp"
                            android:layout_marginTop="@dimen/dimen_margin_20dp"
                            android:text="@string/training_plan_habit_strength_improve_title"
                            android:fontFamily="@font/misanslatin_demibold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="#0d84ff"
                            android:id="@+id/train_improve_desc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="20dp"
                            android:maxWidth="200dp"
                            android:text="@string/training_plan_habit_strength_improve_content"
                            android:fontFamily="@font/misanslatin_regular"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="@+id/train_improve_title"
                            app:layout_constraintTop_toBottomOf="@+id/train_improve_title"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="#0d84ff"
                            android:gravity="center"
                            android:id="@+id/train_imporve_detail_btn"
                            android:background="@drawable/habit_train_improve_detail_btn_bg"
                            android:paddingLeft="18dp"
                            android:paddingTop="@dimen/dimen_margin_10dp"
                            android:paddingRight="18dp"
                            android:paddingBottom="@dimen/dimen_margin_10dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="10dp"
                            android:text="@string/training_plan_habit_strength_improve_btn"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintRight_toRightOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <ImageView
                            android:id="@+id/train_improve_close"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/dimen_margin_7dp"
                            android:src="@drawable/habit_train_improve_card_close"
                            app:layout_constraintRight_toRightOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <com.xiaomi.fitness.training_plan.widget.HabitHomeDetailCard
                        android:id="@+id/train_home_detail_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimen_margin_10dp"/>
                    <com.xiaomi.fitness.training_plan.widget.HabitHomeTrainTodayCard
                        android:id="@+id/train_home_today"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimen_margin_12dp"/>
                    <com.xiaomi.fitness.training_plan.widget.HabitHomeTrainFutureCard
                        android:id="@+id/train_home_future"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimen_margin_12dp"/>
                </LinearLayout>
            </miuix.core.widget.NestedScrollView>
        </miuix.springback.view.SpringBackLayout>
    </FrameLayout>
</LinearLayout>
