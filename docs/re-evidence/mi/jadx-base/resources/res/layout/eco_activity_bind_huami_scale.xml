<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:tag="layout/eco_activity_bind_huami_scale_0"
    android:background="@color/page_white_bg"
    android:paddingBottom="6.67dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/eco_device_bound_device_item_padding_v"
    android:paddingEnd="@dimen/eco_device_bound_device_item_padding_v">
    <ScrollView
        android:id="@+id/device_sv_bind_process"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:layout_constraintBottom_toTopOf="@+id/device_tv_bind_fail_tip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.xiaomi.fitness.eco.device.manager.ui.EcoDeviceNormalGuideView
                android:id="@+id/device_view_bind_device_info"
                android:tag="binding_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <View
                android:id="@+id/device_view_bind_divide"
                android:background="@color/black_10"
                android:layout_width="match_parent"
                android:layout_height="@dimen/eco_device_item_divide_height"
                android:layout_marginTop="@dimen/dimen_margin_20dp"
                android:layout_marginStart="3.3dp"
                android:layout_marginEnd="3.3dp"/>
            <com.xiaomi.fitness.eco.device.manager.ui.bind.EcoDeviceBindStatusView
                android:id="@+id/device_view_bind_to_connect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_20dp"
                app:eco_device_binding_text="@string/eco_device_bind_connecting"
                app:eco_device_fail_text="@string/eco_device_bind_connect_device_failure"
                app:eco_device_success_text="@string/eco_device_bind_connect_success"/>
            <com.xiaomi.fitness.eco.device.manager.ui.bind.EcoDeviceBindStatusView
                android:id="@+id/device_view_bind_to_pair"
                android:tag="binding_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.xiaomi.fitness.eco.device.manager.ui.bind.EcoDeviceBindStatusView
                android:id="@+id/device_view_bind_to_bind_account"
                android:tag="binding_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:eco_device_binding_text="@string/eco_device_bind_bind_account"
                app:eco_device_fail_text="@string/eco_device_bind_failure"
                app:eco_device_success_text="@string/eco_device_bind_success"/>
        </LinearLayout>
    </ScrollView>
    <TextView
        android:textSize="@dimen/text_size_12"
        android:textColor="@color/red"
        android:id="@+id/device_tv_bind_fail_tip"
        android:tag="binding_4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_margin_20dp"/>
    <TextView
        android:id="@+id/device_tv_bind_btn"
        android:tag="binding_5"
        android:layout_marginBottom="@dimen/dimen_margin_20dp"
        android:text="@string/eco_device_retry"
        style="@style/BaseButton.Positive"/>
    <TextView
        android:id="@+id/tv_finish"
        android:visibility="gone"
        android:layout_marginBottom="@dimen/dimen_margin_20dp"
        android:text="@string/common_complete"
        android:layout_marginStart="@dimen/dimen_margin_0dp"
        android:layout_marginEnd="@dimen/dimen_margin_0dp"
        app:layout_constraintBottom_toTopOf="@+id/device_tv_bind_other"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/CommonBtn.Normal"/>
    <TextView
        android:textColor="@color/eco_device_link_color"
        android:gravity="bottom"
        android:autoLink="all"
        android:id="@+id/device_tv_bind_other"
        android:tag="binding_6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_margin_20dp"
        android:text="@string/eco_device_bind_other_des"
        style="@style/FontMedium.12sp"/>
</LinearLayout>
