<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:tag="layout/device_settings_fragment_time_zone_list_0"
    android:background="@drawable/right_arrow_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.xiaomi.fitness.baseui.dialog.ClearEditText
        android:textSize="14sp"
        android:textColor="@color/switch_black"
        android:textColorHint="@color/edit_hint_color"
        android:id="@+id/rl_search"
        android:background="@drawable/shape_search_bg"
        android:paddingLeft="@dimen/dimen_margin_12dp"
        android:paddingRight="@dimen/dimen_margin_12dp"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:hint="@string/device_settings_world_clock_search_hint"
        android:layout_alignParentTop="true"
        android:drawableStart="@drawable/ic_search"
        android:layout_marginHorizontal="@dimen/page_content_padding_horizontal_large"/>
    <RelativeLayout
        android:id="@+id/rl_city_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/dimen_margin_13dp"
        android:layout_below="@+id/rl_search">
        <miuix.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_toStartOf="@+id/sidebar"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="20sp"
            android:gravity="center"
            android:id="@+id/dialog"
            android:background="@color/black_10_transparent"
            android:visibility="gone"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:text="A"
            android:layout_centerInParent="true"/>
        <com.xiaomi.fitness.devicesettings.widget.SideBar
            android:id="@+id/sidebar"
            android:layout_width="30dp"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</RelativeLayout>
