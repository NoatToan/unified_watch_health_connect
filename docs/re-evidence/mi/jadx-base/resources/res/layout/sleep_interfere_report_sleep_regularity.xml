<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sleepInterfereReportSleepRegularityCardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    app:cardBackgroundColor="@color/common_card_bg_color"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/sleepInterfereReportSleepRegularityLinearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="20dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/sleepInterfereReportSleepRegularityTitleLinearLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp">
            <ImageView
                android:id="@+id/sleepInterfereReportSleepRegularityTitleImageView"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/sleep_regularity_title_image"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="20sp"
                android:textColor="@color/text_color"
                android:id="@+id/sleepInterfereReportSleepRegularityTitleTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/health_sleep_regular"
                android:paddingHorizontal="8dp"
                android:textFontWeight="500"/>
        </LinearLayout>
        <com.xiaomi.fitness.health.sleep.interfere.report.charts.SleepInterfereReportChartInfo2ColumnView
            android:id="@+id/sleepChartInfo2ColumnView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginHorizontal="20dp"/>
        <com.xiaomi.fitness.health.sleep.interfere.report.charts.SleepInterfereReportChartCompareInfoView
            android:id="@+id/sleepChartCompareInfoView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginHorizontal="20dp"/>
        <com.xiaomi.fitness.health.sleep.interfere.report.charts.SleepInterfereLineChartView
            android:id="@+id/sleepRegularityChartView"
            android:layout_width="match_parent"
            android:layout_height="246dp"
            android:layout_marginTop="22dp"/>
        <View
            android:id="@+id/divide_line1"
            android:background="@color/divider_line_color"
            android:layout_width="match_parent"
            android:layout_height="0.37dp"
            android:layout_marginHorizontal="20dp"/>
        <com.xiaomi.fitness.health.sleep.interfere.report.charts.SleepInterfereReportChartInfo2ColumnView
            android:id="@+id/awakeChartInfo2ColumnView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginHorizontal="20dp"/>
        <com.xiaomi.fitness.health.sleep.interfere.report.charts.SleepInterfereReportChartCompareInfoView
            android:id="@+id/awakeChartCompareInfoView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginHorizontal="20dp"/>
        <com.xiaomi.fitness.health.sleep.interfere.report.charts.SleepInterfereLineChartView
            android:id="@+id/awakeRegularityChartView"
            android:layout_width="match_parent"
            android:layout_height="246dp"
            android:layout_marginTop="22dp"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
