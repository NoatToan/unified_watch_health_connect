<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/train_plan_report_share_activity_0"
    android:background="@color/page_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_40dp"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/back"
            android:background="@drawable/ic_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/back"
            android:layout_marginStart="@dimen/page_padding_horizontal_large"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="19dp"
            android:layout_gravity="center"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:text="@string/web_share"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_bar"
        app:tabBackground="@color/page_bg"
        app:tabGravity="center"
        app:tabIconTint="@color/white_50"
        app:tabIndicator="@drawable/shape_tab_indicator"
        app:tabIndicatorAnimationMode="linear"
        app:tabIndicatorFullWidth="false"
        app:tabIndicatorHeight="3dp"
        app:tabMode="fixed"
        app:tabSelectedTextColor="@color/text_color"
        app:tabTextColor="@color/text_color_60"
        style="@style/FontMedium.16sp"/>
    <com.xiaomi.fitness.widget.view.DividerView
        android:id="@+id/horizontal_divider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/dimen_margin_20dp"
        app:layout_constraintTop_toBottomOf="@+id/tab_layout"/>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:tag="share_view_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/edit_content_btn"
        app:layout_constraintTop_toBottomOf="@+id/tab_layout"/>
    <TextView
        android:textColor="#ff6a0d"
        android:id="@+id/edit_content_btn"
        android:background="@drawable/train_plan_report_share_shape_card_bg"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_margin_10dp"
        android:paddingHorizontal="@dimen/dimen_margin_17dp"
        android:paddingVertical="7.5dp"
        app:layout_constraintBottom_toTopOf="@+id/bottom_btn_group"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/FontNormal.14sp"/>
    <include
        android:id="@+id/bottom_btn_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        layout="@layout/share_path_popup_window_page_bg"/>
</androidx.constraintlayout.widget.ConstraintLayout>
