<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/health_fragment_ecg_checking_quailty_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginHorizontal="26.67dp">
    <miuix.androidbasewidget.widget.ProgressBar
        android:layout_gravity="center_vertical"
        android:id="@+id/progressBar"
        app:layout_constraintBottom_toTopOf="@+id/tv_checking"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/ProgressDialogIndeterminateProgressbar"/>
    <TextView
        android:textColor="@color/text_color"
        android:gravity="center"
        android:id="@+id/tv_checking"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_10"
        android:text="@string/health_n60_ecg_checking_quality"
        app:layout_constraintBottom_toTopOf="@+id/tv_finish"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/progressBar"
        style="@style/FontRegular.14sp"/>
    <TextView
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_finish"
        android:background="@drawable/selector_bottom_btn_positive_bg"
        android:visibility="gone"
        android:layout_width="@dimen/common_btn_single_line_width"
        android:layout_height="wrap_content"
        android:layout_marginBottom="26.7dp"
        android:text="@string/health_n60_ecg_done"
        android:paddingHorizontal="10dp"
        android:paddingVertical="12.7dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/FontMedium.16sp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
