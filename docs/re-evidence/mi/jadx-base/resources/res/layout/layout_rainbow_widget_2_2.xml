<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@android:id/background"
    android:background="@drawable/widget_default_corners_background_12_67"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@android:id/widget_frame"
        android:paddingTop="12dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="13dp">
        <ImageView
            android:id="@+id/img_main"
            android:layout_width="@dimen/size_84_6"
            android:layout_height="@dimen/size_42_26"
            android:src="@drawable/ic_widget_rainbow_load_preview_2_2"
            android:scaleType="fitXY"
            android:importantForAccessibility="no"/>
        <TextView
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="8"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="20"
            android:importantForAccessibility="no">
            <ImageView
                android:id="@+id/img_type_calories"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_widget_calorie"
                android:layout_marginEnd="@dimen/size_3"/>
            <TextView
                android:textSize="18sp"
                android:textColor="@color/text_color"
                android:gravity="start|center_vertical"
                android:id="@+id/tv_calories_progress"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text=" - "
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="2sp"
                android:autoSizeMaxTextSize="20sp"
                android:textFontWeight="550"/>
        </LinearLayout>
        <TextView
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="20"
            android:importantForAccessibility="no">
            <ImageView
                android:id="@+id/img_type_step"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_widget_step"
                android:layout_marginEnd="@dimen/size_3"/>
            <TextView
                android:textSize="18sp"
                android:textColor="@color/text_color"
                android:gravity="start|center_vertical"
                android:id="@+id/tv_step_progress"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text=" - "
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="2sp"
                android:autoSizeMaxTextSize="20sp"
                android:textFontWeight="550"/>
        </LinearLayout>
        <TextView
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="20"
            android:importantForAccessibility="no">
            <ImageView
                android:id="@+id/img_type_third"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_widget_mh_strength"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/size_3"/>
            <TextView
                android:textSize="18sp"
                android:textColor="@color/text_color"
                android:gravity="start|center_vertical"
                android:id="@+id/tv_third_progress"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text=" - "
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="2sp"
                android:autoSizeMaxTextSize="20sp"
                android:textFontWeight="550"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
