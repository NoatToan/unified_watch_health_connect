<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/health_curse_info_0"
    android:background="@color/health_card_page_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/page_padding_horizontal_large">
    <miuix.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/content"
            android:paddingTop="13dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/updateView"
            app:layout_constraintTop_toTopOf="parent">
            <View
                android:orientation="vertical"
                android:id="@+id/bg"
                android:background="@drawable/shape_data_item_bg_white"
                android:layout_width="match_parent"
                android:layout_height="82dp"
                android:layout_marginTop="7dp"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="18sp"
                android:textColor="@color/text_color"
                android:id="@+id/periodView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="19dp"
                android:layout_marginStart="18dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/bg"
                style="@style/FontMedium"/>
            <TextView
                android:textSize="12.67sp"
                android:textColor="@color/text_color_40"
                android:gravity="start"
                android:id="@+id/descView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                app:layout_constraintStart_toStartOf="@+id/periodView"
                app:layout_constraintTop_toBottomOf="@+id/periodView"
                style="@style/FontRegular"/>
            <com.xiaomi.fitness.health.curse.view.SymChartRecordInfoView
                android:id="@+id/hurtChartView"
                android:background="@drawable/shape_data_item_bg_white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingEnd="@dimen/health_content_padding"
                app:layout_constraintTop_toBottomOf="@+id/bg"
                app:recordType="hurt"/>
            <com.xiaomi.fitness.health.curse.view.SymChartRecordInfoView
                android:id="@+id/bloodChartView"
                android:background="@drawable/shape_data_item_bg_white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingEnd="@dimen/health_content_padding"
                app:layout_constraintTop_toBottomOf="@+id/hurtChartView"
                app:recordType="blood"/>
            <com.xiaomi.fitness.health.curse.view.SymMoodChartRecordInfoView
                android:id="@+id/moodChartView"
                android:background="@drawable/shape_data_item_bg_white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingEnd="@dimen/health_content_padding"
                app:layout_constraintTop_toBottomOf="@+id/bloodChartView"
                app:recordType="motion"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </miuix.core.widget.NestedScrollView>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/updateView"
            android:layout_width="0dp"
            android:layout_height="47dp"
            android:text="@string/health_curse_update"
            android:layout_weight="1"
            android:layout_marginEnd="0dp"
            style="@style/CommonBtn.Normal"/>
        <TextView
            android:id="@+id/deleteView"
            android:layout_width="0dp"
            android:layout_height="47dp"
            android:text="@string/health_curse_delete"
            android:layout_weight="1"
            android:layout_marginStart="13dp"
            style="@style/CommonBtn.Normal"/>
    </LinearLayout>
</LinearLayout>
