<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/notify_fragment_notify_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <miuix.springback.view.SpringBackLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:scrollableView="@+id/spring_back_target">
        <miuix.core.widget.NestedScrollView
            android:id="@+id/spring_back_target"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="vertical"
                android:paddingBottom="@dimen/dimen_margin_10dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.xiaomi.fitness.ubox.export.DeviceIconView
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/deviceView"
                        android:layout_width="@dimen/dimen_margin_270dp"
                        android:layout_height="@dimen/dimen_margin_270dp"
                        android:layout_marginTop="50dp"
                        android:layout_marginBottom="50dp"
                        app:type="1"/>
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:orientation="vertical"
                        android:id="@+id/notifySwitichView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <com.xiaomi.fitness.widget.SwitchButtonTwoLineTextView
                            android:id="@+id/notifyBtn"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="@dimen/page_content_padding_horizontal_large"
                            android:paddingEnd="@dimen/page_content_padding_horizontal_large"
                            app:subtitle="@string/notify_device_notification_open_info"
                            app:title="@string/notify_device_notification"/>
                        <TextView
                            android:textSize="@dimen/dimen_13sp"
                            android:textStyle="bold"
                            android:textColor="@color/common_main_red_color"
                            android:id="@+id/tv_check_solution"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/notify_device_notification_open_sub_info"
                            android:paddingStart="@dimen/page_content_padding_horizontal_large"
                            android:paddingEnd="@dimen/page_content_padding_horizontal_large"/>
                        <com.xiaomi.fitness.widget.SwitchButtonTwoLineTextView
                            android:id="@+id/only_screen_notifyBtn"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="@dimen/page_content_padding_horizontal_large"
                            android:paddingEnd="@dimen/page_content_padding_horizontal_large"
                            app:singleLineTitle="false"
                            app:title="@string/notify_device_notification_only_screen_lock"/>
                        <com.xiaomi.fitness.widget.SwitchButtonTwoLineTextView
                            android:id="@+id/light_notifyBtn"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="@dimen/page_content_padding_horizontal_large"
                            android:paddingEnd="@dimen/page_content_padding_horizontal_large"
                            app:title="@string/notify_device_notification_auto_screen"/>
                        <com.xiaomi.fitness.widget.SwitchButtonTwoLineTextView
                            android:id="@+id/only_wear_button"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="@dimen/page_content_padding_horizontal_large"
                            android:paddingEnd="@dimen/page_content_padding_horizontal_large"
                            app:singleLineTitle="false"
                            app:title="@string/notify_only_wear"/>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </FrameLayout>
                <com.xiaomi.fitness.widget.view.DividerView
                    android:id="@+id/dividerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="25dp"
                    android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
                    android:layout_marginEnd="@dimen/page_content_padding_horizontal_large"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/open_notification_type_view"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/dimen_13sp"
                        android:textColor="@color/text_color_60"
                        android:id="@+id/label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimen_margin_26dp"
                        android:layout_marginBottom="9dp"
                        android:text="@string/notify_select_type_label"
                        android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
                        android:layout_marginEnd="@dimen/page_content_padding_horizontal_large"/>
                    <com.xiaomi.fitness.notify.widget.CheckBoxTextView
                        android:id="@+id/sync_all_notification_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="@dimen/page_content_padding_horizontal_large"
                        android:paddingEnd="@dimen/page_content_padding_horizontal_large"
                        app:singleLineTitle="false"
                        app:title="@string/notify_mirror_notification"/>
                    <com.xiaomi.fitness.notify.widget.CheckBoxTextView
                        android:id="@+id/select_app_notification_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="@dimen/page_content_padding_horizontal_large"
                        android:paddingEnd="@dimen/page_content_padding_horizontal_large"
                        app:title="@string/select_app_notification_button"/>
                </LinearLayout>
                <miuix.recyclerview.widget.RecyclerView
                    android:orientation="vertical"
                    android:id="@+id/app_list"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="10dp"
                    android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
                    android:layout_marginEnd="@dimen/page_content_padding_horizontal_large"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </miuix.core.widget.NestedScrollView>
    </miuix.springback.view.SpringBackLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/bottomView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textStyle="bold"
            android:id="@+id/skipView"
            android:layout_width="0dp"
            android:text="@string/common_skip"
            android:layout_weight="1"
            style="@style/CommonBtn.Normal"/>
        <TextView
            android:textStyle="bold"
            android:id="@+id/continueView"
            android:layout_width="0dp"
            android:text="@string/common_continue"
            android:layout_weight="1"
            style="@style/CommonBtn.Red"/>
    </LinearLayout>
</androidx.appcompat.widget.LinearLayoutCompat>
