<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/dialog_device_imageView"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:scaleType="fitXY"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/black"
        android:layout_gravity="center_horizontal"
        android:id="@+id/device_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_10dp"
        android:layout_marginBottom="@dimen/dimen_margin_10dp"/>
    <TextView
        android:textSize="@dimen/dimen_12sp"
        android:textColor="@color/common_main_dark_gray_color"
        android:layout_gravity="center_horizontal"
        android:id="@+id/dialog_not_mine_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:text="@string/device_search_not_mine"/>
</LinearLayout>
