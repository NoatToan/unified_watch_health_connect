<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/tips_layout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nfc_recharge_result_tips_layout_height">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/nfc_ic_result_success"/>
        <TextView
            android:textAppearance="@style/nfc_TextAppearance.Large"
            android:textSize="@dimen/nfc_recharge_result_tips_text_size"
            android:textColor="@color/nfc_recharge_result_text_color_gray"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/nfc_recharge_result_tips_text_margin_top"
            android:text="@string/nfc_result_recharge_success"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/line"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nfc_recharge_result_median_barrier_height"
        android:layout_below="@+id/tips_layout"/>
    <ListView
        android:id="@+id/listView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/banner_position"
        android:layout_below="@+id/line"/>
    <FrameLayout
        android:id="@+id/banner_position"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
