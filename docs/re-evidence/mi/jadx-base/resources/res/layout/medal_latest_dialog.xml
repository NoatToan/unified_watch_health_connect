<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="match_parent">
    <androidx.cardview.widget.CardView
        android:id="@+id/cardview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dimen_margin_10dp"
        app:cardBackgroundColor="@color/medal_dialog_bg"
        app:cardCornerRadius="@dimen/medal_margin_30dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:clipChildren="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/size_26_67">
            <com.xiaomi.fitness.medal.widget.MedalIconView
                android:id="@+id/medal_icon"
                android:visibility="invisible"
                android:layout_width="186dp"
                android:layout_height="245dp"
                android:layout_marginTop="40dp"
                android:layout_marginBottom="@dimen/dimen_margin_20dp"
                android:scaleType="centerCrop"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="30sp"
                android:textColor="@color/white"
                android:gravity="center_horizontal"
                android:id="@+id/medal_congrats_lable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/medal_margin_25dp"
                android:layout_marginBottom="@dimen/medal_margin_5dp"
                android:text="@string/medal_latest_congrats"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/medal_icon"/>
            <TextView
                android:textSize="@dimen/dimen_24sp"
                android:textColor="@color/white"
                android:gravity="center_horizontal"
                android:id="@+id/medal_got"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/medal_margin_3dp"
                android:paddingHorizontal="@dimen/dimen_margin_4dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/medal_congrats_lable"/>
            <Button
                android:textSize="15sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/btn_jump_medal_detail"
                android:background="@drawable/medal_selector_button_10white_round"
                android:visibility="invisible"
                android:layout_width="122dp"
                android:layout_height="@dimen/medal_btn_height"
                android:layout_marginTop="@dimen/dimen_margin_20dp"
                android:layout_marginBottom="@dimen/medal_btn_margin"
                android:text="@string/medal_go_detail"
                android:layout_marginEnd="12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/go_medaldetail"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/medal_got"/>
            <Button
                android:textSize="15sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/go_medaldetail"
                android:background="@drawable/medal_selector_button_10white_round"
                android:visibility="invisible"
                android:layout_width="122dp"
                android:layout_height="@dimen/medal_btn_height"
                android:layout_marginTop="@dimen/dimen_margin_20dp"
                android:layout_marginBottom="@dimen/medal_btn_margin"
                android:text="@string/medal_share_medal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/btn_jump_medal_detail"
                app:layout_constraintTop_toBottomOf="@+id/medal_got"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
    <ImageView
        android:id="@+id/dialog_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_20dp"
        android:src="@drawable/icon_medal_dialog_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardview"/>
    <com.airbnb.lottie.LottieAnimationView
        android:layout_gravity="top"
        android:id="@+id/caidai_lottie"
        android:background="@color/common_transparent"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/medal_btn_margin"
        android:scaleType="centerCrop"
        android:contentDescription="@string/close"
        android:layout_marginHorizontal="@dimen/medal_btn_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:lottie_fileName="lottie/caidai.json"/>
</androidx.constraintlayout.widget.ConstraintLayout>
