<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_sportrecord_basic_0"
    android:background="@drawable/sport_detail_item_bg"
    android:paddingBottom="25dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="@color/text_color"
        android:id="@+id/sportNameTxt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:drawablePadding="@dimen/dimen_margin_10dp"
        android:layout_marginStart="@dimen/dimen_margin_18dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/FontMedium.13sp"/>
    <TextView
        android:textSize="47sp"
        android:textColor="@color/text_color"
        android:id="@+id/mainValueTxt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_2dp"
        android:fontFamily="@font/misanslatin_demibold"
        android:layout_marginStart="@dimen/dimen_margin_18dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sportNameTxt"/>
    <TextView
        android:textColor="@color/text_color"
        android:id="@+id/unitText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_margin_5dp"
        app:layout_constraintBaseline_toBaselineOf="@+id/mainValueTxt"
        app:layout_constraintStart_toEndOf="@+id/mainValueTxt"
        style="@style/FontMedium.16sp"/>
    <TextView
        android:textSize="@dimen/font_10"
        android:textColor="@color/black_40"
        android:id="@+id/mainValueDesTV"
        android:paddingTop="2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_margin_1dp"
        android:fontFamily="@font/misanslatin_demibold"
        android:paddingStart="@dimen/dimen_margin_5dp"
        android:paddingEnd="@dimen/dimen_margin_5dp"
        app:layout_constraintBottom_toTopOf="@+id/unitText"
        app:layout_constraintStart_toEndOf="@+id/mainValueTxt"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/text_color_60"
        android:id="@+id/txtCheckLabel"
        android:background="@drawable/bg_sport_detail_check_label"
        android:paddingTop="2dp"
        android:paddingBottom="@dimen/dimen_margin_2dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="42dp"
        android:layout_marginBottom="@dimen/dimen_margin_3dp"
        android:text="@string/trail_label_sport_check"
        android:paddingStart="@dimen/dimen_margin_5dp"
        android:paddingEnd="@dimen/dimen_margin_5dp"
        android:layout_marginStart="2dp"
        app:layout_constraintBottom_toTopOf="@+id/unitText"
        app:layout_constraintStart_toEndOf="@+id/mainValueTxt"
        style="@style/FontMedium"/>
    <RelativeLayout
        android:id="@+id/right_group"
        android:layout_width="@dimen/dimen_margin_0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_margin_20dp"
        android:layout_marginEnd="@dimen/dimen_margin_18dp"
        app:layout_constraintBottom_toBottomOf="@+id/mainValueTxt"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/unitText"
        app:layout_constraintTop_toTopOf="@+id/mainValueTxt">
        <com.xiaomi.fitness.widget.view.RoundImageView
            android:id="@+id/header"
            android:background="@drawable/header_default_icon"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_marginBottom="4dp"
            android:layout_alignParentEnd="true"/>
        <TextView
            android:textColor="@color/text_color_40"
            android:ellipsize="end"
            android:gravity="end"
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:layout_below="@+id/header"
            app:layout_constraintEnd_toEndOf="parent"
            style="@style/FontRegular.12sp"/>
        <TextView
            android:textColor="@color/text_color_40"
            android:gravity="end"
            android:id="@+id/sportTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/name"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/name"
            style="@style/FontRegular.12sp"/>
    </RelativeLayout>
    <FrameLayout
        android:id="@+id/flDivider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/right_group">
        <View
            android:id="@+id/basicDivider"
            android:background="@color/divider_line_color"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0.7dp"
            android:layout_marginTop="@dimen/dimen_margin_20dp"
            android:layout_marginStart="@dimen/page_extra_padding_horizontal_large"
            android:layout_marginEnd="@dimen/page_extra_padding_horizontal_large"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/rlGradientView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_23dp"
            android:layout_marginStart="@dimen/dimen_margin_18dp"
            android:layout_marginEnd="@dimen/dimen_margin_18dp">
            <TextView
                android:textSize="8sp"
                android:textColor="@color/location_trace_pace_3"
                android:id="@+id/txtSlow"
                android:background="@drawable/bg_round_rect_white"
                android:padding="1dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/trail_sport_slow_desc"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="8sp"
                android:textColor="@color/location_trace_pace_14"
                android:id="@+id/txtFast"
                android:background="@drawable/bg_round_rect_white"
                android:padding="1dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/trail_sport_fast_desc"
                android:layout_centerVertical="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.xiaomi.wearable.data.sportmodel.detail.view.LinearGradientView
                android:id="@+id/linearGradientView"
                android:layout_width="0dp"
                android:layout_height="5dp"
                android:layout_centerInParent="true"
                android:layout_marginStart="@dimen/dimen_margin_5dp"
                android:layout_marginEnd="@dimen/dimen_margin_5dp"
                app:layout_constraintBottom_toBottomOf="@+id/txtSlow"
                app:layout_constraintEnd_toStartOf="@+id/txtFast"
                app:layout_constraintStart_toEndOf="@+id/txtSlow"
                app:layout_constraintTop_toTopOf="@+id/txtSlow"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerSportInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="14.66dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/flDivider"/>
</androidx.constraintlayout.widget.ConstraintLayout>
