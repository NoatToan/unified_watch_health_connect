<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/dynamic_mode_item"
        android:background="@drawable/sport_selector_vector_switch_item"
        android:layout_width="match_parent"
        android:layout_height="53.33dp">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/sport_selector_color_dynamic_item"
            android:id="@+id/dynamic_mode_item_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sport_dynamic_mode_txt"
            android:layout_centerVertical="true"
            android:layout_marginStart="26.66dp"/>
        <ImageView
            android:id="@+id/dynamic_mode_item_icon"
            android:layout_width="13.4dp"
            android:layout_height="10.75dp"
            android:src="@drawable/sport_selector_vector_switch_mode"
            android:layout_centerVertical="true"
            android:layout_marginEnd="26.66dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/fitness_mode_item"
        android:background="@drawable/sport_selector_vector_switch_item"
        android:layout_width="match_parent"
        android:layout_height="53.33dp">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/sport_selector_color_dynamic_item"
            android:id="@+id/fitness_mode_item_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sport_fitness_mode_txt"
            android:layout_centerVertical="true"
            android:layout_marginStart="26.66dp"/>
        <ImageView
            android:id="@+id/fitness_mode_item_icon"
            android:layout_width="13.4dp"
            android:layout_height="10.75dp"
            android:src="@drawable/sport_selector_vector_switch_mode"
            android:layout_centerVertical="true"
            android:layout_marginEnd="26.66dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</LinearLayout>
