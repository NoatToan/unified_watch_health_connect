<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/dimen_margin_26dp"
    android:paddingEnd="@dimen/dimen_margin_26dp">
    <EditText
        android:textSize="@dimen/text_size_16"
        android:textColor="@color/sport_color_adjustment_txt"
        android:textColorHint="@color/black_40_transparent"
        android:gravity="center_vertical"
        android:id="@+id/adjustmentEdit"
        android:background="@drawable/bg_adjustment_edit"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_45"
        android:hint="@string/sport_adjustment_distance_hint"
        android:maxLength="6"
        android:inputType="numberDecimal"
        android:paddingStart="@dimen/dimen_margin_16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <Button
        android:textColor="@color/sport_indoor_run"
        android:id="@+id/negative"
        android:background="@drawable/bg_cancel"
        android:layout_width="0dp"
        android:layout_height="47dp"
        android:layout_marginTop="27dp"
        android:text="@string/cancel"
        app:layout_constraintEnd_toStartOf="@+id/positive"
        app:layout_constraintStart_toStartOf="@+id/adjustmentEdit"
        app:layout_constraintTop_toBottomOf="@+id/adjustmentEdit"/>
    <Button
        android:textColor="@color/white"
        android:id="@+id/positive"
        android:background="@drawable/bg_confirm"
        android:layout_width="0dp"
        android:layout_height="47dp"
        android:text="@string/confirm"
        android:layout_marginStart="13.3dp"
        app:layout_constraintEnd_toEndOf="@+id/adjustmentEdit"
        app:layout_constraintStart_toEndOf="@+id/negative"
        app:layout_constraintTop_toTopOf="@+id/negative"/>
</androidx.constraintlayout.widget.ConstraintLayout>
