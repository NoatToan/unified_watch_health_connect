<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:id="@+id/tv_dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        style="@style/Dialog.Text.Title"/>
    <TextView
        android:textSize="@dimen/dimen_15sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_jump_today"
        android:visibility="invisible"
        android:layout_width="@dimen/dimen_24sp"
        android:layout_height="@dimen/dimen_24sp"
        android:text="@string/trail_today_single"
        android:contentDescription="@string/trail_month_dialog_go_today"
        android:layout_alignParentEnd="true"
        style="@style/Dialog.Text.Today"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tv_dialog_description"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tv_dialog_title"
        style="@style/Dialog.Text.Description"/>
    <com.xiaomi.fitness.trail.widget.WeekLabelView
        android:textSize="@dimen/font_9_33"
        android:textColor="@color/dialog_month_week_text_color"
        android:id="@+id/week_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_20dp"
        android:layout_marginBottom="@dimen/size_4_7"
        android:layout_below="@+id/tv_dialog_description"/>
    <View
        android:id="@+id/line_top"
        android:background="@color/dialog_month_line_color"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_1_3"
        android:layout_below="@+id/week_label"/>
    <miuix.recyclerview.widget.RecyclerView
        android:id="@+id/list_month"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/layout_bottom_container"
        android:layout_below="@+id/line_top"/>
    <FrameLayout
        android:id="@+id/layout_bottom_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
