<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container"
        android:background="@drawable/shape_data_item_bg"
        android:paddingTop="@dimen/dialog_text_size_20"
        android:paddingBottom="13.3dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/electronic_scale_health_detail_page_common_margin_vertical">
        <TextView
            android:textColor="@color/text_color"
            android:gravity="center_vertical"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/electronic_scale_health_estimation_index"
            android:drawablePadding="@dimen/dimen_margin_10dp"
            android:drawableStart="@drawable/electronic_scale_ic_estimation_index"
            android:layout_marginStart="@dimen/page_extra_padding_horizontal_large"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/FontMedium.14sp"/>
        <com.xiaomi.fitness.widget.view.DividerView
            android:id="@+id/horizontal_divider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_20dp"
            android:layout_marginHorizontal="@dimen/page_extra_padding_horizontal_large"
            app:layout_constraintTop_toBottomOf="@+id/title"/>
        <com.xiaomi.fitness.electronic.scale.view.SomatoTypeTreemapView
            android:id="@+id/weight_treemap"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/electronic_scale_size_360"
            android:layout_marginTop="@dimen/dimen_margin_23dp"
            android:layout_marginBottom="@dimen/dimen_margin_22dp"
            android:paddingStart="50dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/horizontal_divider"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/weight_somatotype_recycler"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="13.3dp"
            android:overScrollMode="never"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/weight_treemap"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
