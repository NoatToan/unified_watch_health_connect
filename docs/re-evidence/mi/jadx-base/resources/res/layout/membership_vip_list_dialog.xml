<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/membership_vip_list_dialog_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/cover"
        android:layout_width="match_parent"
        android:layout_height="128dp"
        android:scaleType="fitXY"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearance="@style/MembershipDialogCover"/>
    <ImageView
        android:id="@+id/close"
        android:layout_width="@dimen/dimen_margin_30dp"
        android:layout_height="@dimen/dimen_margin_30dp"
        android:layout_marginTop="@dimen/dimen_margin_12dp"
        android:src="@drawable/membership_dialog_close"
        android:layout_marginEnd="@dimen/dimen_margin_12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/icon"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_marginTop="@dimen/dimen_margin_18dp"
        android:src="@drawable/membership_icon"
        android:layout_marginStart="@dimen/dimen_margin_16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="17sp"
        android:textColor="@color/membership_dialog_title"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/misanslatin_demibold"
        android:layout_marginStart="@dimen/dimen_margin_12dp"
        app:layout_constraintBottom_toTopOf="@+id/subTitle"
        app:layout_constraintStart_toEndOf="@+id/icon"
        app:layout_constraintTop_toTopOf="@+id/icon"/>
    <TextView
        android:textSize="@dimen/dimen_12sp"
        android:textColor="@color/membership_dialog_subtitle"
        android:id="@+id/subTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/icon"
        app:layout_constraintStart_toStartOf="@+id/title"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content"
        android:background="@drawable/membership_dialog_content_bg"
        android:paddingBottom="@dimen/dimen_margin_12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_20dp"
        app:layout_constraintTop_toBottomOf="@+id/icon">
        <TextView
            android:textSize="17sp"
            android:textColor="@color/dialog_text_color"
            android:id="@+id/select_combo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_16dp"
            android:text="@string/membership_select_combo"
            android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/FontDemiBold"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/combo_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_12dp"
            android:paddingHorizontal="@dimen/dimen_margin_6dp"
            app:layout_constraintTop_toBottomOf="@+id/select_combo"/>
        <TextView
            android:textSize="@dimen/dimen_12sp"
            android:textColor="@color/footer_desc"
            android:id="@+id/description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_14dp"
            android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/combo_list"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/promotion_bg"
            android:background="@color/membership_dialog_combo_item_tag_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_18dp"
            app:layout_constraintTop_toBottomOf="@+id/description">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/promotion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/dimen_margin_10dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:id="@+id/promotion_icon"
                    android:visibility="gone"
                    android:layout_width="@dimen/dimen_margin_14dp"
                    android:layout_height="@dimen/dimen_margin_14dp"
                    android:layout_marginEnd="2dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/promotion_slogan"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="@dimen/dimen_13sp"
                    android:textColor="@color/membership_dialog_subtitle"
                    android:id="@+id/promotion_slogan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dimen_margin_2dp"
                    android:layout_marginEnd="@dimen/dimen_margin_2dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/promotion_countdown"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toEndOf="@+id/promotion_icon"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textColor="@color/membership_dialog_combo_countdown"
                    android:id="@+id/promotion_countdown"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dimen_margin_2dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toEndOf="@+id/promotion_slogan"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:id="@+id/pay"
            android:layout_marginTop="@dimen/dimen_margin_16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/promotion_bg"
            style="@style/CommonBtn.Membership"/>
        <TextView
            android:textSize="@dimen/dimen_12sp"
            android:textColor="@color/footer_desc"
            android:id="@+id/privacy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_12dp"
            android:layout_marginStart="@dimen/dimen_margin_3dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/checkbox"
            app:layout_constraintTop_toBottomOf="@+id/pay"/>
        <CheckBox
            android:id="@+id/checkbox"
            android:background="@drawable/selector_check"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:button="@null"
            android:layout_marginEnd="@dimen/dimen_margin_3dp"
            app:layout_constraintBottom_toBottomOf="@+id/privacy"
            app:layout_constraintEnd_toStartOf="@+id/privacy"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/privacy"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
