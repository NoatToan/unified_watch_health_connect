<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.motion.widget.MotionLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/routeItemLayout"
    android:tag="layout/layout_route_select_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layoutDescription="@xml/layout_route_select_scene">
    <androidx.cardview.widget.CardView
        android:gravity="center"
        android:id="@+id/locationBtn"
        android:layout_width="55dp"
        android:layout_height="55dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="15dp"
        app:cardElevation="1.5dp"
        app:cardPreventCornerOverlap="true"
        app:cardUseCompatPadding="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:gravity="center"
            android:background="@drawable/location_btn_no"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </androidx.cardview.widget.CardView>
    <View
        android:id="@+id/stub"
        android:layout_width="60dp"
        android:layout_height="60dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.cardview.widget.CardView
        android:id="@+id/seeList"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:paddingHorizontal="12dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="15dp"
        app:cardElevation="1.5dp"
        app:cardPreventCornerOverlap="true"
        app:cardUseCompatPadding="true"
        app:layout_constraintBottom_toBottomOf="@+id/locationBtn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/locationBtn">
        <TextView
            android:textSize="14.6dp"
            android:textColor="@color/black"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sport_see_list"
            android:drawablePadding="6dp"
            android:drawableStart="@drawable/ic_list_icon"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="13dp"
            android:paddingVertical="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/locationBtn"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/locationBtn"/>
    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView
        android:id="@+id/cardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_margin_5dp"
        android:layout_marginEnd="@dimen/dimen_margin_5dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="15dp"
        app:cardElevation="1dp"
        app:cardPreventCornerOverlap="true"
        app:cardUseCompatPadding="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/seeList">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/selectItem"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/route_icon"
                android:background="@drawable/shape_card_bg_normal"
                android:layout_width="82dp"
                android:layout_height="82dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                app:layout_constraintStart_toEndOf="@+id/route_icon"
                app:layout_constraintTop_toBottomOf="@+id/route_length"
                app:layout_constraintTop_toTopOf="@+id/route_icon"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/black_60_transparent"
                android:id="@+id/route_length"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toTopOf="@+id/start_point_dis"
                app:layout_constraintStart_toStartOf="@+id/name"
                app:layout_constraintTop_toBottomOf="@+id/name"/>
            <TextView
                android:textSize="12dp"
                android:id="@+id/heat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@+id/route_length"
                app:layout_constraintStart_toEndOf="@+id/route_length"
                app:layout_constraintTop_toTopOf="@+id/route_length"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/black_60_transparent"
                android:id="@+id/start_point_dis"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toTopOf="@+id/route_type"
                app:layout_constraintStart_toStartOf="@+id/name"
                app:layout_constraintTop_toBottomOf="@+id/route_length"/>
            <TextView
                android:textSize="10.67dp"
                android:textColor="@color/sport_color_08c59A"
                android:gravity="center"
                android:id="@+id/route_type"
                android:background="@drawable/shape_e0f4ee"
                android:layout_width="54.6dp"
                android:layout_height="18.6dp"
                app:layout_constraintBottom_toBottomOf="@+id/route_icon"
                app:layout_constraintStart_toStartOf="@+id/name"
                app:layout_constraintTop_toBottomOf="@+id/start_point_dis"/>
            <TextView
                android:background="@drawable/right_arrow_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.motion.widget.MotionLayout>
