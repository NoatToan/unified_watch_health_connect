<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/pay_layout_payment_dialog_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/dimen_16sp"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pay_checkout_title"
            android:fontFamily="@font/misanslatin_medium"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/close"
            android:layout_width="@dimen/dimen_margin_30dp"
            android:layout_height="@dimen/dimen_margin_30dp"
            android:src="@drawable/ic_cancel_left_toolbar"
            android:layout_marginEnd="@dimen/page_padding_horizontal_large"
            app:layout_constraintBottom_toBottomOf="@+id/title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/title"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textColor="@color/footer_desc"
        android:layout_gravity="center_horizontal"
        android:id="@+id/remain_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_25dp"
        style="@style/FontRegular.14sp"/>
    <TextView
        android:textSize="36sp"
        android:layout_gravity="center_horizontal"
        android:id="@+id/price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_10dp"
        style="@style/FontLatinSemiBold"/>
    <TextView
        android:textColor="@color/footer_desc"
        android:id="@+id/channel_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_24dp"
        android:text="@string/pay_checkout_payment_instrument"
        android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
        android:paddingVertical="@dimen/dimen_margin_8dp"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/channel"
        android:background="@drawable/pay_bg_result_item"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dimen_margin_3dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="@dimen/page_padding_horizontal_large"
        android:paddingVertical="@dimen/dimen_margin_6dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@+id/confirm_bg"
        app:layout_constraintTop_toBottomOf="@+id/channel_title"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/confirm_bg"
        android:background="@color/pay_order_page_list_item_bg"
        android:paddingTop="@dimen/dimen_margin_20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/channel">
        <TextView
            android:id="@+id/confirm"
            android:text="@string/pay_checkout_confirm_pay"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/CommonBtn.Primary"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
