<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/page_padding_horizontal_large"
        layout="@layout/layout_sleep_efficiency"/>
    <include
        android:visibility="gone"
        layout="@layout/layout_sleep_snore_dream_talk"/>
    <View
        android:id="@+id/split_line_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/size_20"
        android:layout_marginStart="@dimen/size_18"
        android:layout_marginEnd="@dimen/size_18"/>
    <include
        android:visibility="gone"
        layout="@layout/health_layout_sleep_day_heart_rate_v2"/>
    <include
        android:visibility="gone"
        layout="@layout/health_layout_sleep_day_spo2_v2"/>
    <include
        android:visibility="gone"
        layout="@layout/health_layout_sleep_day_breath_quality_v2"/>
    <include
        android:visibility="gone"
        layout="@layout/layout_sleep_day_heart_relative_rate"/>
    <include
        android:visibility="gone"
        layout="@layout/layout_sleep_day_relative_spo2"/>
    <include
        android:id="@+id/sleep_interpretation"
        android:visibility="gone"
        layout="@layout/sleep_interpretation_card"/>
</LinearLayout>
