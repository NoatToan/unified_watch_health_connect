<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/device_settings_headset_list_fragment_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/dimen_margin_12dp"
    android:paddingEnd="@dimen/dimen_margin_12dp">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/download_layout"
        android:background="@drawable/selector_card_bg"
        android:paddingTop="@dimen/dimen_margin_18dp"
        android:paddingBottom="@dimen/dimen_margin_18dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dimen_margin_15dp"
        android:paddingEnd="@dimen/dimen_margin_15dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.3"
            android:paddingEnd="@dimen/dimen_margin_13dp">
            <TextView
                android:gravity="center_vertical"
                android:id="@+id/left_total_record_time_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="@dimen/dimen_margin_6dp"
                style="@style/FontRegular.12sp"/>
            <miuix.androidbasewidget.widget.ProgressBar
                android:id="@+id/left_progressBar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimen_margin_5dp"
                android:layout_marginTop="@dimen/dimen_margin_5dp"
                android:max="1000"
                android:progressDrawable="@drawable/device_settings_download_progress_horizontal"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"/>
            <TextView
                android:gravity="center_vertical"
                android:id="@+id/right_total_record_time_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="21dp"
                android:drawablePadding="@dimen/dimen_margin_6dp"
                style="@style/FontRegular.12sp"/>
            <miuix.androidbasewidget.widget.ProgressBar
                android:id="@+id/right_progressBar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimen_margin_5dp"
                android:layout_marginTop="@dimen/dimen_margin_5dp"
                android:max="1000"
                android:progressDrawable="@drawable/device_settings_download_progress_horizontal"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"/>
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="@dimen/dimen_margin_13dp">
            <TextView
                android:textColor="@color/colorPrimary"
                android:layout_gravity="center"
                android:id="@+id/download_all"
                android:background="@drawable/device_settings_audio_download_bg"
                android:paddingTop="@dimen/dimen_margin_8dp"
                android:paddingBottom="@dimen/dimen_margin_8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/dimen_margin_14dp"
                android:paddingEnd="@dimen/dimen_margin_14dp"/>
        </LinearLayout>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/record_list_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/dimen_margin_13dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/download_layout"/>
</LinearLayout>
