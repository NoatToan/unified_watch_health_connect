<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:tag="layout/course_all_catalog_activity_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcv_course_catalog"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:background="@color/course_catalog_unselect_color"
        android:layout_width="100dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rcv_course_catalog"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/rcv_course_catalog">
        <com.mi.health.course.widget.NoNestScrollRecyclerView
            android:orientation="vertical"
            android:id="@+id/tabView"
            android:background="@drawable/common_tab_bg"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="37dp"
            android:overScrollMode="never"
            android:paddingStart="@dimen/page_padding_horizontal_large"
            android:paddingEnd="@dimen/page_padding_horizontal_large"
            android:layout_marginStart="@dimen/page_padding_horizontal_large"
            android:layout_marginEnd="@dimen/page_padding_horizontal_large"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:spanCount="3"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:tag="binding_1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="19dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tabView"
            app:layout_goneMarginTop="15dp">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/text_color_20"
                android:id="@+id/tv_no_course"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="150dp"
                android:text="未找到符合条件的课程"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/colorPrimary"
                android:id="@+id/tv_clear_filter"
                android:background="@drawable/course_clear_filter_bg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="清除筛选条件"
                android:paddingHorizontal="18dp"
                android:paddingVertical="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_no_course"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/group_no_course"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="tv_no_course,tv_clear_filter"/>
            <include
                android:id="@+id/state_view"
                android:visibility="gone"
                layout="@layout/view_text_icon"/>
            <com.xiaomi.fitness.baseui.recyclerview.MoreRecyclerView
                android:orientation="vertical"
                android:id="@+id/recycler_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/selectView"
            android:background="@color/course_catalog_mask"
            android:paddingBottom="27dp"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="5dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tabView">
            <com.mi.health.course.widget.NoNestScrollRecyclerView
                android:id="@+id/tagsView"
                android:background="@color/course_white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never"
                android:paddingStart="15dp"
                android:paddingEnd="27dp"/>
            <View
                android:id="@+id/holder"
                android:background="@drawable/course_catalog_bg"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                app:layout_constraintTop_toBottomOf="@+id/tagsView"/>
            <TextView
                android:id="@+id/resetView"
                android:layout_width="0dp"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="0dp"
                android:text="@string/course_reset"
                app:layout_constraintBottom_toBottomOf="@+id/holder"
                app:layout_constraintEnd_toStartOf="@+id/confirmView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tagsView"
                app:layout_constraintTop_toTopOf="@+id/holder"
                style="@style/CommonBtn.Normal"/>
            <TextView
                android:id="@+id/confirmView"
                android:layout_width="0dp"
                android:layout_marginBottom="0dp"
                android:text="@string/confirm"
                android:layout_marginStart="13dp"
                app:layout_constraintBottom_toBottomOf="@+id/resetView"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/resetView"
                app:layout_constraintTop_toTopOf="@+id/resetView"
                style="@style/CommonBtn.Primary"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
