<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/ll_itemview"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/switch_black"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/cityNameView"
        android:layout_width="match_parent"
        android:layout_height="53dp"
        android:singleLine="true"
        android:paddingStart="@dimen/page_content_padding_horizontal_large"
        android:paddingEnd="@dimen/page_content_padding_horizontal_large"/>
</LinearLayout>
