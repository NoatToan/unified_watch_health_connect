<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:textColor="@color/text_color"
            android:id="@+id/tv_key"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            style="@style/nfc_TextAppearance.List.Primary"/>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/nfc_card_record_item_date_margin_top">
            <TextView
                android:textColor="@color/text_color_80"
                android:id="@+id/tv_first_sub_key"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                style="@style/nfc_TextAppearance.List.Secondary"/>
            <View
                android:layout_gravity="center"
                android:id="@+id/divider"
                android:background="@color/text_color_80"
                android:layout_width="@dimen/nfc_card_record_item_divider_width"
                android:layout_height="@dimen/nfc_card_record_item_divider_height"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/nfc_card_record_item_divider_margin_left"
                android:layout_marginEnd="@dimen/nfc_card_record_item_divider_margin_right"/>
            <TextView
                android:textColor="@color/text_color_80"
                android:id="@+id/tv_second_sub_key"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                style="@style/nfc_TextAppearance.List.Secondary"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="end"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textColor="@color/text_color_80"
            android:gravity="end"
            android:id="@+id/tv_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            style="@style/nfc_TextAppearance.List.Primary"/>
        <TextView
            android:textColor="@color/text_color_80"
            android:gravity="end"
            android:id="@+id/tv_sub_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/nfc_card_record_item_status_margin_top"
            android:singleLine="true"
            style="@style/nfc_TextAppearance.List.Secondary"/>
    </LinearLayout>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/iv_arrow"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_base_right_arrow_icon"/>
</LinearLayout>
