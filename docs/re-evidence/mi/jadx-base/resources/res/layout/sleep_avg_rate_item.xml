<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/selector_card_bg"
        android:paddingTop="@dimen/size_20"
        android:paddingBottom="@dimen/size_20"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_13"
        android:paddingHorizontal="20dp">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/card_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_icon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textColor="@color/text_color"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/health_sleep_average_heart_rate"
                android:layout_marginStart="@dimen/size_6_7"
                style="@style/FontMedium.14sp"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/guide_view"
                android:background="@drawable/today_health_guide_view"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dimen_margin_4dp"/>
        </LinearLayout>
        <FrameLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_13"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/card_title">
            <com.xiaomi.fitness.view.TodayHealthDataTitleView
                android:id="@+id/dataTitleView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-20dp"/>
            <com.xiaomi.fitness.chart.view.BarChartRecyclerView
                android:id="@+id/bar_recycler"
                android:paddingTop="79.6dp"
                android:layout_height="311dp"
                android:paddingStart="0dp"
                android:paddingEnd="32dp"
                app:barChartMaxWidth="@dimen/size_5"
                app:barChartRoundRectRadiusRatio="0.03"
                app:barChartSegment="1"
                app:chartColor="@color/health_hrm_chart"
                app:contentPaddingBottom="31.3dp"
                app:dynamicAdjustItemFillWidth="true"
                app:enableEndDayXAxis="true"
                app:enableStartYAxisLabel="false"
                style="@style/ChartBaseStyle"/>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
