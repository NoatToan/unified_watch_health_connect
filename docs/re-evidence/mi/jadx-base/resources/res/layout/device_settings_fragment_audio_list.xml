<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/device_settings_fragment_audio_list_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headView"
        android:background="@drawable/selector_card_bg"
        android:padding="@dimen/dimen_margin_15dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/page_padding_horizontal_large"
        android:layout_marginEnd="@dimen/page_padding_horizontal_large">
        <TextView
            android:id="@+id/storageTipView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/device_settings_audio_record_storage_tips"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/FontDemiBold.16sp"/>
        <TextView
            android:id="@+id/storageView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/storageTipView"
            style="@style/FontDemiBold.12sp"/>
        <miuix.androidbasewidget.widget.ProgressBar
            android:id="@+id/storageProgressView"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="@dimen/dimen_margin_7dp"
            android:progress="100"
            android:progressDrawable="@drawable/device_settings_music_settings_device_storage_progress_bg"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/storageView"
            style="@style/ProgressDialog"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/dimen_margin_15dp"
        android:layout_below="@+id/headView"
        android:layout_marginStart="@dimen/page_padding_horizontal_large"
        android:layout_marginEnd="@dimen/page_padding_horizontal_large"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/emptyView"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_centerVertical="true">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/imgEmptryView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:src="@drawable/icon_common_empty"
            android:scaleType="center"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/text_color_40"
            android:gravity="center_horizontal"
            android:id="@+id/txtEmptryView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:text="@string/no_data"/>
    </LinearLayout>
</RelativeLayout>
