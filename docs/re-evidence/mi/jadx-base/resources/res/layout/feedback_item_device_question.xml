<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:tag="layout/feedback_item_device_question_0"
    android:background="@drawable/feedback_selector_white_round"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/dimen_margin_6dp">
    <com.xiaomi.fitness.widget.SquareBindingImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/feedback_item_iv_device_icon"
        android:tag="binding_1"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:layout_marginTop="@dimen/dimen_margin_20dp"
        android:scaleType="centerCrop"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/text_color"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/feedback_item_tv_device_name"
        android:tag="binding_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_6dp"
        android:layout_marginBottom="6dp"
        android:minLines="2"
        android:layout_marginStart="@dimen/dimen_margin_10dp"
        android:layout_marginEnd="@dimen/dimen_margin_10dp"/>
</LinearLayout>
