<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:tag="layout/nfc_fragment_union_cnv2_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/common_title_left_margin"
        android:paddingEnd="@dimen/common_title_left_margin">
        <TextView
            android:textSize="20sp"
            android:textColor="@color/text_color"
            android:id="@+id/whoView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/text_color"
            android:id="@+id/safeView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nfc_bind_bank_card_num_safe_wearable_global"
            android:layout_below="@+id/whoView"/>
        <TextView
            android:textSize="11sp"
            android:id="@+id/validLable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:text="@string/nfc_bind_bank_card_valid_title_global"
            android:layout_below="@+id/safeView"/>
        <RelativeLayout
            android:id="@+id/validContainnerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:layout_below="@+id/validLable">
            <com.xiaomi.fitness.nfc.widget.SafeEditText
                android:textSize="16sp"
                android:textColor="@color/text_color"
                android:textColorHint="#39000000"
                android:id="@+id/validView"
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/nfc_bind_bank_card_valid_hint_global"
                android:cursorVisible="true"
                android:singleLine="true"
                android:maxLength="5"
                android:layout_centerVertical="true"
                android:inputType="none"
                android:textDirection="locale"/>
            <ImageView
                android:id="@+id/validDateHelpView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/cnv2_helper"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <TextView
            android:textSize="11sp"
            android:id="@+id/cnv2Lable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:text="@string/nfc_cnv2"
            android:layout_below="@+id/validContainnerView"/>
        <RelativeLayout
            android:id="@+id/cnv2ContainnerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:layout_below="@+id/cnv2Lable">
            <com.xiaomi.fitness.nfc.widget.SafeEditText
                android:textSize="16sp"
                android:textColor="@color/text_color"
                android:textColorHint="#39000000"
                android:id="@+id/cnv2View"
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/nfc_bind_bank_card_cvn2_hint_globa"
                android:cursorVisible="true"
                android:singleLine="true"
                android:maxLength="3"
                android:layout_centerVertical="true"
                android:inputType="none"
                android:textDirection="locale"
                android:textAlignment="viewStart"/>
            <ImageView
                android:id="@+id/cnv2HelpView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/cnv2_helper"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/protolView"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="11dp"
            android:layout_above="@+id/nextView"
            android:layout_centerInParent="true">
            <CheckBox
                android:textSize="14sp"
                android:textColor="@color/text_color"
                android:gravity="center_vertical"
                android:id="@+id/checkView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:button="@drawable/selector_check"
                android:drawablePadding="2dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/text_color"
                android:autoLink="web"
                android:layout_gravity="center_vertical"
                android:id="@+id/protoView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"/>
        </LinearLayout>
        <TextView
            android:enabled="false"
            android:id="@+id/nextView"
            android:text="@string/nfc_common_step_next"
            android:layout_above="@+id/bottomView"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp"
            style="@style/CommonBtn.Primary"/>
        <View
            android:id="@+id/bottomView"
            android:layout_width="match_parent"
            android:layout_height="@dimen/common_title_left_margin"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
</ScrollView>
