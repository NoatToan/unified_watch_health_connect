<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:tag="layout/sport_ble_update_fragment_bottom_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/dimen_12sp"
        android:textColor="@color/black_60_transparent"
        android:id="@+id/progress_info"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="19dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"/>
    <ProgressBar
        android:id="@+id/upgrade_pb"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="19dp"
        android:progressDrawable="@drawable/sport_download_progress_horizontal"
        android:minHeight="10dp"
        android:layout_above="@+id/update_btn"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        style="@style/Base.Widget.AppCompat.ProgressBar.Horizontal"/>
    <LinearLayout xmlns:circleProgress="http://schemas.android.com/apk/res-auto"
        android:gravity="center_vertical"
        android:id="@+id/update_progress_dialog_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/progress_height">
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/progress_margin">
            <ProgressBar
                android:layout_gravity="center_vertical"
                android:id="@+id/xq_progress_dialog_indeterminate"
                style="@style/ProgressDialogIndeterminateProgressbar"/>
            <com.xiaomi.fitness.baseui.dialog.CustomCircleProgressBar
                android:layout_gravity="center_vertical"
                android:id="@+id/xq_progress_dialog_determinate"
                android:background="@drawable/dialog_loading"
                android:visibility="gone"
                android:layout_width="20dp"
                android:layout_height="20dp"
                circleProgress:inside_indent="0"
                circleProgress:paint_color="@color/white"
                circleProgress:paint_width="3"/>
        </FrameLayout>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/common_black"
            android:layout_gravity="center_vertical"
            android:id="@+id/xq_progress_dialog_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/common_installing"
            android:layout_marginStart="15dp"/>
    </LinearLayout>
    <TextView
        android:id="@+id/upgrade_btn"
        android:text="@string/sport_firmware_download_upgrade_packet"
        style="@style/CommonBtn.Black"/>
</LinearLayout>
