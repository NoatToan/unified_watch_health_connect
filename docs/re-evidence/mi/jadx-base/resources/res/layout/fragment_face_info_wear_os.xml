<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_face_info_wear_os_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/layout_face_layer"/>
    <com.xiaomi.fitness.widget.view.DividerView
        android:id="@+id/divider"
        android:layout_marginTop="@dimen/dimen_margin_20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mSizeAuthorView"
        style="@style/SettingDivider.Curse"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottom_button"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.xiaomi.fitness.watch.face.widget.PhotoBgPicker
                android:id="@+id/photo_content"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_16dp"
                android:layout_marginStart="@dimen/dimen_margin_26dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/style_content"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/photo_content">
                <miuix.recyclerview.widget.RecyclerView
                    android:id="@+id/style_settings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_16dp"
                android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/style_content">
                <TextView
                    android:id="@+id/complication_slot_title"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_margin_8dp"
                    android:layout_marginBottom="@dimen/dimen_margin_8dp"
                    android:text="@string/face_complication"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/FontRegular.12sp"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/complication_slot_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@+id/complication_slot_title"
                    app:layout_constraintTop_toBottomOf="@+id/complication_slot_title"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/bottom_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:id="@+id/actionDelView"
            android:text="@string/common_delete"
            android:layout_weight="1"
            android:layout_marginEnd="0dp"
            style="@style/CommonBtn.Primary"/>
        <View
            android:id="@+id/empty_view"
            android:layout_width="@dimen/dimen_margin_7dp"
            android:layout_height="@dimen/common_btn_height"/>
        <View
            android:id="@+id/apply_margin"
            android:visibility="gone"
            android:layout_width="@dimen/dimen_margin_26dp"
            android:layout_height="@dimen/common_btn_height"/>
        <TextView
            android:id="@+id/actionUseView"
            android:text="@string/common_use"
            android:layout_weight="1"
            android:layout_marginStart="0dp"
            style="@style/CommonBtn.Normal"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
