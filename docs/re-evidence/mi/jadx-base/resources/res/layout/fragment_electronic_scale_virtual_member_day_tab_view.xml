<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_container"
    android:background="@color/page_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:id="@+id/fl_chart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.xiaomi.fitness.chart.view.LineChartRecyclerView
                android:id="@+id/line_chart_recycler"
                app:enableScrollToScale="true"
                app:enableStartYAxisLabel="false"
                app:enableXAxisLineCircle="true"
                app:lineColor="@color/electronic_scale_weight_chart_color"
                app:lineHighLightType="4"
                app:linePointRadius="2dp"
                app:linePointSelectCircleStroke="true"
                app:linePointSelectRadius="2dp"
                app:linePointSelectStrokeWidth="2dp"
                app:lineSelectCircles="1"
                app:lineShaderBeginColor="@color/energy_shader_begin"
                app:lineShaderEndColor="@color/energy_shader_end"
                app:lineStrokeWidth="6"
                app:xAxisLabelPosition="0"
                style="@style/ChartBaseStyle"/>
            <com.xiaomi.fitness.electronic.scale.widget.DataTitleView
                android:id="@+id/data_title_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </FrameLayout>
        <include
            android:id="@+id/layout_weight_day_detail"
            android:visibility="gone"
            layout="@layout/electronic_scale_health_layout_weight_day_detail"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/lin_note"
            android:background="@drawable/shape_data_item_bg"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dimen_margin_26dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/fl_chart">
            <TextView
                android:textSize="18sp"
                android:textColor="@color/text_color"
                android:id="@+id/tv_warm_tips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/electronic_scale_warm_tips"
                android:layout_marginHorizontal="34dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/fl_chart"/>
            <View
                android:background="@color/divider_line_color"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginTop="10dp"
                android:layout_marginHorizontal="34dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/text_color_60"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="20dp"
                android:text="@string/electronic_scale_warm_tips_desc"
                android:layout_marginStart="34dp"
                android:layout_marginEnd="34dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_warm_tips"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
