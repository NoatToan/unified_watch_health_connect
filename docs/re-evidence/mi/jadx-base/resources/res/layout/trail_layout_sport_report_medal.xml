<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/trail_layout_sport_report_medal_0"
    android:paddingTop="20dp"
    android:paddingBottom="20dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/medal_icon"
        android:layout_width="67dp"
        android:layout_height="88dp"
        android:scaleType="centerCrop"
        android:layout_marginStart="@dimen/page_extra_padding_horizontal_large"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/text_color"
        android:ellipsize="end"
        android:id="@+id/medal_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_5dp"
        android:maxWidth="250dp"
        android:singleLine="true"
        app:layout_constraintEnd_toEndOf="@+id/medal_icon"
        app:layout_constraintStart_toStartOf="@+id/medal_icon"
        app:layout_constraintTop_toBottomOf="@+id/medal_icon"/>
</androidx.constraintlayout.widget.ConstraintLayout>
