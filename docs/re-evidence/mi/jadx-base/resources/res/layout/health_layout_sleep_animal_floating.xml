<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_floating"
    android:tag="layout/health_layout_sleep_animal_floating_0"
    android:background="@drawable/health_sleep_floating_view_bg_shape"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/size_72"
    android:paddingStart="14dp"
    android:paddingEnd="@dimen/size_18"
    android:paddingVertical="@dimen/size_14">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_unlock"
        android:layout_width="21.3dp"
        android:layout_height="21.3dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/health_ic_sleep_unlock"/>
    <TextView
        android:textSize="13.3sp"
        android:textColor="@color/health_sleep_floating_text_color"
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="7dp"
        android:paddingEnd="@dimen/size_10"
        app:layout_constraintBottom_toTopOf="@+id/tv_subtitle"
        app:layout_constraintEnd_toStartOf="@+id/tv_buy"
        app:layout_constraintStart_toEndOf="@+id/iv_unlock"
        app:layout_constraintTop_toTopOf="@+id/iv_unlock"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/FontMedium"/>
    <TextView
        android:textSize="10.7sp"
        android:textColor="@color/health_sleep_floating_text_color"
        android:id="@+id/tv_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/health_sleep_example_report"
        android:paddingStart="7dp"
        android:paddingEnd="@dimen/size_10"
        app:layout_constraintBottom_toBottomOf="@+id/iv_unlock"
        app:layout_constraintEnd_toStartOf="@+id/tv_buy"
        app:layout_constraintStart_toEndOf="@+id/iv_unlock"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        style="@style/FontMedium"/>
    <TextView
        android:textColor="@color/health_sleep_floating_text_color"
        android:id="@+id/tv_buy"
        android:background="@drawable/shape_btn_white_bg_normal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="@dimen/size_100"
        android:text="@string/health_sleep_purchase_device"
        android:paddingHorizontal="@dimen/size_22"
        android:paddingVertical="@dimen/size_10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/FontMedium"/>
</androidx.constraintlayout.widget.ConstraintLayout>
