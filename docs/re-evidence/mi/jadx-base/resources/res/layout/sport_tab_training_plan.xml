<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/root"
        android:background="@drawable/shape_card_bg_normal"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_12dp"
        android:paddingHorizontal="@dimen/dimen_margin_12dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_12dp"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textSize="17sp"
                    android:gravity="center_vertical"
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/training_plan_label"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/FontDemiBold"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/trainingSummaryLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/text_color_40"
                        android:gravity="start|center_vertical"
                        android:id="@+id/trainingName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/misanslatin_medium"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <View
                        android:id="@+id/trainingDivider"
                        android:background="@color/divider_color"
                        android:layout_width="1dp"
                        android:layout_height="12dp"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="6dp"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/text_color_40"
                        android:gravity="center_vertical"
                        android:id="@+id/daysCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/FontDemiBold"/>
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/dimen_14sp"
                android:textColor="@color/text_color_40"
                android:gravity="center_vertical"
                android:id="@+id/all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/training_plan_all_type"
                android:drawablePadding="2dp"
                android:drawableEnd="@drawable/ic_right_arrow"
                android:layout_marginEnd="4dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/tipLayout"
            android:background="@drawable/training_plan_force_stop_bg"
            android:paddingBottom="@dimen/dimen_margin_22dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_14dp"
            app:layout_constraintTop_toBottomOf="@+id/top">
            <TextView
                android:textSize="@dimen/dimen_13sp"
                android:textColor="#0d84ff"
                android:id="@+id/trainingTip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_20dp"
                android:text="@string/training_plan_force_stop_tip"
                android:layout_marginStart="@dimen/dimen_margin_14dp"
                android:layout_marginEnd="39dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/closeTip"
                android:padding="6dp"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginTop="@dimen/dimen_margin_8dp"
                android:src="@drawable/training_plan_force_stop_icon"
                android:layout_marginEnd="@dimen/dimen_margin_8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.xiaomi.fitness.widget.ScrollableHorizontalRecyclerView
            android:id="@+id/trainingTypeList"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_12dp"
            app:layout_constraintTop_toBottomOf="@+id/tipLayout"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/courseList"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_12dp"
            app:layout_constraintTop_toBottomOf="@+id/tipLayout"/>
        <FrameLayout
            android:id="@+id/exceptionLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/top"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
