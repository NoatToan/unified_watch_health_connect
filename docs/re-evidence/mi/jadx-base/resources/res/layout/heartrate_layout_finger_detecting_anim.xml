<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_camera_img_anim"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.xiaomi.fitness.heartrate.camera.VideoPreviewView
        android:id="@+id/preview_detect"
        android:layout_width="355dp"
        android:layout_height="355dp"
        android:contentDescription="@string/heartrate_detect"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.xiaomi.fitness.heartrate.ui.view.TwinkleView
        android:id="@+id/ppg_view"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_alignTop="@+id/preview_detect"
        app:layout_constraintBottom_toBottomOf="@+id/preview_detect"
        app:layout_constraintTop_toTopOf="@+id/preview_detect"/>
</androidx.constraintlayout.widget.ConstraintLayout>
