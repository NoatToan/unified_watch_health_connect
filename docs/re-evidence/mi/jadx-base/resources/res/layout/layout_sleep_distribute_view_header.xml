<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingBottom="@dimen/size_20"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/divide_line"
        android:background="@color/common_divider_bg_color"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_0_33"
        android:layout_marginBottom="@dimen/size_30"
        android:layout_marginStart="@dimen/size_18"
        android:layout_marginEnd="@dimen/size_18"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_18">
        <TextView
            android:textColor="@color/text_color"
            android:layout_gravity="center_vertical"
            android:id="@+id/txt_header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/health_sleep_structure_title"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/FontMedium.16sp"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/img_header"
            android:background="@drawable/health_understand_more_title_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="center"
            android:layout_marginStart="@dimen/dimen_margin_2dp"
            android:layout_marginEnd="@dimen/size_10"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/txt_header_title"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/img_header_liner"
            android:background="@drawable/shape_sleep_distribute_title_bg"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dimen_margin_18dp"
            android:paddingHorizontal="@dimen/dimen_margin_13dp"
            android:paddingVertical="@dimen/dimen_margin_6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textColor="@color/health_sleep_distribute_title_txt_color"
                android:layout_gravity="center_vertical"
                android:id="@+id/txt_header_title_right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/health_sleep_distribute_view_desc_txt"
                style="@style/FontMedium.12sp"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/img_header_right"
                android:background="@drawable/health_distribute_enable_cover_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:scaleType="center"
                android:layout_marginStart="@dimen/dimen_margin_2dp"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
