<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/device_iv_scanning_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/device_scanning"
        android:contentDescription="@null"/>
    <TextView
        android:textSize="@dimen/text_size_14"
        android:textColor="@color/text_color_40"
        android:id="@+id/device_tv_scanning_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/dimen_margin_20dp"
        android:layout_marginEnd="@dimen/dimen_margin_20dp"/>
    <TextView
        android:textSize="@dimen/text_size_12"
        android:textColor="@color/colorPrimary"
        android:layout_gravity="end"
        android:id="@+id/device_tv_scanning_retry"
        android:background="@drawable/shape_btn_bg_ff612e"
        android:paddingTop="@dimen/dimen_margin_8dp"
        android:paddingBottom="@dimen/dimen_margin_8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/device_search_retry"
        android:paddingStart="@dimen/dimen_margin_16dp"
        android:paddingEnd="@dimen/dimen_margin_16dp"/>
</merge>
