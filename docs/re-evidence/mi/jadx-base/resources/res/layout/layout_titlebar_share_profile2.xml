<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rl_profile"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="26sp"
        android:textColor="@color/common_black"
        android:id="@+id/txt_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginStart="@dimen/dimen_margin_10dp"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textSize="@dimen/dimen_13sp"
        android:textColor="@color/black_80_transparent"
        android:id="@+id/txt_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_3dp"
        android:layout_alignParentTop="true"
        android:layout_marginEnd="@dimen/dimen_margin_10dp"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textSize="@dimen/dimen_13sp"
        android:textColor="@color/black_80_transparent"
        android:id="@+id/txt_desc2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/txt_desc"
        android:layout_marginEnd="@dimen/dimen_margin_10dp"
        android:layout_alignParentEnd="true"/>
    <ImageView
        android:id="@+id/img_avatar"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginTop="50dp"
        android:src="@drawable/main_tab_me_normal"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
