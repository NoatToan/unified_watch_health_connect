<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_15dp"
        android:layout_marginStart="@dimen/chart_common_padding_start"
        android:layout_marginEnd="@dimen/size_30">
        <TextView
            android:textSize="@dimen/text_size_12"
            android:textColor="@color/health_subtitle_text_color_40"
            android:gravity="start"
            android:id="@+id/txtDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            style="@style/FontRegular"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="0dp"
            android:paddingEnd="@dimen/dimen_margin_2dp">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/textGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="yes">
                <TextView
                    android:textSize="@dimen/font_26_7"
                    android:textColor="@color/text_color"
                    android:id="@+id/txtValueHour"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:importantForAccessibility="no"
                    android:paddingHorizontal="@dimen/dimen_margin_3dp"
                    style="@style/FontMedium"/>
                <TextView
                    android:textSize="@dimen/font_13"
                    android:textColor="@color/text_color"
                    android:id="@+id/txtHour"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/unit_hour"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:importantForAccessibility="no"
                    style="@style/FontMedium"/>
                <TextView
                    android:textSize="@dimen/font_26_7"
                    android:textColor="@color/text_color"
                    android:id="@+id/txtValueMin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:importantForAccessibility="no"
                    android:accessibilityTraversalBefore="@+id/txtMin"
                    android:paddingHorizontal="@dimen/dimen_margin_3dp"
                    style="@style/FontMedium"/>
                <TextView
                    android:textSize="@dimen/font_13"
                    android:textColor="@color/text_color"
                    android:id="@+id/txtMin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/unit_min"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:importantForAccessibility="no"
                    style="@style/FontMedium"/>
            </LinearLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/title_choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_margin_9dp"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
