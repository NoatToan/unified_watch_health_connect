<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/top_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/dimen_14sp"
            android:textColor="@color/health_home_txt_color"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/unitStrView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:drawablePadding="2dp"
            android:fontFamily="@font/misanslatin_medium"
            android:textDirection="locale"
            android:layout_marginStart="2dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="@dimen/dimen_24sp"
        android:textColor="@color/health_home_txt_color"
        android:gravity="center_vertical"
        android:id="@+id/valueView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:includeFontPadding="false"
        android:fontFamily="@font/misanslatin_semibold"
        app:layout_constraintStart_toStartOf="@+id/top_line"
        app:layout_constraintTop_toBottomOf="@+id/top_line"/>
    <TextView
        android:textColor="@color/health_home_target_unit"
        android:id="@+id/tagertView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        app:layout_constraintStart_toStartOf="@+id/top_line"
        app:layout_constraintTop_toBottomOf="@+id/valueView"
        style="@style/FontDemiBold.12sp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
