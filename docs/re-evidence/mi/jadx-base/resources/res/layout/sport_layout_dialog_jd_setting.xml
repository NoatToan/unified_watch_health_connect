<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/sport_layout_dialog_jd_setting_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/dismiss"
        android:layout_width="@dimen/dimen_margin_32dp"
        android:layout_height="@dimen/dimen_margin_32dp"
        android:src="@drawable/shortcut_delete"
        android:layout_marginEnd="@dimen/dimen_margin_12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/sport_jd_common_text_color"
        android:id="@+id/setting_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_8dp"
        android:text="@string/sport_jd_setting_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dismiss"
        style="@style/FontMedium.22sp"/>
    <TextView
        android:textSize="@dimen/dimen_18sp"
        android:textColor="@color/sport_jd_common_text_color"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sport_jd_setting_vibrate"
        android:layout_marginStart="@dimen/dimen_margin_36dp"
        app:layout_constraintBottom_toBottomOf="@+id/vibrate_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/vibrate_button"/>
    <com.xiaomi.fitness.widget.button.SwitchButton
        android:id="@+id/vibrate_button"
        android:tag="binding_1"
        android:layout_width="@dimen/lib_sb_width"
        android:layout_height="@dimen/lib_sb_height"
        android:layout_marginTop="34dp"
        android:layout_marginEnd="@dimen/dimen_margin_36dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/setting_title"/>
    <TextView
        android:textSize="@dimen/dimen_18sp"
        android:textColor="@color/sport_jd_common_text_color"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sport_jd_setting_slide_mirror"
        android:layout_marginStart="@dimen/dimen_margin_36dp"
        app:layout_constraintBottom_toBottomOf="@+id/slide_mirror_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/slide_mirror_button"/>
    <com.xiaomi.fitness.widget.button.SwitchButton
        android:id="@+id/slide_mirror_button"
        android:tag="binding_2"
        android:layout_width="@dimen/lib_sb_width"
        android:layout_height="@dimen/lib_sb_height"
        android:layout_marginTop="@dimen/dimen_margin_28dp"
        android:layout_marginEnd="@dimen/dimen_margin_36dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vibrate_button"/>
    <CheckBox
        android:id="@+id/slide_button"
        android:tag="binding_3"
        android:background="@drawable/selector_checkbox"
        android:layout_width="@dimen/dimen_margin_32dp"
        android:layout_height="@dimen/dimen_margin_32dp"
        android:layout_marginTop="@dimen/dimen_margin_26dp"
        android:button="@null"
        android:layout_marginStart="@dimen/dimen_margin_36dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/slide_mirror_button"/>
    <TextView
        android:textSize="@dimen/dimen_18sp"
        android:textColor="@color/sport_jd_common_text_color"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sport_jd_setting_slide"
        android:layout_marginStart="@dimen/dimen_margin_6dp"
        app:layout_constraintBottom_toBottomOf="@+id/slide_button"
        app:layout_constraintStart_toEndOf="@+id/slide_button"
        app:layout_constraintTop_toTopOf="@+id/slide_button"/>
    <CheckBox
        android:id="@+id/virtual_button"
        android:tag="binding_4"
        android:background="@drawable/selector_checkbox"
        android:layout_width="@dimen/dimen_margin_32dp"
        android:layout_height="@dimen/dimen_margin_32dp"
        android:layout_marginTop="@dimen/dimen_margin_26dp"
        android:button="@null"
        android:layout_marginEnd="@dimen/dimen_margin_6dp"
        app:layout_constraintEnd_toStartOf="@+id/virtual_text"
        app:layout_constraintTop_toBottomOf="@+id/slide_mirror_button"/>
    <TextView
        android:textSize="@dimen/dimen_18sp"
        android:textColor="@color/sport_jd_common_text_color"
        android:id="@+id/virtual_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sport_jd_setting_button"
        android:layout_marginEnd="@dimen/dimen_margin_36dp"
        app:layout_constraintBottom_toBottomOf="@+id/virtual_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/virtual_button"/>
    <TextView
        android:textSize="20sp"
        android:textColor="@color/sport_jd_common_text_color"
        android:id="@+id/disconnect"
        android:background="@drawable/shape_sport_jd_start_game_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="64dp"
        android:layout_marginBottom="@dimen/dimen_margin_16dp"
        android:text="@string/sport_jd_setting_disconnect"
        android:paddingHorizontal="48dp"
        android:paddingVertical="@dimen/dimen_margin_16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/virtual_button"/>
</androidx.constraintlayout.widget.ConstraintLayout>
