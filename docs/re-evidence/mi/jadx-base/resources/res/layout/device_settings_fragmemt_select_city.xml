<?xml version="1.0" encoding="utf-8"?>
<miuix.springback.view.SpringBackLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/device_settings_fragmemt_select_city_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:scrollableView="@+id/scrollview">
    <miuix.core.widget.NestedScrollView
        android:id="@+id/scrollview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <miuix.androidbasewidget.widget.EditText
                android:textSize="14sp"
                android:textColor="@color/switch_black"
                android:textColorHint="@color/edit_hint_color"
                android:gravity="center_vertical"
                android:id="@+id/selectCityNameView"
                android:background="@drawable/shape_search_bg"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="@dimen/dimen_margin_10dp"
                android:hint="@string/device_settings_weather_search_hint"
                android:drawablePadding="9dp"
                android:inputType="text"
                android:drawableStart="@drawable/ic_search"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
                android:layout_marginEnd="@dimen/page_content_padding_horizontal_large"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/switch_black"
                android:gravity="center_vertical"
                android:id="@+id/autoLocationView"
                android:paddingBottom="5dp"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="@string/device_settings_weather_location_by_auto"
                android:includeFontPadding="false"
                android:drawablePadding="3dp"
                android:textDirection="locale"
                android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
                app:drawableStartCompat="@drawable/ic_weather_location"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/selectCityNameView"/>
            <miuix.recyclerview.widget.RecyclerView
                android:id="@+id/cityListView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/autoLocationView"/>
            <com.xiaomi.fitness.devicesettings.widget.SideBar
                android:id="@+id/sidebar"
                android:visibility="gone"
                android:layout_width="30dp"
                android:layout_height="match_parent"
                app:layout_constraintEnd_toEndOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </miuix.core.widget.NestedScrollView>
</miuix.springback.view.SpringBackLayout>
