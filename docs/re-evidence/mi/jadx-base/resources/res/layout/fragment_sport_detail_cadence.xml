<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/fragment_sport_detail_cadence_0"
    android:paddingBottom="@dimen/dimen_margin_3dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.xiaomi.fitness.widget.view.DataTitleSimpleView
        android:id="@+id/dataSimpleTitleView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/itemViewContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_margin_20dp">
        <com.xiaomi.fitness.baseui.widget.SportDetailItemView
            android:id="@+id/detailItemView1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:itemGravity="0"
            app:itemHeight="100dp"
            app:txtNameColor="@color/text_color"
            app:txtNameSize="@dimen/font_10"
            app:txtValueColor="@color/eco_bicycle_cadence_color"
            app:txtValueFont="@font/misanslatin_demibold"
            app:txtValueSize="@dimen/dimen_26sp"/>
        <com.xiaomi.fitness.baseui.widget.SportDetailItemView
            android:id="@+id/detailItemView2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:itemGravity="0"
            app:itemHeight="100dp"
            app:txtNameColor="@color/text_color"
            app:txtNameSize="@dimen/font_10"
            app:txtValueColor="@color/eco_bicycle_cadence_color"
            app:txtValueFont="@font/misanslatin_demibold"
            app:txtValueSize="@dimen/dimen_26sp"/>
    </LinearLayout>
    <com.xiaomi.fitness.chart.mpchart.linechart.CustomLineChart
        android:id="@+id/chart"
        android:layout_width="match_parent"
        android:layout_height="@dimen/custom_chart_height_245dp"
        android:layout_marginTop="2dp"
        app:enableDrawCircle="true"
        app:enableMaxCircle="false"
        app:enableMaxPoup="false"
        app:enableSportYAxisLabel="true"
        app:enableTimeXAxisLabel="true"
        app:enableXAxisGridLine="false"
        app:enableYAxisGridLine="true"
        app:limitTextColor="@color/sport_step_color"
        app:lineColor="@color/common_transparent"
        app:lineFillColor="@color/sport_step_light_color"
        app:lineFillRes="@drawable/sport_fill_step"
        app:lineStrokeWidth="@integer/sport_chart_line_width"
        app:maxYAxisRatio="0.2"
        app:minYAxisZero="false"
        app:sportYAxisLabelType="0"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_margin_18dp"
        android:layout_marginEnd="@dimen/dimen_margin_18dp"/>
</LinearLayout>
