<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/card_item_rootview"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/card_set_left_img"
        android:background="@drawable/mine_default_icon"
        android:layout_width="@dimen/mine_margin_30dp"
        android:layout_height="@dimen/mine_margin_30dp"
        android:layout_marginTop="@dimen/dimen_margin_15dp"
        android:layout_marginBottom="@dimen/dimen_margin_15dp"
        android:layout_marginStart="@dimen/dimen_margin_18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_margin_16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/card_set_left_img"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/dimen_14sp"
            android:textStyle="bold"
            android:textColor="@color/mine_black"
            android:id="@+id/card_set_name_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mine_weekly_report"/>
        <TextView
            android:textSize="@dimen/dimen_12sp"
            android:textColor="@color/mine_black_40"
            android:id="@+id/card_set_sub_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mine_weekly_report"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/mine_black_40"
        android:id="@+id/card_set_des_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        app:layout_constraintBottom_toBottomOf="@+id/card_set_end_img"
        app:layout_constraintEnd_toStartOf="@+id/card_set_end_img"
        app:layout_constraintTop_toTopOf="@+id/card_set_end_img"/>
    <ImageView
        android:id="@+id/card_set_end_img"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_base_right_arrow_icon"
        android:layout_marginEnd="@dimen/mine_margin_30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
