<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/shape_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/page_content_padding_horizontal_large">
        <TextView
            android:textSize="12sp"
            android:gravity="center_vertical"
            android:id="@+id/set_title"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:text="@string/sport_common_set_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.xiaomi.fitness.widget.RightArrowTwoLineTextView
            android:id="@+id/backgroundPermissionsHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/set_title"
            app:showRemind="false"
            app:subtitle=""
            app:title="@string/sport_bg_permissions"/>
        <com.xiaomi.fitness.widget.RightArrowTwoLineTextView
            android:id="@+id/cadenceMetro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/backgroundPermissionsHint"
            app:showRemind="true"
            app:title="@string/sport_metronome"/>
        <com.xiaomi.fitness.widget.SwitchButtonTwoLineTextView
            android:id="@+id/lock_screen_on_section"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cadenceMetro"
            app:subtitle="@string/sport_lock_screen_not_show_data"
            app:title="@string/sport_lock_screen_switch"/>
        <com.xiaomi.fitness.widget.SwitchButtonTwoLineTextView
            android:id="@+id/screen_on"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/lock_screen_on_section"
            app:title="@string/sport_screen_on"/>
        <com.xiaomi.fitness.widget.SwitchButtonTwoLineTextView
            android:id="@+id/autoPause"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/screen_on"
            app:title="@string/sport_auto_pause"/>
        <com.xiaomi.fitness.widget.SwitchButtonTwoLineTextView
            android:id="@+id/basicVoiceRemind"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/autoPause"
            app:title="@string/sport_voice_broadcast"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/voiceRemindContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_10sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/basicVoiceRemind">
            <com.xiaomi.fitness.widget.SwitchButtonTwoLineTextView
                android:id="@+id/whole_km"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:title="@string/sport_whole_kilo"/>
            <com.xiaomi.fitness.widget.RightArrowTwoLineTextView
                android:id="@+id/paceRemind"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/whole_km"
                app:showRemind="true"
                app:subtitle="@string/sport_pace_reminder_info"
                app:title="@string/sport_data_pace"/>
            <com.xiaomi.fitness.widget.RightArrowTwoLineTextView
                android:id="@+id/speedRemind"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/whole_km"
                app:showRemind="true"
                app:subtitle="@string/sport_speed_reminder_info"
                app:title="@string/sport_speed_remind_detail_alert"/>
            <com.xiaomi.fitness.widget.RightArrowTwoLineTextView
                android:id="@+id/hrRemind"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="parent"
                app:subtitle="@string/sport_hert_rate_remind_desc"
                app:title="@string/sport_setting_hert_rate_remind_tip"/>
            <com.xiaomi.fitness.sport.baseui.RightSelectView
                android:id="@+id/max_hr"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="53dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/hr_change"
                app:rightDetailTextColor="@color/text_color"
                app:rightSelectedDisplayColor="@color/text_color"
                app:rightSelecttitle="string/hr_reminder"
                app:rightTitleTextColor="@color/text_color"/>
        </LinearLayout>
        <View
            android:id="@+id/line"
            android:background="@color/black_10_transparent"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="20dp"
            android:layout_marginStart="@dimen/dimen_margin_23dp"
            android:layout_marginEnd="@dimen/dimen_margin_23dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/voiceRemindContainer"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
