<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/shape_card_bg_normal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/dimen_margin_12dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:id="@+id/username_update_time_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_margin_16dp"
        android:layout_marginVertical="@dimen/dimen_margin_20dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/small_red_dot"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/relative_avatar"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textColor="@color/selector_feature_item_title_text_color"
            android:ellipsize="end"
            android:id="@+id/relative_username"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:singleLine="true"
            android:drawablePadding="@dimen/dimen_margin_4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/FontMedium.16sp"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/relative_username">
            <TextView
                android:textColor="@color/selector_feature_item_subtitle_text_color"
                android:id="@+id/update_description"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:singleLine="true"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/data_exception_tv"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/FontRegular.12sp"/>
            <TextView
                android:textColor="#f22424"
                android:id="@+id/data_exception_tv"
                android:background="#1af22424"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/relative_care_data_exception"
                android:layout_marginStart="@dimen/dimen_margin_6dp"
                android:paddingHorizontal="@dimen/dimen_margin_3dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.xiaomi.fitness.widget.view.RoundImageView
        android:id="@+id/relative_avatar"
        android:layout_width="@dimen/dimen_margin_40dp"
        android:layout_height="@dimen/dimen_margin_40dp"
        android:importantForAccessibility="no"
        android:layout_marginStart="@dimen/dimen_margin_18dp"
        app:innerStrokeWidth="@dimen/dimen_margin_1dp"
        app:layout_constraintBottom_toBottomOf="@+id/username_update_time_group"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/username_update_time_group"/>
    <ImageView
        android:id="@+id/small_red_dot"
        android:background="@drawable/icon_feature_item_remind"
        android:layout_width="@dimen/feature_item_remind_dot_size"
        android:layout_height="@dimen/feature_item_remind_dot_size"
        android:maxWidth="117dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/right_arrow"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/right_arrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_base_right_arrow_icon"
        android:importantForAccessibility="no"
        android:layout_marginEnd="@dimen/dimen_margin_18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
