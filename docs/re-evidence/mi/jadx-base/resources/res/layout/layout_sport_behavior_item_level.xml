<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="@color/text_color"
        android:gravity="center"
        android:id="@+id/txt_behavior_title"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_alignParentTop="true"
        android:layout_marginStart="20dp"
        style="@style/FontMedium.14sp"/>
    <com.xiaomi.fitness.baseui.widget.LevelBarView
        android:id="@+id/levelBarView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_20dp"
        android:layout_below="@+id/txt_behavior_title"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_below="@+id/levelBarView"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="25dp"/>
    <View
        android:id="@+id/divider_bottom"
        android:background="@color/divider_line_color"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginTop="19dp"
        android:layout_below="@+id/constraintContainer"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/dimen_margin_18dp"
        android:layout_marginEnd="@dimen/dimen_margin_18dp"/>
</RelativeLayout>
