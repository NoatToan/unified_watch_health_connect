<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/medal_activity_list_0"
    android:background="@color/medal_dialog_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/page_content_padding_horizontal_large">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/back"
            android:background="@drawable/ic_back_white"
            android:layout_width="@dimen/dimen_round_33.33dp"
            android:layout_height="@dimen/dimen_round_33.33dp"
            android:contentDescription="@string/back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textColor="#ff612e"
            android:id="@+id/medal_wall_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/medal_wall"
            android:drawablePadding="4dp"
            android:contentDescription="@string/medal_wall"
            android:drawableStart="@drawable/medal_wall_entrance"
            app:layout_constraintBottom_toBottomOf="@+id/back"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/back"
            style="@style/FontMedium.16sp"/>
        <TextView
            android:textSize="29.3sp"
            android:textColor="#e5ffffff"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_13dp"
            android:text="@string/medal_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/back"
            style="@style/FontRegular"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_bar"/>
    <RelativeLayout
        android:id="@+id/no_network"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/no_network_icon"
            android:background="@drawable/medal_icon_no_network"
            android:layout_width="93.3dp"
            android:layout_height="60dp"
            android:layout_centerHorizontal="true"
            android:contentDescription="@string/medal_network_connection_failed_tip"/>
        <TextView
            android:textColor="#8b8b8b"
            android:id="@+id/no_network_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_10dp"
            android:text="@string/medal_network_connection_failed_tip"
            android:layout_below="@+id/no_network_icon"
            android:layout_centerHorizontal="true"
            style="@style/FontRegular.14sp"/>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
