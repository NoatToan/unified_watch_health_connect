<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_sleep_model_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
    android:layout_marginEnd="@dimen/page_content_padding_horizontal_large">
    <TextView
        android:textSize="@dimen/dialog_text_size_16"
        android:textColor="@color/text_color"
        android:id="@+id/sleep_model_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="21dp"
        android:text="@string/device_settings_sleep_model_desc"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/dialog_text_size_14"
        android:id="@+id/sleep_model_tips"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_3dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sleep_model_desc"/>
    <View
        android:id="@+id/divide_line"
        android:background="@drawable/device_settings_layer_divider_line"
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider_height"
        android:layout_marginTop="@dimen/dimen_margin_20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sleep_model_tips"/>
    <com.xiaomi.fitness.widget.SwitchButtonBindingTwoLineTextView
        android:id="@+id/sync_system_schedule_view"
        android:tag="binding_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divide_line"
        app:title="@string/device_settings_sync_system_schedule"/>
    <com.xiaomi.fitness.widget.SwitchButtonBindingTwoLineTextView
        android:id="@+id/customize_schedule_view"
        android:tag="binding_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divide_line"
        app:title="@string/device_settings_customize_schedule"/>
    <com.xiaomi.fitness.widget.RightArrowBindingSingleLineTextView
        android:id="@+id/sleep_time_selector"
        android:tag="binding_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/customize_schedule_view"
        app:showRemind="true"
        app:title="@string/device_settings_time_to_sleep"/>
    <com.xiaomi.fitness.widget.RightArrowBindingSingleLineTextView
        android:id="@+id/wake_up_time_selector"
        android:tag="binding_5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sleep_time_selector"
        app:showRemind="true"
        app:title="@string/device_settings_time_to_wake_up"/>
    <com.xiaomi.fitness.widget.SwitchButtonBindingSingleLineTextView
        android:id="@+id/set_alarm_view"
        android:tag="binding_6"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/wake_up_time_selector"
        app:title="@string/device_settings_sleep_model_wake_alarm"/>
</androidx.constraintlayout.widget.ConstraintLayout>
