<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rl_container"
    android:tag="layout/health_layout_expandable_common_header_0"
    android:background="@drawable/shape_card_bg_normal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:animateLayoutChanges="true"
    android:paddingHorizontal="18dp">
    <TextView
        android:textColor="@color/text_color"
        android:id="@+id/tv_group_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:paddingVertical="20.6dp"
        style="@style/FontMedium.14sp"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_arrow"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"
        app:srcCompat="@drawable/health_ic_arrow_down"/>
    <View
        android:id="@+id/divider_line"
        android:background="@color/divider_line_color"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_below="@+id/tv_group_title"
        android:layout_marginHorizontal="8.67dp"/>
</RelativeLayout>
