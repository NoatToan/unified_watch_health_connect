<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="18dp">
    <TextView
        android:textSize="18sp"
        android:textColor="@color/text_color"
        android:id="@+id/typeView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        style="@style/FontMedium"/>
    <com.xiaomi.fitness.chart.view.BarChartRecyclerView
        android:id="@+id/bar_recycler"
        android:paddingTop="12dp"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="12dp"
        android:paddingEnd="@dimen/dimen_margin_32dp"
        app:barBottomColor="#b699ff"
        app:barChartMaxWidth="@dimen/size_10"
        app:barChartRoundRectRadiusRatio="0.25"
        app:barTopColor="#5560ff"
        app:chartEdgeColor="@color/health_white_black"
        app:displayNumbers="6"
        app:enableStartYAxisLabel="false"/>
</LinearLayout>
