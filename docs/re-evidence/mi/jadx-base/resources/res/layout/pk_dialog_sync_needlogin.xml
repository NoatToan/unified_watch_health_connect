<?xml version="1.0" encoding="utf-8"?>
<miuix.springback.view.SpringBackLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:scrollableView="@+id/spring_back_target">
    <miuix.core.widget.NestedScrollView
        android:id="@+id/spring_back_target"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16.66sp"
                android:textColor="@color/text_color"
                android:gravity="center"
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pk_open_sport_health_cloud_sync"
                android:layout_marginStart="@dimen/dimen_margin_26dp"
                android:layout_marginEnd="@dimen/dimen_margin_26dp"
                style="@style/FontMedium"/>
            <TextView
                android:textColor="@color/text_color_80"
                android:id="@+id/desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_16dp"
                android:text="@string/pk_sync_needlogin_desc"
                android:layout_marginStart="@dimen/dimen_margin_40dp"
                android:layout_marginEnd="@dimen/dimen_margin_40dp"
                style="@style/FontRegular.16sp"/>
            <TextView
                android:textSize="@dimen/dimen_15sp"
                android:textColor="@color/text_color"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/dimen_margin_16dp"
                android:text="@string/pk_sync_dialog_title1"
                android:layout_marginStart="@dimen/dimen_margin_40dp"
                android:layout_marginEnd="@dimen/dimen_margin_40dp"
                style="@style/FontMedium"/>
            <TextView
                android:textSize="@dimen/dimen_13sp"
                android:textColor="@color/text_color"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/pk_sync_dialog_desc1"
                android:layout_marginStart="@dimen/dimen_margin_40dp"
                android:layout_marginEnd="@dimen/dimen_margin_40dp"
                style="@style/FontRegular"/>
            <TextView
                android:textSize="@dimen/dimen_15sp"
                android:textColor="@color/text_color"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/dimen_margin_16dp"
                android:text="@string/pk_sync_dialog_title2"
                android:layout_marginStart="@dimen/dimen_margin_40dp"
                android:layout_marginEnd="@dimen/dimen_margin_40dp"
                style="@style/FontMedium"/>
            <TextView
                android:textSize="@dimen/dimen_13sp"
                android:textColor="@color/text_color"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/pk_sync_dialog_desc2"
                android:layout_marginStart="@dimen/dimen_margin_40dp"
                android:layout_marginEnd="@dimen/dimen_margin_40dp"
                style="@style/FontRegular"/>
            <TextView
                android:textSize="@dimen/dimen_15sp"
                android:textColor="@color/text_color"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/dimen_margin_16dp"
                android:text="@string/pk_sync_dialog_title3"
                android:layout_marginStart="@dimen/dimen_margin_40dp"
                android:layout_marginEnd="@dimen/dimen_margin_40dp"
                style="@style/FontMedium"/>
            <TextView
                android:textSize="@dimen/dimen_13sp"
                android:textColor="@color/text_color"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/pk_sync_dialog_desc3"
                android:layout_marginStart="@dimen/dimen_margin_40dp"
                android:layout_marginEnd="@dimen/dimen_margin_40dp"
                style="@style/FontRegular"/>
            <TextView
                android:textSize="@dimen/dimen_15sp"
                android:textColor="@color/text_color"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/dimen_margin_16dp"
                android:text="@string/pk_sync_dialog_title4"
                android:layout_marginStart="@dimen/dimen_margin_40dp"
                android:layout_marginEnd="@dimen/dimen_margin_40dp"
                style="@style/FontMedium"/>
            <TextView
                android:textSize="@dimen/dimen_13sp"
                android:textColor="@color/text_color"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/pk_sync_dialog_desc4"
                android:layout_marginStart="@dimen/dimen_margin_40dp"
                android:layout_marginEnd="@dimen/dimen_margin_40dp"
                style="@style/FontRegular"/>
        </LinearLayout>
    </miuix.core.widget.NestedScrollView>
</miuix.springback.view.SpringBackLayout>
