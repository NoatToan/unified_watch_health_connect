<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/device_settings_music_settings_fragment_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_28dp"
        android:minHeight="@dimen/size_53_3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/back_iv"
            android:background="@drawable/ic_left_back_black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_margin_16dp"/>
        <TextView
            android:textSize="@dimen/dimen_20sp"
            android:textColor="@color/text_color"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/toolbar_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/device_settings_music_settings_title"
            style="@style/devicesettings.Title"/>
        <androidx.appcompat.widget.AppCompatImageButton
            android:layout_gravity="end"
            android:id="@+id/music_settings_add_song_list"
            android:background="@drawable/device_settings_music_settings_add_song_list_ic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dimen_margin_20dp"/>
        <androidx.appcompat.widget.AppCompatImageButton
            android:layout_gravity="end"
            android:id="@+id/music_settings_pull_song"
            android:background="@drawable/device_settings_music_settings_pull_song_ic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dimen_margin_20dp"/>
    </androidx.appcompat.widget.Toolbar>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nested_scroll_view"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintVertical_bias="0">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.cardview.widget.CardView
                android:id="@+id/headView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_5dp"
                android:foreground="@null"
                android:layout_marginHorizontal="@dimen/page_padding_horizontal_large"
                app:cardBackgroundColor="@color/card_view_background"
                app:cardCornerRadius="@dimen/dimen_margin_10dp"
                app:cardElevation="@dimen/dimen_margin_2dp">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/deviceStorageView"
                    android:background="@drawable/device_settings_music_settings_device_storage_bg"
                    android:padding="@dimen/dimen_margin_16dp"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/device_icon"
                        android:layout_width="62dp"
                        android:layout_height="62dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/text_size_14"
                        android:textColor="@color/text_color"
                        android:id="@+id/media_music_settings_device_storage_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/device_settings_music_settings_device_storage_title"
                        app:layout_constraintStart_toEndOf="@+id/device_icon"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/text_size_14"
                        android:textColor="@color/text_color_40"
                        android:id="@+id/device_storage_info_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimen_margin_5dp"
                        android:textDirection="locale"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/device_icon"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <miuix.androidbasewidget.widget.ProgressBar
                        android:id="@+id/media_music_settings_device_storage_progress"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimen_margin_7dp"
                        android:progressDrawable="@drawable/device_settings_music_settings_device_storage_progress_bg"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/device_icon"
                        style="@style/ProgressDialog"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <RelativeLayout
                    android:id="@+id/musicPushProgressView"
                    android:background="@drawable/device_settings_music_settings_device_storage_bg"
                    android:padding="@dimen/dimen_margin_16dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/text_size_14"
                        android:textColor="@color/text_color"
                        android:ellipsize="end"
                        android:id="@+id/pushTitleView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxWidth="165dp"
                        android:text="@string/device_settings_music_pushing"
                        android:singleLine="true"
                        android:layout_toStartOf="@+id/pushStateView"
                        android:layout_alignParentStart="true"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/text_size_14"
                        android:textStyle="bold"
                        android:textColor="@color/colorPrimary"
                        android:id="@+id/pushStateView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignTop="@+id/pushTitleView"
                        android:layout_marginEnd="20dp"
                        android:layout_toStartOf="@+id/cancelView"/>
                    <miuix.androidbasewidget.widget.ProgressBar
                        android:id="@+id/pushProgressView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:progressDrawable="@drawable/device_settings_music_settings_device_storage_progress_bg"
                        android:layout_below="@+id/pushTitleView"
                        android:layout_alignEnd="@+id/pushStateView"
                        style="@style/ProgressDialog"/>
                    <TextView
                        android:textSize="@dimen/text_size_14"
                        android:textColor="@color/text_color_40"
                        android:ellipsize="end"
                        android:id="@+id/pushNameView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:maxWidth="150dp"
                        android:singleLine="true"
                        android:layout_below="@+id/pushProgressView"
                        android:layout_marginEnd="3dp"
                        android:layout_toStartOf="@+id/progressTxtView"/>
                    <TextView
                        android:textSize="@dimen/text_size_14"
                        android:textColor="@color/text_color_40"
                        android:id="@+id/progressTxtView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignTop="@+id/pushNameView"
                        android:layout_alignEnd="@+id/pushStateView"/>
                    <TextView
                        android:textStyle="bold"
                        android:id="@+id/cancelView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/dimen_margin_0dp"
                        android:text="@string/cancel"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="0dp"
                        android:layout_marginEnd="0dp"
                        android:layout_alignParentEnd="true"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp"
                        style="@style/CommonBtn.Normal"/>
                </RelativeLayout>
            </androidx.cardview.widget.CardView>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="vertical"
                android:id="@+id/content_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/size_12"
                    android:textColor="@color/text_color_40"
                    android:id="@+id/device_settings_music_settings_my_song_list"
                    android:paddingTop="@dimen/dimen_margin_8dp"
                    android:paddingBottom="@dimen/dimen_margin_8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_margin_20dp"
                    android:text="@string/device_settings_music_settings_my_song_list"
                    android:paddingStart="@dimen/page_content_padding_horizontal_large"
                    android:paddingEnd="@dimen/page_content_padding_horizontal_large"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/song_list_rv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
                <com.xiaomi.fitness.widget.view.DividerView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_margin_20dp"
                    android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
                    android:layout_marginEnd="@dimen/page_content_padding_horizontal_large"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/size_12"
                    android:textColor="@color/text_color_40"
                    android:id="@+id/device_settings_music_settings_my_song"
                    android:paddingTop="@dimen/dimen_margin_8dp"
                    android:paddingBottom="@dimen/dimen_margin_8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_margin_20dp"
                    android:text="@string/device_settings_music_settings_my_song"
                    android:paddingStart="@dimen/page_content_padding_horizontal_large"
                    android:paddingEnd="@dimen/page_content_padding_horizontal_large"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/song_rv"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/empty_view"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_constraintVertical_bias="0">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/icon_common_empty"
                    android:background="@drawable/icon_common_empty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/text_size_14"
                    android:textColor="@color/text_color_40"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_margin_5dp"
                    android:text="@string/device_settings_music_empty_remind"
                    app:layout_constraintEnd_toEndOf="@+id/icon_common_empty"
                    app:layout_constraintStart_toStartOf="@+id/icon_common_empty"
                    app:layout_constraintTop_toBottomOf="@+id/icon_common_empty"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
