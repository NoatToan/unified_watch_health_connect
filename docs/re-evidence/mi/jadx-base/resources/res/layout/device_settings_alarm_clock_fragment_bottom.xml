<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/alarm_clock_bottom_view"
    android:tag="layout/device_settings_alarm_clock_fragment_bottom_0"
    android:background="@color/text_revert_color"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/alarm_clock_editLinear"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.xiaomi.fitness.widget.view.DividerView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/text_color"
            android:gravity="center"
            android:layout_gravity="bottom"
            android:id="@+id/alarm_clock_delete_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="15dp"
            android:text="@string/common_delete"
            android:drawableTop="@drawable/ic_delete_bottom"
            android:drawablePadding="2dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            style="@style/FontRegular"/>
    </LinearLayout>
    <TextView
        android:id="@+id/alarm_clock_add_tv"
        android:text="@string/device_settings_alarm_add"
        style="@style/CommonBtn.Primary"/>
</FrameLayout>
