<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/layout_face_entrance_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/backgroundView"
        android:background="@drawable/selector_face_entrance"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.xiaomi.fitness.widget.view.RatioImageView
        android:id="@+id/bannerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="@+id/backgroundView"
        app:layout_constraintStart_toStartOf="@+id/backgroundView"
        app:ratio="2.37"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/titleGroup"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="titleView,divider,arrow"/>
    <TextView
        android:textSize="22sp"
        android:textColor="#ff000000"
        android:id="@+id/titleView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/face_manager_band"
        android:layout_marginStart="25dp"
        app:layout_constraintBottom_toTopOf="@+id/divider"
        app:layout_constraintStart_toStartOf="@+id/backgroundView"
        app:layout_constraintTop_toTopOf="@+id/backgroundView"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintWidth_max="wrap"
        app:layout_constraintWidth_percent="0.36"/>
    <ImageView
        android:id="@+id/arrow"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="@drawable/face_icon_more_fit_rtl"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/titleView"
        app:layout_constraintStart_toEndOf="@+id/titleView"
        app:layout_constraintTop_toTopOf="@+id/titleView"/>
    <View
        android:id="@+id/divider"
        android:background="#ff000000"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="3dp"
        app:layout_constraintBottom_toTopOf="@+id/draftView"
        app:layout_constraintEnd_toEndOf="@+id/arrow"
        app:layout_constraintStart_toStartOf="@+id/titleView"
        app:layout_constraintTop_toBottomOf="@+id/titleView"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#ff000000"
        android:ellipsize="end"
        android:id="@+id/draftView"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:maxLines="3"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/backgroundView"
        app:layout_constraintEnd_toStartOf="@+id/face_container"
        app:layout_constraintStart_toStartOf="@+id/titleView"
        app:layout_constraintTop_toBottomOf="@+id/divider"/>
    <FrameLayout
        android:id="@+id/face_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/backgroundView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/backgroundView">
        <com.xiaomi.fitness.watch.face.view.FaceImageView
            android:id="@+id/imgView"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:layout_marginEnd="26dp"/>
        <com.xiaomi.fitness.watch.face.view.FaceImageView
            android:id="@+id/styleView"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:layout_marginEnd="26dp"/>
        <ImageView
            android:id="@+id/smallBanner"
            android:layout_width="130dp"
            android:layout_height="130dp"
            android:layout_marginEnd="10dp"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
