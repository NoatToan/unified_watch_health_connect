<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/face_layout_detail_header_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/outlineView"
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:layout_marginTop="@dimen/dimen_margin_8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.xiaomi.fitness.watch.face.edit.ui.FaceEditPreviewView
        android:id="@+id/mImageView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/outlineView"
        app:layout_constraintEnd_toEndOf="@+id/outlineView"
        app:layout_constraintStart_toStartOf="@+id/outlineView"
        app:layout_constraintTop_toTopOf="@+id/outlineView"/>
    <com.xiaomi.fitness.watch.face.edit.ui.FaceEditPreviewView
        android:id="@+id/styleView"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/outlineView"
        app:layout_constraintEnd_toEndOf="@+id/outlineView"
        app:layout_constraintStart_toStartOf="@+id/outlineView"
        app:layout_constraintTop_toTopOf="@+id/outlineView"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bullet_screen"
        android:background="@drawable/face_bg_bullet_screen"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_margin_23dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:textSize="@dimen/dimen_11sp"
            android:id="@+id/user_icon"
            android:layout_width="@dimen/dimen_margin_25dp"
            android:layout_height="@dimen/dimen_margin_25dp"
            android:layout_marginStart="@dimen/dimen_margin_3dp"
            android:layout_marginVertical="@dimen/dimen_margin_3dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:id="@+id/user_behaviour"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_margin_5dp"
            android:layout_marginEnd="@dimen/dimen_margin_10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/user_icon"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/aod_switch"
        android:tag="binding_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/face_edit_aod_preview"
        android:paddingHorizontal="@dimen/dimen_margin_13dp"
        android:paddingVertical="@dimen/dimen_margin_16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/outlineView"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/icon_list"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
        app:layout_constraintTop_toBottomOf="@+id/aod_switch"/>
</androidx.constraintlayout.widget.ConstraintLayout>
