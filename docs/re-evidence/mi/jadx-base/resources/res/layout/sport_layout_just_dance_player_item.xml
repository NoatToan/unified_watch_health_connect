<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/sport_layout_just_dance_player_item_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/avatar"
        android:tag="binding_1"
        android:background="@drawable/sport_bg_jd_user_icon"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:scaleType="centerInside"
        android:layout_marginStart="@dimen/dimen_margin_36dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/dimen_24sp"
        android:id="@+id/name"
        android:tag="binding_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_margin_12dp"
        app:layout_constraintStart_toEndOf="@+id/avatar"
        app:layout_constraintTop_toTopOf="@+id/avatar"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/sport_jd_common_text_color"
        android:id="@+id/alias"
        android:tag="binding_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@+id/name"
        app:layout_constraintTop_toBottomOf="@+id/name"/>
    <View
        android:id="@+id/score_line"
        android:tag="binding_4"
        android:layout_width="2dp"
        android:layout_height="20sp"
        android:layout_marginVertical="@dimen/margin_5dp"
        app:layout_constraintBottom_toBottomOf="@+id/score"
        app:layout_constraintStart_toStartOf="@+id/name"
        app:layout_constraintTop_toBottomOf="@+id/alias"
        app:layout_constraintTop_toTopOf="@+id/score"/>
    <TextView
        android:textSize="@dimen/dimen_20sp"
        android:id="@+id/score"
        android:tag="binding_5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_6dp"
        android:layout_marginStart="@dimen/dimen_margin_5dp"
        app:layout_constraintStart_toEndOf="@+id/score_line"
        app:layout_constraintTop_toBottomOf="@+id/alias"/>
    <TextView
        android:textSize="24dp"
        android:id="@+id/calories"
        android:tag="binding_6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_14dp"
        app:layout_constraintStart_toStartOf="@+id/calories_unit"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:id="@+id/calories_unit"
        android:tag="binding_7"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:layout_marginEnd="50dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <View
        android:tag="binding_8"
        android:layout_width="1dp"
        android:layout_height="64dp"
        android:layout_marginEnd="@dimen/dimen_margin_12dp"
        android:layout_marginVertical="@dimen/dimen_margin_8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/calories_unit"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
