<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/health_fragment_sleep_phythm_detail_up_to_remote_0"
    android:background="@color/page_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/page_content_padding_horizontal_large"
    android:paddingEnd="@dimen/page_content_padding_horizontal_large">
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/dimen_margin_10dp"
        app:layout_constraintBottom_toTopOf="@+id/agree_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/image"
                android:background="@drawable/health_sleep_rhythm_up_remote_icon"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_marginTop="@dimen/dimen_margin_20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:theme="@style/FontDemiBold.24sp"
                android:textColor="@color/text_color"
                android:id="@+id/up_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/health_sleep_rhythm_up_remote_title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/image"/>
            <TextView
                android:theme="@style/FontDemiBold.14sp"
                android:textColor="@color/text_color"
                android:id="@+id/up_remind"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/health_sleep_rhythm_up_remote_remind"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/up_title"/>
            <com.xiaomi.fitness.widget.view.DividerView
                android:id="@+id/divider_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/up_remind"/>
            <TextView
                android:theme="@style/FontDemiBold.12sp"
                android:textColor="@color/text_color_40"
                android:id="@+id/up_need_info_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:text="@string/health_sleep_rhythm_up_remote_need_know"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/divider_view"/>
            <TextView
                android:theme="@style/FontDemiBold.14sp"
                android:textColor="@color/text_color"
                android:id="@+id/up_need_info_base"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/health_sleep_rhythm_up_remote_basic_info"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/up_need_info_title"/>
            <TextView
                android:theme="@style/FontDemiBold.14sp"
                android:textColor="@color/text_color"
                android:id="@+id/up_need_info_more"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="@string/health_sleep_rhythm_up_remote_more_info"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/up_need_info_base"/>
            <TextView
                android:theme="@style/FontDemiBold.12sp"
                android:textColor="@color/text_color_40"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="50dp"
                android:text="@string/health_sleep_rhythm_up_remote_confirm_des"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/up_need_info_more"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <Button
        android:id="@+id/agree_button"
        android:layout_width="0dp"
        android:layout_height="46dp"
        android:layout_marginBottom="@dimen/margin_5dp"
        android:text="@string/agree"
        app:layout_constraintBottom_toTopOf="@+id/disagree_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/CommonBtn.Primary"/>
    <Button
        android:id="@+id/disagree_button"
        android:layout_width="0dp"
        android:layout_height="46dp"
        android:text="@string/reject"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/CommonBtn.Normal"/>
</androidx.constraintlayout.widget.ConstraintLayout>
