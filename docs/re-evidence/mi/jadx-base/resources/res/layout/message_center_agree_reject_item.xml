<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/message_center_agree_reject_item_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/message_center_horizontal_padding">
    <FrameLayout
        android:id="@+id/fl_avatar"
        android:background="@drawable/message_center_avatar_divider_color"
        android:layout_width="40.3dp"
        android:layout_height="40.3dp"
        android:layout_marginVertical="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.xiaomi.fitness.widget.view.RoundImageView
            android:layout_gravity="center"
            android:id="@+id/iv_avatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_common_avatar_default"/>
    </FrameLayout>
    <TextView
        android:textColor="@color/text_color"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/tv_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="3"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tv_reject"
        app:layout_constraintStart_toEndOf="@+id/fl_avatar"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/FontRegular.14sp"/>
    <TextView
        android:textColor="@color/text_color_80"
        android:layout_gravity="center_vertical"
        android:id="@+id/tv_reject"
        android:background="@drawable/common_btn_gray"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/reject"
        android:maxLines="1"
        android:layout_marginEnd="6dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tv_agree"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/FontMedium.12sp"/>
    <TextView
        android:textColor="@color/selector_common_btn_primary_text_color"
        android:layout_gravity="center_vertical"
        android:id="@+id/tv_agree"
        android:background="@drawable/selector_bottom_button_red"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/agree"
        android:maxLines="1"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/FontMedium.12sp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
