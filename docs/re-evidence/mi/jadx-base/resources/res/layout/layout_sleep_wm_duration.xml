<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/layout_sleep_wm_duration_0"
    android:background="@drawable/shape_data_item_bg"
    android:visibility="visible"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_20"
        android:layout_marginBottom="@dimen/size_13_3"
        layout="@layout/layout_common_icon_title"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp">
        <TextView
            android:textSize="13.3sp"
            android:textColor="@color/text_color"
            android:layout_gravity="bottom"
            android:id="@+id/tv_avg"
            android:paddingBottom="6.7dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/health_sleep_avg"
            style="@style/FontMedium"/>
        <com.xiaomi.fitness.widget.view.DurationTextView
            android:id="@+id/duration_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:dtv_dataFont="@font/misanslatin_medium"
            app:dtv_dataTextColor="@color/text_color"
            app:dtv_dataTextSize="@dimen/font_33_3"
            app:dtv_unitTextColor="@color/text_color"
            app:dtv_unitTextFontFamily="@string/mipro_regular"
            app:dtv_unitTextSize="@dimen/font_16_7"
            app:dtv_unitTextStyle="bold"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="bottom"
            android:id="@+id/iv_explain"
            android:paddingBottom="6.7dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/health_ic_question"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5.3dp">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_chart_interactive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/size_18"
            android:layout_marginEnd="@dimen/size_18">
            <TextView
                android:textSize="11sp"
                android:textColor="#6750f1"
                android:gravity="start"
                android:id="@+id/tv_high_light_tip"
                android:background="@drawable/health_sleep_tip_purple_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="1dp"
                android:paddingHorizontal="@dimen/size_8"
                android:paddingVertical="4.3dp"
                style="@style/FontMedium"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/level_desc_recyclerview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13.3dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_distribute_recycler_parent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </FrameLayout>
</LinearLayout>
