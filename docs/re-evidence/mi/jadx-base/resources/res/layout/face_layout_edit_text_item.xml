<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/face_layout_edit_text_item_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/dimen_margin_8dp">
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/text_color"
        android:id="@+id/week_day"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/edit_text"
        app:layout_constraintEnd_toStartOf="@+id/divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/edit_text"/>
    <View
        android:id="@+id/divider"
        android:background="@color/black_08_transparent"
        android:visibility="gone"
        android:layout_width="1px"
        android:layout_height="16dp"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/week_day"
        app:layout_constraintTop_toTopOf="parent"/>
    <EditText
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/face_market_search_disable"
        android:gravity="center_vertical"
        android:id="@+id/edit_text"
        android:background="@drawable/face_bg_edit_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textCursorDrawable="@drawable/face_shape_search_cursor"
        android:layout_marginEnd="@dimen/dimen_margin_14dp"
        android:paddingHorizontal="@dimen/dimen_margin_12dp"
        android:paddingVertical="11dp"
        app:layout_constraintEnd_toStartOf="@+id/delete_button"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/divider"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="@dimen/dimen_margin_0dp"/>
    <ImageView
        android:id="@+id/drag_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/face_edit_text_item_drag"
        android:layout_marginEnd="@dimen/dimen_margin_12dp"
        app:layout_constraintBottom_toBottomOf="@+id/edit_text"
        app:layout_constraintEnd_toEndOf="@+id/edit_text"
        app:layout_constraintTop_toTopOf="@+id/edit_text"/>
    <ImageView
        android:id="@+id/delete_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/face_edit_text_item_delete"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/more_group"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="drag_button,delete_button"/>
</androidx.constraintlayout.widget.ConstraintLayout>
