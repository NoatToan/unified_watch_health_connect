<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/fragment_hearing_month_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.xiaomi.fitness.chart.view.BarChartRecyclerView
        android:id="@+id/recycler"
        app:barChartRoundRectRadiusRatio="0.25"
        app:chartColor="@color/hearing_chart"
        app:displayNumbers="31"
        app:enableCharValueDisplay="false"
        app:enableStartYAxisLabel="false"
        app:enableXAxisBg="true"
        app:enableXAxisThirdGridLine="false"
        app:xAxisLabelPosition="1"
        app:xAxisScaleDistance="7"
        app:xFirstLinePosition="2"
        style="@style/ChartBaseStyle"/>
</LinearLayout>
