<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bannerMultipleLayout"
    android:tag="layout/banner_multiple_style_layout_0"
    android:paddingBottom="@dimen/dimen_margin_12dp"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="17sp"
        android:textColor="@color/text_color"
        android:gravity="center_vertical"
        android:id="@+id/tvMainTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textDirection="locale"
        app:layout_constraintEnd_toStartOf="@+id/tvShowMore"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/FontDemiBold"/>
    <TextView
        android:textSize="14sp"
        android:gravity="end|center_vertical"
        android:id="@+id/tvShowMore"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxWidth="80dp"
        android:drawableEnd="@drawable/ic_base_right_arrow_icon"
        app:layout_constraintBottom_toBottomOf="@+id/tvMainTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tvMainTitle"
        app:layout_constraintTop_toTopOf="@+id/tvMainTitle"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivBannerFirst"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:scaleType="centerInside"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvMainTitle"
        app:layout_goneMarginTop="0dp"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivBannerSecond"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:scaleType="centerInside"
        app:layout_constraintEnd_toStartOf="@+id/ivBannerThird"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivBannerFirst"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivBannerThird"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:scaleType="centerInside"
        android:layout_marginStart="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/ivBannerSecond"
        app:layout_constraintTop_toBottomOf="@+id/ivBannerFirst"/>
</androidx.constraintlayout.widget.ConstraintLayout>
