<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#ffffff"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textStyle="bold"
        android:gravity="center"
        android:id="@+id/titleBar"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="YRN3 SDK 调试模式"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/catalyst_redbox_background"
        android:id="@+id/remark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:text="@string/yrn_sdk_dev_des"
        android:layout_below="@+id/titleBar"/>
    <TextView
        android:gravity="start|center_vertical"
        android:id="@+id/tvTrace"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_margin="8dp"
        android:minWidth="70dp"
        android:text="打点悬浮:"
        android:layout_below="@+id/remark"/>
    <Switch
        android:id="@+id/switchTrace"
        android:padding="5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:thumb="@drawable/yrn_switch_thumb"
        android:layout_below="@+id/remark"
        android:track="@drawable/yrn_switch_track"
        android:layout_toEndOf="@+id/tvTrace"/>
    <TextView
        android:gravity="start|center_vertical"
        android:id="@+id/tvAppName"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_margin="8dp"
        android:minWidth="70dp"
        android:text="AppName:"
        android:layout_below="@+id/tvTrace"/>
    <Spinner
        android:id="@+id/spAppName"
        android:background="@drawable/yrn_spinner_bg"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_margin="8dp"
        android:layout_below="@+id/tvTrace"
        android:inputType="text"
        android:layout_toEndOf="@+id/tvAppName"/>
    <TextView
        android:gravity="start|center_vertical"
        android:id="@+id/tvEnv"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_margin="8dp"
        android:minWidth="70dp"
        android:text="拉包环境:"
        android:layout_below="@+id/tvAppName"/>
    <Spinner
        android:id="@+id/spEnv"
        android:background="@drawable/yrn_spinner_bg"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_margin="8dp"
        android:layout_below="@+id/tvAppName"
        android:inputType="text"
        android:layout_toEndOf="@+id/tvEnv"/>
    <TextView
        android:gravity="start|center_vertical"
        android:id="@+id/tvRM"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_margin="8dp"
        android:minWidth="70dp"
        android:text="RM按钮显示:"
        android:layout_below="@+id/tvEnv"/>
    <Switch
        android:id="@+id/switchRM"
        android:padding="5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:thumb="@drawable/yrn_switch_thumb"
        android:layout_below="@+id/tvEnv"
        android:track="@drawable/yrn_switch_track"
        android:layout_toEndOf="@+id/tvRM"/>
    <TextView
        android:gravity="start|center_vertical"
        android:id="@+id/tvModule"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_margin="8dp"
        android:minWidth="70dp"
        android:text="Module:"
        android:layout_below="@+id/tvRM"/>
    <EditText
        android:id="@+id/etModule"
        android:background="@drawable/yrn_spinner_bg"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_margin="8dp"
        android:layout_below="@+id/tvRM"
        android:inputType="text"
        android:layout_toEndOf="@+id/tvModule"/>
    <TextView
        android:gravity="start|center_vertical"
        android:id="@+id/tvSwitch"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_margin="8dp"
        android:minWidth="70dp"
        android:text="IP 调试:"
        android:layout_below="@+id/tvModule"/>
    <Switch
        android:id="@+id/switchIP"
        android:padding="5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:thumb="@drawable/yrn_switch_thumb"
        android:layout_below="@+id/tvModule"
        android:track="@drawable/yrn_switch_track"
        android:layout_toEndOf="@+id/tvSwitch"/>
    <TextView
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/btAdd"
        android:background="#ff6699"
        android:layout_width="80dp"
        android:layout_height="34dp"
        android:layout_margin="8dp"
        android:text="添加"
        android:layout_below="@+id/tvModule"
        android:layout_alignParentEnd="true"/>
    <FrameLayout
        android:id="@+id/flContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:layout_below="@+id/switchIP">
        <RelativeLayout
            android:id="@+id/rlIp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:gravity="start|center_vertical"
                android:id="@+id/tvIp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="70dp"
                android:text="Ip:port"
                android:layout_centerVertical="true"
                android:layout_marginEnd="8dp"/>
            <EditText
                android:id="@+id/etIp"
                android:background="@drawable/yrn_spinner_bg"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:hint="不填端口，默认添加:8081"
                android:inputType="text"
                android:layout_marginStart="8dp"
                android:layout_toEndOf="@+id/tvIp"
                android:autofillHints="ip"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_branch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:gravity="start|center_vertical"
                android:id="@+id/tvBranch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="70dp"
                android:text="Branch:"
                android:layout_centerVertical="true"
                android:layout_marginEnd="8dp"/>
            <EditText
                android:id="@+id/etBranch"
                android:background="@drawable/yrn_spinner_bg"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:inputType="text"
                android:layout_marginStart="8dp"
                android:layout_toEndOf="@+id/tvBranch"
                android:autofillHints="ip"/>
        </RelativeLayout>
    </FrameLayout>
    <TextView
        android:textColor="#666666"
        android:id="@+id/desp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="点击下面配置，自动填充配置"
        android:layout_below="@+id/flContainer"
        android:layout_marginStart="10dp"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/desp"/>
</RelativeLayout>
