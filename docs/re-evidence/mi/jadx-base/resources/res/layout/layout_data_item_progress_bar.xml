<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:tag="layout/layout_data_item_progress_bar_0"
    android:background="@drawable/selector_round"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.xiaomi.fitness.v2.view.HomeCardCommonTitleView
        android:id="@+id/cardTitleView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_14"
        android:layout_marginHorizontal="@dimen/size_14"/>
    <View
        android:id="@+id/emptySpace"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="25dp"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/contentLinearLayout"
        style="@style/healthHomeBottomLayoutV2">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivEmpty"
            android:background="@drawable/shape_health_card_empty_bg"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="40dp"/>
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/progressBar"
            android:paddingBottom="2dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:maxHeight="10dp"
            android:max="100"
            android:progressDrawable="@drawable/health_check_progress_bar"
            android:minHeight="10dp"
            style="@android:style/Widget.ProgressBar.Horizontal"/>
        <com.xiaomi.fitness.homepage.viewholder.XAxisView
            android:id="@+id/xAxisView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/healthHomeXAxisViewV2"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.appcompat.widget.LinearLayoutCompat>
