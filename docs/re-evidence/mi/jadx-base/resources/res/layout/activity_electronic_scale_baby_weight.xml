<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_root"
    android:tag="layout/activity_electronic_scale_baby_weight_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:id="@+id/layout_back"
            android:layout_width="match_parent"
            android:layout_height="55dp">
            <androidx.appcompat.widget.AppCompatImageButton
                android:layout_gravity="center_vertical"
                android:id="@+id/back_iv"
                android:background="@drawable/ic_left_back_black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="22dp"/>
        </LinearLayout>
        <TextView
            android:textSize="32sp"
            android:textColor="@color/electronic_scale_weight_black"
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="@string/electronic_scale_adult_title"
            android:fontFamily="@font/misanslatin_regular"
            android:layout_marginStart="28dp"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/text_color_50"
            android:id="@+id/tv_sub_title"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/electronic_scale_adult_desc"
            android:layout_marginStart="28dp"/>
    </LinearLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/layout_title">
        <TextView
            android:textSize="40sp"
            android:textColor="@color/text_color"
            android:id="@+id/weight_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="0.0"
            android:layout_marginStart="28dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/text_color_80"
            android:id="@+id/weight_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="斤"
            android:layout_alignBaseline="@+id/weight_value"
            android:layout_toEndOf="@+id/weight_value"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/red"
            android:id="@+id/weight_max"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/electronic_scale_baby_more"
            android:layout_below="@+id/weight_value"
            android:layout_marginStart="28dp"/>
        <ImageView
            android:id="@+id/step_icon"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/electronic_scale_icon_baby_weigh_one"
            android:layout_above="@+id/step_layout"
            android:layout_below="@+id/weight_value"
            android:layout_centerInParent="true"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/step_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/electronic_scale_dimen_margin_bottom"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/text_color"
                android:id="@+id/cur_step"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/text_color_80"
                android:id="@+id/slash"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="/"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/text_color_80"
                android:id="@+id/total_step"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2"/>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
