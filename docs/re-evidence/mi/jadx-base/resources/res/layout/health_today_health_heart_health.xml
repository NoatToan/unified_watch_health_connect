<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/common_card_bg_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="@dimen/dimen_margin_6dp"
    android:paddingVertical="@dimen/margin_20dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="horizontal"
        android:id="@+id/card_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dimen_margin_20dp">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/image_view"
            android:background="@drawable/heart_health_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="17sp"
            android:textColor="@color/text_color"
            android:layout_gravity="center_vertical"
            android:id="@+id/title_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/health_check_heart_health"
            android:layout_marginStart="@dimen/dimen_margin_6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/image_view"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/FontMedium"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/chart_view"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margin_20dp">
        <FrameLayout
            android:id="@+id/chart_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.xiaomi.fitness.health.todayhealth.ui.items.HeartChartTitleView
                android:id="@+id/brDayTitle"
                android:layout_width="match_parent"
                android:layout_height="82dp"
                android:layout_marginTop="12dp"/>
            <include
                android:id="@+id/image_guide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="97dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="18dp"
                layout="@layout/layout_legend"/>
            <com.xiaomi.fitness.chart.view.LineChartRecyclerView
                android:id="@+id/lineChartRecycler"
                android:paddingTop="143dp"
                android:layout_width="match_parent"
                android:layout_height="405dp"
                android:overScrollMode="never"
                android:paddingStart="2dp"
                android:paddingEnd="20dp"
                app:displayNumbers="1"
                app:enableEndDayXAxis="true"
                app:enableLineFill="false"
                app:enableStartYAxisLabel="false"
                app:enableXAxisLineCircle="false"
                app:lineHighLightType="4"
                app:linePointRadius="2dp"
                app:linePointSelectCircleStroke="true"
                app:linePointSelectRadius="2dp"
                app:linePointSelectStrokeWidth="2dp"
                app:lineSelectCircles="1"
                app:lineShaderBeginColor="@color/red_pink"
                app:lineShaderEndColor="@color/red_pink"
                app:lineStrokeWidth="3"
                app:xAxisLabelPosition="0"/>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
