<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_offline_map_manager_0"
    android:background="@color/page_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:id="@+id/loaded_content"
        android:background="@color/page_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tab_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_margin_28dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tabGravity="center"
            app:tabIconTint="@color/white_50"
            app:tabIndicator="@drawable/shape_tab_indicator"
            app:tabIndicatorAnimationMode="linear"
            app:tabIndicatorFullWidth="false"
            app:tabIndicatorHeight="3dp"
            app:tabMode="fixed"
            app:tabSelectedTextColor="@color/text_color"
            app:tabTextColor="@color/text_color_60"/>
        <FrameLayout
            android:id="@+id/container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingHorizontal="@dimen/dimen_margin_10dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/storage_state_layout"
            android:background="@drawable/share_bottom_bg"
            android:paddingLeft="20dp"
            android:paddingTop="@dimen/dimen_margin_16dp"
            android:paddingRight="20dp"
            android:paddingBottom="@dimen/dimen_margin_30dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.xiaomi.fitness.baseui.widget.CustomCircleProgressBar
                android:id="@+id/device_storage_progress"
                android:background="@drawable/map_storage_progress_bg"
                android:layout_width="30dp"
                android:layout_height="30dp"
                app:inside_indent="0"
                app:paint_color="@color/black"
                app:paint_width="8"/>
            <TextView
                android:textSize="@dimen/text_size_16"
                android:textColor="@color/text_color"
                android:id="@+id/device_storage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:fontFamily="@font/misanslatin_regular"/>
        </LinearLayout>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/loading_group"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-100dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <miuix.androidbasewidget.widget.ProgressBar
            android:layout_gravity="center"
            android:id="@+id/loading_rotate_progress_bar"
            style="@style/ProgressDialogIndeterminateProgressbar"/>
        <TextView
            android:id="@+id/loading_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_4dp"
            android:text="@string/device_settings_currently_loading"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
