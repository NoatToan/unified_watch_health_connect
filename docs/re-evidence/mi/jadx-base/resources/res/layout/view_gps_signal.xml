<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/gps_Signal"
    android:tag="layout/view_gps_signal_0"
    android:padding="5dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/gps"
        android:background="@drawable/sport_gnss_bg"
        android:layout_width="14dp"
        android:layout_height="14dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14dp"
        android:textStyle="bold"
        android:textColor="@color/sport_gps_text_color"
        android:id="@+id/gps_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/misanslatin_medium"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/signal0"
        android:background="@drawable/select_gps"
        android:layout_width="4dp"
        android:layout_height="@dimen/dimen_margin_10dp"
        android:layout_marginStart="5.6dp"
        app:layout_constraintBottom_toBottomOf="@+id/gps"
        app:layout_constraintStart_toEndOf="@+id/gps"
        app:layout_constraintTop_toTopOf="@+id/gps"/>
    <View
        android:id="@+id/signal1"
        android:background="@drawable/select_gps"
        android:layout_width="4dp"
        android:layout_height="@dimen/dimen_margin_10dp"
        android:layout_marginStart="2.6dp"
        app:layout_constraintBottom_toBottomOf="@+id/signal0"
        app:layout_constraintStart_toEndOf="@+id/signal0"
        app:layout_constraintTop_toTopOf="@+id/signal0"/>
    <View
        android:id="@+id/signal2"
        android:background="@drawable/select_gps"
        android:layout_width="4dp"
        android:layout_height="@dimen/dimen_margin_10dp"
        android:layout_marginStart="2.6dp"
        app:layout_constraintBottom_toBottomOf="@+id/signal1"
        app:layout_constraintStart_toEndOf="@+id/signal1"
        app:layout_constraintTop_toTopOf="@+id/signal1"/>
    <View
        android:id="@+id/signal3"
        android:background="@drawable/select_gps"
        android:layout_width="4dp"
        android:layout_height="@dimen/dimen_margin_10dp"
        android:layout_marginStart="2.6dp"
        app:layout_constraintBottom_toBottomOf="@+id/signal2"
        app:layout_constraintStart_toEndOf="@+id/signal2"
        app:layout_constraintTop_toTopOf="@+id/signal2"/>
    <View
        android:id="@+id/signal4"
        android:background="@drawable/select_gps"
        android:layout_width="4dp"
        android:layout_height="@dimen/dimen_margin_10dp"
        android:layout_marginStart="2.6dp"
        app:layout_constraintBottom_toBottomOf="@+id/signal3"
        app:layout_constraintStart_toEndOf="@+id/signal3"
        app:layout_constraintTop_toTopOf="@+id/signal3"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/sport_color_black"
        android:id="@+id/gps_describe"
        android:background="@drawable/shape_gps_desscribe"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_width="248dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="13.5dp"
        android:text="@string/sport_no_gps_describe"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        app:layout_constraintStart_toStartOf="@+id/gps"
        app:layout_constraintTop_toBottomOf="@+id/gps"/>
    <ImageView
        android:id="@+id/arrow"
        android:background="@drawable/ic_arrow"
        android:layout_width="19dp"
        android:layout_height="9dp"
        android:layout_marginTop="5dp"
        app:layout_constraintStart_toEndOf="@+id/signal0"
        app:layout_constraintTop_toBottomOf="@+id/gps"/>
</androidx.constraintlayout.widget.ConstraintLayout>
