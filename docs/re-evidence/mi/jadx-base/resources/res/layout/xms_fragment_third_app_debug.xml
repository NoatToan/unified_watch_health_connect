<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/xms_fragment_third_app_debug_0"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <Button
        android:id="@+id/inputPackageName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="click to input package name"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/text_color"
        android:id="@+id/showPackageName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"/>
    <Button
        android:id="@+id/installThirdApp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="install third app"/>
    <Button
        android:id="@+id/unInstallThirdApp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="uninstall third app"/>
    <Button
        android:id="@+id/goThirdAppList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="go third app list"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/text_color"
        android:id="@+id/thirdappstatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"/>
</androidx.appcompat.widget.LinearLayoutCompat>
