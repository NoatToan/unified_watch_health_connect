<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="45dp">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textColor="@color/text_color"
            android:gravity="center"
            android:id="@+id/txt_header_title0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/trail_sport_course_info_title0"
            android:singleLine="true"
            android:layout_weight="1"
            style="@style/FontMedium.14sp"/>
        <TextView
            android:textColor="@color/text_color"
            android:gravity="center"
            android:id="@+id/txt_header_title1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/trail_sport_group_info_title1"
            android:singleLine="true"
            android:layout_weight="1"
            style="@style/FontMedium.14sp"/>
        <TextView
            android:textColor="@color/text_color"
            android:gravity="center"
            android:id="@+id/txt_header_title2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/trail_sport_group_info_title2"
            android:singleLine="true"
            android:layout_weight="1"
            style="@style/FontMedium.14sp"/>
        <TextView
            android:textColor="@color/text_color"
            android:gravity="center"
            android:id="@+id/txt_header_title3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/trail_sport_course_info_title03"
            android:singleLine="true"
            android:layout_weight="1"
            style="@style/FontMedium.14sp"/>
        <TextView
            android:textColor="@color/text_color"
            android:gravity="center"
            android:id="@+id/txt_header_title4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/trail_sport_course_info_title04"
            android:singleLine="true"
            android:layout_weight="1"
            style="@style/FontMedium.14sp"/>
        <TextView
            android:textColor="@color/text_color"
            android:gravity="center"
            android:id="@+id/txt_header_title5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/trail_sport_course_info_title04"
            android:singleLine="true"
            android:layout_weight="1"
            style="@style/FontMedium.14sp"/>
        <TextView
            android:textColor="@color/text_color"
            android:gravity="center"
            android:id="@+id/txt_header_title6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/trail_sport_course_info_title04"
            android:singleLine="true"
            android:layout_weight="1"
            style="@style/FontMedium.14sp"/>
        <TextView
            android:textColor="@color/text_color"
            android:gravity="center"
            android:id="@+id/txt_header_title7"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/trail_sport_course_info_title04"
            android:singleLine="true"
            android:layout_weight="1"
            style="@style/FontMedium.14sp"/>
        <TextView
            android:textColor="@color/text_color"
            android:gravity="center"
            android:id="@+id/txt_header_title8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/trail_sport_summary_max_hrm"
            android:singleLine="true"
            android:layout_weight="1"
            style="@style/FontMedium.14sp"/>
        <TextView
            android:textColor="@color/text_color"
            android:gravity="center"
            android:id="@+id/txt_header_title9"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/trail_tab_calorie"
            android:singleLine="true"
            android:layout_weight="1"
            style="@style/FontMedium.14sp"/>
    </LinearLayout>
    <View
        android:id="@+id/divide_line"
        android:background="@color/common_divider_bg_color"
        android:layout_width="match_parent"
        android:layout_height="0.33dp"
        android:layout_marginTop="@dimen/dimen_margin_20dp"
        android:layout_marginBottom="@dimen/dimen_margin_20dp"
        android:layout_marginStart="@dimen/dimen_margin_18dp"
        android:layout_marginEnd="@dimen/dimen_margin_18dp"/>
</LinearLayout>
