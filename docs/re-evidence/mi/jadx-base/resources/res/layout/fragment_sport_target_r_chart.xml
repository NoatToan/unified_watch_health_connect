<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_sport_target_r_chart_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/dataView"
        android:paddingBottom="@dimen/margin_20dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.xiaomi.fitness.health.threetarget.view.TargetWeekBarView
            android:id="@+id/targetWeekBarView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_30"
            android:layout_marginHorizontal="@dimen/health_target_weekview_margin"/>
        <androidx.core.widget.NestedScrollView
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/size_20"
            android:overScrollMode="never">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/page_padding_horizontal_large">
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@drawable/shape_data_item_bg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.xiaomi.fitness.health.threetarget.model.ThreeTargetView
                        android:layout_gravity="center"
                        android:id="@+id/three_targetview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/size_30"
                        android:layout_marginStart="50dp"
                        android:layout_marginEnd="50dp"/>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerBottom"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_25dp"
                        android:layout_marginBottom="@dimen/size_20"
                        android:overScrollMode="never"
                        android:layout_marginStart="@dimen/size_18"
                        android:layout_marginEnd="@dimen/size_18"/>
                </LinearLayout>
                <FrameLayout
                    android:id="@+id/calorieContainer"
                    android:background="@drawable/shape_data_item_bg"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_margin_12dp"/>
                <FrameLayout
                    android:id="@+id/stepContainer"
                    android:background="@drawable/shape_data_item_bg"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_margin_12dp"/>
                <FrameLayout
                    android:id="@+id/breatheContainer"
                    android:background="@drawable/shape_data_item_bg"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_margin_12dp"/>
                <FrameLayout
                    android:id="@+id/activityContainer"
                    android:background="@drawable/shape_data_item_bg"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_margin_12dp"/>
                <FrameLayout
                    android:id="@+id/standContainer"
                    android:background="@drawable/shape_data_item_bg"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_margin_12dp"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
    <TextView
        android:gravity="center"
        android:id="@+id/dataTitleView"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/no_data"
        android:drawableTop="@drawable/icon_nothing"
        android:drawablePadding="@dimen/dimen_margin_10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
