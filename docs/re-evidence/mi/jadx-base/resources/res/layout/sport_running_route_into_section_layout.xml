<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/sport_running_route_into_section_layout_0"
    android:paddingTop="24dp"
    android:paddingBottom="18.6dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/dimen_21sp"
        android:id="@+id/route_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/FontMedium"/>
    <TextView
        android:textSize="@dimen/dimen_13sp"
        android:textColor="@color/text_color_80"
        android:id="@+id/route_length"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/route_name"
        style="@style/FontMedium"/>
    <com.xiaomi.fitness.widget.view.DividerView
        android:id="@+id/length_popularity_divider"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginHorizontal="8dp"
        app:isHorizontal="true"
        app:layout_constraintBottom_toBottomOf="@+id/route_length"
        app:layout_constraintStart_toEndOf="@+id/route_length"
        app:layout_constraintTop_toTopOf="@+id/route_length"/>
    <TextView
        android:textSize="@dimen/dimen_13sp"
        android:textColor="@color/text_color_80"
        android:id="@+id/popularity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/route_length"
        app:layout_constraintStart_toEndOf="@+id/length_popularity_divider"
        app:layout_constraintTop_toTopOf="@+id/route_length"
        style="@style/FontMedium"/>
    <TextView
        android:textSize="@dimen/dimen_11sp"
        android:textColor="@color/text_color"
        android:id="@+id/route_type_tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="9.3dp"
        android:paddingHorizontal="6dp"
        android:paddingVertical="1.3dp"
        app:layout_constraintBottom_toBottomOf="@+id/popularity"
        app:layout_constraintStart_toEndOf="@+id/popularity"
        app:layout_constraintTop_toTopOf="@+id/popularity"
        style="@style/FontMedium"/>
    <RelativeLayout
        android:id="@+id/route_contributor_info"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="19dp"
        app:layout_constraintTop_toBottomOf="@+id/route_length">
        <com.xiaomi.fitness.widget.view.RoundImageView
            android:id="@+id/establish_user_icon"
            android:layout_width="@dimen/dimen_margin_24dp"
            android:layout_height="@dimen/dimen_margin_24dp"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:gravity="center"
            android:id="@+id/contributor_info_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/page_extra_padding_horizontal_large"
            android:layout_toEndOf="@+id/establish_user_icon"
            style="@style/FontDemiBold.12sp"/>
        <TextView
            android:textColor="@color/text_color_40"
            android:gravity="center"
            android:id="@+id/establish_desc"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="5dp"
            android:layout_toEndOf="@+id/contributor_info_tv"
            style="@style/FontNormal.12sp"/>
    </RelativeLayout>
    <TextView
        android:textSize="@dimen/dimen_13sp"
        android:textColor="@color/black"
        android:id="@+id/feedback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/size_26"
        android:text="@string/sport_feedback"
        app:layout_constraintBottom_toBottomOf="@+id/route_name"
        app:layout_constraintEnd_toEndOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/route_address_layout"
        android:background="@drawable/shape_card_bg_f9f9f9"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_20dp"
        android:paddingVertical="@dimen/dimen_margin_10dp"
        app:layout_constraintTop_toBottomOf="@+id/route_contributor_info">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dimen_13sp"
            android:textColor="@color/colorPrimary"
            android:id="@+id/navigation_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sport_navigate_start"
            android:drawablePadding="4dp"
            android:drawableStart="@drawable/orange_arrow_up"
            android:layout_marginEnd="@dimen/dimen_margin_12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/FontMedium"/>
        <com.xiaomi.fitness.widget.view.DividerView
            android:id="@+id/dividerView"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dimen_margin_20dp"
            android:layout_marginEnd="@dimen/dimen_margin_20dp"
            app:isHorizontal="true"
            app:layout_constraintBottom_toBottomOf="@+id/navigation_tv"
            app:layout_constraintEnd_toStartOf="@+id/navigation_tv"
            app:layout_constraintTop_toTopOf="@+id/navigation_tv"/>
        <RelativeLayout
            android:id="@+id/route_address_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_margin_12dp"
            app:layout_constraintBottom_toBottomOf="@+id/navigation_tv"
            app:layout_constraintEnd_toStartOf="@+id/dividerView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/navigation_tv">
            <TextView
                android:textSize="@dimen/dimen_12sp"
                android:textColor="@color/text_color_80"
                android:id="@+id/route_address_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/FontMedium.12sp"/>
            <TextView
                android:textColor="@color/text_color_60"
                android:id="@+id/distance_from_starting_point"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5.3dp"
                android:layout_below="@+id/route_address_tv"/>
        </RelativeLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
