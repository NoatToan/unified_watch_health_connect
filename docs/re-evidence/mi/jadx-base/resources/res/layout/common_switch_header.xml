<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rl_switch_header"
    android:tag="layout/common_switch_header_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/size_64"
    android:paddingStart="@dimen/size_26_67"
    android:paddingEnd="@dimen/size_26_67">
    <ImageView
        android:id="@+id/iv_pre"
        android:visibility="gone"
        android:layout_width="@dimen/size_22"
        android:layout_height="@dimen/size_22"
        android:src="@drawable/ic_circle_pre"
        android:layout_centerVertical="true"
        android:layout_alignParentStart="true"/>
    <ImageView
        android:id="@+id/iv_next"
        android:visibility="gone"
        android:layout_width="@dimen/size_22"
        android:layout_height="@dimen/size_22"
        android:src="@drawable/ic_circle_last"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textSize="@dimen/size_16"
        android:textColor="@color/text_color"
        android:gravity="center_vertical"
        android:id="@+id/tv_text"
        android:padding="@dimen/size_4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="-"
        android:drawablePadding="@dimen/size_2_67"
        android:layout_centerInParent="true"
        android:drawableEnd="@drawable/ic_triangle"
        android:layout_marginStart="@dimen/size_74"
        android:layout_marginEnd="@dimen/size_74"
        style="@style/FontMedium"/>
</RelativeLayout>
