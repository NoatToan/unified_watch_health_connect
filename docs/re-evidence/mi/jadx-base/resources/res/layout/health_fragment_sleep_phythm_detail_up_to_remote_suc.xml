<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/health_fragment_sleep_phythm_detail_up_to_remote_suc_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/dimen_margin_10dp"
        app:layout_constraintBottom_toTopOf="@+id/done_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/image"
                android:background="@drawable/rhythm_detail_up_remote_suc_icon"
                android:layout_width="122dp"
                android:layout_height="122dp"
                android:layout_marginTop="@dimen/dimen_margin_30dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:theme="@style/FontMedium.24sp"
                android:textColor="#66cc00"
                android:id="@+id/up_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_20dp"
                android:text="@string/health_sleep_rhythm_up_suc"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/image"/>
            <TextView
                android:theme="@style/FontMedium.20sp"
                android:textColor="@color/text_color"
                android:id="@+id/up_remind"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_30dp"
                android:text="@string/health_sleep_rhythm_up_remind"
                android:layout_marginHorizontal="@dimen/page_content_padding_horizontal_large"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/up_title"/>
            <TextView
                android:theme="@style/FontMedium.20sp"
                android:textColor="@color/text_color"
                android:id="@+id/up_phone_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_30dp"
                android:text="@string/health_rhythm_up_remote_phone_title"
                app:layout_constraintStart_toStartOf="@+id/up_remind"
                app:layout_constraintTop_toBottomOf="@+id/up_remind"/>
            <TextView
                android:theme="@style/FontMedium.20sp"
                android:textColor="#439fff"
                android:id="@+id/up_phone_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/health_rhythm_up_remote_phone"
                android:layout_marginStart="4dp"
                app:layout_constraintStart_toEndOf="@+id/up_phone_title"
                app:layout_constraintTop_toTopOf="@+id/up_phone_title"/>
            <TextView
                android:theme="@style/FontMedium.20sp"
                android:textColor="@color/text_color"
                android:id="@+id/up_need_help"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/health_rhythm_up_remote_need_help"
                app:layout_constraintStart_toStartOf="@+id/up_phone_title"
                app:layout_constraintTop_toBottomOf="@+id/up_phone_title"/>
            <TextView
                android:theme="@style/FontMedium.14sp"
                android:textColor="#439fff"
                android:gravity="center"
                android:id="@+id/up_need_help_btn"
                android:background="@drawable/health_rhythm_up_need_help_btn_bg"
                android:layout_width="74dp"
                android:layout_height="32dp"
                android:text="@string/health_rhythm_up_remote_need_help_remind"
                android:layout_marginStart="4dp"
                app:layout_constraintBottom_toBottomOf="@+id/up_need_help"
                app:layout_constraintStart_toEndOf="@+id/up_need_help"
                app:layout_constraintTop_toTopOf="@+id/up_need_help"/>
            <TextView
                android:theme="@style/FontMedium.16sp"
                android:textColor="@color/text_color_40"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="50dp"
                android:text="@string/health_rhythm_up_remote_suc_des"
                android:layout_marginHorizontal="@dimen/page_content_padding_horizontal_large"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/up_need_help"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <Button
        android:id="@+id/done_button"
        android:layout_width="@dimen/common_btn_single_line_width"
        android:layout_height="@dimen/common_btn_height"
        android:layout_marginBottom="@dimen/margin_5dp"
        android:text="@string/health_rhythm_up_remote_suc_btn_remind"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/CommonBtn.Primary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
