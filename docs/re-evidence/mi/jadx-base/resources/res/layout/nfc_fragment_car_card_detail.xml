<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutView"
    android:tag="layout/nfc_fragment_car_card_detail_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/nfc_common_title_left_margin"
    android:paddingEnd="@dimen/nfc_common_title_left_margin">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:paddingTop="@dimen/nfc_common_content_miui_title_margin"
                android:paddingBottom="@dimen/nfc_tsm_watch_icon_padding_bottom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.xiaomi.fitness.nfc.widget.DeviceImageView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/deviceView"
                    android:layout_width="@dimen/nfc_device_icon_width"
                    android:layout_height="@dimen/nfc_device_icon_height"/>
                <com.xiaomi.fitness.nfc.widget.InnerCardImageView
                    android:id="@+id/cardView"
                    android:layout_width="86.4dp"
                    android:layout_height="48.6dp"/>
            </FrameLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/feature_item_icon_top_bottom_margin"
                android:layout_marginBottom="@dimen/feature_item_icon_top_bottom_margin">
                <TextView
                    android:textColor="@color/selector_feature_item_title_text_color"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nfc_car_detail_permission"
                    android:layout_centerVertical="true"
                    style="@style/FontMedium.16sp"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/text_color_40"
                    android:id="@+id/permissionView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"
                    style="@style/FontRegular.14sp"/>
            </RelativeLayout>
            <View
                android:id="@+id/view_divider"
                android:background="@color/common_divider_color"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginTop="30dp"/>
        </LinearLayout>
        <RelativeLayout
            android:id="@+id/rl_car_validate_title"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="20dp">
            <TextView
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_color_40"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nfc_car_validate_date"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_color_40"
                android:gravity="center"
                android:id="@+id/validateView"
                android:background="@drawable/nfc_car_invalidate_date"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                android:paddingHorizontal="8dp"
                android:paddingVertical="6dp"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_car_validate_start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/feature_item_icon_top_bottom_margin"
            android:layout_marginBottom="@dimen/feature_item_icon_top_bottom_margin">
            <TextView
                android:textColor="@color/selector_feature_item_title_text_color"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nfc_car_validate_date_start_time"
                android:layout_centerVertical="true"
                style="@style/FontMedium.16sp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/text_color_40"
                android:id="@+id/startTimeView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                style="@style/FontRegular.14sp"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_car_validate_end"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/feature_item_icon_top_bottom_margin"
            android:layout_marginBottom="@dimen/feature_item_icon_top_bottom_margin">
            <TextView
                android:textColor="@color/selector_feature_item_title_text_color"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nfc_car_validate_date_end_time"
                android:layout_centerVertical="true"
                style="@style/FontMedium.16sp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/text_color_40"
                android:id="@+id/endTimeView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                style="@style/FontRegular.14sp"/>
        </RelativeLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:paddingBottom="@dimen/nfc_common_content_miui_title_margin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <TextView
            android:id="@+id/removeView"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="0dp"
            android:text="@string/nfc_remove_door_card"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp"
            style="@style/CommonBtn.Normal"/>
    </LinearLayout>
</RelativeLayout>
