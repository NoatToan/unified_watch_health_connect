<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutView"
    android:tag="layout/nfc_fragment_transfer_in_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/nfc_common_title_left_margin"
    android:paddingEnd="@dimen/nfc_common_title_left_margin">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:paddingTop="@dimen/nfc_tsm_watch_icon_padding_top"
            android:paddingBottom="@dimen/nfc_tsm_watch_icon_padding_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.xiaomi.fitness.nfc.widget.DeviceImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/deviceView"
                android:layout_width="@dimen/nfc_device_icon_width"
                android:layout_height="@dimen/nfc_device_icon_height"/>
            <com.xiaomi.fitness.nfc.widget.InnerCardImageView
                android:id="@+id/cardView"
                android:layout_width="86.4dp"
                android:layout_height="48.6dp"/>
        </FrameLayout>
        <TextView
            android:textSize="24sp"
            android:textColor="@color/text_color"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="@string/nfc_transfer_in_title"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="@dimen/nfc_common_textsize_4"
            android:textColor="@color/text_color_60"
            android:gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/nfc_bfc_transfer_in_desc"
            android:layout_below="@+id/watch_layout"
            android:layout_centerHorizontal="true"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <TextView
            android:id="@+id/transferInView"
            android:text="@string/nfc_transfer_in_btn"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp"
            style="@style/CommonBtn.Normal"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/nextpay_card_intro_ll_protocols"
            android:paddingBottom="10dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true">
            <CheckBox
                android:textSize="@dimen/nfc_tsm_text_size_content_small"
                android:gravity="center_vertical"
                android:id="@+id/checkBoxView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:button="@drawable/selector_check"
                android:drawablePadding="2dp"
                style="@style/nfc_TextAppearance.Content.Light"/>
            <TextView
                android:textSize="@dimen/nfc_tsm_text_size_content_small"
                android:textStyle="bold"
                android:textColor="@color/black_80_transparent"
                android:autoLink="all"
                android:id="@+id/protocolsView"
                android:layout_marginStart="3.3dp"
                style="@style/nfc_TextAppearance.Content"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
