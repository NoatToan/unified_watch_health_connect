<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_face_me_0"
    android:background="@color/face_market_page_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:tag="binding_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.xiaomi.fitness.watch.face.widget.StateLayout
                android:id="@+id/state_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/already_install_list_group"
                    android:background="@drawable/bg_face_market_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/page_padding_horizontal_large"
                    app:layout_constraintTop_toTopOf="parent">
                    <TextView
                        android:id="@+id/already_install_list_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimen_margin_20dp"
                        android:text="@string/face_me_already_install_list"
                        android:layout_marginStart="@dimen/dimen_margin_13dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/FontDemiBold.14sp"/>
                    <androidx.recyclerview.widget.RecyclerView
                        android:orientation="vertical"
                        android:id="@+id/mRecyclerView"
                        android:paddingTop="14dp"
                        android:clipToPadding="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        app:layout_constraintTop_toBottomOf="@+id/already_install_list_title"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.xiaomi.fitness.watch.face.widget.StateLayout>
            <include
                android:id="@+id/pay_not_install"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_12dp"
                android:layout_marginHorizontal="@dimen/page_padding_horizontal_large"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/state_view"
                layout="@layout/face_layout_pay_uninstall_item"/>
            <TextView
                android:id="@+id/designer_entrance"
                android:background="@drawable/bg_face_market_item"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="本地推送表盘"
                android:paddingStart="@dimen/dimen_margin_13dp"
                android:layout_marginHorizontal="@dimen/page_padding_horizontal_large"
                android:layout_marginVertical="@dimen/dimen_margin_12dp"
                android:paddingVertical="@dimen/dimen_margin_13dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/pay_not_install"
                style="@style/FontNormal.14sp"/>
            <TextView
                android:id="@+id/white_list_entrance"
                android:background="@drawable/bg_face_market_item"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/face_white_list_entrance"
                android:paddingStart="@dimen/dimen_margin_13dp"
                android:layout_marginHorizontal="@dimen/page_padding_horizontal_large"
                android:layout_marginVertical="@dimen/dimen_margin_12dp"
                android:paddingVertical="@dimen/dimen_margin_13dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/designer_entrance"
                style="@style/FontNormal.14sp"/>
            <View
                android:layout_width="match_parent"
                android:layout_height="75dp"
                app:layout_constraintTop_toBottomOf="@+id/white_list_entrance"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/deleteView"
        android:background="@color/card_view_background"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">
        <com.xiaomi.fitness.widget.view.DividerView
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dimen_margin_2dp"
            app:layout_constraintBottom_toTopOf="@+id/delete_text"/>
        <TextView
            android:textSize="13sp"
            android:id="@+id/delete_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dimen_margin_3dp"
            android:text="@string/common_delete"
            app:layout_constraintBottom_toTopOf="@+id/delete_img"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <ImageView
            android:id="@+id/delete_img"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dimen_margin_26dp"
            android:src="@drawable/ic_delete"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
