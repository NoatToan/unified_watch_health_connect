<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/size_30">
    <TextView
        android:textColor="@color/text_color"
        android:id="@+id/txt_before_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:layout_alignBaseline="@+id/txt_value"
        android:layout_alignParentTop="true"
        android:layout_marginStart="@dimen/size_18"
        android:layout_alignParentStart="true"
        style="@style/FontMedium.12sp"/>
    <TextView
        android:textSize="@dimen/font_22"
        android:id="@+id/txt_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:layout_alignParentTop="true"
        android:layout_marginStart="@dimen/size_2"
        android:layout_toEndOf="@+id/txt_before_desc"
        style="@style/FontMedium"/>
    <com.xiaomi.fitness.widget.view.DurationTextView
        android:id="@+id/duration_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginStart="@dimen/size_18"
        android:layout_alignParentStart="true"
        app:dtv_dataFont="@font/misanslatin_medium"
        app:dtv_dataTextColor="@color/text_color"
        app:dtv_dataTextSize="@dimen/font_22"
        app:dtv_unitTextColor="@color/text_color"
        app:dtv_unitTextFontFamily="mipro-medium"
        app:dtv_unitTextSize="@dimen/font_12"/>
    <TextView
        android:textSize="@dimen/font_12"
        android:textColor="@color/text_color"
        android:id="@+id/txt_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:layout_alignBaseline="@+id/txt_value"
        android:layout_alignParentTop="true"
        android:layout_marginStart="@dimen/size_2"
        android:layout_toEndOf="@+id/txt_value"
        style="@style/FontMedium.12sp"/>
    <TextView
        android:textSize="@dimen/font_12"
        android:textColor="@color/text_color_40"
        android:id="@+id/txt_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="110dp"
        android:maxLines="2"
        android:includeFontPadding="false"
        android:layout_below="@+id/txt_value"
        android:layout_marginStart="@dimen/size_18"
        android:layout_alignParentStart="true"
        style="@style/FontRegular.12sp"/>
    <TextView
        android:textSize="@dimen/size_9"
        android:textColor="#f22424"
        android:id="@+id/tv_abnormal"
        android:background="@drawable/shape_evaluation_bg"
        android:paddingTop="@dimen/size_1"
        android:paddingBottom="@dimen/size_1"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_2"
        android:layout_below="@+id/txt_value"
        android:paddingStart="@dimen/size_3"
        android:paddingEnd="@dimen/size_3"
        android:layout_marginStart="@dimen/size_6"
        android:layout_marginEnd="@dimen/size_3"
        android:layout_toEndOf="@+id/txt_title"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/iv_jump"
        android:background="@drawable/ic_base_right_arrow_icon_size_48"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_2"
        android:layout_below="@+id/txt_value"
        android:layout_toEndOf="@+id/tv_abnormal"/>
</RelativeLayout>
