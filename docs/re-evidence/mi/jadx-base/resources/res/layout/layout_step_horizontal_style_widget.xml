<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@android:id/background"
    android:background="@drawable/widget_default_corners_background_12_67"
    android:padding="@dimen/size_13_3"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:background="@drawable/ic_widget_step_yellow"
        android:layout_width="@dimen/size_19_3"
        android:layout_height="@dimen/size_19_3"/>
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:importantForAccessibility="no"/>
    <TextView
        android:textColor="@color/text_color_30"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/tv_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:drawableLeft="@drawable/ic_widget_step_label_loading"/>
    <TextView
        android:textSize="@dimen/size_32"
        android:textColor="@color/text_color"
        android:ellipsize="middle"
        android:id="@+id/tv_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:drawableLeft="@drawable/ic_widget_step_number_loading"
        android:autoSizeTextType="uniform"
        style="@style/FontLatinSemiBold"/>
    <ProgressBar
        android:id="@+id/step_progress_normal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_6_7"
        android:layout_marginTop="@dimen/size_2_6"
        android:max="100"
        android:progress="0"
        android:indeterminateOnly="false"
        android:progressDrawable="@drawable/layer_step_horizontal_normal_progress"
        style="@style/Base.Widget.AppCompat.ProgressBar.Horizontal"/>
    <ProgressBar
        android:id="@+id/step_progress_reach_target"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_6_7"
        android:layout_marginTop="@dimen/size_2_6"
        android:max="100"
        android:progress="0"
        android:indeterminateOnly="false"
        android:progressDrawable="@drawable/layer_step_horizontal_reach_score_progress"
        style="@style/Base.Widget.AppCompat.ProgressBar.Horizontal"/>
</LinearLayout>
