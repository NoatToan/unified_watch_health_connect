<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/course_series_info_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.xiaomi.fitness.baseui.recyclerview.MoreRecyclerView
        android:id="@+id/rcv_series_course"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintTop_toTopOf="parent"/>
    <include
        android:id="@+id/state_view"
        android:visibility="gone"
        layout="@layout/view_text_icon"/>
    <View
        android:id="@+id/view_title_bg"
        android:background="@color/white"
        android:paddingTop="38dp"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:alpha="0"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/miuix_appcompat_action_bar_back_light"
        android:layout_marginStart="18dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_series_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_series_title"/>
    <TextView
        android:textSize="19sp"
        android:textColor="@color/black"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/tv_series_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:maxLines="1"
        android:maxLength="15"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/view_title_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ImageView
        android:id="@+id/iv_share"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/miuix_appcompat_action_button_share_light"
        android:layout_marginEnd="18dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_series_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_series_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
