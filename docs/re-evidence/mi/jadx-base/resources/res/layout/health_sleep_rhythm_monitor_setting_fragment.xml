<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/health_sleep_rhythm_monitor_setting_fragment_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_weight="1"
        android:overScrollMode="never">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="17sp"
                android:textColor="@color/text_color"
                android:id="@+id/tv_cycle_select"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/health_sleep_rhythm_monitoring_period_selection"
                android:paddingHorizontal="28dp"
                android:paddingVertical="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/FontMedium"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clCycleFirst"
                android:background="@drawable/health_sleep_shape_gray_18_radius"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:paddingVertical="@dimen/size_16"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_cycle_select">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivSelectFirst"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="8dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/tvCycleTitleFirst"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/heath_miuix_preference_btn_radio_arrow_on"/>
                <TextView
                    android:textSize="17sp"
                    android:textColor="@color/text_color"
                    android:id="@+id/tvCycleTitleFirst"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="48dp"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/FontMedium"/>
                <TextView
                    android:textSize="@dimen/dimen_14sp"
                    android:textColor="@color/text_color_60"
                    android:id="@+id/tvCycleSubTitleFirst"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/health_sleep_rhythm_requirement_desc_first"
                    android:layout_marginStart="48dp"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvCycleTitleFirst"
                    style="@style/FontRegular"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clCycleSecond"
                android:background="@drawable/health_sleep_shape_gray_18_radius"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginHorizontal="12dp"
                android:paddingVertical="@dimen/size_16"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/clCycleFirst">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivSelectSecond"
                    android:visibility="gone"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="8dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/tvCycleTitleSecond"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/heath_miuix_preference_btn_radio_arrow_on"/>
                <TextView
                    android:textSize="17sp"
                    android:textColor="@color/text_color"
                    android:id="@+id/tvCycleTitleSecond"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="48dp"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/FontMedium"/>
                <TextView
                    android:textSize="@dimen/dimen_14sp"
                    android:textColor="@color/text_color_60"
                    android:id="@+id/tvCycleSubTitleSecond"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/health_sleep_rhythm_requirement_desc_second"
                    android:layout_marginStart="48dp"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvCycleTitleSecond"
                    style="@style/FontRegular"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <View
                android:id="@+id/divideLine"
                android:background="@color/common_divider_bg_color"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_0_33"
                android:layout_marginTop="48dp"
                android:layout_marginStart="@dimen/size_28"
                android:layout_marginEnd="@dimen/size_28"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/clCycleSecond"/>
            <TextView
                android:textSize="17sp"
                android:textColor="@color/text_color"
                android:id="@+id/tvPrecautionsTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="44dp"
                android:text="@string/health_sleep_rhythm_precautions_title"
                android:layout_marginHorizontal="28dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/divideLine"
                style="@style/FontMedium"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/text_color_80"
                android:id="@+id/tvPrecautionsDesc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/health_sleep_rhythm_precautions_desc"
                android:layout_marginHorizontal="28dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvPrecautionsTitle"
                style="@style/FontRegular"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <TextView
        android:textSize="17sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tvOpenMonitor"
        android:background="@drawable/selector_bottom_btn_positive_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="28dp"
        android:maxWidth="336dp"
        android:text="@string/health_sleep_rhythm_open_rhythm_monitoring"
        android:layout_marginHorizontal="28dp"
        android:paddingHorizontal="@dimen/size_20"
        android:paddingVertical="13dp"/>
</LinearLayout>
