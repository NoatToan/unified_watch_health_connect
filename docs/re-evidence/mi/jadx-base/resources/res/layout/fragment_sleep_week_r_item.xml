<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_sleep_week_r_item_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/container"
        android:tag="binding_1"
        android:paddingBottom="@dimen/size_30"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="@dimen/health_detail_page_common_margin_horizontal"
        app:layout_constraintTop_toTopOf="parent">
        <include
            android:id="@+id/card_evaluation"
            layout="@layout/layout_sleep_evaluation"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_wm_detail"
            android:background="@drawable/shape_data_item_bg"
            android:paddingBottom="10dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_12">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/layout_sleep_distribute"
                android:tag="binding_2"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <include
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_20"
                    android:layout_marginBottom="@dimen/size_20"
                    layout="@layout/layout_common_icon_title"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/level_desc_recyclerview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/size_18"
                    android:layout_marginEnd="@dimen/size_18"/>
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.xiaomi.fitness.view.DataTitleView
                        android:id="@+id/distribute_data_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/health_card_data_title_margin_start"/>
                    <com.xiaomi.fitness.chart.view.BarChartRecyclerView
                        android:id="@+id/distribute_recycler"
                        style="@style/BarChartRecyclerViewStyle.SleepDistribute.Week"/>
                </FrameLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/layout_sleep_regular"
                android:tag="binding_3"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <include layout="@layout/layout_division_line"/>
                <include
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_10"
                    layout="@layout/layout_common_icon_title"/>
                <com.xiaomi.fitness.health.sleep.view.wm.SleepRegularView
                    android:id="@+id/sleep_regular_view"
                    android:paddingTop="@dimen/size_26_6"
                    android:paddingBottom="@dimen/size_31_3"
                    android:layout_width="match_parent"
                    android:layout_height="258dp"
                    android:paddingStart="@dimen/size_18"
                    android:paddingEnd="@dimen/size_41"
                    app:bcl_bg_line_color="@color/common_divider_bg_color"
                    app:bcl_bg_line_width="@dimen/size_0_33"
                    app:bcl_column_color="@color/health_sleep_regular_chart_color"
                    app:bcl_prompt_bg_height="@dimen/size_24"
                    app:bcl_prompt_line_color="@color/health_sleep_regular_chart_color"
                    app:bcl_prompt_line_width="@dimen/size_0_67"
                    app:bcl_prompt_text_size="@dimen/font_12"
                    app:bcl_x_text_color="@color/text_color_30"
                    app:bcl_x_text_size="@dimen/size_10"
                    app:bcl_y_text_color="@color/text_color_30"
                    app:bcl_y_text_size="@dimen/size_10"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/layout_sleep_hrm"
                android:tag="binding_4"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <include layout="@layout/layout_division_line"/>
                <include
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_10"
                    layout="@layout/layout_common_icon_title"/>
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.xiaomi.fitness.view.DataTitleView
                        android:id="@+id/hrm_data_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/size_8"
                        android:layout_marginStart="@dimen/health_card_data_title_margin_start"/>
                    <com.xiaomi.fitness.chart.view.BarChartRecyclerView
                        android:id="@+id/hrm_recycler"
                        style="@style/BarChartRecyclerViewStyle.SleepHrm.Week"/>
                </FrameLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/layout_sleep_spo2"
                android:tag="binding_5"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <include layout="@layout/layout_division_line"/>
                <include
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_10"
                    layout="@layout/layout_common_icon_title"/>
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.xiaomi.fitness.view.DataTitleView
                        android:id="@+id/spo2_data_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/size_8"
                        android:layout_marginStart="@dimen/health_card_data_title_margin_start"/>
                    <com.xiaomi.fitness.chart.view.BarChartRecyclerView
                        android:id="@+id/spo2_recycler"
                        style="@style/BarChartRecyclerViewStyle.SleepSpo2.Week"/>
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:gravity="center"
        android:id="@+id/dataTitleView"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/no_data"
        android:drawableTop="@drawable/icon_nothing"
        android:drawablePadding="@dimen/dimen_margin_10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
