<?xml version="1.0" encoding="utf-8"?>
<miuix.springback.view.SpringBackLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/userinfo_activity_goal_manager_0"
    android:background="@color/userinfo_common_page_bg_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:scrollableView="@+id/scrollView">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:background="@color/userinfo_common_page_bg_color"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@color/userinfo_common_page_bg_color"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="@dimen/page_padding_horizontal_large">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/linear_all_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/userinfo_common_card_left_icon_width"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textColor="@color/userinfo_desc_black"
                    android:id="@+id/goal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="@dimen/dimen_margin_12dp"
                    android:text="@string/userinfo_goal"
                    android:layout_marginHorizontal="@dimen/page_extra_padding_horizontal_large"
                    style="@style/FontNormal.12sp"/>
                <com.xiaomi.fitness.widget.RightArrowBindingTwoLineTextView
                    android:layout_gravity="center"
                    android:id="@+id/calorieSetting"
                    android:background="@drawable/userinfo_shape_round_white_goal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:icon="@drawable/calore_target_icon"
                    app:showBackground="false"
                    app:title="@string/userinfo_data_type_calorie"/>
                <com.xiaomi.fitness.widget.RightArrowBindingTwoLineTextView
                    android:layout_gravity="center"
                    android:id="@+id/stepSettingView"
                    android:background="@drawable/userinfo_shape_round_white_goal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="@dimen/dimen_margin_16dp"
                    app:icon="@drawable/step_target_icon_light"
                    app:showBackground="false"
                    app:title="@string/userinfo_data_type_step"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/switch_goal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_margin_14dp">
                    <TextView
                        android:textColor="@color/userinfo_desc_black"
                        android:id="@+id/switch_goal_textview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/userinfo_switch_goal"
                        android:layout_marginHorizontal="@dimen/page_extra_padding_horizontal_large"
                        style="@style/FontNormal.12sp"/>
                    <ImageView
                        android:id="@+id/img_right_arrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/userinfo_switch_icon"
                        android:layout_marginStart="2dp"/>
                </LinearLayout>
                <com.xiaomi.fitness.widget.RightArrowBindingTwoLineTextView
                    android:layout_gravity="center"
                    android:id="@+id/activeSettingView"
                    android:background="@drawable/userinfo_shape_round_white_goal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:icon="@drawable/userinfo_selector_mhs_common"
                    app:showBackground="false"
                    app:title="@string/userinfo_target_activity_title"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/goal_notify_switch"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/activeSettingView">
                    <View
                        android:id="@+id/devider"
                        android:background="@color/divider_color"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/common_divider_height"
                        android:layout_marginTop="@dimen/dimen_margin_40dp"
                        android:paddingHorizontal="@dimen/userinfo_size_26_67"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:id="@+id/notify_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimen_margin_28dp"
                        android:layout_marginStart="@dimen/dimen_margin_14dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/devider"
                        style="@style/FontRegular.12sp"/>
                    <com.xiaomi.fitness.widget.SwitchButtonTwoLineTextView
                        android:id="@+id/goal_achieve_notify"
                        android:background="@drawable/userinfo_shape_round_white_goal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimen_margin_28dp"
                        android:paddingStart="@dimen/userinfo_margin_14dp"
                        android:paddingEnd="@dimen/dimen_margin_20dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="@+id/notify_title"
                        app:layout_constraintTop_toBottomOf="@+id/notify_title"
                        app:showBackground="false"
                        app:showSwitch="true"
                        app:subtitle="@string/userinfo_goal_achieve_desc"
                        app:title="@string/userinfo_goal_achieve_title"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</miuix.springback.view.SpringBackLayout>
