<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:layout_gravity="center_vertical"
    android:background="@drawable/health_preference_category_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/page_content_padding_horizontal_large"
    android:paddingEnd="@dimen/page_content_padding_horizontal_large">
    <androidx.appcompat.widget.AppCompatRadioButton
        android:gravity="center_vertical"
        android:id="@android:id/checkbox"
        android:focusable="false"
        android:clickable="false"
        android:duplicateParentState="true"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:button="@drawable/health_miuix_preference_btn_radio_arrow"
        android:layout_marginEnd="@dimen/miuix_preference_item_icon_margin_end"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/preference_icon_minWidth">
        <ImageView
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@android:id/icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/miuix_preference_item_padding_inner"
            android:layout_marginBottom="@dimen/miuix_preference_item_padding_inner"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:paddingEnd="@dimen/miuix_preference_icon_padding_end"
            style="@style/Widget.PreferenceIcon"/>
    </LinearLayout>
    <RelativeLayout
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        style="@style/Widget.PreferenceItem.Radio">
        <androidx.appcompat.widget.AppCompatCheckedTextView
            android:textColor="@color/health_selector_text_color"
            android:ellipsize="end"
            android:id="@android:id/title"
            android:fadingEdge="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:textAlignment="viewStart"
            style="@style/FontMedium.16sp"/>
        <androidx.appcompat.widget.AppCompatCheckedTextView
            android:textColor="@color/health_selector_text_color"
            android:id="@android:id/summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/miuix_preference_summary_margin_top"
            android:maxLines="10"
            android:layout_below="@android:id/title"
            android:textAlignment="viewStart"
            android:layout_alignStart="@android:id/title"
            style="@style/FontRegular.12sp"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@android:id/widget_frame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/miuix_preference_widget_width"/>
</LinearLayout>
