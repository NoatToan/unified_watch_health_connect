<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/dimen_16sp"
        android:textColor="@color/text_color"
        android:gravity="center_vertical"
        android:id="@+id/curse_temp_title"
        android:tag="layout/health_curse_temp_view_holder_0"
        android:paddingTop="@dimen/dimen_margin_20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/health_temperature_skin_temp_title"
        android:drawableLeft="@drawable/health_curse_temp_icon"
        android:drawablePadding="10dp"
        android:layout_marginStart="@dimen/dimen_margin_18dp"
        android:layout_marginEnd="@dimen/dimen_margin_18dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/curse_temp_chart_layout"
        android:tag="layout/health_curse_temp_view_holder_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_12dp"
        app:layout_constraintTop_toBottomOf="@+id/curse_temp_title">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/curse_temp_title_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_margin_18dp"
            android:layout_marginEnd="@dimen/dimen_margin_18dp"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:gravity="bottom"
                android:orientation="horizontal"
                android:id="@+id/curse_temp_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/dimen_18sp"
                    android:textColor="@color/black"
                    android:id="@+id/curse_temp_simble"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="@dimen/dimen_24sp"
                    android:textColor="@color/text_color"
                    android:id="@+id/curse_temp_diff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/misanslatin_bold"/>
                <TextView
                    android:textSize="@dimen/dimen_14sp"
                    android:textColor="@color/text_color"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/health_temperature_diff_label"/>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/dimen_14sp"
                android:id="@+id/curse_temp_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:layout_constraintTop_toBottomOf="@+id/curse_temp_layout"/>
        </LinearLayout>
        <com.xiaomi.fitness.chart.view.LineChartRecyclerView
            android:id="@+id/curse_temp_trend_recycler"
            app:barSpace="0.6"
            app:displayNumbers="7"
            app:enableEndYAxisLabel="true"
            app:enableScrollToScale="true"
            app:enableStartYAxisLabel="false"
            app:enableXAxisLineCircle="true"
            app:layout_constraintTop_toBottomOf="@+id/curse_temp_title_layout"
            app:lineColor="@color/curse_color"
            app:lineHighLightType="4"
            app:linePointRadius="@dimen/size_2"
            app:linePointSelectCircleStroke="true"
            app:linePointSelectRadius="@dimen/size_2"
            app:linePointSelectStrokeWidth="@dimen/size_2"
            app:lineSelectCircles="1"
            app:lineShaderBeginColor="@color/transparent"
            app:lineShaderEndColor="@color/transparent"
            app:lineStrokeWidth="6"
            style="@style/ChartBaseStyle"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/curse_temp_desc_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_margin_18dp"
            android:layout_marginEnd="@dimen/dimen_margin_18dp"
            app:layout_constraintTop_toTopOf="@+id/curse_temp_trend_recycler">
            <TextView
                android:textColor="@color/curse_color"
                android:id="@+id/curse_temp_baseline_desc"
                android:background="@drawable/health_bg_curse_temp_baseline_desc"
                android:paddingLeft="8dp"
                android:paddingTop="4dp"
                android:paddingRight="8dp"
                android:paddingBottom="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:singleLine="true"
                android:fontFamily="@font/misanslatin_bold"/>
            <com.google.android.flexbox.FlexboxLayout
                android:id="@+id/curse_table_header_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:dividerDrawableVertical="@drawable/health_curse_sign_divider"
                app:flexDirection="row"
                app:flexWrap="wrap"
                app:justifyContent="space_between"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/divider1"
                app:showDividerVertical="middle">
                <com.xiaomi.fitness.health.curse.view.HealthCurseSignView
                    android:id="@+id/curse"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:healthSignIcon="@drawable/curse_sign"
                    app:healthSignTitle="@string/health_curse"/>
                <com.xiaomi.fitness.health.curse.view.HealthCurseSignView
                    android:id="@+id/predictSign"
                    app:healthSignIcon="@drawable/health_ic_curse_forecast_small"
                    app:healthSignTitle="@string/health_curse_forecast"
                    style="@style/HealthCurseSign"/>
                <com.xiaomi.fitness.health.curse.view.HealthCurseSignView
                    android:id="@+id/ovulateSign"
                    app:healthSignIcon="@drawable/health_ic_curse_ovum_small"
                    app:healthSignTitle="@string/health_curse_ovum"
                    style="@style/HealthCurseSign"/>
                <com.xiaomi.fitness.health.curse.view.HealthCurseSignView
                    android:id="@+id/dangerSign"
                    app:healthSignIcon="@drawable/health_ic_curse_danger_small"
                    app:healthSignTitle="@string/health_curse_danger"
                    style="@style/HealthCurseSign"/>
            </com.google.android.flexbox.FlexboxLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.xiaomi.fitness.view.TemperatureTrendEmptyView
        android:id="@+id/empty_view"
        android:tag="layout/health_curse_temp_view_holder_2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_12dp"
        app:layout_constraintTop_toBottomOf="@+id/curse_temp_title"/>
</merge>
