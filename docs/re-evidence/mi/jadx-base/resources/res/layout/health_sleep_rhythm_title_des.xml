<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/chart_guide"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/shape_sleep_rhythm_body"
        android:background="@drawable/shape_sleep_rhythm_body"
        android:layout_width="@dimen/dimen_margin_10dp"
        android:layout_height="@dimen/dimen_margin_10dp"/>
    <TextView
        android:textColor="@color/text_color_40"
        android:gravity="start"
        android:layout_gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sleep_rhythm_body"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="@dimen/dimen_margin_25dp"
        style="@style/FontRegular.12sp"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/shape_sleep_rhythm_light"
        android:background="@drawable/shape_sleep_rhythm_light"
        android:layout_width="@dimen/dimen_margin_10dp"
        android:layout_height="@dimen/dimen_margin_10dp"/>
    <TextView
        android:textColor="@color/text_color_40"
        android:gravity="start"
        android:layout_gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/health_sleep_rhythm_light"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="@dimen/dimen_margin_25dp"
        style="@style/FontRegular.12sp"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/shape_sleep_rem_guide"
        android:background="@drawable/shape_sleep_rhythm_bed"
        android:layout_width="@dimen/dimen_margin_10dp"
        android:layout_height="@dimen/dimen_margin_10dp"/>
    <TextView
        android:textColor="@color/text_color_40"
        android:gravity="start"
        android:layout_gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/health_sleep_rhythm_bed"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="@dimen/dimen_margin_25dp"
        style="@style/FontRegular.12sp"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/shape_sleep_wake_guide"
        android:background="@drawable/shape_sleep_rhythm_sleep"
        android:layout_width="@dimen/dimen_margin_10dp"
        android:layout_height="@dimen/dimen_margin_10dp"/>
    <TextView
        android:textColor="@color/text_color_40"
        android:gravity="start"
        android:layout_gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/health_sleep_rhythm_sleep"
        android:layout_marginStart="6dp"
        style="@style/FontRegular.12sp"/>
</LinearLayout>
