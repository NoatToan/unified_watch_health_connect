<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:paddingTop="@dimen/size_6"
    android:paddingBottom="@dimen/size_4"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/chart_common_padding_start"
    android:layout_marginEnd="@dimen/chart_common_padding_start">
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/dimen_margin_180dp">
        <ImageView
            android:layout_gravity="center_vertical"
            android:background="@drawable/shape_blood_glucose_agp_low"
            android:layout_width="@dimen/size_10"
            android:layout_height="@dimen/size_10"/>
        <TextView
            android:textColor="@color/text_color_40"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/health_blood_glucose_agp_content_low"
            android:paddingStart="@dimen/size_6"
            android:paddingEnd="@dimen/size_10"
            style="@style/FontRegular.12sp"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/dimen_margin_180dp"
        android:layout_marginStart="@dimen/dimen_margin_10dp">
        <ImageView
            android:layout_gravity="center_vertical"
            android:background="@drawable/shape_blood_glucose_agp_normal"
            android:layout_width="@dimen/size_10"
            android:layout_height="@dimen/size_10"/>
        <TextView
            android:textColor="@color/text_color_40"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/health_blood_glucose_agp_content_mid"
            android:layout_marginStart="@dimen/size_6"
            style="@style/FontRegular.12sp"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/dimen_margin_180dp"
        android:layout_marginStart="@dimen/dimen_margin_10dp">
        <ImageView
            android:layout_gravity="center_vertical"
            android:background="@drawable/shape_blood_glucose_agp_high"
            android:layout_width="@dimen/size_10"
            android:layout_height="@dimen/size_10"/>
        <TextView
            android:textColor="@color/text_color_40"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/health_blood_glucose_agp_content_high"
            android:paddingStart="@dimen/size_6"
            android:paddingEnd="@dimen/size_10"
            style="@style/FontRegular.12sp"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/dimen_margin_180dp"
        android:layout_marginStart="@dimen/dimen_margin_10dp">
        <ImageView
            android:layout_gravity="center_vertical"
            android:background="@drawable/blood_sugar_guide_area"
            android:layout_width="@dimen/size_10"
            android:layout_height="@dimen/size_10"/>
        <TextView
            android:textColor="@color/text_color_40"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/health_blood_glucose_agp_content_guide_area"
            android:layout_marginStart="@dimen/size_6"
            style="@style/FontRegular.12sp"/>
    </LinearLayout>
</LinearLayout>
