<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:ui="http://schemas.android.com/apk/res-auto"
    android:id="@+id/content_layout"
    android:tag="layout/nfc_fragment_card_recharge_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/page_content_padding_horizontal_large"
    android:paddingEnd="@dimen/page_content_padding_horizontal_large">
    <com.xiaomi.fitness.nfc.widget.MarqueeTextView
        android:id="@+id/tipsView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        ui:layout_constraintStart_toStartOf="parent"
        ui:layout_constraintTop_toTopOf="parent"
        style="@style/nfc_TextAppearance.BulletinTextView"/>
    <TextView
        android:textSize="@dimen/nfc_tsm_text_size_content_medium"
        android:textColor="@color/text_color_80"
        android:id="@+id/selectView"
        android:layout_marginTop="15dp"
        android:text="@string/nfc_card_recharge_recharge_info"
        ui:layout_constraintStart_toStartOf="parent"
        ui:layout_constraintTop_toBottomOf="@+id/tipsView"
        style="@style/nfc_TextAppearance.Content.Light"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chooseView"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:numColumns="2"
        ui:layout_constraintStart_toStartOf="parent"
        ui:layout_constraintTop_toBottomOf="@+id/selectView"/>
    <View
        android:id="@+id/lineView"
        android:background="@color/nfc_line"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        ui:layout_constraintTop_toBottomOf="@+id/chooseView"/>
    <com.xiaomi.fitness.nfc.widget.RechargeItemView
        android:id="@+id/couponView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        ui:layout_constraintTop_toBottomOf="@+id/lineView"
        ui:nfc_leftText="@string/nfc_nextpay_card_recharge_coupon_item_text"
        ui:nfc_leftTextColor="@color/nfc_setting_item_title"
        ui:nfc_leftTextSize="@dimen/common_item_set_title_text_size"
        ui:nfc_rightTextColor="@color/orange"
        ui:nfc_rightTextSize="@dimen/nfc_nextpay_card_recharge_item_coupon_right_text_size"
        ui:nfc_showRightArrow="true"/>
    <TextView
        android:textStyle="bold"
        android:id="@+id/confirmView"
        android:layout_width="match_parent"
        android:layout_marginTop="20dp"
        android:text="@string/nfc_common_confirm"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp"
        ui:layout_constraintBottom_toBottomOf="parent"
        ui:layout_constraintStart_toStartOf="parent"
        style="@style/CommonBtn.Primary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
