<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_electronic_scale_ota_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/ll_version_info"
        android:paddingTop="160dp"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/electronic_scale_dimen_margin_27dp"
        android:paddingEnd="@dimen/electronic_scale_dimen_margin_27dp">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/electronic_scale_ota_found_new_version"/>
        <TextView
            android:textSize="@dimen/dimen_14sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_version"
            android:paddingTop="@dimen/dimen_margin_13dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="@dimen/dimen_14sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_version_desc"
            android:paddingTop="@dimen/dimen_margin_3dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ScrollView
                android:id="@+id/layout_note"
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dimen_margin_10dp"
                android:layout_above="@+id/tv_start_ota">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/dimen_14sp"
                        android:textStyle="bold"
                        android:id="@+id/tv_release_note_title"
                        android:paddingTop="@dimen/dimen_margin_40dp"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/electronic_scale_ota_release_note_title"/>
                    <TextView
                        android:textSize="@dimen/dimen_14sp"
                        android:id="@+id/tv_release_note_in_page_one"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </ScrollView>
            <TextView
                android:id="@+id/tv_start_ota"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_marginBottom="@dimen/electronic_scale_dimen_margin_27dp"
                android:text="@string/electronic_scale_ota_start_ota"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:layout_marginStart="@dimen/dimen_margin_0dp"
                android:layout_marginEnd="@dimen/dimen_margin_0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                style="@style/CommonBtn.Normal"/>
        </RelativeLayout>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/ll_upgrading"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/layout_progress">
            <LinearLayout
                android:orientation="vertical"
                android:paddingTop="@dimen/dimen_margin_40dp"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/electronic_scale_dimen_margin_27dp"
                android:paddingEnd="@dimen/electronic_scale_dimen_margin_27dp">
                <TextView
                    android:textSize="@dimen/dimen_14sp"
                    android:textStyle="bold"
                    android:paddingTop="@dimen/dimen_margin_40dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/electronic_scale_ota_release_note_title"/>
                <TextView
                    android:textSize="@dimen/dimen_14sp"
                    android:id="@+id/tv_release_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="@dimen/dimen_14sp"
                    android:textStyle="bold"
                    android:paddingTop="@dimen/dimen_margin_40dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/electronic_scale_ota_attention"/>
                <TextView
                    android:textSize="@dimen/dimen_14sp"
                    android:paddingTop="@dimen/dimen_margin_10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/electronic_scale_ota_attention_content"/>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
            </LinearLayout>
        </ScrollView>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/layout_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:paddingStart="@dimen/electronic_scale_dimen_margin_27dp"
            android:paddingEnd="@dimen/electronic_scale_dimen_margin_27dp">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ll_progress_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/dimen_11sp"
                    android:paddingTop="@dimen/dimen_margin_10dp"
                    android:paddingBottom="@dimen/dimen_margin_5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/electronic_scale_ota_pushing_progress"/>
                <TextView
                    android:textSize="@dimen/dimen_11sp"
                    android:id="@+id/tv_progress"
                    android:paddingTop="@dimen/dimen_margin_10dp"
                    android:paddingBottom="@dimen/dimen_margin_5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="@dimen/dimen_11sp"
                    android:paddingTop="@dimen/dimen_margin_10dp"
                    android:paddingBottom="@dimen/dimen_margin_5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="%"/>
            </LinearLayout>
            <miuix.androidbasewidget.widget.ProgressBar
                android:id="@+id/pb_pushing"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginBottom="@dimen/dimen_margin_20dp"
                style="@style/ProgressDialog"/>
            <TextView
                android:layout_gravity="bottom"
                android:id="@+id/tv_pushing_btn"
                android:layout_width="match_parent"
                android:layout_marginBottom="@dimen/electronic_scale_dimen_margin_27dp"
                android:text="@string/electronic_scale_ota_pushing_package"
                android:layout_marginStart="@dimen/dimen_margin_0dp"
                android:layout_marginEnd="@dimen/dimen_margin_0dp"
                style="@style/CommonBtn.Normal"/>
        </LinearLayout>
    </RelativeLayout>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/ll_ota_fail"
        android:paddingTop="160dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/electronic_scale_dimen_margin_27dp"
        android:paddingEnd="@dimen/electronic_scale_dimen_margin_27dp">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/electronic_scale_icon_config_fail"/>
        <TextView
            android:textSize="@dimen/dimen_19sp"
            android:textStyle="bold"
            android:textColor="#f22424"
            android:layout_gravity="center_horizontal"
            android:paddingTop="@dimen/dimen_margin_40dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/electronic_scale_ota_fail"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <TextView
            android:layout_gravity="bottom"
            android:id="@+id/tv_retry"
            android:layout_width="match_parent"
            android:layout_marginBottom="@dimen/electronic_scale_dimen_margin_27dp"
            android:text="@string/electronic_scale_config_wifi_retry"
            android:layout_marginStart="@dimen/dimen_margin_0dp"
            android:layout_marginEnd="@dimen/dimen_margin_0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/CommonBtn.Primary"/>
        <TextView
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_check_help"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/electronic_scale_dimen_margin_27dp"
            android:text="@string/electronic_scale_config_wifi_check_help"
            android:layout_marginStart="@dimen/dimen_margin_0dp"
            android:layout_marginEnd="@dimen/dimen_margin_0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </LinearLayout>
</FrameLayout>
