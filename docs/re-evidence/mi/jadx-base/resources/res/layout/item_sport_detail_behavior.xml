<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_sport_detail_behavior_0"
    android:background="@drawable/sport_detail_item_bg"
    android:paddingBottom="@dimen/dimen_margin_30dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.xiaomi.fitness.widget.view.DataTitleSimpleView
        android:id="@+id/titleView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.xiaomi.fitness.detail.view.SportsBehaviorCircleView
        android:id="@+id/left_circle_view"
        android:visibility="gone"
        android:layout_width="140dp"
        android:layout_height="140dp"
        app:layout_constraintEnd_toStartOf="@+id/mid_circle_view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleView"/>
    <com.xiaomi.fitness.detail.view.SportsBehaviorCircleView
        android:id="@+id/mid_circle_view"
        android:visibility="gone"
        android:layout_width="140dp"
        android:layout_height="140dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleView"/>
    <com.xiaomi.fitness.detail.view.SportsBehaviorCircleView
        android:id="@+id/right_circle_view"
        android:visibility="gone"
        android:layout_width="140dp"
        android:layout_height="140dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/mid_circle_view"
        app:layout_constraintTop_toBottomOf="@+id/titleView"/>
    <com.xiaomi.fitness.widget.view.DividerView
        android:id="@+id/divider_view"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="@dimen/dimen_margin_1dp"
        android:layout_marginTop="@dimen/dimen_margin_20dp"
        android:layout_marginStart="@dimen/page_extra_padding_horizontal_large"
        android:layout_marginEnd="@dimen/page_extra_padding_horizontal_large"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/left_circle_view"
        app:layout_goneMarginTop="@dimen/dimen_margin_0dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/data_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_18dp"
        android:layout_marginHorizontal="@dimen/dimen_margin_18dp"
        app:layout_constraintTop_toBottomOf="@+id/divider_view">
        <TextView
            android:id="@+id/data_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:id="@+id/data_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_behavior"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/divider_view"/>
</androidx.constraintlayout.widget.ConstraintLayout>
