<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:paddingTop="@dimen/size_17_3"
    android:paddingBottom="@dimen/size_17_3"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/font_16_7"
        android:textStyle="bold"
        android:textColor="@color/text_color_60"
        android:gravity="start"
        android:layout_gravity="center_vertical"
        android:id="@+id/tv_left"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="5"
        android:layout_marginStart="@dimen/size_26_7"
        style="@style/CardTextAppearance.LabelTitle"/>
    <TextView
        android:textSize="@dimen/font_14"
        android:textColor="@color/text_color_40"
        android:gravity="end"
        android:layout_gravity="end"
        android:id="@+id/tv_right"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="3"
        style="@style/CardTextAppearance.ItemStatus"/>
    <ImageView
        android:layout_gravity="start"
        android:id="@+id/right_arrow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:src="@drawable/arrow_right"
        android:layout_weight="2"/>
</LinearLayout>
