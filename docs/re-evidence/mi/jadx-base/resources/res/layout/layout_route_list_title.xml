<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootTitleLayout"
    android:tag="layout/layout_route_list_title_0"
    android:fitsSystemWindows="true"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:elevation="30dp">
    <androidx.cardview.widget.CardView
        android:id="@+id/backCard"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginTop="9dp"
        android:layout_marginStart="14dp"
        app:cardBackgroundColor="@color/card_bg_normal"
        app:cardCornerRadius="12dp"
        app:cardElevation="3dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_left_back_black"
            android:scaleType="centerInside"
            android:contentDescription="@string/back"/>
    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView
        android:id="@+id/titleCard"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:layout_marginStart="11dp"
        android:layout_marginEnd="12dp"
        app:cardBackgroundColor="@color/card_bg_normal"
        app:cardCornerRadius="15dp"
        app:cardElevation="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/backCard"
        app:layout_constraintEnd_toStartOf="@+id/menuButtonCard"
        app:layout_constraintTop_toTopOf="@+id/backCard">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/createRouteCardButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="11dp">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_create_route"
                android:scaleType="centerInside"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/text_color"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sport_create_route"
                android:drawablePadding="8dp"
                android:fontFamily="@font/misanslatin_medium"
                android:paddingHorizontal="2dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <View
        android:layout_width="0dp"
        android:layout_height="5dp"
        app:layout_constraintEnd_toEndOf="@+id/titleCard"
        app:layout_constraintStart_toStartOf="@+id/titleCard"
        app:layout_constraintTop_toBottomOf="@+id/titleCard"/>
    <androidx.cardview.widget.CardView
        android:layout_gravity="center"
        android:id="@+id/menuButtonCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="42dp"
        android:minHeight="42dp"
        android:layout_marginEnd="14dp"
        app:cardBackgroundColor="@color/card_bg_normal"
        app:cardCornerRadius="15dp"
        app:cardElevation="3dp"
        app:layout_constraintBottom_toBottomOf="@+id/backCard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/backCard">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/questionMark"
            android:visibility="gone"
            android:layout_width="42dp"
            android:layout_height="22dp"
            android:src="@drawable/sport_ic_question_mark"
            android:scaleType="centerInside"
            android:contentDescription="@string/sport_question_mark"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/menuButtonLayout"
            android:visibility="visible"
            android:layout_width="42dp"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/menuButton"
                android:background="@color/card_bg_normal"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:src="@drawable/ic_three_dots"
                android:scaleType="centerInside"
                android:contentDescription="@string/more"
                android:paddingVertical="13.5dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <View
        android:id="@+id/menuBottomPadding"
        android:layout_width="0dp"
        android:layout_height="5dp"
        app:layout_constraintEnd_toEndOf="@+id/menuButtonCard"
        app:layout_constraintStart_toStartOf="@+id/menuButtonCard"
        app:layout_constraintTop_toBottomOf="@+id/menuButtonCard"/>
    <LinearLayout
        android:gravity="top|center_horizontal"
        android:orientation="vertical"
        android:id="@+id/create_notice"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/titleCard"
        app:layout_constraintStart_toStartOf="@+id/titleCard"
        app:layout_constraintTop_toBottomOf="@+id/titleCard">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_pop_up_arrow"/>
        <androidx.cardview.widget.CardView
            android:id="@+id/create_notice_card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/black_60"
            app:cardCornerRadius="15dp"
            app:cardElevation="0dp">
            <TextView
                android:textSize="14dp"
                android:textColor="@color/white"
                android:gravity="center"
                android:padding="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sport_try_ai_create_route_hint"
                android:fontFamily="@font/misanslatin_regular"
                android:textAlignment="center"/>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
