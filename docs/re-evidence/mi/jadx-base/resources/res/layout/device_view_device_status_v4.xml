<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/dimen_margin_8dp">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/device_band_icon"
        android:layout_width="164dp"
        android:layout_height="164dp"
        android:scaleType="centerCrop"
        android:layout_marginStart="-8dp"
        android:layout_marginVertical="@dimen/dimen_margin_6dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.xiaomi.fitness.watch.face.export.exportview.FaceInfoView
        android:id="@+id/device_iv_dial_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="@+id/device_band_icon"
        app:layout_constraintEnd_toEndOf="@+id/device_band_icon"
        app:layout_constraintStart_toStartOf="@+id/device_band_icon"
        app:layout_constraintTop_toTopOf="@+id/device_band_icon"/>
    <com.xiaomi.fitness.watch.face.export.exportview.FaceInfoView
        android:id="@+id/device_iv_dial_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="@+id/device_band_icon"
        app:layout_constraintEnd_toEndOf="@+id/device_band_icon"
        app:layout_constraintStart_toStartOf="@+id/device_band_icon"
        app:layout_constraintTop_toTopOf="@+id/device_band_icon"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/device_detail_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_20dp"
        android:layout_marginStart="-8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/device_band_icon"
        app:layout_constraintTop_toTopOf="@+id/device_band_icon">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/device_name_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/device_text_color_black"
                android:ellipsize="end"
                android:id="@+id/device_tv_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_weight="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="14sp"
                android:autoSizeMaxTextSize="16sp"
                style="@style/FontDemiBold"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/device_switch_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/device_status_switch"
                android:layout_marginStart="@dimen/dimen_margin_4dp"/>
        </LinearLayout>
        <TextView
            android:textColor="@color/device_text_color_black"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/device_tv_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/device_name_group"
            style="@style/FontRegular.14sp"/>
        <TextView
            android:textColor="@color/colorPrimary"
            android:id="@+id/device_tv_switch_wear_mode"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_10dp"
            android:text="@string/device_accessory_switch"
            app:layout_constraintStart_toStartOf="@+id/device_name_group"
            app:layout_constraintTop_toBottomOf="@+id/device_tv_status"
            style="@style/FontMedium.14sp"/>
        <TextView
            android:textSize="@dimen/dimen_margin_17dp"
            android:textColor="@color/colorAccent"
            android:gravity="center"
            android:id="@+id/device_tv_synchronize"
            android:background="@drawable/device_shape_status_sync_bg"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dimen_margin_40dp"
            android:layout_marginTop="@dimen/dimen_margin_28dp"
            android:text="@string/device_tab_sync"
            android:paddingHorizontal="19dp"
            android:paddingVertical="@dimen/dimen_margin_9dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/device_tv_switch_wear_mode"
            style="@style/FontMedium"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
