<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/view_outdoor_title_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingEnd="22.3dp">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/container_ll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_20dp"
        android:layout_marginStart="24dp"
        app:layout_constraintEnd_toStartOf="@+id/sportConfig"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="12.6dp"
            android:textColor="@color/sport_color_black"
            android:id="@+id/title"
            android:tag="binding_1"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/FontRegular"/>
        <TextView
            android:gravity="center"
            android:id="@+id/tag"
            android:tag="binding_2"
            android:layout_width="@dimen/size_15"
            android:layout_height="wrap_content"
            android:text="|"
            app:layout_constraintBottom_toBottomOf="@+id/title"
            app:layout_constraintEnd_toEndOf="@+id/title"
            app:layout_constraintStart_toEndOf="@+id/title"
            app:layout_constraintTop_toTopOf="@+id/title"/>
        <TextView
            android:textSize="12.6dp"
            android:textColor="@color/sport_color_black"
            android:id="@+id/connect"
            android:tag="binding_3"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="150dp"
            app:layout_constraintBottom_toBottomOf="@+id/title"
            app:layout_constraintEnd_toStartOf="@+id/line"
            app:layout_constraintStart_toEndOf="@+id/tag"
            app:layout_constraintTop_toTopOf="@+id/title"
            style="@style/FontRegular"/>
        <TextView
            android:gravity="center"
            android:id="@+id/line"
            android:tag="binding_4"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="15dp"
            android:layout_height="wrap_content"
            android:text="|"
            app:layout_constraintBottom_toBottomOf="@+id/connect"
            app:layout_constraintEnd_toStartOf="@+id/connect_tv"
            app:layout_constraintStart_toEndOf="@+id/connect"
            app:layout_constraintTop_toTopOf="@+id/connect"/>
        <TextView
            android:textSize="12.6dp"
            android:textColor="@color/sport_color_black"
            android:gravity="start"
            android:id="@+id/connect_tv"
            android:tag="binding_5"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/sport_connected"
            android:layout_weight="1"
            android:textDirection="locale"
            app:layout_constraintBottom_toBottomOf="@+id/connect"
            app:layout_constraintEnd_toStartOf="@+id/sportConfig"
            app:layout_constraintStart_toEndOf="@+id/line"
            app:layout_constraintTop_toTopOf="@+id/connect"
            style="@style/FontRegular"/>
    </LinearLayout>
    <com.xiaomi.fitness.sport.view.widget.GpsSignalView
        android:id="@+id/gpsView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/container_ll"/>
    <ImageView
        android:id="@+id/sportConfig"
        android:visibility="gone"
        android:layout_width="33.3dp"
        android:layout_height="33.3dp"
        android:src="@drawable/sporting_set"
        android:contentDescription="@string/sport_config"
        app:layout_constraintBottom_toBottomOf="@+id/container_ll"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/container_ll"
        app:layout_constraintTop_toTopOf="@+id/container_ll"/>
</androidx.constraintlayout.widget.ConstraintLayout>
