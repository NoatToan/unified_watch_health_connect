<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/fragment_sport_detail_power_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.xiaomi.fitness.widget.view.DataTitleSimpleView
        android:id="@+id/dataSimpleTitleView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/itemViewContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_margin_20dp">
        <com.xiaomi.fitness.baseui.widget.SportDetailItemView
            android:id="@+id/detailItemAvg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:itemGravity="0"
            app:itemHeight="100dp"
            app:txtNameColor="@color/text_color"
            app:txtNameSize="@dimen/font_10"
            app:txtValueColor="@color/text_color"
            app:txtValueFont="@font/misanslatin_demibold"
            app:txtValueSize="@dimen/dimen_26sp"/>
        <com.xiaomi.fitness.baseui.widget.SportDetailItemView
            android:id="@+id/detailItemMax"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:itemGravity="0"
            app:itemHeight="100dp"
            app:txtNameColor="@color/text_color"
            app:txtNameSize="@dimen/font_10"
            app:txtValueColor="@color/text_color"
            app:txtValueFont="@font/misanslatin_demibold"
            app:txtValueSize="@dimen/dimen_26sp"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_bottom"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_margin_20dp"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.xiaomi.fitness.chart.mpchart.linechart.CustomLineChart
            android:id="@+id/chart"
            android:layout_width="match_parent"
            android:layout_height="@dimen/custom_chart_height_245dp"
            android:layout_marginTop="2dp"
            android:paddingStart="2dp"
            android:paddingEnd="@dimen/padding_1dp"
            android:layout_marginStart="18dp"
            app:enableMaxCircle="false"
            app:enableMaxPoup="false"
            app:enableSportYAxisLabel="true"
            app:enableTimeXAxisLabel="true"
            app:enableXAxisGridLine="false"
            app:enableYAxisGridLine="true"
            app:lineColor="@color/eco_bicycle_power_chart_line_color"
            app:lineFillRes="@drawable/eco_sport_fill_power"
            app:lineStrokeWidth="@integer/sport_chart_line_width"
            app:maxYAxisRatio="0.2"
            app:sportYAxisLabelType="1"
            app:sportYAxisReminder="12"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="end|top"
            android:id="@+id/iv_expand"
            android:padding="@dimen/dimen_margin_3dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:contentDescription="@string/trail_sport_title_detail"
            android:paddingStart="@dimen/dimen_margin_18dp"
            android:paddingEnd="@dimen/dimen_margin_15dp"
            android:layout_marginEnd="@dimen/dimen_margin_18dp"
            app:srcCompat="@drawable/iv_health_chart_expand"/>
    </FrameLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_distribute"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_12dp"/>
</LinearLayout>
