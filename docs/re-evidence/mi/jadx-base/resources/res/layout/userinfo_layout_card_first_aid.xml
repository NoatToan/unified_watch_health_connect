<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/bg"
        android:background="@drawable/medical_id_entrance_shape_card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="@+id/content"
        app:layout_constraintTop_toTopOf="@+id/content"
        app:shapeAppearance="@style/userinfo_roundedCornerStyle"/>
    <ImageView
        android:id="@+id/bubble"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:src="@drawable/medical_id_entrance_bubble"
        android:scaleType="fitEnd"
        app:layout_constraintBottom_toBottomOf="@+id/bg"
        app:layout_constraintEnd_toEndOf="@+id/bg"
        app:layout_constraintTop_toTopOf="@+id/bg"/>
    <ImageView
        android:id="@+id/iv_icon"
        android:layout_width="@dimen/size_30"
        android:layout_height="31dp"
        android:src="@drawable/ic_first_aid_case"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/dimen_margin_20dp"
        app:layout_constraintBottom_toBottomOf="@+id/content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/content"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:id="@+id/content"
        android:layout_width="@dimen/dimen_margin_0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16.7dp"
        android:layout_marginEnd="@dimen/dimen_margin_20dp"
        android:paddingVertical="21dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/arrow_right"
        app:layout_constraintStart_toEndOf="@+id/iv_icon"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textColor="@color/white"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/userinfo_first_aid_card"
            android:singleLine="true"
            style="@style/FontMedium.14sp"/>
        <TextView
            android:textColor="@color/white_70"
            android:id="@+id/tv_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2.67dp"
            android:text="@string/userinfo_medical_file_desc1"
            android:layout_below="@+id/tv_title"
            style="@style/FontRegular.11sp"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <ImageView
        android:id="@+id/arrow_right"
        android:layout_width="@dimen/size_12"
        android:layout_height="@dimen/size_12"
        android:src="@drawable/medical_id_right_arrow"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/dimen_margin_10dp"
        android:layout_marginEnd="@dimen/userinfo_size_20"
        app:layout_constraintBottom_toBottomOf="@+id/content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/content"/>
</androidx.constraintlayout.widget.ConstraintLayout>
