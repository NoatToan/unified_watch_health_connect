<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/contentLayout"
    android:tag="layout/sport_fragment_create_route_choose_module_0"
    android:background="@drawable/sport_route_ai_create_bg"
    android:paddingTop="20dp"
    android:paddingBottom="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="29dp">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/confirmRouteTitleLayout"
        android:paddingBottom="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="23sp"
            android:textColor="@color/text_color"
            android:gravity="start|center_vertical"
            android:id="@+id/confirmRouteTitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sport_choose_planning_mode"
            android:fontFamily="@font/misanslatin_semibold"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/text_color_40"
            android:gravity="start|center_vertical"
            android:id="@+id/confirmRouteSubTitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sport_please_select_your_preferred_route_style"
            android:fontFamily="@font/misanslatin_regular"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/midContentView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="2">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/midFiexedHeightLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/distanceLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="6dp"
                android:layout_weight="1"
                android:contentDescription="@string/sport_plan_by_distance">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/distanceBg"
                    android:background="@drawable/sport_create_route_bg_wide"
                    android:padding="6dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:foreground="@drawable/sport_red_style_selector"
                    android:scaleType="centerInside"
                    app:layout_constraintBottom_toTopOf="@+id/distanceTextView"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/distanceIcon"
                    android:padding="18dp"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:src="@drawable/ic_route_distance_plan"
                    android:scaleType="centerInside"
                    app:layout_constraintBottom_toBottomOf="@+id/distanceBg"
                    app:layout_constraintEnd_toEndOf="@+id/distanceBg"
                    app:layout_constraintStart_toStartOf="@+id/distanceBg"
                    app:layout_constraintTop_toTopOf="@+id/distanceBg"/>
                <TextView
                    android:textSize="16dp"
                    android:textColor="@color/text_color"
                    android:layout_gravity="bottom|center_horizontal"
                    android:id="@+id/distanceTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sport_plan_by_distance"
                    android:fontFamily="@font/misanslatin_medium"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/distanceBg"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/styleLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="6dp"
                android:layout_weight="1"
                android:contentDescription="@string/sport_customize_route_shape">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/styleBg"
                    android:background="@drawable/sport_create_route_bg_wide"
                    android:padding="6dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:foreground="@drawable/sport_red_style_selector"
                    android:scaleType="centerInside"
                    app:layout_constraintBottom_toTopOf="@+id/styleTextView"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/styleIcon"
                    android:padding="20dp"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:src="@drawable/ic_love"
                    android:scaleType="centerInside"
                    app:layout_constraintBottom_toBottomOf="@+id/styleBg"
                    app:layout_constraintEnd_toEndOf="@+id/styleBg"
                    app:layout_constraintStart_toStartOf="@+id/styleBg"
                    app:layout_constraintTop_toTopOf="@+id/styleBg"/>
                <TextView
                    android:textSize="16dp"
                    android:textColor="@color/text_color"
                    android:layout_gravity="bottom|center_horizontal"
                    android:id="@+id/styleTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sport_customize_route_shape"
                    android:fontFamily="@font/misanslatin_medium"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/styleBg"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="bottom|center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/bottomButtonLayout"
        android:paddingTop="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:textSize="18dp"
            android:gravity="center"
            android:layout_gravity="end"
            android:id="@+id/button_next"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/btn_next"
            android:layout_weight="162"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            style="@style/SportCreateRouteOrangeButtonStyle"/>
    </LinearLayout>
</LinearLayout>
