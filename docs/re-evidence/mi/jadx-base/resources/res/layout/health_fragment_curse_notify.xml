<?xml version="1.0" encoding="utf-8"?>
<miuix.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/health_fragment_curse_notify_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="13dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/page_content_padding_horizontal_large">
        <com.xiaomi.fitness.widget.SwitchButtonSingleLineTextView
            android:id="@+id/appSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:title="@string/health_curse_app_notify"/>
        <TextView
            android:id="@+id/appStartLabel"
            android:text="@string/health_curse_notify_start"
            style="@style/HealthCurseNotifyItemTitle"/>
        <com.xiaomi.fitness.widget.RightArrowSingleLineTextView
            android:id="@+id/appInView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:title="@string/health_curse_notify_ahead"/>
        <TextView
            android:id="@+id/appOvumLabel"
            android:text="@string/health_curse_notify_ovum"
            style="@style/HealthCurseNotifyItemTitle"/>
        <com.xiaomi.fitness.widget.RightArrowSingleLineTextView
            android:id="@+id/appOvumView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:title="@string/health_curse_notify_ahead"/>
        <TextView
            android:id="@+id/appEasyPregnancyLabel"
            android:text="@string/health_curse_notify_easy_pregnancy"
            style="@style/HealthCurseNotifyItemTitle"/>
        <com.xiaomi.fitness.widget.RightArrowSingleLineTextView
            android:id="@+id/appEasyPregnancyView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:title="@string/health_curse_notify_ahead"/>
        <com.xiaomi.fitness.widget.view.DividerView
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:layout_marginStart="26dp"
            android:layout_marginEnd="26dp"/>
        <com.xiaomi.fitness.widget.SwitchButtonSingleLineTextView
            android:id="@+id/deviceSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:title="@string/health_curse_notify_device"/>
        <TextView
            android:id="@+id/deviceStartLabel"
            android:text="@string/health_curse_notify_start"
            style="@style/HealthCurseNotifyItemTitle"/>
        <com.xiaomi.fitness.widget.RightArrowSingleLineTextView
            android:id="@+id/deviceInView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:title="@string/health_curse_notify_ahead"/>
        <TextView
            android:id="@+id/deviceOvumLabel"
            android:text="@string/health_curse_notify_ovum"
            style="@style/HealthCurseNotifyItemTitle"/>
        <com.xiaomi.fitness.widget.RightArrowSingleLineTextView
            android:id="@+id/deviceOvumView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:title="@string/health_curse_notify_ahead"/>
        <TextView
            android:id="@+id/devicePregnancyLabel"
            android:text="@string/health_curse_notify_easy_pregnancy"
            style="@style/HealthCurseNotifyItemTitle"/>
        <com.xiaomi.fitness.widget.RightArrowSingleLineTextView
            android:id="@+id/deviceEasyPregnancyView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:title="@string/health_curse_notify_ahead"/>
    </LinearLayout>
</miuix.core.widget.NestedScrollView>
