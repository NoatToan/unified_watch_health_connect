<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_ability_plan_setting_0"
    android:background="@color/page_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.xiaomi.fitness.training_plan_export.widget.TrainingPlanTitleBar
        android:id="@+id/titlebar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/title_bar_height"
        android:layout_marginTop="@dimen/dimen_margin_36dp"
        android:layout_marginHorizontal="21dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:id="@+id/main"
        android:background="@drawable/common_card_bg_white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_10dp"
        android:layout_marginHorizontal="@dimen/page_padding_horizontal_large"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titlebar">
        <com.xiaomi.fitness.widget.RightArrowBindingSingleLineTextView
            android:id="@+id/training_plan_running_date"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/page_content_padding_horizontal_large"
            app:showMore="true"
            app:title="@string/training_plan_running_date"/>
        <com.xiaomi.fitness.widget.RightArrowBindingSingleLineTextView
            android:id="@+id/training_plan_power_date"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/page_content_padding_horizontal_large"
            app:showMore="true"
            app:title="@string/training_plan_power_date"/>
        <com.xiaomi.fitness.widget.SwitchButtonBindingTwoLineTextView
            android:id="@+id/training_plan_settings_sync_to_calender"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/page_content_padding_horizontal_large"
            app:title="@string/training_plan_settings_sync_to_calender"/>
        <com.xiaomi.fitness.widget.SwitchButtonBindingTwoLineTextView
            android:id="@+id/training_plan_settings_remind"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/page_content_padding_horizontal_large"
            app:subtitle="@string/training_plan_open_remind_tip"
            app:title="@string/training_plan_settings_remind"/>
        <com.xiaomi.fitness.widget.RightArrowBindingSingleLineTextView
            android:id="@+id/training_plan_settings_remind_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/page_content_padding_horizontal_large"
            app:showMore="true"
            app:title="@string/training_plan_settings_remind_time"/>
        <View
            android:background="@color/divider_line_color"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginHorizontal="@dimen/page_content_padding_horizontal_large"/>
        <TextView
            android:textColor="@color/text_color_40"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_25dp"
            android:layout_marginBottom="@dimen/dimen_margin_28dp"
            android:text="@string/training_plan_setting_tip"
            android:paddingHorizontal="@dimen/page_content_padding_horizontal_large"
            style="@style/FontNormal.12sp"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.constraintlayout.widget.ConstraintLayout>
