<?xml version="1.0" encoding="utf-8"?>
<miuix.springback.view.SpringBackLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/device_settings_fragment_heart_rate_broadcast_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:scrollableView="@+id/scrollview">
    <miuix.core.widget.NestedScrollView
        android:id="@+id/scrollview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
            android:layout_marginEnd="@dimen/page_content_padding_horizontal_large">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dimen_12sp"
                android:textColor="@color/common_hint_des_txt_color"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_10dp"/>
            <com.xiaomi.fitness.widget.SwitchButtonTwoLineTextView
                android:id="@+id/heartRateSwitchView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:subtitle="@string/device_settings_heart_rate_broadcast_des"
                app:title="@string/device_settings_heart_rate_broadcast"/>
        </LinearLayout>
    </miuix.core.widget.NestedScrollView>
</miuix.springback.view.SpringBackLayout>
