<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/pk_activity_history_detail_0"
    android:background="@color/page_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/coordinatorLayout"
        android:background="@color/page_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="@dimen/page_padding_horizontal_large">
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/app_bar"
            android:background="@color/page_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:elevation="0dp"
            app:layout_behavior="com.xiaomi.fitness.active.pk.widget.FlingBehavior">
            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:fitsSystemWindows="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_scrollFlags="exitUntilCollapsed|scroll"
                app:statusBarScrim="@android:color/transparent">
                <RelativeLayout
                    android:id="@+id/top_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <View
                        android:id="@+id/view_space"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:layout_centerHorizontal="true"/>
                    <RelativeLayout
                        android:background="@drawable/pk_card_white_bg_radius_48"
                        android:paddingTop="@dimen/size_26_67"
                        android:paddingBottom="@dimen/size_20"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/size_20"
                        android:layout_below="@+id/view_space">
                        <com.xiaomi.fitness.widget.view.RoundImageView
                            android:id="@+id/iv_opp_avatar"
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:src="@drawable/ic_pk_avatar_default"
                            android:layout_marginStart="@dimen/dimen_margin_40dp"
                            android:layout_alignParentStart="true"/>
                        <TextView
                            android:textColor="@color/text_color_40"
                            android:gravity="center"
                            android:id="@+id/iv_opp_nickname"
                            android:layout_width="75dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/size_7"
                            android:layout_below="@+id/iv_opp_avatar"
                            android:layout_marginStart="25dp"
                            style="@style/FontRegular.10sp"/>
                        <com.xiaomi.fitness.widget.view.RoundImageView
                            android:id="@+id/iv_own_avatar"
                            android:background="@drawable/ic_pk_avatar_default"
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:layout_marginEnd="@dimen/dimen_margin_40dp"
                            android:layout_alignParentEnd="true"/>
                        <TextView
                            android:textColor="@color/text_color_40"
                            android:gravity="center"
                            android:id="@+id/iv_own_nickname"
                            android:layout_width="75dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/size_7"
                            android:layout_below="@+id/iv_own_avatar"
                            android:layout_marginEnd="25dp"
                            android:layout_alignParentEnd="true"
                            style="@style/FontRegular.10sp"/>
                        <ImageView
                            android:id="@+id/iv_colon"
                            android:background="@drawable/ic_pk_colon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8.7dp"
                            android:layout_centerHorizontal="true"/>
                        <TextView
                            android:textSize="28.3sp"
                            android:textColor="@color/text_color"
                            android:gravity="center"
                            android:id="@+id/tv_opp_score"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_alignTop="@+id/iv_opp_avatar"
                            android:layout_alignBottom="@+id/iv_opp_avatar"
                            android:layout_toStartOf="@+id/iv_colon"
                            android:layout_toEndOf="@+id/iv_opp_avatar"
                            style="@style/FontLatinDemiBold"/>
                        <TextView
                            android:textSize="28.3sp"
                            android:textColor="@color/text_color"
                            android:gravity="center"
                            android:id="@+id/tv_own_score"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_alignTop="@+id/iv_own_avatar"
                            android:layout_alignBottom="@+id/iv_own_avatar"
                            android:layout_toStartOf="@+id/iv_own_avatar"
                            android:layout_toEndOf="@+id/iv_colon"
                            style="@style/FontLatinDemiBold"/>
                        <TextView
                            android:textColor="@color/text_color_40"
                            android:id="@+id/win_count_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/size_7"
                            android:text="@string/pk_win_count"
                            android:layout_below="@+id/iv_opp_avatar"
                            android:layout_centerHorizontal="true"
                            style="@style/FontRegular.10sp"/>
                    </RelativeLayout>
                    <ImageView
                        android:id="@+id/iv_medal"
                        android:visibility="gone"
                        android:layout_width="146.67dp"
                        android:layout_height="146.67dp"
                        android:layout_centerHorizontal="true"/>
                </RelativeLayout>
            </com.google.android.material.appbar.CollapsingToolbarLayout>
        </com.google.android.material.appbar.AppBarLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/pk_history_recycler"
            android:background="@drawable/pk_card_white_bg_radius_48"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_12"
            android:layout_marginBottom="@dimen/size_20"
            android:overScrollMode="never"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
        <TextView
            android:textColor="@color/pk_no_network_text_color"
            android:layout_gravity="center"
            android:id="@+id/no_network"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pk_network_connection_failed_tip"
            android:drawableTop="@drawable/icon_no_network"
            android:drawablePadding="@dimen/size_10"
            style="@style/FontRegular.14sp"/>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</RelativeLayout>
