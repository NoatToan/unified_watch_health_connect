<?xml version="1.0" encoding="utf-8"?>
<miuix.springback.view.SpringBackLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/device_settings_device_settins_fragment_screen_wake_for_huami_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:scrollableView="@+id/scrollview">
    <miuix.core.widget.NestedScrollView
        android:id="@+id/scrollview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
            android:layout_marginEnd="@dimen/page_content_padding_horizontal_large">
            <com.xiaomi.fitness.widget.RightArrowTwoLineTextView
                android:id="@+id/layout_wrist_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_13dp"
                app:layout_constraintTop_toBottomOf="@+id/stateView"
                app:subtitle="@string/device_settings_wrist_bright_screen_notice"
                app:title="@string/device_settings_wrist_bright_screen"/>
            <com.xiaomi.fitness.widget.RightArrowTwoLineTextView
                android:id="@+id/layout_wrist_start_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:title="@string/device_settings_wrist_bright_start_time"/>
            <com.xiaomi.fitness.widget.RightArrowTwoLineTextView
                android:id="@+id/layout_wrist_end_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:title="@string/device_settings_night_end_time"/>
            <com.xiaomi.fitness.widget.RightArrowTwoLineTextView
                android:id="@+id/layout_wrist_sensitive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:title="@string/device_settings_wrist_bright_sensitive"/>
        </LinearLayout>
    </miuix.core.widget.NestedScrollView>
</miuix.springback.view.SpringBackLayout>
