<?xml version="1.0" encoding="utf-8"?>
<miuix.springback.view.SpringBackLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/feedback_activity_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:scrollableView="@+id/spring_back_target">
    <miuix.core.widget.NestedScrollView
        android:id="@+id/spring_back_target"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:paddingBottom="@dimen/feedback_margin_26"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="@dimen/page_padding_horizontal_large">
            <TextView
                android:id="@+id/label1"
                android:text="@string/feedback_type"
                android:layout_marginStart="@dimen/dimen_margin_14dp"
                android:layout_marginEnd="@dimen/dimen_margin_14dp"
                style="@style/FeedbackDesc"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/tag_view"
                android:layout_width="match_parent"
                android:layout_height="53.3dp"
                android:layout_marginTop="@dimen/feedback_margin"
                android:layout_marginStart="@dimen/feedback_margin"
                android:layout_marginEnd="@dimen/feedback_margin"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/label1">
                <TextView
                    android:textSize="@dimen/dimen_15sp"
                    android:textColor="@color/black"
                    android:layout_gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/feedback_type_label"
                    android:paddingStart="0dp"
                    android:paddingEnd="20dp"/>
                <TextView
                    android:textSize="@dimen/dimen_13sp"
                    android:textColor="@color/feedback_black_40"
                    android:ellipsize="end"
                    android:gravity="end|center_vertical"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/feedback_type_name_tv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/feedback_select_please"
                    android:singleLine="true"
                    android:layout_weight="1"
                    android:drawableEnd="@drawable/feedback_rtl_feedback_type_item_arrow"
                    android:textDirection="locale"/>
            </LinearLayout>
            <EditText
                android:textColor="@color/feedback_black_30"
                android:textColorHint="@color/feedback_common_hint_txt_color"
                android:id="@+id/desc_view"
                android:background="@drawable/feedback_label_bg_cyan"
                android:paddingTop="@dimen/dimen_margin_20dp"
                android:paddingBottom="@dimen/dimen_margin_22dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_marginTop="15dp"
                android:minHeight="150dp"
                android:hint="@string/feedback_hint"
                android:maxLines="500"
                android:inputType="textMultiLine"
                app:layout_constraintTop_toBottomOf="@+id/tag_view"
                style="@style/FeedbackEdit"/>
            <TextView
                android:textSize="12.7sp"
                android:textColor="@color/feedback_black_30"
                android:id="@+id/txt_num_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dimen_margin_5dp"
                android:text="0/500"
                android:layout_marginEnd="12dp"
                app:layout_constraintBottom_toBottomOf="@+id/desc_view"
                app:layout_constraintEnd_toEndOf="@+id/desc_view"/>
            <View
                android:id="@+id/divider2"
                android:background="@color/feedback_item_divide_color"
                android:layout_width="match_parent"
                android:layout_height="@dimen/feedback_item_divide_height"
                android:layout_marginTop="@dimen/dimen_margin_26dp"
                android:layout_marginStart="@dimen/dimen_margin_26dp"
                android:layout_marginEnd="@dimen/dimen_margin_26dp"
                app:layout_constraintTop_toBottomOf="@+id/desc_view"/>
            <TextView
                android:id="@+id/label11"
                android:layout_width="0dp"
                android:layout_marginTop="@dimen/dimen_margin_26dp"
                android:text="@string/feedback_crop_tip"
                android:paddingEnd="@dimen/feedback_margin"
                android:layout_marginStart="@dimen/dimen_margin_14dp"
                android:layout_marginEnd="@dimen/dimen_margin_14dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/divider2"
                style="@style/FeedbackDesc"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/image_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13.3dp"
                android:paddingStart="@dimen/feedback_margin"
                android:paddingEnd="@dimen/feedback_margin_1dp"
                android:layout_marginStart="@dimen/dimen_margin_12dp"
                android:layout_marginEnd="@dimen/dimen_margin_12dp"
                android:nestedScrollingEnabled="false"
                app:layout_constraintTop_toBottomOf="@+id/label11"/>
            <View
                android:id="@+id/divider3"
                android:background="@color/feedback_item_divide_color"
                android:layout_width="match_parent"
                android:layout_height="@dimen/feedback_item_divide_height"
                android:layout_marginTop="@dimen/dimen_margin_26dp"
                android:layout_marginStart="@dimen/dimen_margin_26dp"
                android:layout_marginEnd="@dimen/dimen_margin_26dp"
                app:layout_constraintTop_toBottomOf="@+id/image_view"/>
            <TextView
                android:gravity="start"
                android:id="@+id/label4"
                android:layout_width="0dp"
                android:layout_marginTop="@dimen/dimen_margin_26dp"
                android:text="@string/feedback_connect_tip"
                android:paddingEnd="@dimen/feedback_margin"
                android:layout_marginStart="@dimen/dimen_margin_14dp"
                android:layout_marginEnd="@dimen/dimen_margin_14dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/divider3"
                style="@style/FeedbackDesc"/>
            <EditText
                android:textSize="@dimen/size_16_7"
                android:textColor="@color/feedback_black_30"
                android:textColorHint="@color/feedback_black_30"
                android:gravity="center_vertical"
                android:id="@+id/phone_view"
                android:background="@drawable/feedback_label_bg_cyan"
                android:layout_height="53dp"
                android:singleLine="true"
                android:maxLength="18"
                android:inputType="phone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/label4"
                style="@style/FeedbackEdit"/>
            <EditText
                android:textSize="@dimen/size_16_7"
                android:textColor="@color/feedback_black_30"
                android:textColorHint="@color/feedback_black_30"
                android:gravity="center_vertical"
                android:id="@+id/mail_view"
                android:background="@drawable/feedback_label_bg_cyan"
                android:layout_height="53dp"
                android:layout_marginTop="6dp"
                android:singleLine="true"
                android:maxLength="30"
                android:inputType="textEmailAddress"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/phone_view"
                style="@style/FeedbackEdit"/>
            <View
                android:id="@+id/divider7"
                android:background="@color/feedback_item_divide_color"
                android:layout_width="match_parent"
                android:layout_height="@dimen/feedback_item_divide_height"
                android:layout_marginTop="@dimen/dimen_margin_26dp"
                android:layout_marginStart="@dimen/dimen_margin_26dp"
                android:layout_marginEnd="@dimen/dimen_margin_26dp"
                app:layout_constraintTop_toBottomOf="@+id/mail_view"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:orientation="horizontal"
                android:id="@+id/logtext_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/dimen_margin_26dp"
                app:layout_constraintTop_toBottomOf="@+id/divider7">
                <TextView
                    android:id="@+id/upload_device_log_text_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/feedback_device_log_title"
                    android:layout_marginStart="@dimen/dimen_margin_14dp"
                    android:layout_marginEnd="@dimen/dimen_margin_14dp"
                    app:layout_constraintStart_toStartOf="parent"
                    style="@style/FontNormal.12sp"/>
                <TextView
                    android:gravity="left"
                    android:id="@+id/upload_device_log_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine"
                    android:layout_marginStart="@dimen/dimen_margin_14dp"
                    android:layout_marginEnd="@dimen/dimen_margin_20dp"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/upload_device_log_text_title"
                    style="@style/FontNormal.12sp"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:orientation="horizontal"
                android:id="@+id/logapp_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/dimen_margin_16dp"
                android:layout_marginStart="@dimen/dimen_margin_18dp"
                android:layout_marginEnd="@dimen/dimen_margin_18dp"
                app:layout_constraintTop_toBottomOf="@+id/logtext_layout">
                <TextView
                    android:id="@+id/text_app"
                    android:layout_width="@dimen/dimen_margin_200dp"
                    android:layout_height="match_parent"
                    android:text="@string/feedback_upload_error_log"
                    style="@style/FontNormal.16sp"/>
                <CheckedTextView
                    android:id="@+id/logapp_view"
                    android:layout_marginTop="16.3dp"
                    android:checked="false"
                    app:layout_constraintEnd_toEndOf="parent"
                    style="@style/FeedbackLog"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:id="@+id/upload_view"
                android:layout_marginTop="@dimen/dimen_margin_26dp"
                android:text="@string/feedback_upload"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/logapp_layout"
                style="@style/CommonBtn.Red"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </miuix.core.widget.NestedScrollView>
</miuix.springback.view.SpringBackLayout>
