<?xml version="1.0" encoding="utf-8"?>
<miuix.springback.view.SpringBackLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_find_device_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:scrollableView="@+id/scrollview">
    <miuix.core.widget.NestedScrollView
        android:id="@+id/scrollview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.xiaomi.fitness.devicesettings.huami.vibratemode.DeviceImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/device_view"
                android:layout_width="@dimen/dimen_margin_200dp"
                android:layout_height="@dimen/dimen_margin_200dp"
                android:layout_marginTop="@dimen/dimen_margin_50dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/text_size_16"
                android:textColor="@color/text_color"
                android:id="@+id/status_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_18dp"
                android:text="@string/device_settings_find_device_remind_start"
                android:paddingStart="@dimen/page_content_padding_horizontal_large"
                android:paddingEnd="@dimen/page_content_padding_horizontal_large"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/device_view"/>
            <Button
                android:id="@+id/start_find"
                android:layout_width="0dp"
                android:layout_height="@dimen/common_btn_height"
                android:text="@string/device_settings_find_device"
                android:layout_marginEnd="@dimen/dimen_margin_0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/stop_find"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                style="@style/CommonBtn.Normal"/>
            <Button
                android:enabled="false"
                android:id="@+id/stop_find"
                android:layout_width="0dp"
                android:layout_height="@dimen/common_btn_height"
                android:text="@string/device_settings_find_device_remind_stop"
                android:layout_marginStart="@dimen/page_extra_padding_horizontal_large"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/start_find"
                style="@style/CommonBtn.Normal"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </miuix.core.widget.NestedScrollView>
</miuix.springback.view.SpringBackLayout>
