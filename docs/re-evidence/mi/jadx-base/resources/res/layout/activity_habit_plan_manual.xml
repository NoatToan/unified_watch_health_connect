<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_habit_plan_manual_0"
    android:background="@color/page_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.xiaomi.fitness.training_plan_export.widget.TrainingPlanTitleBar
        android:id="@+id/titlebar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/title_bar_height"
        android:layout_marginTop="@dimen/dimen_margin_36dp"
        android:layout_marginHorizontal="21dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/date_select_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_10dp"
        android:layout_marginHorizontal="@dimen/dimen_margin_12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titlebar"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/sport_value_container"
        android:background="@drawable/habit_card_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="@dimen/dimen_margin_12dp"
        app:layout_constraintTop_toBottomOf="@+id/date_select_layout">
        <TextView
            android:id="@+id/sport_value_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/training_plan_habit_manual_distance"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/habit_main_textStyle"/>
        <View
            android:id="@+id/divider2"
            android:layout_width="match_parent"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@+id/sport_value_label"
            style="@style/habit_dividerStyle"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/distance_input_root"
            android:background="@drawable/habit_sport_value_manual_bg"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginHorizontal="@dimen/dimen_margin_12dp"
            app:layout_constraintTop_toBottomOf="@+id/divider2">
            <EditText
                android:textSize="24sp"
                android:textColor="@color/text_color"
                android:id="@+id/value_input"
                android:background="@null"
                android:focusableInTouchMode="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="30dp"
                android:inputType="numberDecimal"
                android:textCursorDrawable="@drawable/habit_manual_cursor_color"
                android:fontFamily="@font/misanslatin_demibold"
                android:layout_marginStart="12dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/text_color"
                android:id="@+id/value_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:fontFamily="@font/misanslatin_regular"
                app:layout_constraintBaseline_toBaselineOf="@+id/value_input"
                app:layout_constraintLeft_toRightOf="@+id/value_input"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:paddingBottom="30dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/confirm"
            android:background="@drawable/bottom_button_selector"
            android:layout_width="306dp"
            android:layout_height="44dp"
            android:text="@string/confirm"
            style="@style/FontMedium"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
