<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/rootView"
    android:tag="layout/layout_data_detail_item_view_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/value_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="24sp"
            android:textColor="@color/white"
            android:gravity="start|bottom"
            android:id="@+id/value_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:autoSizeTextType="uniform"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/text_color_60"
            android:layout_gravity="bottom"
            android:id="@+id/unit_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_margin_2dp"/>
        <TextView
            android:textSize="9sp"
            android:layout_gravity="bottom"
            android:id="@+id/level_icon"
            android:paddingTop="@dimen/dimen_margin_1dp"
            android:paddingBottom="@dimen/dimen_margin_1dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dimen_margin_2dp"
            android:paddingStart="@dimen/dimen_margin_3dp"
            android:paddingEnd="@dimen/dimen_margin_3dp"
            android:layout_marginStart="@dimen/dimen_margin_1dp"
            android:layout_marginEnd="@dimen/dimen_margin_3dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/name_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/value_layout">
        <TextView
            android:textSize="@dimen/dimen_12sp"
            android:textColor="@color/white_80_transparent"
            android:id="@+id/name_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_weight="10"
            android:fontFamily="@style/FontMedium"/>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:id="@+id/img_detail_guide_layout"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minWidth="12sp">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/img_detail_guide"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/right_arrow_icon"
                android:layout_marginStart="@dimen/dimen_margin_2dp"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
