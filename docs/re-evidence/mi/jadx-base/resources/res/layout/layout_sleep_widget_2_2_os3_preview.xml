<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@android:id/background"
    android:background="@drawable/widget_default_corners_background_radius_20"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:maxWidth="170dp"
    android:maxHeight="170dp">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@android:id/widget_frame"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="14"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="136">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="13"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="42">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="96">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="#4b5ef6"
                        android:gravity="start|center_vertical"
                        android:id="@+id/widgetSleepTitle"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:text="@string/widget_sleep_title"
                        android:layout_weight="24"
                        android:autoSizeTextType="uniform"
                        android:autoSizeStepGranularity="0.2sp"
                        android:autoSizeMinTextSize="2sp"
                        android:autoSizeMaxTextSize="16sp"
                        android:textFontWeight="450"/>
                    <TextView
                        android:textSize="13.87sp"
                        android:textColor="@color/text_color"
                        android:gravity="start|center_vertical"
                        android:id="@+id/widgetSleepValue"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:text="@string/widget_start_record"
                        android:maxLines="1"
                        android:layout_weight="18"
                        android:importantForAccessibility="no"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="2sp"
                        android:autoSizeMaxTextSize="13.87sp"
                        android:textFontWeight="380"/>
                </LinearLayout>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/img_main"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:src="@drawable/widget_sleep_bed_2_1_os3"
                    android:adjustViewBounds="true"
                    android:layout_weight="36"
                    android:importantForAccessibility="no"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"/>
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="26"/>
            <ImageView
                android:id="@+id/img_sleep_state"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:src="@drawable/bg_card_5percent_dark_4radius"
                android:scaleType="fitXY"
                android:minHeight="60dp"
                android:layout_weight="52"
                android:importantForAccessibility="no"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="2"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="12"
                android:layoutDirection="ltr">
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/widget_sleep_time"
                    android:gravity="start|center_vertical"
                    android:id="@+id/tv_sleep_start"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/data_xaxis_time_0"
                    android:layout_weight="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeStepGranularity="0.2sp"
                    android:autoSizeMinTextSize="2sp"
                    android:autoSizeMaxTextSize="10sp"
                    android:textFontWeight="380"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/widget_sleep_time"
                    android:gravity="end|center_vertical"
                    android:id="@+id/tv_sleep_end"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/data_xaxis_time_24"
                    android:layout_weight="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeStepGranularity="0.2sp"
                    android:autoSizeMinTextSize="2sp"
                    android:autoSizeMaxTextSize="10sp"
                    android:textFontWeight="380"/>
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="12"/>
        </LinearLayout>
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="12"/>
    </LinearLayout>
</LinearLayout>
