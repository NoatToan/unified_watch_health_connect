<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_sport_share_slogan_view_0"
    android:background="@color/transparent"
    android:paddingBottom="25dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/page_extra_padding_horizontal_large"
    android:layout_marginEnd="@dimen/page_extra_padding_horizontal_large">
    <TextView
        android:textSize="@dimen/font_11"
        android:textColor="@color/white_90"
        android:id="@+id/timeTxt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_3dp"
        android:shadowColor="@color/black_40_transparent"
        android:shadowDy="2"
        android:shadowRadius="2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/FontNormal"/>
    <TextView
        android:textSize="26.67sp"
        android:textColor="@color/white"
        android:id="@+id/sloganTxt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:shadowColor="@color/black_40_transparent"
        android:shadowDy="2"
        android:shadowRadius="2"
        android:fontFamily="@font/misanslatin_demibold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/timeTxt"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/white"
        android:id="@+id/sportValueTxt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_2dp"
        android:shadowColor="@color/black_40_transparent"
        android:shadowDy="2"
        android:shadowRadius="2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sloganTxt"
        style="@style/FontNormal"/>
</androidx.constraintlayout.widget.ConstraintLayout>
