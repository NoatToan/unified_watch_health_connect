<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:tag="layout/device_settings_fragment_widget_group_edit_0"
    android:background="@color/device_settings_widget_manager_page_bg"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.xiaomi.fitness.devicesettings.bluttooth.widget.view.WidgetGroupView
                android:layout_gravity="center_horizontal"
                android:id="@+id/widget_group"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_marginTop="39dp"
                android:layout_marginBottom="34dp"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_function_list"
        android:background="@color/device_settings_widget_manager_page_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/page_padding_horizontal_large"/>
</LinearLayout>
