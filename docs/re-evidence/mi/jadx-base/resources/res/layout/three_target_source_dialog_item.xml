<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/dimen_margin_18dp">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/dimen_margin_15dp">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/data_source_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_margin_16dp">
            <TextView
                android:textSize="@dimen/text_size_16"
                android:textColor="@color/text_color"
                android:id="@+id/data_source_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/unit_hour"
                style="@style/FontNormal"/>
            <TextView
                android:textSize="@dimen/text_size_12"
                android:textColor="@color/text_color_40"
                android:id="@+id/data_source_current"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/health_target_data_source_current_device"
                style="@style/FontNormal"/>
        </LinearLayout>
    </LinearLayout>
    <View
        android:id="@+id/data_source_divider"
        android:background="@color/text_color_10"
        android:layout_width="match_parent"
        android:layout_height="0.3dp"/>
</LinearLayout>
