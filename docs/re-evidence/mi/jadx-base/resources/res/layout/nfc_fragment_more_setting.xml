<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/layoutView"
    android:tag="layout/nfc_fragment_more_setting_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/page_content_padding_horizontal_large"
    android:paddingEnd="@dimen/page_content_padding_horizontal_large">
    <com.xiaomi.fitness.nfc.widget.TSMSetRightArrowView
        android:id="@+id/cardNoView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:arrow_desShow="true"
        app:arrow_lineShow="false"
        app:arrow_name="@string/nfc_common_notification"
        app:arrow_rightValue_text="@string/nfc_nextpay_more_settings_copy_no"/>
    <com.xiaomi.fitness.nfc.widget.SetRightArrowView
        android:id="@+id/recordView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:arrow_desShow="false"
        app:arrow_lineShow="false"
        app:arrow_name="@string/nfc_card_detail_more_settings_trade_record"/>
    <com.xiaomi.fitness.nfc.widget.SetRightArrowView
        android:id="@+id/lntPhoneView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:arrow_desShow="false"
        app:arrow_lineShow="false"
        app:arrow_name="@string/nfc_card_detail_more_settings_trade_record"/>
    <com.xiaomi.fitness.nfc.widget.SetRightArrowView
        android:id="@+id/lntFQAView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:arrow_desShow="false"
        app:arrow_lineShow="false"
        app:arrow_name="@string/nfc_card_detail_more_settings_trade_record"/>
    <com.xiaomi.fitness.nfc.widget.SetRightArrowView
        android:id="@+id/returnCardView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:arrow_desShow="false"
        app:arrow_lineShow="false"
        app:arrow_name="@string/nfc_retrun_card"/>
    <com.xiaomi.fitness.nfc.widget.SetRightArrowView
        android:id="@+id/set_notify_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:arrow_desShow="false"
        app:arrow_lineShow="false"
        app:arrow_name="@string/nfc_nextpay_more_settings_balance_tips"
        app:arrow_rightValueShow="true"/>
    <com.xiaomi.fitness.nfc.widget.SetRightArrowView
        android:id="@+id/set_help_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:arrow_desShow="false"
        app:arrow_lineShow="false"
        app:arrow_name="@string/nfc_nextpay_more_settings_help"/>
    <com.xiaomi.fitness.nfc.widget.SetRightArrowView
        android:id="@+id/returnSztCardView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:arrow_desShow="false"
        app:arrow_lineShow="false"
        app:arrow_name="@string/nfc_retrun_card_service"/>
    <com.xiaomi.fitness.nfc.widget.SetRightArrowView
        android:id="@+id/openLntAppView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:nfc_arrow_desShow="false"
        app:nfc_arrow_icon="@drawable/nfc_lnt_icon"
        app:nfc_arrow_lineShow="false"
        app:nfc_arrow_name="@string/nfc_open_lnt_app"/>
</LinearLayout>
