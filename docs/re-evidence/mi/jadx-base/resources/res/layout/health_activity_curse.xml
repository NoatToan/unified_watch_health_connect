<?xml version="1.0" encoding="utf-8"?>
<miuix.springback.view.SpringBackLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/health_activity_curse_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:scrollableView="@+id/scrollView">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_content"
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/health_detail_page_common_margin_vertical"
            android:layout_marginHorizontal="@dimen/health_detail_page_common_margin_horizontal">
            <com.xiaomi.fitness.health.curse.view.CurseDataHolder
                android:id="@+id/dataView"
                android:background="@drawable/shape_data_item_bg"
                android:paddingTop="20dp"
                android:paddingBottom="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.xiaomi.fitness.health.curse.view.CurseNoticeCardView
                android:id="@+id/intelligentPredictSwitchView"
                android:visibility="gone"
                android:layout_height="wrap_content"
                app:healthCurseNoticeArrowTitle="@string/health_woman_intelligent_predict_on"
                app:healthCurseNoticeArrowTitleShow="true"
                app:healthCurseNoticeSubTitle="@string/health_women_intelligent_predict_switch_subtitle"
                app:healthCurseNoticeSubTitleSize="14sp"
                app:healthCurseNoticeTitle="@string/health_women_intelligent_predict_title"
                app:layout_constraintTop_toBottomOf="@+id/dataView"
                style="@style/HealthCurseSet"/>
            <com.xiaomi.fitness.health.curse.view.CurseNoticeCardView
                android:id="@+id/intelligentPredictBindView"
                android:visibility="gone"
                android:layout_height="wrap_content"
                app:healthCurseNoticeArrowTitle="@string/health_woman_intelligent_predict_bind"
                app:healthCurseNoticeArrowTitleShow="true"
                app:healthCurseNoticeSubTitle="@string/health_women_intelligent_predict_bind_subtitle"
                app:healthCurseNoticeSubTitleSize="14sp"
                app:healthCurseNoticeTitle="@string/health_women_intelligent_predict_title"
                app:layout_constraintTop_toBottomOf="@+id/intelligentPredictSwitchView"
                style="@style/HealthCurseSet"/>
            <com.xiaomi.fitness.health.curse.view.CurseNoticeCardView
                android:id="@+id/openHrAndTempMonitorView"
                android:visibility="gone"
                android:layout_height="wrap_content"
                app:healthCurseNoticeArrowTitle="@string/health_woman_open_hr_and_temp_arrow_title"
                app:healthCurseNoticeArrowTitleShow="true"
                app:healthCurseNoticeSubTitle="@string/health_women_open_hr_temp_monitor_subtitle"
                app:healthCurseNoticeSubTitleSize="14sp"
                app:healthCurseNoticeTitle="@string/health_women_open_hr_temp_monitor_title"
                app:layout_constraintTop_toBottomOf="@+id/intelligentPredictBindView"
                style="@style/HealthCurseSet"/>
            <com.xiaomi.fitness.health.curse.view.CurseResetCardView
                android:id="@+id/resetView"
                android:visibility="gone"
                android:layout_height="@dimen/dimen_margin_50dp"
                app:layout_constraintTop_toBottomOf="@+id/openHrAndTempMonitorView"
                style="@style/HealthCurseSet"/>
            <com.xiaomi.fitness.health.curse.view.CurseResetCardView
                android:id="@+id/predictingView"
                android:visibility="gone"
                android:layout_height="@dimen/dimen_margin_50dp"
                app:layout_constraintTop_toBottomOf="@+id/resetView"
                style="@style/HealthCurseSet"/>
            <com.xiaomi.fitness.health.curse.view.CurseSymptomHolder
                android:id="@+id/symptomView"
                app:layout_constraintTop_toBottomOf="@+id/predictingView"
                style="@style/HealthCurseHolder"/>
            <com.xiaomi.fitness.health.curse.view.CurseTempViewHolder
                android:id="@+id/curse_temp_holder"
                android:background="@drawable/shape_data_item_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_12dp"
                app:layout_constraintTop_toBottomOf="@+id/symptomView"/>
            <com.xiaomi.fitness.view.HealthBannerCardSetView
                android:id="@+id/health_banner_card_set"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@+id/curse_temp_holder"/>
            <com.xiaomi.fitness.health.curse.view.CurseMoreView
                android:id="@+id/knownView"
                android:layout_height="60dp"
                app:healthSettingArrow="true"
                app:healthSettingTitle="@string/health_curse_forecast_tip"
                app:layout_constraintTop_toBottomOf="@+id/health_banner_card_set"
                style="@style/HealthCurseSet"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</miuix.springback.view.SpringBackLayout>
