<?xml version="1.0" encoding="utf-8"?>
<com.mi.health.course.widget.CourseLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/course_layout"
    android:tag="layout/eco_course_activity_video_0"
    android:background="@color/common_black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <SurfaceView
        android:layout_gravity="center"
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/infoView"
            android:background="@drawable/course_info_dark"
            android:padding="18dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:minWidth="@dimen/video_info_minute_width"
            android:layout_marginStart="31dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="27sp"
                android:textColor="@color/common_black"
                android:id="@+id/timeView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:fontFamily="@font/misanslatin_demibold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.mi.health.course.widget.CircleProgressBar
                android:id="@+id/progressView"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginBottom="2dp"
                app:layout_constraintBottom_toBottomOf="@+id/timeView"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/timeView"
                app:layout_constraintTop_toTopOf="@+id/timeView"
                app:progress="0"
                app:progressBgColor="#33000000"
                app:progressColor="@color/common_black"
                app:progressStrokeWidth="4dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/data_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/timeView"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <ImageView
            android:id="@+id/wearView"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/course_device_bottom"
            android:src="@drawable/course_band_dark"
            android:layout_marginStart="@dimen/course_device_left"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <ImageView
            android:id="@+id/sportView"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/course_device_bottom"
            android:src="@drawable/course_gms_dark"
            android:layout_marginStart="37dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/wearView"
            app:layout_goneMarginStart="@dimen/course_device_left"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/mask_group"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="maskBottomView,maskTopView"/>
        <View
            android:id="@+id/maskTopView"
            android:background="@drawable/course_video_mask_top_light"
            android:layout_width="match_parent"
            android:layout_height="150dp"/>
        <View
            android:id="@+id/maskBottomView"
            android:background="@drawable/course_video_mask_bottom_light"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            app:layout_constraintBottom_toBottomOf="parent"/>
        <View
            android:id="@+id/casting_bg"
            android:background="@color/common_black"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/pauseGroup"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="pauseView,preView,nextView"/>
        <ImageView
            android:id="@+id/pauseView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/course_video_pause"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/preView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/course_video_pre"
            android:layout_marginEnd="67dp"
            app:layout_constraintBottom_toBottomOf="@+id/pauseView"
            app:layout_constraintRight_toLeftOf="@+id/pauseView"
            app:layout_constraintTop_toTopOf="@+id/pauseView"/>
        <ImageView
            android:id="@+id/nextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/course_video_next"
            android:layout_marginStart="67dp"
            app:layout_constraintBottom_toBottomOf="@+id/pauseView"
            app:layout_constraintLeft_toRightOf="@+id/pauseView"
            app:layout_constraintTop_toTopOf="@+id/pauseView"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/stopGroup"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="stopView,continueView"/>
        <ImageView
            android:id="@+id/stopView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/course_video_stop"
            app:layout_constraintBottom_toBottomOf="@+id/pauseView"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/continueView"
            app:layout_constraintTop_toTopOf="@+id/pauseView"/>
        <ImageView
            android:id="@+id/continueView"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/course_video_start"
            android:layout_marginStart="67dp"
            app:layout_constraintBottom_toBottomOf="@+id/pauseView"
            app:layout_constraintLeft_toRightOf="@+id/stopView"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/pauseView"/>
        <View
            android:id="@+id/clarityBg"
            android:background="@drawable/course_clarity_bg"
            android:layout_width="82dp"
            android:layout_height="33dp"
            android:layout_marginTop="39dp"
            android:layout_marginEnd="30dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/common_white"
            android:gravity="center"
            android:id="@+id/clarityCurView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/course_video_720"
            app:layout_constraintBottom_toBottomOf="@+id/clarityBg"
            app:layout_constraintEnd_toEndOf="@+id/clarityBg"
            app:layout_constraintStart_toStartOf="@+id/clarityBg"
            app:layout_constraintTop_toTopOf="@+id/clarityBg"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/common_white"
            android:gravity="center"
            android:id="@+id/clarity2View"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:text="@string/course_video_1080"
            app:layout_constraintStart_toStartOf="@+id/clarityCurView"
            app:layout_constraintTop_toBottomOf="@+id/clarityBg"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/common_white"
            android:gravity="center"
            android:id="@+id/clarity1View"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:layout_marginBottom="16dp"
            android:text="@string/course_video_4k"
            app:layout_constraintStart_toStartOf="@+id/clarityCurView"
            app:layout_constraintTop_toBottomOf="@+id/clarity2View"/>
        <ImageView
            android:id="@+id/castView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/course_cast_white"
            android:layout_marginEnd="29dp"
            app:layout_constraintBottom_toBottomOf="@+id/clarityBg"
            app:layout_constraintEnd_toStartOf="@+id/clarityBg"
            app:layout_constraintTop_toTopOf="@+id/clarityBg"/>
        <ImageView
            android:id="@+id/linkView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/course_link_white"
            android:layout_marginEnd="29dp"
            app:layout_constraintBottom_toBottomOf="@+id/castView"
            app:layout_constraintEnd_toStartOf="@+id/castView"
            app:layout_constraintTop_toTopOf="@+id/castView"/>
        <TextView
            android:textSize="133sp"
            android:textColor="@color/common_white"
            android:gravity="center"
            android:id="@+id/starter_view"
            android:background="#66000000"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="3"/>
        <View
            android:id="@+id/modestyView"
            android:background="@color/common_black"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.mi.health.course.widget.CourseLayout>
