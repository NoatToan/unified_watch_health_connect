<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_3"
        android:layout_marginStart="@dimen/dimen_margin_20dp"
        android:layout_marginEnd="@dimen/size_30">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/font_14"
                android:textColor="@color/text_color"
                android:id="@+id/txtValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:autoSizeTextType="uniform"
                style="@style/FontMedium"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/title_arrow"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_7"/>
            <TextView
                android:textSize="10sp"
                android:textColor="#ff5050"
                android:id="@+id/abnormalMarkingTextView"
                android:background="@drawable/health_check_bg_abnormal_mark"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/health_abnormal"
                android:layout_marginStart="5dp"
                android:paddingHorizontal="4dp"
                android:paddingVertical="2dp"
                android:textFontWeight="500"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/font_15"
            android:textColor="@color/text_color_80"
            android:id="@+id/txtDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            style="@style/FontMedium"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/font_30"
        android:layout_gravity="start|center_vertical"
        android:id="@+id/emptyView"
        android:paddingTop="@dimen/size_5"
        android:paddingBottom="@dimen/size_5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/chart_common_padding_start"
        android:layout_marginEnd="@dimen/size_30"
        android:autoSizeTextType="uniform"
        style="@style/FontMedium"/>
</FrameLayout>
