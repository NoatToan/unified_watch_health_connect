<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/login_activity_internal_test_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/dimen_20sp"
        android:textStyle="bold"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp"
        android:text="@string/login_internal_test_title"
        android:drawableTop="@drawable/login_internal_test_logo"
        android:drawablePadding="@dimen/dimen_margin_10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.xiaomi.fitness.widget.view.DividerView
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_30dp"
        android:layout_marginStart="@dimen/margin_27dp"
        android:layout_marginEnd="@dimen/margin_27dp"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dimen_margin_30dp"
        android:layout_marginBottom="@dimen/dimen_margin_14dp"
        app:layout_constraintBottom_toTopOf="@+id/bottom_divider"
        app:layout_constraintTop_toBottomOf="@+id/divider">
        <TextView
            android:textSize="@dimen/dimen_15sp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/login_internal_test_content"
            android:paddingStart="@dimen/margin_27dp"
            android:paddingEnd="@dimen/margin_27dp"/>
    </ScrollView>
    <com.xiaomi.fitness.widget.view.DividerView
        android:id="@+id/bottom_divider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_margin_10dp"
        app:layout_constraintBottom_toTopOf="@+id/user_experience"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/user_experience"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_14dp"
        android:layout_marginBottom="@dimen/login_margin_20dp"
        android:layout_marginStart="@dimen/dimen_margin_26dp"
        app:layout_constraintBottom_toTopOf="@+id/opration">
        <CheckBox
            android:layout_gravity="top"
            android:id="@+id/internal_agreement_radio"
            android:background="@drawable/login_selector_privacy_check"
            android:padding="5dp"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:checked="false"
            android:button="@null"/>
        <TextView
            android:textSize="@dimen/dimen_14sp"
            android:textColor="@color/login_black_60"
            android:autoLink="all"
            android:id="@+id/internal_test_agreement_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_internal_test_agreement"
            android:layout_marginStart="@dimen/dimen_margin_10dp"
            android:layout_marginEnd="26dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="bottom"
        android:orientation="horizontal"
        android:id="@+id/opration"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_27dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:textSize="@dimen/dimen_16sp"
            android:textColor="@color/login_black"
            android:gravity="center"
            android:id="@+id/exit_test"
            android:background="@drawable/selector_bottom_btn_native_bg"
            android:layout_width="0dp"
            android:layout_height="@dimen/common_btn_height"
            android:text="@string/login_internal_test_exit"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/dimen_margin_26dp"/>
        <TextView
            android:textSize="@dimen/dimen_16sp"
            android:textColor="@color/login_white"
            android:gravity="center"
            android:id="@+id/login_internal_test_continue"
            android:background="@drawable/selector_bottom_btn_positive_bg"
            android:layout_width="0dp"
            android:layout_height="@dimen/common_btn_height"
            android:text="@string/login_internal_test_continue"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/dimen_14sp"
            android:layout_marginEnd="@dimen/dimen_margin_26dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
