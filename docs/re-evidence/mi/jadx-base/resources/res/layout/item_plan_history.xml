<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/item_plan_history_0"
    android:background="@drawable/training_card_shape"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/dimen_margin_14dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_14dp">
        <TextView
            android:textSize="@dimen/dimen_16sp"
            android:textColor="@color/text_color"
            android:id="@+id/typeName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/misanslatin_regular"/>
        <ImageView
            android:id="@+id/medalImg"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="@dimen/dimen_margin_6dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_4dp">
        <TextView
            android:textSize="13sp"
            android:textColor="@color/text_color_30"
            android:id="@+id/dateRange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/misanslatin_regular"/>
        <View
            android:id="@+id/trainingDivider"
            android:background="@color/black_15"
            android:layout_width="1px"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="@dimen/dimen_margin_7dp"
            android:layout_marginVertical="3dp"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/text_color_30"
            android:id="@+id/totalDays"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/misanslatin_regular"/>
    </LinearLayout>
    <View
        android:background="@color/divider_color"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginVertical="@dimen/dimen_margin_20dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_margin_26dp"
        android:layout_marginHorizontal="@dimen/dimen_margin_6dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/dimen_12sp"
                android:textColor="@color/text_color"
                android:id="@+id/completionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/training_plan_ability_completion_percent_label"
                android:fontFamily="@font/misanslatin_regular"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/dimen_22sp"
                android:gravity="bottom"
                android:id="@+id/completion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_10dp"
                android:fontFamily="@font/misanslatin_medium"
                app:layout_constraintStart_toStartOf="@+id/completionLabel"
                app:layout_constraintTop_toBottomOf="@+id/completionLabel"/>
            <TextView
                android:textSize="@dimen/dimen_12sp"
                android:textColor="@color/text_color_30"
                android:id="@+id/completionUnit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="%"
                android:layout_marginStart="@dimen/dimen_margin_4dp"
                app:layout_constraintBaseline_toBaselineOf="@+id/completion"
                app:layout_constraintBottom_toBottomOf="@+id/completion"
                app:layout_constraintStart_toEndOf="@+id/completion"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/dimen_12sp"
                android:textColor="@color/text_color"
                android:id="@+id/totalDistanceLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/training_plan_ability_total_distance_label"
                android:fontFamily="@font/misanslatin_regular"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/dimen_22sp"
                android:textColor="@color/text_color"
                android:id="@+id/distance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_10dp"
                android:fontFamily="@font/misanslatin_medium"
                app:layout_constraintStart_toStartOf="@+id/totalDistanceLabel"
                app:layout_constraintTop_toBottomOf="@+id/totalDistanceLabel"/>
            <TextView
                android:textSize="@dimen/dimen_12sp"
                android:textColor="@color/text_color_30"
                android:id="@+id/distanceUnit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="km"
                android:layout_marginStart="@dimen/dimen_margin_4dp"
                app:layout_constraintBaseline_toBaselineOf="@+id/distance"
                app:layout_constraintBottom_toBottomOf="@+id/distance"
                app:layout_constraintStart_toEndOf="@+id/distance"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/dimen_12sp"
                android:textColor="@color/text_color"
                android:id="@+id/totalCalorieLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/training_plan_ability_total_calorie_label"
                android:fontFamily="@font/misanslatin_regular"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/dimen_22sp"
                android:textColor="@color/text_color"
                android:id="@+id/calorie"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_10dp"
                android:fontFamily="@font/misanslatin_medium"
                app:layout_constraintStart_toStartOf="@+id/totalCalorieLabel"
                app:layout_constraintTop_toBottomOf="@+id/totalCalorieLabel"/>
            <TextView
                android:textSize="@dimen/dimen_12sp"
                android:textColor="@color/text_color_30"
                android:id="@+id/calorieUnit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="kcal"
                android:layout_marginStart="@dimen/dimen_margin_4dp"
                app:layout_constraintBaseline_toBaselineOf="@+id/calorie"
                app:layout_constraintBottom_toBottomOf="@+id/calorie"
                app:layout_constraintStart_toEndOf="@+id/calorie"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</LinearLayout>
