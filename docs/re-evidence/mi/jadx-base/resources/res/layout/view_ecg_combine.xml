<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/fl_chart"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.xiaomi.fitness.chart.view.LineChartRecyclerView
        android:id="@+id/line_recycler"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_alignParentTop="true"
        app:barBorderColor="@color/black_60_transparent"
        app:barSpace="0"
        app:contentPaddingBottom="35dp"
        app:contentPaddingTop="0dp"
        app:displayNumbers="80"
        app:enableEndYAxisLabel="false"
        app:enableLineFill="false"
        app:enableScrollToScale="true"
        app:enableStartYAxisLabel="false"
        app:enableXAxisFirstGridLine="true"
        app:enableXAxisLineCircle="false"
        app:enableXAxisSecondGridLine="true"
        app:enableXAxisThirdGridLine="true"
        app:enableYAxisLineDash="false"
        app:layoutManagerReverseLayout="false"
        app:lineColor="@color/bar_chart_pink"
        app:lineStrokeWidth="4"
        app:recyclerPaddingRight="3dp"
        app:xAxisFirstDividerColor="@color/black_60_transparent"
        app:xAxisScaleDistance="8"
        app:xAxisSecondDividerColor="@color/black_60_transparent"
        app:yAxisLineColor="@color/black_60_transparent"/>
</androidx.appcompat.widget.LinearLayoutCompat>
