<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:tag="layout/activity_electronic_scale_claim_record_header_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="12sp"
        android:textColor="@color/text_color_40"
        android:id="@+id/tv_week"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/electronic_scale_week"
        android:layout_marginStart="26dp"/>
    <com.xiaomi.fitness.electronic.scale.widget.ClaimRecordsWeekRecyclerView
        android:id="@+id/week_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/text_color_40"
        android:id="@+id/tv_more"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/miuix_appcompat_actionbar_immersion_button_more_description"
        android:layout_marginStart="26dp"/>
</LinearLayout>
