<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/activity_ecg_landscape_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="10dp">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:id="@+id/fl_chart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/font_18"
            android:textColor="@color/text_color"
            android:id="@+id/tv_avg_hrm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:paddingHorizontal="44dp"
            style="@style/FontMedium"/>
        <com.xiaomi.fitness.chart.view.LineChartRecyclerView
            android:id="@+id/line_recycler"
            android:paddingTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:layout_marginHorizontal="24dp"
            app:barBorderColor="@color/black_60_transparent"
            app:barSpace="0"
            app:contentPaddingTop="0dp"
            app:displayNumbers="80"
            app:enableEndYAxisLabel="false"
            app:enableLineFill="false"
            app:enableScrollToScale="true"
            app:enableStartYAxisLabel="false"
            app:enableXAxisFirstGridLine="true"
            app:enableXAxisLineCircle="false"
            app:enableXAxisSecondGridLine="true"
            app:enableXAxisThirdGridLine="true"
            app:enableYAxisLineDash="false"
            app:layoutManagerReverseLayout="false"
            app:lineColor="@color/bar_chart_pink"
            app:lineStrokeWidth="4"
            app:recyclerPaddingRight="3dp"
            app:xAxisFirstDividerColor="@color/black_60_transparent"
            app:xAxisScaleDistance="8"
            app:xAxisSecondDividerColor="@color/black_60_transparent"
            app:yAxisLineColor="@color/black_60_transparent"/>
        <TextView
            android:textColor="@color/text_color_40"
            android:id="@+id/tv_desc"
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/health_n60_ecg_pdf_information"
            android:paddingHorizontal="44dp"
            style="@style/FontRegular.12sp"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.core.widget.NestedScrollView>
