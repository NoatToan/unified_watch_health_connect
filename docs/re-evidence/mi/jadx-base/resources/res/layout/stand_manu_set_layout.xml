<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/selector_round"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/stand_set_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/health_stand_manu_set"
        android:layout_marginStart="@dimen/margin_20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/text_color"
        android:id="@+id/stand_set_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_20"
        android:text="@string/health_stand_of_current_hour_not_completed"
        android:paddingEnd="5dp"
        android:layout_marginStart="@dimen/size_10"
        android:layout_marginEnd="@dimen/dimen_margin_20dp"
        app:layout_constraintEnd_toStartOf="@+id/stand_manual_set_btn"
        app:layout_constraintStart_toEndOf="@+id/stand_set_icon"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/FontMedium.14sp"/>
    <TextView
        android:textColor="@color/text_color_40"
        android:id="@+id/stand_set_time"
        android:paddingBottom="@dimen/margin_20dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:paddingEnd="5dp"
        android:layout_marginEnd="@dimen/dimen_margin_20dp"
        app:layout_constraintEnd_toStartOf="@+id/stand_manual_set_btn"
        app:layout_constraintStart_toStartOf="@+id/stand_set_title"
        app:layout_constraintTop_toBottomOf="@+id/stand_set_title"
        app:layout_constraintWidth_default="spread"
        style="@style/FontRegular.12sp"/>
    <TextView
        android:textColor="@color/stand_chart_display"
        android:id="@+id/stand_manual_set_btn"
        android:background="@drawable/health_stand_manually_set_bg_card_36cf6e"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/health_manually_set"
        android:layout_marginEnd="18dp"
        android:paddingHorizontal="@dimen/dimen_margin_16dp"
        android:paddingVertical="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
