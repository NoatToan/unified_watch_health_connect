<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_constraintHorizontal_weight="3">
    <TextView
        android:id="@+id/value1View"
        android:tag="layout/layout_share_data_0"
        app:layout_constraintStart_toStartOf="@+id/name1View"
        style="@style/ShareItemValue"/>
    <TextView
        android:id="@+id/value2View"
        android:tag="layout/layout_share_data_1"
        app:layout_constraintEnd_toEndOf="@+id/name2View"
        app:layout_constraintStart_toStartOf="@+id/name2View"
        style="@style/ShareItemValue"/>
    <TextView
        android:id="@+id/value3View"
        android:tag="layout/layout_share_data_2"
        app:layout_constraintEnd_toEndOf="parent"
        style="@style/ShareItemValue"/>
    <TextView
        android:gravity="start"
        android:id="@+id/name1View"
        android:tag="layout/layout_share_data_3"
        android:text="时间"
        android:textDirection="locale"
        android:textAlignment="gravity"
        app:layout_constraintEnd_toStartOf="@+id/name2View"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/value1View"
        style="@style/ShareItemName"/>
    <TextView
        android:gravity="center"
        android:id="@+id/name2View"
        android:tag="layout/layout_share_data_4"
        android:layout_width="0dp"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"
        app:layout_constraintEnd_toStartOf="@+id/name3View"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/name1View"
        app:layout_constraintTop_toBottomOf="@+id/value2View"
        style="@style/ShareItemName"/>
    <TextView
        android:gravity="end"
        android:id="@+id/name3View"
        android:tag="layout/layout_share_data_5"
        android:textDirection="locale"
        android:textAlignment="gravity"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/name2View"
        app:layout_constraintTop_toBottomOf="@+id/value3View"
        style="@style/ShareItemName"/>
</merge>
