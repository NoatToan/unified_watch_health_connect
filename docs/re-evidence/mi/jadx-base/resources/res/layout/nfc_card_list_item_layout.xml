<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/nfc_tsm_text_size_content_medium"
        android:textColor="@color/text_color_40"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/cardGroupNameView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="33dp"
        android:singleLine="true"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/cardItemLayoutView"
        android:background="@drawable/nfc_selector_list_item"
        android:paddingTop="15dp"
        android:paddingBottom="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/card_list_item_icon"
            android:layout_width="70dp"
            android:layout_height="44dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/nfc_card_list_item_text_margin_horizontal"
            android:layout_marginEnd="@dimen/nfc_card_list_item_text_margin_horizontal">
            <LinearLayout
                android:layout_gravity="start"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layoutDirection="rtl">
                <TextView
                    android:textSize="@dimen/nfc_tsm_text_size_content_small"
                    android:textColor="@color/common_btn_normal_red_bg_color"
                    android:id="@+id/card_list_item_card_sub_script"
                    android:background="@drawable/nfc_bg_card_list_item_0"
                    android:padding="3dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="3dp"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/card_list_item_default_card"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layoutDirection="ltr">
                    <TextView
                        android:textColor="@color/text_color"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/nfc_text_separator"
                        android:includeFontPadding="true"
                        style="@style/nfc_TextAppearance.List.Primary"/>
                    <TextView
                        android:textColor="@color/text_color"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/nfc_card_default_card"
                        android:includeFontPadding="true"
                        style="@style/nfc_TextAppearance.List.Primary"/>
                </LinearLayout>
                <TextView
                    android:textStyle="bold"
                    android:id="@+id/card_list_item_card_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:includeFontPadding="true"
                    style="@style/nfc_TextAppearance.List.Primary"/>
            </LinearLayout>
            <TextView
                android:textColor="@color/nfc_card_list_subtitle"
                android:ellipsize="end"
                android:id="@+id/card_list_item_card_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/nfc_card_list_item_text_margin_top"
                android:maxLines="2"
                android:includeFontPadding="false"
                style="@style/FontNormal.14sp"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/nfc_card_list_item_description_text_size"
            android:textColor="@color/nfc_card_list_desc"
            android:gravity="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/card_list_item_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/nfc_card_list_item_description_max_width"/>
        <ImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/card_list_item_right_arrow"
            android:duplicateParentState="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_base_right_arrow_icon"/>
    </LinearLayout>
</LinearLayout>
