<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/layout_endurance_pangu_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/page_content_padding_horizontal_large"
    android:paddingEnd="@dimen/page_content_padding_horizontal_large">
    <View
        android:id="@+id/dividerView"
        android:layout_width="match_parent"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/SettingsLineStyle"/>
    <TextView
        android:textColor="@color/text_color"
        android:id="@+id/title_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/device_settings_endurance_title"
        app:layout_constraintTop_toTopOf="@+id/dividerView"
        style="@style/FontMedium.18sp"/>
    <TextView
        android:textColor="@color/text_color_50"
        android:id="@+id/des_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/title_tv"
        style="@style/FontRegular.12sp"/>
    <com.xiaomi.fitness.baseui.widget.LevelBarView
        android:id="@+id/level_bar_view"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@+id/des_tv"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/text_color"
        android:gravity="center"
        android:id="@+id/normal_level_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/device_settings_endurance_normal_level"
        android:paddingStart="3dp"
        android:paddingEnd="3dp"
        app:layout_constraintEnd_toStartOf="@+id/light_level_tv"
        app:layout_constraintStart_toStartOf="@+id/level_bar_view"
        app:layout_constraintTop_toBottomOf="@+id/level_bar_view"
        style="@style/FontMedium"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/text_color"
        android:gravity="center"
        android:id="@+id/light_level_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/device_settings_endurance_light_level"
        android:paddingStart="3dp"
        android:paddingEnd="3dp"
        app:layout_constraintEnd_toStartOf="@+id/moderate_level_tv"
        app:layout_constraintStart_toEndOf="@+id/normal_level_tv"
        app:layout_constraintTop_toBottomOf="@+id/level_bar_view"
        style="@style/FontMedium"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/text_color"
        android:gravity="center"
        android:id="@+id/moderate_level_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/device_settings_endurance_moderate_level"
        android:paddingStart="3dp"
        android:paddingEnd="3dp"
        app:layout_constraintEnd_toStartOf="@+id/severe_level_tv"
        app:layout_constraintStart_toEndOf="@+id/light_level_tv"
        app:layout_constraintTop_toBottomOf="@+id/level_bar_view"
        style="@style/FontMedium"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/text_color"
        android:gravity="center"
        android:id="@+id/severe_level_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/device_settings_endurance_severe_level"
        android:paddingStart="3dp"
        android:paddingEnd="3dp"
        app:layout_constraintEnd_toEndOf="@+id/level_bar_view"
        app:layout_constraintStart_toEndOf="@+id/moderate_level_tv"
        app:layout_constraintTop_toBottomOf="@+id/level_bar_view"
        style="@style/FontMedium"/>
</androidx.constraintlayout.widget.ConstraintLayout>
