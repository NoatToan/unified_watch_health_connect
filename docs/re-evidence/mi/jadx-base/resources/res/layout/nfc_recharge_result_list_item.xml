<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:layout_width="match_parent"
    android:layout_height="@dimen/nfc_recharge_result_list_item_height"
    style="@style/Widget.ListView.Item.SingleLine">
    <TextView
        android:textSize="@dimen/nfc_recharge_result_list_item_text_size"
        android:textColor="@color/nfc_recharge_result_list_item_text_color"
        android:id="@+id/recharge_result_list_item_tv_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        style="@style/nfc_TextAppearance.List.Primary"/>
    <TextView
        android:textSize="@dimen/nfc_recharge_result_list_item_text_size"
        android:textColor="@color/nfc_recharge_result_list_item_text_color"
        android:gravity="end"
        android:id="@+id/recharge_result_list_item_tv_value"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_weight="1"
        style="@style/nfc_TextAppearance.List.Primary"/>
</LinearLayout>
