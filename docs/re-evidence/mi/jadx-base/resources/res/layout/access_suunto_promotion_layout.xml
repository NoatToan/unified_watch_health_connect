<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginHorizontal="@dimen/page_content_padding_horizontal_large">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dimen_16sp"
        android:textColor="@color/text_color"
        android:id="@+id/suunto_app_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/access_suunto_app"
        style="@style/FontMedium"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dimen_16sp"
        android:textColor="@color/text_color"
        android:id="@+id/suunto_app_paragraph"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/access_suunto_suunto_app_paragrpah"
        style="@style/FontNormal"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dimen_16sp"
        android:textColor="@color/text_color"
        android:id="@+id/training_partner_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_20dp"
        android:text="@string/access_training_partner"
        style="@style/FontMedium"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dimen_16sp"
        android:textColor="@color/text_color"
        android:id="@+id/training_partner_paragraph"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/access_suunto_training_partner_paragraph"
        style="@style/FontNormal"/>
    <ImageView
        android:id="@+id/bg_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_20dp"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dimen_16sp"
        android:textColor="@color/text_color"
        android:id="@+id/daily_well_being_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_20dp"
        android:text="@string/access_daily_well_being"
        style="@style/FontMedium"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dimen_16sp"
        android:textColor="@color/text_color"
        android:id="@+id/daily_well_being_title_paragraph"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/access_daily_well_being_paragraph"
        style="@style/FontNormal"/>
    <ImageView
        android:id="@+id/bg_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_20dp"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dimen_16sp"
        android:textColor="@color/text_color"
        android:id="@+id/outdoor_maps_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_20dp"
        android:text="@string/access_outdoor_maps"
        style="@style/FontMedium"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/text_color"
        android:id="@+id/outdoor_maps_paragraph"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/access_outdoor_maps_paragraph"
        style="@style/FontNormal"/>
    <ImageView
        android:id="@+id/bg_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_20dp"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dimen_16sp"
        android:id="@+id/connect_to_partners_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_20dp"
        android:text="@string/access_connect_to_partners"
        style="@style/FontMedium"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dimen_16sp"
        android:textColor="@color/text_color"
        android:id="@+id/connect_to_partners_paragraph"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/access_connected_partners_paragraph"
        style="@style/FontNormal"/>
    <ImageView
        android:id="@+id/bg_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_20dp"/>
</LinearLayout>
