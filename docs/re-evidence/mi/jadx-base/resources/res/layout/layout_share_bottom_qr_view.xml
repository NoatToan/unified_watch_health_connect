<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/rl_profile"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/rl_outer"
        android:background="@drawable/shape_card_round_3dp_white"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/rl_inner"
            android:background="@drawable/shape_share_download_app_bg"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/size_4_7"/>
        <com.xiaomi.fitness.detail.view.SportShareLongView
            android:id="@+id/shareLogo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true"
            app:logoColor="@color/common_black"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/common_black"
            android:id="@+id/txtAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/app_name"
            android:layout_alignParentTop="true"
            android:layout_marginStart="3dp"
            android:layout_toEndOf="@+id/shareLogo"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/common_black"
            android:id="@+id/txtAppDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/trail_share_app_desc"
            android:layout_below="@+id/txtAppName"
            android:layout_marginStart="3dp"
            android:layout_toEndOf="@+id/shareLogo"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/common_black"
            android:id="@+id/txtDownload"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_10"
            android:layout_marginBottom="@dimen/size_10"
            android:text="@string/trail_share_app_download"
            android:layout_below="@+id/shareLogo"
            android:layout_marginStart="@dimen/dimen_margin_12dp"
            android:layout_marginEnd="8dp"
            android:layout_alignParentStart="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="10dp">
        <com.xiaomi.fitness.widget.view.RoundImageView
            android:id="@+id/img_qr_code"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:scaleType="center"
            android:layout_centerVertical="true"
            app:cornerRadius="4dp"/>
    </RelativeLayout>
</LinearLayout>
