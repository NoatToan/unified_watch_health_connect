<?xml version="1.0" encoding="utf-8"?>
<miuix.springback.view.SpringBackLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/device_settings_fragment_weather_help_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:scrollableView="@+id/scrollview">
    <miuix.core.widget.NestedScrollView
        android:id="@+id/scrollview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/switch_black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="35dp"
                android:text="@string/device_settings_weather_setting_sync_error_reson"
                android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
                android:layout_marginEnd="@dimen/page_content_padding_horizontal_large"/>
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/switch_black"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="@string/device_settings_weather_setting_sync_error_reson_location"
                android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
                android:layout_marginEnd="@dimen/page_content_padding_horizontal_large"/>
            <Button
                android:id="@+id/openLocationPermissionView"
                android:layout_marginTop="26dp"
                android:text="@string/device_settings_common_has_open"
                style="@style/CommonBtn.Normal"/>
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/switch_black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="@string/device_settings_weather_setting_sync_error_reson_location_service"
                android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
                android:layout_marginEnd="@dimen/page_content_padding_horizontal_large"/>
            <Button
                android:id="@+id/openLocationServiceView"
                android:layout_marginTop="26dp"
                android:text="@string/device_settings_common_has_open"
                style="@style/CommonBtn.Normal"/>
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/switch_black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="@string/device_settings_weather_setting_sync_error_reson_sync"
                android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
                android:layout_marginEnd="@dimen/page_content_padding_horizontal_large"/>
        </LinearLayout>
    </miuix.core.widget.NestedScrollView>
</miuix.springback.view.SpringBackLayout>
