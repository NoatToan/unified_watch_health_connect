<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/electronic_scale_health_weight_evaluation_detail_item_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="14.67dp"
    android:paddingEnd="14.67dp">
    <View
        android:id="@+id/view_divider_top"
        android:background="@color/common_divider_bg_color"
        android:layout_width="0dp"
        android:layout_height="@dimen/electronic_scale_size_0_33"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/view_divider_vertical"
        android:background="@color/common_divider_bg_color"
        android:layout_width="@dimen/electronic_scale_size_0_33"
        android:layout_height="@dimen/electronic_scale_size_37_33"
        android:layout_marginTop="@dimen/electronic_scale_size_28_33"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_divider_top"/>
    <TextView
        android:id="@+id/tv_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_divider_top"
        style="@style/ElectronicScaleCardTextAppearance.ItemValue"/>
    <TextView
        android:id="@+id/tv_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_margin_2dp"
        app:layout_constraintBaseline_toBaselineOf="@+id/tv_value"
        app:layout_constraintEnd_toEndOf="@+id/view_divider_vertical"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/tv_value"
        style="@style/ElectronicScaleCardTextAppearance.ItemUnit"/>
    <TextView
        android:id="@+id/tv_index_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@+id/tv_value"
        app:layout_constraintTop_toBottomOf="@+id/tv_value"
        style="@style/ElectronicScaleCardTextAppearance.ItemStatus"/>
    <TextView
        android:id="@+id/tv_grade_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_20dp"
        android:layout_marginStart="@dimen/dimen_margin_18dp"
        app:layout_constraintStart_toEndOf="@+id/view_divider_vertical"
        app:layout_constraintTop_toTopOf="@+id/view_divider_top"
        style="@style/ElectronicScaleCardTextAppearance.ItemValue"/>
    <TextView
        android:id="@+id/tv_grade_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@+id/tv_grade_value"
        app:layout_constraintTop_toBottomOf="@+id/tv_grade_value"
        style="@style/ElectronicScaleCardTextAppearance.ItemStatus"/>
    <View
        android:id="@+id/view_divider_bottom"
        android:background="@color/common_divider_bg_color"
        android:layout_width="0dp"
        android:layout_height="@dimen/electronic_scale_size_0_33"
        android:layout_marginTop="@dimen/dimen_margin_20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_index_label"/>
    <com.xiaomi.fitness.baseui.widget.LevelBarView
        android:id="@+id/level_bar_view"
        android:layout_width="match_parent"
        android:layout_height="@dimen/electronic_scale_size_70"
        android:layout_marginTop="@dimen/size_30"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_divider_bottom"/>
    <androidx.recyclerview.widget.RecyclerView
        android:layout_gravity="center_horizontal"
        android:id="@+id/level_desc_recyclerview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/level_bar_view"/>
    <TextView
        android:id="@+id/tv_description"
        android:paddingBottom="@dimen/size_10"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/level_desc_recyclerview"
        style="@style/ElectronicScaleCardTextAppearance.ItemStatus"/>
</androidx.constraintlayout.widget.ConstraintLayout>
