<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/fragment_spo2_abnormal_chart_0"
    android:background="@color/page_bg"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.xiaomi.fitness.view.TitleBarAlphaView
        android:id="@+id/titleAlpha"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.xiaomi.fitness.view.DataTitleView
                    android:id="@+id/dataTitleView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <com.xiaomi.fitness.chart.view.BarChartRecyclerView
                    android:id="@+id/bar_recycler"
                    android:layout_height="311dp"
                    app:barChartMaxWidth="@dimen/size_5"
                    app:barChartRoundRectRadiusRatio="0.03"
                    app:barChartSegment="1"
                    app:chartColor="@color/spo_chart"
                    app:displayNumbers="48"
                    app:dynamicAdjustItemFillWidth="true"
                    app:enableStartYAxisLabel="false"
                    app:yAxisMaximum="100"
                    app:yAxisMinimum="60"
                    style="@style/ChartBaseStyle"/>
            </FrameLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_understand"
                android:tag="binding_1"
                android:background="@drawable/common_card_bg_white"
                android:paddingTop="@dimen/size_20"
                android:paddingBottom="@dimen/size_30"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/page_padding_horizontal_large">
                <TextView
                    android:textColor="@color/text_color"
                    android:id="@+id/tv_understand_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/health_spo2_know_more_on_low_spo2"
                    android:layout_marginHorizontal="@dimen/size_18"
                    style="@style/FontMedium.14sp"/>
                <include layout="@layout/layout_division_line"/>
                <TextView
                    android:textColor="@color/text_color_60"
                    android:id="@+id/tv_understand_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/health_spo2_understand_detail2"
                    android:layout_marginHorizontal="@dimen/size_18"
                    style="@style/FontRegular.14sp"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
