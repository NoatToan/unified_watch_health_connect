<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/layout_sleep_day_relative_distribute"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.xiaomi.fitness.chart.view.SleepChartRecyclerView
            android:id="@+id/chart_recycler"
            android:paddingTop="@dimen/size_86"
            android:layout_width="match_parent"
            android:layout_height="337dp"
            android:paddingStart="@dimen/size_18"
            android:paddingEnd="@dimen/size_18"
            app:contentPaddingBottom="@dimen/size_51"
            app:sleepItemHeight="@dimen/health_sleep_chart_item_height"
            style="@style/ChartBaseStyle"/>
        <com.xiaomi.fitness.view.DataTitleView
            android:id="@+id/dataTitleView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_15"
            android:layout_marginStart="@dimen/health_card_data_title_margin_start"/>
    </FrameLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_distribute"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"/>
</LinearLayout>
