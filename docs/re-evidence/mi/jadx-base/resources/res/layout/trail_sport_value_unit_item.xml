<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/font_22"
        android:id="@+id/txt_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:layout_alignParentTop="true"
        android:layout_marginStart="@dimen/dimen_margin_18dp"
        android:layout_alignParentStart="true"
        style="@style/FontLatinMedium"/>
    <TextView
        android:textSize="@dimen/font_12"
        android:textColor="@color/text_color"
        android:id="@+id/txt_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:layout_alignBaseline="@+id/txt_value"
        android:layout_alignParentTop="true"
        android:layout_marginStart="@dimen/dimen_margin_2dp"
        android:layout_toEndOf="@+id/txt_value"
        style="@style/FontMedium.12sp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:weightSum="1"
        android:layout_below="@+id/txt_value"
        android:layout_marginStart="@dimen/dimen_margin_18dp"
        android:layout_alignParentStart="true">
        <TextView
            android:textSize="@dimen/font_12"
            android:textColor="@color/text_color_40"
            android:id="@+id/txt_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:layout_weight="1"
            android:autoSizeTextType="uniform"
            android:autoSizeStepGranularity="0.5sp"
            android:autoSizeMinTextSize="7sp"
            android:autoSizeMaxTextSize="12sp"
            style="@style/FontRegular.12sp"/>
        <TextView
            android:textSize="9sp"
            android:gravity="center_vertical"
            android:id="@+id/level_icon"
            android:paddingTop="@dimen/dimen_margin_1dp"
            android:paddingBottom="@dimen/dimen_margin_1dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/dimen_margin_3dp"
            android:paddingEnd="@dimen/dimen_margin_3dp"
            android:layout_marginStart="@dimen/dimen_margin_1dp"
            android:layout_marginEnd="@dimen/dimen_margin_3dp"/>
        <ImageView
            android:gravity="center_vertical"
            android:layout_gravity="center"
            android:id="@+id/learn_more"
            android:background="@drawable/sport_detail_learn_more_auto_mirror"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_margin_1dp"
            android:layout_marginEnd="@dimen/dimen_margin_3dp"/>
    </LinearLayout>
</RelativeLayout>
