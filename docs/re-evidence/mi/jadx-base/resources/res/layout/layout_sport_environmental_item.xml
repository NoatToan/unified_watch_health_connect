<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/img_environmental"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="@dimen/dimen_margin_20dp"
        android:scaleType="fitCenter"
        android:layout_marginStart="20dp"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textColor="@color/text_color"
        android:gravity="center"
        android:id="@+id/txt_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:layout_alignParentTop="true"
        android:layout_marginStart="14dp"
        android:layout_toEndOf="@+id/img_environmental"
        style="@style/FontMedium.14sp"/>
    <TextView
        android:textSize="22sp"
        android:textColor="@color/text_color"
        android:id="@+id/txt_environmental_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:layout_below="@+id/txt_title"
        android:layout_centerHorizontal="true"
        style="@style/FontLatinMedium"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/text_color_40"
        android:id="@+id/txt_environmental_des"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_16dp"
        android:layout_marginBottom="@dimen/dimen_margin_20dp"
        android:layout_below="@+id/txt_environmental_value"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="@dimen/dimen_margin_20dp"
        android:layout_marginEnd="@dimen/dimen_margin_20dp"/>
</RelativeLayout>
