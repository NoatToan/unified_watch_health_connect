<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:tag="layout/activity_electronic_scale_visitor_weight_success_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_above="@+id/visitor_result"
        android:layout_centerHorizontal="true">
        <ImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/electronic_scale_icon_weight_success"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/green"
            android:id="@+id/result_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/electronic_scale_visitor_meaure_success"/>
        <TextView
            android:textColor="@color/text_color"
            android:id="@+id/result_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="100dp"
            android:text="@string/electronic_scale_visitor_meaure_result"/>
    </LinearLayout>
    <Button
        android:id="@+id/visitor_result"
        android:layout_marginBottom="27dp"
        android:text="@string/electronic_scale_visitor_meaure_result_btn"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="20dp"
        style="@style/CommonBtn.Primary"/>
</RelativeLayout>
