<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingBottom="@dimen/health_detail_page_common_margin_vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/vo2max_card"
        android:background="@drawable/selector_card_bg"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size_12"
        android:layout_marginHorizontal="@dimen/health_detail_page_common_margin_horizontal">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_vo2max_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"/>
        <View
            android:id="@+id/vo2max_divider"
            android:background="@color/common_divider_bg_color"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_0_33"
            android:layout_marginBottom="@dimen/size_10"
            android:layout_marginStart="@dimen/size_18"
            android:layout_marginEnd="@dimen/size_18"/>
        <com.xiaomi.fitness.baseui.widget.LevelBarView
            android:id="@+id/levelBarView"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_40"
            android:layout_marginStart="@dimen/size_18"
            android:layout_marginEnd="@dimen/size_18"/>
        <androidx.recyclerview.widget.RecyclerView
            android:layout_gravity="center_horizontal"
            android:id="@+id/level_desc_recyclerview"
            android:paddingBottom="@dimen/size_10"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/size_18"
            android:layout_marginEnd="@dimen/size_18"/>
    </LinearLayout>
    <com.xiaomi.fitness.view.CardUnderstandView
        android:id="@+id/understandCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/health_detail_page_common_margin_horizontal"
        android:layout_marginVertical="@dimen/health_detail_page_common_margin_vertical"
        app:txtUnderstand="@string/health_vo2max_understand_title"/>
</LinearLayout>
