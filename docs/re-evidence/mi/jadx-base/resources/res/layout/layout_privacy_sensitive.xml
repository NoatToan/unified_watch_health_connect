<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:id="@+id/xq_progress_dialog_linearlayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/dimen_16sp"
        android:textColor="@color/privacy_sensitive_black"
        android:gravity="center_horizontal"
        android:id="@+id/title_privacy"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="@string/privacy_sensitive_notify_title"
        android:layout_marginStart="@dimen/dimen_margin_40dp"
        android:layout_marginEnd="@dimen/dimen_margin_40dp"
        style="@style/TextAppearance.MiuiBold"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/privacy_sensitive_black_des"
        android:gravity="left"
        android:id="@+id/des_privacy"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/dimen_margin_14dp"
        android:text="@string/privacy_sensitive_notify_des"
        android:layout_marginStart="@dimen/dimen_margin_40dp"
        android:layout_marginEnd="@dimen/dimen_margin_40dp"/>
    <TextView
        android:textSize="@dimen/dimen_12sp"
        android:textColor="@color/privacy_sensitive_black_des"
        android:layout_gravity="left"
        android:id="@+id/permission_privacy"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/dimen_margin_10dp"
        android:layout_marginStart="@dimen/dimen_margin_40dp"
        android:layout_marginEnd="@dimen/dimen_margin_40dp"/>
</LinearLayout>
