<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/device_settings_fragment_sync_system_setting_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <miuix.springback.view.SpringBackLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scrollableView="@+id/scrollview">
        <miuix.core.widget.NestedScrollView
            android:id="@+id/scrollview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="center_horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="80dp"
                    android:layout_marginBottom="80dp"
                    android:src="@drawable/device_settings_sync_system"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/dimen_13sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/dimen_margin_10dp"
                    android:text="@string/device_sync_watch_and_phone_label"
                    android:layout_marginStart="@dimen/dimen_margin_28dp"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:gravity="center_vertical"
                    android:id="@+id/sync_wifi_view"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_margin_20dp"
                    android:layoutDirection="locale"
                    android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
                    android:layout_marginEnd="@dimen/page_content_padding_horizontal_large">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/dimen_16sp"
                        android:textStyle="bold"
                        android:textColor="@color/switch_black"
                        android:id="@+id/sync_wifi_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/device_settings_guide_sync_wlan_info"
                        android:layout_marginStart="@dimen/dimen_margin_12dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/sync_wifi_button"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <CheckBox
                        android:id="@+id/sync_wifi_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:button="@drawable/selector_common_circle_check"
                        android:contentDescription="@string/device_settings_guide_sync_wlan_info"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:gravity="center_vertical"
                    android:id="@+id/sync_not_disturb_view"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_margin_20dp"
                    android:layoutDirection="locale"
                    android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
                    android:layout_marginEnd="@dimen/page_content_padding_horizontal_large">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/dimen_16sp"
                        android:textStyle="bold"
                        android:textColor="@color/switch_black"
                        android:id="@+id/sync_not_disturb_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/device_settings_guide_sync_no_disturb_title"
                        android:layout_marginStart="@dimen/dimen_margin_12dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/sync_not_disturb_button"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <CheckBox
                        android:id="@+id/sync_not_disturb_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:button="@drawable/selector_common_circle_check"
                        android:contentDescription="@string/device_settings_guide_sync_no_disturb_title"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:gravity="center_vertical"
                    android:id="@+id/sync_calendar_view"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_margin_20dp"
                    android:layoutDirection="locale"
                    android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
                    android:layout_marginEnd="@dimen/page_content_padding_horizontal_large">
                    <CheckBox
                        android:id="@+id/sync_calendar_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:button="@drawable/selector_common_circle_check"
                        android:contentDescription="@string/device_sync_schedule"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/dimen_16sp"
                        android:textStyle="bold"
                        android:textColor="@color/switch_black"
                        android:id="@+id/sync_calendar_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/device_sync_schedule"
                        android:layout_marginStart="@dimen/dimen_margin_12dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/sync_calendar_button"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:gravity="center_vertical"
                    android:id="@+id/sync_weather_view"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_margin_20dp"
                    android:layoutDirection="locale"
                    android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
                    android:layout_marginEnd="@dimen/page_content_padding_horizontal_large">
                    <CheckBox
                        android:id="@+id/sync_weather_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:button="@drawable/selector_common_circle_check"
                        android:contentDescription="@string/device_settings_weather_setting_sync"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/dimen_16sp"
                        android:textStyle="bold"
                        android:textColor="@color/switch_black"
                        android:id="@+id/sync_weather_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/device_settings_weather_setting_sync"
                        android:layout_marginStart="@dimen/dimen_margin_12dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/sync_weather_button"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/sync_miui_todo_view"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_27dp"
                    android:layoutDirection="locale"
                    android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
                    android:layout_marginEnd="@dimen/page_content_padding_horizontal_large">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/dimen_15sp"
                        android:textStyle="bold"
                        android:textColor="@color/switch_black"
                        android:id="@+id/sync_miui_todo_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/device_settings_guide_sync_miui_todo"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/dimen_13sp"
                        android:textColor="@color/notify_guide_remind_has_open_color"
                        android:id="@+id/sync_not_miui_todo_subtitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/device_settings_guide_sync_miui_todo_desc"
                        android:layout_marginEnd="40dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/sync_miui_todo_button"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/sync_miui_todo_title"/>
                    <CheckBox
                        android:id="@+id/sync_miui_todo_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:button="@drawable/selector_common_circle_check"
                        android:contentDescription="@string/device_settings_guide_sync_miui_todo"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
        </miuix.core.widget.NestedScrollView>
    </miuix.springback.view.SpringBackLayout>
    <Button
        android:id="@+id/cancel_button"
        android:layout_width="@dimen/common_btn_two_column_width"
        android:layout_height="@dimen/common_btn_height"
        android:text="@string/notify_message_remind_ignore"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/open_button"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/CommonBtn.Normal"/>
    <Button
        android:id="@+id/open_button"
        android:layout_width="@dimen/common_btn_two_column_width"
        android:layout_height="@dimen/common_btn_height"
        android:text="@string/device_settings_continue"
        android:layout_marginStart="@dimen/page_extra_padding_horizontal_large"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/cancel_button"
        style="@style/CommonBtn.Primary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
