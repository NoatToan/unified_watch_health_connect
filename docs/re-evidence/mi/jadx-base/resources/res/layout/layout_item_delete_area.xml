<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:id="@+id/layout_delete_area"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/img_delete"
        android:layout_width="33.33dp"
        android:layout_height="33.33dp"
        android:src="@drawable/ic_item_delete_gray"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/device_settings_widget_delete_txt"
        android:id="@+id/tv_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/device_settings_widget_group_delete"
        android:layout_below="@+id/img_delete"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
