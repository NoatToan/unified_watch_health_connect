<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/ubox_fragment_done_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/dimen_26sp"
        android:textColor="@color/text_color"
        android:id="@+id/titleView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="@string/ubox_start_use_title"
        android:fontFamily="@font/misanslatin_bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:layout_marginBottom="25dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleView">
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottieView"
            android:visibility="invisible"
            android:layout_width="380dp"
            android:layout_height="380dp"
            android:scaleType="centerCrop"
            app:lottie_autoPlay="true"
            app:lottie_loop="false"/>
        <com.xiaomi.fitness.ubox.export.DeviceIconView
            android:layout_gravity="center"
            android:id="@+id/deviceView"
            android:layout_width="320dp"
            android:layout_height="320dp"
            app:type="0"/>
    </FrameLayout>
    <TextView
        android:textStyle="bold"
        android:id="@+id/continueView"
        android:layout_width="match_parent"
        android:text="@string/ubox_start_use"
        app:layout_constraintBottom_toBottomOf="parent"
        style="@style/CommonBtn.Primary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
