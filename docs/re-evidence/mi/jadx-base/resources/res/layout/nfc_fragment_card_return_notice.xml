<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/layoutView"
    android:tag="layout/nfc_fragment_card_return_notice_0"
    android:paddingTop="@dimen/size_21_3"
    android:paddingBottom="@dimen/size_21_3"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/page_content_padding_horizontal_large"
    android:paddingEnd="@dimen/page_content_padding_horizontal_large">
    <TextView
        android:textSize="@dimen/font_13_36"
        android:textStyle="bold"
        android:textColor="@color/text_color"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/nfc_retrun_card_confirm_title"/>
    <TextView
        android:textColor="@color/text_color_40"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/nfc_size_6_68"
        android:text="@string/nfc_retrun_card_confirm_msg_2"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/reasonListView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </androidx.core.widget.NestedScrollView>
    <TextView
        android:enabled="false"
        android:id="@+id/confirmView"
        android:layout_marginTop="@dimen/size_10"
        android:text="@string/nfc_retrun_card_btn_title"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp"
        style="@style/CommonBtn.Normal"/>
</LinearLayout>
