<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/device_settings_fragment_emergency_info_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/page_content_padding_horizontal_large"
    android:paddingEnd="@dimen/page_content_padding_horizontal_large">
    <com.xiaomi.fitness.devicesettings.widget.EmergencyCallView
        android:id="@+id/phone_number_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_8dp"
        app:emergency_contact_edit_hint="@string/device_settings_emergency_info_number_hint"
        app:emergency_contact_force_number="true"
        app:emergency_contact_name="@string/device_settings_common_telephony"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.xiaomi.fitness.devicesettings.widget.EmergencyCallView
        android:id="@+id/remark_name_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:emergency_contact_edit_hint="@string/device_settings_emergency_info_remark_hint"
        app:emergency_contact_name="@string/device_settings_common_remark"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/phone_number_view"/>
</androidx.constraintlayout.widget.ConstraintLayout>
