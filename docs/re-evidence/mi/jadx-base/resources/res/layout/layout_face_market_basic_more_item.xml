<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/layout_face_market_basic_more_item_0"
    android:background="@drawable/face_market_card_item_bg"
    android:paddingTop="@dimen/dimen_margin_17dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="@color/text_color"
        android:id="@+id/face_market_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_margin_14dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/FontDemiBold.18sp"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/text_color_40"
        android:id="@+id/face_market_more"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/face_watch_pool_resource_more"
        android:drawableEnd="@drawable/ic_more_right"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.xiaomi.fitness.watch.face.widget.NoTouchRecyclerView
        android:id="@+id/face_market_basic_tab_list"
        android:paddingTop="-2dp"
        android:paddingBottom="@dimen/dimen_margin_20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/face_market_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
