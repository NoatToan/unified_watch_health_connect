<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/send_invitation_with_xiaomi_account_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/page_content_padding_horizontal_large">
    <TextView
        android:textColor="@color/text_color_40"
        android:id="@+id/input_xiaomi_account_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/relative_care_input_xiaomi_account_description"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/FontRegular.14sp"/>
    <EditText
        android:textSize="17sp"
        android:textColor="@color/text_color_40"
        android:id="@+id/xiaomi_account"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="34.3dp"
        android:hint="@string/relative_care_please_input_xiaomi_account"
        android:inputType="number"
        app:layout_constraintTop_toBottomOf="@+id/input_xiaomi_account_description"/>
    <TextView
        android:textSize="@dimen/dimen_16sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/button"
        android:background="@drawable/selector_bottom_btn_positive_bg"
        android:layout_width="@dimen/common_btn_single_line_width"
        android:layout_height="@dimen/common_btn_height"
        android:layout_marginBottom="26.67dp"
        android:text="@string/confirm"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
