<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingBottom="@dimen/size_20"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:paddingTop="@dimen/size_20"
        android:paddingBottom="@dimen/size_20"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_18">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/img_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="center"
            android:layout_marginEnd="@dimen/size_10"/>
        <include layout="@layout/health_distribute_title"/>
    </LinearLayout>
    <View
        android:id="@+id/divide_line"
        android:background="@color/common_divider_bg_color"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_0_33"
        android:layout_marginBottom="@dimen/size_30"
        android:layout_marginStart="@dimen/size_18"
        android:layout_marginEnd="@dimen/size_18"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_below="@+id/divide_line"
        android:layout_marginStart="@dimen/size_18"
        android:layout_marginEnd="@dimen/size_18">
        <com.xiaomi.fitness.baseui.widget.DistributeView
            android:id="@+id/distributeView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"/>
        <com.xiaomi.fitness.baseui.widget.CircularCoverView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            app:cover_color="@color/card_bg_normal"
            app:left_bottom_radius="@dimen/dimen_margin_10dp"
            app:left_top_radius="@dimen/dimen_margin_10dp"
            app:right_bottom_radius="@dimen/dimen_margin_10dp"
            app:right_top_radius="@dimen/dimen_margin_10dp"/>
    </RelativeLayout>
</LinearLayout>
