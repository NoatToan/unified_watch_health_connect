<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/target_weekbar_week_text"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/dimen_margin_20dp"
    android:layout_marginHorizontal="@dimen/health_target_weekview_margin">
    <TextView
        android:textSize="@dimen/text_size_12"
        android:textColor="@color/text_color_40"
        android:gravity="center"
        android:id="@+id/targetMON"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/date_week_simple_monday"
        android:layout_weight="1"/>
    <TextView
        android:textSize="@dimen/text_size_12"
        android:textColor="@color/text_color_40"
        android:gravity="center"
        android:id="@+id/targetTUE"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/date_week_simple_tuesday"
        android:layout_weight="1"/>
    <TextView
        android:textSize="@dimen/text_size_12"
        android:textColor="@color/text_color_40"
        android:gravity="center"
        android:id="@+id/targetWED"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/date_week_simple_wednesday"
        android:layout_weight="1"/>
    <TextView
        android:textSize="@dimen/text_size_12"
        android:textColor="@color/text_color_40"
        android:gravity="center"
        android:id="@+id/targetTHU"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/date_week_simple_thursday"
        android:layout_weight="1"/>
    <TextView
        android:textSize="@dimen/text_size_12"
        android:textColor="@color/text_color_40"
        android:gravity="center"
        android:id="@+id/targetFRI"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/date_week_simple_friday"
        android:layout_weight="1"/>
    <TextView
        android:textSize="@dimen/text_size_12"
        android:textColor="@color/text_color_40"
        android:gravity="center"
        android:id="@+id/targetSAT"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/date_week_simple_saturday"
        android:layout_weight="1"/>
    <TextView
        android:textSize="@dimen/text_size_12"
        android:textColor="@color/text_color_40"
        android:gravity="center"
        android:id="@+id/targetSUN"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/date_week_simple_sunday"
        android:layout_weight="1"/>
</LinearLayout>
