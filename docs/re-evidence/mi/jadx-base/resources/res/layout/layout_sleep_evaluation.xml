<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/layout_sleep_evaluation"
    android:tag="layout/layout_sleep_evaluation_0"
    android:background="@drawable/selector_card_bg"
    android:paddingTop="@dimen/size_20"
    android:paddingBottom="@dimen/size_20"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/size_13"
    android:paddingStart="@dimen/size_18"
    android:paddingEnd="@dimen/size_18">
    <TextView
        android:textSize="@dimen/font_14"
        android:textColor="@color/text_color"
        android:id="@+id/tv_sleep_time_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_10"
        android:text="@string/health_total_sleep_duration"
        android:drawablePadding="@dimen/size_3_3"
        android:drawableEnd="@drawable/question_icon_2"
        style="@style/FontMedium"/>
    <TextView
        android:textSize="@dimen/font_33_3"
        android:textColor="@color/text_color"
        android:id="@+id/tv_sleep_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dialog_loanding"
        style="@style/FontMedium"/>
    <TextView
        android:textSize="@dimen/font_33_3"
        android:textColor="@color/text_color"
        android:id="@+id/tv_empty_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/health_data_empty"
        style="@style/FontMedium"/>
    <TextView
        android:textSize="@dimen/font_14"
        android:textColor="@color/text_color"
        android:id="@+id/tv_evaluate_result"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_10"
        android:drawablePadding="@dimen/size_3_3"
        android:drawableEnd="@drawable/question_icon_2"
        style="@style/FontMedium"/>
    <TextView
        android:textSize="@dimen/font_12"
        android:textColor="@color/text_color_40"
        android:id="@+id/tv_evaluate_desc"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_4"
        style="@style/FontRegular"/>
</LinearLayout>
