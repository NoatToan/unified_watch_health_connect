<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/common_data_layout"
    android:tag="layout/view_outdoor_sport_data_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/running_posture"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dimen_margin_10dp"
        android:paddingVertical="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/runningLottie"
            android:layout_width="21.3dp"
            android:layout_height="21.3dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/running_posture_tv"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:lottie_fileName="running.json"
            app:lottie_loop="true"/>
        <TextView
            android:textSize="13.3dp"
            android:textColor="@color/white"
            android:gravity="center_vertical"
            android:id="@+id/running_posture_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sport_running_form"
            android:drawableEnd="@drawable/right_arrow_icon"
            android:layout_marginStart="@dimen/dimen_margin_5dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/FontMedium"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/locationBtn"
        android:background="@drawable/sport_location"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:layout_marginStart="@dimen/margin_15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/line"
        android:background="@drawable/sport_route_bottom_sheet_handler"
        android:layout_width="37.3dp"
        android:layout_height="4dp"
        app:layout_constraintBottom_toTopOf="@+id/sportDataLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/locationBtn"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/sportDataLayout"
        android:background="@drawable/shape_sporting_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="3dp">
        <LinearLayout
            android:id="@+id/title_config"
            android:tag="binding_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <include
                android:id="@+id/outdoor_title"
                layout="@layout/view_outdoor_title"/>
            <View
                android:layout_width="match_parent"
                android:layout_height="12.6dp"/>
        </LinearLayout>
        <TextView
            android:textSize="64dp"
            android:textColor="@color/sport_color_black"
            android:id="@+id/targetData"
            android:tag="binding_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_25dp"
            app:layout_constraintBottom_toTopOf="@+id/target"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title_config"
            style="@style/FontLatinDemiBold"/>
        <TextView
            android:textSize="18dp"
            android:textStyle="bold"
            android:textColor="@color/sport_color_black"
            android:id="@+id/unit"
            android:tag="binding_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:layout_marginStart="5dp"
            app:layout_constraintBottom_toBottomOf="@+id/targetData"
            app:layout_constraintStart_toEndOf="@+id/targetData"
            style="@style/FontDemiBold"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/target"
            android:tag="binding_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_margin_25dp"
            android:layout_marginEnd="@dimen/dimen_margin_25dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/targetData">
            <include
                app:layout_constraintBottom_toBottomOf="parent"
                layout="@layout/view_indoor_sport_target"/>
            <View
                android:layout_width="match_parent"
                android:layout_height="20dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll"
            android:tag="binding_5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/target">
            <include
                android:id="@+id/view_out_sport_data_view"
                app:layout_constraintTop_toBottomOf="@+id/target"
                layout="@layout/view_out_sport_data"/>
            <TextView
                android:background="@color/page_white_bg"
                android:layout_width="match_parent"
                android:layout_height="100dp"/>
        </LinearLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/b_data"
            android:background="@drawable/shape_sporting_bg"
            android:layout_width="0dp"
            android:layout_height="90dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="30dp"
                android:textStyle="bold"
                android:textColor="@color/sport_color_black"
                android:gravity="bottom"
                android:id="@+id/b_main_data"
                android:tag="binding_6"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:translationY="-12dp"
                android:layout_marginStart="@dimen/margin_25dp"
                app:layout_constraintBottom_toTopOf="@+id/b_main_des"
                app:layout_constraintEnd_toStartOf="@+id/b_minor_data"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/sport_unit_color"
                android:id="@+id/b_main_des"
                android:tag="binding_7"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:translationY="-10dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="@+id/b_main_data"
                app:layout_constraintTop_toBottomOf="@+id/b_main_data"/>
            <TextView
                android:textSize="30dp"
                android:textStyle="bold"
                android:textColor="@color/sport_color_black"
                android:gravity="bottom"
                android:id="@+id/b_minor_data"
                android:tag="binding_8"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:translationY="-12dp"
                app:layout_constraintBottom_toBottomOf="@+id/b_main_data"
                app:layout_constraintEnd_toStartOf="@+id/b_three_data"
                app:layout_constraintStart_toEndOf="@+id/b_main_data"
                app:layout_constraintTop_toTopOf="@+id/b_main_data"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/sport_unit_color"
                android:id="@+id/b_minor_des"
                android:tag="binding_9"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_marginTop="5dp"
                android:translationY="-10dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="@+id/b_minor_data"
                app:layout_constraintTop_toBottomOf="@+id/b_minor_data"/>
            <TextView
                android:textSize="30dp"
                android:textStyle="bold"
                android:textColor="@color/sport_color_black"
                android:gravity="bottom"
                android:id="@+id/b_three_data"
                android:tag="binding_10"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:translationY="-12dp"
                app:layout_constraintBottom_toBottomOf="@+id/b_minor_data"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/b_minor_data"
                app:layout_constraintTop_toTopOf="@+id/b_minor_data"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/sport_unit_color"
                android:id="@+id/b_three_des"
                android:tag="binding_11"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_marginTop="5dp"
                android:translationY="-10dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="@+id/b_three_data"
                app:layout_constraintTop_toBottomOf="@+id/b_three_data"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
