<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="52.3dp"
    android:paddingEnd="52.3dp">
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:background="@color/black"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"/>
    <com.xiaomi.fitness.heartrate.camera.VideoPreviewView
        android:id="@+id/sv_finger_guide"
        android:background="@color/black"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"/>
    <ImageView
        android:id="@+id/img_finger_detect_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/heartrate_ic_finger_detect_cover"
        android:scaleType="fitCenter"
        android:layout_centerInParent="true"/>
    <com.xiaomi.fitness.heartrate.ui.view.CircleEmptyView
        android:id="@+id/view_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"
        app:cev_coverColor="@color/black"/>
</RelativeLayout>
