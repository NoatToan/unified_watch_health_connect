<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/health_sleep_breath_quality_bg_color"
    android:scrollbars="none"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:overScrollMode="never">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:weightSum="1"
        android:paddingHorizontal="@dimen/page_padding_horizontal_large">
        <TextView
            android:textSize="@dimen/font_13"
            android:id="@+id/noise_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_20"
            android:text="2021年2月25日 20:43"
            android:layout_marginStart="@dimen/size_12"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:id="@+id/environmental_noise_card"
            android:background="@drawable/shape_card_bg_normal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_25_3"
            app:cardCornerRadius="@dimen/size_4"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/noise_time">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/noise_volume_upper"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <RelativeLayout
                        android:id="@+id/noise_volume_unit"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingHorizontal="@dimen/size_18">
                        <TextView
                            android:textSize="31.82sp"
                            android:textColor="@color/text_color"
                            android:id="@+id/noise_volume"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/size_10"
                            android:text="78"
                            android:layout_alignParentStart="true"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/text_color_40"
                            android:id="@+id/noise_unit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/health_decibel_number"
                            android:layout_below="@+id/noise_volume"
                            android:layout_alignParentStart="true"/>
                    </RelativeLayout>
                    <RelativeLayout
                        android:layout_gravity="center_vertical"
                        android:id="@+id/noise_level_evaluation"
                        android:paddingBottom="@dimen/dimen_margin_10dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/size_10"
                        android:layout_weight="1"
                        android:layout_toEndOf="@+id/noise_volume_unit"
                        android:paddingHorizontal="@dimen/size_18">
                        <View
                            android:id="@+id/vertical_divider"
                            android:background="#e5e5e5"
                            android:layout_width="@dimen/dimen_margin_1dp"
                            android:layout_height="@dimen/size_45"
                            android:layout_centerVertical="true"
                            android:layout_alignParentStart="true"/>
                        <TextView
                            android:textSize="@dimen/font_29_3"
                            android:textColor="@color/text_color"
                            android:id="@+id/noise_evaluation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/health_hearing_too_high"
                            android:paddingStart="@dimen/dimen_margin_18dp"
                            android:layout_toEndOf="@+id/vertical_divider"/>
                        <TextView
                            android:textSize="@dimen/font_12"
                            android:textColor="@color/text_color_40"
                            android:id="@+id/noise_level"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/health_hearing_level"
                            android:layout_below="@+id/noise_evaluation"
                            android:paddingStart="@dimen/dimen_margin_18dp"
                            android:layout_toEndOf="@+id/vertical_divider"/>
                    </RelativeLayout>
                </LinearLayout>
                <View
                    android:id="@+id/horizontal_divider"
                    android:background="#e5e5e5"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/size_20"
                    android:layout_marginHorizontal="@dimen/size_18"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/noise_volume_upper"/>
                <com.xiaomi.fitness.baseui.widget.LevelBarView
                    android:id="@+id/levelBarView"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size_50"
                    android:layout_marginTop="@dimen/dimen_margin_28dp"
                    android:layout_marginStart="26dp"
                    android:layout_marginEnd="26dp"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/level_desc_recyclerview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="16dp"
                    android:layout_marginHorizontal="@dimen/size_14"/>
                <TextView
                    android:textSize="@dimen/font_12"
                    android:textColor="#999999"
                    android:id="@+id/health_sleep_environmental_noise_high_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_20"
                    android:layout_marginBottom="@dimen/size_30"
                    android:text="@string/health_sleep_environmental_noise_high_description"
                    android:paddingHorizontal="@dimen/dimen_margin_18dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/health_sleep_environmental_noise_level_indicator"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
