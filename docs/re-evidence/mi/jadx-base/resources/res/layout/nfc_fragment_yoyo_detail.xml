<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/listView"
    android:tag="layout/nfc_fragment_yoyo_detail_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/nfc_common_title_left_margin"
    android:paddingEnd="@dimen/nfc_common_title_left_margin">
    <FrameLayout
        android:id="@+id/faceView"
        android:paddingTop="@dimen/nfc_common_content_miui_title_margin"
        android:paddingBottom="@dimen/nfc_tsm_watch_icon_padding_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.xiaomi.fitness.nfc.widget.DeviceImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/deviceView"
            android:layout_width="@dimen/nfc_device_icon_width"
            android:layout_height="@dimen/nfc_device_icon_height"/>
        <com.xiaomi.fitness.nfc.widget.InnerCardImageView
            android:layout_gravity="center"
            android:id="@+id/cardView"
            android:layout_width="86.4dp"
            android:layout_height="48.6dp"/>
    </FrameLayout>
    <View
        android:id="@+id/lineView"
        android:background="@color/common_divider_color"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginTop="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/faceView"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/balanceContainnerView"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nfc_issued_card_list_detail_item_height"
        android:layout_marginTop="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lineView">
        <TextView
            android:textSize="@dimen/nfc_common_item_set_title_text_size"
            android:textColor="@color/text_color"
            android:gravity="center"
            android:id="@+id/balanceView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:includeFontPadding="false"
            android:layout_marginEnd="@dimen/nfc_issued_card_list_detail_balance_margin_right"/>
        <TextView
            android:textColor="@color/text_color"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/nfc_card_balance_des"
            android:includeFontPadding="false"
            android:layout_weight="1"
            style="@style/FontMedium.16sp"/>
        <TextView
            android:textSize="@dimen/nfc_tsm_text_size_content_medium"
            android:textColor="@color/colorPrimary"
            android:id="@+id/rechargeView"
            android:paddingTop="@dimen/nfc_issued_card_list_detail_top_up_padding_vertical"
            android:paddingBottom="@dimen/nfc_issued_card_list_detail_top_up_padding_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nfc_yoyo_recharge"
            android:paddingStart="@dimen/nfc_issued_card_list_detail_item_padding_horizontal"
            style="@style/nfc_TextAppearance.List.Primary"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center_vertical"
        android:id="@+id/cardNoContannerView"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nfc_issued_card_list_detail_item_height"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/balanceContainnerView">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textColor="@color/text_color"
                android:id="@+id/cradNoLableView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nfc_card_number_global"
                android:includeFontPadding="false"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/FontMedium.16sp"/>
            <TextView
                android:textSize="12.7sp"
                android:textColor="@color/text_color_40"
                android:id="@+id/cardNumberView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="@+id/cradNoLableView"
                app:layout_constraintTop_toTopOf="@+id/cradNoLableView"/>
        </LinearLayout>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:id="@+id/copyView"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="0dp"
            android:text="@string/nfc_copy"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:layout_marginEnd="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/CommonBtn.Normal"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/helpView"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nfc_issued_card_list_detail_item_height"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardNoContannerView">
        <TextView
            android:textColor="@color/text_color"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/nfc_help"
            android:includeFontPadding="false"
            android:layout_weight="1"
            style="@style/FontMedium.16sp"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_base_right_arrow_icon"/>
    </LinearLayout>
    <TextView
        android:id="@+id/removeView"
        android:visibility="gone"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="0dp"
        android:text="@string/nfc_remove_door_card"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/CommonBtn.Normal"/>
</androidx.constraintlayout.widget.ConstraintLayout>
