<?xml version="1.0" encoding="utf-8"?>
<miuix.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll_view"
    android:tag="layout/fragment_blood_pressure_add_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout xmlns:app="http://schemas.android.com/apk/res-auto"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="@dimen/page_padding_horizontal_large">
        <include
            android:id="@+id/layout_record_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            layout="@layout/layout_title_subtitle_state"/>
        <TextView
            android:id="@+id/tv_required_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_20"
            android:text="@string/health_blood_pressure_required_edit"
            android:layout_marginStart="@dimen/size_13_3"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layout_record_time"/>
        <androidx.cardview.widget.CardView
            android:id="@+id/card_high"
            android:tag="binding_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_8"
            android:foreground="@null"
            android:layout_marginEnd="@dimen/size_3_7"
            app:cardCornerRadius="@dimen/size_15_3"
            app:layout_constraintEnd_toStartOf="@+id/card_low"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_required_label"
            style="@style/CardView.Default">
            <include layout="@layout/layout_edit_blood_pressure"/>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:id="@+id/card_low"
            android:tag="binding_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_8"
            android:foreground="@null"
            android:layout_marginStart="@dimen/size_3_7"
            app:cardCornerRadius="@dimen/size_15_3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/card_high"
            app:layout_constraintTop_toBottomOf="@+id/tv_required_label"
            style="@style/CardView.Default">
            <include layout="@layout/layout_edit_blood_pressure"/>
        </androidx.cardview.widget.CardView>
        <TextView
            android:id="@+id/tv_optional_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_14"
            android:text="@string/health_blood_pressure_pulse_optional_edit"
            android:layout_marginStart="@dimen/size_13_3"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/card_high"/>
        <androidx.cardview.widget.CardView
            android:id="@+id/card_pulse"
            android:tag="binding_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_8"
            android:foreground="@null"
            android:layout_marginEnd="@dimen/size_3_7"
            app:cardCornerRadius="@dimen/size_15_3"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_optional_label"
            app:layout_constraintWidth_percent="0.5"
            style="@style/CardView.Default">
            <include layout="@layout/layout_edit_blood_pressure"/>
        </androidx.cardview.widget.CardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</miuix.core.widget.NestedScrollView>
