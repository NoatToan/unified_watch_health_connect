<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/health_fragment_resting_hrm_0"
    android:background="@color/page_bg"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.xiaomi.fitness.view.TitleBarAlphaView
        android:id="@+id/titleAlpha"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.xiaomi.fitness.chart.view.LineChartRecyclerView
                    android:id="@+id/recycler"
                    app:barChartMaxWidth="@dimen/size_3"
                    app:barChartRoundRectRadiusRatio="0.5"
                    app:barChartSegment="1"
                    app:displayNumbers="30"
                    app:enableEndDayXAxis="true"
                    app:enableStartYAxisLabel="false"
                    app:lineColor="@color/health_hrm_chart"
                    app:lineHighLightType="4"
                    app:linePointRadius="@dimen/size_2"
                    app:linePointSelectCircleStroke="true"
                    app:linePointSelectRadius="@dimen/size_2"
                    app:linePointSelectStrokeWidth="@dimen/size_2"
                    app:lineSelectCircles="1"
                    app:lineShaderBeginColor="@color/energy_shader_begin"
                    app:lineShaderEndColor="@color/health_hrm_chart"
                    app:lineStrokeWidth="6"
                    style="@style/ChartBaseStyle"/>
                <com.xiaomi.fitness.view.DataTitleView
                    android:id="@+id/dataTitleView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </FrameLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/shape_data_item_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/page_padding_horizontal_large"
                android:layout_marginEnd="@dimen/page_padding_horizontal_large">
                <TextView
                    android:textColor="@color/text_color"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_margin_20dp"
                    android:text="@string/health_hrm_resting_about_title"
                    android:layout_marginStart="@dimen/dimen_margin_18dp"
                    style="@style/FontMedium.14sp"/>
                <View
                    android:background="@color/black_10"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="@dimen/dimen_margin_18dp"
                    android:layout_marginTop="@dimen/dimen_margin_20dp"
                    android:layout_marginRight="@dimen/dimen_margin_18dp"/>
                <TextView
                    android:textSize="@dimen/text_size_14"
                    android:textColor="@color/text_color_60"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dimen_margin_18dp"
                    android:layout_marginTop="@dimen/dimen_margin_20dp"
                    android:layout_marginRight="@dimen/dimen_margin_18dp"
                    android:layout_marginBottom="@dimen/dimen_margin_30dp"
                    android:text="@string/health_hrm_resting_about_desc"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.appcompat.widget.LinearLayoutCompat>
