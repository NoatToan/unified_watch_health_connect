<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/layoutView"
    android:tag="layout/device_settings_fragment_avs_setting_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/page_content_padding_horizontal_large"
    android:paddingEnd="@dimen/page_content_padding_horizontal_large">
    <com.xiaomi.fitness.widget.RightArrowBindingTwoLineTextView
        android:id="@+id/skillView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/device_settings_xiaoai_skill"/>
    <com.xiaomi.fitness.widget.SwitchButtonBindingTwoLineTextView
        android:id="@+id/optimiseView"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:subtitle="@string/device_settings_aivs_voice_optimise_desc"
        app:title="@string/device_settings_aivs_voice_optimise"/>
</LinearLayout>
