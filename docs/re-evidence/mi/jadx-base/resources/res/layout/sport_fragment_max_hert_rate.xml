<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/sport_fragment_max_hert_rate_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/voiceRemindContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_10sp"
            android:paddingHorizontal="@dimen/page_content_padding_horizontal_large"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/set_title">
            <com.xiaomi.fitness.widget.RightArrowSingleLineTextView
                android:id="@+id/max_hr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:title="@string/sport_hert_rate_limit_remind"/>
            <View
                android:background="@color/text_color_10"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginTop="@dimen/dimen_margin_20dp"
                android:layout_marginBottom="@dimen/dimen_margin_20dp"/>
            <com.xiaomi.fitness.widget.SwitchButtonTwoLineTextView
                android:id="@+id/radio_hr_change"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:subtitle="@string/sport_hert_rate_range"
                app:title="@string/sport_hert_rate_range_remind"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/hert_rate_range"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintTop_toBottomOf="@+id/voiceRemindContainer">
            <com.xiaomi.fitness.sport.view.widget.SportRadioView
                android:id="@+id/radio_hr_warm_up"
                android:layout_width="match_parent"
                android:layout_height="@dimen/sport_hert_rate_switch_height"
                android:layout_marginTop="@dimen/dimen_margin_20dp"
                android:layout_marginBottom="@dimen/dimen_margin_20dp"
                app:radioTitle="@string/sport_hert_rate_range_warm_up"/>
            <com.xiaomi.fitness.sport.view.widget.SportRadioView
                android:id="@+id/radio_hr_fat_burning"
                android:layout_width="match_parent"
                android:layout_height="@dimen/sport_hert_rate_switch_height"
                android:layout_marginBottom="@dimen/dimen_margin_20dp"
                app:radioTitle="@string/sport_hert_rate_range_fat_burning"/>
            <com.xiaomi.fitness.sport.view.widget.SportRadioView
                android:id="@+id/radio_hr_aerobic"
                android:layout_width="match_parent"
                android:layout_height="@dimen/sport_hert_rate_switch_height"
                android:layout_marginBottom="@dimen/dimen_margin_20dp"
                app:radioTitle="@string/sport_hert_rate_range_aerobic"/>
            <com.xiaomi.fitness.sport.view.widget.SportRadioView
                android:id="@+id/radio_hr_anaerobic"
                android:layout_width="match_parent"
                android:layout_height="@dimen/sport_hert_rate_switch_height"
                android:layout_marginBottom="@dimen/dimen_margin_20dp"
                app:radioTitle="@string/sport_hert_rate_range_anaerobic"/>
            <com.xiaomi.fitness.sport.view.widget.SportRadioView
                android:id="@+id/radio_hr_limit"
                android:layout_width="match_parent"
                android:layout_height="@dimen/sport_hert_rate_switch_height"
                android:layout_marginBottom="@dimen/dimen_margin_20dp"
                app:radioTitle="@string/sport_hert_rate_range_limit"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
