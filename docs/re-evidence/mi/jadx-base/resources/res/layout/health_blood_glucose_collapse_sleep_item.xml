<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/blood_glucose_collapse_sleep_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_margin_10dp"
        android:layout_marginStart="@dimen/margin_20dp"
        android:layout_marginEnd="@dimen/margin_20dp"
        layout="@layout/layout_blood_glucose_bottom_guide"/>
    <FrameLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.xiaomi.fitness.chart.view.LineChartRecyclerView
            android:id="@+id/sleep_line_chart_recycler"
            android:paddingTop="@dimen/dimen_margin_10dp"
            android:layout_height="311dp"
            android:paddingStart="@dimen/size_18"
            android:paddingEnd="31.67dp"
            app:enableEndDayXAxis="true"
            app:enableLineFill="false"
            app:enableStartYAxisLabel="false"
            app:enableXAxisLineCircle="false"
            app:lineHighLightType="4"
            app:lineShaderBeginColor="@color/health_blood_glucose_chart_fill"
            app:lineShaderEndColor="@color/health_blood_glucose_chart_fill"
            app:lineStrokeWidth="3"
            app:xAxisLabelPosition="0"
            style="@style/ChartBaseStyle"/>
        <include
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="300dp"
            android:layout_marginStart="@dimen/size_18"
            android:layout_marginEnd="31.67dp"
            layout="@layout/health_blood_glucose_collapse_chart_content"/>
    </FrameLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/blood_glucose_collapse_content_recycler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_20dp"/>
</LinearLayout>
