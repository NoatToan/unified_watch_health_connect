<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/device_settings_fragment_ble_pressure_setting_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/page_content_padding_horizontal_large">
    <com.xiaomi.fitness.widget.SwitchButtonBindingTwoLineTextView
        android:id="@+id/pressure_switch_view"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:subtitle="@string/device_settings_pressure_setting_switch_des"
        app:title="@string/device_settings_pressure_setting_switch_title"/>
    <com.xiaomi.fitness.widget.SwitchButtonBindingTwoLineTextView
        android:id="@+id/high_pressure_switch_view"
        android:tag="binding_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:subtitle="@string/device_settings_high_pressure_notice_des"
        app:title="@string/device_settings_high_pressure_notice_title"/>
    <com.xiaomi.fitness.devicesettings.widget.DeviceReminderView
        android:tag="binding_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_40dp"/>
</LinearLayout>
