<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutView"
    android:tag="layout/nfc_fragment_card_order_detail_0"
    android:paddingTop="@dimen/nfc_card_trade_record_recharge_content_padding_top"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/page_content_padding_horizontal_large"
    android:paddingEnd="@dimen/page_content_padding_horizontal_large">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/card_order_detail_success_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/header_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/statusIconView"
                android:layout_width="@dimen/nfc_card_trade_record_recharge_content_icon_width"
                android:layout_height="@dimen/nfc_card_trade_record_recharge_content_icon_height"
                android:src="@drawable/nfc_ic_result_fail"
                android:scaleType="centerCrop"/>
            <TextView
                android:textSize="@dimen/nfc_card_trade_record_recharge_content_name_text_size"
                android:textColor="@color/black"
                android:gravity="center"
                android:id="@+id/statusDescView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/nfc_card_trade_record_recharge_content_status_desc_margin_top"
                android:lineSpacingExtra="5dp"/>
            <FrameLayout
                android:background="@color/nfc_common_divider_separator_bg"
                android:layout_width="match_parent"
                android:layout_height="@dimen/common_divider_height"
                android:layout_marginTop="@dimen/nfc_card_order_detail_divider_margin_top">
                <ImageView
                    android:layout_gravity="top"
                    android:background="@color/nfc_common_divider_line"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/common_divider_height"/>
                <ImageView
                    android:layout_gravity="bottom"
                    android:background="@color/nfc_common_divider_line"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/common_divider_height"/>
            </FrameLayout>
        </LinearLayout>
        <ListView
            android:scrollbarStyle="outsideOverlay"
            android:id="@+id/orderFlowListView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:cacheColorHint="@null"
            android:divider="@null"
            android:layout_weight="1"
            android:fastScrollEnabled="false"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/nfc_common_view_btn_margin_top"
            android:layout_marginBottom="@dimen/size_10">
            <View
                android:id="@+id/v_separator_1"
                android:background="@color/common_divider_color"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginBottom="@dimen/nfc_common_view_btn_margin_top"
                android:layout_marginStart="@dimen/common_btn_margin"
                android:layout_marginEnd="@dimen/common_btn_margin"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nfc_card_detail_order_id_title"/>
            <com.xiaomi.fitness.nfc.widget.TSMSetRightArrowView
                android:id="@+id/orderIdView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:nfc_arrow_des="@string/nfc_data_empty"
                app:nfc_arrow_desShow="true"
                app:nfc_arrow_lineShow="false"
                app:nfc_arrow_name="@string/nfc_card_detail_mi_order_id_title"
                app:nfc_arrow_rightValueShow="true"
                app:nfc_arrow_rightValue_text="@string/nfc_card_detail_copy_id"/>
            <com.xiaomi.fitness.nfc.widget.TSMSetRightArrowView
                android:id="@+id/cardCompanyIdView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:nfc_arrow_des="@string/nfc_data_empty"
                app:nfc_arrow_desShow="true"
                app:nfc_arrow_lineShow="false"
                app:nfc_arrow_name="@string/nfc_card_detail_card_company_order_id_title"
                app:nfc_arrow_rightValueShow="true"
                app:nfc_arrow_rightValue_text="@string/nfc_card_detail_copy_id"/>
        </LinearLayout>
        <FrameLayout
            android:paddingBottom="40dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/common_btn_margin"
            android:paddingEnd="@dimen/common_btn_margin">
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/retryView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <FrameLayout
                        android:background="@color/nfc_common_divider_separator_bg"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/common_divider_height">
                        <ImageView
                            android:layout_gravity="top"
                            android:background="@color/nfc_common_divider_line"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/common_divider_height"/>
                        <ImageView
                            android:layout_gravity="bottom"
                            android:background="@color/nfc_common_divider_line"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/common_divider_height"/>
                    </FrameLayout>
                    <TextView
                        android:layout_marginBottom="10dp"
                        android:text="@string/nfc_common_retry"
                        android:layout_marginStart="0dp"
                        android:layout_marginEnd="0dp"
                        style="@style/BaseButton.Positive"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/refundView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <FrameLayout
                        android:background="@color/nfc_common_divider_separator_bg"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/common_divider_height">
                        <ImageView
                            android:layout_gravity="top"
                            android:background="@color/nfc_common_divider_line"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/common_divider_height"/>
                        <ImageView
                            android:layout_gravity="bottom"
                            android:background="@color/nfc_common_divider_line"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/common_divider_height"/>
                    </FrameLayout>
                    <TextView
                        android:text="@string/nfc_card_record_text"
                        android:layout_marginStart="0dp"
                        android:layout_marginEnd="0dp"
                        style="@style/BaseButton.Positive"/>
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:ellipsize="end"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/tipView"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/nfc_card_order_detail_tip_height"
                android:layout_marginTop="@dimen/nfc_card_order_detail_tip_margin_top"
                android:layout_marginBottom="@dimen/nfc_card_order_detail_tip_margin_bottom"
                android:singleLine="true"/>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
