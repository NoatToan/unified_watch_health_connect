<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/trail_chart_layout_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="20dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dataContainer"
        android:background="@drawable/trail_record_data"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginHorizontal="@dimen/dimen_margin_14dp">
        <TextView
            android:textSize="@dimen/trail_data"
            android:textColor="@color/trail_black"
            android:id="@+id/data1View"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/data2View"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/FontLatinDemiBold"/>
        <TextView
            android:textSize="@dimen/trail_data"
            android:textColor="@color/trail_black"
            android:id="@+id/data2View"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="26.25KM"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/data3View"
            app:layout_constraintStart_toEndOf="@+id/data1View"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/FontLatinDemiBold"/>
        <TextView
            android:textSize="@dimen/trail_data"
            android:textColor="@color/trail_black"
            android:id="@+id/data3View"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="270千卡"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/data4View"
            app:layout_constraintStart_toEndOf="@+id/data2View"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/FontLatinDemiBold"/>
        <TextView
            android:textSize="@dimen/trail_data"
            android:textColor="@color/trail_black"
            android:id="@+id/data4View"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:28:36"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/data3View"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/FontLatinDemiBold"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.xiaomi.fitness.trail.widget.RecordChartView
        android:id="@+id/barView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="4dp"
        android:paddingEnd="@dimen/dimen_margin_30dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dataContainer"/>
</androidx.constraintlayout.widget.ConstraintLayout>
