<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_sport_detail_common_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.xiaomi.fitness.share.view.ShareLogoContainer
        android:id="@+id/shareLogo"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.xiaomi.fitness.detail.view.SportShareBottomView
        android:id="@+id/shareBottomView"
        android:paddingBottom="@dimen/dimen_margin_40dp"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.xiaomi.fitness.detail.view.MapScrollView
        android:orientation="vertical"
        android:id="@+id/mapScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:id="@+id/outContainter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:id="@+id/marginView"
                android:background="@drawable/sport_detail_common_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/cover_view_pager"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="350dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="vertical"
                android:id="@+id/report_all_root_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="180dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textSize="33sp"
                    android:textColor="@color/white"
                    android:id="@+id/txtSportName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
                    style="@style/FontMedium"/>
                <TextView
                    android:textColor="@color/white"
                    android:id="@+id/sportTimeTV"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
                    style="@style/FontMedium.16sp"/>
                <com.xiaomi.fitness.detail.view.SportRecordBasicInfoView
                    android:id="@+id/sportRecordBasic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_margin_20dp"
                    android:layout_marginHorizontal="@dimen/page_padding_horizontal_large"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/recordDetailContent"
                    android:background="@color/page_bg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <FrameLayout
                        android:id="@+id/container_detail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="-12dp"/>
                </LinearLayout>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.xiaomi.fitness.detail.view.MapScrollView>
    <TextView
        android:textColor="@color/common_transparent"
        android:gravity="center"
        android:id="@+id/sportTitle"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/FontMedium.16sp"/>
    <ImageView
        android:id="@+id/imgBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_back_white"
        android:scaleType="center"
        android:contentDescription="@string/back"
        android:layout_marginStart="25dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/imgDelete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_sport_more_white"
        android:scaleType="center"
        android:contentDescription="@string/trail_sport_record_more_settings"
        android:layout_marginEnd="25dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/imgShare"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_white_share"
        android:scaleType="center"
        android:contentDescription="@string/trail_share"
        android:layout_marginEnd="@dimen/dimen_margin_13dp"
        app:layout_constraintBottom_toBottomOf="@+id/imgDelete"
        app:layout_constraintEnd_toStartOf="@+id/imgDelete"
        app:layout_constraintTop_toTopOf="@+id/imgDelete"/>
    <com.xiaomi.fitness.detail.view.SportShareLongView
        android:id="@+id/sport_share_long_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
