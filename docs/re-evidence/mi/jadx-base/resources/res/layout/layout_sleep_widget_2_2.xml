<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@android:id/background"
    android:background="@drawable/widget_default_corners_background_12_67"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@android:id/widget_frame"
        android:paddingTop="12dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="13dp">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="46">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3.5">
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/text_color"
                    android:gravity="start|center_vertical"
                    android:id="@+id/widgetSleepTitle"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:text="@string/widget_sleep_title"
                    android:layout_weight="16"
                    android:autoSizeTextType="uniform"
                    android:autoSizeStepGranularity="0.2sp"
                    android:autoSizeMinTextSize="2sp"
                    android:autoSizeMaxTextSize="13sp"
                    android:textFontWeight="600"/>
                <TextView
                    android:textSize="26sp"
                    android:textColor="@color/text_color"
                    android:gravity="start|center_vertical"
                    android:id="@+id/widgetSleepValue"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginBottom="1dp"
                    android:text="--"
                    android:maxLines="1"
                    android:layout_weight="30"
                    android:importantForAccessibility="no"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="2sp"
                    android:autoSizeMaxTextSize="26sp"
                    android:textFontWeight="600"/>
                <TextView
                    android:textSize="18sp"
                    android:textColor="@color/text_color"
                    android:gravity="start|center_vertical"
                    android:id="@+id/tv_sleep_tip"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:text="@string/no_record"
                    android:layout_weight="24"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="1sp"
                    android:autoSizeMaxTextSize="18sp"
                    android:textFontWeight="550"/>
            </LinearLayout>
            <ImageView
                android:layout_gravity="end|top"
                android:id="@+id/img_main"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_widget_sleep_bed"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no"
                android:layout_marginStart="1dp"/>
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="17"/>
        <ImageView
            android:id="@+id/img_sleep_state"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:src="@drawable/bg_card_5percent_dark_4radius"
            android:scaleType="fitXY"
            android:minHeight="60dp"
            android:layout_weight="53"
            android:importantForAccessibility="no"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="1dp"
            android:layout_weight="14"
            android:layoutDirection="ltr">
            <TextView
                android:textSize="10sp"
                android:textColor="@color/widget_sleep_time"
                android:gravity="start|center_vertical"
                android:id="@+id/tv_sleep_start"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/data_xaxis_time_0"
                android:layout_weight="1"
                android:autoSizeTextType="uniform"
                android:autoSizeStepGranularity="0.2sp"
                android:autoSizeMinTextSize="2sp"
                android:autoSizeMaxTextSize="10sp"
                android:textFontWeight="380"/>
            <TextView
                android:textSize="10sp"
                android:textColor="@color/widget_sleep_time"
                android:gravity="end|center_vertical"
                android:id="@+id/tv_sleep_end"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/data_xaxis_time_24"
                android:layout_weight="1"
                android:autoSizeTextType="uniform"
                android:autoSizeStepGranularity="0.2sp"
                android:autoSizeMinTextSize="2sp"
                android:autoSizeMaxTextSize="10sp"
                android:textFontWeight="380"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
