<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/layout_sleep_rhythm_monitor_entrance_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_sleep_rhythm"
        android:background="@drawable/selector_card_bg"
        android:padding="16dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textColor="@color/health_sleep_rhythm_monitor_entrance_title_color"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/health_sleep_rhythm_monitor_united_peking_university"
            android:layout_marginEnd="5dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/FontMedium.14sp"/>
        <TextView
            android:textSize="17sp"
            android:textColor="@color/text_color"
            android:id="@+id/tv_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/health_sleep_rhythm_monitoring_program"
            android:layout_marginEnd="5dp"
            app:layout_constraintBottom_toTopOf="@+id/imgBottom"
            app:layout_constraintStart_toStartOf="@+id/tv_title"
            app:layout_constraintTop_toBottomOf="@+id/tv_title"
            style="@style/FontMedium.17sp"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/imgBottom"
            android:paddingTop="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:srcCompat="@drawable/health_ic_sleep_rhythm_entrance_img_2"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_sleep_research"
        android:background="@drawable/selector_card_bg"
        android:padding="16dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textColor="@color/health_sleep_rhythm_monitor_entrance_title_color"
            android:id="@+id/tv_sleepresearchtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/health_sleep_research_monitor_united_xuanwu_university"
            android:layout_marginEnd="5dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/FontMedium.14sp"/>
        <TextView
            android:textSize="17sp"
            android:textColor="@color/text_color"
            android:id="@+id/tv_sleepresearchsubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/health_sleep_research_monitoring_program"
            android:layout_marginEnd="5dp"
            app:layout_constraintBottom_toTopOf="@+id/sleepresearchimgBottom"
            app:layout_constraintStart_toStartOf="@+id/tv_sleepresearchtitle"
            app:layout_constraintTop_toBottomOf="@+id/tv_sleepresearchtitle"
            style="@style/FontMedium.17sp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/sleepresearchimgBottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <ImageView
                android:layout_gravity="center_vertical"
                android:layout_width="29dp"
                android:layout_height="29dp"
                android:src="@drawable/health_research_logo"
                android:scaleType="centerInside"
                android:layout_marginStart="-3dp"/>
            <View
                android:layout_gravity="center_vertical"
                android:background="@drawable/layer_divider_line"
                android:layout_width="1dp"
                android:layout_height="16dp"
                android:layout_marginHorizontal="8dp"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:layout_width="80dp"
                android:layout_height="20dp"
                android:src="@drawable/health_ic_sleep_research_entrance_img_2"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
