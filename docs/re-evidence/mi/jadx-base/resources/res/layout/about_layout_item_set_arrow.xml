<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/common_set_item_height">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/arrow_item_name_linear"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/common_set_item_margin"
        android:layout_marginBottom="@dimen/common_set_item_margin"
        android:layout_marginStart="@dimen/common_set_margin_start"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/set_right_linear"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/common_item_set_title_text_size"
            android:textColor="@color/about_setting_item_second"
            android:id="@+id/arrow_name_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            style="@style/TextAppearance.MiuiBold"/>
        <TextView
            android:textSize="@dimen/common_item_set_des_text_size"
            android:textColor="@color/about_setting_item_second"
            android:id="@+id/arrow_des_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textDirection="locale"/>
    </LinearLayout>
    <View
        android:id="@+id/arrow_item_lineview"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/arrow_item_name_linear"
        style="@style/SettingsLineStyle"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/set_right_linear"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:id="@+id/arrow_right_red_point"
            android:background="@drawable/about_shape_round_red"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginEnd="4dp"/>
        <TextView
            android:textSize="@dimen/common_item_set_des_text_size"
            android:textColor="@color/about_setting_item_second"
            android:gravity="end"
            android:id="@+id/arrow_right_value_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/dimen_margin_125dp"
            android:layout_marginEnd="4dp"/>
        <ImageView
            android:id="@+id/arrow_right_arrow_imgv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/right_arrow_icon_fit_rtl"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
