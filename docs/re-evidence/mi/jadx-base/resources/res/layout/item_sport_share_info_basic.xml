<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_sport_share_info_basic_0"
    android:background="@color/transparent"
    android:paddingBottom="15dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/page_extra_padding_horizontal_large"
    android:layout_marginEnd="@dimen/page_extra_padding_horizontal_large">
    <com.xiaomi.fitness.widget.view.RoundImageView
        android:id="@+id/header"
        android:background="@drawable/header_default_icon"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="18dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/font_10"
        android:textColor="@color/white"
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_10dp"
        android:fontFamily="@font/misanslatin_semibold"
        android:layout_marginEnd="18dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header"/>
    <TextView
        android:textSize="@dimen/font_8"
        android:textColor="@color/white_80"
        android:id="@+id/sportNameTxt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/misanslatin_medium"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/name"/>
    <TextView
        android:textSize="40sp"
        android:textColor="@color/white"
        android:id="@+id/mainValueTxt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_10dp"
        android:fontFamily="@font/misanslatin_semibold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/recyclerSportInfo"/>
    <TextView
        android:textColor="@color/white"
        android:id="@+id/unitText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/misanslatin_semibold"
        android:layout_marginStart="@dimen/dimen_margin_5dp"
        app:layout_constraintBaseline_toBaselineOf="@+id/mainValueTxt"
        app:layout_constraintBottom_toBottomOf="@+id/mainValueTxt"
        app:layout_constraintStart_toEndOf="@+id/mainValueTxt"/>
    <TextView
        android:textSize="11sp"
        android:textColor="@color/black_40"
        android:id="@+id/mainValueDesTV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/misanslatin_demibold"
        android:layout_marginStart="@dimen/dimen_margin_2dp"
        app:layout_constraintBaseline_toBaselineOf="@+id/mainValueTxt"
        app:layout_constraintBottom_toBottomOf="@+id/mainValueTxt"
        app:layout_constraintStart_toEndOf="@+id/unitText"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/text_color_60"
        android:id="@+id/txtCheckLabel"
        android:background="@drawable/bg_sport_detail_check_label"
        android:paddingTop="2dp"
        android:paddingBottom="@dimen/dimen_margin_2dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="42dp"
        android:layout_marginBottom="@dimen/dimen_margin_3dp"
        android:text="@string/trail_label_sport_check"
        android:fontFamily="@style/FontMedium"
        android:paddingStart="@dimen/dimen_margin_5dp"
        android:paddingEnd="@dimen/dimen_margin_5dp"
        android:layout_marginStart="2dp"
        app:layout_constraintBottom_toTopOf="@+id/unitText"
        app:layout_constraintStart_toEndOf="@+id/mainValueTxt"/>
    <com.xiaomi.fitness.detail.view.ShareTrackLineView
        android:id="@+id/shareLineView"
        android:layout_width="80dp"
        android:layout_height="53dp"
        android:layout_marginTop="@dimen/dimen_margin_10dp"
        app:layout_constraintBottom_toBottomOf="@+id/unitText"
        app:layout_constraintEnd_toEndOf="parent"/>
    <com.xiaomi.fitness.share.view.ShareRoutineView
        android:id="@+id/routineView"
        android:layout_width="90dp"
        android:layout_height="53dp"
        android:layout_marginTop="@dimen/dimen_margin_10dp"
        android:layout_marginStart="@dimen/dimen_margin_20dp"
        app:layout_constraintBottom_toBottomOf="@+id/unitText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/recyclerSportInfo"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerSportInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_5dp"
        android:overScrollMode="never"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sportNameTxt"/>
</androidx.constraintlayout.widget.ConstraintLayout>
