<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/GradientView"
    android:tag="layout/layout_data_item_relative_0"
    android:background="@drawable/selector_round"
    android:paddingBottom="@dimen/margin_20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/img_sport_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_20dp"
        android:src="@drawable/health_data_calorie"
        android:scaleType="center"
        android:layout_marginStart="@dimen/margin_20dp"/>
    <TextView
        android:textColor="@color/health_home_txt_color"
        android:id="@+id/txt_sport_type_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_7dp"
        android:text="@string/health_data_type_calorie"
        android:layout_marginStart="@dimen/dimen_margin_20dp"
        style="@style/FontMedium.16sp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/blood_pressure_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textColor="@color/health_home_txt_color"
            android:id="@+id/txt_data_content_str"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_20dp"
            style="@style/FontRegular.11sp"/>
        <TextView
            android:textColor="#f22424"
            android:id="@+id/data_exception_tv"
            android:background="#1af22424"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/relative_care_data_exception"
            android:layout_marginStart="@dimen/dimen_margin_6dp"
            android:paddingHorizontal="@dimen/dimen_margin_3dp"/>
    </LinearLayout>
</androidx.appcompat.widget.LinearLayoutCompat>
