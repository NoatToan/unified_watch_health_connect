<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/layoutView"
    android:tag="layout/nfc_fragment_coupon_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/page_padding_horizontal_large"
    android:paddingEnd="@dimen/page_padding_horizontal_large">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listView"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <RelativeLayout
        android:layout_gravity="bottom"
        android:id="@+id/emptyView"
        android:paddingBottom="@dimen/nfc_nextpay_coupon_dialog_padding_bottom"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="60dp"
        android:paddingStart="@dimen/nfc_nextpay_coupon_dialog_padding_left"
        android:paddingEnd="@dimen/nfc_nextpay_coupon_dialog_padding_right">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="180dp"
            android:layout_centerHorizontal="true">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:src="@drawable/nfc_nextpay_coupon_error_icon"/>
            <TextView
                android:textSize="14dp"
                android:textColor="#999999"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/nfc_nextpay_coupon_error_title_margin_bottom"
                android:text="@string/nfc_nextpay_coupon_error_title_content"/>
        </LinearLayout>
        <TextView
            android:id="@+id/gotItView"
            android:text="@string/nfc_common_known"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp"
            style="@style/BaseButton.Positive"/>
    </RelativeLayout>
    <TextView
        android:textSize="@dimen/nfc_nextpay_coupon_use_desc_text_size"
        android:textColor="@color/text_color_60"
        android:gravity="center"
        android:id="@+id/tipsView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/nfc_nextpay_coupon_use_desc"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:id="@+id/comfirmView"
        android:layout_marginTop="@dimen/nfc_nextpay_coupon_not_select_margin_top"
        android:layout_marginBottom="@dimen/common_btn_margin"
        android:text="@string/confirm"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp"
        style="@style/BaseButton.Positive"/>
</LinearLayout>
