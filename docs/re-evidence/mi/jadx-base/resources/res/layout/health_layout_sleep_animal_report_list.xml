<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/health_layout_sleep_animal_report_list_0"
    android:background="@drawable/shape_data_item_bg"
    android:paddingTop="@dimen/size_20"
    android:paddingBottom="@dimen/size_30"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="18dp">
    <include
        android:id="@+id/layout_common_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="-18dp"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/layout_common_icon_title"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_content"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp">
        <include
            android:id="@+id/layout_animal_report_schedule"
            layout="@layout/health_layout_sleep_insight_schedule_report"/>
        <include
            android:id="@+id/layout_animal_report_continuity"
            layout="@layout/health_layout_sleep_insight_continuity_report"/>
        <include
            android:id="@+id/layout_animal_report_day_nap"
            layout="@layout/health_layout_sleep_insight_day_nap_report"/>
        <View
            android:id="@+id/divider_line"
            android:background="@color/common_divider_bg_color"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_0_33"
            android:layout_marginTop="@dimen/size_20"
            android:layout_marginBottom="@dimen/size_43_67"/>
        <include
            android:id="@+id/layout_animal_report_stress"
            layout="@layout/health_layout_sleep_insight_stress_report"/>
        <include
            android:id="@+id/layout_animal_report_strength"
            layout="@layout/health_layout_sleep_insight_strength_report"/>
    </LinearLayout>
</LinearLayout>
