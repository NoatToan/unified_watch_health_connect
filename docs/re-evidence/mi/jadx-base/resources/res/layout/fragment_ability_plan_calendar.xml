<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/fragment_ability_plan_calendar_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/dimen_margin_12dp"
    android:paddingEnd="@dimen/dimen_margin_12dp">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/topWeek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_margin_6dp"
        app:layout_constraintTop_toBottomOf="parent">
        <TextView
            android:textSize="12dp"
            android:textColor="@color/text_color_30"
            android:gravity="center"
            android:id="@+id/mondayTip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/misanslatin_regular"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"/>
        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/text_color_30"
            android:gravity="center"
            android:id="@+id/tuesdayTip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/misanslatin_regular"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"/>
        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/text_color_30"
            android:gravity="center"
            android:id="@+id/wednesdayTip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/misanslatin_regular"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"/>
        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/text_color_30"
            android:gravity="center"
            android:id="@+id/thursdayTip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/misanslatin_regular"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"/>
        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/text_color_30"
            android:gravity="center"
            android:id="@+id/fridayTip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/misanslatin_regular"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"/>
        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/text_color_30"
            android:gravity="center"
            android:id="@+id/saturdayTip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/misanslatin_regular"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"/>
        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/text_color_30"
            android:gravity="center"
            android:id="@+id/sundayTip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/misanslatin_regular"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"/>
    </LinearLayout>
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/weekPager"
        android:layout_width="match_parent"
        android:layout_height="47dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/dayTrainingList"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="@dimen/dimen_16sp"
            android:textColor="@color/text_color_80"
            android:layout_gravity="center"
            android:id="@+id/noneTrainingtip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="46dp"
            android:text="@string/training_plan_today_rest_tip"
            android:paddingHorizontal="@dimen/dimen_margin_18dp"
            android:paddingVertical="@dimen/dimen_margin_6dp"/>
    </LinearLayout>
</LinearLayout>
