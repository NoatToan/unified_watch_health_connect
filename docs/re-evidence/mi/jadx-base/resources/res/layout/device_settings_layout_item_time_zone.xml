<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/rootview"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/img_sort"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_common_item_sort"
        android:scaleType="center"
        android:layout_marginEnd="@dimen/dimen_margin_15dp"/>
    <com.xiaomi.fitness.devicesettings.widget.TimeZoneItemView
        android:id="@+id/contentView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/checkbox_timezone"
        android:background="@drawable/device_settings_selector_clock_check"
        android:visibility="gone"
        android:layout_width="21dp"
        android:layout_height="21dp"
        android:button="@null"
        android:layout_marginStart="10dp"/>
</LinearLayout>
