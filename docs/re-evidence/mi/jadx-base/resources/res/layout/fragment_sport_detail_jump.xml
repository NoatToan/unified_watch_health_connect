<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/fragment_sport_detail_jump_0"
    android:paddingBottom="15dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.xiaomi.fitness.widget.view.DataTitleSimpleView
        android:id="@+id/dataSimpleTitleView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.xiaomi.fitness.chart.mpchart.linechart.CustomLineChart
            android:id="@+id/chart"
            android:layout_width="match_parent"
            android:layout_height="@dimen/custom_chart_height_245dp"
            android:layout_marginTop="2dp"
            android:paddingStart="2dp"
            android:paddingEnd="@dimen/padding_1dp"
            android:layout_marginStart="18dp"
            app:enableMaxCircle="false"
            app:enableMaxPoup="true"
            app:enableSportYAxisLabel="true"
            app:enableTimeXAxisLabel="true"
            app:enableXAxisGridLine="false"
            app:enableYAxisGridLine="true"
            app:lineColor="@color/sport_speed_color"
            app:lineFillColor="@color/sport_speed_light_color"
            app:lineFillRes="@drawable/sport_fill_speed"
            app:lineStrokeWidth="@integer/sport_chart_line_width"
            app:maxYAxisRatio="0.2"
            app:minYAxisZero="false"
            app:sportYAxisLabelType="1"/>
    </FrameLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_segment"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_5dp"
        android:layout_marginBottom="@dimen/dimen_margin_5dp"
        android:layout_marginStart="@dimen/dimen_margin_10dp"
        android:layout_marginEnd="@dimen/dimen_margin_10dp"/>
</LinearLayout>
