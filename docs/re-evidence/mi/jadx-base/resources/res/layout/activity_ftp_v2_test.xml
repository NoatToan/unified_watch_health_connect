<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:tag="layout/activity_ftp_v2_test_0"
    android:paddingTop="17.66dp"
    android:paddingBottom="17.66dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/sport_data_layout"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="35dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:minWidth="240dp"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toTopOf="@+id/course_relativelayout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="spread_inside">
            <TextView
                android:textSize="@dimen/font_16"
                android:textColor="@color/text_color"
                android:id="@+id/audio_title_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="93.33dp"
                android:includeFontPadding="false"
                android:fontFamily="@font/misanslatin_regular"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/size_2_67">
                <TextView
                    android:textSize="@dimen/font_14"
                    android:textColor="@color/text_color_80"
                    android:gravity="center"
                    android:id="@+id/sportDeviceView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="96dp"
                    android:text="@string/sport_bike_is_connected"
                    android:includeFontPadding="false"/>
                <ImageView
                    android:id="@+id/link_status_iv"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/course_audio_link_open"
                    android:layout_marginHorizontal="5dp"
                    app:layout_constraintBottom_toBottomOf="@+id/sportDeviceView"
                    app:layout_constraintStart_toEndOf="@+id/sportDeviceView"
                    app:layout_constraintTop_toTopOf="@+id/sportDeviceView"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:textSize="@dimen/font_24"
                android:textColor="@color/text_color"
                android:id="@+id/body_condition_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_12"
                android:text="@string/sport_eco_ftp_warm_up_part"
                android:includeFontPadding="false"
                android:fontFamily="@font/misanslatin_bold"/>
            <TextView
                android:textSize="@dimen/font_40"
                android:textColor="@color/text_color"
                android:id="@+id/body_condition2_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_9_33"
                android:text="@string/sport_eco_ftp_part0"
                android:includeFontPadding="false"
                android:fontFamily="@font/misanslatin_bold"/>
        </LinearLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/course_relativelayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_9_33"
            android:layout_marginBottom="25dp"
            android:minWidth="240dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintStart_toStartOf="parent">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/powerItemView"
                android:layout_width="wrap_content"
                android:layout_height="60dp"
                android:minWidth="100dp">
                <TextView
                    android:textSize="@dimen/font_13_33"
                    android:textColor="@color/text_color"
                    android:id="@+id/powerItem"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="@dimen/font_30"
                    android:textColor="@color/ftp_target_value"
                    android:id="@+id/targetPowerItem"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <TextView
                android:textColor="@color/text_color"
                android:id="@+id/resistanceItem"
                android:layout_width="wrap_content"
                android:layout_height="60dp"
                android:minWidth="100dp"
                android:includeFontPadding="false"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/powerItemView"
                app:layout_constraintVertical_bias="0"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/cadenceItemView"
                android:layout_width="wrap_content"
                android:layout_height="60dp"
                android:minWidth="100dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="1"
                app:layout_constraintStart_toEndOf="@+id/powerItemView">
                <TextView
                    android:textSize="@dimen/font_13_33"
                    android:textColor="@color/text_color"
                    android:id="@+id/cadenceItem"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="@dimen/font_30"
                    android:textColor="@color/ftp_target_value"
                    android:id="@+id/targetCadenceItem"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ftp_progress_group"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toStartOf="@+id/sport_operation_layout"
        app:layout_constraintStart_toEndOf="@+id/sport_data_layout">
        <com.xiaomi.fitness.sport_eco.ftp.view.ColorfulRingProgressView
            android:id="@+id/ftp_progress"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_marginTop="@dimen/course_share_bottom"
            app:bgColor="@color/ftp_progress_bg"
            app:fgColorEnd="@color/ftp_progress"
            app:fgColorStart="@color/ftp_progress_0"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:percent="90"
            app:startAngle="0"
            app:strokeWidth="22dp"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ftp_progress_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/course_share_bottom"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="@dimen/font_36_67"
                android:textColor="@color/text_color"
                android:id="@+id/ftp_progress_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="180"
                android:fontFamily="@font/misanslatin_demibold"/>
            <TextView
                android:textSize="@dimen/font_18_67"
                android:textStyle="bold"
                android:textColor="#cccccc"
                android:layout_gravity="bottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:text="s"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/sport_operation_layout"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:paddingEnd="@dimen/margin_27dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <FrameLayout
            android:id="@+id/frameLayout_finish_group"
            android:visibility="gone"
            android:layout_width="120dp"
            android:layout_height="120dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/finish_ring_progress_bg"
                android:background="@drawable/ic_bg_ring_4_white"
                android:visibility="gone"
                android:layout_width="100dp"
                android:layout_height="100dp"/>
            <com.xiaomi.fitness.sport_eco.view.widget.CircularProgressLayout
                android:layout_gravity="center"
                android:id="@+id/finish_circle_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cpl_backgroundColor="@color/sport_color_white"
                app:cpl_colorSchemeColors="@color/color_ff612e"
                app:cpl_strokeWidth="6dp">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/finish_sport_action"
                    android:background="@drawable/ic_bg_circle_ff612e_70_off"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:scaleType="center"/>
            </com.xiaomi.fitness.sport_eco.view.widget.CircularProgressLayout>
        </FrameLayout>
        <ImageView
            android:id="@+id/audio_pause_iv"
            android:background="@drawable/course_start_or_pause_bg"
            android:visibility="gone"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_marginBottom="60dp"
            android:src="@drawable/course_audio_pause_img"
            android:scaleType="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <ImageView
            android:id="@+id/audio_start_iv"
            android:background="@drawable/course_start_or_pause_bg"
            android:visibility="gone"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:src="@drawable/course_audio_starting_img"
            android:scaleType="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.airbnb.lottie.LottieAnimationView
        android:layout_gravity="center"
        android:id="@+id/countdown_lottie_view"
        android:background="@color/common_white"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:lottie_fileName="countdown_white.json"/>
</androidx.constraintlayout.widget.ConstraintLayout>
