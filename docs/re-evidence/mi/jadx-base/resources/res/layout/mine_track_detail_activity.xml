<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/mine_track_detail_activity_0"
    android:background="@color/mine_track_detail_item_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.mi.health.sport.TrackMapView
            android:id="@+id/trackMapView"
            android:layout_width="match_parent"
            android:layout_height="500dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.mi.health.sport.TrackShareRoutineView
            android:id="@+id/routineView"
            android:background="@drawable/mine_track_line_bg"
            android:visibility="invisible"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginTop="100dp"
            android:layout_marginStart="@dimen/dimen_margin_20dp"/>
        <androidx.core.widget.NestedScrollView
            android:id="@+id/mScrollView"
            android:layout_width="match_parent"
            android:layout_height="700dp"
            android:fillViewport="true"
            android:overScrollMode="never"
            app:behavior_hideable="false"
            app:layout_behavior="@string/bottom_sheet_behavior"
            app:layout_constraintTop_toBottomOf="@+id/trackMapView">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/sport_report"
                    android:background="@drawable/mine_track_detail_bg"
                    android:paddingTop="21dp"
                    android:paddingBottom="21dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:paddingStart="23dp"
                    android:paddingEnd="23dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <TextView
                        android:textSize="22.7dp"
                        android:textColor="@color/mine_track_detail_text_color"
                        android:id="@+id/trackName"
                        android:tag="binding_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:id="@+id/trackDate"
                        android:tag="binding_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:layout_constraintStart_toStartOf="@+id/trackName"
                        app:layout_constraintTop_toBottomOf="@+id/trackName"/>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="26dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="@+id/trackDate"
                        app:layout_constraintTop_toBottomOf="@+id/trackDate">
                        <TextView
                            android:background="@color/black"
                            android:layout_width="1dp"
                            android:layout_height="81dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <TextView
                            android:textSize="22dp"
                            android:textColor="@color/mine_track_detail_text_color"
                            android:id="@+id/totalDuration"
                            android:tag="binding_3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <TextView
                            android:id="@+id/totalDurationDes"
                            android:tag="binding_4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:layout_constraintStart_toStartOf="@+id/totalDuration"
                            app:layout_constraintTop_toBottomOf="@+id/totalDuration"/>
                        <ImageView
                            android:id="@+id/totalDurationDesTip"
                            android:background="@drawable/mine_tip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            app:layout_constraintBottom_toBottomOf="@+id/totalDurationDes"
                            app:layout_constraintStart_toEndOf="@+id/totalDurationDes"
                            app:layout_constraintTop_toTopOf="@+id/totalDurationDes"/>
                        <TextView
                            android:textSize="22dp"
                            android:textColor="@color/mine_track_detail_text_color"
                            android:id="@+id/totalDis"
                            android:tag="binding_5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:layout_constraintStart_toStartOf="@+id/totalDisDes"
                            app:layout_constraintTop_toTopOf="@+id/totalDuration"/>
                        <TextView
                            android:id="@+id/totalDisDes"
                            android:tag="binding_6"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="30dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/totalDis"/>
                        <ImageView
                            android:id="@+id/totalDisDesTip"
                            android:background="@drawable/mine_tip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            app:layout_constraintStart_toEndOf="@+id/totalDisDes"
                            app:layout_constraintTop_toTopOf="@+id/totalDisDes"/>
                        <TextView
                            android:textSize="22dp"
                            android:textColor="@color/mine_track_detail_text_color"
                            android:id="@+id/totalRise"
                            android:tag="binding_7"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            app:layout_constraintStart_toStartOf="@+id/totalDurationDes"
                            app:layout_constraintTop_toBottomOf="@+id/totalDurationDes"/>
                        <TextView
                            android:id="@+id/totalRiseDes"
                            android:tag="binding_8"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:layout_constraintStart_toStartOf="@+id/totalRise"
                            app:layout_constraintTop_toBottomOf="@+id/totalRise"/>
                        <ImageView
                            android:id="@+id/totalRiseDesTip"
                            android:background="@drawable/mine_tip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            app:layout_constraintBottom_toBottomOf="@+id/totalRiseDes"
                            app:layout_constraintStart_toEndOf="@+id/totalRiseDes"
                            app:layout_constraintTop_toTopOf="@+id/totalRiseDes"/>
                        <TextView
                            android:textSize="22dp"
                            android:textColor="@color/mine_track_detail_text_color"
                            android:id="@+id/totalDrop"
                            android:tag="binding_9"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:layout_constraintStart_toStartOf="@+id/totalDis"
                            app:layout_constraintTop_toTopOf="@+id/totalRise"/>
                        <TextView
                            android:id="@+id/totalDropDes"
                            android:tag="binding_10"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:layout_constraintStart_toStartOf="@+id/totalDrop"
                            app:layout_constraintTop_toBottomOf="@+id/totalDrop"/>
                        <ImageView
                            android:id="@+id/totalDropDesTip"
                            android:background="@drawable/mine_tip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            app:layout_constraintBottom_toBottomOf="@+id/totalDropDes"
                            app:layout_constraintStart_toEndOf="@+id/totalDropDes"
                            app:layout_constraintTop_toTopOf="@+id/totalDropDes"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/chartLl"
                    android:background="@drawable/mine_track_detail_bg"
                    android:paddingBottom="@dimen/dimen_margin_15dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/sport_report">
                    <com.xiaomi.fitness.widget.view.DataTitleSimpleView
                        android:id="@+id/dataSimpleTitleView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/itemViewContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/dimen_margin_20dp">
                        <com.xiaomi.fitness.baseui.widget.SportDetailItemView
                            android:id="@+id/detailItemView1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            app:itemGravity="0"
                            app:itemHeight="100dp"
                            app:txtNameColor="@color/text_color"
                            app:txtNameSize="@dimen/font_10"
                            app:txtValueColor="@color/text_color"
                            app:txtValueFont="@font/misanslatin_semibold"
                            app:txtValueSize="@dimen/dimen_26sp"/>
                        <com.xiaomi.fitness.baseui.widget.SportDetailItemView
                            android:id="@+id/detailItemView2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            app:itemGravity="0"
                            app:itemHeight="100dp"
                            app:txtNameColor="@color/text_color"
                            app:txtNameSize="@dimen/font_10"
                            app:txtValueColor="@color/text_color"
                            app:txtValueFont="@font/misanslatin_semibold"
                            app:txtValueSize="@dimen/dimen_26sp"/>
                    </LinearLayout>
                    <FrameLayout
                        android:id="@+id/chartFl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="12dp">
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="245dp">
                            <com.xiaomi.fitness.chart.mpchart.linechart.CustomLineChart
                                android:id="@+id/chart"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginTop="2dp"
                                android:layout_marginBottom="5dp"
                                app:enableMaxCircle="false"
                                app:enableMaxPoup="true"
                                app:enableSportYAxisLabel="true"
                                app:enableTimeXAxisLabel="true"
                                app:enableXAxisGridLine="false"
                                app:enableYAxisGridLine="true"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:lineColor="@color/sport_height_color"
                                app:lineFillColor="@color/sport_height_light_color"
                                app:lineFillRes="@drawable/sport_fill_height"
                                app:lineStrokeWidth="@integer/sport_chart_line_width"
                                app:maxYAxisRatio="0.2"
                                app:minYAxisZero="false"
                                app:sportYAxisLabelType="1"/>
                            <TextView
                                android:textSize="10dp"
                                android:textColor="@color/black_30_transparent"
                                android:id="@+id/startX"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="@string/track_0_kilo"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="@+id/chart"/>
                            <TextView
                                android:textSize="10dp"
                                android:textColor="@color/black_30_transparent"
                                android:id="@+id/endX"
                                android:tag="binding_11"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="25dp"
                                app:layout_constraintBottom_toBottomOf="@+id/startX"
                                app:layout_constraintEnd_toEndOf="parent"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </FrameLayout>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <include
        android:id="@+id/noEleLayout"
        layout="@layout/mine_no_ele_layout"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/exportImg"
            android:background="@drawable/mine_export_track"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/route_track_export_track_into_file"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/mapEdit"
            android:background="@drawable/mine_map_edit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:contentDescription="@string/trail_sport_map_edit"
            app:layout_constraintEnd_toEndOf="@+id/exportImg"
            app:layout_constraintStart_toStartOf="@+id/exportImg"
            app:layout_constraintTop_toBottomOf="@+id/exportImg"/>
        <ImageView
            android:id="@+id/backImg"
            android:background="@drawable/selector_back_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="17dp"
            android:textColor="@color/mine_track_detail_text_color"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mine_route_detail"
            android:layout_marginStart="5dp"
            app:layout_constraintBottom_toBottomOf="@+id/backImg"
            app:layout_constraintStart_toEndOf="@+id/backImg"
            app:layout_constraintTop_toTopOf="@+id/backImg"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <Button
        android:textSize="16dp"
        android:id="@+id/operateBtn"
        android:layout_width="0dp"
        android:layout_height="45dp"
        android:layout_marginTop="25dp"
        android:text="@string/mine_import_from_local"
        android:layout_marginStart="27dp"
        android:layout_marginEnd="27dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/CommonBtn.Primary"/>
    <include
        android:id="@+id/progressInclude"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="130dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        layout="@layout/mine_track_detail_progress"/>
</androidx.constraintlayout.widget.ConstraintLayout>
