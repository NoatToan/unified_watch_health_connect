<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/health_triplet_item_with_logo_0"
    android:background="@drawable/shape_card_bg_normal"
    android:paddingTop="@dimen/dimen_margin_20dp"
    android:paddingBottom="@dimen/dimen_margin_30dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="@color/text_color"
        android:gravity="center_vertical"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/health_weight_control_advice"
        android:drawablePadding="@dimen/dimen_margin_10dp"
        android:drawableStart="@drawable/ic_control_advice"
        android:layout_marginHorizontal="@dimen/page_extra_padding_horizontal_large"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/FontMedium.14sp"/>
    <com.xiaomi.fitness.widget.view.DividerView
        android:id="@+id/horizontal_divider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_20dp"
        android:layout_marginHorizontal="@dimen/page_extra_padding_horizontal_large"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/triplet_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_30dp"
        android:baselineAligned="false"
        android:weightSum="3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/horizontal_divider">
        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="@dimen/dimen_margin_18dp">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/weight_control_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/weight_control"
                    android:background="@drawable/health_weight_ic_weight_control_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"/>
                <TextView
                    android:textSize="@dimen/dimen_11sp"
                    android:textColor="@color/text_color"
                    android:id="@+id/weight_control_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_margin_10dp"
                    style="@style/FontLatinMedium"/>
                <TextView
                    android:textColor="@color/text_color_40"
                    android:id="@+id/weight_control_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/health_weight_control"
                    style="@style/FontRegular.11sp"/>
            </LinearLayout>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <com.xiaomi.fitness.widget.view.DividerView
                android:id="@+id/muscle_divider"
                android:layout_width="wrap_content"
                android:layout_height="78.67dp"
                android:layout_marginEnd="@dimen/dimen_margin_18dp"
                android:layout_alignParentStart="true"
                app:isHorizontal="true"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/muscle_control_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@+id/muscle_divider">
                <ImageView
                    android:id="@+id/muscle_control"
                    android:background="@drawable/health_weight_ic_muscle_control_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"/>
                <TextView
                    android:textSize="@dimen/dimen_11sp"
                    android:textColor="@color/text_color"
                    android:id="@+id/muscle_control_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_margin_10dp"
                    style="@style/FontLatinMedium"/>
                <TextView
                    android:textColor="@color/text_color_40"
                    android:id="@+id/muscle_control_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/health_muscle_control"
                    style="@style/FontRegular.11sp"/>
            </LinearLayout>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <com.xiaomi.fitness.widget.view.DividerView
                android:id="@+id/fat_divider"
                android:layout_width="wrap_content"
                android:layout_height="78.67dp"
                android:layout_marginEnd="@dimen/dimen_margin_18dp"
                android:layout_alignParentStart="true"
                app:isHorizontal="true"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/fat_control_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@+id/fat_divider">
                <ImageView
                    android:id="@+id/fat_control"
                    android:background="@drawable/health_weight_ic_fat_control_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"/>
                <TextView
                    android:textSize="@dimen/dimen_11sp"
                    android:textColor="@color/text_color"
                    android:id="@+id/fat_control_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_margin_10dp"
                    style="@style/FontLatinMedium"/>
                <TextView
                    android:textColor="@color/text_color_40"
                    android:id="@+id/fat_control_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/health_fat_control"
                    style="@style/FontRegular.11sp"/>
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
