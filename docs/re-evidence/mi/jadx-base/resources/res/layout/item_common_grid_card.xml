<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="@dimen/size_30"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/view_divider"
        android:background="@color/common_divider_bg_color"
        android:layout_width="@dimen/size_0_33"
        android:layout_height="@dimen/size_36"
        android:layout_marginTop="@dimen/size_7"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/tv_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_18"
        app:layout_constraintStart_toEndOf="@+id/view_divider"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/CardTextAppearance.ItemValue"/>
    <TextView
        android:textSize="@dimen/size_10"
        android:ellipsize="end"
        android:id="@+id/tv_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/size_2"
        app:layout_constraintBaseline_toBaselineOf="@+id/tv_value"
        app:layout_constraintStart_toEndOf="@+id/tv_value"
        style="@style/CardTextAppearance.ItemUnit"/>
    <TextView
        android:id="@+id/tv_second_value"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@+id/tv_unit"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/CardTextAppearance.ItemValue"/>
    <TextView
        android:textSize="@dimen/size_10"
        android:ellipsize="end"
        android:id="@+id/tv_second_unit"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/size_2"
        app:layout_constraintBaseline_toBaselineOf="@+id/tv_value"
        app:layout_constraintStart_toEndOf="@+id/tv_second_value"
        style="@style/CardTextAppearance.ItemUnit"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/tv_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:drawablePadding="@dimen/size_9"
        app:layout_constraintStart_toStartOf="@+id/tv_value"
        app:layout_constraintTop_toBottomOf="@+id/tv_value"
        style="@style/CardTextAppearance.ItemStatus"/>
    <TextView
        android:textSize="@dimen/size_9"
        android:textColor="#f22424"
        android:id="@+id/tv_result"
        android:background="@drawable/shape_evaluation_bg"
        android:paddingTop="@dimen/size_1"
        android:paddingBottom="@dimen/size_1"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/size_3"
        android:paddingEnd="@dimen/size_3"
        android:layout_marginStart="@dimen/size_6"
        app:layout_constraintBottom_toBottomOf="@+id/tv_label"
        app:layout_constraintStart_toEndOf="@+id/tv_label"
        app:layout_constraintTop_toTopOf="@+id/tv_label"/>
</androidx.constraintlayout.widget.ConstraintLayout>
