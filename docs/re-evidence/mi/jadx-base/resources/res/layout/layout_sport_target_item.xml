<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/img_target"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_20dp"
        android:src="@drawable/sport_target"
        android:scaleType="center"
        android:layout_marginStart="20dp"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textColor="@color/text_color"
        android:gravity="center"
        android:id="@+id/txt_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:layout_alignParentTop="true"
        android:layout_marginStart="14dp"
        android:layout_toEndOf="@+id/img_target"
        style="@style/FontMedium.14sp"/>
    <TextView
        android:textColor="@color/text_color"
        android:id="@+id/txt_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_15dp"
        android:layout_below="@+id/img_target"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="14dp"
        style="@style/FontMedium.14sp"/>
    <RelativeLayout
        android:id="@+id/rl_process"
        android:layout_width="match_parent"
        android:layout_height="17dp"
        android:layout_marginTop="@dimen/dimen_margin_7dp"
        android:layout_below="@+id/txt_desc"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp">
        <com.xiaomi.fitness.detail.view.DataDistributeView3
            android:id="@+id/progress_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:rectRadius="@dimen/dimen_margin_10dp"/>
        <com.xiaomi.fitness.baseui.widget.CircularCoverView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            app:cover_color="@color/card_bg_normal"
            app:left_bottom_radius="4dp"
            app:left_top_radius="4dp"
            app:right_bottom_radius="4dp"
            app:right_top_radius="4dp"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="23dp"
        android:layout_marginBottom="30dp"
        android:layout_below="@+id/rl_process">
        <com.xiaomi.fitness.detail.view.SportValueNameUnitView
            android:id="@+id/itemViewTarget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="20dp"
            app:txtNameColor="@color/text_color_40"
            app:txtNameSize="@dimen/dimen_10sp"
            app:txtValueColor="@color/text_color"
            app:txtValueFont="@font/misanslatin_demibold"
            app:txtValueSize="@dimen/dimen_24sp"/>
        <View
            android:background="@color/divider_line_color"
            android:layout_width="1px"
            android:layout_height="match_parent"/>
        <com.xiaomi.fitness.detail.view.SportValueNameUnitView
            android:id="@+id/itemViewActual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="20dp"
            app:txtNameColor="@color/text_color_40"
            app:txtNameSize="@dimen/dimen_10sp"
            app:txtValueColor="@color/text_color"
            app:txtValueFont="@font/misanslatin_demibold"
            app:txtValueSize="@dimen/dimen_24sp"/>
    </LinearLayout>
</RelativeLayout>
