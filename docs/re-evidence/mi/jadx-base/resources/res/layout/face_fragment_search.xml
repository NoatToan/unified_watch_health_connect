<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/face_fragment_search_0"
    android:background="@color/app_4_0_bg_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/dimen_13sp"
        android:textColor="@color/footer_desc"
        android:id="@+id/history_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_8dp"
        android:text="@string/face_search_history"
        android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/history_delete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/face_search_history_delete"
        android:layout_marginEnd="@dimen/dimen_margin_13dp"
        app:layout_constraintBottom_toBottomOf="@+id/history_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/history_title"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/history_recyc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_12dp"
        android:layout_marginHorizontal="@dimen/dimen_margin_12dp"
        app:layout_constraintTop_toBottomOf="@+id/history_title"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/history_group"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="history_title,history_delete,history_recyc"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/search_scroll"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/dimen_margin_5dp">
        <com.xiaomi.fitness.baseui.recyclerview.MoreRecyclerView
            android:id="@+id/search_recyc"
            android:background="@drawable/bg_face_market_item"
            android:paddingBottom="@dimen/dimen_margin_20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/page_padding_horizontal_large"/>
    </androidx.core.widget.NestedScrollView>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/empty_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.42">
        <ImageView
            android:id="@+id/empty_img"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_round_33.33dp"
            android:src="@drawable/icon_common_empty"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/dimen_14sp"
            android:textColor="@color/footer_desc"
            android:gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_10dp"
            android:text="@string/face_search_empty"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/empty_img"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
