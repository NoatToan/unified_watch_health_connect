<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="@color/text_color"
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/popup_menu_item_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/common_top_menu_item_top_margin"
        android:layout_marginBottom="@dimen/common_top_menu_item_bottom_margin"
        android:drawablePadding="@dimen/common_top_menu_drawable_padding"
        android:layout_marginStart="@dimen/common_top_menu_item_left_margin"
        android:layout_marginEnd="@dimen/common_top_menu_item_right_margin"/>
</FrameLayout>
