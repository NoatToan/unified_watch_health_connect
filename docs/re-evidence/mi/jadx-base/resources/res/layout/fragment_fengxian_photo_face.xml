<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_fengxian_photo_face_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include
        android:id="@+id/layout_face_layer"
        layout="@layout/layout_face_layer"/>
    <com.xiaomi.fitness.widget.view.DividerView
        android:id="@+id/divider"
        app:layout_constraintTop_toBottomOf="@+id/layout_face_layer"
        style="@style/SettingDivider.Curse"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#ff000000"
        android:id="@+id/mDescView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:layout_marginStart="@dimen/dimen_margin_26dp"
        android:layout_marginEnd="@dimen/dimen_margin_26dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider"/>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/black_90_transparent"
        android:id="@+id/style_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="29dp"
        android:text="@string/face_photo_face_style"
        android:layout_marginStart="@dimen/dimen_margin_26dp"
        android:layout_marginEnd="@dimen/dimen_margin_26dp"
        app:layout_constraintTop_toBottomOf="@+id/mDescView"/>
    <LinearLayout
        android:id="@+id/out_recy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_24dp"
        android:layout_marginStart="@dimen/dimen_margin_14dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/style_tv">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/style_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <com.xiaomi.fitness.watch.face.widget.PhotoBgPicker
        android:orientation="vertical"
        android:id="@+id/photo_bg_picker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="23dp"
        app:layout_constraintTop_toBottomOf="@+id/out_recy"/>
</androidx.constraintlayout.widget.ConstraintLayout>
