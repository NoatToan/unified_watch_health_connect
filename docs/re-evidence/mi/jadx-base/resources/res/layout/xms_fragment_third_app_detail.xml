<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/xms_fragment_third_app_detail_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <miuix.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="27dp"
            android:paddingEnd="27dp">
            <ImageView
                android:id="@+id/app_icon"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginTop="31dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textColor="@color/text_color"
                android:id="@+id/app_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/app_icon"
                style="@style/FontMedium.20sp"/>
            <View
                android:id="@+id/divider_view"
                android:background="@color/black_10_transparent"
                android:layout_width="match_parent"
                android:layout_height="0.3dp"
                android:layout_marginTop="40dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/app_name"/>
            <TextView
                android:textColor="@color/text_color"
                android:id="@+id/app_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="@string/xms_third_app_info"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/divider_view"
                style="@style/FontMedium.16sp"/>
            <com.xiaomi.xms.wearable.widget.ExpandableTextView
                android:textColor="@color/text_color_60"
                android:id="@+id/info_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@+id/app_info"
                app:xms_expandedSuffix="@string/xms_third_app_detail_fold"
                app:xms_foldLines="4"
                app:xms_foldedSuffix="@string/xms_third_app_detail_expand"
                app:xms_suffixTextColor="@color/colorPrimary"
                style="@style/FontRegular.14sp"/>
            <com.xiaomi.xms.wearable.widget.ExpandableTextView
                android:textColor="@color/text_color_60"
                android:id="@+id/update_log_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@+id/info_tv"
                app:xms_expandedSuffix="@string/xms_third_app_detail_fold"
                app:xms_foldLines="4"
                app:xms_foldedSuffix="@string/xms_third_app_detail_expand"
                app:xms_suffixTextColor="@color/colorPrimary"
                style="@style/FontRegular.14sp"/>
            <com.xiaomi.xms.wearable.widget.ExpandableTextView
                android:textColor="@color/text_color_60"
                android:id="@+id/size_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@+id/update_log_tv"
                app:xms_expandedSuffix="@string/xms_third_app_detail_fold"
                app:xms_foldLines="4"
                app:xms_foldedSuffix="@string/xms_third_app_detail_expand"
                app:xms_suffixTextColor="@color/colorPrimary"
                style="@style/FontRegular.14sp"/>
            <com.xiaomi.xms.wearable.widget.ExpandableTextView
                android:textColor="@color/text_color_60"
                android:id="@+id/update_date_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@+id/size_tv"
                app:xms_expandedSuffix="@string/xms_third_app_detail_fold"
                app:xms_foldLines="4"
                app:xms_foldedSuffix="@string/xms_third_app_detail_expand"
                app:xms_suffixTextColor="@color/colorPrimary"
                style="@style/FontRegular.14sp"/>
            <com.xiaomi.xms.wearable.widget.ExpandableTextView
                android:textColor="@color/text_color_60"
                android:id="@+id/developerNameView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@+id/update_date_tv"
                app:xms_expandedSuffix="@string/xms_third_app_detail_fold"
                app:xms_foldLines="4"
                app:xms_foldedSuffix="@string/xms_third_app_detail_expand"
                app:xms_suffixTextColor="@color/colorPrimary"
                style="@style/FontRegular.14sp"/>
            <com.xiaomi.xms.wearable.widget.ExpandableTextView
                android:textColor="@color/text_color_60"
                android:id="@+id/recoderNameView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@+id/developerNameView"
                app:xms_expandedSuffix="@string/xms_third_app_detail_fold"
                app:xms_foldLines="4"
                app:xms_foldedSuffix="@string/xms_third_app_detail_expand"
                app:xms_suffixTextColor="@color/colorPrimary"
                style="@style/FontRegular.14sp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </miuix.core.widget.NestedScrollView>
    <include
        android:id="@+id/bottom_layout"
        layout="@layout/xms_view_third_app_bottom_view"/>
</LinearLayout>
