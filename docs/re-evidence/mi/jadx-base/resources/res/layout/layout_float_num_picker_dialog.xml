<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_picker"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_152_33"
        android:layout_marginStart="@dimen/size_80"
        android:layout_marginEnd="@dimen/size_80"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.xiaomi.fitness.baseui.widget.NumberPickerView
            android:id="@+id/picker_hour"
            android:focusable="true"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:npv_NumberDigits="1"
            app:npv_WrapSelectorWheel="true"
            style="@style/HealthPicker.Number.DateDialog"/>
        <TextView
            android:textSize="@dimen/font_24"
            android:textColor="@color/common_btn_normal_red_bg_color"
            android:layout_gravity="center_vertical"
            android:id="@+id/decimal_separator"
            android:layout_width="@dimen/dimen_margin_20dp"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"/>
        <com.xiaomi.fitness.baseui.widget.NumberPickerView
            android:id="@+id/picker_minute"
            android:focusable="true"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:layout_constraintEnd_toEndOf="parent"
            app:npv_NumberDigits="1"
            app:npv_WrapSelectorWheel="true"
            style="@style/HealthPicker.Number.DateDialog"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
