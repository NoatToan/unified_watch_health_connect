<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_electronic_scale_weight_guide_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/weight_guide"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/weight_guide_circle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="90dp"
            android:src="@drawable/electronic_scale_guide_circle"
            android:layout_above="@+id/guide_title"
            android:layout_centerHorizontal="true"/>
        <ImageView
            android:id="@+id/iv_weight_guide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/electronic_scale_guide_img_margin_top"
            android:layout_marginBottom="100dp"
            android:scaleType="centerInside"
            android:layout_above="@+id/guide_title"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="@dimen/electronic_scale_guide_title_size"
            android:textColor="@color/text_color"
            android:gravity="center"
            android:id="@+id/guide_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="@string/electronic_scale_hand_title"
            android:layout_above="@+id/guide_subtitle"
            android:layout_centerHorizontal="true"
            android:layout_marginHorizontal="20dp"/>
        <TextView
            android:textSize="@dimen/electronic_scale_guide_subtitle_size"
            android:textColor="@color/text_color_40"
            android:gravity="center"
            android:id="@+id/guide_subtitle"
            android:layout_width="@dimen/electronic_scale_des_width"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/electronic_scale_des_margin_bottom"
            android:text="@string/electronic_scale_handle_desc"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
</FrameLayout>
