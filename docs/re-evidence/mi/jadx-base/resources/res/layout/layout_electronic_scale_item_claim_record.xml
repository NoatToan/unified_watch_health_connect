<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/shape_data_item_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:layout_marginHorizontal="20dp"
    android:paddingHorizontal="20dp"
    android:paddingVertical="20dp">
    <CheckBox
        android:id="@+id/claim_record_ck"
        android:background="@drawable/electronic_sale_selector_check"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:button="@null"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="10dp"
        android:layout_toStartOf="@+id/claim_record_weight"
        android:layout_toEndOf="@+id/claim_record_ck">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/text_color"
            android:id="@+id/claim_record_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/electronic_scale_body_weight"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/text_color_40"
            android:id="@+id/claim_record_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/electronic_scale_body_weight"/>
    </LinearLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/text_color"
        android:id="@+id/claim_record_weight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/electronic_scale_body_weight"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
