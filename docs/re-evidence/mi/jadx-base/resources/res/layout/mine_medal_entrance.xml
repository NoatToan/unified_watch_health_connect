<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/mine_medal_entrance_0"
    android:background="@drawable/mine_label_bg_white"
    android:paddingBottom="@dimen/dimen_margin_12dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="17sp"
        android:id="@+id/medal_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/mine_medal"
        android:layout_marginStart="@dimen/dimen_margin_14dp"
        app:layout_constraintBottom_toBottomOf="@+id/face_entrance_all_img"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/face_entrance_all_img"
        style="@style/FontDemiBold"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/footer_desc"
        android:id="@+id/face_entrance_all_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/mine_medals_title_all"
        app:layout_constraintBottom_toBottomOf="@+id/face_entrance_all_img"
        app:layout_constraintEnd_toStartOf="@+id/face_entrance_all_img"
        app:layout_constraintTop_toTopOf="@+id/face_entrance_all_img"/>
    <ImageView
        android:id="@+id/face_entrance_all_img"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_12dp"
        android:src="@drawable/ic_right_arrow"
        android:layout_marginStart="-2dp"
        android:layout_marginEnd="@dimen/dimen_margin_12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="horizontal"
        android:id="@+id/medal_entrance_recycler_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:nestedScrollingEnabled="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/medal_title"/>
    <include
        android:id="@+id/medal_unlogged_in_entrance"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/page_extra_padding_horizontal_large"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        layout="@layout/mine_medal_unlogged_in_entrance"/>
    <ImageView
        android:id="@+id/medal_bg_when_loading"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/medal_entrance_loading_bg"
        android:layout_marginHorizontal="@dimen/dimen_margin_16dp"
        android:layout_marginVertical="@dimen/size_11_3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/medal_title"/>
    <ImageView
        android:id="@+id/medal_entrance_mask"
        android:visibility="gone"
        android:layout_width="191dp"
        android:layout_height="wrap_content"
        android:translationX="-100dp"
        app:layout_constraintStart_toStartOf="@+id/medal_bg_when_loading"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mine_main_medal_error_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/medal_title">
        <ImageView
            android:id="@+id/mine_main_tab_load_error_base_icon"
            android:background="@drawable/mine_main_tab_load_error_base_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textColor="@color/text_color_60"
            android:id="@+id/load_error_text_view"
            android:layout_width="wrap_content"
            android:layout_height="155dp"
            android:layout_marginTop="@dimen/dimen_margin_6dp"
            android:text="@string/mine_main_medal_icon_text_error"
            android:drawablePadding="@dimen/dimen_margin_8dp"
            android:drawableStart="@drawable/mine_main_medal_icon_error_small"
            android:layout_marginVertical="@dimen/size_11_3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/mine_main_tab_load_error_base_icon"
            style="@style/FontMedium.12sp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
