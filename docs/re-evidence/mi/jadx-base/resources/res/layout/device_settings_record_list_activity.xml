<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/device_settings_record_list_activity_0"
    android:background="@color/page_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/title"
        android:background="@drawable/device_settings_audio_title_bg"
        android:padding="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="23dp"
        android:layout_marginEnd="23dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textColor="@color/text_color_80"
            android:gravity="center"
            android:id="@+id/mobile_phone_storage"
            android:background="@drawable/selector_card_bg"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/device_settings_audio_record_phone"
            android:layout_weight="1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/FontRegular.14sp"/>
        <TextView
            android:textColor="@color/text_color_80"
            android:gravity="center"
            android:id="@+id/headset_storage"
            android:background="@drawable/selector_card_bg"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/device_settings_audio_record_watch"
            android:layout_weight="1"
            app:layout_constraintStart_toEndOf="@+id/mobile_phone_storage"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/FontRegular.14sp"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/frame_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dimen_margin_16dp"
        app:layout_constraintBottom_toTopOf="@+id/record_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/record_layout"
        android:background="@color/device_settings_audio_record_bg_color"
        android:paddingTop="@dimen/dimen_margin_23dp"
        android:paddingBottom="@dimen/dimen_margin_23dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:id="@+id/record_type"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/FontDemiBold.16sp"/>
        <TextView
            android:textColor="@color/text_color_40"
            android:id="@+id/record_time"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dimen_margin_25dp"
            style="@style/FontRegular.12sp"/>
        <ImageView
            android:id="@+id/record_operation_iv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/device_settings_audio_record_start"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
