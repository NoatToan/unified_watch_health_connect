<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/fragment_vitality_day_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.xiaomi.fitness.chart.view.BarChartRecyclerView
            android:id="@+id/vitality_recycler"
            android:paddingTop="@dimen/size_70"
            android:layout_height="311dp"
            app:barChartMaxWidth="@dimen/size_10"
            app:chartColor="@color/fitness_pai_chart"
            app:contentPaddingBottom="@dimen/size_41_3"
            app:displayNumbers="7"
            app:enableStartYAxisLabel="false"
            style="@style/ChartBaseStyle"/>
        <com.xiaomi.fitness.view.DataTitleView
            android:id="@+id/dataTitleView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/layout_open_hr_check"
        android:background="@drawable/selector_card_bg"
        android:paddingTop="@dimen/size_20"
        android:paddingBottom="@dimen/size_20"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size_12"
        android:layout_marginHorizontal="@dimen/health_detail_page_common_margin_horizontal">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_icon"
            android:background="@drawable/ic_health_pai_hrm_open"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:layout_marginStart="@dimen/size_18"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/size_10"
            android:layout_marginEnd="@dimen/size_10">
            <TextView
                android:textColor="@color/text_color"
                android:gravity="start"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/health_pai_open_hr_check_txt"
                style="@style/FontMedium.14sp"/>
            <TextView
                android:textColor="@color/text_color_40"
                android:gravity="start"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_title_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/health_pai_open_hr_check_txt_desc"
                style="@style/FontMedium.12sp"/>
        </LinearLayout>
        <com.xiaomi.fitness.widget.button.SwitchButton
            android:layout_gravity="center_vertical"
            android:id="@+id/switch_btn"
            android:layout_width="@dimen/lib_sb_width"
            android:layout_height="@dimen/lib_sb_height"
            android:layout_marginStart="@dimen/feature_item_more_margin_start"
            android:layout_marginEnd="@dimen/dimen_margin_18dp"/>
    </LinearLayout>
    <com.xiaomi.fitness.health.vitality.VitalityProgressView
        android:id="@+id/vitalityProgress"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size_12"
        android:layout_marginHorizontal="@dimen/health_detail_page_common_margin_horizontal"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_distribute"
        android:background="@drawable/shape_data_item_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/health_detail_page_common_margin_vertical"
        android:overScrollMode="never"
        android:layout_marginHorizontal="@dimen/health_detail_page_common_margin_horizontal"/>
    <com.xiaomi.fitness.common.devicelist.SportsDeviceListView
        android:id="@+id/deviceListView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-12dp"
        android:layout_marginBottom="@dimen/size_12"
        android:layout_marginHorizontal="@dimen/health_detail_page_common_margin_horizontal"/>
    <com.xiaomi.fitness.view.CardUnderstandView
        android:id="@+id/understandCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size_12"
        android:layout_marginHorizontal="@dimen/health_detail_page_common_margin_horizontal"
        app:txtUnderstand="@string/health_vitality_understand"/>
</LinearLayout>
