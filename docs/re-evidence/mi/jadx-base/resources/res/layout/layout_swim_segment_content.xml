<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/dimen_margin_14dp"
    android:paddingEnd="@dimen/dimen_margin_14dp">
    <TextView
        android:textSize="@dimen/dimen_12sp"
        android:textStyle="bold"
        android:textColor="@color/text_color"
        android:id="@+id/txt_segment_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_10dp"
        android:layout_marginBottom="@dimen/dimen_margin_7dp"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.xiaomi.fitness.detail.view.SportPaceSegmentView
            android:id="@+id/paceSegmentView"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_margin_16dp"
            app:segmentCommonColor="@color/trail_sport_pace_segment"
            app:segmentFastColor="@color/trail_sport_pace_segment_fast"/>
    </RelativeLayout>
</LinearLayout>
