<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:background="@android:color/holo_blue_light"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="12sp"
        android:textColor="@color/footer_desc"
        android:gravity="center"
        android:id="@+id/mStateView"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:text="@string/common_no_more"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/leftLine"
        android:background="@color/footer_desc"
        android:layout_width="11dp"
        android:layout_height="0.67dp"
        android:layout_marginEnd="6.67dp"
        app:layout_constraintBottom_toBottomOf="@+id/mStateView"
        app:layout_constraintEnd_toStartOf="@+id/mStateView"
        app:layout_constraintTop_toTopOf="@+id/mStateView"/>
    <View
        android:id="@+id/rightLine"
        android:background="@color/footer_desc"
        android:layout_width="11dp"
        android:layout_height="0.67dp"
        android:layout_marginStart="6.67dp"
        app:layout_constraintBottom_toBottomOf="@+id/mStateView"
        app:layout_constraintStart_toEndOf="@+id/mStateView"
        app:layout_constraintTop_toTopOf="@+id/mStateView"/>
</merge>
