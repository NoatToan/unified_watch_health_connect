<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/mine_function_active_play_0"
    android:background="@drawable/mine_label_bg_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/page_extra_padding_horizontal_large">
    <ImageView
        android:id="@+id/function_icon"
        android:background="@drawable/mine_active_pk_icon"
        android:layout_width="30dp"
        android:layout_height="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:theme="@style/FontDemiBold.16sp"
        android:textColor="@color/text_color"
        android:id="@+id/function_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/mine_pk_my_pk"
        android:layout_marginStart="@dimen/dimen_margin_16dp"
        app:layout_constraintBottom_toTopOf="@+id/function_des"
        app:layout_constraintStart_toEndOf="@+id/function_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:theme="@style/FontDemiBold.12sp"
        android:textColor="@color/text_color_40"
        android:ellipsize="end"
        android:id="@+id/function_des"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_4dp"
        android:maxLines="2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/function_jump_icon"
        app:layout_constraintStart_toStartOf="@+id/function_name"
        app:layout_constraintTop_toBottomOf="@+id/function_name"/>
    <Button
        android:id="@+id/function_jump_icon"
        android:layout_width="wrap_content"
        android:layout_height="35dp"
        android:layout_marginBottom="0dp"
        android:minWidth="90dp"
        android:text="@string/mine_active_pk_jump_remind_text"
        android:layout_marginEnd="@dimen/dimen_margin_0dp"
        android:paddingHorizontal="@dimen/dimen_margin_8dp"
        app:layout_constraintBottom_toBottomOf="@+id/function_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/function_icon"
        style="@style/CommonBtn.Normal"/>
</androidx.constraintlayout.widget.ConstraintLayout>
