<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="start"
    android:layout_gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/detail_item_layout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/dimen_margin_18dp"
    android:minWidth="150dp"
    android:layout_marginStart="@dimen/dimen_margin_10dp">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/item_click"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <CheckBox
                android:layout_gravity="start"
                android:id="@+id/detail_choice_image"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:button="@drawable/sport_record_title_check"/>
            <ImageView
                android:layout_gravity="center"
                android:background="@drawable/sport_record_title_selected"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </FrameLayout>
        <TextView
            android:textSize="@dimen/text_size_14"
            android:textColor="@color/text_color"
            android:layout_gravity="center"
            android:id="@+id/detail_choice_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_marginStart="@dimen/dimen_margin_3dp"/>
    </LinearLayout>
</LinearLayout>
