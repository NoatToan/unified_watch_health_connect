<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutView"
    android:tag="layout/nfc_fragment_return_szt_code_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/page_content_padding_horizontal_large"
    android:paddingEnd="@dimen/page_content_padding_horizontal_large">
    <TextView
        android:textStyle="bold"
        android:textColor="@color/text_color"
        android:id="@+id/codeTitleView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="@string/nfc_retrun_card_token"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/text_color_80"
        android:id="@+id/codeView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/codeTitleView"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/text_color_80"
        android:id="@+id/copyView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/nfc_card_detail_copy_id"
        app:layout_constraintBottom_toBottomOf="@+id/codeTitleView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/codeTitleView"/>
    <TextView
        android:textStyle="bold"
        android:textColor="@color/text_color"
        android:id="@+id/flowTitleView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/nfc_retrun_card_flow_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/codeView"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/text_color_80"
        android:id="@+id/flowView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/nfc_retrun_card_flow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/flowTitleView"/>
</androidx.constraintlayout.widget.ConstraintLayout>
