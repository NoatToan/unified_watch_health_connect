<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rl_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/size_63_3">
    <ImageView
        android:id="@+id/img_back_white"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_10"
        android:src="@drawable/ic_left_back_black"
        android:scaleType="center"
        android:contentDescription="@string/back"
        android:layout_marginStart="@dimen/dimen_margin_18dp"
        android:layout_alignParentStart="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_marginHorizontal="@dimen/size_48">
        <TextView
            android:textColor="@color/text_color"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/txt_title_alpha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            style="@style/FontMedium.19sp"/>
        <TextView
            android:textColor="@color/text_color"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/txt_desc_alpha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="@dimen/size_3_6"
            android:drawableEnd="@drawable/ic_health_arrow_down"
            style="@style/FontRegular.14sp"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/shareView"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/icon_share_enabled"
        android:scaleType="center"
        android:layout_centerVertical="true"
        android:contentDescription="@string/share_trail"
        android:layout_marginEnd="@dimen/dimen_margin_10dp"
        android:layout_toStartOf="@+id/img_share_alpha"/>
    <ImageView
        android:id="@+id/img_share_alpha"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/icon_more"
        android:scaleType="center"
        android:layout_centerVertical="true"
        android:contentDescription="@string/health_more_settings"
        android:layout_marginEnd="@dimen/dimen_margin_10dp"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
