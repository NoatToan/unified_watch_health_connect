<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/medal_activity_share_0"
    android:background="@color/black"
    android:paddingTop="32dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/medal_share_goback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_medal_back"
        android:contentDescription="@string/back"
        android:layout_marginStart="@dimen/dimen_margin_18dp"
        android:layout_marginVertical="@dimen/dimen_margin_10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/white"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/medal_share"
        app:layout_constraintBottom_toBottomOf="@+id/medal_share_goback"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/medal_share_goback"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/share_content_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dimen_margin_18dp"
        android:layout_marginHorizontal="@dimen/page_content_padding_horizontal_large"
        app:layout_constraintBottom_toTopOf="@+id/bottom_share_widget"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/medal_share_goback">
        <com.xiaomi.fitness.medal.widget.MedalShareContentCardView
            android:id="@+id/share_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="@dimen/dimen_margin_20dp"/>
    </androidx.core.widget.NestedScrollView>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/swipe_up_view"
        android:background="@drawable/medal_share_swipe_up_instruction_gradient_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="92dp"
        app:layout_constraintBottom_toTopOf="@+id/bottom_share_widget"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:id="@+id/up_arrow"
            android:background="@drawable/medal_ic_arrow_up"
            android:layout_width="@dimen/dimen_margin_14dp"
            android:layout_height="@dimen/dimen_margin_14dp"
            android:layout_marginTop="43.3dp"
            android:contentDescription="@string/medal_share_swipe_up_to_see_whole_pic_instruction"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textColor="#808080"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/medal_share_swipe_up_to_see_whole_pic_instruction"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/up_arrow"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/bottom_share_widget"
        android:background="@drawable/medal_share_gray_bottom_bg"
        android:layout_width="match_parent"
        android:layout_height="129.3dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:paddingBottom="@dimen/dimen_margin_5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26.67dp"
            android:layout_marginBottom="@dimen/dimen_margin_30dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <RelativeLayout
                android:orientation="vertical"
                android:id="@+id/rlDownload"
                android:layout_width="45dp"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/img_download"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:src="@drawable/share_download"
                    android:layout_alignParentTop="true"
                    android:layout_centerHorizontal="true"
                    android:contentDescription="@string/share_download"/>
                <TextView
                    android:textSize="@dimen/dimen_10sp"
                    android:textColor="@color/white_60"
                    android:gravity="center"
                    android:id="@+id/txt_download"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_margin_5dp"
                    android:text="@string/share_download"
                    android:layout_below="@+id/img_download"
                    android:layout_centerHorizontal="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:orientation="vertical"
                android:id="@+id/rlShareWxSession"
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dimen_margin_30dp">
                <ImageView
                    android:id="@+id/img_share_wx_session"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:src="@drawable/share_wx_session"
                    android:layout_alignParentTop="true"
                    android:layout_centerHorizontal="true"/>
                <TextView
                    android:textSize="@dimen/dimen_10sp"
                    android:textColor="@color/white_60"
                    android:gravity="center"
                    android:id="@+id/txt_share_wx_session"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_margin_5dp"
                    android:text="@string/share_wx_session"
                    android:layout_below="@+id/img_share_wx_session"
                    android:layout_centerHorizontal="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:orientation="vertical"
                android:id="@+id/rlShareTimeline"
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dimen_margin_30dp">
                <ImageView
                    android:id="@+id/img_share_wx_timeline"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:src="@drawable/share_wx_timeline"
                    android:layout_alignParentTop="true"
                    android:layout_centerHorizontal="true"/>
                <TextView
                    android:textSize="@dimen/dimen_10sp"
                    android:textColor="@color/white_60"
                    android:gravity="center"
                    android:id="@+id/txt_share_wx_timeline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_margin_5dp"
                    android:text="@string/share_wx_timeline"
                    android:layout_below="@+id/img_share_wx_timeline"
                    android:layout_centerHorizontal="true"/>
            </RelativeLayout>
        </LinearLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
