<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/temperature_container"
    android:tag="layout/fragment_temperature_week_item_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:id="@+id/space"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/size_30"/>
            <com.xiaomi.fitness.chart.view.BarChartRecyclerView
                android:id="@+id/recycler"
                app:barChartMaxWidth="@dimen/size_10"
                app:barChartRoundRectRadiusRatio="0.5"
                app:barChartSegment="1"
                app:barSpace="0.75"
                app:chartColor="@color/health_temperature_body_color"
                app:displayNumbers="7"
                app:enableEndDayXAxis="true"
                app:enableStartYAxisLabel="false"
                app:highLightBigTextSize="@dimen/size_15"
                app:highLightSmallTextSize="@dimen/size_12"
                app:rateChartDarkColor="@color/health_temperature_body_color"
                app:rateChartLightColor="@color/health_temperature_skin_color"
                style="@style/ChartBaseStyle"/>
        </LinearLayout>
        <com.xiaomi.fitness.health.temperature.ui.TemperatureDataTitleView
            android:id="@+id/dataTitleView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/temp_trend_layout"
        android:background="@drawable/shape_data_item_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size_12"
        android:layout_marginHorizontal="@dimen/health_detail_page_common_margin_horizontal">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_20dp"
                android:layout_marginStart="@dimen/dimen_margin_18dp">
                <ImageView
                    android:layout_width="@dimen/dimen_margin_30dp"
                    android:layout_height="@dimen/dimen_margin_30dp"
                    android:src="@drawable/sport_data_temperature_detail"/>
                <TextView
                    android:textSize="@dimen/dimen_16sp"
                    android:textColor="@color/text_color"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:text="@string/health_temperature_skin_temp_title"
                    android:fontFamily="@font/misanslatin_bold"/>
            </LinearLayout>
            <FrameLayout
                android:id="@+id/temp_trend_chart_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_20dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/temp_trend_title_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dimen_margin_18dp"
                    android:layout_marginEnd="@dimen/dimen_margin_18dp">
                    <LinearLayout
                        android:gravity="bottom"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="@dimen/dimen_18sp"
                            android:textColor="@color/text_color"
                            android:id="@+id/temp_trend_symbol"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                        <TextView
                            android:textSize="@dimen/dimen_24sp"
                            android:textColor="@color/text_color"
                            android:id="@+id/temp_trend_diff"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/misanslatin_bold"/>
                        <TextView
                            android:textSize="@dimen/dimen_14sp"
                            android:textColor="@color/text_color"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/health_temperature_diff_label"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="@dimen/dimen_14sp"
                        android:id="@+id/temp_trend_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        app:layout_constraintTop_toBottomOf="@+id/curse_temp_layout"/>
                </LinearLayout>
                <com.xiaomi.fitness.chart.view.LineChartRecyclerView
                    android:id="@+id/temp_trend_recycler"
                    android:paddingTop="80dp"
                    app:barSpace="0.6"
                    app:displayNumbers="7"
                    app:enableEndYAxisLabel="true"
                    app:enableScrollToScale="true"
                    app:enableStartYAxisLabel="false"
                    app:enableXAxisLineCircle="true"
                    app:lineColor="@color/health_temperature_body_color"
                    app:lineHighLightType="4"
                    app:linePointRadius="@dimen/size_2"
                    app:linePointSelectCircleStroke="true"
                    app:linePointSelectRadius="@dimen/size_2"
                    app:linePointSelectStrokeWidth="@dimen/size_2"
                    app:lineSelectCircles="1"
                    app:lineShaderBeginColor="@color/transparent"
                    app:lineShaderEndColor="@color/transparent"
                    app:lineStrokeWidth="6"
                    style="@style/ChartBaseStyle"/>
            </FrameLayout>
            <com.xiaomi.fitness.view.TemperatureTrendEmptyView
                android:id="@+id/temp_trend_empty_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@+id/curse_temp_title"/>
        </LinearLayout>
    </FrameLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_detail"
        android:background="@drawable/shape_data_item_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size_12"
        android:overScrollMode="never"
        android:layout_marginHorizontal="@dimen/health_detail_page_common_margin_horizontal"/>
    <com.xiaomi.fitness.view.CardUnderstandView
        android:id="@+id/understandCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size_12"
        android:layout_marginHorizontal="@dimen/health_detail_page_common_margin_horizontal"
        app:txtUnderstand="@string/health_temperature_understand"/>
</LinearLayout>
