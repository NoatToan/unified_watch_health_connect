<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/training_card_shape"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="17sp"
        android:textColor="@color/text_color"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/misanslatin_regular"
        android:layout_marginStart="14dp"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/text_color_40"
        android:id="@+id/desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_4dp"
        android:fontFamily="@font/misanslatin_regular"
        android:layout_marginStart="14dp"/>
    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/flex"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_16dp"
        android:layout_marginBottom="@dimen/dimen_margin_17dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        app:flexWrap="wrap"/>
</LinearLayout>
