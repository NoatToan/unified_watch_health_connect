<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/common_card_bg_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="@dimen/dimen_margin_6dp"
    android:paddingVertical="@dimen/margin_20dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="horizontal"
        android:id="@+id/card_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/image_view"
            android:background="@drawable/health_data_blood_pressure_square"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="17sp"
            android:textColor="@color/text_color"
            android:layout_gravity="center_vertical"
            android:id="@+id/title_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/health_check_blood_pressure_health"
            android:layout_marginStart="@dimen/dimen_margin_6dp"
            app:layout_constraintBottom_toBottomOf="@+id/image_view"
            app:layout_constraintStart_toEndOf="@+id/image_view"
            app:layout_constraintTop_toTopOf="@+id/image_view"
            style="@style/FontMedium"/>
        <TextView
            android:textSize="22sp"
            android:textColor="@color/text_color"
            android:id="@+id/bloodPressureTypeTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/health_data_empty"
            android:textFontWeight="550"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title_view"/>
        <TextView
            android:textSize="10sp"
            android:textColor="#ff5050"
            android:id="@+id/abnormalMarkingTextView"
            android:background="@drawable/health_check_bg_abnormal_mark"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/health_abnormal"
            android:layout_marginStart="4dp"
            android:paddingHorizontal="4dp"
            android:paddingVertical="2dp"
            android:textFontWeight="500"
            app:layout_constraintBottom_toBottomOf="@+id/bloodPressureTypeTextView"
            app:layout_constraintStart_toEndOf="@+id/bloodPressureTypeTextView"
            app:layout_constraintTop_toTopOf="@+id/bloodPressureTypeTextView"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/text_color_30"
            android:id="@+id/bloodPressureHealthDateTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textFontWeight="400"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/bloodPressureTypeTextView"/>
        <ImageView
            android:id="@+id/bloodPressureHealthImageView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/blood_pressure_health_no_data_image"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintStart_toEndOf="@+id/bloodPressureHealthDateTextView"
            app:layout_constraintTop_toTopOf="@+id/bloodPressureTypeTextView"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
