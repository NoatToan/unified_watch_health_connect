<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rlImgShareLong"
    android:tag="layout/layout_sport_share_long_view_0"
    android:background="@color/page_bg"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollShare"
        android:paddingTop="45dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <ImageView
            android:id="@+id/imgShareLong"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="80dp"
            android:layout_marginRight="80dp"
            android:layout_marginBottom="160dp"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:layout_centerInParent="true"
            android:contentDescription="@string/back"/>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/slide_up_widget"
        android:background="@drawable/share_path_pic_bottom_bg_gradient"
        android:paddingTop="@dimen/dimen_margin_10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <TextView
            android:textSize="@dimen/dimen_11sp"
            android:textColor="@color/text_color_40"
            android:gravity="center"
            android:id="@+id/txtScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/trail_sport_scroll_top_desc"
            android:drawableTop="@drawable/top_arrow"/>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_5dp"
            android:layout_marginStart="80dp"
            android:layout_marginEnd="80dp">
            <RelativeLayout
                android:orientation="vertical"
                android:id="@+id/rlDownload"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/img_download"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:src="@drawable/share_download"
                    android:layout_alignParentTop="true"
                    android:layout_centerHorizontal="true"/>
                <TextView
                    android:textSize="@dimen/dimen_10sp"
                    android:gravity="center"
                    android:id="@+id/txt_download"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_margin_5dp"
                    android:text="@string/trail_update_download"
                    android:layout_below="@+id/img_download"
                    android:layout_centerHorizontal="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:orientation="vertical"
                android:id="@+id/rlShareWxSession"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/img_share_wx_session"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:src="@drawable/share_wx_session"
                    android:layout_alignParentTop="true"
                    android:layout_centerHorizontal="true"/>
                <TextView
                    android:textSize="@dimen/dimen_10sp"
                    android:gravity="center"
                    android:id="@+id/txt_share_wx_session"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_margin_5dp"
                    android:text="@string/trail_share_wx_session"
                    android:layout_below="@+id/img_share_wx_session"
                    android:layout_centerHorizontal="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:orientation="vertical"
                android:id="@+id/rlShareTimeline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/img_share_wx_timeline"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:src="@drawable/share_wx_timeline"
                    android:layout_alignParentTop="true"
                    android:layout_centerHorizontal="true"/>
                <TextView
                    android:textSize="@dimen/dimen_10sp"
                    android:gravity="center"
                    android:id="@+id/txt_share_wx_timeline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_margin_5dp"
                    android:text="@string/trail_share_wx_timeline"
                    android:layout_below="@+id/img_share_wx_timeline"
                    android:layout_centerHorizontal="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:orientation="vertical"
                android:id="@+id/rl_more"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/img_share_more"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:src="@drawable/ic_share_more"
                    android:layout_alignParentTop="true"
                    android:layout_centerHorizontal="true"/>
                <TextView
                    android:textSize="@dimen/dimen_10sp"
                    android:gravity="center"
                    android:id="@+id/tv_more"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_margin_5dp"
                    android:text="@string/more"
                    android:layout_below="@+id/img_share_more"
                    android:layout_centerHorizontal="true"/>
            </RelativeLayout>
        </LinearLayout>
        <View
            android:background="@color/black_06_transparent"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_marginTop="@dimen/dimen_margin_10dp"
            android:layout_marginBottom="@dimen/dimen_margin_10dp"
            android:layout_marginStart="@dimen/dimen_margin_15dp"
            android:layout_marginEnd="@dimen/dimen_margin_15dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/shareContainer"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="100dp"
            android:layout_marginEnd="100dp">
            <RelativeLayout
                android:id="@+id/rlSharePic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/img_share_pic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/share_pic"
                    android:layout_alignParentTop="true"
                    android:layout_centerHorizontal="true"/>
                <TextView
                    android:textSize="@dimen/dimen_12sp"
                    android:gravity="center"
                    android:id="@+id/txt_share_pic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_margin_5dp"
                    android:text="@string/trail_share_pic_square"
                    android:layout_below="@+id/img_share_pic"
                    android:layout_centerHorizontal="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rlShareVideo"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/img_share_video"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/share_video"
                    android:layout_alignParentTop="true"
                    android:layout_centerHorizontal="true"/>
                <TextView
                    android:textSize="@dimen/dimen_12sp"
                    android:gravity="center"
                    android:id="@+id/txt_share_video"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_margin_5dp"
                    android:text="@string/trail_share_video"
                    android:layout_below="@+id/img_share_video"
                    android:layout_centerHorizontal="true"/>
            </RelativeLayout>
        </LinearLayout>
    </LinearLayout>
    <ImageView
        android:id="@+id/imgFadeOut"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="@dimen/dimen_margin_40dp"
        android:src="@drawable/img_sport_back"
        android:scaleType="center"
        android:layout_alignParentTop="true"
        android:layout_marginStart="@dimen/dimen_margin_20dp"
        android:layout_alignParentStart="true"/>
</RelativeLayout>
