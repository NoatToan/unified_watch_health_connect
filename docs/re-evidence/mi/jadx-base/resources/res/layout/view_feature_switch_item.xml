<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_feature_item_start_icon"
        android:layout_width="@dimen/feature_item_icon_size"
        android:layout_height="@dimen/feature_item_icon_size"
        android:layout_marginTop="@dimen/feature_item_icon_top_bottom_margin"
        android:layout_marginBottom="@dimen/feature_item_icon_top_bottom_margin"
        android:scaleType="centerCrop"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/feature_item_title_top_bottom_margin"
        android:layout_marginBottom="13.33dp"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/feature_item_title_start_margin">
        <TextView
            android:textSize="@dimen/feature_item_title_text_size"
            android:textColor="@color/feature_item_title_text_color"
            android:id="@+id/tv_feature_item_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:singleLine="true"/>
        <TextView
            android:textSize="@dimen/feature_item_subtitle_text_size"
            android:textColor="@color/feature_item_subtitle_text_color"
            android:id="@+id/tv_feature_item_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"/>
    </LinearLayout>
    <com.xiaomi.fitness.widget.button.SwitchButton
        android:id="@+id/switch_btn"
        android:layout_width="@dimen/lib_sb_width"
        android:layout_height="@dimen/lib_sb_height"
        android:layout_marginStart="@dimen/feature_item_more_margin_start"/>
</merge>
