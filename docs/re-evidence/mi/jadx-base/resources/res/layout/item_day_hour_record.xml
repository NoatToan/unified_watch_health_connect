<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/font_11_3"
        android:textColor="@color/text_color_40"
        android:gravity="center"
        android:id="@+id/tv_time"
        android:background="@drawable/shape_time_bg"
        android:paddingTop="@dimen/size_3"
        android:paddingBottom="@dimen/size_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_32_5"
        android:layout_marginBottom="@dimen/size_32_5"
        android:minWidth="@dimen/size_46"
        android:layout_marginStart="@dimen/size_18"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/FontMedium"/>
    <View
        android:id="@+id/top_line"
        android:background="@color/common_divider_bg_color"
        android:layout_width="@dimen/size_0_67"
        android:layout_height="@dimen/size_32_5"
        app:layout_constraintBottom_toTopOf="@+id/tv_time"
        app:layout_constraintEnd_toEndOf="@+id/tv_time"
        app:layout_constraintStart_toStartOf="@+id/tv_time"/>
    <View
        android:id="@+id/bottom_line"
        android:background="@color/common_divider_bg_color"
        android:layout_width="@dimen/size_0_67"
        android:layout_height="@dimen/size_32_5"
        app:layout_constraintEnd_toEndOf="@+id/tv_time"
        app:layout_constraintStart_toStartOf="@+id/tv_time"
        app:layout_constraintTop_toBottomOf="@+id/tv_time"/>
    <View
        android:id="@+id/view_divider"
        android:background="@color/common_divider_bg_color"
        android:layout_width="@dimen/size_0_33"
        android:layout_height="@dimen/size_37_33"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/guide_line"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.75"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guide_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.6"/>
    <TextView
        android:textSize="@dimen/font_22"
        android:textColor="@color/text_color"
        android:id="@+id/tv_high_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_20"
        app:layout_constraintBottom_toTopOf="@+id/high_flex"
        app:layout_constraintStart_toEndOf="@+id/tv_time"
        app:layout_constraintTop_toTopOf="@+id/tv_time"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/FontLatinMedium"/>
    <TextView
        android:textSize="@dimen/size_10"
        android:ellipsize="end"
        android:id="@+id/tv_high_unit"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/health_blood_pressure_unit_short"
        android:maxLines="1"
        android:layout_marginStart="@dimen/size_2"
        app:layout_constraintBaseline_toBaselineOf="@+id/tv_high_value"
        app:layout_constraintEnd_toEndOf="@+id/guide_line"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/tv_high_value"
        style="@style/CardTextAppearance.ItemUnit"/>
    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/high_flex"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:flexWrap="wrap"
        app:layout_constraintBottom_toBottomOf="@+id/tv_time"
        app:layout_constraintEnd_toEndOf="@+id/guide_line"
        app:layout_constraintStart_toStartOf="@+id/tv_high_value"
        app:layout_constraintTop_toBottomOf="@+id/tv_high_value">
        <TextView
            android:ellipsize="end"
            android:id="@+id/tv_high_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/health_blood_pressure_high_pressure"
            android:maxLines="2"
            android:paddingEnd="@dimen/size_2"
            style="@style/CardTextAppearance.ItemStatus"/>
        <TextView
            android:textSize="@dimen/font_9"
            android:textColor="#f22424"
            android:id="@+id/tv_high_result"
            android:background="@drawable/shape_evaluation_bg"
            android:paddingTop="@dimen/size_1"
            android:paddingBottom="@dimen/size_1"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/size_3"
            android:paddingEnd="@dimen/size_3"/>
    </com.google.android.flexbox.FlexboxLayout>
    <TextView
        android:textSize="@dimen/font_22"
        android:textColor="@color/text_color"
        android:id="@+id/tv_low_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_18"
        app:layout_constraintBottom_toTopOf="@+id/low_flex"
        app:layout_constraintStart_toStartOf="@+id/guide_line"
        app:layout_constraintTop_toTopOf="@+id/tv_time"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/FontLatinMedium"/>
    <TextView
        android:textSize="@dimen/size_10"
        android:ellipsize="end"
        android:id="@+id/tv_low_unit"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/health_blood_pressure_unit_short"
        android:maxLines="1"
        android:layout_marginStart="@dimen/size_2"
        app:layout_constraintBaseline_toBaselineOf="@+id/tv_low_value"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/tv_low_value"
        style="@style/CardTextAppearance.ItemUnit"/>
    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/low_flex"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:flexWrap="wrap"
        app:layout_constraintBottom_toBottomOf="@+id/tv_time"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tv_low_value"
        app:layout_constraintTop_toBottomOf="@+id/tv_low_value">
        <TextView
            android:ellipsize="end"
            android:id="@+id/tv_low_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/health_blood_pressure_low_pressure"
            android:maxLines="2"
            android:paddingEnd="@dimen/size_2"
            style="@style/CardTextAppearance.ItemStatus"/>
        <TextView
            android:textSize="@dimen/font_9"
            android:textColor="#f22424"
            android:id="@+id/tv_low_result"
            android:background="@drawable/shape_evaluation_bg"
            android:paddingTop="@dimen/size_1"
            android:paddingBottom="@dimen/size_1"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/size_3"
            android:paddingEnd="@dimen/size_3"/>
    </com.google.android.flexbox.FlexboxLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
