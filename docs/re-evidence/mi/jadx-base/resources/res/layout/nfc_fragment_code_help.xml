<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:tag="layout/nfc_fragment_code_help_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/common_title_left_margin"
    android:paddingEnd="@dimen/common_title_left_margin">
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/text_color"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="45dp"
        android:text="@string/nfc_valid_code_no_get"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/black_60_transparent"
        android:autoLink="phone"
        android:id="@+id/helpView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/nfc_valid_code_no_get_content"/>
</LinearLayout>
