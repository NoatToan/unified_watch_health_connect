<?xml version="1.0" encoding="utf-8"?>
<com.xiaomi.fitness.watch.face.widget.StateLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/state_view"
    android:tag="layout/fragment_tab_list_0"
    android:background="@color/face_market_page_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <EditText
            android:textColor="@color/text_color"
            android:id="@+id/edit_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toStartOf="@+id/search_view"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintHorizontal_weight="3"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:id="@+id/search_view"
            android:layout_width="0dp"
            android:text="@string/face_white_list_search"
            android:layout_marginVertical="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/edit_view"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@+id/edit_view"
            app:layout_constraintTop_toTopOf="@+id/edit_view"
            style="@style/CommonBtn.Normal"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/search_group"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="search_view,edit_view"/>
        <com.xiaomi.fitness.baseui.recyclerview.MoreRecyclerView
            android:id="@+id/tab_list_rv"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/dimen_margin_13dp"
            android:layout_marginHorizontal="@dimen/page_padding_horizontal_large"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/edit_view"
            app:layout_constraintVertical_weight="1"
            app:loadMoreThreshold="0"/>
        <com.xiaomi.fitness.watch.face.view.FaceWaterMarkView
            android:id="@+id/water_mark"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.xiaomi.fitness.watch.face.widget.StateLayout>
