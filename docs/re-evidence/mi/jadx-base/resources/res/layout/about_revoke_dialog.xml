<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/size_16_7"
        android:textColor="@color/about_black"
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/about_privacy_revoke_account_des"
        android:layout_marginStart="@dimen/dimen_margin_26dp"
        android:layout_marginEnd="@dimen/dimen_margin_26dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/FontMedium"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_20dp"
        android:layout_marginStart="@dimen/dimen_margin_40dp"
        android:layout_marginEnd="@dimen/dimen_margin_40dp"
        app:layout_constraintHeight_max="300dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/text_size_16"
                android:textColor="@color/about_black_80"
                android:id="@+id/text_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/about_privacy_revoke_account_tips"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/button"
        android:paddingTop="@dimen/dimen_margin_20dp"
        android:paddingBottom="@dimen/dimen_margin_20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/scrollView"
        app:layout_constraintVertical_bias="1">
        <TextView
            android:textSize="@dimen/text_size_16"
            android:textColor="@color/about_black"
            android:id="@+id/cancel_revoke_button"
            android:layout_width="0dp"
            android:layout_height="@dimen/common_btn_height"
            android:text="@string/about_cancle"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/dimen_margin_26dp"
            style="@style/AboutButton.FullWidth.Menstrual.Gray"/>
        <TextView
            android:textSize="@dimen/text_size_16"
            android:textColor="@color/about_black"
            android:id="@+id/confirm_revoke_button"
            android:layout_width="0dp"
            android:layout_height="@dimen/common_btn_height"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/dimen_margin_1dp"
            android:layout_marginEnd="@dimen/dimen_margin_26dp"
            style="@style/AboutButton.FullWidth.Menstrual.Orange"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
