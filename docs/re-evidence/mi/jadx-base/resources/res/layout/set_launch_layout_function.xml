<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/setRootView"
    android:tag="layout/set_launch_layout_function_0"
    android:background="@drawable/shape_white_gray"
    android:padding="@dimen/launch_sport_edge"
    android:visibility="visible"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="8dp"
    android:layout_marginTop="8dp"
    android:layout_marginRight="8dp"
    android:layoutDirection="locale">
    <com.xiaomi.fitness.widget.view.RatioImageView
        android:id="@+id/setImgView"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:src="@mipmap/ic_launcher_small"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/setTitleView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearance="@style/CourseShapeImage"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/course_black"
        android:ellipsize="end"
        android:id="@+id/setTitleView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/sport_ftp_test"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toTopOf="@+id/setDataView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/setImgView"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/course_desc"
        android:ellipsize="end"
        android:id="@+id/setDataView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="@string/sport_ftp_test_des"
        android:maxLines="1"
        android:layout_marginEnd="25dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/setTitleView"
        app:layout_constraintStart_toStartOf="@+id/setTitleView"
        app:layout_constraintTop_toBottomOf="@+id/setTitleView"/>
    <ImageView
        android:id="@+id/arrow"
        android:background="@drawable/ic_base_right_arrow_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginEnd="5dp"
        android:layout_alignParentEnd="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/setTitleView"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
