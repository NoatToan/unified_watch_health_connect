<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:circleProgress="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="bottom"
        android:id="@+id/xq_progress_dialog_linearlayout"
        android:background="@drawable/common_popup_bottom_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/progress_height">
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/progress_margin">
            <ProgressBar
                android:layout_gravity="center_vertical"
                android:id="@+id/xq_progress_dialog_indeterminate"
                style="@style/ProgressDialogIndeterminateProgressbar"/>
            <com.xiaomi.fitness.baseui.widget.CustomCircleProgressBar
                android:layout_gravity="center_vertical"
                android:id="@+id/xq_progress_dialog_determinate"
                android:background="@drawable/dialog_loading"
                android:layout_width="20dp"
                android:layout_height="20dp"
                circleProgress:inside_indent="0"
                circleProgress:paint_color="@color/white"
                circleProgress:paint_width="3"/>
        </FrameLayout>
        <TextView
            android:textSize="@dimen/dimen_16sp"
            android:textColor="@color/black"
            android:layout_gravity="center_vertical"
            android:id="@+id/xq_progress_dialog_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"/>
        <TextView
            android:textSize="@dimen/dimen_16sp"
            android:textColor="@color/black"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/xq_progress_dialog_percent"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/dimen_margin_15dp"/>
        <TextView
            android:textSize="7sp"
            android:textColor="@color/black_60"
            android:gravity="center"
            android:layout_gravity="end|center_vertical"
            android:id="@+id/xq_progress_dialog_cancel_btn"
            android:background="@drawable/dialog_progress_cancel_btn"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancel"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginEnd="@dimen/dimen_margin_15dp"/>
    </LinearLayout>
</FrameLayout>
