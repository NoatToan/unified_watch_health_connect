<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_open_vip_dialog"
    android:tag="layout/course_open_course_vip_dialog_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="21sp"
        android:textStyle="bold"
        android:textColor="@color/text_color"
        android:id="@+id/tv_open_vip_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="@string/course_vip_open_title"
        android:textAlignment="viewStart"
        android:layout_marginStart="26dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/text_color_30"
        android:id="@+id/tv_open_vip_title_sub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:text="@string/course_vip_open_title_sub"
        app:layout_constraintStart_toStartOf="@+id/tv_open_vip_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_open_vip_title"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcv_open_vip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_open_vip_title_sub"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/text_color_40"
        android:id="@+id/tv_open_vip_agreement_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/course_vip_rights_title_less"
        android:layout_marginHorizontal="27dp"
        app:layout_constraintTop_toBottomOf="@+id/rcv_open_vip"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/text_color_40"
        android:ellipsize="end"
        android:id="@+id/tv_open_vip_agreement"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:text="@string/course_vip_rights_info"
        android:maxLines="15"
        android:lineSpacingExtra="@dimen/dimen_margin_4dp"
        android:layout_marginHorizontal="27dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_open_vip_agreement_title"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_open_vip"
        android:background="@drawable/course_open_vip_bg"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="18dp"
        android:text="@string/course_vip_open"
        android:layout_marginHorizontal="27dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_open_vip_agreement"/>
    <TextView
        android:textSize="11sp"
        android:textColor="@color/text_color_50"
        android:id="@+id/tv_vip_agreement"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="18dp"
        android:text="@string/course_vip_agreement_pay"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_open_vip"/>
    <FrameLayout
        android:id="@+id/fl_status"
        android:tag="binding_1"
        android:background="@color/app_4_0_bg_color"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <include
            android:id="@+id/state_view"
            android:visibility="visible"
            layout="@layout/view_text_icon"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
