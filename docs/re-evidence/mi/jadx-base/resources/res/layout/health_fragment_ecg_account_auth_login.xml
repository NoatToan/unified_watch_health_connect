<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/health_fragment_ecg_account_auth_login_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginHorizontal="26.67dp">
    <com.xiaomi.fitness.widget.view.RoundImageView
        android:id="@+id/iv_icon"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="30dp"
        android:src="@drawable/health_ic_hlw"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/text_color"
        android:gravity="center"
        android:id="@+id/tv_label"
        android:paddingBottom="@dimen/size_20"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_10"
        android:text="@string/health_n60_ecg_use_mi_account_login_analyze_platform"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_icon"
        style="@style/FontMedium.16sp"/>
    <View
        android:id="@+id/divider_line_top"
        android:background="@color/common_divider_bg_color"
        android:layout_width="0dp"
        android:layout_height="@dimen/size_0_33"
        android:layout_marginTop="@dimen/size_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_label"/>
    <com.xiaomi.fitness.widget.view.RoundImageView
        android:id="@+id/iv_user_avatar"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_marginTop="40dp"
        app:innerStrokeWidth="@dimen/dimen_margin_1dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider_line_top"
        app:srcCompat="@drawable/header_default_icon"/>
    <TextView
        android:textColor="@color/text_color"
        android:id="@+id/tv_nick_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_user_avatar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_user_avatar"
        app:layout_constraintTop_toTopOf="@+id/iv_user_avatar"
        style="@style/FontMedium.16sp"/>
    <TextView
        android:textSize="@dimen/font_12"
        android:textColor="@color/text_color_40"
        android:id="@+id/tv_permission_label"
        android:paddingBottom="@dimen/size_8"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="@string/health_n60_ecg_after_auth_success_obtain_permission"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_user_avatar"/>
    <TextView
        android:textSize="14.67sp"
        android:textColor="@color/text_color"
        android:gravity="start|center_vertical"
        android:id="@+id/tv_permission_user_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/health_n60_ecg_access_information_detail"
        android:drawablePadding="10dp"
        android:drawableStart="@drawable/health_iv_permission_user"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_permission_label"
        style="@style/FontMedium"/>
    <TextView
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_agree"
        android:background="@drawable/selector_bottom_btn_positive_bg"
        android:layout_width="@dimen/common_btn_single_line_width"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="@string/health_n60_ecg_auth_agree"
        android:paddingHorizontal="10dp"
        android:paddingVertical="12.7dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_disagree"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/FontMedium.16sp"/>
    <TextView
        android:textColor="@color/text_color_80"
        android:gravity="center"
        android:id="@+id/tv_disagree"
        android:background="@drawable/selector_bottom_btn_native_bg"
        android:layout_width="@dimen/common_btn_single_line_width"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size_26_7"
        android:text="@string/health_n60_ecg_auth_disagree"
        android:paddingHorizontal="10dp"
        android:paddingVertical="12.7dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/FontMedium.16sp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
