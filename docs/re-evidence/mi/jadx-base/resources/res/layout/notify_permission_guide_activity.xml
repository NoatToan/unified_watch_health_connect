<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/notify_permission_guide_activity_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <miuix.springback.view.SpringBackLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scrollableView="@+id/scrollview">
        <miuix.core.widget.NestedScrollView
            android:id="@+id/scrollview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="@dimen/dimen_18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_color"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_margin_16dp"
                    android:text="@string/notify_guide_function_open"
                    android:layout_marginStart="@dimen/dimen_margin_26dp"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/notify_open_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_27dp"
                    android:layoutDirection="locale"
                    android:layout_marginStart="@dimen/size_26_67">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/dimen_15sp"
                        android:textStyle="bold"
                        android:textColor="@color/switch_black"
                        android:id="@+id/notify_message_remind_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/notify_message_remind_title"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/dimen_13sp"
                        android:textColor="@color/notify_guide_remind_has_open_color"
                        android:id="@+id/notify_message_remind_subtitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/notify_message_remind_subtitle"
                        android:layout_marginEnd="40dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/notify_message_open_view"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/notify_message_remind_title"/>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/notify_message_open_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <miuix.androidbasewidget.widget.CheckedTextView
                            android:id="@+id/notify_message_open_button"
                            android:background="@drawable/selector_common_circle_check"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="false"
                            android:button="@null"
                            android:layout_marginEnd="@dimen/dimen_margin_26dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="@dimen/dimen_13sp"
                            android:id="@+id/notify_message_remind_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="26dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/notify_call_open_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_27dp"
                    android:layoutDirection="locale"
                    android:layout_marginStart="@dimen/size_26_67">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/dimen_15sp"
                        android:textStyle="bold"
                        android:textColor="@color/switch_black"
                        android:id="@+id/call_remind_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/notify_call_remind_title"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/dimen_13sp"
                        android:textColor="@color/notify_guide_remind_has_open_color"
                        android:id="@+id/call_remind_subtitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/notify_call_remind_subtitle"
                        android:layout_marginEnd="40dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/call_open_view"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/call_remind_title"/>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/call_open_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <miuix.androidbasewidget.widget.CheckedTextView
                            android:id="@+id/call_open_button"
                            android:background="@drawable/selector_common_circle_check"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="false"
                            android:button="@null"
                            android:layout_marginEnd="@dimen/dimen_margin_26dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="@dimen/dimen_13sp"
                            android:id="@+id/call_remind_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="26dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/system_function_setting_view"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/dimen_18sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_color"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimen_margin_26dp"
                        android:text="@string/notify_guide_system_set"
                        android:layout_marginStart="@dimen/dimen_margin_26dp"/>
                    <com.xiaomi.fitness.widget.SwitchButtonTwoLineTextView
                        android:id="@+id/sync_all_notification_button"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:subtitle="@string/notify_one_step_all_notification_subtitle"
                        app:title="@string/notify_one_step_all_notification"/>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/sync_wifi_open"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_27dp"
                        android:layoutDirection="locale"
                        android:layout_marginStart="@dimen/size_26_67">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="@dimen/dimen_15sp"
                            android:textStyle="bold"
                            android:textColor="@color/switch_black"
                            android:id="@+id/sync_wifi_open_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/device_settings_sync_wifi_title"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="@dimen/dimen_13sp"
                            android:textColor="@color/notify_guide_remind_has_open_color"
                            android:id="@+id/sync_wifi_open_subtitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/device_settings_sync_wifi_desc"
                            android:layout_marginEnd="40dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/sync_wifi_open_view"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/sync_wifi_open_title"/>
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/sync_wifi_open_view"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent">
                            <miuix.androidbasewidget.widget.CheckedTextView
                                android:id="@+id/sync_wifi_open_button"
                                android:background="@drawable/selector_common_circle_check"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="false"
                                android:button="@null"
                                android:layout_marginEnd="@dimen/dimen_margin_26dp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>
            </LinearLayout>
        </miuix.core.widget.NestedScrollView>
    </miuix.springback.view.SpringBackLayout>
    <Button
        android:id="@+id/cancel_button"
        android:layout_width="150dp"
        android:layout_height="46dp"
        android:text="@string/notify_message_remind_ignore"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/CommonBtn.Normal"/>
    <Button
        android:id="@+id/open_button"
        android:layout_width="150dp"
        android:layout_height="46dp"
        android:text="@string/notify_message_remind_to_open"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        style="@style/CommonBtn.Primary"/>
    <Button
        android:id="@+id/finish_button"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:text="@string/notify_message_remind_finish"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        style="@style/CommonBtn.Primary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
