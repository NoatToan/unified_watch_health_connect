<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/health_activity_sleep_rhythm_calendar_0"
    android:background="@color/page_bg"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.xiaomi.fitness.view.TitleBarAlphaView
        android:id="@+id/titleAlpha"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:tag="binding_1"
            android:paddingBottom="@dimen/size_30"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="@dimen/health_detail_page_common_margin_horizontal">
            <include
                android:id="@+id/cardCalendarRecord"
                layout="@layout/layout_sleep_rhythm_calendar_record"/>
            <com.xiaomi.fitness.view.CardUnderstandView
                android:id="@+id/historyViewCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_12"
                app:txtUnderstand="@string/health_sleep_rhythm_sleep_monitoring_data"/>
            <com.xiaomi.fitness.view.CardUnderstandView
                android:id="@+id/upgradeinfo"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:background="@drawable/selector_card_bg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="18dp"
                        android:paddingVertical="14dp">
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/health_sleep_rhythm_upgrade"/>
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/health_sleep_rhythm_upgradeto"/>
                            </LinearLayout>
                            <TextView
                                android:textSize="18sp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="@string/health_sleep_rhythm_name"
                                android:fontFamily="@font/misanslatin_demibold"/>
                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="22dp">
                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/xiaomi"/>
                                <View
                                    android:layout_gravity="center_vertical"
                                    android:id="@+id/divider_vertical"
                                    android:background="#1a000000"
                                    android:layout_width="0.67dp"
                                    android:layout_height="16.67dp"
                                    android:layout_marginHorizontal="8dp"/>
                                <ImageView
                                    android:layout_width="79.69dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/beidaguoji"/>
                                <View
                                    android:layout_gravity="center_vertical"
                                    android:id="@+id/divider_vertical2"
                                    android:background="#1a000000"
                                    android:layout_width="0.67dp"
                                    android:layout_height="16.67dp"
                                    android:layout_marginHorizontal="8dp"/>
                                <ImageView
                                    android:id="@+id/secondhospital"
                                    android:layout_width="114dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/xuanwuyiyuan"/>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                    <ImageView
                        android:layout_gravity="end|top"
                        android:layout_width="117.59dp"
                        android:layout_height="89.92dp"
                        android:layout_marginTop="18dp"
                        android:src="@drawable/woshou"/>
                </FrameLayout>
            </com.xiaomi.fitness.view.CardUnderstandView>
            <com.xiaomi.fitness.view.CardUnderstandView
                android:id="@+id/historyViewCard1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_12"
                app:txtUnderstand="@string/health_sleep_rhythm_sleep_monitoring_data"/>
            <com.xiaomi.fitness.view.CardUnderstandView
                android:id="@+id/understandCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_12"
                app:txtUnderstand="@string/health_sleep_rhythm_screening_plan_understand"/>
            <com.xiaomi.fitness.view.CardUnderstandView
                android:id="@+id/understandsleepCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_12"
                app:txtUnderstand="@string/health_sleep_rhythm_screening_plan_understand_sleepresearch"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.core.widget.NestedScrollView>
</androidx.appcompat.widget.LinearLayoutCompat>
