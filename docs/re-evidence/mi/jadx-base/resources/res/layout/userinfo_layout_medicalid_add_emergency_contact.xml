<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:tag="layout/userinfo_layout_medicalid_add_emergency_contact_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/page_padding_horizontal_large">
    <TextView
        android:textSize="@dimen/dimen_15sp"
        android:textColor="@color/text_color"
        android:textColorHint="@color/text_color_40"
        android:id="@+id/add_emergency_contact_guide"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_20dp"
        android:text="@string/userinfo_add_emergency_contact_guide"
        android:paddingHorizontal="@dimen/page_extra_padding_horizontal_large"/>
    <EditText
        android:textColor="@color/text_color"
        android:textColorHint="@color/text_color_40"
        android:id="@+id/contact_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28.6dp"
        android:hint="@string/userinfo_contact_name"
        android:layout_below="@+id/add_emergency_contact_guide"
        android:layout_centerVertical="true"
        android:inputType="text"
        android:labelFor="@+id/contact_name_key"
        android:autofillHints="name"
        style="@style/FontMedium.16sp"/>
    <EditText
        android:textColor="@color/text_color"
        android:id="@+id/contact_number"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:hint="@string/userinfo_emergency_contact_number"
        android:maxLength="15"
        android:layout_below="@+id/contact_name"
        android:layout_centerVertical="true"
        android:inputType="phone"
        android:labelFor="@+id/contact_name_key"
        android:autofillHints="phone"
        style="@style/FontMedium.16sp"/>
    <com.xiaomi.fitness.userinfo.medicalid.baseui.UserInfoRightArrowSingleLineTextView
        android:id="@+id/emergency_contact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/contact_number"
        android:paddingHorizontal="@dimen/page_extra_padding_horizontal_large"/>
</RelativeLayout>
