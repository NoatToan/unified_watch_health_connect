<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="60dp"
    android:paddingStart="@dimen/dimen_margin_20dp"
    android:paddingEnd="@dimen/dimen_margin_20dp">
    <TextView
        android:textColor="@color/text_color_40"
        android:id="@+id/txt_item_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_25dp"
        android:layout_marginBottom="5dp"
        style="@style/FontRegular.12sp"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="80dp">
        <ImageView
            android:id="@+id/img_active_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="center"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_active_stage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/size_10"
            android:layout_toEndOf="@+id/img_active_mode">
            <TextView
                android:textSize="@dimen/dimen_12sp"
                android:textColor="@color/text_color_60"
                android:id="@+id/txt_item_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/FontRegular"/>
            <TextView
                android:textSize="@dimen/dimen_14sp"
                android:textColor="@color/text_color"
                android:id="@+id/txt_item_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/FontMedium"/>
        </LinearLayout>
        <View
            android:id="@+id/line_top"
            android:background="@color/common_divider_bg_color"
            android:layout_width="0.5dp"
            android:layout_height="26dp"
            android:layout_alignParentTop="true"
            android:layout_marginStart="@dimen/dimen_margin_15dp"
            android:layout_alignParentStart="true"/>
        <View
            android:id="@+id/line_bottom"
            android:background="@color/common_divider_bg_color"
            android:layout_width="0.5dp"
            android:layout_height="26dp"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/dimen_margin_15dp"
            android:layout_alignParentStart="true"/>
    </RelativeLayout>
</LinearLayout>
