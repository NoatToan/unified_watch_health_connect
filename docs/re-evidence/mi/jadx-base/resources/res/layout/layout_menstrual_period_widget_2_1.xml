<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@android:id/background"
    android:background="@drawable/widget_default_corners_background_12_67"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/iv_image"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_widget_menses_loading"
        android:importantForAccessibility="no"
        android:layout_marginStart="7dp"/>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="7dp">
        <TextView
            android:textSize="14.7dp"
            android:textColor="@color/text_color"
            android:ellipsize="middle"
            android:gravity="start"
            android:id="@+id/tv_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:drawableLeft="@drawable/widget_placeholder_shape_size_40_16"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="10dp"
            style="@style/FontMedium"/>
        <TextView
            android:textSize="10dp"
            android:textColor="@color/text_color_60"
            android:ellipsize="middle"
            android:gravity="start"
            android:id="@+id/tv_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:drawableLeft="@drawable/widget_placeholder_shape_size_70_12"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="7dp"
            style="@style/FontRegular"/>
        <TextView
            android:textSize="10dp"
            android:textColor="@color/text_color"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/tv_no_init_tip"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:paddingEnd="@dimen/size_20"
            android:letterSpacing="0.01"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="7dp"
            style="@style/FontRegular"/>
    </LinearLayout>
</LinearLayout>
