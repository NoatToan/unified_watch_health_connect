<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollview"
    android:tag="layout/health_fragment_sleep_phythm_detail_0"
    android:background="@color/page_bg"
    android:scrollbars="none"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.xiaomi.fitness.widget.RightArrowSingleLineTextView
            android:textSize="@dimen/dimen_12sp"
            android:textColor="@color/text_color"
            android:id="@+id/diary_time_tv"
            android:background="@drawable/common_card_bg_white"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_10dp"
            android:paddingStart="@dimen/page_content_padding_horizontal_large"
            android:paddingEnd="@dimen/page_extra_padding_horizontal_large"
            app:title="@string/health_sleep_diary_time"/>
        <LinearLayout
            android:orientation="vertical"
            android:tag="binding_1"
            android:background="@drawable/common_card_bg_white"
            android:paddingBottom="@dimen/page_extra_padding_horizontal_large"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_10dp"
            android:layout_marginHorizontal="@dimen/page_padding_horizontal_large">
            <com.xiaomi.fitness.widget.RightArrowSingleLineTextView
                android:id="@+id/health_sleep_rhythm_item_icon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/page_extra_padding_horizontal_large"
                app:icon="@drawable/health_sleep_phythm_item_icon"
                app:remindText="@string/health_sleep_rhythm_all"
                app:showRemind="true"
                app:title="@string/health_sleep_rhythm"/>
            <View
                android:id="@+id/common_divider_line"
                android:background="@color/common_divider_line"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginHorizontal="@dimen/page_extra_padding_horizontal_large"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="vertical"
                android:id="@+id/chat_list_root_view"
                android:tag="binding_2"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_16dp"
                android:layout_marginHorizontal="@dimen/page_extra_padding_horizontal_large"
                app:layout_goneMarginTop="0dp">
                <include
                    android:id="@+id/health_sleep_rhythm_title_des"
                    layout="@layout/health_sleep_rhythm_title_des"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/chat_list_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_margin_10dp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:layout_constraintStart_toStartOf="@+id/health_sleep_rhythm_item_icon"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <include
                android:id="@+id/sleep_rhythm_chat_empty_view"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="75dp"
                android:layout_marginTop="@dimen/dimen_margin_16dp"
                android:layout_marginHorizontal="@dimen/page_extra_padding_horizontal_large"
                app:layout_goneMarginTop="0dp"
                layout="@layout/health_rhythm_chart_empty_view"/>
        </LinearLayout>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:id="@+id/health_sleep_rhythm_diary_view"
            android:tag="binding_3"
            android:background="@drawable/common_card_bg_white"
            android:paddingBottom="@dimen/page_extra_padding_horizontal_large"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_10dp"
            android:layout_marginHorizontal="@dimen/page_padding_horizontal_large">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/page_extra_padding_horizontal_large">
                <ImageView
                    android:id="@+id/health_sleep_rhythm_diary_icon"
                    android:background="@drawable/health_sleep_rhythm_diary_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_margin_16dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:theme="@style/FontMedium.16sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/health_sleep_diary"
                    android:layout_marginStart="@dimen/dimen_margin_10dp"
                    app:layout_constraintBottom_toBottomOf="@+id/health_sleep_rhythm_diary_icon"
                    app:layout_constraintStart_toEndOf="@+id/health_sleep_rhythm_diary_icon"
                    app:layout_constraintTop_toTopOf="@+id/health_sleep_rhythm_diary_icon"/>
                <ImageView
                    android:id="@+id/health_sleep_rhythm_edit_icon"
                    android:background="@drawable/health_sleep_rhythm_edit_icon"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="@+id/health_sleep_rhythm_diary_icon"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/health_sleep_rhythm_diary_icon"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <View
                android:id="@+id/diary_divider_line"
                android:background="@color/common_divider_line"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginTop="@dimen/dimen_margin_16dp"
                android:layout_marginHorizontal="@dimen/page_extra_padding_horizontal_large"/>
            <com.xiaomi.fitness.health.sleep.rhythm.rhythm.SleepRhythmDetailDiaryView
                android:id="@+id/sleep_rhythm_diary_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_16dp"
                android:layout_marginHorizontal="@dimen/page_extra_padding_horizontal_large"
                app:layout_goneMarginTop="0dp"/>
            <com.xiaomi.fitness.health.sleep.rhythm.rhythm.SleepRhythmDetailDiaryListView
                android:id="@+id/sleep_rhythm_diary_list_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_16dp"
                android:layout_marginHorizontal="@dimen/page_extra_padding_horizontal_large"
                app:layout_goneMarginTop="0dp"/>
            <include
                android:id="@+id/sleep_diary_empty_view"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="75dp"
                android:layout_marginTop="@dimen/dimen_margin_16dp"
                android:layout_marginHorizontal="@dimen/page_extra_padding_horizontal_large"
                app:layout_goneMarginTop="0dp"
                layout="@layout/health_rhythm_chart_empty_view"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:tag="binding_4"
            android:background="@drawable/common_card_bg_white"
            android:paddingBottom="@dimen/page_extra_padding_horizontal_large"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_10dp"
            android:layout_marginHorizontal="@dimen/page_padding_horizontal_large">
            <com.xiaomi.fitness.widget.RightArrowSingleLineTextView
                android:id="@+id/sleep_detail_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/page_extra_padding_horizontal_large"
                app:icon="@drawable/health_sleep_phythm_item_icon"
                app:remindText="@string/health_sleep_rhythm_all"
                app:showRemind="true"
                app:title="@string/health_sleep_long_sleep"/>
            <View
                android:id="@+id/long_sleep_divider_line"
                android:background="@color/common_divider_line"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginHorizontal="@dimen/page_extra_padding_horizontal_large"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="vertical"
                android:id="@+id/sleep_detail_chat_root_view"
                android:tag="binding_5"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_16dp"
                android:layout_marginHorizontal="@dimen/page_extra_padding_horizontal_large"
                app:layout_goneMarginTop="0dp">
                <include
                    android:id="@+id/health_sleep_detail_title_des"
                    layout="@layout/health_sleep_detail_title_des"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/sleep_detail_rv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_margin_10dp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:layout_constraintStart_toStartOf="parent"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <include
                android:id="@+id/sleep_detail_chat_empty_view"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="75dp"
                android:layout_marginTop="@dimen/dimen_margin_16dp"
                android:layout_marginHorizontal="@dimen/page_extra_padding_horizontal_large"
                app:layout_goneMarginTop="0dp"
                layout="@layout/health_rhythm_chart_empty_view"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/pdf_view"
            android:tag="binding_6"
            android:background="@color/common_white"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include
                android:id="@+id/health_sleep_rhythm_report_view_1"
                layout="@layout/health_sleep_rhythm_report_view"/>
            <include
                android:id="@+id/health_sleep_rhythm_report_view_2"
                layout="@layout/health_sleep_rhythm_report_view"/>
            <include
                android:id="@+id/health_sleep_rhythm_report_view_3"
                layout="@layout/health_sleep_rhythm_report_view"/>
            <include
                android:id="@+id/health_sleep_rhythm_report_view_4"
                layout="@layout/health_sleep_rhythm_report_view"/>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
