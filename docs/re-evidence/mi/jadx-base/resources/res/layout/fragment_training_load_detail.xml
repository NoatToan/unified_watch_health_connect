<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/fragment_training_load_detail_0"
    android:paddingBottom="@dimen/health_detail_page_common_margin_vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.xiaomi.fitness.chart.view.LineChartRecyclerView
            android:id="@+id/line_recycler"
            app:chartColor="@color/health_training_load_chart_color"
            app:displayNumbers="28"
            app:dynamicAdjustItemFillWidth="true"
            app:enableEndDayXAxis="true"
            app:enableEndYAxisLabel="true"
            app:enableScrollToScale="true"
            app:enableStartYAxisLabel="false"
            app:enableXAxisFirstGridLine="false"
            app:enableXAxisLineCircle="true"
            app:enableXAxisThirdGridLine="false"
            app:lineColor="@color/health_training_load_chart_color"
            app:linePointRadius="@dimen/size_2"
            app:linePointSelectCircleStroke="true"
            app:linePointSelectRadius="@dimen/size_2"
            app:linePointSelectStrokeWidth="@dimen/size_2"
            app:lineSelectCircles="1"
            app:lineShaderBeginColor="@color/health_training_load_shader_begin"
            app:lineShaderEndColor="@color/health_training_load_shader_end"
            app:lineStrokeWidth="6"
            style="@style/ChartBaseStyle"/>
        <com.xiaomi.fitness.view.DataTitleView
            android:id="@+id/dataTitleView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/today_train_load_card"
        android:background="@drawable/selector_card_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/health_detail_page_common_margin_horizontal">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"/>
        <View
            android:id="@+id/divider"
            android:background="@color/common_divider_bg_color"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_0_33"
            android:layout_marginBottom="@dimen/size_10"
            android:layout_marginStart="@dimen/size_18"
            android:layout_marginEnd="@dimen/size_18"/>
        <com.xiaomi.fitness.baseui.widget.LevelBarView
            android:id="@+id/levelBarView"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_40"
            android:layout_marginStart="@dimen/size_18"
            android:layout_marginEnd="@dimen/size_18"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/level_desc_recyclerview"
            android:paddingBottom="@dimen/size_10"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/size_18"
            android:layout_marginEnd="@dimen/size_18"/>
    </LinearLayout>
    <com.xiaomi.fitness.common.devicelist.SportsDeviceListView
        android:id="@+id/deviceListView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/health_detail_page_common_margin_horizontal"/>
    <com.xiaomi.fitness.view.CardUnderstandView
        android:id="@+id/understandCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_12"
        android:layout_marginHorizontal="@dimen/health_detail_page_common_margin_horizontal"
        app:txtUnderstand="@string/health_training_load_understand"/>
</LinearLayout>
