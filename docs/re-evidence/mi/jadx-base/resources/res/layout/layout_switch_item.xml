<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/common_set_item_height"
    android:paddingStart="@dimen/common_set_margin_start"
    android:paddingEnd="@dimen/common_set_margin_start">
    <ImageView
        android:id="@+id/switch_icon"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/switch_item_name_linear"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/common_set_item_margin"
        android:layout_marginBottom="@dimen/common_set_item_margin"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/switch_item_checkbox"
        app:layout_constraintStart_toEndOf="@+id/switch_icon"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/common_item_set_title_text_size"
            android:textColor="@color/switch_black"
            android:id="@+id/switch_name_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            style="@style/TextAppearance.MiuiBold"/>
        <TextView
            android:textSize="@dimen/common_item_set_des_text_size"
            android:textColor="@color/switch_black"
            android:id="@+id/switch_des_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:includeFontPadding="false"
            android:textDirection="locale"/>
    </LinearLayout>
    <View
        android:id="@+id/switch_item_lineview"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/switch_item_name_linear"
        style="@style/SettingsLineStyle"/>
    <com.xiaomi.fitness.widget.button.SwitchButton
        android:id="@+id/switch_item_checkbox"
        android:layout_width="@dimen/lib_sb_width"
        android:layout_height="@dimen/lib_sb_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/arrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/right_arrow_icon"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
