<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="70dp"
    android:layout_height="@dimen/feedback_img_size">
    <ImageView
        android:id="@+id/feedback_imgview"
        android:layout_width="@dimen/feedback_img_size"
        android:layout_height="@dimen/feedback_img_size"
        android:scaleType="centerCrop"/>
    <ImageView
        android:layout_gravity="end|top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/size_4_7"
        android:src="@drawable/feedback_icon_item_delete"/>
</FrameLayout>
