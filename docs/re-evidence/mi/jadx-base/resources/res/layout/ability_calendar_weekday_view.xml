                android:textColor="@color/text_color_30"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/mondayRestTip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/training_plan_day_rest_tip"
                android:fontFamily="@font/misanslatin_regular"/>
            <View
                android:layout_gravity="center"
                android:id="@+id/mondayCourseIndicator"
                android:layout_width="5dp"
                android:layout_height="5dp"/>
        </FrameLayout>
    </LinearLayout>
