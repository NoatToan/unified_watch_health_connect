<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:id="@+id/common_loading_dialog"
    android:layout_width="160dp"
    android:layout_height="100dp">
    <ProgressBar style="@style/ProgressDialogIndeterminateProgressbar"/>
    <TextView
        android:textSize="@dimen/text_size_14"
        android:textColor="@color/access_common_textcolor_2"
        android:ellipsize="end"
        android:id="@+id/common_loading_dialog_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/access_common_waiting"
        android:singleLine="true"/>
</LinearLayout>
