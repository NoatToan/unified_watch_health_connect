<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layot_pai_limit"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/size_18">
        <TextView
            android:textSize="@dimen/font_22"
            android:textColor="@color/text_color"
            android:id="@+id/tv_pai_high_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            style="@style/FontLatinMedium"/>
        <TextView
            android:textColor="@color/text_color"
            android:id="@+id/tv_pai_high_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PAI"
            android:layout_alignBaseline="@+id/tv_pai_high_value"
            android:layout_marginStart="@dimen/size_2"
            android:layout_toEndOf="@+id/tv_pai_high_value"
            style="@style/FontMedium.12sp"/>
        <TextView
            android:textColor="@color/text_color_40"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/health_pai_high_value"
            android:layout_below="@+id/tv_pai_high_value"
            style="@style/FontRegular.12sp"/>
    </RelativeLayout>
    <View
        android:layout_gravity="center_vertical"
        android:background="@color/common_divider_bg_color"
        android:layout_width="@dimen/size_0_33"
        android:layout_height="@dimen/size_37_3"/>
    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/size_18">
        <TextView
            android:textSize="@dimen/font_22"
            android:textColor="@color/text_color"
            android:id="@+id/tv_pai_medium_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            style="@style/FontLatinMedium"/>
        <TextView
            android:textColor="@color/text_color"
            android:id="@+id/tv_pai_medium_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PAI"
            android:layout_alignBaseline="@+id/tv_pai_medium_value"
            android:layout_marginStart="@dimen/size_2"
            android:layout_toEndOf="@+id/tv_pai_medium_value"
            style="@style/FontMedium.12sp"/>
        <TextView
            android:textColor="@color/text_color_40"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/health_pai_medium_value"
            android:layout_below="@+id/tv_pai_medium_value"
            style="@style/FontRegular.12sp"/>
    </RelativeLayout>
    <View
        android:layout_gravity="center_vertical"
        android:background="@color/common_divider_bg_color"
        android:layout_width="@dimen/size_0_33"
        android:layout_height="@dimen/size_37_3"/>
    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/size_18">
        <TextView
            android:textSize="@dimen/font_22"
            android:textColor="@color/text_color"
            android:id="@+id/tv_pai_low_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            style="@style/FontLatinMedium"/>
        <TextView
            android:textColor="@color/text_color"
            android:id="@+id/tv_pai_low_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PAI"
            android:layout_alignBaseline="@+id/tv_pai_low_value"
            android:layout_marginStart="@dimen/size_2"
            android:layout_toEndOf="@+id/tv_pai_low_value"
            style="@style/FontMedium.12sp"/>
        <TextView
            android:textColor="@color/text_color_40"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/health_pai_low_value"
            android:layout_below="@+id/tv_pai_low_value"
            style="@style/FontRegular.12sp"/>
    </RelativeLayout>
</LinearLayout>
