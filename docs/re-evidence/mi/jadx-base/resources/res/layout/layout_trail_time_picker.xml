<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.xiaomi.fitness.baseui.widget.NumberPickerView
        android:scrollbarSize="@dimen/dimen_26sp"
        android:id="@+id/num_picker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginTop="0dp"
        app:npv_NumberDigits="1"
        style="@style/Picker.Number.Dialog"/>
    <TextView
        android:textSize="@dimen/text_size_9"
        android:id="@+id/unit_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_margin_50dp"
        app:layout_constraintBottom_toBottomOf="@+id/num_picker"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/num_picker"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/add_more_layout"
        android:layout_width="match_parent"
        android:layout_height="53dp"
        android:layout_marginStart="@dimen/margin_27dp"
        android:layout_marginEnd="@dimen/margin_27dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/num_picker">
        <TextView
            android:textSize="@dimen/dialog_text_size_16"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/trail_add_more"
            android:layout_marginStart="@dimen/dimen_margin_15dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_trail_arrow_icon"
            android:layout_marginEnd="@dimen/dimen_margin_20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
