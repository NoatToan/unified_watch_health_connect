<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/device_settings_widget_select_title_0"
    android:padding="@dimen/dimen_margin_9dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/widget_select_handler"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="1dp"
        android:src="@drawable/widget_select_handler"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/img_back_press"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_8dp"
        android:src="@drawable/ic_back"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="@dimen/dimen_margin_8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/widget_select_handler"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/widget_select_handler">
        <ImageView
            android:id="@+id/img_widget_icon"
            android:visibility="gone"
            android:layout_width="21dp"
            android:layout_height="21dp"/>
        <TextView
            android:textSize="@dimen/dimen_20sp"
            android:textColor="@color/text_color"
            android:id="@+id/tv_widget_group_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/dimen_margin_2dp"
            android:text="@string/device_settings_common_weather"
            android:fontFamily="@font/misanslatin_regular"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
