<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="20dp"
    android:paddingStart="@dimen/size_18">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/font_18"
            android:id="@+id/txt_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            style="@style/FontMedium"/>
        <com.xiaomi.fitness.widget.view.DurationTextView
            android:id="@+id/duration_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_7dp"
            app:dtv_dataFont="@font/misanslatin_medium"
            app:dtv_dataTextColor="@color/text_color"
            app:dtv_dataTextSize="@dimen/font_18"
            app:dtv_unitTextColor="@color/text_color"
            app:dtv_unitTextFontFamily="mipro-medium"
            app:dtv_unitTextSize="@dimen/font_12"/>
        <TextView
            android:textSize="@dimen/font_18"
            android:id="@+id/txt_value_wake"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:layout_marginStart="@dimen/margin_7dp"
            style="@style/FontMedium"/>
        <TextView
            android:textSize="@dimen/font_12"
            android:textColor="@color/text_color"
            android:id="@+id/txt_unit_wake"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:layout_marginStart="@dimen/size_2"
            style="@style/FontMedium.12sp"/>
        <TextView
            android:textSize="@dimen/text_size_9"
            android:textColor="@color/health_sleep_distribute_item_abnormal_txt_color"
            android:layout_gravity="center"
            android:id="@+id/tv_abnormal"
            android:background="@drawable/shape_sleep_distribute_item_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_margin_3dp"
            android:paddingHorizontal="@dimen/dimen_margin_3dp"
            android:paddingVertical="@dimen/dimen_margin_1dp"/>
    </LinearLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_12dp">
        <com.xiaomi.fitness.view.HealthDistributeSegmentView
            android:id="@+id/sleepSegmentView"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_margin_24dp"
            android:layout_marginTop="1dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/sleep_cover_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <View
                    android:id="@+id/sleep_cover_view_left"
                    android:layout_width="2dp"
                    android:layout_height="@dimen/margin_27dp"/>
                <ImageView
                    android:id="@+id/sleep_cover_image"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dimen_margin_24dp"
                    android:layout_marginTop="@dimen/dimen_margin_1dp"
                    android:layout_marginBottom="@dimen/dimen_margin_1dp"
                    android:layout_marginEnd="2dp"/>
                <View
                    android:id="@+id/sleep_cover_view_right"
                    android:layout_width="2dp"
                    android:layout_height="@dimen/margin_27dp"
                    android:layout_marginStart="-2dp"/>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/font_10"
                android:textColor="@color/text_color_40"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/sleep_cover_txt_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_5dp"
                style="@style/FontMedium"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/text_size_12"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/txt_percent"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dimen_margin_24dp"
            android:layout_marginTop="1dp"
            android:includeFontPadding="false"
            android:layout_marginStart="5dp"
            style="@style/FontMedium"/>
    </RelativeLayout>
</LinearLayout>
