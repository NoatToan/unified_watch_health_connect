<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/device_settings_fragment_add_custom_vibrate_mode_0"
    android:background="@color/app_4_0_bg_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.xiaomi.fitness.devicesettings.huami.vibratemode.VibrateCustomTouchView
        android:id="@+id/touch_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/dimen_margin_22dp"
        android:layout_marginHorizontal="@dimen/page_padding_horizontal_large"
        app:layout_constraintBottom_toTopOf="@+id/progressView"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_weight="1"/>
    <com.xiaomi.fitness.devicesettings.huami.vibratemode.BubbleAnimationView
        android:id="@+id/bubble"
        android:layout_width="@dimen/dimen_margin_0dp"
        android:layout_height="@dimen/dimen_margin_0dp"
        app:layout_constraintBottom_toBottomOf="@+id/touch_view"
        app:layout_constraintEnd_toEndOf="@+id/touch_view"
        app:layout_constraintStart_toStartOf="@+id/touch_view"
        app:layout_constraintTop_toTopOf="@+id/touch_view"/>
    <com.xiaomi.fitness.devicesettings.huami.vibratemode.VibrateModeProgressBar
        android:id="@+id/progressView"
        android:layout_width="match_parent"
        android:layout_height="29dp"
        android:layout_marginBottom="@dimen/dimen_margin_30dp"
        android:layout_marginHorizontal="@dimen/page_content_padding_horizontal_large"
        app:layout_constraintBottom_toTopOf="@+id/bottomView"
        app:layout_constraintTop_toBottomOf="@+id/touch_view"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/bottomView"
        android:paddingBottom="@dimen/dimen_margin_10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/page_content_padding_horizontal_large"
        android:paddingEnd="@dimen/page_content_padding_horizontal_large"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/progressView">
        <Button
            android:enabled="false"
            android:id="@+id/vibrateView"
            android:layout_width="0dp"
            android:layout_height="@dimen/common_btn_height"
            android:text="@string/device_settings_add_new_vibrate_in_device"
            android:layout_weight="1"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp"
            style="@style/CommonBtn.Normal"/>
        <Button
            android:enabled="false"
            android:id="@+id/stopView"
            android:layout_width="0dp"
            android:layout_height="@dimen/common_btn_height"
            android:text="@string/device_settings_add_new_vibrate_stop"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/common_set_item_margin"
            android:layout_marginEnd="0dp"
            style="@style/CommonBtn.Normal"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
