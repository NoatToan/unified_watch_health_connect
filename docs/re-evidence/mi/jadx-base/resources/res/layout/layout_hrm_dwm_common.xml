<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/layout_hrm_dwm_common_0"
    android:paddingBottom="@dimen/health_detail_page_common_margin_vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/health_detail_page_common_margin_horizontal">
    <com.xiaomi.fitness.widget.view.CardStyleSetView
        android:id="@+id/hrm_phone_record"
        android:background="@drawable/selector_card_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/health_detail_page_common_margin_vertical"
        app:card_left_image="@drawable/sport_data_rate_manual_record"
        app:card_title="@string/health_hrm_phone_record"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_rate_detail"
        android:background="@drawable/shape_data_item_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/health_detail_page_common_margin_vertical"
        android:overScrollMode="never"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_abnormal_rate_high"
        android:background="@drawable/shape_data_item_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/health_detail_page_common_margin_vertical"
        android:overScrollMode="never"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_abnormal_rate_low"
        android:background="@drawable/shape_data_item_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/health_detail_page_common_margin_vertical"
        android:overScrollMode="never"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_abnormal_fib"
        android:background="@drawable/shape_data_item_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/health_detail_page_common_margin_vertical"
        android:overScrollMode="never"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_rate_distribute"
        android:background="@drawable/shape_data_item_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/health_detail_page_common_margin_vertical"
        android:overScrollMode="never"/>
    <com.xiaomi.fitness.view.HealthBannerCardSetView
        android:id="@+id/health_banner_card_set"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/health_detail_page_common_margin_vertical"/>
    <com.xiaomi.fitness.view.CardUnderstandView
        android:id="@+id/understandCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:txtUnderstand="@string/health_hrm_understand"/>
</LinearLayout>
