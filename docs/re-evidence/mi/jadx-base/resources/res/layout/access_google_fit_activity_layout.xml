<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/access_google_fit_activity_layout_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/network_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/icon"
            android:background="@drawable/ic_access_googlefit"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginTop="41.67dp"
            android:layout_centerHorizontal="true"
            android:contentDescription="@string/access_thirdparty_google_fit"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.xiaomi.fitness.widget.view.DividerView
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_40dp"
            android:layout_marginHorizontal="@dimen/page_content_padding_horizontal_large"
            app:layout_constraintTop_toBottomOf="@+id/icon"/>
        <TextView
            android:id="@+id/description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_30dp"
            android:layout_marginHorizontal="@dimen/page_content_padding_horizontal_large"
            app:layout_constraintTop_toBottomOf="@+id/divider"
            style="@style/FontRegular.14sp"/>
        <TextView
            android:textSize="@dimen/dimen_16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/bottom_btn"
            android:background="@drawable/selector_bottom_btn_positive_bg"
            android:layout_width="306.6641dp"
            android:layout_height="@dimen/common_btn_height"
            android:layout_marginBottom="26.67dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <miuix.androidbasewidget.widget.ProgressBar
            android:layout_gravity="center_vertical"
            android:id="@+id/loading_rotate_progress_bar"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/bottom_btn"
            app:layout_constraintEnd_toEndOf="@+id/bottom_btn"
            app:layout_constraintStart_toStartOf="@+id/bottom_btn"
            app:layout_constraintTop_toTopOf="@+id/bottom_btn"
            style="@style/ProgressDialogIndeterminateProgressbar_white"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/no_network_fallback_page"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="@dimen/dimen_14sp"
            android:textColor="@color/common_network_connection_failed_text_color"
            android:gravity="center_horizontal"
            android:id="@+id/icon_no_network"
            android:layout_width="100dp"
            android:layout_height="150dp"
            android:text="@string/common_network_connection_failed_please_retry"
            android:drawableTop="@drawable/icon_no_network"
            android:drawablePadding="@dimen/dimen_margin_10dp"
            android:layout_centerInParent="true"
            android:translationY="-60dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/dimen_16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/btn_retry"
            android:background="@drawable/selector_bottom_btn_positive_bg"
            android:layout_width="306.6641dp"
            android:layout_height="@dimen/common_btn_height"
            android:layout_marginBottom="26.67dp"
            android:text="@string/common_retry"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
