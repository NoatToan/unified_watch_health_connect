<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/lineContain"
    android:tag="layout/share_view_trace_line_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="@dimen/margin_10dp">
    <com.xiaomi.fitness.chart.mpchart.linechart.CustomLineChart
        android:id="@+id/lineChart"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginTop="@dimen/dimen_margin_0dp"
        android:layout_marginBottom="@dimen/dimen_margin_0dp"
        android:layout_weight="1"
        android:layout_marginEnd="@dimen/dimen_margin_3dp"
        android:paddingHorizontal="@dimen/dimen_margin_0dp"
        android:paddingVertical="@dimen/dimen_margin_0dp"
        app:disableDrawZeroLiner="true"
        app:layout_constraintEnd_toStartOf="@+id/lineTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:lineColor="@color/white"
        app:lineFillColor="@color/white_60_transparent"
        app:lineFillRes="@drawable/sport_fill_bg"
        app:lineStrokeWidth="1"
        app:minYAxisZero="false"/>
    <TextView
        android:textSize="@dimen/font_10"
        android:textColor="@color/white_40_transparent"
        android:id="@+id/lineTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/trail_sport_height_of_climb"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</LinearLayout>
