<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/access_wechat_thirdparty_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/page_content_padding_horizontal_large">
    <ScrollView
        android:orientation="vertical"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/dimen_margin_20dp"
        app:layout_constraintBottom_toTopOf="@+id/unBindView"
        app:layout_constraintTop_toTopOf="parent">
        <RelativeLayout
            android:id="@+id/bindSuccessView"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="@dimen/dimen_14sp"
                android:textColor="@color/access_black"
                android:gravity="center"
                android:id="@+id/thirdparty_wechat_bound"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginTop="50dp"
                android:text="@string/access_thirdparty_wechat_bound"
                android:drawableTop="@drawable/card_issue_success_big"
                android:drawablePadding="20dp"
                android:layout_centerHorizontal="true"/>
            <com.xiaomi.fitness.widget.view.DividerView
                android:id="@+id/dividerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="50dp"
                android:layout_below="@+id/thirdparty_wechat_bound"
                android:layout_centerHorizontal="true"
                android:layout_marginEnd="20dp"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/text_color"
                android:gravity="start"
                android:id="@+id/function_upgrade_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_20dp"
                android:text="@string/access_wechat_sport_function_upgrade"
                android:layout_below="@+id/dividerView"
                style="@style/FontDemiBold.16sp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/text_color_40"
                android:gravity="start"
                android:id="@+id/function_upgrade_des_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_10dp"
                android:text="@string/access_wechat_sport_setting_upgrade_des_1"
                android:layout_below="@+id/function_upgrade_title"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/text_color_40"
                android:gravity="start"
                android:id="@+id/function_upgrade_des_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/access_wechat_sport_setting_upgrade_des_2"
                android:layout_below="@+id/function_upgrade_des_1"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/text_color_40"
                android:gravity="start"
                android:id="@+id/function_upgrade_des_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/access_wechat_sport_setting_upgrade_des_3"
                android:layout_below="@+id/function_upgrade_des_2"/>
        </RelativeLayout>
    </ScrollView>
    <Button
        android:textColor="@color/white"
        android:id="@+id/unBindView"
        android:background="@drawable/access_btn_bg_orange"
        android:layout_width="@dimen/common_btn_single_line_width"
        android:layout_height="46.67dp"
        android:layout_marginBottom="20dp"
        android:text="@string/access_thirdparty_alipay_unbind"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
