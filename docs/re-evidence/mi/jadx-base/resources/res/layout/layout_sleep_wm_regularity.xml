<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/layout_sleep_wm_regularity_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:tag="binding_1"
        android:background="@drawable/shape_data_item_bg"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include
            android:id="@+id/layout_common_title_regularity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_20dp"
            app:layout_constraintTop_toTopOf="parent"
            layout="@layout/layout_common_icon_title"/>
        <FrameLayout
            android:tag="binding_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include
                android:id="@+id/layout_sleep_regularity_header_bedtime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dimen_margin_18dp"
                layout="@layout/layout_sleep_regularity_header"/>
            <com.xiaomi.fitness.chart.view.LineChartRecyclerView
                android:id="@+id/recycler_bedtime"
                android:layout_marginTop="60dp"
                android:paddingStart="@dimen/dimen_margin_18dp"
                app:barChartMaxWidth="@dimen/size_3"
                app:barChartRoundRectRadiusRatio="0.5"
                app:dynamicAdjustItemFillWidth="true"
                app:enableEndDayXAxis="true"
                app:enableStartYAxisLabel="false"
                app:lineColor="@color/sleep_duration_target"
                app:linePointRadius="@dimen/size_2"
                app:linePointSelectCircleStroke="true"
                app:linePointSelectRadius="@dimen/size_2"
                app:linePointSelectStrokeWidth="@dimen/size_2"
                app:lineSelectCircles="1"
                app:lineShaderBeginColor="@color/transparent"
                app:lineShaderEndColor="@color/transparent"
                app:lineStrokeWidth="6"
                style="@style/ChartBaseStyle"/>
        </FrameLayout>
        <FrameLayout
            android:tag="binding_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include
                android:id="@+id/layout_sleep_regularity_header_wakeup_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dimen_margin_18dp"
                layout="@layout/layout_sleep_regularity_header"/>
            <com.xiaomi.fitness.chart.view.LineChartRecyclerView
                android:id="@+id/recycler_wakeup_time"
                android:layout_marginTop="60dp"
                android:paddingStart="@dimen/dimen_margin_18dp"
                app:barChartMaxWidth="@dimen/size_3"
                app:barChartRoundRectRadiusRatio="0.5"
                app:dynamicAdjustItemFillWidth="true"
                app:enableEndDayXAxis="true"
                app:enableStartYAxisLabel="false"
                app:lineColor="@color/sleep_duration_target"
                app:linePointRadius="@dimen/size_2"
                app:linePointSelectCircleStroke="true"
                app:linePointSelectRadius="@dimen/size_2"
                app:linePointSelectStrokeWidth="@dimen/size_2"
                app:lineSelectCircles="1"
                app:lineShaderBeginColor="@color/transparent"
                app:lineShaderEndColor="@color/transparent"
                app:lineStrokeWidth="6"
                style="@style/ChartBaseStyle"/>
        </FrameLayout>
    </LinearLayout>
</ScrollView>
