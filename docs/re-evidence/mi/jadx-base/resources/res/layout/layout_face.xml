<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/layout_face_0"
    android:paddingTop="5dp"
    android:paddingBottom="@dimen/dimen_margin_15dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.xiaomi.fitness.watch.face.view.FaceImageView
        android:layout_gravity="center"
        android:id="@+id/mImageView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.xiaomi.fitness.watch.face.view.FaceImageView
        android:layout_gravity="center"
        android:id="@+id/mStyleView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/mImageView"
        app:layout_constraintStart_toStartOf="@+id/mImageView"/>
    <View
        android:id="@+id/checkView"
        android:background="@drawable/selector_face_check"
        android:visibility="gone"
        android:layout_width="@dimen/dimen_margin_24dp"
        android:layout_height="@dimen/dimen_margin_24dp"
        android:translationY="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/mImageView"
        app:layout_constraintEnd_toEndOf="@+id/mImageView"
        app:layout_constraintStart_toStartOf="@+id/mImageView"/>
    <TextView
        android:textColor="@color/white"
        android:id="@+id/mTagView"
        android:background="@drawable/bg_face_item_tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-2dp"
        android:text="@string/face_me_tag_vip"
        android:layout_marginEnd="@dimen/dimen_margin_4dp"
        android:paddingHorizontal="@dimen/dimen_margin_5dp"
        android:paddingVertical="@dimen/dimen_margin_3dp"
        app:layout_constraintEnd_toEndOf="@+id/mImageView"
        app:layout_constraintTop_toTopOf="@+id/mImageView"/>
    <TextView
        android:textSize="@dimen/dimen_12sp"
        android:textColor="@color/white"
        android:id="@+id/invalid_tag"
        android:background="@drawable/bg_face_item_invalid_tag"
        android:padding="@dimen/dimen_margin_6dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/face_me_invalid"
        app:layout_constraintBottom_toBottomOf="@+id/mImageView"
        app:layout_constraintEnd_toEndOf="@+id/mImageView"
        app:layout_constraintStart_toStartOf="@+id/mImageView"
        app:layout_constraintTop_toTopOf="@+id/mImageView"/>
    <TextView
        android:textSize="@dimen/dimen_13sp"
        android:textColor="@color/face_common_text"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/mNameView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:maxLines="1"
        app:layout_constraintTop_toBottomOf="@+id/mImageView"
        style="@style/FontDemiBold"/>
    <TextView
        android:textSize="@dimen/dimen_11sp"
        android:textColor="@color/footer_desc"
        android:gravity="center_horizontal"
        android:id="@+id/mStateView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_4dp"
        android:text="@string/face_me_can_edit"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mNameView"
        style="@style/FontNormal"/>
    <View
        android:id="@+id/empty_view"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_margin_10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mStateView"/>
</androidx.constraintlayout.widget.ConstraintLayout>
