<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/mine_track_adapter_0"
    android:background="@drawable/mine_track_bg"
    android:padding="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp">
    <ImageView
        android:id="@+id/img"
        android:background="@drawable/mine_track_line_bg"
        android:layout_width="73.3dp"
        android:layout_height="73.3dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/mine_track_lib_item_text_title"
        android:ellipsize="end"
        android:id="@+id/trackName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="170dp"
        android:singleLine="true"
        android:layout_marginStart="13.3dp"
        app:layout_constraintStart_toEndOf="@+id/img"
        app:layout_constraintTop_toTopOf="@+id/img"/>
    <TextView
        android:textColor="#45b4ff"
        android:id="@+id/trackTag"
        android:background="@drawable/shape_mine_track_tag"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/mine_transferred"
        android:layout_marginStart="@dimen/dimen_margin_10dp"
        android:paddingHorizontal="3dp"
        android:paddingVertical="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/trackName"
        app:layout_constraintStart_toEndOf="@+id/trackName"
        app:layout_constraintTop_toTopOf="@+id/trackName"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/mine_track_lib_item_text"
        android:id="@+id/dis"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/bornDate"
        app:layout_constraintStart_toStartOf="@+id/trackName"
        app:layout_constraintTop_toBottomOf="@+id/trackName"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/mine_track_lib_item_text"
        android:id="@+id/bornDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/img"
        app:layout_constraintStart_toStartOf="@+id/trackName"
        app:layout_constraintTop_toBottomOf="@+id/dis"/>
    <View
        android:id="@+id/selectImg"
        android:background="@drawable/mine_route_select"
        android:visibility="gone"
        android:layout_width="21dp"
        android:layout_height="21dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/selectImgFl"
        android:layout_width="50dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/selectImg"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/arrow"
        android:background="@drawable/ic_base_right_arrow_icon_size_48"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
