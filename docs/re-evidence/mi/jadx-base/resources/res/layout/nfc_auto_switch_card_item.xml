<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:background="@drawable/nfc_shape_card_bg_normal"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/cardFaceView"
            android:layout_width="75dp"
            android:layout_height="47dp"
            android:layout_centerVertical="true"/>
        <TextView
            android:textStyle="bold"
            android:id="@+id/nameView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/size_10"
            android:layout_marginEnd="@dimen/dimen_margin_10dp"
            android:layout_toStartOf="@+id/checkView"
            android:layout_toEndOf="@+id/cardFaceView"
            style="@style/nfc_TextAppearance.List.Primary"/>
        <ImageView
            android:id="@+id/checkView"
            android:background="@drawable/selector_common_circle_check"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <TextView
        android:textSize="@dimen/dimen_13sp"
        android:textColor="@color/nfc_card_manager_subtitle"
        android:id="@+id/jobTipView"
        android:paddingTop="15dp"
        android:paddingBottom="10dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="@string/nfc_auto_switch_card_job_card"
        android:layout_marginStart="12dp"/>
</LinearLayout>
