<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_electronic_scale_virtual_member_statistics_tab_0"
    android:background="@color/page_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/fl_chart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toTopOf="parent">
        <com.xiaomi.fitness.chart.view.LineChartRecyclerView
            android:id="@+id/chart_recycler"
            app:displayNumbers="7"
            app:enableEndYAxisLabel="true"
            app:enableScrollToScale="true"
            app:enableStartYAxisLabel="false"
            app:enableXAxisLineCircle="true"
            app:lineColor="@color/electronic_scale_weight_chart_color"
            app:lineHighLightType="4"
            app:linePointRadius="@dimen/size_2"
            app:linePointSelectCircleStroke="true"
            app:linePointSelectRadius="@dimen/size_2"
            app:linePointSelectStrokeWidth="@dimen/size_2"
            app:lineSelectCircles="1"
            app:lineShaderBeginColor="@color/energy_shader_begin"
            app:lineShaderEndColor="@color/energy_shader_end"
            app:lineStrokeWidth="6"
            style="@style/ChartBaseStyle"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/max_min_recycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:layout_marginStart="@dimen/common_margin_start"
            android:layout_marginEnd="@dimen/common_margin_start"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/shape_data_item_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dimen_margin_26dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fl_chart">
        <TextView
            android:textSize="18sp"
            android:textColor="@color/text_color"
            android:id="@+id/tv_warm_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/electronic_scale_warm_tips"
            android:layout_marginHorizontal="34dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/fl_chart"/>
        <View
            android:background="@color/divider_line_color"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="10dp"
            android:layout_marginHorizontal="34dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/text_color_60"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp"
            android:text="@string/electronic_scale_warm_tips_desc"
            android:layout_marginStart="34dp"
            android:layout_marginEnd="34dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_warm_tips"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
