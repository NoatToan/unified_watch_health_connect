<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/device_settings_fragment_track_0"
    android:background="@color/common_page_bg_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/headerView"
        app:layout_constraintBottom_toTopOf="@+id/fl"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/device_settings_item_track_list_head"/>
    <FrameLayout
        android:id="@+id/fl"
        android:tag="binding_1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/dimen_margin_40dp"
        app:layout_constraintBottom_toTopOf="@+id/trackExport"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headerView">
        <com.xiaomi.fitness.baseui.recyclerview.MoreRecyclerView
            android:orientation="vertical"
            android:id="@+id/recycler_view"
            android:paddingTop="10dp"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <include
            android:id="@+id/emptyView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            layout="@layout/device_settings_layout_empty_view"/>
    </FrameLayout>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/common_white"
        android:gravity="center"
        android:id="@+id/trackExport"
        android:background="@drawable/selector_bottom_btn_positive_bg"
        android:layout_width="0dp"
        android:layout_height="47dp"
        android:layout_marginBottom="20dp"
        android:text="@string/device_settings_track_import_from_library"
        android:layout_marginStart="@dimen/dimen_margin_20dp"
        android:layout_marginEnd="@dimen/dimen_margin_20dp"
        app:layout_constraintBottom_toTopOf="@+id/view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <View
        android:id="@+id/view"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_margin_5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
