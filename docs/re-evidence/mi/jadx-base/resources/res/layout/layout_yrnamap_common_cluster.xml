<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/layout_yrnamap_common_cluster_0"
    android:background="@drawable/drawable_cluster_common_popup"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/icon4"
        android:padding="2dp"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginEnd="@dimen/dimen_margin_12dp"
        app:layout_constraintBottom_toBottomOf="@+id/icon3"
        app:layout_constraintEnd_toEndOf="@+id/icon3"
        app:layout_constraintTop_toTopOf="@+id/icon3"/>
    <ImageView
        android:id="@+id/icon3"
        android:padding="2dp"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginEnd="@dimen/dimen_margin_12dp"
        app:layout_constraintBottom_toBottomOf="@+id/icon2"
        app:layout_constraintEnd_toEndOf="@+id/icon2"
        app:layout_constraintTop_toTopOf="@+id/icon2"/>
    <ImageView
        android:id="@+id/icon2"
        android:padding="2dp"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginEnd="@dimen/dimen_margin_12dp"
        app:layout_constraintBottom_toBottomOf="@+id/icon1"
        app:layout_constraintEnd_toEndOf="@+id/icon1"
        app:layout_constraintTop_toTopOf="@+id/icon1"/>
    <ImageView
        android:id="@+id/icon1"
        android:padding="2dp"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginEnd="@dimen/dimen_margin_12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/icon_more"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="@dimen/dimen_margin_8dp"/>
    <ImageView
        android:id="@+id/icon_more"
        android:padding="2dp"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:src="@drawable/drawable_cluster_icon_more"
        android:layout_marginEnd="@dimen/dimen_margin_8dp"
        app:layout_constraintBottom_toBottomOf="@+id/icon1"
        app:layout_constraintEnd_toStartOf="@+id/title"
        app:layout_constraintTop_toTopOf="@+id/icon1"/>
    <TextView
        android:textColor="@color/colorPrimary"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_margin_8dp"
        android:layout_marginEnd="@dimen/dimen_margin_6dp"
        app:layout_constraintBottom_toBottomOf="@+id/icon1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/icon1"/>
</androidx.constraintlayout.widget.ConstraintLayout>
