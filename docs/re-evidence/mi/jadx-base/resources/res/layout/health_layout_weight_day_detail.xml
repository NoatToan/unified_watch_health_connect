<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:tag="layout/health_layout_weight_day_detail_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/page_padding_horizontal_large">
    <include
        android:id="@+id/health_layout_weight_body_score"
        android:visibility="gone"
        layout="@layout/health_layout_weight_body_score"/>
    <include
        android:id="@+id/health_layout_weight_focus_index"
        android:visibility="gone"
        layout="@layout/health_layout_weight_focus_index"/>
    <include
        android:id="@+id/health_layout_weight_body_composition"
        android:visibility="gone"
        layout="@layout/health_layout_weight_body_composition"/>
    <include
        android:id="@+id/health_layout_weight_control_suggest"
        android:visibility="gone"
        layout="@layout/health_layout_weight_control_suggest"/>
    <include
        android:id="@+id/health_layout_weight_index_evaluation"
        android:visibility="gone"
        layout="@layout/health_layout_weight_index_evaluation"/>
    <include
        android:id="@+id/health_layout_weight_segmental_fat"
        android:visibility="gone"
        layout="@layout/health_layout_weight_segmental"/>
    <include
        android:id="@+id/health_layout_weight_segmental_muscle"
        android:visibility="gone"
        layout="@layout/health_layout_weight_segmental"/>
    <TextView
        android:gravity="center_horizontal"
        android:id="@+id/tv_statement"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/health_weight_statement"
        android:layout_marginVertical="13.3dp"/>
    <TextView
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_download"
        android:background="@drawable/selector_bottom_btn_positive_bg"
        android:visibility="gone"
        android:layout_width="@dimen/common_btn_single_line_width"
        android:layout_height="wrap_content"
        android:text="@string/health_weight_download_report"
        android:paddingVertical="12.7dp"
        style="@style/FontMedium.16sp"/>
</LinearLayout>
