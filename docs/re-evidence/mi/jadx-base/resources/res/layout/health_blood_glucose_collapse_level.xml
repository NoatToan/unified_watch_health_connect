<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/blood_glucose_collapse_level"
    android:background="@drawable/selector_card_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/page_padding_horizontal_large">
    <include
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dimen_margin_18dp"
        layout="@layout/health_blood_glucose_agp_title"/>
    <View
        android:background="@color/common_divider_bg_color"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_0_33"
        android:layout_marginStart="@dimen/size_12"
        android:layout_marginEnd="@dimen/size_12"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/level_value"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_20dp">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/dimen_22sp"
                android:textColor="@color/text_color"
                android:id="@+id/blood_glucose_level_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dimen_margin_3dp"
                android:text="5"
                android:layout_marginStart="@dimen/dimen_margin_12dp"
                style="@style/FontDemiBold"/>
            <TextView
                android:textSize="@dimen/text_size_12"
                android:textColor="@color/text_color"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="%"
                android:layout_marginStart="@dimen/dimen_margin_2dp"
                style="@style/FontDemiBold"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/level_no_data"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textColor="@color/text_color"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_20dp"
            android:text="@string/health_blood_glucose_level_gmi_title"
            android:layout_marginHorizontal="@dimen/dimen_margin_12dp"
            style="@style/FontDemiBold.12sp"/>
        <TextView
            android:textColor="@color/text_color_40"
            android:id="@+id/health_blood_glucose_level_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/health_blood_glucose_level_description"
            android:layout_marginHorizontal="@dimen/dimen_margin_12dp"
            style="@style/FontNormal.12sp"/>
    </LinearLayout>
    <View
        android:background="@color/common_divider_bg_color"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_0_33"
        android:layout_marginTop="@dimen/margin_20dp"
        android:layout_marginStart="@dimen/size_12"
        android:layout_marginEnd="@dimen/size_12"/>
    <TextView
        android:textSize="13.33sp"
        android:textColor="@color/text_color"
        android:id="@+id/blood_glucose_level_no_data"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_20dp"
        android:layout_marginBottom="@dimen/margin_20dp"
        android:text="@string/health_blood_glucose_no_date"
        android:layout_marginHorizontal="@dimen/dimen_margin_12dp"
        style="@style/FontDemiBold.12sp"/>
    <TextView
        android:textColor="@color/text_color_40"
        android:id="@+id/health_blood_glucose_level_data"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_20dp"
        android:layout_marginBottom="@dimen/margin_20dp"
        android:text="@string/health_blood_glucose_level_description"
        android:layout_marginHorizontal="@dimen/dimen_margin_12dp"
        style="@style/FontNormal.12sp"/>
</LinearLayout>
