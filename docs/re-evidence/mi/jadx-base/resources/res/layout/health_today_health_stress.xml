<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/common_card_bg_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="@dimen/dimen_margin_6dp"
    android:paddingVertical="@dimen/margin_20dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="horizontal"
        android:id="@+id/card_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dimen_margin_20dp">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/image_view"
            android:background="@drawable/health_data_stress_square"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="17sp"
            android:layout_gravity="center_vertical"
            android:id="@+id/title_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/health_check_stress"
            android:layout_marginStart="@dimen/dimen_margin_6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/image_view"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/FontMedium"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/guide_view"
            android:background="@drawable/today_health_guide_view"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_margin_4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/title_view"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/detail_view"
            android:background="@drawable/today_health_right_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dimen_margin_10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/summary_card"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.xiaomi.fitness.chart.view.BarChartRecyclerView
                android:id="@+id/bar_recycler"
                app:barChartMaxWidth="@dimen/size_3"
                app:barChartRoundRectRadiusRatio="0.25"
                app:barChartSegment="1"
                app:chartColor="@color/stress_chart"
                app:displayNumbers="48"
                app:enableEndDayXAxis="true"
                app:enableStartYAxisLabel="false"
                style="@style/ChartBaseStyle"/>
            <com.xiaomi.fitness.view.TodayHealthDataTitleView
                android:id="@+id/dataTitleView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </FrameLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/empty_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margin_20dp">
        <TextView
            android:textSize="@dimen/font_30"
            android:id="@+id/no_value_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_16dp"
            android:text="@string/health_data_empty"
            style="@style/FontMedium"/>
        <TextView
            android:textSize="@dimen/font_14"
            android:id="@+id/no_value_des_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_2dp"
            android:text="@string/health_today_health_advice_stress_default"
            style="@style/FontMedium"/>
    </LinearLayout>
</LinearLayout>
