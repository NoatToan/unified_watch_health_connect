<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/feedback_item_dialogue_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="146dp">
    <TextView
        android:textSize="@dimen/text_size_14"
        android:textColor="@color/text_color_50"
        android:id="@+id/feedback_tv_dialogue_title"
        android:tag="binding_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_margin_8dp"
        app:layout_constraintStart_toEndOf="@+id/feedback_view_dialogue_dot"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/text_size_14"
        android:textColor="@color/text_color_50"
        android:gravity="end"
        android:id="@+id/feedback_tv_dialogue_date"
        android:tag="binding_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/feedback_tv_dialogue_title"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/text_size_14"
        android:textColor="@color/text_color"
        android:gravity="start"
        android:id="@+id/feedback_tv_dialogue_content"
        android:tag="binding_3"
        android:background="@drawable/feedback_dialogue_content_bg"
        android:padding="@dimen/dimen_margin_16dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/feedback_tv_dialogue_title"
        app:layout_constraintTop_toBottomOf="@+id/feedback_tv_dialogue_title"/>
    <View
        android:background="@color/red"
        android:layout_width="2dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/feedback_view_dialogue_dot"
        app:layout_constraintStart_toStartOf="@+id/feedback_view_dialogue_dot"
        app:layout_constraintTop_toBottomOf="@+id/feedback_view_dialogue_dot"/>
    <View
        android:id="@+id/feedback_view_dialogue_dot"
        android:background="@drawable/icon_unchecked"
        android:layout_width="@dimen/size_10"
        android:layout_height="@dimen/size_10"
        android:layout_marginTop="@dimen/dimen_margin_5dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
