<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ecg_snippet_layout"
    android:tag="layout/health_layout_ecg_snippet_0"
    android:background="@drawable/shape_card_bg_normal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/dimen_margin_12dp"
    android:paddingVertical="@dimen/dimen_margin_20dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ecg_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/dimen_margin_18dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/FontMedium.22sp"/>
        <TextView
            android:textSize="9sp"
            android:textColor="@color/blue"
            android:id="@+id/notification_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_margin_4dp"
            android:paddingHorizontal="@dimen/dimen_margin_3dp"
            app:layout_constraintBottom_toBottomOf="@+id/title"
            app:layout_constraintStart_toEndOf="@+id/title"
            app:layout_constraintTop_toTopOf="@+id/title"
            style="@style/FontRegular"/>
        <ImageView
            android:id="@+id/right_arrow"
            android:background="@drawable/ic_base_right_arrow_icon"
            android:layout_width="@dimen/dimen_margin_30dp"
            android:layout_height="@dimen/dimen_margin_30dp"
            app:layout_constraintBottom_toBottomOf="@+id/title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/title"/>
        <TextView
            android:id="@+id/remind_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dimen_margin_6dp"
            app:layout_constraintBottom_toBottomOf="@+id/right_arrow"
            app:layout_constraintEnd_toStartOf="@+id/right_arrow"
            app:layout_constraintTop_toTopOf="@+id/right_arrow"
            style="@style/FontRegular.12sp"/>
        <RadioButton
            android:id="@+id/radio_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:button="@null"
            android:drawableEnd="@drawable/selector_check"
            app:layout_constraintBottom_toBottomOf="@+id/title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/title"/>
        <TextView
            android:textColor="@color/text_color_40"
            android:id="@+id/description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="@+id/title"
            app:layout_constraintTop_toBottomOf="@+id/title"
            style="@style/FontRegular.12sp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.xiaomi.fitness.health.ecg.view.EcgCombineView
        android:id="@+id/ecg_snippet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_20dp"
        android:paddingStart="@dimen/dimen_margin_20dp"
        android:paddingEnd="@dimen/dimen_margin_20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ecg_detail"
        app:ratioSpeed="0"/>
</androidx.constraintlayout.widget.ConstraintLayout>
