<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:tag="layout/access_activity_alipay_thirdparty_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/alipayIconView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:src="@drawable/ic_access_alipay_icon"
        android:layout_centerHorizontal="true"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/unBindContainnerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_below="@+id/alipayIconView"
        android:paddingHorizontal="@dimen/page_content_padding_horizontal_large">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/access_black"
            android:id="@+id/alipayNameView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/access_thirdparty_alipay"/>
        <com.xiaomi.fitness.widget.view.DividerView
            android:id="@+id/dividerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="50dp"
            android:layout_marginEnd="20dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/access_black"
            android:layout_gravity="center_horizontal"
            android:id="@+id/alipayDescView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="@string/access_thirdparty_aplipay_thirdparty_desc"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/bindContainnerView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:layout_below="@+id/alipayIconView">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/access_black"
            android:gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/access_thirdparty_alipay_bind_success_title"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/access_black"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/access_thirdparty_alipay_bind_success_desc"
            android:layout_marginHorizontal="@dimen/page_content_padding_horizontal_large"/>
    </LinearLayout>
    <TextView
        android:id="@+id/bindView"
        android:layout_marginBottom="20dp"
        android:text="@string/access_thirdparty_alipay_bind"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        style="@style/Button.FullWidth.Menstrual.Orange"/>
</RelativeLayout>
