<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iconView"
        android:tag="layout/health_curse_reset_card_view_0"
        android:layout_width="@dimen/dimen_margin_20dp"
        android:layout_height="@dimen/dimen_margin_20dp"
        android:src="@drawable/health_curse_setting_banner_icon"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/curse_color"
        android:id="@+id/titleView"
        android:tag="layout/health_curse_reset_card_view_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/health_women_predict_result_ready"
        android:fontFamily="@font/misanslatin_bold"
        android:layout_marginStart="@dimen/dimen_margin_14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iconView"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginStart="0dp"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/curse_color"
        android:id="@+id/arrowTitleView"
        android:tag="layout/health_curse_reset_card_view_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/health_woman_intelligent_predict_adjust"
        android:fontFamily="@font/misanslatin_bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/rightArrowView"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/rightArrowView"
        android:tag="layout/health_curse_reset_card_view_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_pink_arrow"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</merge>
