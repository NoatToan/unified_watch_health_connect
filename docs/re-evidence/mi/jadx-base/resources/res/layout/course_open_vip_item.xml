<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/course_open_vip_item_0"
    android:layout_width="wrap_content"
    android:layout_height="114dp">
    <View
        android:id="@+id/view_open_vip_type_bg"
        android:background="@color/rectangle_orange"
        android:layout_width="98dp"
        android:layout_height="106dp"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_open_vip_tag"
        android:background="@drawable/course_open_vip_tag_bg"
        android:layout_width="56dp"
        android:layout_height="20dp"
        android:text="首单特惠"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/text_color"
        android:id="@+id/tv_open_vip_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="月卡"
        app:layout_constraintEnd_toEndOf="@+id/view_open_vip_type_bg"
        app:layout_constraintStart_toStartOf="@+id/view_open_vip_type_bg"
        app:layout_constraintTop_toTopOf="@+id/view_open_vip_type_bg"/>
    <TextView
        android:textSize="23sp"
        android:textStyle="bold"
        android:textColor="@color/colorPrimary"
        android:id="@+id/tv_open_vip_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="￥9"
        app:layout_constraintEnd_toEndOf="@+id/view_open_vip_type_bg"
        app:layout_constraintStart_toStartOf="@+id/view_open_vip_type_bg"
        app:layout_constraintTop_toBottomOf="@+id/tv_open_vip_name"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/text_color"
        android:id="@+id/tv_open_vip_price_old"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="¥15"
        app:layout_constraintEnd_toEndOf="@+id/view_open_vip_type_bg"
        app:layout_constraintStart_toStartOf="@+id/view_open_vip_type_bg"
        app:layout_constraintTop_toBottomOf="@+id/tv_open_vip_price"/>
</androidx.constraintlayout.widget.ConstraintLayout>
