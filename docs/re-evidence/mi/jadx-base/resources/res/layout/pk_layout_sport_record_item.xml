<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:tag="layout/pk_layout_sport_record_item_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="@color/pk_process_sport_record_date_color"
        android:id="@+id/date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24.67dp"/>
    <RelativeLayout
        android:id="@+id/sport_record_content"
        android:layout_width="match_parent"
        android:layout_height="66.67dp"
        android:layout_below="@+id/date">
        <View
            android:id="@+id/upper_vertical_line"
            android:background="@color/pk_detail_sport_record_point_bg"
            android:layout_width="0.33dp"
            android:layout_height="35dp"
            android:layout_alignParentTop="true"
            android:layout_marginStart="33dp"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/dot"
            android:background="@drawable/ic_pk_detail_sport_record_gray_point"
            android:layout_width="@dimen/dimen_margin_5dp"
            android:layout_height="@dimen/dimen_margin_5dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="31dp"/>
        <View
            android:id="@+id/lower_vertical_line"
            android:background="@color/pk_detail_sport_record_point_bg"
            android:layout_width="0.33dp"
            android:layout_height="35dp"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="33dp"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/sport_type_logo"
            android:layout_width="@dimen/dimen_round_33.33dp"
            android:layout_height="@dimen/dimen_round_33.33dp"
            android:layout_marginTop="18.33dp"
            android:layout_marginBottom="18.33dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="58dp"/>
        <View
            android:id="@+id/horizontal_guideline"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="@dimen/dimen_14sp"
            android:textColor="@color/text_color"
            android:id="@+id/sport_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:translationY="-10dp"
            android:layout_marginStart="10dp"
            android:layout_toEndOf="@+id/sport_type_logo"
            style="@style/FontMedium.14sp"/>
        <TextView
            android:textSize="@dimen/dimen_12sp"
            android:textColor="@color/text_color_40"
            android:id="@+id/value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:translationY="@dimen/size_10"
            android:layout_marginStart="@dimen/dimen_margin_10dp"
            android:layout_toEndOf="@+id/sport_type_logo"
            style="@style/FontLatinRegular"/>
    </RelativeLayout>
</RelativeLayout>
