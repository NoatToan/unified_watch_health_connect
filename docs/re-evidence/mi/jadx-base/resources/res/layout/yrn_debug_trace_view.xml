<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#ffffff"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/yrn_trace_close"
        android:background="#66cccc"
        android:padding="8dp"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="45dp"
        android:layout_height="wrap_content"
        android:text="关闭"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/yrn_trace_clear"
        android:background="#7ec0ee"
        android:padding="8dp"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="45dp"
        android:layout_height="wrap_content"
        android:text="清空"
        android:layout_marginEnd="4dp"
        android:layout_toStartOf="@+id/yrn_trace_close"/>
    <TextView
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/yrn_trace_save"
        android:background="#cc9966"
        android:padding="8dp"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="45dp"
        android:layout_height="wrap_content"
        android:text="保存"
        android:layout_marginEnd="4dp"
        android:layout_toStartOf="@+id/yrn_trace_clear"/>
    <TextView
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/yrn_trace_move"
        android:background="#ff6699"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="按下移动"
        android:layout_marginEnd="4dp"
        android:layout_toStartOf="@+id/yrn_trace_save"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="bold"
        android:id="@+id/yrn_trace_save_path"
        android:background="#cc9966"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/yrn_trace_move"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/yrn_trace_recyclerView"
        android:background="#eeeeee"
        android:padding="5dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/yrn_trace_save_path"/>
</RelativeLayout>
