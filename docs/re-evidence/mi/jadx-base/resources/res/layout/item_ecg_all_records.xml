<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:background="@drawable/selector_card_bg"
    android:paddingTop="@dimen/size_17_3"
    android:paddingBottom="@dimen/size_17_3"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/page_content_padding_horizontal_large">
    <TextView
        android:textColor="@color/text_color"
        android:gravity="start"
        android:layout_gravity="center_vertical"
        android:id="@+id/tv_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="@dimen/size_120"
        style="@style/FontMedium.14sp"/>
    <TextView
        android:textSize="@dimen/font_9"
        android:textColor="#f22424"
        android:layout_gravity="center_vertical"
        android:id="@+id/tv_high_result"
        android:background="@drawable/shape_evaluation_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/health_n60_to_be_interpreted"
        android:layout_marginStart="@dimen/dimen_margin_2dp"/>
    <TextView
        android:textColor="@color/text_color_40"
        android:gravity="end"
        android:layout_gravity="center_vertical"
        android:id="@+id/tv_record_time"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        style="@style/FontRegular.12sp"/>
    <TextView
        android:layout_gravity="center"
        android:id="@+id/arrow_icon"
        android:background="@drawable/ic_base_right_arrow_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</LinearLayout>
