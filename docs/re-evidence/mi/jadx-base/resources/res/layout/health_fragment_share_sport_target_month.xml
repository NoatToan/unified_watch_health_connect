<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/health_fragment_share_sport_target_month_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:paddingBottom="100dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/page_content_padding_horizontal_large">
        <androidx.cardview.widget.CardView
            android:id="@+id/bgContainnerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardPreventCornerOverlap="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/bgView"
                android:paddingBottom="9dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.xiaomi.fitness.health.threetarget.view.ShareAccountInfoView
                    android:id="@+id/accountInfoView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="23dp"
                    android:layout_marginStart="22dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <LinearLayout
                    android:gravity="bottom"
                    android:orientation="horizontal"
                    android:id="@+id/caluliContainerView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="23dp"
                    app:layout_constraintStart_toStartOf="@+id/accountInfoView"
                    app:layout_constraintTop_toBottomOf="@+id/accountInfoView">
                    <TextView
                        android:textSize="33sp"
                        android:textColor="@color/white"
                        android:id="@+id/kaluliView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/FontMedium"/>
                    <TextView
                        android:textColor="@color/white"
                        android:id="@+id/kaluliUnitView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        style="@style/FontMedium.16sp"/>
                </LinearLayout>
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/white_90"
                    android:id="@+id/caluliDetailView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/dimen_margin_22dp"
                    app:layout_constraintTop_toBottomOf="@+id/caluliContainerView"/>
                <LinearLayout
                    android:gravity="bottom"
                    android:orientation="horizontal"
                    android:id="@+id/stepContainerView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="23dp"
                    app:layout_constraintStart_toStartOf="@+id/caluliDetailView"
                    app:layout_constraintTop_toBottomOf="@+id/caluliDetailView">
                    <TextView
                        android:textSize="33sp"
                        android:textColor="@color/white"
                        android:gravity="bottom"
                        android:id="@+id/stepView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/FontMedium"/>
                    <TextView
                        android:textColor="@color/white"
                        android:id="@+id/stepUnitView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        style="@style/FontMedium.16sp"/>
                </LinearLayout>
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/white_90"
                    android:id="@+id/stepDetailView"
                    android:layout_width="155dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@+id/stepContainerView"
                    app:layout_constraintTop_toBottomOf="@+id/stepContainerView"/>
                <TextView
                    android:textSize="16.7sp"
                    android:textColor="@color/white"
                    android:id="@+id/reachDayNumView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="22dp"
                    app:layout_constraintBottom_toBottomOf="@+id/stepContainerView"
                    app:layout_constraintEnd_toEndOf="parent"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/white_90"
                    android:gravity="end"
                    android:id="@+id/reachView"
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="22dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/stepDetailView"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@drawable/health_share_sport_target_month_bg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginHorizontal="7dp"
                    android:paddingHorizontal="9dp"
                    android:paddingVertical="15dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/stepDetailView">
                    <com.xiaomi.fitness.baseui.calendar.view.WeekBar
                        android:id="@+id/weekView"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/size_30"
                        app:isNeedWeek="true"
                        app:layout_scrollFlags="scroll"
                        app:weekBarTextColor="@color/black"
                        app:weekBarTextSize="@dimen/font_12"/>
                    <com.xiaomi.fitness.baseui.calendar.view.DayThreeCircleFiveLineCalendarView
                        android:id="@+id/monthCalendarView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:calendarTxtFontRes="@font/misanslatin_semibold"
                        app:hollowCircleColor="#0099ff"
                        app:hollowCircleStroke="1.5dp"
                        app:isShowOtherMonthDate="false"
                        app:layout_scrollFlags="scroll"
                        app:selectCircleColor="@color/text_color"
                        app:selectCircleRadius="20dp"
                        app:solarSelectTextColor="#fe6528"
                        app:solarTextColor="@color/black"
                        app:solarTextSize="@dimen/dimen_14sp"
                        app:todayBgColor="@color/health_calendar_today_bg"
                        app:todaySolarSelectTextColor="#fe6528"
                        app:todaySolarTextColor="@color/black"
                        app:todayWeekBgColor="@color/common_transparent"/>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
    </androidx.core.widget.NestedScrollView>
    <include
        android:id="@+id/bottomView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        layout="@layout/health_view_share_bottom_operation_view"/>
</RelativeLayout>
