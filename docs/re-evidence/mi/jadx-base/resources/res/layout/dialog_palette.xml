<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/palette_shadow"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="15sp"
        android:textColor="#ff000000"
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:text="@string/face_palette"/>
    <com.xiaomi.fitness.watch.face.view.PaletteView
        android:id="@+id/paletteView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <com.xiaomi.fitness.widget.view.DividerView
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="45dp"
        app:layout_constraintTop_toBottomOf="@+id/paletteView"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#ff000000"
        android:gravity="center"
        android:id="@+id/cancelView"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:text="@string/cancel"
        app:layout_constraintEnd_toStartOf="@+id/ml_alertdialog_button1_line"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider"/>
    <com.xiaomi.fitness.widget.view.DividerView
        android:id="@+id/ml_alertdialog_button1_line"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        app:isHorizontal="true"
        app:layout_constraintEnd_toStartOf="@+id/okView"
        app:layout_constraintStart_toEndOf="@+id/cancelView"
        app:layout_constraintTop_toBottomOf="@+id/divider"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#ff000000"
        android:gravity="center"
        android:id="@+id/okView"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:text="@string/confirm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ml_alertdialog_button1_line"
        app:layout_constraintTop_toBottomOf="@+id/divider"/>
</androidx.constraintlayout.widget.ConstraintLayout>
