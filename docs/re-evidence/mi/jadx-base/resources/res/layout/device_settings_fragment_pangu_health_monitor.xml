<?xml version="1.0" encoding="utf-8"?>
<miuix.springback.view.SpringBackLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/device_settings_fragment_pangu_health_monitor_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:scrollableView="@+id/spring_back_target">
    <miuix.core.widget.NestedScrollView
        android:id="@+id/spring_back_target"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:tag="binding_1"
            android:paddingTop="@dimen/device_settings_list_padding_top"
            android:paddingBottom="30dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include
                android:id="@+id/endurance_layout"
                layout="@layout/layout_endurance_pangu"/>
            <TextView
                android:textColor="@color/text_color_50"
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="33dp"
                android:layout_marginTop="8dp"
                android:text="@string/device_settings_detection_title_heart_rate"
                android:textDirection="locale"
                android:paddingStart="@dimen/margin_27dp"
                android:paddingEnd="0dp"
                style="@style/FontRegular.12sp"/>
            <com.xiaomi.fitness.widget.RightArrowTwoLineTextView
                android:id="@+id/heartView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:subtitle="@string/device_settings_detection_heart_rate_des"
                app:title="@string/device_settings_detection_heart_rate"/>
            <com.xiaomi.fitness.widget.RightArrowTwoLineTextView
                android:id="@+id/high_warning_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:subtitle="@string/device_settings_detection_heart_rate_warning_des2"
                app:title="@string/device_settings_detection_heart_rate_warning"/>
            <com.xiaomi.fitness.widget.SwitchButtonTwoLineTextView
                android:id="@+id/activityDetectionView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:subtitle="@string/device_settings_detection_activity_des"
                app:title="@string/device_settings_detection_activity"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/heart_healthy_detection_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.xiaomi.fitness.widget.view.DividerView style="@style/SettingDivider"/>
                <TextView
                    android:textColor="@color/text_color_50"
                    android:gravity="center_vertical"
                    android:layout_width="match_parent"
                    android:layout_height="33dp"
                    android:text="@string/device_settings_detection_title_abnormal_heart_beat"
                    android:textDirection="locale"
                    android:paddingStart="@dimen/margin_27dp"
                    android:paddingEnd="0dp"
                    style="@style/FontRegular.12sp"/>
                <com.xiaomi.fitness.widget.SwitchButtonTwoLineTextView
                    android:id="@+id/heartHealthyDetectionView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:subtitle="@string/device_settings_detection_heart_healthy_des"
                    app:title="@string/device_settings_detection_heart_healthy"/>
            </LinearLayout>
            <com.xiaomi.fitness.widget.view.DividerView style="@style/SettingDivider"/>
            <TextView
                android:textColor="@color/text_color_50"
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="33dp"
                android:text="@string/device_settings_detection_title_sleep"
                android:textDirection="locale"
                android:paddingStart="@dimen/margin_27dp"
                android:paddingEnd="0dp"
                style="@style/FontRegular.12sp"/>
            <com.xiaomi.fitness.widget.SwitchButtonTwoLineTextView
                android:id="@+id/sleep_aids_detection_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:subtitle="@string/device_settings_detection_sleep_aids_des"
                app:title="@string/device_settings_detection_sleep_aids"/>
            <com.xiaomi.fitness.widget.SwitchButtonTwoLineTextView
                android:id="@+id/sleep_breath_quality_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:subtitle="@string/device_settings_detection_sleep_respiration_des"
                app:title="@string/device_settings_detection_sleep_respiration"/>
            <com.xiaomi.fitness.widget.view.DividerView style="@style/SettingDivider"/>
            <TextView
                android:textColor="@color/text_color_50"
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="33dp"
                android:text="@string/device_settings_detection_title_pressure"
                android:textDirection="locale"
                android:paddingStart="@dimen/margin_27dp"
                android:paddingEnd="0dp"
                style="@style/FontRegular.12sp"/>
            <com.xiaomi.fitness.widget.SwitchButtonTwoLineTextView
                android:id="@+id/pressure_detection_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:subtitle="@string/device_settings_detection_pressure_des"
                app:title="@string/device_settings_detection_pressure"/>
        </LinearLayout>
    </miuix.core.widget.NestedScrollView>
</miuix.springback.view.SpringBackLayout>
