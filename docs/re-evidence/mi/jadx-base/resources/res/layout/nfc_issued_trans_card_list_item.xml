<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/issued_trans_card_list_iv_bg"
            android:layout_width="@dimen/nfc_trade_alert_card_image_width"
            android:layout_height="@dimen/nfc_trade_alert_card_image_height"
            android:scaleType="fitCenter"/>
        <View
            android:layout_gravity="center"
            android:id="@+id/issued_trans_card_list_iv_mask_bg"
            android:background="@drawable/nfc_invalid_card_mask"
            android:visibility="gone"
            android:layout_width="@dimen/nfc_trade_alert_card_image_width"
            android:layout_height="@dimen/nfc_trade_alert_card_image_height"/>
    </FrameLayout>
    <LinearLayout
        android:id="@+id/issued_trans_card_list_ll_card_name_container"
        android:duplicateParentState="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/nfc_issued_card_list_item_name_margin_top"
        android:layout_marginStart="@dimen/nfc_issued_card_list_item_name_margin_left">
        <TextView
            android:textSize="@dimen/nfc_issued_card_list_item_name_text_size"
            android:textColor="@color/nfc_card_list_content_selector"
            android:id="@+id/issued_trans_card_list_tv_card_name"
            android:paddingBottom="@dimen/nfc_issued_card_list_item_name_padding_bottom"
            android:duplicateParentState="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:shadowColor="@color/nfc_issued_trans_card_list_text_shadow_color"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="1"
            android:paddingStart="@dimen/nfc_issued_card_list_item_name_padding_left"/>
    </LinearLayout>
</RelativeLayout>
