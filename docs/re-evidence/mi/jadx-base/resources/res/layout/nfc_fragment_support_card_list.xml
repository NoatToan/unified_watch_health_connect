<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/nfc_fragment_support_card_list_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/masterCardView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.xiaomi.fitness.nfc.widget.BankCardView
            android:id="@+id/bankCardView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.xiaomi.fitness.nfc.widget.DeviceImageView
            android:id="@+id/deviceView2"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_marginTop="85dp"
            android:scaleType="fitXY"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/text_color_60"
        android:gravity="center"
        android:id="@+id/tipsView"
        android:paddingLeft="@dimen/common_title_left_margin"
        android:paddingRight="@dimen/common_title_left_margin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/nfc_master_support_tips"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/masterCardView"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/unionCardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="73dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/posView"
            android:layout_width="140dp"
            android:layout_height="284dp"
            android:src="@drawable/nfc_union_card_pos"
            android:scaleType="fitXY"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.xiaomi.fitness.nfc.widget.DeviceImageView
            android:id="@+id/deviceView"
            android:layout_width="166dp"
            android:layout_height="166dp"
            android:layout_marginTop="67dp"
            android:layout_marginStart="58dp"
            app:layout_constraintStart_toStartOf="@+id/posView"
            app:layout_constraintTop_toTopOf="@+id/posView"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <include
        android:id="@+id/bottomView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/nfc_common_layout_padding"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        layout="@layout/nfc_union_card_support_card_bottom"/>
</androidx.constraintlayout.widget.ConstraintLayout>
