<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/access_wechat_device_0"
    android:background="@color/access_common_page_bg_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/page_content_padding_horizontal_large">
    <com.xiaomi.fitness.widget.RightArrowBindingTwoLineTextView
        android:layout_gravity="center"
        android:id="@+id/deviceView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_16dp"
        app:showBackground="false"
        app:subtitle="@string/access_add_device_to_wechat_desc"
        app:title="@string/access_add_device_to_wechat"/>
    <com.xiaomi.fitness.widget.RightArrowBindingTwoLineTextView
        android:layout_gravity="center"
        android:id="@+id/wechatView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_6dp"
        app:layout_constraintTop_toBottomOf="@+id/deviceView"
        app:remindText=" "
        app:showBackground="false"
        app:showRemind="true"
        app:subtitle="@string/access_upload_step_to_wechat_desc"
        app:title="@string/access_upload_step_to_wechat"/>
</androidx.constraintlayout.widget.ConstraintLayout>
