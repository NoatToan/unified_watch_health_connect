<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/nfc_selector_list_item"
    android:paddingTop="15dp"
    android:paddingBottom="15dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/iconView"
        android:layout_width="70dp"
        android:layout_height="44dp"/>
    <TextView
        android:textStyle="bold"
        android:id="@+id/nameView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:includeFontPadding="true"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        style="@style/nfc_TextAppearance.List.Primary"/>
    <TextView
        android:textSize="@dimen/nfc_card_list_item_description_text_size"
        android:textColor="@color/nfc_card_list_desc"
        android:gravity="end"
        android:layout_gravity="center_vertical"
        android:id="@+id/descView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="@dimen/nfc_card_list_item_description_max_width"/>
    <ImageView
        android:layout_gravity="end|center_vertical"
        android:id="@+id/arrowView"
        android:duplicateParentState="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_base_right_arrow_icon"/>
</LinearLayout>
