<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/media_music_song_list_content"
    android:tag="layout/device_settings_music_settings_song_list_item_0"
    android:paddingTop="@dimen/dimen_margin_15dp"
    android:paddingBottom="@dimen/dimen_margin_15dp"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/page_content_padding_horizontal_large"
    android:paddingEnd="@dimen/page_content_padding_horizontal_large">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/media_music_song_list_icon"
        android:layout_width="@dimen/dimen_margin_30dp"
        android:layout_height="@dimen/margin_27dp"
        android:src="@drawable/device_settings_music_song_list_icon"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/dimen_16sp"
        android:textColor="@color/text_color"
        android:id="@+id/songlist_name_tv"
        android:tag="binding_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_marginStart="@dimen/dimen_margin_20dp"
        app:layout_constraintEnd_toStartOf="@+id/songlist_more"
        app:layout_constraintStart_toEndOf="@+id/media_music_song_list_icon"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/size_12"
        android:textColor="@color/text_color_40"
        android:id="@+id/songlist_num_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@+id/songlist_name_tv"
        app:layout_constraintTop_toBottomOf="@+id/songlist_name_tv"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/songlist_more"
        android:background="@drawable/icon_more"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
