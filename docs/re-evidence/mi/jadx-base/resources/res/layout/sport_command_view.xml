<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:tag="layout/sport_command_view_0"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/frameLayout_right"
        android:layout_width="120dp"
        android:layout_height="120dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/finish_ring_progress_bg"
            android:background="@drawable/ic_bg_ring_4_white"
            android:visibility="gone"
            android:layout_width="100dp"
            android:layout_height="100dp"/>
        <com.xiaomi.fitness.sport.view.widget.CircularProgressLayout
            android:layout_gravity="center"
            android:id="@+id/finish_circle_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cpl_backgroundColor="@color/sport_color_white"
            app:cpl_colorSchemeColors="@color/color_ff612e"
            app:cpl_strokeWidth="6dp">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/finish_sport_action"
                android:background="@drawable/ic_bg_circle_ff612e"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:scaleType="center"
                android:contentDescription="@string/sport_finish"/>
        </com.xiaomi.fitness.sport.view.widget.CircularProgressLayout>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/frameLayout_left"
        android:layout_width="120dp"
        android:layout_height="120dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.xiaomi.fitness.sport.view.widget.CircularProgressLayout
            android:layout_gravity="center"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cpl_backgroundColor="@color/sport_color_white"
            app:cpl_colorSchemeColors="@color/color_ff612e"
            app:cpl_strokeWidth="6dp">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/sport_action_img"
                android:background="@drawable/ic_bg_circle_1eca96"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:scaleType="center"/>
        </com.xiaomi.fitness.sport.view.widget.CircularProgressLayout>
    </FrameLayout>
    <ImageView
        android:id="@+id/sport_lock"
        android:background="@drawable/sport_lock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="45dp"
        android:layout_marginEnd="@dimen/margin_15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/frameLayout_left"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/center_lock"
        android:visibility="gone"
        android:layout_width="120dp"
        android:layout_height="120dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.xiaomi.fitness.sport.view.widget.CircularProgressLayout
            android:layout_gravity="center"
            android:id="@+id/lock_circle_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cpl_backgroundColor="@color/sport_color_white"
            app:cpl_colorSchemeColors="@color/color_1ECA96"
            app:cpl_strokeWidth="6dp">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/center_lock_img"
                android:background="@drawable/ic_bg_circle_1eca96"
                android:layout_width="91dp"
                android:layout_height="91dp"
                android:src="@drawable/ic_lock_ffffff"
                android:scaleType="center"/>
        </com.xiaomi.fitness.sport.view.widget.CircularProgressLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
