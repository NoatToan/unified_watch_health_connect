<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.cardview.widget.CardView
        android:id="@+id/card_view"
        android:background="@drawable/shape_card_bg_pressed"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:cardBackgroundColor="@color/transparent"
        app:cardCornerRadius="8dp"
        app:cardElevation="@dimen/dimen_margin_0dp"
        app:layout_constraintDimensionRatio="w,9:16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/mask_iv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textColor="@color/white"
                android:id="@+id/app_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_15dp"
                android:text="@string/app_name"
                android:drawablePadding="4dp"
                android:layout_marginStart="@dimen/dimen_margin_13dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/qr_code_bg"
                android:background="@drawable/trail_shape_qr_code_bg"
                android:visibility="gone"
                android:layout_width="@dimen/dimen_margin_30dp"
                android:layout_height="@dimen/dimen_margin_30dp"
                android:layout_marginTop="@dimen/dimen_margin_13dp"
                android:layout_marginEnd="@dimen/dimen_margin_13dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/qr_code"
                android:layout_width="30.3dp"
                android:layout_height="30.3dp"
                android:contentDescription="qr code"
                app:layout_constraintBottom_toBottomOf="@+id/qr_code_bg"
                app:layout_constraintEnd_toEndOf="@+id/qr_code_bg"
                app:layout_constraintStart_toStartOf="@+id/qr_code_bg"
                app:layout_constraintTop_toTopOf="@+id/qr_code_bg"/>
            <FrameLayout
                android:id="@+id/sticker_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_constraintBottom_toTopOf="@+id/sport_algo_source_left"
                app:layout_constraintStart_toStartOf="parent"/>
            <com.xiaomi.fitness.detail.view.SportShareSloganView
                android:id="@+id/share_slogan_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.xiaomi.fitness.detail.view.SportShareBasicInfoView
                android:id="@+id/base_info_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toTopOf="@+id/sport_algo_source_left"
                app:layout_constraintStart_toStartOf="parent"/>
            <TextView
                android:textColor="@color/white"
                android:id="@+id/app_name_bottom"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_15dp"
                android:text="@string/app_name"
                android:drawablePadding="4dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="7sp"
                android:textColor="@color/white"
                android:id="@+id/sport_algo_source_center"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dimen_margin_15dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                style="@style/FontMedium"/>
            <View
                android:id="@+id/sport_algo_source_left"
                android:background="@color/white_30"
                android:layout_width="match_parent"
                android:layout_height="0.3dp"
                android:layout_marginBottom="@dimen/dimen_margin_9dp"
                android:layout_marginHorizontal="@dimen/dimen_margin_20dp"
                app:layout_constraintBottom_toTopOf="@+id/sport_algo_source_left_txt"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <TextView
                android:textSize="7sp"
                android:textColor="@color/white"
                android:id="@+id/sport_algo_source_left_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dimen_margin_10dp"
                android:layout_marginStart="@dimen/dimen_margin_20dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                style="@style/FontMedium"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
