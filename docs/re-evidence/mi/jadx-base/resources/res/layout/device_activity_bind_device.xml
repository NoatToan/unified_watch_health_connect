<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:tag="layout/device_activity_bind_device_0"
    android:background="@color/page_white_bg"
    android:paddingBottom="6.67dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/page_content_padding_horizontal_large">
    <ScrollView
        android:id="@+id/device_sv_bind_process"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:layout_constraintBottom_toTopOf="@+id/device_tv_bind_fail_tip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/bind_device_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.xiaomi.fitness.ubox.export.DeviceIconView
                android:layout_gravity="center_horizontal"
                android:id="@+id/deviceView"
                android:layout_width="@dimen/dimen_margin_270dp"
                android:layout_height="@dimen/dimen_margin_270dp"
                android:layout_marginTop="50dp"
                android:layout_marginBottom="@dimen/dimen_margin_50dp"
                app:isCurrentDevice="false"
                app:type="0"/>
            <TextView
                android:textSize="@dimen/dimen_18sp"
                android:textStyle="bold"
                android:textColor="@color/device_text_color_black"
                android:id="@+id/deviceNameView"
                android:tag="binding_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_20dp"/>
            <TextView
                android:textSize="@dimen/dimen_14sp"
                android:textColor="@color/device_sub_text_color_black"
                android:id="@+id/descView"
                android:tag="binding_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_10dp"/>
        </LinearLayout>
    </ScrollView>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_margin_20dp">
        <TextView
            android:textSize="@dimen/text_size_13"
            android:textColor="@color/red"
            android:id="@+id/device_tv_bind_fail_tip"
            android:tag="binding_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"/>
        <CheckBox
            android:gravity="center_vertical"
            android:id="@+id/silentUpdateCheckBoxView"
            android:tag="binding_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:button="@drawable/selector_check"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="@dimen/text_size_13"
            android:textColor="@color/text_color_60"
            android:gravity="start"
            android:id="@+id/silentUpdateTipView"
            android:tag="binding_5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/device_silent_upgrade_tips"
            android:layout_centerVertical="true"
            android:layout_marginStart="5dp"
            android:layout_toEndOf="@+id/silentUpdateCheckBoxView"/>
    </RelativeLayout>
    <TextView
        android:id="@+id/device_tv_bind_btn"
        android:tag="binding_6"
        android:layout_marginBottom="@dimen/dimen_margin_20dp"
        android:text="@string/device_retry"
        style="@style/BaseButton.Positive"/>
    <TextView
        android:id="@+id/tv_finish"
        android:visibility="gone"
        android:layout_marginBottom="@dimen/dimen_margin_20dp"
        android:text="@string/common_continue"
        android:layout_marginStart="@dimen/dimen_margin_0dp"
        android:layout_marginEnd="@dimen/dimen_margin_0dp"
        app:layout_constraintBottom_toTopOf="@+id/device_tv_bind_other"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/BaseButton.Positive"/>
    <TextView
        android:textColor="@color/device_link_color"
        android:gravity="bottom"
        android:autoLink="all"
        android:id="@+id/device_tv_bind_other"
        android:tag="binding_7"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_margin_20dp"
        android:text="@string/device_bind_other_des"
        style="@style/FontMedium.12sp"/>
</LinearLayout>
