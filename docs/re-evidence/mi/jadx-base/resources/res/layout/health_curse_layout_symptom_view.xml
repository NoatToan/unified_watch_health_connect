<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:gravity="start"
        android:id="@+id/typeView"
        android:tag="layout/health_curse_layout_symptom_view_0"
        android:text="@string/health_curse_hurt"
        android:textDirection="locale"
        style="@style/HealthCurseSymptomType"/>
    <RadioGroup
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/radioGroup"
        android:tag="layout/health_curse_layout_symptom_view_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <RadioButton
            android:id="@+id/little"
            android:checked="false"
            style="@style/HealthSymptomValue"/>
        <RadioButton
            android:id="@+id/middle"
            style="@style/HealthSymptomValue"/>
        <RadioButton
            android:id="@+id/bad"
            android:layout_marginEnd="0dp"
            style="@style/HealthSymptomValue"/>
    </RadioGroup>
</merge>
