<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingTop="@dimen/dimen_margin_10dp"
    android:paddingBottom="@dimen/dimen_margin_20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/device_settings_aod_setting_off"
        android:paddingTop="@dimen/dimen_margin_13dp"
        android:paddingBottom="@dimen/dimen_margin_13dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/page_content_padding_horizontal_large"
        android:paddingEnd="@dimen/page_content_padding_horizontal_large">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="16sp"
            android:textColor="@color/text_color"
            android:id="@+id/device_settings_aod_setting_off_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/device_settings_aod_setting_off"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/device_settings_aod_setting_off_icon"
            android:background="@drawable/device_settings_ic_dialog_checked"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/device_settings_aod_setting_smart_on"
        android:paddingTop="@dimen/dimen_margin_13dp"
        android:paddingBottom="@dimen/dimen_margin_13dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/page_content_padding_horizontal_large"
        android:paddingEnd="@dimen/page_content_padding_horizontal_large">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="16sp"
            android:textColor="@color/text_color"
            android:id="@+id/device_settings_aod_setting_smart_on_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/device_settings_aod_setting_smart_on"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="13sp"
            android:textColor="@color/text_color_40"
            android:id="@+id/device_settings_aod_setting_smart_on_des"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/device_settings_aod_setting_smart_on_des"
            android:layout_marginEnd="@dimen/dimen_margin_50dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/device_settings_aod_setting_smart_on_text"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/device_settings_aod_setting_smart_on_icon"
            android:background="@drawable/device_settings_ic_dialog_checked"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/device_settings_aod_setting_custom"
        android:paddingTop="@dimen/dimen_margin_13dp"
        android:paddingBottom="@dimen/dimen_margin_13dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/page_content_padding_horizontal_large"
        android:paddingEnd="@dimen/page_content_padding_horizontal_large">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="16sp"
            android:textColor="@color/text_color"
            android:id="@+id/device_settings_aod_setting_custom_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/device_settings_aod_setting_custom"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/device_settings_aod_setting_custom_icon"
            android:background="@drawable/device_settings_ic_dialog_checked"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.appcompat.widget.LinearLayoutCompat>
