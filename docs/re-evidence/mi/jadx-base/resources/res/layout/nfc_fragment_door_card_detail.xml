<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutView"
    android:tag="layout/nfc_fragment_door_card_detail_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/nfc_common_title_left_margin"
    android:paddingEnd="@dimen/nfc_common_title_left_margin">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:paddingTop="@dimen/nfc_common_content_miui_title_margin"
                android:paddingBottom="@dimen/nfc_tsm_watch_icon_padding_bottom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.xiaomi.fitness.nfc.widget.DeviceImageView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/deviceView"
                    android:layout_width="@dimen/nfc_device_icon_width"
                    android:layout_height="@dimen/nfc_device_icon_height"/>
                <com.xiaomi.fitness.nfc.widget.InnerCardImageView
                    android:id="@+id/cardView"
                    android:layout_width="86.4dp"
                    android:layout_height="48.6dp"/>
            </FrameLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/door3View"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_color"
                    android:id="@+id/notReadyTitleView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nfc_nfc3_data_not_ready"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/selector_feature_item_remind_text_color"
                    android:id="@+id/notReadydescView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="200dp"
                    android:text="@string/nfc_nfc3_data_not_ready_detail_desc"
                    app:layout_constraintStart_toStartOf="@+id/notReadyTitleView"
                    app:layout_constraintTop_toBottomOf="@+id/notReadyTitleView"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/colorPrimary"
                    android:id="@+id/verifyView"
                    android:background="@drawable/nfc_btn_bg"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nfc_verify_card"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <View
                android:background="@color/common_divider_color"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginTop="20dp"/>
            <com.xiaomi.fitness.widget.RightArrowSingleLineTextView
                android:id="@+id/renameView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:title="@string/nfc_nextpay_door_card_edit_card_name"/>
            <com.xiaomi.fitness.nfc.widget.CardSwitcherView
                android:id="@+id/cardSwitchView"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:id="@+id/problemView"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/nfc_issued_card_list_detail_item_height"
                android:paddingStart="@dimen/nfc_common_title_left_margin"
                android:paddingEnd="@dimen/nfc_common_title_left_margin">
                <TextView
                    android:textColor="@color/setting_item_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/nfc_card_detail_more_settings_help"
                    android:includeFontPadding="false"
                    android:layout_weight="1"
                    style="@style/FontMedium.16sp"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_base_right_arrow_icon"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:id="@+id/milockHelpView"
                android:background="@drawable/selector_white"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/nfc_issued_card_list_detail_item_height">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:textColor="@color/text_color"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/nfc_card_milock_activate_help_title"
                        android:includeFontPadding="false"
                        style="@style/FontMedium.16sp"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/text_color_40"
                        android:id="@+id/milock_activate_help_msg_tv"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/nfc_card_milock_status_no_activate_msg"
                        style="@style/nfc_TextAppearance.List.Primary"/>
                </LinearLayout>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_base_right_arrow_icon"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:paddingBottom="@dimen/nfc_common_content_miui_title_margin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <TextView
            android:id="@+id/defaultView"
            android:visibility="gone"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="0dp"
            android:text="@string/nfc_set_default_card"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp"
            style="@style/CommonBtn.Normal"/>
        <TextView
            android:id="@+id/removeBackupView"
            android:visibility="gone"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="0dp"
            android:text="@string/nfc_backup_door_delete_from_server"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp"
            style="@style/CommonBtn.Normal"/>
        <TextView
            android:id="@+id/removeView"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="0dp"
            android:text="@string/nfc_remove_door_card"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp"
            style="@style/CommonBtn.Normal"/>
    </LinearLayout>
</RelativeLayout>
