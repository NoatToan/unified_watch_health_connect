<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/layout_sleep_rhythm_calendar_record_0"
    android:background="@drawable/selector_card_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:paddingVertical="20dp">
    <TextView
        android:textSize="24sp"
        android:textColor="@color/text_color"
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/health_common_today"
        android:layout_marginHorizontal="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/FontRegular"/>
    <TextView
        android:textColor="@color/text_color_40"
        android:id="@+id/tvSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        app:layout_constraintStart_toStartOf="@+id/tvTitle"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
        style="@style/FontRegular.14sp"/>
    <com.xiaomi.fitness.widget.view.DividerView
        android:id="@+id/dividerFirst"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginHorizontal="20dp"
        app:layout_constraintTop_toBottomOf="@+id/tvSubtitle"/>
    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/indicatorContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="20dp"
        app:flexDirection="row"
        app:flexWrap="wrap"
        app:justifyContent="space_between"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dividerFirst"
        app:showDividerVertical="middle">
        <com.xiaomi.fitness.health.sleep.rhythm.view.SleepRhythmIndicatorView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:healthIndicatorIconFirst="@drawable/ic_sleep_rhythm_recorded"
            app:healthIndicatorTitle="@string/health_sleep_rhythm_data_recorded"/>
        <com.xiaomi.fitness.health.sleep.rhythm.view.SleepRhythmIndicatorView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:healthIndicatorIconFirst="@drawable/ic_sleep_no_recorded"
            app:healthIndicatorTitle="@string/health_sleep_rhythm_data_not_recorded"/>
        <com.xiaomi.fitness.health.sleep.rhythm.view.SleepRhythmIndicatorView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:healthIndicatorIconFirst="@drawable/ic_sleep_journal_recorded"
            app:healthIndicatorIconSecond="@drawable/ic_sleep_journal_and_rhythm_recorded"
            app:healthIndicatorTitle="@string/health_sleep_rhythm_journal_recorded"/>
    </com.google.android.flexbox.FlexboxLayout>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/datePager"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@+id/indicatorContainer"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="horizontal"
        android:id="@+id/llRecordJournal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/datePager">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/health_ic_sleep_journal_daily"/>
        <TextView
            android:textColor="#7a6eff"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/health_sleep_rhythm_journal_record"
            style="@style/FontRegular.14sp"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/health_ic_sleep_journal_jump"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <com.xiaomi.fitness.widget.view.DividerView
        android:id="@+id/dividerBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@+id/llRecordJournal"/>
    <TextView
        android:textColor="@color/text_color"
        android:id="@+id/tv_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/health_sleep_rhythm_monitoring"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="@dimen/size_8"
        app:layout_constraintBottom_toBottomOf="@+id/actionView"
        app:layout_constraintEnd_toStartOf="@+id/actionView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/actionView"
        style="@style/FontMedium.16sp"/>
    <TextView
        android:textColor="@color/health_sleep_purple_main_color"
        android:gravity="center"
        android:id="@+id/actionView"
        android:background="@drawable/health_sleep_rhythm_action_shape"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:maxWidth="260dp"
        android:text="@string/health_sleep_rhythm_monitoring_ended"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginEnd="20dp"
        android:paddingVertical="@dimen/size_5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_label"
        app:layout_constraintTop_toBottomOf="@+id/dividerBottom"
        style="@style/FontMedium.14sp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
