<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/face_layout_search_result_item_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/dimen_margin_20dp">
    <com.xiaomi.fitness.watch.face.view.FaceImageView
        android:layout_gravity="center"
        android:id="@+id/mImageView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/dimen_13sp"
        android:textColor="@color/face_common_text"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/mNameView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:maxLines="1"
        app:layout_constraintTop_toBottomOf="@+id/mImageView"
        style="@style/FontDemiBold"/>
    <TextView
        android:textSize="@dimen/dimen_11sp"
        android:textColor="@color/footer_desc"
        android:gravity="center_horizontal"
        android:id="@+id/mStateView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_4dp"
        android:text="@string/face_me_can_edit"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mNameView"
        style="@style/FontNormal"/>
    <View
        android:id="@+id/empty_view"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_margin_10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mStateView"/>
</androidx.constraintlayout.widget.ConstraintLayout>
