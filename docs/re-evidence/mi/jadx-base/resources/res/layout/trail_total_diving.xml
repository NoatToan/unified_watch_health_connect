<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:tag="layout/trail_total_diving_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="@dimen/dimen_margin_40dp"
    android:layout_marginHorizontal="@dimen/page_padding_horizontal_large">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/layout_diving"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:tag="binding_1"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <include
                android:id="@+id/diving_statistics_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                layout="@layout/trail_total_diving_statistics_card"/>
            <TextView
                android:textColor="@color/trail_item_year"
                android:id="@+id/diving_journal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_20dp"
                android:text="@string/trail_diving_journal"
                android:layout_marginStart="@dimen/page_extra_padding_horizontal_large"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/diving_recycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
