<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/item_sport_share_data_bottom_view_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dimen_margin_15dp"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/dimen_margin_18dp">
        <com.xiaomi.fitness.widget.view.RoundImageView
            android:id="@+id/header"
            android:background="@drawable/header_default_icon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginEnd="18dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            app:layout_constraintBottom_toBottomOf="@+id/header"
            app:layout_constraintStart_toEndOf="@+id/header"
            app:layout_constraintTop_toTopOf="@+id/header">
            <TextView
                android:textSize="@dimen/font_11"
                android:textColor="@color/white"
                android:layout_gravity="center_vertical"
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/misanslatin_semibold"
                android:layout_marginEnd="18dp"/>
            <TextView
                android:textSize="@dimen/font_9_33"
                android:textColor="@color/white_80"
                android:layout_gravity="center_vertical"
                android:id="@+id/sportNameTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/misanslatin_medium"/>
        </LinearLayout>
        <com.xiaomi.fitness.share.view.ShareRoutineView
            android:id="@+id/routineView"
            android:layout_width="82dp"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/dimen_margin_10dp"
            android:layout_marginStart="@dimen/dimen_margin_20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
        <com.xiaomi.fitness.detail.view.ShareTrackLineView
            android:id="@+id/shareLineView"
            android:layout_width="82dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/dimen_margin_15dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/shape_card_bg_normal_lower_round"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="@dimen/dimen_margin_18dp">
        <TextView
            android:textSize="28sp"
            android:textColor="@color/black"
            android:id="@+id/mainValueTxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_2dp"
            android:layout_marginBottom="@dimen/dimen_margin_10dp"
            android:fontFamily="@font/misanslatin_semibold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/dimen_19sp"
            android:textColor="@color/black"
            android:id="@+id/unitText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/misanslatin_semibold"
            app:layout_constraintBaseline_toBaselineOf="@+id/mainValueTxt"
            app:layout_constraintBottom_toBottomOf="@+id/mainValueTxt"
            app:layout_constraintStart_toEndOf="@+id/mainValueTxt"/>
        <TextView
            android:textSize="7sp"
            android:textColor="@color/black"
            android:id="@+id/sport_algo_source_left_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-5dp"
            android:layout_marginBottom="@dimen/dimen_margin_18dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/mainValueTxt"
            style="@style/FontMedium"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/dataView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dimen_margin_3dp"
            android:layout_marginStart="@dimen/margin_10dp"
            app:layout_constraintBottom_toBottomOf="@+id/mainValueTxt"
            app:layout_constraintEnd_toEndOf="parent">
            <TextView
                android:textSize="@dimen/dimen_18sp"
                android:textColor="@color/black"
                android:id="@+id/dataText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/misanslatin_semibold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <TextView
                android:textSize="@dimen/dimen_18sp"
                android:textColor="@color/black"
                android:id="@+id/dataUnitText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/misanslatin_semibold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/dataText"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:textSize="@dimen/dimen_11sp"
            android:textColor="@color/black_40"
            android:id="@+id/dataTitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/misanslatin_medium"
            app:layout_constraintBottom_toTopOf="@+id/dataView"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
