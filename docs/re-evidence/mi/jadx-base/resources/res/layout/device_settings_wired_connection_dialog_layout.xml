<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/device_settings_wired_connection_dialog_layout_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/page_content_padding_horizontal_large">
    <TextView
        android:textSize="@dimen/dimen_16sp"
        android:textColor="@color/text_color"
        android:id="@+id/permission_content_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/offline_map_permission_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/text_color_40"
        android:gravity="center_horizontal"
        android:id="@+id/guide_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/device_settings_check_guide"
        app:layout_constraintTop_toBottomOf="@+id/permission_content_tv"/>
</androidx.constraintlayout.widget.ConstraintLayout>
