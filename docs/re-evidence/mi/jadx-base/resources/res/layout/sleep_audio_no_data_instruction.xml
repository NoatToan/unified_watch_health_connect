<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:background="@drawable/sleep_audio_instruction_shape_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginEnd="5dp"
        android:paddingHorizontal="14.67dp"
        android:paddingVertical="10.3dp">
        <TextView
            android:textSize="13sp"
            android:textColor="@color/health_selected_color"
            android:id="@+id/title_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dimen_margin_3dp"
            android:text="@string/health_sleep_audio_no_data_title"
            style="@style/FontMedium"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/health_selected_color"
            android:id="@+id/instruction_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/health_sleep_audio_no_record_data_title_desc"
            style="@style/FontRegular"/>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/close_instruction"
        android:background="@drawable/ic_sleep_audio_instruction_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_alignParentTop="true"
        android:layout_marginEnd="11.33dp"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
