<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sleepInterfereReportSummaryCardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/common_card_bg_color"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/sleepInterfereReportSummaryContentLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginVertical="20dp">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/titleLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/leftComponentInTitleLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="15sp"
                    android:textColor="@color/text_color"
                    android:id="@+id/finishRecordTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/health_sleep_interfere_finish_clock_in_title"
                    android:textFontWeight="380"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="52sp"
                    android:textColor="@color/text_color"
                    android:id="@+id/completedDaysTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>
            <LinearLayout
                android:gravity="end"
                android:orientation="vertical"
                android:id="@+id/rightComponentInTitleLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.xiaomi.fitness.widget.view.RoundImageView
                    android:id="@+id/userImageView"
                    android:layout_width="36dp"
                    android:layout_height="36dp"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="12sp"
                    android:textColor="@color/text_color_40"
                    android:id="@+id/userNameTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="12sp"
                    android:textColor="@color/text_color_40"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/health_sleep_interfere_title"/>
            </LinearLayout>
        </LinearLayout>
        <View
            android:id="@+id/divide_line1"
            android:background="@color/divider_line_color"
            android:layout_width="match_parent"
            android:layout_height="0.37dp"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/summaryCardRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
