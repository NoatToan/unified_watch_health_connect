<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/health_hearing_environmental_noise_0"
    android:background="@color/health_sleep_breath_quality_bg_color"
    android:scrollbars="none"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="never">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/page_padding_horizontal_large">
        <TextView
            android:textSize="@dimen/font_13"
            android:textColor="@color/text_color_60"
            android:id="@+id/hearing_environmental_noise_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_25"
            android:layout_marginBottom="@dimen/size_30"
            android:text="@string/health_hearing_environmental_noise_description"
            android:paddingHorizontal="@dimen/page_extra_padding_horizontal_large"/>
        <RelativeLayout
            android:id="@+id/environmental_noise_list_card"
            android:background="@drawable/shape_card_bg_normal"
            android:paddingTop="@dimen/size_17_67"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/hearing_environmental_noise_description"
            app:cardCornerRadius="@dimen/size_10">
            <ImageView
                android:id="@+id/icon"
                android:layout_width="@dimen/size_30"
                android:layout_height="@dimen/size_30"
                android:src="@drawable/ic_health_hearing_volume"
                android:layout_marginStart="@dimen/size_18"/>
            <TextView
                android:textSize="@dimen/font_14"
                android:textColor="@color/text_color"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/health_hearing_environmental_noise_too_high_title"
                android:layout_marginStart="@dimen/size_18"
                android:layout_toEndOf="@+id/icon"/>
            <TextView
                android:textColor="@color/text_color_60"
                android:id="@+id/subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/health_hearing_only_for_reference"
                android:layout_below="@+id/title"
                android:layout_marginStart="@dimen/size_18"
                android:layout_toEndOf="@+id/icon"/>
            <View
                android:id="@+id/divider"
                android:background="@color/text_color_10"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginTop="@dimen/size_17_67"
                android:layout_below="@+id/subtitle"
                android:layout_marginHorizontal="@dimen/size_18"/>
            <TextView
                android:textColor="@color/text_color_40"
                android:id="@+id/date"
                android:paddingLeft="@dimen/size_18"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_8"
                android:text="2月16日"
                android:layout_below="@+id/divider"
                android:layout_marginStart="@dimen/size_8"/>
            <miuix.recyclerview.widget.RecyclerView
                android:id="@+id/noise_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/date"/>
        </RelativeLayout>
    </RelativeLayout>
</androidx.core.widget.NestedScrollView>
