<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/course_series_info_head_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_series_pic"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="31sp"
        android:textColor="@color/text_color"
        android:ellipsize="end"
        android:id="@+id/tv_series_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:paddingHorizontal="@dimen/dimen_margin_26dp"/>
    <TextView
        android:textSize="@dimen/dimen_13sp"
        android:textColor="@color/text_color_60"
        android:id="@+id/des"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textAlignment="viewStart"
        android:paddingHorizontal="@dimen/dimen_margin_26dp"/>
    <com.xiaomi.fitness.widget.expandable.ExpandableTextView
        android:textColor="@color/text_color_50"
        android:id="@+id/tv_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textAlignment="viewStart"
        android:paddingHorizontal="@dimen/dimen_margin_26dp"
        app:expandLines="2"
        app:expandTextColor="@color/text_color"/>
    <View
        android:background="@color/text_color_10"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginHorizontal="@dimen/dimen_margin_26dp"
        android:layout_marginVertical="@dimen/dimen_margin_20dp"/>
</LinearLayout>
