<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/fragment_pai_day_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.xiaomi.fitness.chart.view.BarChartRecyclerView
            android:id="@+id/pai_recycler"
            android:paddingTop="@dimen/size_70"
            android:layout_height="311dp"
            app:barChartMaxWidth="@dimen/size_10"
            app:chartColor="@color/fitness_pai_chart"
            app:contentPaddingBottom="@dimen/size_41_3"
            app:displayNumbers="7"
            app:enableStartYAxisLabel="false"
            style="@style/ChartBaseStyle"/>
        <com.xiaomi.fitness.view.DataTitleView
            android:id="@+id/dataTitleView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <com.xiaomi.fitness.health.pai.view.PaiProgressView
        android:id="@+id/paiProgress"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size_12"
        android:layout_marginHorizontal="@dimen/health_detail_page_common_margin_horizontal"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_pai_hrm"
        android:background="@drawable/shape_data_item_bg"
        android:paddingBottom="@dimen/size_30"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size_12"
        android:layout_marginHorizontal="@dimen/health_detail_page_common_margin_horizontal">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center_vertical"
                android:background="@drawable/ic_health_pai_hrm_chart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_20"
                android:layout_marginBottom="@dimen/size_20"
                android:importantForAccessibility="no"
                android:layout_marginStart="@dimen/size_18"/>
            <TextView
                android:textColor="@color/text_color"
                android:gravity="start"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_today_pai_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="@dimen/size_10"
                android:layout_marginStart="@dimen/size_10"
                style="@style/FontMedium.14sp"/>
        </LinearLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.xiaomi.fitness.chart.view.BarChartRecyclerView
                android:id="@+id/rateRecycler"
                android:paddingStart="@dimen/size_19"
                app:barChartRoundRectRadiusRatio="0.5"
                app:barChartSegment="1"
                app:chartColor="@color/fitness_pai_chart"
                app:displayNumbers="48"
                app:enableEndDayXAxis="true"
                app:enableStartYAxisLabel="false"
                app:rateChartDarkColor="@color/fitness_pai_chart"
                style="@style/ChartBaseStyle"/>
            <com.xiaomi.fitness.view.DataTitleView
                android:id="@+id/hrmDataTitleView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/health_card_data_title_margin_start"/>
        </FrameLayout>
        <com.xiaomi.fitness.health.pai.view.PaiLimitGridView
            android:id="@+id/paiLimitGridView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/layout_open_hr_check"
        android:background="@drawable/selector_card_bg"
        android:paddingTop="@dimen/size_20"
        android:paddingBottom="@dimen/size_20"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size_12"
        android:layout_marginHorizontal="@dimen/health_detail_page_common_margin_horizontal">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_icon"
            android:background="@drawable/ic_health_pai_hrm_open"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:layout_marginStart="@dimen/size_18"/>
        <TextView
            android:textColor="@color/text_color"
            android:gravity="start"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/health_pai_open_hr_check_txt"
            android:layout_weight="1"
            android:paddingEnd="@dimen/size_10"
            android:layout_marginStart="@dimen/size_10"
            style="@style/FontMedium.14sp"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_feature_item_more"
            android:background="@drawable/ic_base_right_arrow_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/size_20"/>
    </LinearLayout>
    <com.xiaomi.fitness.common.devicelist.SportsDeviceListView
        android:id="@+id/deviceListView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-12dp"
        android:layout_marginBottom="@dimen/size_12"
        android:layout_marginHorizontal="@dimen/health_detail_page_common_margin_horizontal"/>
    <com.xiaomi.fitness.view.CardUnderstandView
        android:id="@+id/understandCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size_12"
        android:layout_marginHorizontal="@dimen/health_detail_page_common_margin_horizontal"
        app:txtUnderstand="@string/health_pai_understand"/>
</LinearLayout>
