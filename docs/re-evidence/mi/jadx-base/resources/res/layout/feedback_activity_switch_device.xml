<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:tag="layout/feedback_activity_switch_device_0"
    android:background="@color/feedback_device_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/page_padding_horizontal_large">
    <miuix.core.widget.NestedScrollView
        android:id="@+id/spring_back_target"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <miuix.recyclerview.widget.RecyclerView
            android:orientation="vertical"
            android:id="@+id/feedback_rv_device_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </miuix.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
