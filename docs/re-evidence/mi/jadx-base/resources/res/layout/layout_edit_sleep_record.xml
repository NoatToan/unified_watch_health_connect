<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/layout_edit_sleep_record_0"
    android:background="@color/health_common_edit_card_bg_color"
    android:paddingTop="@dimen/size_20"
    android:paddingBottom="@dimen/size_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/size_19">
    <TextView
        android:textSize="@dimen/font_12_67"
        android:textColor="@color/health_common_edit_title_text_color"
        android:ellipsize="end"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="入睡时间"
        android:maxLines="2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/time_and_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_50dp"
        android:layout_marginBottom="@dimen/dimen_margin_16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title">
        <TextView
            android:textSize="@dimen/font_29_3"
            android:id="@+id/HHmmTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="@dimen/size_11"
            app:layout_constraintEnd_toStartOf="@+id/tv_date"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/font_13_3"
            android:textColor="@color/health_common_edit_unit_text_color"
            android:ellipsize="end"
            android:id="@+id/tv_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5/16"
            android:maxLines="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="@dimen/dimen_margin_20dp"
            app:layout_constraintBaseline_toBaselineOf="@+id/HHmmTime"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
