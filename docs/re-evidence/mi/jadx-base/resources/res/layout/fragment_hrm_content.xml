<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingBottom="@dimen/health_detail_page_common_margin_vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="@dimen/health_detail_page_common_margin_horizontal">
        <com.xiaomi.fitness.widget.view.CardStyleSetView
            android:id="@+id/hrm_phone_record"
            android:background="@drawable/selector_card_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/health_detail_page_common_margin_vertical"
            app:card_left_image="@drawable/sport_data_rate_manual_record"
            app:card_title="@string/health_hrm_phone_record"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_rate_detail"
            android:background="@drawable/shape_data_item_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/health_detail_page_common_margin_vertical"
            android:overScrollMode="never"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_rate_exception_record"
            android:background="@drawable/shape_data_item_bg"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/health_detail_page_common_margin_vertical"
            android:overScrollMode="never"/>
        <com.xiaomi.fitness.widget.view.CardStyleSetView
            android:id="@+id/hrm_fibrillation"
            android:background="@drawable/selector_card_bg"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/health_detail_page_common_margin_vertical"
            app:card_left_image="@drawable/health_ic_data_exception"
            app:card_rightValue="@string/health_hrm_fibrillation_none"
            app:card_title="@string/health_hrm_fibrillation"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_rate_distribute"
            android:background="@drawable/shape_data_item_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/health_detail_page_common_margin_vertical"
            android:overScrollMode="never"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_rate_manual"
            android:background="@drawable/shape_data_item_bg"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/health_detail_page_common_margin_vertical"
            android:overScrollMode="never"/>
        <com.xiaomi.fitness.view.CardUnderstandView
            android:id="@+id/understandCard"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/health_detail_page_common_margin_vertical"
            app:txtUnderstand="@string/health_hrm_understand"/>
    </LinearLayout>
</LinearLayout>
