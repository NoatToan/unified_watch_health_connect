<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/login_region_activity_select_list_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <EditText
        android:textSize="14sp"
        android:textColor="@color/login_black"
        android:textColorHint="@color/login_common_hint_txt_color"
        android:gravity="center_vertical"
        android:id="@+id/country_key_edt"
        android:background="@drawable/login_shape_search_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/login_region_select_input_item_height"
        android:layout_marginTop="@dimen/login_common_content_miui_title_margin"
        android:drawablePadding="9dp"
        android:inputType="text"
        android:drawableStart="@drawable/ic_search"
        android:textDirection="locale"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginStart="@dimen/page_padding_horizontal_large"
        android:layout_marginEnd="@dimen/page_padding_horizontal_large"/>
    <TextView
        android:textSize="15.33sp"
        android:textColor="@color/login_black"
        android:gravity="center_vertical"
        android:id="@+id/country_recommend_name_tv"
        android:layout_width="wrap_content"
        android:layout_height="53.3dp"
        android:layout_marginTop="12dp"
        android:text="@string/login_region_auto_getting"
        android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
        android:layout_marginEnd="@dimen/page_content_padding_horizontal_large"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/login_grey_color"
        android:layout_gravity="center_vertical"
        android:id="@+id/country_change_tip_tv"
        android:paddingTop="8dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/login_region_change_des"
        android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
        android:layout_marginEnd="@dimen/login_region_select_page_margin"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/dimen_margin_10dp">
        <TextView
            android:textSize="@dimen/font_12"
            android:textColor="@color/login_grey_color"
            android:gravity="center_vertical"
            android:id="@+id/country_label_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_common_all"
            android:layout_alignParentTop="true"
            android:layout_marginStart="@dimen/page_content_padding_horizontal_large"/>
        <androidx.recyclerview.widget.RecyclerView
            android:orientation="vertical"
            android:id="@+id/country_recycleView"
            android:tag="binding_1"
            android:background="@color/login_page_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_10dp"
            android:layout_below="@+id/country_label_tv"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:reverseLayout="false"
            app:spanCount="1"/>
        <com.xiaomi.fitness.login.widget.QuickIndexView
            android:id="@+id/country_indexView"
            android:layout_width="@dimen/login_region_select_index_view_width"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_8dp"
            android:layout_marginEnd="@dimen/page_padding_horizontal_large"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</LinearLayout>
