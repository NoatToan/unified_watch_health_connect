<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/layoutView"
    android:tag="layout/nfc_fragment_card_return_user_info_0"
    android:paddingTop="@dimen/nfc_size_22"
    android:paddingBottom="@dimen/nfc_size_26_7"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/page_content_padding_horizontal_large"
    android:paddingEnd="@dimen/page_content_padding_horizontal_large">
    <com.xiaomi.fitness.nfc.widget.InfoInputEditTextView
        android:id="@+id/nameView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/nfc_size_19"
        app:nfc_iet_hint_text="@string/nfc_retrun_card_user_info_hint"
        app:nfc_iet_text_length="50"
        app:nfc_iet_title_text="@string/nfc_retrun_card_user_info_name"/>
    <com.xiaomi.fitness.nfc.widget.InfoInputEditTextView
        android:id="@+id/alipayAccountView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/nfc_size_19"
        app:nfc_iet_hint_text="@string/nfc_retrun_card_user_info_alipay_account_hint"
        app:nfc_iet_title_text="@string/nfc_retrun_card_user_info_alipay_account"/>
    <com.xiaomi.fitness.nfc.widget.InfoInputEditTextView
        android:id="@+id/phoneView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/nfc_size_19"
        android:inputType="phone"
        app:nfc_iet_hint_text="@string/nfc_retrun_card_user_info_phone_num_hint"
        app:nfc_iet_text_length="11"
        app:nfc_iet_title_text="@string/nfc_retrun_card_user_info_phone_num"/>
    <View
        android:id="@+id/view_line"
        android:background="@color/black_10_transparent"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nfc_size_0_33"
        android:layout_marginTop="@dimen/nfc_size_15"
        android:layout_marginBottom="@dimen/nfc_size_15"/>
    <TextView
        android:textSize="@dimen/nfc_font_14"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/nfc_retrun_card_user_info_attention_title"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/nfc_size_8_3"
        android:text="@string/nfc_retrun_card_user_info_attention_desc"/>
    <View
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <TextView
        android:enabled="false"
        android:id="@+id/confirmView"
        android:layout_marginTop="@dimen/size_10"
        android:layout_marginBottom="@dimen/nfc_size_26_7"
        android:text="@string/nfc_retrun_card_user_info_btn_title"
        style="@style/BaseButton.Positive"/>
</LinearLayout>
