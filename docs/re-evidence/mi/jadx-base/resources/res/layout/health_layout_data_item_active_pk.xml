<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:background="@drawable/shape_card_bg_normal"
    android:layout_width="match_parent"
    android:layout_height="59.33dp"
    android:layout_marginHorizontal="@dimen/page_padding_horizontal_large">
    <ImageView
        android:id="@+id/icon"
        android:background="@drawable/ic_pk_orange_logo"
        android:layout_width="33.33dp"
        android:layout_height="33.33dp"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/dimen_margin_18dp"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textSize="@dimen/dimen_16sp"
        android:textColor="@color/text_color"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/pk_title"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/size_10"
        android:layout_toEndOf="@+id/icon"
        style="@style/FontMedium"/>
    <RelativeLayout
        android:id="@+id/players"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_toStartOf="@+id/arrow">
        <RelativeLayout
            android:id="@+id/my_avatar_view"
            android:layout_width="@dimen/dimen_margin_30dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6.33dp"
            android:layout_alignParentEnd="true">
            <com.xiaomi.fitness.widget.view.RoundImageView
                android:id="@+id/my_avatar"
                android:background="@drawable/ic_pk_avatar_default"
                android:layout_width="@dimen/dimen_margin_30dp"
                android:layout_height="@dimen/dimen_margin_30dp"
                android:layout_centerInParent="true"
                android:layout_alignParentEnd="true"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/my_leading_crown"
                android:layout_width="14.67dp"
                android:layout_height="14.67dp"
                android:layout_above="@+id/my_avatar"
                android:layout_centerHorizontal="true"
                android:translationY="@dimen/dimen_margin_6dp"
                app:srcCompat="@drawable/ic_pk_leading_crown"/>
        </RelativeLayout>
        <TextView
            android:textSize="14.67sp"
            android:id="@+id/vs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/health_vs"
            android:layout_centerVertical="true"
            android:layout_marginStart="6.33dp"
            android:layout_toStartOf="@+id/my_avatar_view"
            style="@style/FontMedium"/>
        <RelativeLayout
            android:id="@+id/opponent_avatar_view"
            android:layout_width="@dimen/dimen_margin_30dp"
            android:layout_height="match_parent"
            android:layout_toStartOf="@+id/vs">
            <com.xiaomi.fitness.widget.view.RoundImageView
                android:id="@+id/left_opponent"
                android:background="@drawable/ic_pk_avatar_default"
                android:layout_width="@dimen/dimen_margin_30dp"
                android:layout_height="@dimen/dimen_margin_30dp"
                android:layout_centerInParent="true"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/opponent_leading_crown"
                android:layout_width="14.67dp"
                android:layout_height="14.67dp"
                android:layout_above="@+id/left_opponent"
                android:layout_centerHorizontal="true"
                android:translationY="@dimen/dimen_margin_6dp"
                app:srcCompat="@drawable/ic_pk_leading_crown"/>
        </RelativeLayout>
    </RelativeLayout>
    <ImageView
        android:id="@+id/arrow"
        android:background="@drawable/ic_right_arrow_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/dimen_margin_18dp"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
