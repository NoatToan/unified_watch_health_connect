<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_app_upgrade_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:orientation="vertical"
        android:id="@+id/ll_fail_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/dimen_margin_26dp"
        android:paddingEnd="@dimen/dimen_margin_26dp">
        <ImageView
            android:id="@+id/iv_error_img"
            android:paddingTop="@dimen/dimen_margin_200dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/app_upgrade_icon_fail"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="@dimen/dimen_14sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_10dp"
            android:text="@string/app_upgrade_load_fail"
            android:layout_below="@+id/iv_error_img"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:id="@+id/tv_retry"
            android:layout_width="match_parent"
            android:layout_marginBottom="@dimen/dimen_margin_26dp"
            android:text="@string/app_upgrade_load_retry"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginStart="@dimen/dimen_margin_0dp"
            android:layout_marginEnd="@dimen/dimen_margin_0dp"
            style="@style/CommonBtn.Primary"/>
    </RelativeLayout>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/ll_version_info"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/dimen_margin_26dp"
        android:paddingEnd="@dimen/dimen_margin_26dp">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/iv_details_img"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/app_upgrade_found_new_version"/>
        <TextView
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_version_desc"
            android:paddingTop="@dimen/dimen_margin_20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/FontDemiBold.20sp"/>
        <TextView
            android:textSize="@dimen/dimen_14sp"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_version"
            android:paddingTop="@dimen/dimen_margin_4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <com.xiaomi.fitness.widget.view.DividerView
            android:id="@+id/deviderView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_30dp"/>
        <TextView
            android:textSize="@dimen/dimen_14sp"
            android:id="@+id/tv_release_note_title"
            android:paddingTop="@dimen/dimen_margin_30dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/FontDemiBold.14sp"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/dimen_margin_10dp">
            <ScrollView
                android:id="@+id/layout_note"
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="@dimen/dimen_margin_26dp"
                android:layout_above="@+id/tv_action_btn">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/dimen_14sp"
                        android:id="@+id/tv_release_note_in_page_one"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </ScrollView>
            <TextView
                android:id="@+id/tv_action_btn"
                android:layout_width="match_parent"
                android:layout_marginBottom="@dimen/dimen_margin_26dp"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:layout_marginStart="@dimen/dimen_margin_0dp"
                android:layout_marginEnd="@dimen/dimen_margin_0dp"
                style="@style/CommonBtn.Primary"/>
        </RelativeLayout>
    </LinearLayout>
</FrameLayout>
