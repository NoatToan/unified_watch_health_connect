<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/course_info_detail_header_portrait_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.xiaomi.fitness.widget.view.RatioImageView
        android:id="@+id/post_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="parent"
        app:ratio="1.679"
        app:shapeAppearance="@style/CourseInfo"/>
    <androidx.cardview.widget.CardView
        android:id="@+id/card_video"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:elevation="0dp"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/post_view"
        app:layout_constraintEnd_toEndOf="@+id/post_view"
        app:layout_constraintStart_toStartOf="@+id/post_view"
        app:layout_constraintTop_toTopOf="@+id/post_view">
        <SurfaceView
            android:layout_gravity="center"
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <View
            android:id="@+id/view_mask"
            android:background="@color/black_30"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </androidx.cardview.widget.CardView>
    <ImageView
        android:id="@+id/iv_pre_stop"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/course_icon_pre_stop"
        app:layout_constraintBottom_toBottomOf="@+id/post_view"
        app:layout_constraintEnd_toStartOf="@+id/iv_pre_play"
        app:layout_constraintStart_toStartOf="@+id/post_view"
        app:layout_constraintTop_toTopOf="@+id/post_view"/>
    <ImageView
        android:id="@+id/iv_pre_play"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/course_icon_pre_play"
        android:contentDescription="@string/course_video_play"
        app:layout_constraintBottom_toBottomOf="@+id/post_view"
        app:layout_constraintEnd_toEndOf="@+id/post_view"
        app:layout_constraintStart_toEndOf="@+id/iv_pre_stop"
        app:layout_constraintTop_toTopOf="@+id/post_view"/>
    <TextView
        android:textSize="11sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_pre_play_hint"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="33dp"
        android:text="试看1分钟"
        android:paddingHorizontal="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/post_view"
        app:layout_constraintEnd_toEndOf="@+id/post_view"
        app:layout_constraintStart_toStartOf="@+id/post_view"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_course_tag"
        android:visibility="gone"
        android:layout_width="37dp"
        android:layout_height="19dp"
        android:layout_margin="12dp"
        android:text="限免"
        app:layout_constraintStart_toStartOf="@+id/post_view"
        app:layout_constraintTop_toTopOf="@+id/post_view"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/white"
        android:id="@+id/tv_course_pre_current_time"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:text="00:27"
        app:layout_constraintBottom_toBottomOf="@+id/post_view"
        app:layout_constraintStart_toStartOf="@+id/post_view"/>
    <ProgressBar
        android:id="@+id/pb_course_pre"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="4.5dp"
        android:progressDrawable="@drawable/course_pre_pb"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_course_pre_current_time"
        app:layout_constraintEnd_toStartOf="@+id/tv_course_pre_total_time"
        app:layout_constraintStart_toEndOf="@+id/tv_course_pre_current_time"
        app:layout_constraintTop_toTopOf="@+id/tv_course_pre_current_time"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/white"
        android:id="@+id/tv_course_pre_total_time"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:text="00:27"
        app:layout_constraintBottom_toBottomOf="@+id/post_view"
        app:layout_constraintEnd_toEndOf="@+id/post_view"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="horizontal"
        android:id="@+id/triple_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_22dp"
        android:weightSum="3"
        app:layout_constraintTop_toBottomOf="@+id/post_view">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/difficulty_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:translationX="-10dp">
            <TextView
                android:gravity="start"
                android:id="@+id/difficulty_label_view"
                android:text="@string/course_difficult"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/CourseInfoLabel"/>
            <TextView
                android:id="@+id/difficulty_value_view"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_chainStyle="spread_inside"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/difficulty_label_view"
                style="@style/CourseInfoValue"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/consume_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:id="@+id/consume_label_view"
                android:text="@string/course_share_calorie_desc"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/CourseInfoLabel"/>
            <TextView
                android:id="@+id/consume_value_view"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/consume_label_view"
                style="@style/CourseInfoValue"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/time_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:translationX="@dimen/dimen_margin_10dp">
            <TextView
                android:id="@+id/time_label_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/course_time"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/CourseInfoLabel"/>
            <TextView
                android:id="@+id/time_value_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_5dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/time_label_view"
                style="@style/CourseInfoValue"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <com.xiaomi.fitness.widget.expandable.ExpandableTextView
        android:textSize="12sp"
        android:textColor="@color/course_info_desc"
        android:id="@+id/desc_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="23dp"
        android:lineSpacingExtra="4dp"
        app:expandLines="2"
        app:expandTextColor="@color/course_black"
        app:layout_constraintTop_toBottomOf="@+id/triple_group"/>
</androidx.constraintlayout.widget.ConstraintLayout>
