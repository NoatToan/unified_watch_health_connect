<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:id="@+id/layoutView"
    android:tag="layout/nfc_fragment_transfer_out_intro_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/page_content_padding_horizontal_large"
    android:paddingEnd="@dimen/common_set_margin_start">
    <FrameLayout
        android:id="@+id/watch_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/nfc_tsm_watch_icon_padding_top"
        android:layout_marginBottom="@dimen/nfc_tsm_watch_icon_padding_bottom"
        android:layout_centerHorizontal="true">
        <com.xiaomi.fitness.nfc.widget.DeviceImageView
            android:id="@+id/deviceView"
            android:layout_width="@dimen/nfc_device_icon_width"
            android:layout_height="@dimen/nfc_device_icon_height"/>
        <com.xiaomi.fitness.nfc.widget.InnerCardImageView
            android:id="@+id/cardView"
            android:layout_width="86.4dp"
            android:layout_height="48.6dp"/>
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/progressView"
            android:visibility="gone"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:indeterminateDrawable="@drawable/nfc_card_issuing_indeterminate"
            android:indeterminateDuration="2000"
            android:interpolator="@android:interpolator/accelerate_decelerate"/>
    </FrameLayout>
    <RelativeLayout
        android:id="@+id/nextpay_transfer_out_title_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/watch_layout">
        <TextView
            android:textSize="24sp"
            android:textColor="@color/text_color"
            android:id="@+id/titleView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nfc_nextpay_transfer_out_title"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/text_color"
            android:id="@+id/dotView"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="···"
            android:layout_toEndOf="@+id/titleView"/>
    </RelativeLayout>
    <TextView
        android:textSize="@dimen/nfc_common_textsize_4"
        android:textColor="@color/text_color_60"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/descView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/nfc_nextpay_transfer_out_intro_desc_margin_top"
        android:text="@string/nfc_nextpay_transfer_out_desc"
        android:layout_below="@+id/nextpay_transfer_out_title_layout"
        android:layout_centerHorizontal="true"/>
    <RelativeLayout
        android:id="@+id/bottomLayoutView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="60dp"
        android:layout_alignParentBottom="true">
        <TextView
            android:id="@+id/agreeView"
            android:text="@string/nfc_nextpay_transfer_out_btn_accept"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp"
            style="@style/CommonBtn.Normal"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@+id/nextpay_transfer_out_ll_protocols"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/agreeView"
            android:layout_centerHorizontal="true">
            <CheckBox
                android:textSize="@dimen/nfc_tsm_text_size_content_small"
                android:gravity="center_vertical"
                android:id="@+id/nextpay_transfer_out_chk_contracts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:button="@drawable/selector_check"
                android:text="@string/nfc_common_agree"
                android:drawablePadding="2dp"
                style="@style/nfc_TextAppearance.Content.Light"/>
            <TextView
                android:textSize="@dimen/nfc_tsm_text_size_content_small"
                android:textColor="@color/black_80_transparent"
                android:autoLink="all"
                android:id="@+id/protocolsView"
                style="@style/nfc_TextAppearance.Content"/>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
