<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/page_content_padding_horizontal_large"
    android:paddingEnd="@dimen/page_content_padding_horizontal_large">
    <EditText
        android:textSize="16sp"
        android:textColor="@color/switch_black"
        android:textColorHint="@color/edit_hint_color"
        android:id="@+id/input_name_et"
        android:background="@drawable/common_edit_bg"
        android:padding="16dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_10dp"
        android:hint="@string/health_sleep_phythm_up_dialog_name"
        android:maxLength="11"
        android:textDirection="locale"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <miuix.androidbasewidget.widget.EditText
        android:textSize="16sp"
        android:textColor="@color/switch_black"
        android:textColorHint="@color/edit_hint_color"
        android:id="@+id/input_id_et"
        android:background="@drawable/common_edit_bg"
        android:padding="16dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_10dp"
        android:hint="@string/health_sleep_phythm_up_dialog_id"
        android:maxLength="20"
        android:inputType="number"
        android:textDirection="locale"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/input_name_et"/>
    <TextView
        android:theme="@style/FontNormal.12sp"
        android:textColor="@color/text_color_40"
        android:id="@+id/up_need_info_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/health_sleep_phythm_up_dialog_remind"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/input_id_et"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/text_size_16"
        android:id="@+id/positive_button"
        android:layout_width="@dimen/dimen_margin_0dp"
        android:layout_height="52dp"
        android:layout_marginTop="@dimen/dimen_margin_10dp"
        android:text="@string/confirm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/up_need_info_title"
        style="@style/CommonBtn.Normal"/>
</androidx.constraintlayout.widget.ConstraintLayout>
