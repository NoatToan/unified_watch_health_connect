<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/userinfo_layout_aid_record_detail_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.xiaomi.fitness.widget.view.RoundImageView
        android:id="@+id/iv_avatar"
        android:background="@drawable/ic_avatar_default"
        android:layout_width="@dimen/userinfo_size_53_3"
        android:layout_height="@dimen/userinfo_size_53_3"
        android:layout_marginTop="@dimen/size_21_3"
        android:layout_alignParentTop="true"
        android:contentDescription="@string/userinfo_avatar"
        android:layout_marginEnd="@dimen/page_content_padding_horizontal_large"
        android:layout_alignParentEnd="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:userinfo_riv_oval="true"/>
    <TextView
        android:textSize="@dimen/userinfo_font_31_97"
        android:textColor="@color/black_90"
        android:ellipsize="end"
        android:id="@+id/tv_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/userinfo_size_26_7"
        android:maxLines="2"
        android:fontFamily="mipro-light"
        android:layout_marginEnd="@dimen/page_content_padding_horizontal_large"
        android:layout_toStartOf="@+id/iv_avatar"
        android:layout_alignParentStart="true"
        android:paddingHorizontal="@dimen/page_content_padding_horizontal_large"/>
    <TextView
        android:textSize="@dimen/font_13_36"
        android:textColor="@color/black_40"
        android:id="@+id/tv_gender_and_age"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tv_name"
        android:paddingHorizontal="@dimen/page_content_padding_horizontal_large"
        style="@style/FontRegular"/>
    <com.xiaomi.fitness.userinfo.medicalid.baseui.DisplayItemView
        android:id="@+id/blood_type"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_30dp"
        android:layout_below="@+id/tv_gender_and_age"
        app:item_title="@string/userinfo_blood_type"/>
    <com.xiaomi.fitness.userinfo.medicalid.baseui.DisplayItemView
        android:id="@+id/donor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/blood_type"
        app:item_title="@string/userinfo_organ_donation_volunteer"/>
    <com.xiaomi.fitness.userinfo.medicalid.baseui.DisplayItemView
        android:id="@+id/allergy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/donor"
        app:item_title="@string/userinfo_allergic_drugs"/>
    <com.xiaomi.fitness.userinfo.medicalid.baseui.DisplayItemView
        android:id="@+id/chronic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/allergy"
        app:item_title="@string/userinfo_chronic"/>
    <com.xiaomi.fitness.userinfo.medicalid.baseui.DisplayItemView
        android:id="@+id/treatment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/chronic"
        app:item_title="@string/userinfo_medication_and_treatment"/>
    <View
        android:id="@+id/divider"
        android:background="@color/black_10"
        android:layout_width="match_parent"
        android:layout_height="0.73dp"
        android:layout_marginTop="@dimen/dimen_margin_20dp"
        android:layout_below="@+id/treatment"
        android:paddingHorizontal="@dimen/dimen_margin_18dp"/>
    <com.xiaomi.fitness.userinfo.medicalid.baseui.DisplayItemView
        android:id="@+id/contact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_20dp"
        android:layout_marginBottom="@dimen/dimen_margin_20dp"
        android:layout_below="@+id/divider"
        app:item_title="@string/userinfo_emergency_contact"/>
</RelativeLayout>
