<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/sport_running_route_detail_activity_layout_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.amap.api.maps.MapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="500dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.mi.health.sport.TrackShareRoutineView
            android:id="@+id/routineView"
            android:background="@drawable/mine_track_line_bg"
            android:visibility="invisible"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginTop="100dp"
            android:layout_marginStart="@dimen/dimen_margin_20dp"/>
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/bottom_sheet"
            android:background="@color/transparent"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"
            app:behavior_peekHeight="433dp"
            app:elevation="0dp"
            app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/bottom_sheet_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RelativeLayout
                    android:id="@+id/drag_handle"
                    android:paddingTop="@dimen/dimen_margin_20dp"
                    android:paddingBottom="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <ImageView
                        android:id="@+id/drag_handle_iv"
                        android:background="@drawable/sport_route_bottom_sheet_handler"
                        android:layout_width="37.3dp"
                        android:layout_height="@dimen/dimen_margin_4dp"
                        android:layout_alignParentTop="true"
                        android:layout_centerHorizontal="true"/>
                </RelativeLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/bottom_sheet_panel"
                    android:tag="binding_1"
                    android:background="@drawable/shape_sporting_bg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/page_padding_horizontal_large"
                    app:layout_constraintTop_toBottomOf="@+id/drag_handle">
                    <include
                        android:id="@+id/route_info_section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        layout="@layout/sport_running_route_into_section_layout"/>
                    <include
                        android:id="@+id/tab_layout"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toBottomOf="@+id/route_info_section"
                        layout="@layout/sport_route_detail_tab_layout"/>
                    <include
                        android:id="@+id/ranking_list_container"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="@dimen/dimen_margin_10dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tab_layout"
                        layout="@layout/sport_route_detail_ranking_container"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.appbar.AppBarLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/no_network_panel"
            android:background="@drawable/shape_sporting_bg"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="100dp"
            app:layout_constraintBottom_toBottomOf="parent">
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/text_color_40"
                android:gravity="center"
                android:id="@+id/no_network_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_network"
                android:drawableTop="@drawable/icon_no_network"
                android:translationY="-40dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/FontNormal.14sp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <RelativeLayout
        android:id="@+id/start_running_tab"
        android:background="@color/page_white_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:textSize="@dimen/dimen_16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/start_running_btn"
            android:background="@drawable/selector_bottom_btn_positive_bg"
            android:layout_width="336dp"
            android:layout_height="48dp"
            android:text="@string/sport_start_running"
            android:layout_centerInParent="true"
            style="@style/FontMedium"/>
    </RelativeLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/action_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.cardview.widget.CardView
            android:id="@+id/ic_back"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginTop="9dp"
            android:foregroundGravity="center"
            android:contentDescription="@string/back"
            android:layout_marginStart="15dp"
            app:cardBackgroundColor="@color/card_bg_normal"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:layout_gravity="center"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_left_back_black"
                android:scaleType="centerInside"
                android:contentDescription="@string/back"/>
        </androidx.cardview.widget.CardView>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/menu_horizontal"
            android:background="@drawable/bg_route_detail_menu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="15dp"
            app:layout_constraintBottom_toBottomOf="@+id/ic_back"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/ic_back">
            <ImageView
                android:id="@+id/ic_route_collect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_route_uncollect"
                android:contentDescription="@string/sport_route_collect_desc"/>
            <com.google.android.material.divider.MaterialDivider
                android:layout_gravity="center_vertical"
                android:id="@+id/menu_divider"
                android:layout_width="1px"
                android:layout_height="18dp"
                android:layout_marginLeft="@dimen/size_15"
                android:layout_marginRight="@dimen/size_15"/>
            <ImageView
                android:id="@+id/ic_send_to_device"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/sport_ic_save_route_horizontal_auto_mirror"
                android:contentDescription="@string/sport_route_save_to_device_title"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <include
        android:id="@+id/progressInclude"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="130dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        layout="@layout/route_detail_progress"/>
</androidx.constraintlayout.widget.ConstraintLayout>
