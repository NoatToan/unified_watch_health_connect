<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_sleep_duration"
    android:tag="layout/layout_sleep_duration_0"
    android:background="@drawable/selector_card_bg"
    android:paddingTop="@dimen/size_20"
    android:paddingBottom="@dimen/size_20"
    android:focusable="true"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/size_13"
    android:paddingStart="@dimen/size_18"
    android:paddingEnd="@dimen/size_18">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_icon"
        android:layout_width="30dp"
        android:layout_height="30dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_sleep_duration"/>
    <TextView
        android:textSize="@dimen/font_18"
        android:textColor="@color/text_color"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/health_total_sleep_duration"
        android:drawablePadding="@dimen/size_3_3"
        android:drawableEnd="@drawable/health_ic_question"
        android:layout_marginStart="@dimen/size_6_7"
        app:layout_constraintBottom_toBottomOf="@+id/iv_icon"
        app:layout_constraintStart_toEndOf="@+id/iv_icon"
        app:layout_constraintTop_toTopOf="@+id/iv_icon"
        style="@style/FontMedium"/>
    <com.xiaomi.fitness.widget.view.DurationTextView
        android:id="@+id/duration_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_13"
        app:dtv_dataFont="@font/misanslatin_medium"
        app:dtv_dataTextColor="@color/text_color"
        app:dtv_dataTextSize="@dimen/font_33_3"
        app:dtv_unitTextColor="@color/text_color"
        app:dtv_unitTextFontFamily="@string/mipro_regular"
        app:dtv_unitTextSize="@dimen/font_16_7"
        app:dtv_unitTextStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_icon"/>
    <TextView
        android:textColor="@color/text_color_40"
        android:id="@+id/tv_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/health_sleep_total_sleep_duration"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/duration_view"
        style="@style/FontRegular.12sp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
