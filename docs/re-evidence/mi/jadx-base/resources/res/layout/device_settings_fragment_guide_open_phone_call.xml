<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/device_settings_fragment_guide_open_phone_call_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <miuix.springback.view.SpringBackLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scrollableView="@+id/scrollview">
        <miuix.core.widget.NestedScrollView
            android:id="@+id/scrollview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.xiaomi.fitness.ubox.export.DeviceIconView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/deviceView"
                    android:layout_width="@dimen/dimen_margin_270dp"
                    android:layout_height="@dimen/dimen_margin_270dp"
                    android:layout_marginTop="50dp"
                    android:layout_marginBottom="50dp"
                    app:isCurrentDevice="true"
                    app:type="2"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/phone_call_open_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:layoutDirection="locale"
                    android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
                    android:layout_marginEnd="@dimen/page_content_padding_horizontal_large">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/dimen_15sp"
                        android:textStyle="bold"
                        android:textColor="@color/switch_black"
                        android:id="@+id/phone_call_remind_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/dimen_13sp"
                        android:textColor="@color/notify_guide_remind_has_open_color"
                        android:id="@+id/phone_call_remind_subtitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginEnd="40dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/phone_call_button"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/phone_call_remind_title"/>
                    <CheckBox
                        android:id="@+id/phone_call_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:button="@drawable/selector_common_circle_check"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
        </miuix.core.widget.NestedScrollView>
    </miuix.springback.view.SpringBackLayout>
    <Button
        android:id="@+id/cancel_button"
        android:layout_width="@dimen/common_btn_two_column_width"
        android:layout_height="@dimen/common_btn_height"
        android:text="@string/notify_message_remind_ignore"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/open_button"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/CommonBtn.Normal"/>
    <Button
        android:id="@+id/open_button"
        android:layout_width="@dimen/common_btn_two_column_width"
        android:layout_height="@dimen/common_btn_height"
        android:text="@string/common_continue"
        android:layout_marginStart="@dimen/page_extra_padding_horizontal_large"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/cancel_button"
        style="@style/CommonBtn.Primary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
