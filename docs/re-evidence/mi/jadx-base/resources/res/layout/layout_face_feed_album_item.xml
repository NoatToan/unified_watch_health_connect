<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/layout_face_feed_album_item_0"
    android:background="@drawable/bg_face_market_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_16dp"
        android:layout_marginStart="@dimen/dimen_margin_16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/FontMedium.16sp"/>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_more_right"
        android:layout_marginStart="@dimen/dimen_margin_1dp"
        app:layout_constraintBottom_toBottomOf="@+id/title"
        app:layout_constraintStart_toEndOf="@+id/title"
        app:layout_constraintTop_toTopOf="@+id/title"/>
    <com.xiaomi.fitness.watch.face.export.exportview.FaceInfoView
        android:id="@+id/preview_3"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <com.xiaomi.fitness.watch.face.export.exportview.FaceInfoView
        android:id="@+id/preview_2"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/preview_3"
        app:layout_constraintEnd_toEndOf="@+id/preview_3"/>
    <com.xiaomi.fitness.watch.face.export.exportview.FaceInfoView
        android:id="@+id/preview_1"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/preview_3"
        app:layout_constraintEnd_toEndOf="@+id/preview_2"/>
</androidx.constraintlayout.widget.ConstraintLayout>
