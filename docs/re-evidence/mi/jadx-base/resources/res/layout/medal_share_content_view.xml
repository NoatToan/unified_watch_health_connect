<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/share_content"
    android:tag="layout/medal_share_content_view_0"
    android:background="@drawable/medal_share_shape_card_bg_normal"
    android:paddingTop="17.33dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/dimen_margin_40dp">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/logo_and_app_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/page_extra_padding_horizontal_large"
        app:layout_constraintBottom_toTopOf="@+id/tv_user_achieved"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.xiaomi.fitness.widget.view.RoundImageView
            android:id="@+id/mi_health_logo"
            android:layout_width="27.3dp"
            android:layout_height="27.3dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/medal_ic_share_logo"/>
        <TextView
            android:textSize="@dimen/dimen_15sp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/app_name"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/app_name"
            android:paddingStart="6dp"
            style="@style/FontDemiBold"/>
    </LinearLayout>
    <TextView
        android:textSize="20sp"
        android:gravity="center"
        android:id="@+id/tv_user_achieved"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_10dp"
        android:maxLines="2"
        android:layout_marginHorizontal="@dimen/page_extra_padding_horizontal_large"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/logo_and_app_name"
        style="@style/FontLatinSemiBold"/>
    <com.xiaomi.fitness.medal.share.MedalShareContentView
        android:id="@+id/share_icon_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:paddingHorizontal="@dimen/page_extra_padding_horizontal_large"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_user_achieved">
        <ImageView
            android:id="@+id/share_medal_icon"
            android:layout_width="198dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:layout_marginBottom="17dp"
            android:scaleType="fitCenter"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </com.xiaomi.fitness.medal.share.MedalShareContentView>
    <TextView
        android:textSize="48sp"
        android:textColor="#e5ffffff"
        android:gravity="start"
        android:id="@+id/share_medal_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="8dp"
        android:layout_marginHorizontal="@dimen/page_extra_padding_horizontal_large"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/share_icon_content"
        style="@style/FontDemiBold"/>
    <TextView
        android:textColor="#808080"
        android:gravity="start"
        android:id="@+id/got_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_3dp"
        android:layout_marginHorizontal="@dimen/page_extra_padding_horizontal_large"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/share_medal_name"
        style="@style/FontMedium.12sp"/>
    <View
        android:id="@+id/divider"
        android:background="#5b5b5b"
        android:layout_width="match_parent"
        android:layout_height="0.6dp"
        android:layout_marginTop="@dimen/dimen_margin_30dp"
        android:layout_centerVertical="true"
        android:layout_marginHorizontal="@dimen/page_extra_padding_horizontal_large"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/got_time"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_margin_20dp"
        android:paddingVertical="@dimen/dimen_margin_15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bottom_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/share_qrcode"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginTop="@dimen/dimen_margin_15dp"
                android:contentDescription="@string/scan_qrcode"
                android:layout_marginStart="14.33dp"
                android:layout_marginEnd="@dimen/page_extra_padding_horizontal_large"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.xiaomi.fitness.widget.view.RoundImageView
                android:id="@+id/photo_view"
                android:layout_width="38.3dp"
                android:layout_height="38.3dp"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/page_extra_padding_horizontal_large"
                app:layout_constraintBottom_toBottomOf="@+id/share_qrcode"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/share_qrcode"/>
            <com.xiaomi.fitness.widget.view.DividerView
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@+id/share_qrcode"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/share_qrcode"/>
            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6.67dp"
                android:layout_marginEnd="14.3dp"
                app:layout_constraintBottom_toBottomOf="@+id/share_qrcode"
                app:layout_constraintEnd_toStartOf="@+id/share_qrcode"
                app:layout_constraintStart_toEndOf="@+id/photo_view"
                app:layout_constraintTop_toTopOf="@+id/share_qrcode">
                <TextView
                    android:textColor="#d3d3d3"
                    android:id="@+id/nickName_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/FontDemiBold.16sp"/>
                <TextView
                    android:textColor="#5b5b5b"
                    android:id="@+id/collect_medal_description"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/medal_share_collect_medal_description"
                    android:layout_below="@+id/nickName_text"
                    style="@style/FontRegular.12sp"/>
            </RelativeLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
