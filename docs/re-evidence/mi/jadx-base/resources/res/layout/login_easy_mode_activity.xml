<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:tag="layout/login_easy_mode_activity_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/login_size_33_33"
            android:text="@string/login_privacy_easy_mode_desc"
            android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
            android:layout_marginEnd="@dimen/page_content_padding_horizontal_large"
            style="@style/FontRegular.14sp"/>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_20dp"
        android:layout_marginBottom="@dimen/login_size_27">
        <TextView
            android:textColor="@color/login_text_white"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_positive"
            android:background="@drawable/selector_bottom_btn_positive_bg"
            android:layout_width="@dimen/common_btn_single_line_width"
            android:layout_height="wrap_content"
            android:text="@string/login_privacy_enter_easy_mode"
            android:layout_weight="1"
            android:paddingHorizontal="@dimen/size_10"
            android:paddingVertical="12.7dp"
            style="@style/FontMedium.16sp"/>
        <TextView
            android:textColor="@color/login_black"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_negative"
            android:background="@drawable/selector_bottom_btn_native_bg"
            android:layout_width="@dimen/common_btn_single_line_width"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_10"
            android:text="@string/login_privacy_exit_app"
            android:layout_weight="1"
            android:paddingHorizontal="@dimen/size_10"
            android:paddingVertical="12.7dp"
            style="@style/FontMedium.16sp"/>
    </LinearLayout>
</LinearLayout>
