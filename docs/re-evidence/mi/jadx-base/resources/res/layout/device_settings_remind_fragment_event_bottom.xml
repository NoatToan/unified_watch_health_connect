<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/eventMinderBottomView"
    android:tag="layout/device_settings_remind_fragment_event_bottom_0"
    android:background="@color/device_settings_adapted_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.xiaomi.fitness.widget.view.DividerView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/text_color"
        android:gravity="center"
        android:id="@+id/eventReminderDeleteView"
        android:paddingTop="15dp"
        android:paddingBottom="15dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/common_delete"
        android:drawableTop="@drawable/ic_delete_bottom"
        android:drawablePadding="2dp"
        style="@style/FontRegular"/>
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/eventMinderEditLinear"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="13sp"
            android:textColor="@color/text_color"
            android:gravity="center"
            android:id="@+id/eventReminderEditView"
            android:paddingTop="15dp"
            android:paddingBottom="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/device_settings_common_edit"
            android:drawableTop="@drawable/ic_edit_normal"
            android:drawablePadding="2dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            style="@style/FontRegular"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/text_color"
            android:gravity="center"
            android:id="@+id/eventReminderAddView"
            android:paddingTop="15dp"
            android:paddingBottom="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/device_settings_common_add"
            android:drawableTop="@drawable/device_settings_ic_edit_add_normal"
            android:drawablePadding="2dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginStart="30dp"
            style="@style/FontRegular"/>
    </LinearLayout>
</FrameLayout>
