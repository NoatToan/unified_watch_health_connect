<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/layout_pai_progress"
    android:background="@drawable/shape_data_item_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="@color/text_color"
        android:gravity="start"
        android:id="@+id/tv_pai_target_disparity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_17_67"
        android:textDirection="locale"
        android:textAlignment="gravity"
        android:layout_marginStart="@dimen/size_20"
        android:layout_marginEnd="@dimen/size_20"
        style="@style/FontMedium.14sp"/>
    <TextView
        android:textColor="@color/text_color_40"
        android:gravity="start"
        android:id="@+id/tv_pai_suggest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textDirection="locale"
        android:textAlignment="gravity"
        android:layout_marginStart="@dimen/size_20"
        android:layout_marginEnd="@dimen/size_20"
        style="@style/FontRegular.12sp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:layout_marginBottom="10dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp">
        <RelativeLayout
            android:id="@+id/rl_sleep_chart"
            android:layout_width="0dp"
            android:layout_height="20dp"
            android:layout_weight="1">
            <ProgressBar
                android:id="@+id/pb_target_step1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:maxHeight="20dp"
                android:max="30"
                android:progressDrawable="@drawable/pai_progress_left_round"
                android:minHeight="20dp"
                android:min="0"
                style="@style/Base.Widget.AppCompat.ProgressBar.Horizontal"/>
            <com.xiaomi.fitness.baseui.widget.CircularCoverView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_centerInParent="true"
                app:cover_color="@color/card_bg_normal"
                app:left_bottom_radius="@dimen/size_10"
                app:left_top_radius="@dimen/size_10"
                app:right_bottom_radius="0dp"
                app:right_top_radius="0dp"/>
        </RelativeLayout>
        <ProgressBar
            android:id="@+id/pb_target_step2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxHeight="20dp"
            android:max="20"
            android:progressDrawable="@drawable/pai_progress_rect"
            android:minHeight="20dp"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:min="0"
            style="@style/Base.Widget.AppCompat.ProgressBar.Horizontal"/>
        <ProgressBar
            android:id="@+id/pb_target_step3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxHeight="20dp"
            android:max="50"
            android:progressDrawable="@drawable/pai_progress_rect"
            android:minHeight="20dp"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:min="0"
            style="@style/Base.Widget.AppCompat.ProgressBar.Horizontal"/>
        <ProgressBar
            android:id="@+id/pb_target_step4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxHeight="20dp"
            android:max="100"
            android:progressDrawable="@drawable/pai_progress_right_round"
            android:minHeight="20dp"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:min="0"
            style="@style/Base.Widget.AppCompat.ProgressBar.Horizontal"/>
    </LinearLayout>
    <LinearLayout
        android:paddingBottom="@dimen/size_30"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="50dp"
        android:paddingEnd="50dp">
        <TextView
            android:textSize="10sp"
            android:textColor="@color/black_50"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/health_pai_target_30pai"
            android:layout_weight="1"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/black_50"
            android:gravity="center"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:text="@string/health_pai_target_50pai"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/black_50"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/health_pai_target_100pai"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
