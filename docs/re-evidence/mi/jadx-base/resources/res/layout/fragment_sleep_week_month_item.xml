<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nestedScrollView"
    android:tag="layout/fragment_sleep_week_month_item_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/container"
        android:tag="binding_1"
        android:paddingBottom="@dimen/size_30"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="@dimen/health_detail_page_common_margin_horizontal">
        <include
            android:id="@+id/card_empty"
            layout="@layout/layout_sleep_empty"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_wm_detail"
            android:tag="binding_2"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_12">
            <include
                android:id="@+id/card_sleep_wm_score"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                layout="@layout/layout_sleep_wm_score"/>
            <include
                android:id="@+id/card_sleep_regularity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_12"
                layout="@layout/layout_sleep_wm_regularity"/>
            <include
                android:id="@+id/card_sleep_wm_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_12"
                layout="@layout/layout_sleep_wm_duration"/>
            <include
                android:id="@+id/card_sleep_wm_regular"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_12"
                layout="@layout/health_layout_sleep_wm_regular"/>
            <include
                android:id="@+id/card_sleep_wm_efficiency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_12"
                layout="@layout/layout_sleep_wm_efficiency"/>
        </LinearLayout>
        <com.xiaomi.fitness.health.sleep.ui.SleepHealthBannerCardSetLayout
            android:id="@+id/health_sleep_banner_card_set_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"/>
        <com.xiaomi.fitness.view.CardUnderstandView
            android:id="@+id/understandCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_12"
            app:txtUnderstand="@string/health_sleep_understand"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
