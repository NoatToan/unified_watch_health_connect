<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/relative_care_layout_more_settings_0"
    android:background="@color/page_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <miuix.springback.view.SpringBackLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scrollableView="@+id/spring_back_target">
        <miuix.core.widget.NestedScrollView
            android:id="@+id/spring_back_target"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/page_content_padding_horizontal_large"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textColor="@color/text_color_40"
                    android:id="@+id/my_setting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_margin_28dp"
                    android:layout_marginBottom="@dimen/dimen_margin_12dp"
                    android:text="@string/relative_care_my_related_setting"
                    style="@style/FontRegular.12sp"/>
                <com.xiaomi.fitness.widget.RightArrowBindingSingleLineTextView
                    android:id="@+id/data_share_to_them"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:showBackground="false"
                    app:title="@string/relative_care_data_shared_to_them"/>
                <com.xiaomi.fitness.widget.RightArrowBindingSingleLineTextView
                    android:id="@+id/data_share_range"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:showBackground="false"
                    app:title="@string/relative_care_data_share_range"/>
                <TextView
                    android:textColor="@color/text_color_40"
                    android:id="@+id/other_setting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_margin_12dp"
                    android:layout_marginBottom="@dimen/dimen_margin_12dp"
                    android:text="@string/relative_care_other_related_setting"
                    style="@style/FontRegular.12sp"/>
                <com.xiaomi.fitness.widget.RightArrowBindingSingleLineTextView
                    android:id="@+id/data_shared_by_them"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:showBackground="false"
                    app:title="@string/relative_care_data_shared_by_them"/>
                <com.xiaomi.fitness.widget.SwitchButtonBindingTwoLineTextView
                    android:id="@+id/subscribe_to_abnormal_data"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:showBackground="false"
                    app:subtitle="@string/relative_care_abnormal_subscription_subtitle"
                    app:title="@string/relative_care_subscribe_to_abnormal_data"/>
                <com.xiaomi.fitness.widget.RightArrowBindingSingleLineTextView
                    android:id="@+id/change_friend_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:showBackground="false"
                    app:title="@string/relative_care_change_friend_note"/>
                <TextView
                    android:textColor="@color/text_color_40"
                    android:id="@+id/more_setting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_margin_12dp"
                    android:layout_marginBottom="@dimen/dimen_margin_12dp"
                    android:text="@string/relative_care_more_related_setting"
                    style="@style/FontRegular.12sp"/>
                <com.xiaomi.fitness.widget.RightArrowBindingSingleLineTextView
                    android:id="@+id/unfriend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:showBackground="false"
                    app:title="@string/relative_care_unfriend"/>
            </LinearLayout>
        </miuix.core.widget.NestedScrollView>
    </miuix.springback.view.SpringBackLayout>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/relative_care_no_network_text_color"
        android:gravity="center_horizontal"
        android:id="@+id/no_network"
        android:visibility="gone"
        android:layout_width="100dp"
        android:layout_height="150dp"
        android:text="@string/relative_care_network_connection_failed_tip"
        android:drawableTop="@drawable/icon_no_network"
        android:drawablePadding="@dimen/dimen_margin_10dp"
        android:layout_centerInParent="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
