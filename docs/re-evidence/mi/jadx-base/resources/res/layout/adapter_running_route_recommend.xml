<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/routeInfoLayout"
    android:tag="layout/adapter_running_route_recommend_0"
    android:background="@drawable/ic_remand_route_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="16sp"
        android:textColor="@color/black"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_13dp"
        android:maxWidth="160dp"
        android:singleLine="true"
        android:fontFamily="@font/misanslatin_semibold"
        android:paddingStart="0dp"
        android:paddingEnd="10dp"
        android:layout_marginHorizontal="13dp"
        app:layout_constraintEnd_toStartOf="@+id/routeBg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="20sp"
        android:textColor="@color/black"
        android:gravity="start"
        android:id="@+id/route_length"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/misanslatin_demibold"
        app:layout_constraintStart_toStartOf="@+id/name"
        app:layout_constraintTop_toBottomOf="@+id/name"/>
    <TextView
        android:textSize="10.67sp"
        android:textColor="@color/black"
        android:id="@+id/unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="3dp"
        android:layout_marginStart="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/route_length"
        app:layout_constraintStart_toEndOf="@+id/route_length"/>
    <TextView
        android:textSize="10.67sp"
        android:textColor="@color/sport_color_08c59A"
        android:gravity="center"
        android:id="@+id/routeType"
        android:background="@drawable/shape_e0f4ee"
        android:layout_width="54.6dp"
        android:layout_height="18.66dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="@dimen/dimen_margin_13dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/name"
        app:layout_constraintTop_toBottomOf="@+id/route_length"/>
    <ImageView
        android:id="@+id/routeBg"
        android:layout_width="73.3dp"
        android:layout_height="73.3dp"
        android:layout_marginEnd="@dimen/dimen_margin_13dp"
        app:layout_constraintBottom_toBottomOf="@+id/routeType"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/name"
        app:layout_constraintTop_toTopOf="@+id/name"/>
    <View
        android:id="@+id/bottomView"
        android:layout_width="0dp"
        android:layout_height="13dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/routeBg"/>
</androidx.constraintlayout.widget.ConstraintLayout>
