<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/shape_card_bg_normal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/dimen_margin_12dp"
    android:layout_marginHorizontal="@dimen/page_padding_horizontal_large"
    android:paddingVertical="17.3dp">
    <ImageView
        android:id="@+id/route_icon"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginStart="17.3dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/text_color"
        android:id="@+id/route_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_margin_12dp"
        app:layout_constraintStart_toEndOf="@+id/route_icon"
        app:layout_constraintTop_toTopOf="@+id/route_icon"
        style="@style/FontMedium.16sp"/>
    <TextView
        android:textColor="@color/text_color_60"
        android:id="@+id/route_entire_length"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6.67dp"
        app:layout_constraintStart_toStartOf="@+id/route_name"
        app:layout_constraintTop_toBottomOf="@+id/route_name"
        style="@style/FontMedium.16sp"/>
    <TextView
        android:textColor="#8c93b0"
        android:id="@+id/route_status_card_unfinished"
        android:background="@drawable/sport_shape_card_bg_normal_unfinished"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sport_route_unfinished"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/route_icon"
        app:layout_constraintStart_toStartOf="@+id/route_name"
        style="@style/FontMedium.12sp"/>
    <TextView
        android:textColor="@color/primary_pace_theme_color"
        android:id="@+id/route_status_card_finished"
        android:background="@drawable/sport_shape_card_bg_normal_finished"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sport_route_finished"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/route_icon"
        app:layout_constraintStart_toStartOf="@+id/route_name"/>
    <ImageView
        android:id="@+id/right_arrow"
        android:background="@drawable/right_arrow_icon"
        android:visibility="gone"
        android:layout_width="@dimen/dimen_margin_30dp"
        android:layout_height="@dimen/dimen_margin_30dp"
        android:layout_marginEnd="5.3dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/white"
        android:id="@+id/join_punching_in_btn"
        android:background="@drawable/shape_bottom_btn_positive_bg_normal"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sport_join_punching_in"
        android:layout_marginEnd="@dimen/dimen_margin_15dp"
        android:paddingHorizontal="@dimen/dimen_margin_10dp"
        android:paddingVertical="9dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/FontMedium.14sp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
