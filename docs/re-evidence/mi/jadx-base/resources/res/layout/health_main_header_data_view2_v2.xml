<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/app_4_0_bg_color"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:background="@drawable/bg_data_headerview"
        android:layout_width="match_parent"
        android:layout_height="269dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.xiaomi.fitness.health.threetarget.model.ThreeTargetView
        android:id="@+id/targetView"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/reflectView"
        android:layout_width="210dp"
        android:layout_height="80dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/targetView"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/shareBtnView"
        android:focusable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="yes"
        android:screenReaderFocusable="true"
        app:layout_constraintBottom_toTopOf="@+id/target_parent"
        app:layout_constraintEnd_toEndOf="@+id/target_parent">
        <ImageView
            android:id="@+id/outerPlaceView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/health_bg_share"
            android:importantForAccessibility="no"
            android:screenReaderFocusable="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/thingView"
            android:background="@drawable/health_ic_calorie_convert_type_biscuit"
            android:layout_width="56dp"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:importantForAccessibility="no"
            android:screenReaderFocusable="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/outerPlaceView"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/text_color"
            android:id="@+id/thingNumView"
            android:paddingBottom="2dp"
            android:focusable="false"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:importantForAccessibility="no"
            android:fontFamily="@font/misanslatin_semibold"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="2sp"
            android:autoSizeMaxTextSize="14sp"
            android:screenReaderFocusable="false"
            app:layout_constraintBottom_toBottomOf="@+id/outerPlaceView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/thingView"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/target_parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="168dp"
        android:paddingHorizontal="@dimen/page_padding_horizontal_large"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/targetContainnerView"
            android:background="@drawable/health_bg_data_header_three_target"
            android:paddingTop="@dimen/dimen_margin_16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/item_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="3"
                android:layout_marginStart="@dimen/dimen_margin_14dp"
                android:layout_marginEnd="2dp"
                app:layout_constraintTop_toTopOf="parent">
                <com.xiaomi.fitness.homepage.view.DataHeaderTargetItemV2View
                    android:id="@+id/item1View"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"/>
                <com.xiaomi.fitness.homepage.view.DataHeaderTargetItemV2View
                    android:id="@+id/item2View"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"/>
                <com.xiaomi.fitness.homepage.view.DataHeaderTargetItemV2View
                    android:id="@+id/item3View"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
            </LinearLayout>
            <View
                android:id="@+id/lineView"
                android:background="@color/divider_line_color"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginTop="@dimen/dimen_margin_22dp"
                android:layout_marginHorizontal="@dimen/dimen_margin_14dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/item_list"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/otherDataView"
                android:paddingBottom="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dimen_margin_14dp"
                android:layout_marginEnd="@dimen/dimen_margin_14dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/lineView">
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/standIconView"
                    android:layout_width="@dimen/health_target_img_square_height"
                    android:layout_height="@dimen/health_target_img_square_height"
                    android:layout_marginTop="@dimen/dimen_margin_22dp"
                    android:scaleType="centerInside"
                    android:layout_marginEnd="@dimen/size_5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="@dimen/dimen_14sp"
                    android:textColor="@color/health_home_txt_color"
                    android:gravity="center_vertical"
                    android:id="@+id/standLableView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/health_data_type_standing"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/misanslatin_medium"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="@dimen/dimen_margin_10dp"
                    app:layout_constraintBottom_toBottomOf="@+id/standIconView"
                    app:layout_constraintEnd_toStartOf="@+id/right_arrow"
                    app:layout_constraintStart_toEndOf="@+id/standIconView"
                    app:layout_constraintTop_toTopOf="@+id/standIconView"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/right_arrow"
                    android:layout_width="@dimen/dimen_margin_28dp"
                    android:layout_height="@dimen/dimen_margin_28dp"
                    android:src="@drawable/ic_right_arrow_icon"
                    app:layout_constraintBottom_toBottomOf="@+id/standIconView"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/standIconView"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
