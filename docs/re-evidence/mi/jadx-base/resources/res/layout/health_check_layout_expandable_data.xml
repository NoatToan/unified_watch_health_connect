<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/main_container"
    android:tag="layout/health_check_layout_expandable_data_0"
    android:background="#fbfbfb"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="14dp"
    android:layout_marginVertical="@dimen/dimen_margin_5dp"
    android:paddingHorizontal="14dp"
    android:paddingVertical="13dp">
    <LinearLayout
        android:layout_gravity="start|center_vertical"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textColor="@color/text_color"
            android:id="@+id/tv_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/FontMedium.15sp"/>
        <TextView
            android:textColor="@color/text_color"
            android:id="@+id/tv_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            style="@style/FontMedium.15sp"/>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="start|center_vertical"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">
        <LinearLayout
            android:layout_gravity="start|center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="@color/text_color"
                android:id="@+id/tv_abnormal_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/FontMedium.15sp"/>
            <TextView
                android:textColor="@color/health_check_divider"
                android:gravity="center_vertical"
                android:id="@+id/divider_line"
                android:layout_width="@dimen/size_16"
                android:layout_height="wrap_content"
                android:text="|"/>
            <TextView
                android:textColor="@color/text_color"
                android:id="@+id/tv_total_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                style="@style/FontMedium.15sp"/>
        </LinearLayout>
        <com.google.android.flexbox.FlexboxLayout
            android:id="@+id/layoutAbnormalItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            app:flexWrap="wrap"
            app:justifyContent="flex_start"/>
    </LinearLayout>
    <TextView
        android:textColor="@color/health_check_sub_sub_text"
        android:id="@+id/tv_source"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        style="@style/FontMedium.15sp"/>
</LinearLayout>
