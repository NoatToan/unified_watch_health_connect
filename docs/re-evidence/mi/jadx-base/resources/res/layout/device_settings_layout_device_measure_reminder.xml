<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/device_settings_layout_device_measure_reminder_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textColor="@color/text_color"
        android:id="@+id/measure_reminder_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/device_settings_spo2_measure_reminder_title"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/FontMedium.13sp"/>
    <TextView
        android:textColor="@color/text_color_60"
        android:id="@+id/measure_reminder_des_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_13dp"
        app:layout_constraintTop_toBottomOf="@+id/measure_reminder_title"
        style="@style/FontRegular.13sp"/>
    <ImageView
        android:id="@+id/reminderImgView"
        android:layout_width="@dimen/dimen_margin_200dp"
        android:layout_height="@dimen/dimen_margin_200dp"
        android:layout_marginTop="@dimen/dimen_margin_10dp"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/measure_reminder_des_1"/>
    <TextView
        android:textColor="@color/text_color_60"
        android:id="@+id/measure_reminder_des_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_20dp"
        android:text="@string/device_settings_device_wear_measure_reminder_2"
        app:layout_constraintTop_toBottomOf="@+id/reminderImgView"
        style="@style/FontRegular.13sp"/>
    <TextView
        android:textColor="@color/text_color_60"
        android:id="@+id/measure_reminder_des_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_20dp"
        android:text="@string/device_settings_device_wear_measure_reminder_3"
        app:layout_constraintTop_toBottomOf="@+id/measure_reminder_des_2"
        style="@style/FontRegular.13sp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
