<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/health_fragment_sleep_diary_medication_update_0"
    android:background="@color/page_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/page_content_padding_horizontal_large"
    android:paddingEnd="@dimen/page_content_padding_horizontal_large">
    <EditText
        android:textSize="16sp"
        android:textColor="@color/text_color"
        android:textColorHint="@color/text_color_40"
        android:gravity="start|center_vertical"
        android:id="@+id/medication_name_et"
        android:background="@drawable/edit_text_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:minHeight="54dp"
        android:hint="@string/health_medication_name"
        android:maxLength="20"
        android:paddingHorizontal="@dimen/page_extra_padding_horizontal_large"
        android:autofillHints="1"
        android:textFontWeight="500"/>
    <EditText
        android:textSize="16sp"
        android:textColor="@color/text_color"
        android:textColorHint="@color/text_color_40"
        android:gravity="start|center_vertical"
        android:id="@+id/medication_count_et"
        android:background="@drawable/edit_text_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:minHeight="54dp"
        android:hint="@string/health_medication_count"
        android:inputType="number"
        android:paddingHorizontal="@dimen/page_extra_padding_horizontal_large"
        android:textFontWeight="500"/>
    <com.xiaomi.fitness.widget.RightArrowSingleLineTextView
        android:id="@+id/medication_select_time_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_10dp"
        android:layout_marginStart="5dp"
        app:remindText="@string/health_sleep_diary_to_edit"
        app:showRemind="true"
        app:title="@string/health_medication_time"/>
</androidx.appcompat.widget.LinearLayoutCompat>
