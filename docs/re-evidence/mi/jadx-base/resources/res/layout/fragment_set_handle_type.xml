<?xml version="1.0" encoding="utf-8"?>
<miuix.springback.view.SpringBackLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_set_handle_type_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:scrollableView="@+id/scrollview">
    <miuix.core.widget.NestedScrollView
        android:id="@+id/scrollview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/dimen_margin_13dp">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/left_root_layout"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimen_margin_50dp"
                android:layoutDirection="locale">
                <TextView
                    android:textSize="@dimen/dimen_15sp"
                    android:textStyle="bold"
                    android:textColor="@color/switch_black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/device_settings_left_handle"
                    android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <miuix.androidbasewidget.widget.CheckedTextView
                    android:id="@+id/cb_left_handle"
                    android:background="@drawable/selector_common_circle_check"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:button="@null"
                    android:layout_marginEnd="@dimen/page_content_padding_horizontal_large"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/right_root_layout"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimen_margin_50dp">
                <TextView
                    android:textSize="@dimen/dimen_15sp"
                    android:textStyle="bold"
                    android:textColor="@color/switch_black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/device_settings_right_handle"
                    android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <miuix.androidbasewidget.widget.CheckedTextView
                    android:id="@+id/cb_right_handle"
                    android:background="@drawable/selector_common_circle_check"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:button="@null"
                    android:layout_marginEnd="@dimen/page_content_padding_horizontal_large"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </miuix.core.widget.NestedScrollView>
</miuix.springback.view.SpringBackLayout>
