<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:tag="layout/item_pangu_shortcut_settings_label_0"
    android:background="@drawable/right_arrow_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/page_content_padding_horizontal_large"
    android:paddingEnd="@dimen/page_content_padding_horizontal_large">
    <View
        android:id="@+id/separator_view"
        android:background="@color/black_10_transparent"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginTop="@dimen/dimen_margin_20dp"
        android:layout_marginBottom="@dimen/dimen_margin_20dp"/>
    <TextView
        android:textSize="@dimen/dimen_12sp"
        android:textColor="@color/selector_feature_item_title_text_color"
        android:gravity="start|center_vertical"
        android:id="@+id/label_tv"
        android:background="@drawable/right_arrow_white"
        android:layout_width="match_parent"
        android:layout_height="33dp"
        android:textDirection="locale"/>
</LinearLayout>
