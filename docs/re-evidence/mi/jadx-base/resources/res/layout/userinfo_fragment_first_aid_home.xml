<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:tag="layout/userinfo_fragment_first_aid_home_0"
    android:background="@color/userinfo_medical_id_bg_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_30"
        android:layout_marginHorizontal="19.3dp"
        layout="@layout/userinfo_layout_tool_bar"/>
    <miuix.springback.view.SpringBackLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/dimen_margin_25dp"
        android:layout_below="@+id/toolbar"
        android:layout_marginHorizontal="@dimen/page_padding_horizontal_large"
        app:scrollOrientation="angle|vertical"
        app:scrollableView="@+id/scroll_view">
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll_view"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <RelativeLayout
                android:paddingBottom="@dimen/userinfo_size_80"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/userinfo_font_12"
                    android:textColor="@color/white"
                    android:id="@+id/tv_lock_on_description"
                    android:paddingTop="@dimen/dimen_margin_12dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/card_aid_record"
                    android:paddingStart="@dimen/page_content_padding_horizontal_large"
                    android:paddingEnd="@dimen/page_content_padding_horizontal_large"/>
                <TextView
                    android:textSize="@dimen/userinfo_font_12"
                    android:textColor="@color/white"
                    android:id="@+id/tv_lock_solve"
                    android:paddingTop="@dimen/dimen_margin_12dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/tv_lock_on_description"
                    android:paddingStart="@dimen/page_content_padding_horizontal_large"
                    android:paddingEnd="@dimen/page_content_padding_horizontal_large"/>
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_aid_record"
                    android:tag="binding_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/userinfo_size_8"
                    android:foreground="@null"
                    app:cardCornerRadius="@dimen/size_16_7"
                    style="@style/userinfo_card_detailPage">
                    <include
                        android:id="@+id/medical_id_record"
                        layout="@layout/userinfo_card_aid_record"/>
                </androidx.cardview.widget.CardView>
            </RelativeLayout>
        </androidx.core.widget.NestedScrollView>
    </miuix.springback.view.SpringBackLayout>
</RelativeLayout>
