<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingTop="@dimen/size_20"
    android:paddingBottom="@dimen/size_20"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/size_18"
    android:paddingEnd="@dimen/size_18">
    <ImageView
        android:id="@+id/img_header"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:scaleType="center"
        android:layout_alignParentTop="true"
        android:layout_marginEnd="@dimen/size_10"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textStyle="bold"
        android:textColor="@color/text_color"
        android:id="@+id/txt_header_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_5_3"
        android:layout_toEndOf="@+id/img_header"
        style="@style/FontMedium.14sp"/>
    <ImageView
        android:id="@+id/img_arrow_right"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:src="@drawable/title_guide_drawable"
        android:scaleType="center"
        android:layout_toEndOf="@+id/txt_header_title"/>
    <View
        android:id="@+id/divider_line_top"
        android:background="@color/common_divider_bg_color"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_0_33"
        android:layout_marginTop="@dimen/size_20"
        android:layout_below="@+id/img_header"/>
</RelativeLayout>
