<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/page_content_padding_horizontal_large"
    android:paddingEnd="@dimen/page_content_padding_horizontal_large">
    <EditText
        android:textSize="16sp"
        android:textColor="@color/switch_black"
        android:textColorHint="@color/edit_hint_color"
        android:id="@+id/input_name_et"
        android:background="@drawable/common_edit_bg"
        android:padding="16dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_10dp"
        android:hint="@string/device_settings_music_settings_input_song_list_name"
        android:maxLength="20"
        android:textDirection="locale"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/text_size_16"
        android:id="@+id/negative_button"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:layout_marginTop="@dimen/dimen_margin_10dp"
        android:text="@string/cancel"
        android:layout_marginStart="@dimen/dimen_margin_0dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintEnd_toStartOf="@+id/positive_button"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/input_name_et"
        app:layout_constraintVertical_chainStyle="spread_inside"
        style="@style/CommonBtn.Normal"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:enabled="false"
        android:textSize="@dimen/text_size_16"
        android:id="@+id/positive_button"
        android:layout_width="@dimen/dimen_margin_0dp"
        android:layout_height="55dp"
        android:text="@string/confirm"
        android:layout_marginStart="@dimen/dimen_margin_15dp"
        android:layout_marginEnd="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/negative_button"
        app:layout_constraintTop_toTopOf="@+id/negative_button"
        style="@style/CommonBtn.Primary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
