<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:tag="layout/nfc_fragment_copy_card_by_phone_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/bgView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
        android:layout_marginEnd="@dimen/page_content_padding_horizontal_large">
        <ImageView
            android:id="@+id/imgView"
            android:background="@drawable/read_entrance_card_guide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="20sp"
            android:textColor="@color/text_color_20"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="@string/nfc_entrance_card_emulation"
            android:layout_alignBottom="@+id/imgView"
            android:layout_marginStart="20dp"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/alertView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/nfc_mifare_card_new_mifare_card_guide_title_margin_top"
        android:layout_below="@+id/bgView">
        <TextView
            android:textSize="@dimen/nfc_common_textsize_4"
            android:textColor="@color/text_color_40"
            android:gravity="center"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nfc_entrance_card_read_title"/>
        <TextView
            android:textSize="@dimen/nfc_common_textsize_4"
            android:textColor="@color/text_color_40"
            android:gravity="center_horizontal"
            android:id="@+id/desc"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/nfc_card_intro_chk_margin_bottom"
            android:text="@string/nfc_entrance_card_read_desc"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/encryView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_below="@+id/bgView">
        <TextView
            android:textSize="24sp"
            android:textColor="@color/text_color"
            android:gravity="center"
            android:id="@+id/titleView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nfc_reading_tag_error_encrypt_support_copy_card"/>
        <TextView
            android:textSize="@dimen/nfc_common_textsize_4"
            android:textColor="@color/text_color_80"
            android:gravity="center"
            android:id="@+id/descView"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/nfc_reading_tag_error_encrypt_support_copy_card_des"
            android:paddingStart="@dimen/page_content_padding_horizontal_large"
            android:paddingEnd="@dimen/page_content_padding_horizontal_large"/>
    </LinearLayout>
    <TextView
        android:id="@+id/finishView"
        android:visibility="gone"
        android:text="@string/nfc_copy_card_by_device_finish"
        android:layout_above="@+id/issueCarView"
        android:layout_centerHorizontal="true"
        style="@style/CommonBtn.Primary"/>
    <TextView
        android:id="@+id/issueCarView"
        android:visibility="gone"
        android:text="@string/nfc_copy_card_by_device_copy_card"
        android:layout_above="@+id/bottomView"
        android:layout_centerHorizontal="true"
        style="@style/CommonBtn.Primary"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/bottomView"
        android:paddingBottom="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <TextView
            android:id="@+id/startView"
            android:visibility="gone"
            android:text="@string/nfc_entrance_card_start_copy"
            style="@style/CommonBtn.Normal"/>
        <TextView
            android:textSize="@dimen/nfc_tsm_text_size_button_normal"
            android:textStyle="bold"
            android:textColor="@color/text_color_60"
            android:id="@+id/tipsView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/nfc_entrance_card_support_alert"/>
    </LinearLayout>
</RelativeLayout>
