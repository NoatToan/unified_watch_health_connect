<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sport_constraintlayout"
    android:tag="layout/layout_running_music_0"
    android:layout_width="match_parent"
    android:layout_height="54dp"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">
    <RelativeLayout
        android:id="@+id/img_container"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/sport_music_img"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:foreground="@drawable/shape_running_music_corners_8"/>
        <ImageView
            android:id="@+id/sport_music_animation"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/running_music_playing_animation"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/sport_color_black"
        android:ellipsize="end"
        android:id="@+id/sport_music_name"
        android:layout_width="90dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:fontFamily="@font/misanslatin_medium"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/img_container"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent">
        <ImageView
            android:id="@+id/sport_music_pre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_music_pre"
            android:layout_marginEnd="15dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/sport_music_play_or_pause"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_music_play"
            android:layout_marginStart="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/sport_music_next"
            app:layout_constraintStart_toEndOf="@+id/sport_music_pre"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/sport_music_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_music_next"
            android:layout_marginStart="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/sport_music_playlist"
            app:layout_constraintStart_toEndOf="@+id/sport_music_play_or_pause"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/sport_music_playlist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_music_fold"
            android:layout_marginStart="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/sport_music_next"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
