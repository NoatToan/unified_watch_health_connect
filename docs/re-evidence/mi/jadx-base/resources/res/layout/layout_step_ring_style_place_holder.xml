<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@android:id/background"
    android:background="@drawable/widget_default_corners_background_12_67"
    android:paddingTop="16.7dp"
    android:paddingBottom="@dimen/size_10"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="16.7dp"
    android:paddingEnd="@dimen/size_10">
    <ImageView
        android:id="@+id/iv_image"
        android:background="@drawable/ic_widget_step_ring_holder"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:importantForAccessibility="no"/>
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:importantForAccessibility="no"/>
    <RelativeLayout
        android:layout_gravity="bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/label_placeholder"
            android:background="@drawable/provider_placeholder_shape"
            android:layout_width="33.3dp"
            android:layout_height="13.3dp"/>
        <ImageView
            android:id="@+id/value_placeholder"
            android:background="@drawable/provider_placeholder_shape"
            android:layout_width="75dp"
            android:layout_height="18dp"
            android:layout_marginTop="@dimen/size_4"
            android:layout_below="@+id/label_placeholder"/>
    </RelativeLayout>
</LinearLayout>
