<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_bg"
    android:tag="layout/sport_activity_just_dance_control_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/control_group"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/user_icon"
            android:tag="binding_2"
            android:background="@drawable/sport_bg_jd_user_icon"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="16dp"
            android:scaleType="centerInside"
            android:layout_marginStart="@dimen/dimen_margin_36dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/dimen_24sp"
            android:id="@+id/user_name"
            android:tag="binding_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dimen_margin_2dp"
            android:layout_marginStart="@dimen/dimen_margin_12dp"
            app:layout_constraintBottom_toTopOf="@+id/alias_name"
            app:layout_constraintEnd_toStartOf="@+id/qr_code"
            app:layout_constraintStart_toEndOf="@+id/user_icon"
            app:layout_constraintTop_toTopOf="@+id/user_icon"
            app:layout_constraintVertical_chainStyle="packed"/>
        <TextView
            android:textSize="@dimen/dimen_16sp"
            android:textColor="@color/sport_jd_common_text_color"
            android:id="@+id/alias_name"
            android:tag="binding_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_2dp"
            android:layout_marginStart="@dimen/dimen_margin_12dp"
            app:layout_constraintBottom_toBottomOf="@+id/user_icon"
            app:layout_constraintStart_toEndOf="@+id/user_icon"
            app:layout_constraintTop_toBottomOf="@+id/user_name"
            app:layout_constraintVertical_chainStyle="packed"/>
        <ImageView
            android:id="@+id/qr_code"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/sport_jd_qr_code"
            android:layout_marginEnd="@dimen/dimen_margin_36dp"
            app:layout_constraintBottom_toBottomOf="@+id/user_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/user_icon"/>
        <View
            android:id="@+id/horizontal_line"
            android:background="#1f000000"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_margin_1dp"
            android:layout_marginTop="@dimen/dimen_margin_20dp"
            android:layout_marginHorizontal="@dimen/dimen_margin_36dp"
            app:layout_constraintTop_toBottomOf="@+id/user_icon"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/navigation"
            android:tag="binding_5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toStartOf="@+id/setting_icon"
            app:layout_constraintStart_toEndOf="@+id/back_icon"
            app:layout_constraintTop_toTopOf="@+id/setting_icon"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/player_list"
            android:tag="binding_6"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/dimen_margin_26dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintBottom_toTopOf="@+id/player_share"
            app:layout_constraintTop_toBottomOf="@+id/setting_icon"
            app:layout_constraintVertical_weight="1"/>
        <TextView
            android:textSize="@dimen/dimen_22sp"
            android:textColor="@color/white"
            android:id="@+id/player_share"
            android:tag="binding_7"
            android:background="@drawable/shape_sport_jd_player_share"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_marginBottom="@dimen/dimen_margin_40dp"
            android:text="@string/sport_jd_result_share"
            android:layout_marginEnd="@dimen/dimen_margin_8dp"
            android:paddingHorizontal="54dp"
            android:paddingVertical="@dimen/dimen_margin_14dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/player_continue"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:textSize="@dimen/dimen_22sp"
            android:textColor="@color/white"
            android:id="@+id/player_continue"
            android:background="@drawable/shape_sport_jd_player_continue"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_marginBottom="@dimen/dimen_margin_40dp"
            android:text="@string/sport_jd_result_continue"
            android:layout_marginStart="@dimen/dimen_margin_8dp"
            android:paddingHorizontal="54dp"
            android:paddingVertical="@dimen/dimen_margin_14dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/player_share"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/player_group"
            android:tag="binding_8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="player_list,player_continue"/>
        <ImageView
            android:id="@+id/back_icon"
            android:tag="binding_9"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_20dp"
            android:src="@drawable/shortcut_back"
            android:layout_marginStart="@dimen/dimen_margin_26dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/horizontal_line"/>
        <ImageView
            android:id="@+id/setting_icon"
            android:tag="binding_10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_20dp"
            android:src="@drawable/shortcut_extra"
            android:layout_marginEnd="@dimen/dimen_margin_26dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/horizontal_line"/>
        <TextView
            android:textSize="@dimen/dimen_20sp"
            android:textColor="@color/sport_jd_common_text_color"
            android:id="@+id/display_text"
            android:tag="binding_11"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/touch_area_group"
            android:tag="binding_12"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/setting_icon"
            app:layout_constraintVertical_weight="1">
            <com.xiaomi.fitness.sport.view.justdance.control.JustDanceClickAreaView
                android:id="@+id/click_area"
                android:tag="binding_13"
                android:layout_width="320dp"
                android:layout_height="320dp"
                android:layout_marginBottom="@dimen/dimen_margin_12dp"
                android:layout_marginHorizontal="@dimen/dimen_margin_36dp"
                app:layout_constraintBottom_toTopOf="@+id/touch_area_hint"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <com.xiaomi.fitness.sport.view.justdance.control.JustDanceTouchAreaView
                android:id="@+id/touch_area"
                android:tag="binding_14"
                android:background="@drawable/shape_sport_jd_touch_area"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginBottom="@dimen/dimen_margin_12dp"
                android:layout_marginHorizontal="@dimen/dimen_margin_36dp"
                app:layout_constraintBottom_toTopOf="@+id/touch_area_hint"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_weight="1"/>
            <ImageView
                android:id="@+id/touch_hint"
                android:tag="binding_15"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginBottom="@dimen/dimen_margin_16dp"
                android:src="@drawable/sport_jd_touch_area_hint"
                android:layout_marginStart="@dimen/dimen_margin_16dp"
                app:layout_constraintBottom_toBottomOf="@+id/touch_area"
                app:layout_constraintStart_toStartOf="@+id/touch_area"/>
            <ImageView
                android:id="@+id/touch_guide"
                android:tag="binding_16"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@+id/touch_area"
                app:layout_constraintEnd_toEndOf="@+id/touch_area"
                app:layout_constraintStart_toStartOf="@+id/touch_area"
                app:layout_constraintTop_toTopOf="@+id/touch_area"/>
            <TextView
                android:textSize="@dimen/dimen_14sp"
                android:textColor="@color/sport_jd_common_text_color"
                android:id="@+id/touch_area_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="37dp"
                android:text="@string/sport_jd_control_play_tips"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <ImageView
            android:id="@+id/setup_icon"
            android:tag="binding_17"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:scaleType="fitCenter"
            app:layout_constraintBottom_toTopOf="@+id/pause_area"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/setting_icon"
            app:layout_constraintVertical_weight="1"/>
        <com.xiaomi.fitness.sport.view.justdance.control.JustDancePauseSliderView
            android:id="@+id/pause_area"
            android:tag="binding_18"
            android:background="@drawable/shape_sport_jd_pause_slider_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_10dp"
            android:layout_marginBottom="@dimen/dimen_margin_12dp"
            android:layout_marginHorizontal="48dp"
            app:layout_constraintBottom_toTopOf="@+id/sport_desc"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/setup_icon">
            <TextView
                android:textSize="@dimen/dimen_24sp"
                android:textColor="@color/sport_jd_common_text_color"
                android:id="@+id/text"
                android:tag="binding_19"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/slider"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/sport_jd_pause_slider"
                android:layout_marginStart="@dimen/dimen_margin_8dp"
                android:layout_marginVertical="@dimen/dimen_margin_8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </com.xiaomi.fitness.sport.view.justdance.control.JustDancePauseSliderView>
        <TextView
            android:textSize="@dimen/dimen_14sp"
            android:textColor="@color/sport_jd_common_text_color"
            android:id="@+id/sport_desc"
            android:tag="binding_20"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dimen_margin_24dp"
            android:text="@string/sport_jd_control_play_tips"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <EditText
            android:textColor="@color/text_color"
            android:id="@+id/edit_text"
            android:tag="binding_21"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="175dp"
            android:hint="@string/sport_jd_control_edit_hint"
            android:singleLine="true"
            android:maxLength="6"
            android:layout_marginHorizontal="@dimen/dimen_margin_26dp"
            app:layout_constraintTop_toBottomOf="@+id/setting_icon"/>
        <TextView
            android:textColor="@color/sport_jd_common_text_color"
            android:id="@+id/edit_confirm"
            android:tag="binding_22"
            android:background="@drawable/shape_sport_jd_start_game_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_24dp"
            android:text="@string/confirm"
            android:paddingHorizontal="48dp"
            android:paddingVertical="@dimen/dimen_margin_16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/edit_text"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/connect_dialog"
        android:tag="binding_23"
        android:background="@drawable/shape_sport_jd_connect_dialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dimen_margin_36dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ProgressBar
            android:id="@+id/connect_loading"
            android:tag="binding_24"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateOnly="true"
            android:indeterminateDrawable="@drawable/sport_jd_connect_loading_rotate"
            android:indeterminateBehavior="repeat"
            android:layout_marginVertical="185dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/connect_success_title_bg"
            android:tag="binding_25"
            android:background="#34d895"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="50dp"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/connect_success_title_icon"
            android:tag="binding_26"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/sport_jd_connect_success"
            android:layout_marginEnd="@dimen/dimen_margin_6dp"
            app:layout_constraintBottom_toBottomOf="@+id/connect_success_title_bg"
            app:layout_constraintEnd_toStartOf="@+id/connect_success_title_text"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="@+id/connect_success_title_bg"
            app:layout_constraintTop_toTopOf="@+id/connect_success_title_bg"/>
        <TextView
            android:textSize="@dimen/dimen_26sp"
            android:textColor="@color/white"
            android:id="@+id/connect_success_title_text"
            android:tag="binding_27"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sport_jd_launch_connect_title"
            android:layout_marginStart="@dimen/dimen_margin_6dp"
            app:layout_constraintBottom_toBottomOf="@+id/connect_success_title_bg"
            app:layout_constraintEnd_toEndOf="@+id/connect_success_title_bg"
            app:layout_constraintStart_toEndOf="@+id/connect_success_title_icon"
            app:layout_constraintTop_toTopOf="@+id/connect_success_title_bg"/>
        <ImageView
            android:id="@+id/connect_success_user_icon"
            android:tag="binding_28"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginTop="@dimen/dimen_margin_12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/connect_success_title_bg"/>
        <TextView
            android:textSize="@dimen/dimen_24sp"
            android:id="@+id/connect_success_user_name"
            android:tag="binding_29"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/connect_success_user_icon"/>
        <TextView
            android:textSize="@dimen/dimen_16sp"
            android:textColor="@color/sport_jd_common_text_color"
            android:id="@+id/connect_success_user_alias"
            android:tag="binding_30"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/connect_success_user_name"/>
        <TextView
            android:textSize="20sp"
            android:textColor="@color/sport_jd_common_text_color"
            android:id="@+id/connect_success_start"
            android:tag="binding_31"
            android:background="@drawable/shape_sport_jd_start_game_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_18dp"
            android:layout_marginBottom="@dimen/dimen_margin_28dp"
            android:text="@string/sport_jd_launch_connect_play"
            android:paddingHorizontal="48dp"
            android:paddingVertical="@dimen/dimen_margin_16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/connect_success_user_alias"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
