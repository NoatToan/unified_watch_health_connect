<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/sport_fragment_global_tab_0"
    android:background="@color/card_bg_normal"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/topView"
        android:background="@color/sport_page_head_color"
        android:layout_width="0dp"
        android:layout_height="138dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/headerView"
        android:background="@drawable/shape_sport_head"
        android:layout_width="0dp"
        android:layout_height="62dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topView"/>
    <com.xiaomi.fitness.widget.view.HomeHeaderView
        android:id="@+id/sport_header_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_47dp"
        app:header_desc="@string/sport_advise0"
        app:header_title="@string/sport"
        app:layout_constraintTop_toTopOf="parent"/>
    <RelativeLayout
        android:gravity="top"
        android:id="@+id/sport_card_bg"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sport_header_view">
        <com.xiaomi.fitness.sport.view.widget.SportGlobalTabLayout
            android:id="@+id/sport_global_tab_layout"
            android:background="@drawable/shape_card_bg_normal_upper_round"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/size_12"/>
        <include
            android:id="@+id/sport_global_view_launch"
            android:background="@color/yellow_light"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-6dp"
            android:layout_below="@+id/sport_global_tab_layout"
            layout="@layout/sport_global_view_launch"/>
    </RelativeLayout>
    <RelativeLayout
        android:orientation="horizontal"
        android:id="@+id/sport_global_goal_go_settings"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginBottom="80dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:id="@+id/goal_setting"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_sport_goal"
            android:scaleType="center"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/margin_40dp"
            android:layout_alignParentStart="true"/>
        <TextView
            android:gravity="center_horizontal"
            android:id="@+id/action_sport"
            android:background="@drawable/sport_go"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="center"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/sport_setting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_sport_config_bg"
            android:scaleType="center"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/margin_40dp"
            android:layout_alignParentEnd="true"/>
        <ImageView
            android:id="@+id/small_red_point"
            android:background="@drawable/icon_small_red_point"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_centerVertical="true"
            android:translationX="-2dp"
            android:translationY="-12dp"
            android:layout_marginEnd="55dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
