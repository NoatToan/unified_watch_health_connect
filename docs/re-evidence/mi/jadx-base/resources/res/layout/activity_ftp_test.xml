<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_ftp_test_0"
    android:paddingTop="17.66dp"
    android:paddingBottom="17.66dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/sport_data_layout"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:minWidth="240dp"
        android:paddingStart="25dp">
        <TextView
            android:textSize="20sp"
            android:textColor="@color/text_color"
            android:id="@+id/audio_title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="93.33dp"
            android:includeFontPadding="false"
            app:layout_constraintBottom_toTopOf="@+id/curDeviceView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="spread_inside"/>
        <TextView
            android:textSize="13.33sp"
            android:textColor="@color/text_color"
            android:gravity="center"
            android:id="@+id/curDeviceView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:minWidth="96dp"
            android:text="@string/sport_bike_is_connected"
            android:includeFontPadding="false"
            app:layout_constraintBottom_toTopOf="@+id/body_condition_tv"
            app:layout_constraintStart_toStartOf="@+id/audio_title_tv"
            app:layout_constraintTop_toBottomOf="@+id/audio_title_tv"/>
        <TextView
            android:textSize="@dimen/dimen_12sp"
            android:textColor="@color/text_color"
            android:gravity="center"
            android:id="@+id/sportDeviceView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:includeFontPadding="false"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/curDeviceView"/>
        <ImageView
            android:id="@+id/link_status_iv"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/course_audio_link_open"
            app:layout_constraintBottom_toBottomOf="@+id/curDeviceView"
            app:layout_constraintStart_toEndOf="@+id/curDeviceView"
            app:layout_constraintTop_toTopOf="@+id/curDeviceView"/>
        <TextView
            android:textSize="33.33sp"
            android:textColor="@color/text_color"
            android:id="@+id/sport_time_tv"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="00:00:00"
            android:includeFontPadding="false"
            android:fontFamily="@font/misanslatin_demibold"
            app:layout_constraintBottom_toTopOf="@+id/course_relativelayout"
            app:layout_constraintStart_toStartOf="@+id/body_condition_tv"
            app:layout_constraintTop_toBottomOf="@+id/body_condition_tv"/>
        <TextView
            android:textSize="26.66sp"
            android:textColor="@color/text_color"
            android:id="@+id/sport_time_pr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="(0%)"
            android:includeFontPadding="false"
            app:layout_constraintBottom_toBottomOf="@+id/sport_time_tv"
            app:layout_constraintStart_toEndOf="@+id/sport_time_tv"
            app:layout_constraintTop_toTopOf="@+id/sport_time_tv"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="horizontal"
            android:id="@+id/course_relativelayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="11.33dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/sport_time_tv"
            app:layout_constraintTop_toBottomOf="@+id/sport_time_tv">
            <TextView
                android:textColor="@color/text_color"
                android:id="@+id/resistanceItem"
                android:layout_width="wrap_content"
                android:layout_height="60dp"
                android:minWidth="85dp"
                android:text=""
                android:includeFontPadding="false"/>
            <TextView
                android:textColor="@color/text_color"
                android:id="@+id/kcalItem"
                android:layout_width="wrap_content"
                android:layout_height="60dp"
                android:minWidth="85dp"
                android:includeFontPadding="false"
                android:layout_marginStart="54.66dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/resistanceItem"/>
            <TextView
                android:textColor="@color/text_color"
                android:id="@+id/powerItem"
                android:layout_width="wrap_content"
                android:layout_height="60dp"
                android:layout_marginTop="16dp"
                android:minWidth="85dp"
                android:includeFontPadding="false"
                android:layout_below="@+id/resistanceItem"
                app:layout_constraintBottom_toTopOf="@+id/targetPower"
                app:layout_constraintTop_toBottomOf="@+id/resistanceItem"/>
            <TextView
                android:id="@+id/cadenceItem"
                android:layout_width="wrap_content"
                android:layout_height="60dp"
                android:minWidth="85dp"
                android:includeFontPadding="false"
                android:layout_below="@+id/kcalItem"
                android:layout_toEndOf="@+id/powerItem"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="@+id/kcalItem"
                app:layout_constraintTop_toTopOf="@+id/powerItem"/>
            <TextView
                android:textSize="6sp"
                android:textColor="@color/black"
                android:gravity="center"
                android:id="@+id/targetPower"
                android:background="@drawable/ftp_selector_vector_target"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:layout_below="@+id/cadenceItem"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="@+id/powerItem"/>
            <TextView
                android:textSize="6sp"
                android:textColor="@color/black"
                android:gravity="center"
                android:id="@+id/targetCadence"
                android:background="@drawable/ftp_selector_vector_target"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:layout_below="@+id/cadenceItem"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="@+id/cadenceItem"
                app:layout_constraintTop_toBottomOf="@+id/cadenceItem"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:textSize="22.66sp"
            android:textColor="@color/text_color"
            android:id="@+id/heartrate_tv"
            android:layout_width="wrap_content"
            android:layout_height="27.2dp"
            android:minWidth="25dp"
            android:includeFontPadding="false"
            android:fontFamily="@font/misanslatin_demibold"
            android:layout_marginStart="70.66dp"
            app:layout_constraintStart_toEndOf="@+id/body_condition_tv"
            app:layout_constraintTop_toTopOf="@+id/body_condition_tv"/>
        <TextView
            android:textSize="8.33sp"
            android:textColor="@color/text_color"
            android:id="@+id/course_textview2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sport_heart_rate"
            android:includeFontPadding="false"
            app:layout_constraintStart_toStartOf="@+id/heartrate_tv"
            app:layout_constraintTop_toBottomOf="@+id/heartrate_tv"/>
        <TextView
            android:textSize="26.66sp"
            android:textColor="@color/text_color"
            android:id="@+id/body_condition_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="17.33dp"
            android:text="@string/course_hr_stage_warmup"
            android:includeFontPadding="false"
            app:layout_constraintBottom_toTopOf="@+id/sport_time_tv"
            app:layout_constraintStart_toStartOf="@+id/curDeviceView"
            app:layout_constraintTop_toBottomOf="@+id/curDeviceView"
            app:layout_constraintVertical_bias="0.5"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/body_condition_ll"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/body_condition_tv"
            app:layout_constraintStart_toEndOf="@+id/body_condition_tv"
            app:layout_constraintTop_toTopOf="@+id/body_condition_tv">
            <View
                android:id="@+id/label0"
                android:background="@color/black_15_transparent"
                android:layout_width="4dp"
                android:layout_height="match_parent"/>
            <View
                android:id="@+id/label1"
                android:background="@color/black_15_transparent"
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:layout_marginStart="2dp"/>
            <View
                android:id="@+id/label2"
                android:background="@color/black_15_transparent"
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:layout_marginStart="2dp"/>
            <View
                android:id="@+id/label3"
                android:background="@color/black_15_transparent"
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:layout_marginStart="2dp"/>
            <View
                android:id="@+id/label4"
                android:background="@color/black_15_transparent"
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:layout_marginStart="2dp"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/course_imageview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/course_audio_heartrate_img"
            android:layout_marginStart="2dp"
            app:layout_constraintStart_toEndOf="@+id/heartrate_tv"
            app:layout_constraintTop_toTopOf="@+id/heartrate_tv"/>
        <TextView
            android:textSize="6.66sp"
            android:textColor="@color/text_color"
            android:id="@+id/course_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sport_fat_burning"
            android:includeFontPadding="false"
            app:layout_constraintBottom_toTopOf="@+id/course_textview2"
            app:layout_constraintEnd_toEndOf="@+id/course_imageview"
            app:layout_constraintStart_toStartOf="@+id/course_imageview"
            app:layout_constraintTop_toBottomOf="@+id/course_imageview"/>
        <com.airbnb.lottie.LottieAnimationView
            android:layout_gravity="center"
            android:id="@+id/countdown_lottie_view"
            android:background="@color/common_white"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:lottie_fileName="lottie/countdown_white.json"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="43dp"
        android:layout_marginEnd="23dp"
        app:layout_constraintEnd_toStartOf="@+id/sport_operation_layout"
        app:layout_constraintStart_toEndOf="@+id/sport_data_layout">
        <TextView
            android:textSize="17sp"
            android:textColor="@color/text_color"
            android:gravity="center"
            android:id="@+id/audio_subtitle_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="106dp"
            android:includeFontPadding="false"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/FontDemiBold"/>
        <com.xiaomi.fitness.sport_eco.ftp.FtpChartView
            android:id="@+id/speed_view"
            android:background="@color/about_gray"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/course_share_bottom"
            android:layout_marginBottom="60dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/audio_subtitle_tv"/>
        <TextView
            android:textColor="@color/text_color"
            android:id="@+id/ftp_chart_tag1"
            android:background="@drawable/ftp_selector_vector_chart_tag"
            android:layout_width="11dp"
            android:layout_height="5.33dp"
            android:layout_marginTop="4dp"
            android:includeFontPadding="false"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/speed_view"/>
        <TextView
            android:textSize="4sp"
            android:textColor="@color/text_color"
            android:gravity="center"
            android:id="@+id/ftp_chart_tag2"
            android:layout_width="wrap_content"
            android:layout_height="5.33dp"
            android:layout_marginTop="4dp"
            android:text="@string/sport_target_power"
            android:includeFontPadding="false"
            android:layout_marginStart="2dp"
            app:layout_constraintStart_toEndOf="@+id/ftp_chart_tag1"
            app:layout_constraintTop_toBottomOf="@+id/speed_view"/>
        <TextView
            android:textColor="@color/text_color"
            android:id="@+id/ftp_chart_tag3"
            android:background="@drawable/ftp_selector_vector_chart_tag"
            android:layout_width="11dp"
            android:layout_height="5.33dp"
            android:layout_marginTop="4dp"
            android:includeFontPadding="false"
            android:layout_marginStart="4dp"
            app:layout_constraintStart_toEndOf="@+id/ftp_chart_tag2"
            app:layout_constraintTop_toBottomOf="@+id/speed_view"/>
        <TextView
            android:textSize="4sp"
            android:textColor="@color/text_color"
            android:id="@+id/ftp_chart_tag4"
            android:layout_width="wrap_content"
            android:layout_height="5.33dp"
            android:layout_marginTop="4dp"
            android:text="@string/sport_actual_power"
            android:includeFontPadding="false"
            android:layout_marginStart="2dp"
            app:layout_constraintStart_toEndOf="@+id/ftp_chart_tag3"
            app:layout_constraintTop_toBottomOf="@+id/speed_view"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/sport_operation_layout"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:paddingEnd="@dimen/margin_27dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/audio_stop_iv"
            android:background="@drawable/course_stop_bg"
            android:visibility="gone"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:src="@drawable/course_audio_stop_img"
            android:scaleType="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/audio_pause_iv"
            android:background="@drawable/course_start_or_pause_bg"
            android:visibility="gone"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_marginBottom="60dp"
            android:src="@drawable/course_audio_pause_img"
            android:scaleType="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <ImageView
            android:id="@+id/audio_start_iv"
            android:background="@drawable/course_start_or_pause_bg"
            android:visibility="gone"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:src="@drawable/course_audio_starting_img"
            android:scaleType="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
