<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_lpa_management_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/lpa_provision_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.xiaomi.fitness.widget.RightArrowTwoLineTextView
            android:id="@+id/lpa_management_eid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/common_set_margin_start"
            android:layout_marginEnd="@dimen/common_set_margin_start"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:title="EID"/>
        <com.xiaomi.fitness.widget.RightArrowTwoLineTextView
            android:id="@+id/lpa_management_imei"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/common_set_margin_start"
            android:layout_marginEnd="@dimen/common_set_margin_start"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/lpa_management_eid"
            app:title="IMEI"/>
        <View
            android:id="@+id/lpa_management_divider"
            android:background="@color/text_color_10"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_marginTop="20dp"
            android:layout_marginStart="@dimen/dimen_margin_26dp"
            android:layout_marginEnd="@dimen/dimen_margin_26dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/lpa_management_imei"/>
        <TextView
            android:textColor="@color/text_color_40"
            android:id="@+id/lpa_management_carrier_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_20dp"
            android:layout_marginBottom="10dp"
            android:text="@string/lpa_management_carrier_title"
            android:layout_marginStart="@dimen/common_set_margin_start"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/lpa_management_divider"
            style="@style/FontNormal.12sp"/>
        <com.xiaomi.fitness.widget.RightArrowSingleLineTextView
            android:id="@+id/lpamanagement_cm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/common_set_margin_start"
            android:layout_marginEnd="@dimen/common_set_margin_start"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/lpa_management_carrier_title"
            app:title="@string/lpa_management_cm"/>
        <com.xiaomi.fitness.widget.RightArrowSingleLineTextView
            android:id="@+id/lpamanagement_cu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/common_set_margin_start"
            android:layout_marginEnd="@dimen/common_set_margin_start"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/lpamanagement_cm"
            app:title="@string/lpa_management_cu"/>
        <com.xiaomi.fitness.widget.RightArrowSingleLineTextView
            android:id="@+id/lpamanagement_ct"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/common_set_margin_start"
            android:layout_marginEnd="@dimen/common_set_margin_start"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/lpamanagement_cu"
            app:title="@string/lpa_management_ct"/>
        <TextView
            android:textColor="@color/text_color_40"
            android:id="@+id/lpa_profile_tips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dimen_margin_20dp"
            android:text="@string/lpa_management_tips"
            android:layout_marginStart="@dimen/feature_item_start_padding"
            android:layout_marginEnd="@dimen/feature_item_end_padding"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/FontMedium.14sp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/lpa_profile_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.xiaomi.fitness.widget.RightArrowSingleLineTextView
            android:id="@+id/lpa_profile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/common_set_margin_start"
            android:layout_marginEnd="@dimen/common_set_margin_start"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.xiaomi.fitness.widget.RightArrowTwoLineTextView
            android:id="@+id/lpa_profile_eid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/common_set_margin_start"
            android:layout_marginEnd="@dimen/common_set_margin_start"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/lpa_profile"
            app:title="EID"/>
        <com.xiaomi.fitness.widget.RightArrowTwoLineTextView
            android:id="@+id/lpa_profile_imei"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/common_set_margin_start"
            android:layout_marginEnd="@dimen/common_set_margin_start"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/lpa_profile_eid"
            app:title="IMEI"/>
        <com.xiaomi.fitness.widget.RightArrowTwoLineTextView
            android:id="@+id/lpa_profile_iccid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/common_set_margin_start"
            android:layout_marginEnd="@dimen/common_set_margin_start"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/lpa_profile_imei"
            app:title="ICCID"/>
        <View
            android:id="@+id/divider"
            android:background="@color/black_10"
            android:layout_width="match_parent"
            android:layout_height="0.3dp"
            android:layout_marginTop="@dimen/dimen_margin_20dp"
            android:layout_marginStart="@dimen/common_set_margin_start"
            android:layout_marginEnd="@dimen/common_set_margin_start"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/lpa_profile_iccid"/>
        <TextView
            android:textColor="@color/text_color_60"
            android:id="@+id/disable_info_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_30dp"
            android:text="@string/lpa_disable_info_title"
            android:layout_marginStart="@dimen/common_set_margin_start"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/divider"
            style="@style/FontRegular.14sp"/>
        <TextView
            android:textColor="@color/text_color_60"
            android:id="@+id/disable_info_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/lpa_disable_subtitle"
            android:layout_marginStart="@dimen/common_set_margin_start"
            android:layout_marginEnd="@dimen/common_set_margin_start"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/disable_info_title"
            style="@style/FontRegular.14sp"/>
        <TextView
            android:textColor="@color/text_color_60"
            android:id="@+id/delete_info_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_20dp"
            android:text="@string/lpa_delete_info_title"
            android:layout_marginStart="@dimen/common_set_margin_start"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/disable_info_content"
            style="@style/FontRegular.14sp"/>
        <TextView
            android:textColor="@color/text_color_60"
            android:id="@+id/delete_info_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/lpa_delete_subtitle"
            android:layout_marginStart="@dimen/common_set_margin_start"
            android:layout_marginEnd="@dimen/common_set_margin_start"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/delete_info_title"
            style="@style/FontRegular.14sp"/>
        <Button
            android:id="@+id/lpa_btn_deactive"
            android:visibility="gone"
            android:text="@string/lpa_profile_btn_disable"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/CommonBtn.Normal"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <Button
                android:id="@+id/lpa_btn_delete"
                android:visibility="gone"
                android:layout_width="0dp"
                android:text="@string/lpa_profile_btn_delete"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/lpa_btn_enable"
                app:layout_constraintStart_toStartOf="parent"
                style="@style/CommonBtn.Normal"/>
            <Button
                android:id="@+id/lpa_btn_enable"
                android:visibility="gone"
                android:layout_width="0dp"
                android:text="@string/lpa_profile_btn_enable"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/lpa_btn_delete"
                style="@style/CommonBtn.Primary"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
