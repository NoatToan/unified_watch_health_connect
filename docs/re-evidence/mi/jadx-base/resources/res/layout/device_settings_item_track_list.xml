<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/contentView"
    android:tag="layout/device_settings_item_track_list_0"
    android:background="@drawable/device_settings_selector_list_item_round"
    android:layout_width="match_parent"
    android:layout_height="90dp"
    android:layout_marginBottom="5dp"
    android:paddingStart="@dimen/dimen_margin_15dp"
    android:layout_marginStart="5dp"
    android:layout_marginEnd="5dp">
    <ImageView
        android:id="@+id/icon"
        android:layout_width="75dp"
        android:layout_height="75dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/text_color"
        android:ellipsize="end"
        android:id="@+id/nameView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minWidth="150dp"
        android:minHeight="20dp"
        android:maxLines="1"
        android:layout_marginStart="@dimen/dimen_margin_15dp"
        android:layout_marginEnd="75dp"
        app:layout_constraintBottom_toTopOf="@+id/infoView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/text_color_60"
        android:id="@+id/infoView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_5dp"
        android:minWidth="50dp"
        android:minHeight="15dp"
        android:layout_marginStart="@dimen/dimen_margin_15dp"
        android:layout_marginEnd="@dimen/dimen_margin_30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/icon"
        app:layout_constraintTop_toBottomOf="@+id/nameView"/>
    <FrameLayout
        android:id="@+id/fl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_margin_15dp"
        android:layout_marginEnd="@dimen/dimen_margin_25dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/right_arrow"
            android:background="@drawable/ic_base_right_arrow_icon_size_48"
            android:layout_width="20dp"
            android:layout_height="20dp"/>
        <View
            android:layout_gravity="center_vertical"
            android:id="@+id/check_view"
            android:background="@drawable/device_settings_track_checkbox"
            android:visibility="gone"
            android:layout_width="25dp"
            android:layout_height="25dp"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
