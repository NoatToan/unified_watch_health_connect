<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/device_settings_fragment_hotspot_0"
    android:paddingTop="@dimen/common_set_margin_start"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/page_padding_horizontal_large">
    <ImageView
        android:id="@+id/deviceView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/device_settings_hotspot_device"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/device_settings_hotspot_device_icon"
        app:layout_constraintBottom_toBottomOf="@+id/deviceView"
        app:layout_constraintEnd_toStartOf="@+id/netView"
        app:layout_constraintStart_toEndOf="@+id/deviceView"
        app:layout_constraintTop_toTopOf="@+id/deviceView"/>
    <ImageView
        android:id="@+id/netView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/device_settings_hotspot_device_net"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/text_color"
        android:id="@+id/q1View"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="42dp"
        android:text="@string/device_settings_hotspot_q1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/deviceView"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/text_color_60"
        android:id="@+id/a1View"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/device_settings_hotspot_a1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/q1View"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/text_color"
        android:id="@+id/q2View"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="@string/device_settings_hotspot_q2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/a1View"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/text_color_60"
        android:id="@+id/a2View"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/device_settings_hotspot_a2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/q2View"/>
    <TextView
        android:textStyle="bold"
        android:id="@+id/goOpenView"
        android:layout_marginTop="20dp"
        android:text="@string/device_settings_common_go_open"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/a2View"
        style="@style/CommonBtn.Normal"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/text_color"
        android:id="@+id/q3View"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="@string/device_settings_hotspot_q3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/goOpenView"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/text_color_60"
        android:id="@+id/a3View"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/device_settings_hotspot_a3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/q3View"/>
</androidx.constraintlayout.widget.ConstraintLayout>
