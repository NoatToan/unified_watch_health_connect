<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:paddingTop="@dimen/size_17_3"
    android:paddingBottom="@dimen/size_17_3"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/page_content_padding_horizontal_large">
    <TextView
        android:textColor="@color/text_color"
        android:gravity="start"
        android:layout_gravity="center_vertical"
        android:id="@+id/tv_left"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        style="@style/FontMedium.16sp"/>
    <TextView
        android:textColor="@color/text_color_40"
        android:gravity="end"
        android:layout_gravity="center_vertical"
        android:id="@+id/tv_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        style="@style/FontRegular.14sp"/>
    <TextView
        android:textSize="@dimen/text_size_9"
        android:textColor="@color/text_color"
        android:layout_gravity="center_vertical"
        android:id="@+id/tv_level_type"
        android:background="@drawable/shape_blood_glucose_high"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="3dp"
        android:paddingHorizontal="3dp"
        style="@style/FontRegular"/>
</LinearLayout>
