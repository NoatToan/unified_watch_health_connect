<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_global_launch_sport_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container"
        android:paddingBottom="40dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_20dp"
        android:paddingHorizontal="@dimen/page_padding_horizontal_large">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/total_distance_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dimen_margin_13dp"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/text_color_40"
                android:gravity="center_vertical"
                android:id="@+id/titleTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="33sp"
                android:textColor="@color/text_color"
                android:id="@+id/value_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6.3dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/titleTv"
                style="@style/FontDemiBold"/>
            <TextView
                android:textSize="@dimen/dimen_12sp"
                android:textColor="@color/text_color"
                android:id="@+id/unit_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBaseline_toBaselineOf="@+id/value_tv"
                app:layout_constraintStart_toEndOf="@+id/value_tv"
                style="@style/FontRegular"/>
            <TextView
                android:textSize="@dimen/dimen_14sp"
                android:textColor="@color/text_color_80"
                android:id="@+id/hr_tv"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="5.3dp"
                app:layout_constraintBaseline_toBaselineOf="@+id/value_tv"
                app:layout_constraintEnd_toEndOf="parent"
                style="@style/FontDemiBold.14sp"/>
            <TextView
                android:textSize="@dimen/dimen_12sp"
                android:id="@+id/weather_desc"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toTopOf="@+id/hr_tv"
                app:layout_constraintEnd_toEndOf="parent"
                style="@style/FontLatinDemiBold"/>
            <ImageView
                android:id="@+id/weather_icon"
                android:visibility="gone"
                android:layout_width="30dp"
                android:layout_height="@dimen/dimen_margin_30dp"
                app:layout_constraintBottom_toTopOf="@+id/weather_desc"
                app:layout_constraintEnd_toEndOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bg_container"
            android:layout_width="match_parent"
            android:layout_height="400dp"
            app:layout_constraintTop_toBottomOf="@+id/total_distance_group">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/bg_cl"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.cardview.widget.CardView
                    android:id="@+id/launch_map_card_view"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardCornerRadius="@dimen/dimen_margin_16dp"
                    app:cardElevation="0dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <com.mi.health.sport.SportLaunchMapView
                        android:id="@+id/launchMap"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginHorizontal="-10dp"
                        android:layout_marginVertical="-10dp"/>
                </androidx.cardview.widget.CardView>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/indoor_running_bg"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="400dp"
                    android:scaleType="centerCrop"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/dimen_14sp"
                    android:ellipsize="marquee"
                    android:id="@+id/phone_placement_advice"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    android:maxWidth="150dp"
                    android:text="@string/sport_phone_plaec"
                    android:singleLine="true"
                    android:drawablePadding="5.3dp"
                    android:layout_marginStart="@dimen/dimen_margin_13dp"
                    android:layout_marginEnd="@dimen/dimen_margin_20dp"
                    app:drawableEndCompat="@drawable/sport_arrow_right"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/indoor_running_bg"
                    style="@style/FontRegular"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/connected_devices_recycler_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    android:layout_marginEnd="@dimen/dimen_margin_20dp"
                    android:translationZ="@dimen/dimen_margin_10dp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:layout_constraintEnd_toEndOf="@+id/bg_cl"
                    app:layout_constraintTop_toTopOf="@+id/bg_cl"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <com.xiaomi.fitness.sport.view.widget.GpsSignalView
                android:id="@+id/gpsSignalView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_20dp"
                android:layout_marginStart="@dimen/margin_20dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/bg_cl"
                app:layout_constraintVertical_bias="0.42"/>
            <RelativeLayout
                android:orientation="horizontal"
                android:id="@+id/controller_group"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginBottom="@dimen/dimen_margin_30dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">
                <TextView
                    android:gravity="center_horizontal"
                    android:id="@+id/action_sport"
                    android:background="@drawable/sport_go"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scaleType="center"
                    android:layout_centerInParent="true"
                    android:contentDescription="@string/talkback_start_sport"/>
                <ImageView
                    android:id="@+id/sport_setting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_sport_config_bg"
                    android:scaleType="center"
                    android:layout_centerVertical="true"
                    android:contentDescription="@string/talkback_sport_config"
                    android:layout_marginEnd="@dimen/margin_40dp"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/banner_recycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_12dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintTop_toBottomOf="@+id/bg_container"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
