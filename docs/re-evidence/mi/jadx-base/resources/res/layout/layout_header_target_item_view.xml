<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/llFirstLayout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_above="@+id/llSecondLayout">
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/img_first"
        android:layout_width="@dimen/health_target_img_square_height"
        android:layout_height="@dimen/health_target_img_square_height"
        android:scaleType="centerInside"
        android:layout_marginEnd="@dimen/size_5"/>
    <TextView
        android:textSize="@dimen/dimen_16sp"
        android:textColor="@color/health_home_txt_color"
        android:gravity="center_vertical"
        android:id="@+id/txt_target_str"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:fontFamily="@font/misanslatin_semibold"/>
    <TextView
        android:textColor="@color/health_home_target_unit"
        android:id="@+id/txt_target_unit"
        android:paddingBottom="@dimen/size_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="1dp"
        style="@style/FontDemiBold.12sp"/>
</merge>
