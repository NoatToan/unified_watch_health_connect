<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:background="@drawable/widget_default_corners_transparent_background_20"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:maxWidth="170dp"
    android:maxHeight="65dp">
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_sleep_2_1_bg_os3"
        android:scaleType="fitXY"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@android:id/widget_frame"
        android:background="@color/transparent"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="12"/>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:baselineAligned="false"
            android:layout_weight="92.5">
            <TextView
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="12.5"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#4b5ef6"
                android:gravity="start|center_vertical"
                android:id="@+id/widgetSleepTitle"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:text="@string/widget_sleep_title"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:layout_weight="16"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="2sp"
                android:autoSizeMaxTextSize="12sp"
                android:textFontWeight="450"/>
            <TextView
                android:textSize="13.87sp"
                android:textColor="@color/text_color"
                android:gravity="start|center_vertical"
                android:id="@+id/widgetSleepValue"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:text="@string/widget_start_record"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:layout_weight="18"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="2sp"
                android:autoSizeMaxTextSize="13.87sp"
                android:textFontWeight="380"/>
            <TextView
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="13.5"/>
        </LinearLayout>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/iv_sleep_image"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:src="@drawable/widget_sleep_bed_2_1_os3"
            android:adjustViewBounds="true"
            android:layout_weight="42"
            android:importantForAccessibility="no"/>
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="13.5"/>
    </LinearLayout>
</FrameLayout>
