<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/trail_total_diving_statistics_card_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/statistics_card"
        android:background="@drawable/trail_item_bg"
        android:paddingTop="30dp"
        android:paddingBottom="30dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/dimen_margin_18dp"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/first_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="2"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/accumulative_times_group"
                android:layout_width="@dimen/dimen_margin_0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingEnd="@dimen/dimen_margin_10dp">
                <TextView
                    android:textColor="@color/text_color_40"
                    android:id="@+id/accumulative_times_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/trail_accumulative_diving_times"
                    style="@style/TrailTotalLabel"/>
                <TextView
                    android:id="@+id/accumulative_times_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/TrailTotalValue"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/max_depth_group"
                android:layout_width="@dimen/dimen_margin_0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textColor="@color/text_color_40"
                    android:id="@+id/max_depth_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/trail_sport_max_diving_depth_title"
                    style="@style/TrailTotalLabel"/>
                <TextView
                    android:id="@+id/max_depth_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/TrailTotalValue"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/second_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:weightSum="2"
            app:layout_constraintTop_toBottomOf="@+id/first_line">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/visited_region_group"
                android:layout_width="@dimen/dimen_margin_0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingEnd="@dimen/dimen_margin_10dp">
                <TextView
                    android:textColor="@color/text_color_40"
                    android:id="@+id/visited_region_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/trail_visited_countries_or_regions"
                    style="@style/TrailTotalLabel"/>
                <TextView
                    android:textSize="33sp"
                    android:textColor="@color/trail_black_90white"
                    android:gravity="center_vertical"
                    android:id="@+id/visited_region_value"
                    android:layout_width="match_parent"
                    style="@style/TrailTotalValue"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/visited_diving_point_count_group"
                android:layout_width="@dimen/dimen_margin_0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textColor="@color/text_color_40"
                    android:id="@+id/visited_diving_point_count_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/trail_diving_point_where_i_have_been_to"
                    style="@style/TrailTotalLabel"/>
                <TextView
                    android:id="@+id/visited_diving_point_count_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/TrailTotalValue"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/third_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/second_line">
            <TextView
                android:textColor="@color/text_color_40"
                android:id="@+id/most_frequent_diving_point_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/trail_most_frequent_diving_point"
                style="@style/TrailTotalLabel"/>
            <TextView
                android:textSize="17sp"
                android:id="@+id/most_frequent_diving_point_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_6dp"
                style="@style/FontMedium"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
