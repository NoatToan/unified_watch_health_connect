<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_blood_pressure_day_r_item_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/blood_pressure_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/dimen_margin_12dp"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/daily_card_detail"
            android:background="@drawable/shape_data_item_bg"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/health_detail_page_common_margin_vertical"
            android:layout_marginHorizontal="@dimen/health_detail_page_common_margin_horizontal">
            <TextView
                android:id="@+id/tv_label"
                android:focusable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/health_data_detail_day"
                android:layout_marginStart="@dimen/size_10"
                app:layout_constraintBottom_toBottomOf="@+id/iv_icon"
                app:layout_constraintStart_toEndOf="@+id/iv_icon"
                app:layout_constraintTop_toTopOf="@+id/iv_icon"
                style="@style/CardTextAppearance.LabelTitle"/>
            <View
                android:id="@+id/divider_line_top"
                android:background="@color/common_divider_bg_color"
                android:layout_width="0dp"
                android:layout_height="@dimen/size_0_33"
                android:layout_marginTop="@dimen/size_20"
                android:layout_marginStart="@dimen/size_18"
                android:layout_marginEnd="@dimen/size_18"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/iv_icon"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_20"
                android:layout_marginStart="@dimen/size_18"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_blood_pressure_data_detail"/>
            <miuix.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_detail"
                android:paddingBottom="@dimen/size_20"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_10"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/divider_line_top"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_distribute"
            android:background="@drawable/shape_data_item_bg"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/health_detail_page_common_margin_vertical"
            android:overScrollMode="never"
            android:layout_marginHorizontal="@dimen/health_detail_page_common_margin_horizontal"/>
    </LinearLayout>
    <TextView
        android:gravity="center"
        android:id="@+id/dataTitleView"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/no_data"
        android:drawableTop="@drawable/icon_nothing"
        android:drawablePadding="@dimen/dimen_margin_10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
