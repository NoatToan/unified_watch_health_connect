<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_sleep_score"
    android:tag="layout/layout_sleep_score_0"
    android:background="@drawable/selector_card_bg"
    android:paddingTop="@dimen/size_20"
    android:paddingBottom="@dimen/size_20"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/size_13"
    android:paddingStart="@dimen/size_18"
    android:paddingEnd="@dimen/size_18">
    <TextView
        android:textSize="@dimen/font_33_3"
        android:textColor="@color/text_color"
        android:id="@+id/tv_empty_text"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="--"
        style="@style/FontMedium"/>
    <RelativeLayout
        android:id="@+id/layout_accurate"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/font_18"
            android:textColor="@color/text_color"
            android:id="@+id/tv_accurate_score_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/health_sleep_quality_score_title"
            android:drawablePadding="@dimen/size_3_3"
            style="@style/FontMedium"/>
        <TextView
            android:textSize="40sp"
            android:textColor="@color/text_color"
            android:id="@+id/tv_sleep_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:layout_below="@+id/tv_accurate_score_title"
            style="@style/FontLatinSemiBold"/>
        <TextView
            android:textSize="@dimen/font_13_33"
            android:textColor="@color/text_color_80"
            android:id="@+id/tv_sleep_score_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@+id/tv_sleep_score"
            android:layout_alignBaseline="@+id/tv_sleep_score"
            style="@style/FontMedium"/>
        <TextView
            android:textSize="@dimen/font_14"
            android:textColor="@color/text_color"
            android:id="@+id/tv_accurate_evaluate_result"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="@dimen/size_3_3"
            android:layout_below="@+id/tv_sleep_score"
            android:drawableEnd="@drawable/health_ic_question"
            style="@style/FontMedium"/>
        <TextView
            android:textSize="@dimen/font_13_33"
            android:textColor="@color/text_color"
            android:id="@+id/tv_accurate_score_tip"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_4"
            android:layout_below="@+id/tv_accurate_evaluate_result"
            style="@style/FontMedium"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/layout_fuzzy"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/font_13_3"
            android:textColor="@color/text_color"
            android:id="@+id/tv_fuzzy_score_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/health_sleep_quality_score_evaluate_title"
            android:drawablePadding="@dimen/size_3_3"
            style="@style/FontMedium"/>
        <TextView
            android:textSize="29.3dp"
            android:textColor="@color/text_color"
            android:id="@+id/tv_fuzzy_evaluation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tv_fuzzy_score_title"
            style="@style/FontLatinSemiBold"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_fuzzy_evaluation_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@+id/tv_fuzzy_score_title"
            android:layout_toEndOf="@+id/tv_fuzzy_score_title"
            app:srcCompat="@drawable/health_ic_question"/>
        <View
            android:id="@+id/divider_line"
            android:background="@color/common_divider_bg_color"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_0_33"
            android:layout_marginTop="@dimen/size_20"
            android:layout_marginBottom="@dimen/size_20"
            android:layout_below="@+id/tv_fuzzy_evaluation"/>
        <TextView
            android:textColor="@color/text_color"
            android:id="@+id/tv_open_tip"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/health_sleep_quality_score_evaluate_desc"
            android:layout_below="@+id/divider_line"
            android:layout_toStartOf="@+id/tv_open"
            style="@style/FontNormal.12sp"/>
        <TextView
            android:textColor="@color/selector_common_btn_primary_text_color"
            android:gravity="center"
            android:id="@+id/tv_open"
            android:background="@drawable/selector_bottom_button_red"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="0dp"
            android:text="@string/health_sleep_quality_score_evaluate_open"
            android:layout_below="@+id/divider_line"
            android:layout_alignParentEnd="true"
            android:paddingHorizontal="@dimen/dimen_margin_22dp"
            android:paddingVertical="@dimen/size_10"/>
    </RelativeLayout>
</FrameLayout>
