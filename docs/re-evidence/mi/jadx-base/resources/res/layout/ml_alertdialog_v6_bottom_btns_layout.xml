<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:ml="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ml_alertdialog_buttonPanel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:padding="@dimen/dimen_margin_26dp"
        android:layout_width="match_parent"
        android:layout_height="105dp">
        <com.xiaomi.fitness.baseui.widget.BottomButtonV6
            android:gravity="center"
            android:id="@+id/ml_alertdialog_button2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text=""
            android:singleLine="true"
            android:layout_weight="1"
            ml:feedback_ml_alertdialog_button_position="left"
            ml:feedback_ml_alertdialog_button_style="normal"
            ml:feedback_ml_alertdialog_button_text_style="bold"/>
        <View
            android:id="@+id/ml_alertdialog_button3_line"
            android:visibility="gone"
            style="@style/VerticalSeparatorLine"/>
        <com.xiaomi.fitness.baseui.widget.BottomButtonV6
            android:gravity="center"
            android:id="@+id/ml_alertdialog_button3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text=""
            android:singleLine="true"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/dimen_margin_13dp"
            ml:feedback_ml_alertdialog_button_position="center"
            ml:feedback_ml_alertdialog_button_style="normal"
            ml:feedback_ml_alertdialog_button_text_style="bold"/>
        <View
            android:id="@+id/ml_alertdialog_button1_line"
            android:visibility="gone"
            style="@style/VerticalSeparatorLine"/>
        <com.xiaomi.fitness.baseui.widget.BottomButtonV6
            android:gravity="center"
            android:id="@+id/ml_alertdialog_button1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text=""
            android:singleLine="true"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/dimen_margin_13dp"
            ml:feedback_ml_alertdialog_button_position="right"
            ml:feedback_ml_alertdialog_button_style="emphasize"
            ml:feedback_ml_alertdialog_button_text_style="bold"/>
    </LinearLayout>
</LinearLayout>
