<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sleepInterfereReportSleepRegularityCardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    app:cardBackgroundColor="@color/common_card_bg_color"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp">
    <LinearLayout
        android:orientation="vertical"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/size_13_3"
            android:layout_marginHorizontal="20dp"
            android:layout_marginVertical="20dp">
            <ImageView
                android:id="@+id/sleepInterfereReportDurationTitleImageView"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/sleep_detail_title"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="20sp"
                android:textColor="@color/text_color"
                android:id="@+id/sleepInterfereReportDurationTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/health_sleep_average_sleep_duration"
                android:paddingHorizontal="8dp"
                android:textFontWeight="500"/>
        </LinearLayout>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp">
            <TextView
                android:textSize="36sp"
                android:textColor="@color/text_color"
                android:layout_gravity="bottom"
                android:id="@+id/sleepAverageDurationTimeTextView"
                android:paddingBottom="6.7dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/health_sleep_avg"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5.3dp">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_chart_interactive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/size_18"
                android:layout_marginEnd="@dimen/size_18">
                <TextView
                    android:textSize="11sp"
                    android:textColor="#6750f1"
                    android:gravity="start"
                    android:id="@+id/tv_high_light_tip"
                    android:background="@drawable/health_sleep_tip_purple_bg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="1dp"
                    android:paddingHorizontal="@dimen/size_8"
                    android:paddingVertical="4.3dp"
                    style="@style/FontMedium"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/level_desc_recyclerview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13.3dp"/>
            </LinearLayout>
            <com.xiaomi.fitness.health.sleep.interfere.report.charts.SleepDurationStackedBarChart
                android:id="@+id/sleepInterfereSleepDurationStackedBarChart"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:layout_marginTop="20dp"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
