<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/device_settings_todo_remind_item_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/size_12">
    <TextView
        android:textColor="@color/text_color_40"
        android:id="@+id/tv_category_label"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/size_26_67"
        android:paddingVertical="@dimen/size_8"
        style="@style/FontRegular.12sp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/selector_card_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="17.3dp"
        android:paddingHorizontal="18dp"
        android:paddingVertical="20dp">
        <CheckBox
            android:id="@+id/check_box_mark"
            android:background="@drawable/device_settings_selector_todo_remind_check"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:checked="false"
            android:button="@null"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textColor="@color/text_color"
            android:ellipsize="end"
            android:id="@+id/tv_title"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:layout_marginStart="@dimen/size_12"
            android:layout_marginEnd="@dimen/size_12"
            app:layout_constraintBottom_toTopOf="@+id/tv_subtitle"
            app:layout_constraintEnd_toStartOf="@+id/check_box_delete"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/check_box_mark"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            style="@style/FontMedium.14sp"/>
        <TextView
            android:textColor="@color/text_color_40"
            android:ellipsize="end"
            android:id="@+id/tv_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:layout_marginStart="@dimen/size_12"
            android:layout_marginEnd="@dimen/size_12"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/check_box_delete"
            app:layout_constraintStart_toEndOf="@+id/check_box_mark"
            app:layout_constraintTop_toBottomOf="@+id/tv_title"
            style="@style/FontRegular.12sp"/>
        <CheckBox
            android:id="@+id/check_box_delete"
            android:background="@drawable/selector_check"
            android:visibility="gone"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:checked="false"
            android:button="@null"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
