<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/movie_player_3g_tip_root"
    android:background="@color/color_212121"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/movie_player_3g_content_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true">
        <TextView
            android:textSize="13sp"
            android:textColor="@android:color/white"
            android:id="@+id/mobile_net_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="54dp"
            android:text="@string/common_exoplay_player_3g_tip_title"/>
        <TextView
            android:id="@+id/player_mobile_net_retry"
            android:background="@drawable/player_error_continue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="52.4dp"/>
    </LinearLayout>
</RelativeLayout>
