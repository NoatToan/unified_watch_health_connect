<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:background="@drawable/pk_card_white_bg_radius_48"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/size_12"
    android:paddingHorizontal="@dimen/size_18"
    android:paddingVertical="@dimen/size_13_67">
    <com.xiaomi.fitness.widget.view.RoundImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/iv_avatar"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:src="@drawable/ic_pk_avatar_default"/>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="16dp">
        <TextView
            android:textColor="@color/text_color"
            android:ellipsize="end"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            style="@style/FontDemiBold.16sp"/>
        <TextView
            android:textColor="@color/text_color"
            android:id="@+id/tv_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/FontRegular.12sp"/>
    </LinearLayout>
    <TextView
        android:textColor="@color/selector_common_btn_primary_text_color"
        android:layout_gravity="center_vertical"
        android:id="@+id/tv_action"
        android:background="@drawable/selector_bottom_button_red"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        style="@style/FontMedium.12sp"/>
</LinearLayout>
