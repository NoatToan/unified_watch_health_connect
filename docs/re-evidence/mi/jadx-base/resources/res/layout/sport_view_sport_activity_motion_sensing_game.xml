<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/banner"
    android:tag="layout/sport_view_sport_activity_motion_sensing_game_0"
    android:background="@drawable/sport_aidong_banner_bg"
    android:layout_width="336dp"
    android:layout_height="170dp"
    android:layout_marginVertical="@dimen/dimen_margin_20dp">
    <ImageView
        android:id="@+id/mi_logo"
        android:background="@drawable/sport_round_corner_mi_logo"
        android:layout_width="@dimen/dimen_margin_12dp"
        android:layout_height="@dimen/dimen_margin_12dp"
        android:layout_marginTop="@dimen/dimen_margin_18dp"
        android:contentDescription="@string/app_name"
        android:layout_marginStart="21.33dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="9.56sp"
        android:textColor="@color/white"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:layout_marginStart="3dp"
        app:layout_constraintStart_toEndOf="@+id/mi_logo"
        app:layout_constraintTop_toTopOf="@+id/mi_logo"/>
    <com.xiaomi.fitness.widget.view.DividerView
        android:id="@+id/vertical_divider"
        android:layout_width="2dp"
        android:layout_height="@dimen/dimen_margin_10dp"
        android:layout_marginStart="5.4dp"
        app:isHorizontal="true"
        app:layout_constraintBottom_toBottomOf="@+id/title"
        app:layout_constraintStart_toEndOf="@+id/title"
        app:layout_constraintTop_toTopOf="@+id/title"/>
    <ImageView
        android:id="@+id/aidong_logo"
        android:background="@drawable/sport_aidong_logo"
        android:layout_width="44.67dp"
        android:layout_height="@dimen/dimen_margin_12dp"
        android:contentDescription="@string/sport_aidong_app_name"
        android:layout_marginStart="4.33dp"
        app:layout_constraintBottom_toBottomOf="@+id/title"
        app:layout_constraintStart_toEndOf="@+id/vertical_divider"
        app:layout_constraintTop_toTopOf="@+id/title"/>
    <TextView
        android:textSize="21sp"
        android:textColor="@color/white"
        android:id="@+id/aidong_slogan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_22dp"
        android:text="@string/sport_aidong_beats_everything"
        android:fontFamily="@font/misanslatin_semibold"
        android:layout_marginStart="21.33dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <TextView
        android:textSize="@dimen/dimen_11sp"
        android:textColor="@color/white_60"
        android:id="@+id/aidong_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_3dp"
        android:text="@string/sport_aidong_description"
        android:layout_marginStart="21.33dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/aidong_slogan"/>
    <TextView
        android:textColor="@color/white"
        android:gravity="center"
        android:background="@drawable/shape_bottom_btn_positive_bg_normal"
        android:layout_width="77.3dp"
        android:layout_height="26.67dp"
        android:layout_marginBottom="@dimen/dimen_margin_23dp"
        android:text="@string/sport_start_training"
        android:layout_marginStart="21.33dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/FontMedium.12sp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
