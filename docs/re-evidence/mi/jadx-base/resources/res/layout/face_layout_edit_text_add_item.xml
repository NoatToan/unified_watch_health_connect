<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/face_layout_edit_text_add_item_0"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/image_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/face_edit_text_item_add"
        android:layout_marginVertical="@dimen/dimen_margin_7dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/common_btn_normal_text_color"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/face_edit_text_add"
        android:layout_marginStart="@dimen/dimen_margin_8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/image_view"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/FontLatinMedium"/>
</androidx.constraintlayout.widget.ConstraintLayout>
