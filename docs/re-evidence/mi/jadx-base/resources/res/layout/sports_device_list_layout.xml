<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/selector_round"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/health_detail_page_common_margin_vertical">
    <ImageView
        android:id="@+id/device_list_icon"
        android:background="@drawable/ic_stress_data_source"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_22_33"
        android:layout_marginBottom="@dimen/size_22_33"
        android:layout_marginStart="@dimen/size_18"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/text_color"
        android:id="@+id/device_list_datasource"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_20"
        android:text="@string/health_data_device_list_source"
        android:layout_marginStart="@dimen/size_10"
        app:layout_constraintStart_toEndOf="@+id/device_list_icon"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/FontMedium.14sp"/>
    <TextView
        android:textColor="@color/text_color_40"
        android:gravity="start"
        android:id="@+id/device_list_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="当前设备小米手表"
        android:textDirection="locale"
        android:textAlignment="gravity"
        android:layout_marginStart="@dimen/size_10"
        android:layout_marginEnd="@dimen/dimen_margin_10dp"
        app:layout_constraintEnd_toStartOf="@+id/device_list_change_device"
        app:layout_constraintStart_toEndOf="@+id/device_list_icon"
        app:layout_constraintTop_toBottomOf="@+id/device_list_datasource"
        style="@style/FontRegular.12sp"/>
    <TextView
        android:textColor="@color/text_color_40"
        android:gravity="center"
        android:id="@+id/device_list_change_device"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:text="@string/health_data_device_list_change_device"
        android:drawableEnd="@drawable/device_list_change_device_icon"
        android:layout_marginEnd="@dimen/dimen_margin_18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_default="spread"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/FontRegular.14sp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
