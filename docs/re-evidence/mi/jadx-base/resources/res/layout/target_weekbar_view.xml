<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.xiaomi.fitness.health.threetarget.view.TargetWeekBarItemView
        android:id="@+id/targetMON"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"/>
    <com.xiaomi.fitness.health.threetarget.view.TargetWeekBarItemView
        android:id="@+id/targetTUE"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"/>
    <com.xiaomi.fitness.health.threetarget.view.TargetWeekBarItemView
        android:id="@+id/targetWED"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"/>
    <com.xiaomi.fitness.health.threetarget.view.TargetWeekBarItemView
        android:id="@+id/targetTHU"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"/>
    <com.xiaomi.fitness.health.threetarget.view.TargetWeekBarItemView
        android:id="@+id/targetFRI"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"/>
    <com.xiaomi.fitness.health.threetarget.view.TargetWeekBarItemView
        android:id="@+id/targetSAT"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"/>
    <com.xiaomi.fitness.health.threetarget.view.TargetWeekBarItemView
        android:id="@+id/targetSUN"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"/>
</LinearLayout>
