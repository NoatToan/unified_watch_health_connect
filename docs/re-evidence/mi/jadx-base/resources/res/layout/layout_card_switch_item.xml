<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_item_rootview"
    android:layout_width="match_parent"
    android:layout_height="@dimen/common_card_item_height">
    <ImageView
        android:id="@+id/card_switch_left_img"
        android:layout_width="@dimen/common_card_left_icon_width"
        android:layout_height="@dimen/common_card_left_icon_width"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="13dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/card_switch"
        app:layout_constraintStart_toEndOf="@+id/card_switch_left_img"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginLeft="0dp">
        <TextView
            android:textSize="@dimen/common_card_des_text_size"
            android:textColor="@color/common_item_main_title_txt_color"
            android:id="@+id/card_switch_name_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""/>
        <TextView
            android:textSize="@dimen/common_card_des_text_size"
            android:textColor="@color/common_item_sub_title_txt_color"
            android:id="@+id/card_switch_sub_tv"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""/>
    </LinearLayout>
    <com.xiaomi.fitness.widget.button.SwitchButton
        android:id="@+id/card_switch"
        android:layout_width="@dimen/lib_sb_width"
        android:layout_height="@dimen/lib_sb_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.xiaomi.fitness.widget.view.DividerView
        android:id="@+id/line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"/>
</merge>
