<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/pk_detail_layout_no_pk_no_invitation_0"
    android:paddingBottom="@dimen/dimen_margin_14dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:background="@drawable/pk_shape_card_bg"
        android:paddingTop="16.67dp"
        android:paddingBottom="@dimen/dimen_margin_20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/dimen_margin_20dp"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="23sp"
            android:textColor="@color/mine_pk_orange_bg"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mine_pk_my_pk"
            android:drawablePadding="@dimen/mine_dimen_margin_4dp"
            android:drawableEnd="@drawable/ic_pk_orange_rounded_right_arrow"
            style="@style/FontMedium"/>
        <View
            android:id="@+id/pk_divider"
            android:background="@color/mine_pk_orange_text_color"
            android:layout_width="114dp"
            android:layout_height="0.33dp"
            android:layout_below="@+id/title"
            android:layout_marginVertical="7dp"/>
        <TextView
            android:textSize="@dimen/dimen_13sp"
            android:textColor="@color/mine_pk_orange_text_color"
            android:id="@+id/pk_slogan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pk_slogan"
            android:layout_below="@+id/pk_divider"
            style="@style/FontRegular"/>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
