<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/health_curse_activity_set_0"
    android:background="@color/health_page_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/dimen_margin_12dp">
    <androidx.core.widget.NestedScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/state_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:id="@+id/curse_setting_interval_label"
                android:text="生理周期设置"
                android:layout_marginStart="@dimen/dimen_margin_16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/HealthCurseSettingLabel"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/curse_setting_interval_layout"
                android:background="@drawable/shape_data_item_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_12dp"
                android:paddingHorizontal="@dimen/dimen_margin_12dp"
                app:layout_constraintTop_toBottomOf="@+id/curse_setting_interval_label">
                <com.xiaomi.fitness.widget.RightArrowTwoLineTextView
                    android:id="@+id/curse_setting_menstrual_interval"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:remindText="6天"
                    app:showRemind="true"
                    app:subtitle="月经一般持续几天？"
                    app:title="经期天数"/>
                <com.xiaomi.fitness.widget.RightArrowTwoLineTextView
                    android:id="@+id/curse_setting_cycle_interval"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:remindText="28天"
                    app:showRemind="true"
                    app:subtitle="月经一般间隔几天？"
                    app:title="经期间隔天数"/>
            </LinearLayout>
            <TextView
                android:id="@+id/curse_setting_prediction_label"
                android:layout_marginTop="@dimen/dimen_margin_32dp"
                android:text="@string/health_women_predict_setting_label"
                android:layout_marginStart="@dimen/dimen_margin_16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/curse_setting_interval_layout"
                style="@style/HealthCurseSettingLabel"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/curse_setting_prediction_layout"
                android:background="@drawable/shape_data_item_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_12dp"
                android:paddingHorizontal="@dimen/dimen_margin_12dp"
                app:layout_constraintTop_toBottomOf="@+id/curse_setting_prediction_label">
                <com.xiaomi.fitness.widget.SwitchButtonSingleLineTextView
                    android:id="@+id/algoPredictView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/predictView"
                    app:title="@string/health_women_intelligent_predict"/>
                <com.xiaomi.fitness.widget.SwitchButtonSingleLineTextView
                    android:id="@+id/predictView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/lastView"
                    app:title="@string/health_women_calendar_predict"/>
            </LinearLayout>
            <TextView
                android:id="@+id/curse_setting_app_notify_label"
                android:layout_marginTop="@dimen/dimen_margin_32dp"
                android:text="@string/health_women_app_notification_setting_label"
                android:layout_marginStart="@dimen/dimen_margin_16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/curse_setting_prediction_layout"
                style="@style/HealthCurseSettingLabel"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/curse_setting_app_notify_layout"
                android:background="@drawable/shape_data_item_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_12dp"
                android:paddingHorizontal="@dimen/dimen_margin_12dp"
                app:layout_constraintTop_toBottomOf="@+id/curse_setting_app_notify_label">
                <com.xiaomi.fitness.widget.SwitchButtonSingleLineTextView
                    android:id="@+id/appSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:title="@string/health_curse_app_notify_title"/>
                <com.xiaomi.fitness.widget.RightArrowSingleLineTextView
                    android:id="@+id/appInView"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:title="@string/health_curse_notify_start"/>
                <com.xiaomi.fitness.widget.RightArrowSingleLineTextView
                    android:id="@+id/appOvumView"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:title="@string/health_curse_notify_ovum"/>
                <com.xiaomi.fitness.widget.RightArrowSingleLineTextView
                    android:id="@+id/appEasyPregnancyView"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:title="@string/health_curse_notify_easy_pregnancy"/>
            </LinearLayout>
            <TextView
                android:id="@+id/curse_setting_device_notify_label"
                android:layout_marginTop="@dimen/dimen_margin_32dp"
                android:text="@string/health_women_devices_notification_setting_label"
                android:layout_marginStart="@dimen/dimen_margin_16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/curse_setting_app_notify_layout"
                style="@style/HealthCurseSettingLabel"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/curse_setting_device_notify_layout"
                android:background="@drawable/shape_data_item_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_12dp"
                android:paddingHorizontal="@dimen/dimen_margin_12dp"
                app:layout_constraintTop_toBottomOf="@+id/curse_setting_device_notify_label">
                <com.xiaomi.fitness.widget.SwitchButtonSingleLineTextView
                    android:id="@+id/deviceSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:title="@string/health_curse_notify_device"/>
                <com.xiaomi.fitness.widget.RightArrowSingleLineTextView
                    android:id="@+id/deviceInView"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:title="@string/health_curse_notify_start"/>
                <com.xiaomi.fitness.widget.RightArrowSingleLineTextView
                    android:id="@+id/deviceOvumView"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:title="@string/health_curse_notify_ovum"/>
                <com.xiaomi.fitness.widget.RightArrowSingleLineTextView
                    android:id="@+id/deviceEasyPregnancyView"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:title="@string/health_curse_notify_easy_pregnancy"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <Button
        android:layout_gravity="bottom"
        android:id="@+id/startView"
        android:visibility="gone"
        android:text="@string/health_curse_use"
        style="@style/CommonBtn.Primary"/>
</LinearLayout>
