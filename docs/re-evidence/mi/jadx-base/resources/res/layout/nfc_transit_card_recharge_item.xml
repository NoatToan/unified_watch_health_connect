<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/card_recharge_list_item_layout"
    android:layout_width="match_parent"
    android:layout_height="@dimen/common_set_item_height">
    <TextView
        android:textSize="@dimen/common_item_set_title_text_size"
        android:textColor="@color/text_color"
        android:id="@+id/card_recharge_list_item_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"/>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="end|center_vertical"
        android:id="@+id/card_recharge_list_item_left_pic_ll"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/nfc_card_recharge_list_item_height"
        android:layout_marginStart="@dimen/nfc_card_recharge_list_item_left_pic_margin_left">
        <ImageView
            android:duplicateParentState="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/nfc_question_mark"
            android:scaleType="centerCrop"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/nfc_card_issue_list_item_second_title_text_size"
        android:textColor="@color/text_color_40"
        android:gravity="end"
        android:layout_gravity="center_vertical"
        android:id="@+id/card_recharge_list_item_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"/>
    <ImageView
        android:layout_gravity="end|center_vertical"
        android:id="@+id/card_recharge_list_item_right_arrow"
        android:visibility="gone"
        android:duplicateParentState="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_base_right_arrow_icon"
        android:layout_marginStart="3dp"/>
</LinearLayout>
