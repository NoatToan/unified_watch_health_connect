<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/constraintLayout"
    android:tag="layout/view_launch_0"
    android:paddingTop="@dimen/size_12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include
        android:id="@+id/head"
        layout="@layout/view_launch_head"/>
    <FrameLayout
        android:id="@+id/run_indoor"
        android:tag="binding_1"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/head">
        <include
            android:id="@+id/indoor_incluce"
            layout="@layout/view_launch_indoor"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/mapFrameLayout"
        android:layout_width="match_parent"
        android:layout_height="400dp"
        android:layout_marginHorizontal="5dp"
        app:layout_constraintTop_toBottomOf="@+id/head"/>
    <View
        android:id="@+id/darkBg"
        android:background="@color/black"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/mapFrameLayout"
        app:layout_constraintEnd_toEndOf="@+id/mapFrameLayout"
        app:layout_constraintStart_toStartOf="@+id/mapFrameLayout"
        app:layout_constraintTop_toTopOf="@+id/mapFrameLayout"/>
    <com.xiaomi.fitness.sport.view.widget.GpsSignalView
        android:id="@+id/gpsGignalView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_14dp"
        android:layout_marginStart="@dimen/dimen_margin_14dp"
        app:layout_constraintStart_toStartOf="@+id/mapFrameLayout"
        app:layout_constraintTop_toTopOf="@+id/mapFrameLayout"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintl"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/mapFrameLayout"
        app:layout_constraintEnd_toEndOf="@+id/mapFrameLayout"
        app:layout_constraintStart_toStartOf="@+id/mapFrameLayout"
        app:layout_constraintTop_toTopOf="@+id/mapFrameLayout">
        <androidx.recyclerview.widget.RecyclerView
            android:orientation="vertical"
            android:id="@+id/connected_devices_recycler_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="13.33dp"
            android:layout_marginEnd="@dimen/dimen_margin_14dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.xiaomi.fitness.sport.view.widget.SportMusicView
            android:id="@+id/sport_music_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_14dp"
            android:layout_marginEnd="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/connected_devices_recycler_view"/>
        <ImageView
            android:id="@+id/sport_setting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_sport_config_bg"
            android:scaleType="center"
            android:contentDescription="@string/talkback_sport_config"
            android:layout_marginStart="@dimen/size_36"
            app:layout_constraintBottom_toBottomOf="@+id/action_sport"
            app:layout_constraintStart_toEndOf="@+id/action_sport"
            app:layout_constraintTop_toTopOf="@+id/action_sport"/>
        <androidx.cardview.widget.CardView
            android:id="@+id/create_route"
            android:visibility="gone"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginStart="@dimen/size_36"
            app:cardBackgroundColor="@color/card_bg_normal"
            app:cardCornerRadius="27dp"
            app:cardElevation="2dp"
            app:layout_constraintBottom_toBottomOf="@+id/action_sport"
            app:layout_constraintStart_toEndOf="@+id/action_sport"
            app:layout_constraintTop_toTopOf="@+id/action_sport">
            <ImageView
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/sport_create_running_route_entrance_icon"
                android:scaleType="centerInside"
                android:contentDescription="@string/talkback_sport_config"/>
        </androidx.cardview.widget.CardView>
        <View
            android:id="@+id/setting_badge"
            android:background="@drawable/sport_setting_badge"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginTop="15dp"
            android:layout_marginEnd="15dp"
            app:layout_constraintEnd_toEndOf="@+id/sport_setting"
            app:layout_constraintTop_toTopOf="@+id/sport_setting"/>
        <ImageView
            android:id="@+id/goal_setting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_sport_goal"
            android:scaleType="center"
            android:contentDescription="@string/talkback_goal_config"
            android:layout_marginEnd="@dimen/size_36"
            app:layout_constraintBottom_toBottomOf="@+id/action_sport"
            app:layout_constraintEnd_toStartOf="@+id/action_sport"
            app:layout_constraintTop_toTopOf="@+id/action_sport"/>
        <TextView
            android:id="@+id/action_sport"
            android:background="@drawable/sport_go"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_marginBottom="32.7dp"
            android:contentDescription="@string/talkback_start_sport"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:textSize="@dimen/font_14"
            android:textColor="@color/color_ff612e"
            android:gravity="center"
            android:id="@+id/connect_tv2"
            android:background="@drawable/bg_white_radius45"
            android:paddingLeft="@dimen/margin_15dp"
            android:paddingTop="8dp"
            android:paddingRight="@dimen/margin_15dp"
            android:paddingBottom="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dimen_margin_12dp"
            android:text="@string/sport_start_connect"
            app:layout_constraintBottom_toTopOf="@+id/action_sport"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
        <ImageView
            android:id="@+id/create_route_notice_arrow"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_pop_up_arrow"
            android:elevation="10dp"
            app:layout_constraintEnd_toEndOf="@+id/create_route"
            app:layout_constraintStart_toStartOf="@+id/create_route"
            app:layout_constraintTop_toBottomOf="@+id/create_route"/>
        <androidx.cardview.widget.CardView
            android:id="@+id/create_route_notice_text"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:elevation="10dp"
            app:cardBackgroundColor="@color/black_60"
            app:cardCornerRadius="15dp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="@+id/create_route_notice_arrow"
            app:layout_constraintStart_toStartOf="@+id/create_route_notice_arrow"
            app:layout_constraintTop_toBottomOf="@+id/create_route_notice_arrow">
            <TextView
                android:textSize="14dp"
                android:textColor="@color/white"
                android:gravity="center"
                android:padding="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sport_try_ai_create_route_hint"/>
        </androidx.cardview.widget.CardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
