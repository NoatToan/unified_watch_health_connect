<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/electronic_scale_dimen_margin_27dp"
    android:paddingEnd="@dimen/electronic_scale_dimen_margin_27dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:minHeight="56dp">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/text_color"
            android:id="@+id/ssid"
            android:background="@android:color/transparent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text=""
            android:hint="@string/electronic_scale_common_wifi_name"
            android:drawableBottom="@android:color/transparent"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/lock"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/electronic_scale_icon_password"/>
        <ImageView
            android:id="@+id/siginal"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/electronic_scale_icon_wifi_grey0"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
</FrameLayout>
