<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/eco_environmental_activity_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/size_26_67">
    <RelativeLayout
        android:background="@drawable/sport_eco_environmental_level_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_200">
        <ImageView
            android:id="@+id/sprot_eco_iv"
            android:background="@drawable/environmental_level"
            android:layout_width="@dimen/size_146_67"
            android:layout_height="@dimen/size_146_67"
            android:layout_marginTop="@dimen/size_26_67"
            android:scaleType="center"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <TextView
        android:textSize="@dimen/font_14"
        android:textColor="@color/sport_eco_environmental_des_color"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_10"
        android:text="@string/sport_eco_environmental_des"/>
</LinearLayout>
