<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/activity_electronic_scale_user_add_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/visitor_save">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.xiaomi.fitness.widget.view.RoundImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/visitor_photo"
                android:background="@drawable/electronic_scale_user_icon"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginTop="50dp"
                android:scaleType="centerCrop"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/text_color_40"
                android:id="@+id/tv_tips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:text="@string/electronic_scale_enter_virtual_account_info_tips"
                android:paddingHorizontal="@dimen/dimen_margin_20dp"/>
            <com.xiaomi.fitness.widget.RightArrowBindingSingleLineTextView
                android:id="@+id/user_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="50dp"
                android:layout_marginHorizontal="@dimen/page_content_padding_horizontal_large"
                app:showMore="true"
                app:showRemind="true"
                app:title="@string/electronic_scale_visitor_name"/>
            <com.xiaomi.fitness.widget.RightArrowBindingSingleLineTextView
                android:id="@+id/sex"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/page_content_padding_horizontal_large"
                app:showMore="true"
                app:showRemind="true"
                app:title="@string/electronic_scale_sex"/>
            <com.xiaomi.fitness.widget.RightArrowBindingSingleLineTextView
                android:id="@+id/birth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/page_content_padding_horizontal_large"
                app:showMore="true"
                app:showRemind="true"
                app:title="@string/electronic_scale_birthday"/>
            <com.xiaomi.fitness.widget.RightArrowBindingSingleLineTextView
                android:id="@+id/height"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/page_content_padding_horizontal_large"
                app:showMore="true"
                app:showRemind="true"
                app:title="@string/electronic_scale_height"/>
            <com.xiaomi.fitness.widget.RightArrowBindingSingleLineTextView
                android:id="@+id/weightTarget"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/page_content_padding_horizontal_large"
                app:showMore="true"
                app:showRemind="true"
                app:title="@string/electronic_scale_weight_name"/>
        </LinearLayout>
    </ScrollView>
    <Button
        android:id="@+id/visitor_save"
        android:layout_marginBottom="27dp"
        android:text="@string/electronic_scale_add_to"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginHorizontal="20dp"
        style="@style/CommonBtn.Primary"/>
</RelativeLayout>
