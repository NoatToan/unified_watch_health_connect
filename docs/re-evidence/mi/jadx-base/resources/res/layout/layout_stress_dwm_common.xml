<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/layout_stress_dwm_common_0"
    android:paddingBottom="@dimen/health_detail_page_common_margin_vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/health_detail_page_common_margin_horizontal">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_stress_detail"
        android:background="@drawable/shape_data_item_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/health_detail_page_common_margin_vertical"
        android:overScrollMode="never"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_stress_distribute"
        android:background="@drawable/shape_data_item_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/health_detail_page_common_margin_vertical"
        android:overScrollMode="never"/>
    <com.xiaomi.fitness.common.devicelist.SportsDeviceListView
        android:id="@+id/deviceListView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-12dp"
        android:layout_marginBottom="@dimen/health_detail_page_common_margin_vertical"/>
    <com.xiaomi.fitness.view.HealthBannerCardSetView
        android:id="@+id/health_banner_card_set"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size_12"/>
    <com.xiaomi.fitness.view.CardUnderstandView
        android:id="@+id/understandCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:txtUnderstand="@string/health_stress_understand"/>
</LinearLayout>
