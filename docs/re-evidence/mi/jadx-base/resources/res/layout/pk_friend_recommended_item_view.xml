<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/pk_friend_recommended_item_view_0"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.xiaomi.fitness.widget.view.RoundImageView
        android:id="@+id/avatar_image"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginBottom="@dimen/dimen_margin_5dp"
        android:layout_marginHorizontal="11dp"
        app:srcCompat="@drawable/ic_pk_avatar_default"/>
    <TextView
        android:textSize="@dimen/font_11"
        android:textColor="@color/pk_text_recommend_friend_name"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@+id/tv_nickname"
        android:layout_width="44dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_margin_5dp"
        android:text="LongNickname"
        android:maxLines="2"
        android:layout_below="@+id/avatar_image"
        android:layout_centerHorizontal="true"
        android:layout_marginHorizontal="11dp"/>
    <TextView
        android:textColor="@color/pk_theme_orange"
        android:gravity="center_horizontal"
        android:id="@+id/tv_request_sent"
        android:visibility="invisible"
        android:layout_width="44dp"
        android:layout_height="wrap_content"
        android:text="@string/pk_sent"
        android:layout_below="@+id/tv_nickname"
        android:layout_centerHorizontal="true"
        style="@style/FontRegular.11sp"/>
</RelativeLayout>
