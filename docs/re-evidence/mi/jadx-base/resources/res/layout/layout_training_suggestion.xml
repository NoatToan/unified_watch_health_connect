<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/layout_training_suggestion_0"
    android:background="@drawable/shape_card_bg_normal"
    android:paddingTop="@dimen/dimen_margin_20dp"
    android:paddingBottom="@dimen/dimen_margin_30dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/dimen_margin_12dp"
    android:paddingHorizontal="@dimen/page_extra_padding_horizontal_large">
    <TextView
        android:textColor="@color/text_color"
        android:gravity="center_vertical"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/health_training_suggestion"
        android:drawablePadding="@dimen/dimen_margin_10dp"
        android:drawableStart="@drawable/health_ic_training_suggestion"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/FontMedium.14sp"/>
    <com.xiaomi.fitness.widget.view.DividerView
        android:id="@+id/horizontal_divider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_20dp"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/estimation_and_suggestion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_13dp"
        android:baselineAligned="false"
        android:weightSum="2"
        android:paddingVertical="@dimen/dimen_margin_14dp"
        app:layout_constraintTop_toBottomOf="@+id/horizontal_divider">
        <RelativeLayout
            android:id="@+id/running_ability_prediction_group"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="@dimen/dimen_22sp"
                android:textColor="@color/text_color"
                android:id="@+id/ability_prediction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                style="@style/FontMedium"/>
            <TextView
                android:textColor="@color/text_color_40"
                android:id="@+id/indicator_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/health_running_indicator_prediction"
                android:layout_below="@+id/ability_prediction"
                android:layout_alignParentStart="true"
                style="@style/FontRegular.11sp"/>
        </RelativeLayout>
        <com.xiaomi.fitness.widget.view.DividerView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            app:isHorizontal="true"/>
        <RelativeLayout
            android:id="@+id/training_frequency_suggestion_group"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/dimen_margin_20dp">
            <TextView
                android:textSize="@dimen/text_size_20"
                android:textColor="@color/text_color"
                android:id="@+id/frequency_suggestion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                style="@style/FontMedium"/>
            <TextView
                android:textColor="@color/text_color_40"
                android:id="@+id/frequency_suggestion_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/health_training_frequency_suggestion"
                android:layout_below="@+id/frequency_suggestion"
                android:layout_alignParentStart="true"
                style="@style/FontRegular.11sp"/>
        </RelativeLayout>
    </LinearLayout>
    <com.xiaomi.fitness.widget.view.DividerView
        android:id="@+id/horizontal_divider_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_20dp"
        app:layout_constraintTop_toBottomOf="@+id/estimation_and_suggestion"/>
    <TextView
        android:textColor="@color/text_color_40"
        android:id="@+id/suggestion_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/horizontal_divider_2"
        style="@style/FontRegular.11sp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
