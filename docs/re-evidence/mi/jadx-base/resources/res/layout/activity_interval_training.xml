<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_interval_training_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <miuix.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/start_view"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.xiaomi.fitness.widget.view.RatioImageView
                android:id="@+id/post_view"
                android:background="@drawable/course_interval_training"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_20dp"
                android:scaleType="centerCrop"
                android:layout_marginStart="@dimen/margin_27dp"
                android:layout_marginEnd="@dimen/margin_27dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:ratio="1.679"
                app:shapeAppearance="@style/CourseInfo"/>
            <com.xiaomi.fitness.sport_eco.view.widget.ExpandableTextView
                android:textSize="12sp"
                android:textColor="@color/sport_text_color_bg"
                android:id="@+id/desc_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="23dp"
                android:lineSpacingExtra="4dp"
                android:layout_marginStart="@dimen/margin_27dp"
                android:layout_marginEnd="@dimen/margin_27dp"
                app:expandLines="2"
                app:expandTextColor="@color/course_black"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/post_view"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/desc_view">
                <miuix.miuixbasewidget.widget.FilterSortView
                    android:theme="@style/FilterSortViewStyle"
                    android:id="@+id/filter_sort_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_margin_13dp"
                    android:layout_marginBottom="@dimen/dimen_margin_10dp"
                    android:layout_marginStart="@dimen/common_set_margin_start"
                    android:layout_marginEnd="@dimen/common_set_margin_start"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.xiaomi.fitness.sport_eco.view.interval.ScrollViewPager
                    android:id="@+id/viewPager"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/filter_sort_view"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </miuix.core.widget.NestedScrollView>
    <TextView
        android:id="@+id/start_view"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/CommonBtn.Red"/>
</androidx.constraintlayout.widget.ConstraintLayout>
