<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/userinfo_activity_guide_gender_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.constraintlayout.widget.Guideline
                android:orientation="horizontal"
                android:id="@+id/guide_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_percent="0.15"/>
            <TextView
                android:textSize="@dimen/userinfo_common_card_title_text_size"
                android:id="@+id/pass"
                android:visibility="gone"
                android:text="@string/userinfo_set_later"
                android:layout_marginStart="@dimen/dimen_margin_24dp"
                app:layout_constraintStart_toStartOf="parent"
                style="@style/userinfo_GuideSubTitleText"/>
            <TextView
                android:id="@+id/tv_subtitle"
                android:text="@string/userinfo_setting_sport_info_set_tips"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                style="@style/userinfo_GuideSubTitleText"/>
            <com.xiaomi.fitness.baseui.widget.NumberPickerView
                android:id="@+id/picker_gender"
                android:layout_width="match_parent"
                android:layout_height="@dimen/userinfo_size_313"
                android:layout_marginBottom="@dimen/userinfo_size_157"
                app:layout_constraintBottom_toTopOf="@+id/tv_go_next"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_subtitle"
                app:npv_ItemPaddingVertical="@dimen/userinfo_size_320_67"
                app:npv_ShowCount="3"
                app:npv_ShowDivider="false"
                app:npv_TextColorNormal="@color/userinfo_black_20"
                app:npv_TextColorOuter="@color/userinfo_black_10"
                app:npv_TextColorSelected="@color/userinfo_black"
                app:npv_TextSizeNormal="@dimen/userinfo_font_37"
                app:npv_TextSizeOuter="@dimen/userinfo_font_33_1"
                app:npv_TextSizeSelected="@dimen/userinfo_font_46_67"
                app:npv_WrapSelectorWheel="true"/>
            <TextView
                android:id="@+id/tv_go_next"
                android:layout_marginBottom="@dimen/userinfo_size_27"
                android:text="@string/userinfo_next_step"
                android:layout_marginStart="@dimen/dimen_margin_26dp"
                android:layout_marginEnd="@dimen/dimen_margin_26dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintVertical_bias="1"
                style="@style/userinfo_Button.FullWidth.Menstrual.Orange"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</LinearLayout>
