<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="@color/text_color"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/trail_sport_map_edit"
        style="@style/FontMedium.17sp"/>
    <include
        android:id="@+id/map_style"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_18dp"
        android:layout_marginStart="@dimen/dimen_margin_23dp"
        layout="@layout/trace_sport_record_trace_style"/>
    <include
        android:id="@+id/trace_style"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_18dp"
        android:layout_marginStart="@dimen/dimen_margin_23dp"
        layout="@layout/trace_sport_record_trace_style"/>
    <RelativeLayout
        android:id="@+id/rlShowColors"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:paddingStart="@dimen/size_30"
        android:paddingEnd="@dimen/size_30">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/trail_open_sport_map_show_color"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            style="@style/FontMedium.16sp"/>
        <com.xiaomi.fitness.widget.button.SwitchButton
            android:id="@+id/colorsSwitchBtn"
            android:layout_width="@dimen/lib_sb_width"
            android:layout_height="@dimen/lib_sb_height"
            android:button="@drawable/checkbox_green"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rlMailPoints"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:paddingStart="@dimen/size_30"
        android:paddingEnd="@dimen/size_30">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/trail_open_mail_points"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            style="@style/FontMedium.16sp"/>
        <com.xiaomi.fitness.widget.button.SwitchButton
            android:id="@+id/switchBtn"
            android:layout_width="@dimen/lib_sb_width"
            android:layout_height="@dimen/lib_sb_height"
            android:button="@drawable/checkbox_green"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</LinearLayout>
