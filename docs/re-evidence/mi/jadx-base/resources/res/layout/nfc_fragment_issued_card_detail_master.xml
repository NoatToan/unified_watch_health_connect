<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:background="@drawable/selector_white"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nfc_issued_card_list_detail_item_height"
        android:layout_marginTop="20dp"
        android:paddingStart="@dimen/common_title_left_margin"
        android:paddingEnd="@dimen/common_title_left_margin">
        <TextView
            android:textSize="@dimen/common_item_set_title_text_size"
            android:textColor="@color/setting_item_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/nfc_bank_name"
            android:includeFontPadding="false"
            android:layout_weight="1"
            style="@style/nfc_TextAppearance.List.Primary"/>
        <TextView
            android:textSize="12.7dp"
            android:textColor="@color/text_color_40"
            android:id="@+id/bankNameMasterView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:background="@drawable/selector_white"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nfc_issued_card_list_detail_item_height"
        android:paddingStart="@dimen/common_title_left_margin"
        android:paddingEnd="@dimen/common_title_left_margin">
        <TextView
            android:textSize="@dimen/common_item_set_title_text_size"
            android:textColor="@color/setting_item_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/nfc_bank_account_number"
            android:includeFontPadding="false"
            android:layout_weight="1"
            style="@style/nfc_TextAppearance.List.Primary"/>
        <TextView
            android:textSize="12.7dp"
            android:textColor="@color/text_color_40"
            android:id="@+id/accountNoMasterView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <RelativeLayout
        android:background="@drawable/selector_white"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/common_title_left_margin"
        android:paddingEnd="@dimen/common_title_left_margin">
        <TextView
            android:textSize="@dimen/common_item_set_title_text_size"
            android:textColor="@color/setting_item_title"
            android:id="@+id/nfc_device_card_number_mul"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nfc_device_card_number_mul"
            android:includeFontPadding="false"
            style="@style/nfc_TextAppearance.List.Primary"/>
        <TextView
            android:textSize="12.7dp"
            android:textColor="@color/text_color_40"
            android:id="@+id/deviceNoMasterView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="12sp"
            android:textColor="@color/nfc_device_number_remind_tips_color"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/nfc_device_card_number_remind"
            android:layout_below="@+id/nfc_device_card_number_mul"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/transationMasterView"
        android:background="@drawable/selector_white"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nfc_issued_card_list_detail_item_height"
        android:paddingStart="@dimen/common_title_left_margin"
        android:paddingEnd="@dimen/common_title_left_margin">
        <TextView
            android:textSize="@dimen/common_item_set_title_text_size"
            android:textColor="@color/setting_item_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/nfc_card_detail_more_settings_trade_record"
            android:includeFontPadding="false"
            android:layout_weight="1"
            style="@style/nfc_TextAppearance.List.Primary"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_base_right_arrow_icon"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/bankServiceMasterView"
        android:background="@drawable/selector_white"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nfc_issued_card_list_detail_item_height"
        android:paddingStart="@dimen/common_title_left_margin"
        android:paddingEnd="@dimen/common_title_left_margin">
        <TextView
            android:textSize="@dimen/common_item_set_title_text_size"
            android:textColor="@color/setting_item_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/nfc_bank_service_url"
            android:includeFontPadding="false"
            android:layout_weight="1"
            style="@style/nfc_TextAppearance.List.Primary"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_base_right_arrow_icon"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/contactUsMasterView"
        android:background="@drawable/selector_white"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nfc_issued_card_list_detail_item_height"
        android:paddingStart="@dimen/common_title_left_margin"
        android:paddingEnd="@dimen/common_title_left_margin">
        <TextView
            android:textSize="@dimen/common_item_set_title_text_size"
            android:textColor="@color/setting_item_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/nfc_bank_contact_us"
            android:includeFontPadding="false"
            android:layout_weight="1"
            style="@style/nfc_TextAppearance.List.Primary"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/nfc_arrow_right_dark"/>
    </LinearLayout>
</LinearLayout>
