<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_title"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_3"
        android:layout_marginStart="@dimen/chart_common_padding_start"
        android:layout_marginEnd="@dimen/size_30">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_first"
                android:layout_width="150dp"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="@color/text_color_40"
                    android:gravity="start"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/tv_first_guide"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/health_temperature_body"
                    android:drawablePadding="@dimen/size_6"
                    android:drawableStart="@drawable/shape_temperature_body"
                    style="@style/FontRegular.12sp"/>
                <TextView
                    android:textSize="33.3dp"
                    android:textColor="@color/text_color"
                    android:gravity="start"
                    android:id="@+id/firstText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_8"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:autoSizeTextType="uniform"
                    style="@style/FontMedium"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_second"
                android:layout_width="150dp"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="@color/text_color_40"
                    android:gravity="start"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/tv_second_guide"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/health_temperature_skin"
                    android:drawablePadding="@dimen/size_6"
                    android:drawableStart="@drawable/shape_temperature_skin"
                    style="@style/FontRegular.12sp"/>
                <TextView
                    android:textSize="33.3dp"
                    android:textColor="@color/text_color"
                    android:gravity="start"
                    android:id="@+id/secondText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_8"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:autoSizeTextType="uniform"
                    style="@style/FontMedium"/>
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:textColor="@color/health_subtitle_text_color_40"
            android:id="@+id/txtDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            style="@style/FontRegular.12sp"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/font_30"
        android:layout_gravity="start|center_vertical"
        android:id="@+id/emptyView"
        android:paddingTop="@dimen/size_5"
        android:paddingBottom="@dimen/size_5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/chart_common_padding_start"
        android:layout_marginEnd="@dimen/size_30"
        android:autoSizeTextType="uniform"
        style="@style/FontMedium"/>
</FrameLayout>
