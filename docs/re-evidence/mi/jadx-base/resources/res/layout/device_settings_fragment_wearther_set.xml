<?xml version="1.0" encoding="utf-8"?>
<miuix.springback.view.SpringBackLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/device_settings_fragment_wearther_set_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:scrollableView="@+id/scrollview">
    <miuix.core.widget.NestedScrollView
        android:id="@+id/scrollview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.xiaomi.fitness.widget.SwitchButtonTwoLineTextView
                android:id="@+id/syncView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/page_content_padding_horizontal_large"
                android:paddingEnd="@dimen/page_content_padding_horizontal_large"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:subtitle="@string/device_settings_weather_setting_sync_tips"
                app:title="@string/device_settings_weather_setting_sync"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/setting_item_second"
                android:id="@+id/sync_open_tips"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/device_settings_weather_setting_sync_open_tips"
                android:layout_marginHorizontal="@dimen/page_content_padding_horizontal_large"
                app:layout_constraintTop_toBottomOf="@+id/syncView"/>
            <com.xiaomi.fitness.widget.view.DividerView
                android:id="@+id/divider_view"
                android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
                android:layout_marginEnd="@dimen/page_content_padding_horizontal_large"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/sync_open_tips"
                style="@style/SettingDivider"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/select_city_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/divider_view">
                <com.xiaomi.fitness.widget.RightArrowTwoLineTextView
                    android:id="@+id/cityView"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/page_content_padding_horizontal_large"
                    android:paddingEnd="@dimen/page_content_padding_horizontal_large"
                    app:arrow_desShow="false"
                    app:arrow_rightValueShow="true"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:remindText="@string/device_settings_weather_add_city"
                    app:showRemind="true"
                    app:subtitle="@string/device_settings_weather_add_city_limit"
                    app:title="@string/device_settings_weather_setting_city"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/city_list_view"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/page_content_padding_horizontal_large"
                    android:layout_marginEnd="@dimen/page_content_padding_horizontal_large"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/cityView"/>
                <com.xiaomi.fitness.widget.RightArrowSingleLineTextView
                    android:id="@+id/temp_view"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/page_content_padding_horizontal_large"
                    android:paddingEnd="@dimen/page_content_padding_horizontal_large"
                    app:arrow_desShow="false"
                    app:arrow_lineShow="false"
                    app:arrow_name="@string/device_settings_weather_temp_ss"
                    app:arrow_rightValueShow="true"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/city_list_view"
                    app:title="@string/device_settings_weather_temp"/>
                <com.xiaomi.fitness.widget.SwitchButtonTwoLineTextView
                    android:id="@+id/alerts_View"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/page_content_padding_horizontal_large"
                    android:paddingEnd="@dimen/page_content_padding_horizontal_large"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/temp_view"
                    app:title="@string/device_settings_weather_alerts"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/switch_black"
                android:gravity="bottom|center_horizontal"
                android:id="@+id/helpView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginBottom="80dp"
                android:minHeight="@dimen/dimen_margin_12dp"
                android:text="@string/device_settings_weather_setting_sync_error_des"
                android:includeFontPadding="false"
                android:layout_weight="1"
                android:paddingStart="@dimen/page_content_padding_horizontal_large"
                android:paddingEnd="@dimen/page_content_padding_horizontal_large"/>
        </LinearLayout>
    </miuix.core.widget.NestedScrollView>
</miuix.springback.view.SpringBackLayout>
