<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/sleep_interpretation_card_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/page_extra_padding_horizontal_large">
    <View
        android:id="@+id/split_line_view"
        android:background="@color/common_divider_bg_color"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_0_33"
        android:layout_marginTop="@dimen/dimen_margin_20dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="17.42sp"
        android:textColor="@color/text_color"
        android:gravity="start"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="@string/health_sleep_interpretation_and_advice"
        android:textFontWeight="600"
        app:layout_constraintTop_toBottomOf="@+id/split_line_view"/>
    <TextView
        android:textSize="@dimen/dimen_15sp"
        android:textColor="@color/text_color"
        android:id="@+id/preview_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textFontWeight="420"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/suggestionListContainer"
        android:background="@drawable/sleep_interpretation_shape_card_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:paddingHorizontal="@dimen/page_extra_padding_horizontal_large"
        android:paddingVertical="@dimen/page_extra_padding_horizontal_large"
        app:layout_constraintTop_toBottomOf="@+id/preview_text">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/sleep_interpretation_recycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/suggestionListContainer">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="13sp"
            android:textColor="@color/text_color_40"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/health_technical_support_colon"
            android:textFontWeight="400"
            app:autoSizeMaxTextSize="13sp"
            app:autoSizeMinTextSize="2sp"
            app:autoSizeTextType="uniform"/>
        <com.google.android.flexbox.FlexboxLayout
            android:id="@+id/supportLogoContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:dividerDrawableHorizontal="@drawable/spacer_vertical_10dp"
            app:dividerDrawableVertical="@drawable/spacer_horizontal_10dp"
            app:flexDirection="row"
            app:flexWrap="wrap"
            app:showDividerHorizontal="middle"
            app:showDividerVertical="middle">
            <com.google.android.material.card.MaterialCardView
                android:theme="@style/TranslucentMaterialTheme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/health_card_bg_gray"
                app:cardCornerRadius="6dp"
                app:cardElevation="0dp">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="13sp"
                    android:textColor="@color/text_color_40"
                    android:gravity="center_vertical"
                    android:background="@color/health_card_bg_gray"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/world_sleep_society_logo_text"
                    android:includeFontPadding="false"
                    android:drawablePadding="4dp"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:textFontWeight="400"
                    app:autoSizeMaxTextSize="13sp"
                    app:autoSizeMinTextSize="2sp"
                    app:autoSizeTextType="uniform"
                    app:drawableStartCompat="@drawable/world_sleep_society_logo_59_22"/>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:theme="@style/TranslucentMaterialTheme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/health_card_bg_gray"
                app:cardCornerRadius="6dp"
                app:cardElevation="0dp">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="13sp"
                    android:textColor="@color/text_color_40"
                    android:gravity="center_vertical"
                    android:background="@color/health_card_bg_gray"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/asian_society_of_sleep_medicine_logo_text"
                    android:includeFontPadding="false"
                    android:drawablePadding="4dp"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:textFontWeight="400"
                    app:autoSizeMaxTextSize="13sp"
                    app:autoSizeMinTextSize="2sp"
                    app:autoSizeTextType="uniform"
                    app:drawableStartCompat="@drawable/asian_society_of_sleep_medicine_logo_47_22"/>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:theme="@style/TranslucentMaterialTheme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/health_card_bg_gray"
                app:cardCornerRadius="6dp"
                app:cardElevation="0dp">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="13sp"
                    android:textColor="@color/text_color_40"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chinese_sleep_research_society_logo_text"
                    android:includeFontPadding="false"
                    android:drawablePadding="4dp"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:textFontWeight="400"
                    app:autoSizeMaxTextSize="13sp"
                    app:autoSizeMinTextSize="2sp"
                    app:autoSizeTextType="uniform"
                    app:drawableStartCompat="@drawable/chinese_sleep_research_society_logo_22_22"/>
            </com.google.android.material.card.MaterialCardView>
        </com.google.android.flexbox.FlexboxLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
