<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/health_sleep_animal_schedule_item_0"
    android:paddingBottom="@dimen/size_7"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="9dp"
    android:paddingEnd="@dimen/size_18">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_dot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_time"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_time"
        app:srcCompat="@drawable/health_ic_sleep_purple_dot"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/text_color"
        android:id="@+id/tv_time"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="26.3dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/FontLatinSemiBold"/>
    <TextView
        android:textSize="11.3sp"
        android:textColor="@color/text_color_60"
        android:id="@+id/tv_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        app:layout_constraintStart_toStartOf="@+id/tv_time"
        app:layout_constraintTop_toBottomOf="@+id/tv_time"
        style="@style/FontRegular"/>
    <View
        android:id="@+id/divider_line"
        android:background="@color/divider_color"
        android:layout_width="0.7dp"
        android:layout_height="27dp"
        android:layout_marginTop="@dimen/size_12"
        app:layout_constraintEnd_toEndOf="@+id/iv_dot"
        app:layout_constraintStart_toStartOf="@+id/iv_dot"
        app:layout_constraintTop_toBottomOf="@+id/iv_dot"/>
</androidx.constraintlayout.widget.ConstraintLayout>
