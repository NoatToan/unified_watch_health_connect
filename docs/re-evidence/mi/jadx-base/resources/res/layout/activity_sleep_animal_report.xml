<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_sleep_animal_report_0"
    android:background="@color/page_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="match_parent"
        android:layout_height="390dp"
        android:scaleType="fitXY"
        app:srcCompat="@drawable/health_sleep_animal_report_top_bg"/>
    <LinearLayout
        android:orientation="vertical"
        android:tag="binding_1"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include
            android:id="@+id/layout_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/health_common_custom_title_layout"/>
        <androidx.core.widget.NestedScrollView
            android:id="@+id/nestedScrollView"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:layout_marginHorizontal="@dimen/page_padding_horizontal_large">
            <LinearLayout
                android:orientation="vertical"
                android:tag="binding_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <include
                    android:id="@+id/layout_collect_progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    layout="@layout/health_layout_sleep_animal_collect_progress"/>
                <include
                    android:id="@+id/layout_animal_image"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13.3dp"
                    layout="@layout/health_layout_sleep_animal_image"/>
                <include
                    android:id="@+id/layout_animal_report_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13.3dp"
                    layout="@layout/health_layout_sleep_animal_report_list"/>
                <include
                    android:id="@+id/layout_animal_schedule_suggest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13.3dp"
                    layout="@layout/health_layout_sleep_animal_schedule_suggest"/>
                <com.xiaomi.fitness.view.CardUnderstandView
                    android:id="@+id/understandCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13.3dp"
                    app:txtUnderstand="@string/health_sleep_how_to_use_sleep_tracking_device"/>
                <View
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="150dp"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
    <include
        android:layout_gravity="bottom"
        android:id="@+id/layout_floating"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="35dp"
        android:layout_marginHorizontal="12dp"
        layout="@layout/health_layout_sleep_animal_floating"/>
</FrameLayout>
