<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/view_line"
        android:background="@color/black_10_transparent"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nfc_size_0_33"
        android:layout_marginTop="@dimen/nfc_size_15"
        android:layout_marginBottom="@dimen/nfc_size_15"/>
    <TextView
        android:textSize="@dimen/nfc_font_14"
        android:textStyle="bold"
        android:textColor="@color/text_color"
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/nfc_size_8_3"
        android:text="@string/nfc_retrun_card_reason_title"/>
</LinearLayout>
