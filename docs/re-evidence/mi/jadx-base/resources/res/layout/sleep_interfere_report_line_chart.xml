<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/sleep_interfere_report_line_chart_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/legend"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="114dp">
        <TextView
            android:textSize="34sp"
            android:textColor="@color/text_color"
            android:id="@+id/state"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:textFontWeight="500"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/text_color_40"
            android:id="@+id/dateTv"
            android:layout_width="wrap_content"
            android:layout_height="19dp"
            android:textFontWeight="400"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/state"/>
        <androidx.cardview.widget.CardView
            android:id="@+id/tagc1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="3dp"
            app:cardElevation="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dateTv">
            <View
                android:id="@+id/tagct1"
                android:layout_width="20dp"
                android:layout_height="2.5dp"/>
        </androidx.cardview.widget.CardView>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/text_color_40"
            android:id="@+id/tag1"
            android:layout_width="wrap_content"
            android:layout_height="19dp"
            android:layout_marginStart="6dp"
            app:layout_constraintBottom_toBottomOf="@+id/tagc1"
            app:layout_constraintStart_toEndOf="@+id/tagc1"
            app:layout_constraintTop_toTopOf="@+id/tagc1"/>
        <androidx.cardview.widget.CardView
            android:id="@+id/tagc2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="48dp"
            app:cardCornerRadius="3dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/tag1"
            app:layout_constraintStart_toEndOf="@+id/tag1"
            app:layout_constraintTop_toTopOf="@+id/tag1">
            <View
                android:id="@+id/tagct2"
                android:background="#c9c9c9"
                android:layout_width="20dp"
                android:layout_height="2.5dp"/>
        </androidx.cardview.widget.CardView>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/text_color_40"
            android:id="@+id/tag2"
            android:layout_width="wrap_content"
            android:layout_height="19dp"
            android:layout_marginStart="6dp"
            app:layout_constraintBottom_toBottomOf="@+id/tagc1"
            app:layout_constraintStart_toEndOf="@+id/tagc2"
            app:layout_constraintTop_toTopOf="@+id/tagc1"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.github.mikephil.charting.charts.LineChart
        android:id="@+id/lineChart"
        android:layout_width="match_parent"
        android:layout_height="362dp"/>
</FrameLayout>
