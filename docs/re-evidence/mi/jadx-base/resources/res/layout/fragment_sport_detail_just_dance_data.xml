<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/fragment_sport_detail_just_dance_data_0"
    android:paddingBottom="@dimen/dimen_margin_10dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.xiaomi.fitness.widget.view.DataTitleSimpleView
        android:id="@+id/title_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_10dp">
        <TextView
            android:textColor="@color/text_color"
            android:id="@+id/just_dance_finish_song_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/page_extra_padding_horizontal_large"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/FontMedium.22sp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/text_color_40"
            android:id="@+id/just_dance_finish_song"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/trail_just_dance_finish_song"
            android:layout_marginStart="@dimen/page_extra_padding_horizontal_large"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/just_dance_finish_song_tv"/>
        <TextView
            android:textColor="@color/text_color"
            android:id="@+id/trail_just_dance_song_score_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/FontMedium.22sp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/text_color_40"
            android:id="@+id/trail_just_dance_song_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/trail_just_dance_song_score"
            app:layout_constraintEnd_toEndOf="@+id/trail_just_dance_song_score_tv"
            app:layout_constraintStart_toStartOf="@+id/trail_just_dance_song_score_tv"
            app:layout_constraintTop_toBottomOf="@+id/trail_just_dance_song_score_tv"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/dance_data_list_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="10dp"
        android:layout_marginHorizontal="@dimen/page_extra_padding_horizontal_large"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/text_color_40"
        android:gravity="center_vertical"
        android:layout_gravity="center_horizontal"
        android:id="@+id/dance_data_more_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/trail_sport_segment_btn_txt"
        android:drawableEnd="@drawable/sport_detail_just_dance_more_icon"/>
</LinearLayout>
