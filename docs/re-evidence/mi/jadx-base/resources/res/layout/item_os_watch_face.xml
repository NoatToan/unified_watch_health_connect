<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_os_watch_face_0"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/dimen_margin_24dp">
    <com.xiaomi.fitness.watch.face.view.FaceImageView
        android:layout_gravity="center"
        android:id="@+id/os_preview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:gravity="center_horizontal"
        android:id="@+id/name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/os_preview"
        style="@style/FontRegular.12sp"/>
    <TextView
        android:textColor="@color/text_select_color"
        android:id="@+id/state"
        android:background="@drawable/face_choose_available_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_4dp"
        android:text="@string/face_add_to_favorite"
        android:paddingHorizontal="@dimen/dimen_margin_12dp"
        android:paddingVertical="@dimen/dimen_margin_4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/name"
        style="@style/FontMedium.12sp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
