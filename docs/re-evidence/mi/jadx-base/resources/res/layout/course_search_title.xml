<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="45dp">
    <ImageView
        android:id="@+id/backIcon"
        android:background="@drawable/ic_left_back_black"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/back"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <EditText
        android:textSize="16sp"
        android:textColor="@color/text_color"
        android:textColorHint="@color/text_color_40"
        android:gravity="center_vertical"
        android:id="@+id/ed_search_course"
        android:background="@drawable/course_search_edit_bg"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:hint="@string/course_search_hint"
        android:singleLine="true"
        android:drawablePadding="6dp"
        android:inputType="text"
        android:imeOptions="actionSearch"
        android:drawableStart="@drawable/ic_search"
        android:paddingStart="16dp"
        android:paddingEnd="28dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="16dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tv_search"
        app:layout_constraintStart_toEndOf="@+id/backIcon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="0dp"/>
    <ImageView
        android:id="@+id/iv_search_clear"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/course_search_clear"
        android:paddingHorizontal="7dp"
        android:paddingVertical="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/ed_search_course"
        app:layout_constraintEnd_toEndOf="@+id/ed_search_course"
        app:layout_constraintTop_toTopOf="@+id/ed_search_course"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/colorPrimary"
        android:id="@+id/tv_search"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/course_search"
        app:layout_constraintBottom_toBottomOf="@+id/ed_search_course"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ed_search_course"/>
</androidx.constraintlayout.widget.ConstraintLayout>
