<?xml version="1.0" encoding="utf-8"?>
<miuix.springback.view.SpringBackLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/habit_activity_habit_share_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:scrollableView="@+id/spring_back_target">
    <miuix.core.widget.NestedScrollView
        android:id="@+id/spring_back_target"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/shareContent"
                android:background="@color/habit_punch_btn_yellow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:id="@+id/bigIconView"
                    android:layout_width="match_parent"
                    android:layout_height="333dp"
                    android:layout_margin="5dp"
                    android:scaleType="centerCrop"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="40sp"
                    android:textColor="@color/white"
                    android:id="@+id/continuePunchView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginStart="20dp"
                    app:layout_constraintStart_toStartOf="@+id/bigIconView"
                    app:layout_constraintTop_toTopOf="@+id/bigIconView"
                    app:layout_goneMarginLeft="25dp"
                    app:layout_goneMarginTop="14dp"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    android:id="@+id/shareDays"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toEndOf="@+id/continuePunchView"
                    app:layout_constraintTop_toTopOf="@+id/continuePunchView"/>
                <TextView
                    android:textSize="@dimen/dimen_18sp"
                    android:textColor="@color/white"
                    android:id="@+id/habitNameView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    app:layout_constraintStart_toStartOf="@+id/continuePunchView"
                    app:layout_constraintTop_toBottomOf="@+id/continuePunchView"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/white_60_transparent"
                    android:id="@+id/nickNameView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:layout_marginStart="26dp"
                    app:layout_constraintBottom_toBottomOf="@+id/bigIconView"
                    app:layout_constraintStart_toStartOf="@+id/bigIconView"/>
                <ImageView
                    android:id="@+id/shareQRView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="26dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/bigIconView"/>
                <ImageView
                    android:id="@+id/shareIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/habit_share_icon"
                    android:layout_marginEnd="28dp"
                    app:layout_constraintBottom_toTopOf="@+id/shareLongPressLabel"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/bigIconView"
                    app:layout_constraintVertical_chainStyle="packed"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/black"
                    android:gravity="end"
                    android:id="@+id/shareLongPressLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:maxWidth="150dp"
                    android:text="@string/habit_long_press_to_download"
                    app:layout_constraintBottom_toTopOf="@+id/appNameView"
                    app:layout_constraintEnd_toEndOf="@+id/shareIcon"
                    app:layout_constraintTop_toBottomOf="@+id/shareIcon"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/black"
                    android:id="@+id/appNameView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="@+id/shareIcon"
                    app:layout_constraintTop_toBottomOf="@+id/shareLongPressLabel"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </miuix.core.widget.NestedScrollView>
</miuix.springback.view.SpringBackLayout>
