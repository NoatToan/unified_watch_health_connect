<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/pay_layout_order_page_list_item_0"
    android:background="@drawable/pay_order_page_list_item_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/dimen_margin_10dp">
    <TextView
        android:textColor="@color/pay_wf_order_common_text"
        android:id="@+id/create_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="19dp"
        android:layout_marginStart="@dimen/dimen_margin_12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/FontRegular.14sp"/>
    <View
        android:id="@+id/divider_view"
        android:background="@color/pay_wf_divider_line"
        android:layout_width="match_parent"
        android:layout_height="0.33dp"
        android:layout_marginTop="@dimen/dimen_margin_17dp"
        android:layout_marginHorizontal="@dimen/dimen_margin_12dp"
        app:layout_constraintTop_toBottomOf="@+id/create_time"/>
    <TextView
        android:textColor="@color/pay_wf_order_common_text"
        android:id="@+id/order_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="19dp"
        android:layout_marginEnd="@dimen/dimen_margin_12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/FontRegular.14sp"/>
    <TextView
        android:id="@+id/order_pay"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_12dp"
        android:text="@string/pay_order_status_in_payment"
        android:layout_marginEnd="@dimen/dimen_margin_12dp"
        android:paddingHorizontal="@dimen/dimen_margin_12dp"
        android:paddingVertical="@dimen/dimen_margin_7dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/CommonBtn.Primary"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/sku_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider_view">
        <ImageView
            android:id="@+id/preview"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_marginTop="@dimen/dimen_margin_20dp"
            android:layout_marginBottom="19dp"
            android:scaleType="centerInside"
            android:layout_marginStart="@dimen/dimen_margin_12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textColor="@color/pay_wf_order_common_text"
            android:id="@+id/name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_margin_10dp"
            app:layout_constraintBottom_toTopOf="@+id/order_id"
            app:layout_constraintEnd_toStartOf="@+id/price"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@+id/preview"
            app:layout_constraintTop_toTopOf="@+id/preview"
            style="@style/FontDemiBold.16sp"/>
        <TextView
            android:textColor="@color/footer_desc"
            android:id="@+id/order_id"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/preview"
            app:layout_constraintEnd_toStartOf="@+id/price"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="@+id/name"
            app:layout_constraintTop_toBottomOf="@+id/name"
            style="@style/FontRegular.14sp"/>
        <TextView
            android:textSize="17sp"
            android:textColor="@color/pay_wf_order_common_text"
            android:id="@+id/price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dimen_margin_12dp"
            app:layout_constraintBottom_toBottomOf="@+id/preview"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/preview"
            style="@style/FontDemiBold"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
