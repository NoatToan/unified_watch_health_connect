<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/shape_card_bg_placeholder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/page_padding_horizontal_large"
    android:paddingVertical="@dimen/dimen_margin_16dp">
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/text_color_40"
        android:gravity="center_horizontal"
        android:id="@+id/guide_open_high_precision_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/health_entry_duration_to_sleep_not_detected_or_high_precision_off"
        android:drawableTop="@drawable/health_ic_sleep_empty"
        android:layout_marginHorizontal="@dimen/page_padding_horizontal_large"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/FontRegular.12sp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
