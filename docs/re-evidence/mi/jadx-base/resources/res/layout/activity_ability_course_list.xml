<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/main"
    android:tag="layout/activity_ability_course_list_0"
    android:background="@color/page_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.xiaomi.fitness.training_plan_export.widget.TrainingPlanTitleBar
        android:id="@+id/titlebar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/title_bar_height"
        android:layout_marginTop="@dimen/dimen_margin_36dp"
        android:layout_marginHorizontal="21dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:background="@drawable/training_card_shape"
        android:paddingTop="20dp"
        android:paddingBottom="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_12dp"
        android:paddingStart="@dimen/size_23"
        android:layout_marginStart="@dimen/dimen_margin_12dp"
        android:layout_marginEnd="@dimen/dimen_margin_12dp">
        <RelativeLayout
            android:gravity="center_horizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="@dimen/dimen_13sp"
                android:id="@+id/totalWeekIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/training_plan_ability_duration"
                android:layout_alignParentTop="true"
                android:fontFamily="@font/misanslatin_bold"
                android:layout_alignParentStart="true"/>
            <TextView
                android:textSize="24sp"
                android:id="@+id/totalWeek"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_8dp"
                android:layout_below="@+id/totalWeekIndicator"
                android:fontFamily="@font/misanslatin_medium"
                android:layout_alignParentStart="true"/>
            <TextView
                android:textSize="@dimen/dimen_14sp"
                android:textColor="@color/text_color_30"
                android:id="@+id/totalWeekUnit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignBaseline="@+id/totalWeek"
                android:fontFamily="@font/misanslatin_bold"
                android:layout_marginStart="4dp"
                android:layout_toEndOf="@+id/totalWeek"/>
        </RelativeLayout>
        <View
            android:background="@color/divider_color"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginTop="7dp"
            android:layout_marginBottom="7dp"/>
        <RelativeLayout
            android:gravity="center_horizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="@dimen/dimen_13sp"
                android:id="@+id/totalDayIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/training_plan_ability_days"
                android:layout_alignParentTop="true"
                android:fontFamily="@font/misanslatin_bold"
                android:layout_alignParentStart="true"/>
            <TextView
                android:textSize="24sp"
                android:id="@+id/totalDay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_8dp"
                android:layout_below="@+id/totalDayIndicator"
                android:fontFamily="@font/misanslatin_medium"
                android:layout_alignParentStart="true"/>
            <TextView
                android:textSize="@dimen/dimen_14sp"
                android:textColor="@color/text_color_30"
                android:id="@+id/totalDayUnit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignBaseline="@+id/totalDay"
                android:fontFamily="@font/misanslatin_bold"
                android:layout_marginStart="4dp"
                android:layout_toEndOf="@+id/totalDay"/>
        </RelativeLayout>
        <View
            android:background="@color/divider_color"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginTop="7dp"
            android:layout_marginBottom="7dp"/>
        <RelativeLayout
            android:gravity="center_horizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="@dimen/dimen_13sp"
                android:id="@+id/totalRestIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/training_plan_ability_rest_days"
                android:layout_alignParentTop="true"
                android:fontFamily="@font/misanslatin_bold"
                android:layout_alignParentStart="true"/>
            <TextView
                android:textSize="24sp"
                android:id="@+id/totalRest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_8dp"
                android:layout_below="@+id/totalRestIndicator"
                android:fontFamily="@font/misanslatin_medium"
                android:layout_alignParentStart="true"/>
            <TextView
                android:textSize="@dimen/dimen_14sp"
                android:textColor="@color/text_color_30"
                android:id="@+id/totalRestUnit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignBaseline="@+id/totalRest"
                android:fontFamily="@font/misanslatin_bold"
                android:layout_marginStart="4dp"
                android:layout_toEndOf="@+id/totalRest"/>
        </RelativeLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/training_card_shape"
        android:paddingTop="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp">
        <TextView
            android:textSize="17sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_8dp"
            android:text="@string/training_plan_ability_plan"
            android:layout_below="@+id/totalRestIndicator"
            android:fontFamily="@font/misanslatin_bold"
            android:layout_alignParentStart="true"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/courseList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_14dp"/>
    </LinearLayout>
</LinearLayout>
