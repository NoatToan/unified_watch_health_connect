<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/contentCardView"
    android:tag="layout/sport_fragment_create_route_select_style_pattern_0"
    android:background="@drawable/sport_route_ai_create_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardElevation="3dp"
    app:cardMaxElevation="3dp">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/contentLayout"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="29dp">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/confirmRouteTitleLayout"
            android:paddingBottom="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="23sp"
                android:textColor="@color/text_color"
                android:gravity="start|center_vertical"
                android:id="@+id/confirmRouteTitleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sport_input_route_info"
                android:fontFamily="@font/misanslatin_semibold"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/text_color_40"
                android:gravity="start|center_vertical"
                android:id="@+id/confirmRouteSubTitleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sport_please_select_a_pattern_you_want_to_generate"
                android:fontFamily="@font/misanslatin_regular"/>
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:layout_gravity="center_vertical"
            android:id="@+id/midContentView"
            android:scrollbars="none"
            android:clipChildren="true"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:nestedScrollingEnabled="true"
            android:paddingHorizontal="-4dp"
            android:paddingVertical="-4dp"/>
        <LinearLayout
            android:gravity="bottom|center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/bottomButtonLayout"
            android:paddingTop="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Button
                android:textSize="18dp"
                android:gravity="center"
                android:layout_gravity="start"
                android:id="@+id/button_prev"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/btn_pre"
                android:layout_weight="162"
                style="@style/SportCreateRouteGreyButtonStyle"/>
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="12"/>
            <Button
                android:textSize="18dp"
                android:gravity="center"
                android:layout_gravity="end"
                android:id="@+id/button_next"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/sport_start_drawing"
                android:layout_weight="162"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                style="@style/SportCreateRouteOrangeButtonStyle"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
