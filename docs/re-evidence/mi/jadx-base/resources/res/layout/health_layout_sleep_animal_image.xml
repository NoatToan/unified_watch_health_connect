<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/health_layout_sleep_animal_image_0"
    android:background="@drawable/shape_data_item_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/size_30"
    android:paddingVertical="@dimen/size_32">
    <TextView
        android:textSize="@dimen/dimen_18sp"
        android:textColor="@color/text_color"
        android:id="@+id/tv_no_report_title"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/health_sleep_sleep_animal_identification"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/FontLatinSemiBold"/>
    <TextView
        android:textColor="@color/text_color_80"
        android:id="@+id/tv_no_report_subtitle"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_no_report_title"
        style="@style/FontRegular.12sp"/>
    <TextView
        android:textSize="@dimen/font_24"
        android:textColor="@color/text_color"
        android:id="@+id/tv_has_report_animal_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/health_sleep_animal_night_owl_type"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/FontLatinSemiBold"/>
    <TextView
        android:textSize="@dimen/font_12"
        android:textColor="@color/text_color_60"
        android:id="@+id/tv_has_report_time_range"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_has_report_animal_type"
        style="@style/FontRegular"/>
    <TextView
        android:textSize="@dimen/font_8_68"
        android:textColor="@color/text_color_50"
        android:id="@+id/tv_has_report_tag"
        android:background="@drawable/health_sleep_tag_view_bg_shape"
        android:paddingBottom="1.3dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_3_3"
        android:paddingHorizontal="5.3dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/tv_has_report_time_range"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/tv_has_report_time_range"
        app:layout_constraintTop_toTopOf="@+id/tv_has_report_time_range"
        style="@style/FontRegular"/>
    <TextView
        android:textSize="@dimen/font_13_3"
        android:textColor="@color/text_color"
        android:gravity="center"
        android:id="@+id/tv_has_report_animal_desc"
        android:layout_width="245dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_10_67"
        android:text="@string/health_sleep_animal_introduction_night_owl"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_has_report_time_range"
        style="@style/FontRegular"/>
    <com.xiaomi.fitness.health.sleep.view.SleepAnimalShadowLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/shadow_has_report"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-11dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_has_report_animal_desc"
        app:shadowColor="@color/health_sleep_animal_shadow_sheep"
        app:shadowDx="20dp"
        app:shadowDy="20dp"
        app:shadowRadius="13dp"
        app:shadowShape="oval">
        <com.xiaomi.fitness.widget.view.RoundImageView
            android:id="@+id/iv_has_report_animal"
            android:layout_width="180dp"
            android:layout_height="180dp"
            app:innerStrokeColor="@color/health_sleep_animal_stroke_sheep"
            app:innerStrokeWidth="0.33dp"
            app:srcCompat="@drawable/health_sleep_animal_sheep"/>
    </com.xiaomi.fitness.health.sleep.view.SleepAnimalShadowLayout>
    <RelativeLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/shadow_no_report"
        android:padding="23dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_no_report_subtitle">
        <FrameLayout
            android:background="@drawable/health_sleep_report_image_no_report_oval_stroke_bg"
            android:layout_width="180dp"
            android:layout_height="180dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:id="@+id/iv_no_report_animal"
                android:focusable="true"
                android:layout_width="179.7dp"
                android:layout_height="179.7dp"
                app:srcCompat="@drawable/health_sleep_animal_sheep"/>
        </FrameLayout>
    </RelativeLayout>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="shadow_no_report,shadow_has_report"/>
    <com.xiaomi.fitness.health.sleep.view.SleepAnimalShadowLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-14.3dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/barrier"
        app:shadowColor="#1448366c"
        app:shadowDx="3dp"
        app:shadowDy="5dp"
        app:shadowRadius="10dp"
        app:shadowShape="rectangle">
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/health_sleep_floating_text_color"
            android:id="@+id/tv_understand_animal"
            android:background="@drawable/health_sleep_understand_animal_bg_shape"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/health_sleep_animal_understand"
            android:drawablePadding="4dp"
            android:paddingHorizontal="14.7dp"
            android:paddingVertical="7dp"
            app:drawableEndCompat="@drawable/health_ic_sleep_purple_jump_wrapper"
            style="@style/FontMedium.12sp"/>
    </com.xiaomi.fitness.health.sleep.view.SleepAnimalShadowLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
