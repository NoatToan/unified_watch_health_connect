<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_electronic_scale_device_manage_0"
    android:background="@color/page_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <miuix.springback.view.SpringBackLayout
        android:id="@+id/shareListView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="10dp"
        android:layout_above="@+id/device_share_add"
        app:scrollableView="@+id/spring_back_target">
        <miuix.core.widget.NestedScrollView
            android:id="@+id/spring_back_target"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/layout_activity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/text_color_40"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/electronic_scale_device_has_shared"
                    android:layout_marginStart="26dp"
                    android:layout_marginHorizontal="20dp"/>
                <com.xiaomi.fitness.electronic.scale.widget.NoScrollRecyclerView
                    android:id="@+id/account_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:overScrollMode="never"/>
            </LinearLayout>
        </miuix.core.widget.NestedScrollView>
    </miuix.springback.view.SpringBackLayout>
    <RelativeLayout
        android:id="@+id/emptyView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/device_share_add">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:src="@drawable/icon_common_empty"
            android:layout_above="@+id/tv_text"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textColor="@color/text_color_40"
            android:id="@+id/tv_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_data"
            android:layout_centerInParent="true"
            style="@style/FontRegular.14sp"/>
    </RelativeLayout>
    <Button
        android:id="@+id/device_share_add"
        android:layout_marginBottom="27dp"
        android:text="@string/electronic_sale_device_device_share_add"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginHorizontal="20dp"
        style="@style/CommonBtn.Primary"/>
</RelativeLayout>
