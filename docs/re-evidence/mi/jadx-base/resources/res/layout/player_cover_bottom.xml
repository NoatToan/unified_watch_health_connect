<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/movie_player_bottom"
    android:background="@drawable/player_bottom_view_bg"
    android:layout_width="match_parent"
    android:layout_height="50dp"
    android:layout_alignParentBottom="true">
    <TextView
        android:textSize="13sp"
        android:textColor="@android:color/white"
        android:id="@+id/player_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00"
        android:layout_marginStart="12dp"/>
    <SeekBar
        android:id="@+id/player_small_screen_seekBar"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxHeight="2dp"
        android:max="100"
        android:progressDrawable="@drawable/inline_player_progress_seekbar_bg"
        android:minHeight="2dp"
        android:thumb="@drawable/inline_progress_thumb_selector"
        android:layout_weight="1"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        style="@style/VideoSeekBar"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@android:color/white"
        android:id="@+id/player_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00"
        android:layout_marginEnd="5dp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@android:color/white"
        android:gravity="center_vertical"
        android:id="@+id/player_clarity"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:paddingStart="8dp"
        android:layout_marginEnd="12dp"/>
    <RelativeLayout
        android:id="@+id/player_change_screen_layout"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_centerVertical="true"
        android:paddingStart="5dp"
        android:paddingEnd="8dp"
        android:layout_alignParentEnd="true">
        <ImageView
            android:id="@+id/player_change_screen_imge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/inline_to_full_screen"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
</LinearLayout>
