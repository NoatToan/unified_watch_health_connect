<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/device_settings_fragment_ble_heart_rate_setting_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/page_content_padding_horizontal_large">
    <com.xiaomi.fitness.widget.RightArrowBindingTwoLineTextView
        android:id="@+id/hr_mode_setting_view"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/device_settings_hr_monitor_type"/>
    <com.xiaomi.fitness.widget.RightArrowBindingTwoLineTextView
        android:id="@+id/highWarningView"
        android:tag="binding_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:subtitle="@string/device_settings_high_hr_notify_des"
        app:title="@string/device_settings_high_hr_notify"/>
    <com.xiaomi.fitness.widget.RightArrowBindingTwoLineTextView
        android:id="@+id/lowWarningView"
        android:tag="binding_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:subtitle="@string/device_settings_low_hr_warning_des"
        app:title="@string/device_settings_low_hr_warning_title"/>
    <com.xiaomi.fitness.widget.SwitchButtonBindingTwoLineTextView
        android:id="@+id/sport_hr_warning_switch_view"
        android:tag="binding_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:subtitle="@string/device_settings_high_sport_hr_notify_des"
        app:title="@string/device_settings_high_sport_hr_notify"/>
    <com.xiaomi.fitness.widget.RightArrowBindingTwoLineTextView
        android:id="@+id/sport_hr_warning_setting_view"
        android:tag="binding_5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/device_settings_high_sport_hr_notify_threshold"/>
    <com.xiaomi.fitness.widget.SwitchButtonTwoLineTextView
        android:id="@+id/heartHealthyView"
        android:tag="binding_6"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:subtitle="@string/device_settings_detection_heart_healthy_des"
        app:title="@string/device_settings_detection_heart_healthy"/>
    <com.xiaomi.fitness.devicesettings.widget.DeviceReminderView
        android:tag="binding_7"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_40dp"/>
</LinearLayout>
