<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/device_settings_todo_remind_fragment_0"
    android:background="@color/page_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/todo_reminder_recycler"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="13.3dp"
        android:overScrollMode="never"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@+id/barrier"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/text_color_40"
        android:gravity="center"
        android:id="@+id/tv_no_data"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="70dp"
        android:text="@string/device_settings_no_todo_tips"
        android:drawableTop="@drawable/icon_common_empty"
        android:drawablePadding="@dimen/size_10"
        app:layout_constraintBottom_toTopOf="@+id/tv_add_todo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/FontRegular.14sp"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="top"
        app:constraint_referenced_ids="tv_add_todo,bottom_delete_layout"/>
    <TextView
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_add_todo"
        android:background="@drawable/selector_bottom_btn_positive_bg"
        android:layout_width="@dimen/common_btn_single_line_width"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size_26_67"
        android:text="@string/device_settings_todo_add"
        android:layout_weight="1"
        android:paddingHorizontal="@dimen/size_10"
        android:paddingVertical="12.7dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/FontMedium.16sp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/bottom_delete_layout"
        android:background="@color/page_white_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">
        <com.xiaomi.fitness.widget.view.DividerView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/text_color"
            android:gravity="center"
            android:id="@+id/tvDelete"
            android:paddingTop="15dp"
            android:paddingBottom="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/common_delete"
            android:drawableTop="@drawable/ic_delete_bottom"
            android:drawablePadding="2dp"
            style="@style/FontRegular"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
