<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:id="@+id/msg_item"
    android:tag="layout/dialog_share_track_select_0"
    android:background="@drawable/share_path_pic_bottom_bg_gradient"
    android:paddingTop="@dimen/dimen_margin_10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_alignParentBottom="true">
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_5dp"
        android:layout_marginStart="80dp"
        android:layout_marginEnd="80dp">
        <RelativeLayout
            android:orientation="vertical"
            android:id="@+id/rlDownload"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/img_download"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:src="@drawable/share_download"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="@dimen/dimen_10sp"
                android:gravity="center"
                android:id="@+id/txt_download"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_5dp"
                android:text="@string/trail_update_download"
                android:layout_below="@+id/img_download"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:orientation="vertical"
            android:id="@+id/rlShareWxSession"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/img_share_wx_session"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:src="@drawable/share_wx_session"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="@dimen/dimen_10sp"
                android:gravity="center"
                android:id="@+id/txt_share_wx_session"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_5dp"
                android:text="@string/trail_share_wx_session"
                android:layout_below="@+id/img_share_wx_session"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:orientation="vertical"
            android:id="@+id/rl_more"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/img_share_more"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:src="@drawable/ic_share_more"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="@dimen/dimen_10sp"
                android:gravity="center"
                android:id="@+id/tv_more"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_5dp"
                android:text="@string/more"
                android:layout_below="@+id/img_share_more"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
