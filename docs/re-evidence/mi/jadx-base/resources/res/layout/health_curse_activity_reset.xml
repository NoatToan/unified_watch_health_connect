<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:tag="layout/health_curse_activity_reset_0"
    android:background="@color/health_page_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/dimen_margin_12dp">
    <androidx.core.widget.NestedScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">
        <androidx.constraintlayout.widget.ConstraintLayout xmlns:app="http://schemas.android.com/apk/res-auto"
            android:id="@+id/state_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.xiaomi.fitness.health.curse.view.CurseSetItemView
                android:id="@+id/inDaysView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6.67dp"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.xiaomi.fitness.health.curse.view.CurseSetItemView
                android:id="@+id/intervalView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/inDaysView"/>
            <com.xiaomi.fitness.health.curse.view.CurseSetItemView
                android:id="@+id/lastView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/intervalView"/>
            <com.xiaomi.fitness.widget.SwitchButtonSingleLineTextView
                android:id="@+id/predictView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/dimen_margin_12dp"
                app:layout_constraintTop_toBottomOf="@+id/lastView"
                app:title="@string/health_curse_predict"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <Button
        android:layout_gravity="bottom"
        android:id="@+id/startView"
        android:visibility="gone"
        android:text="@string/health_curse_use"
        style="@style/CommonBtn.Primary"/>
</LinearLayout>
