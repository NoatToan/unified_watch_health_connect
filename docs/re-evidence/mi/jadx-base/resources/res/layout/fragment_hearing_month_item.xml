<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/fragment_hearing_month_item_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/layout_hearing_top_guide"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.xiaomi.fitness.chart.view.BarChartRecyclerView
            android:id="@+id/bar_recycler"
            app:barChartRoundRectRadiusRatio="0.25"
            app:chartColor="@color/stress_chart"
            app:displayNumbers="31"
            app:enableStartYAxisLabel="false"
            style="@style/ChartBaseStyle"/>
        <com.xiaomi.fitness.view.DataTitleView
            android:id="@+id/dataTitleView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/card_volume"
        android:background="@drawable/selector_card_bg"
        android:paddingTop="@dimen/size_20"
        android:paddingBottom="@dimen/size_20"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_12"
        android:layout_marginHorizontal="@dimen/health_detail_page_common_margin_horizontal">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_icon"
            android:background="@drawable/ic_health_hearing_volume"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:layout_marginStart="@dimen/size_18"/>
        <TextView
            android:textColor="@color/text_color"
            android:gravity="start"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/health_hearing_ambient_volume_higher"
            android:paddingEnd="@dimen/size_20"
            android:layout_marginStart="@dimen/size_10"
            style="@style/FontMedium.14sp"/>
        <TextView
            android:textColor="@color/text_color_40"
            android:gravity="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:drawableEnd="@drawable/ic_base_right_arrow_icon"
            android:layout_marginEnd="@dimen/size_18"
            style="@style/FontRegular.14sp"/>
    </LinearLayout>
    <com.xiaomi.fitness.view.CardUnderstandView
        android:id="@+id/understandCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/health_detail_page_common_margin_horizontal"
        app:txtUnderstand="@string/health_hearing_understand"/>
</LinearLayout>
