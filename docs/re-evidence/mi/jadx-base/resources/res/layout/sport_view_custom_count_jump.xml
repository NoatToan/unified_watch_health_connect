<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/sport_view_custom_count_jump_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <EditText
        android:textSize="60dp"
        android:textStyle="bold"
        android:textColor="@color/sport_color_black"
        android:textColorHint="@color/text_color_30"
        android:gravity="bottom|right"
        android:layout_gravity="center_horizontal"
        android:id="@+id/goalEditText"
        android:background="@null"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:maxLength="4"
        android:inputType="number"
        android:textCursorDrawable="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/space"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="9dp"
        app:layout_constraintLeft_toLeftOf="@+id/goalEditText"
        app:layout_constraintRight_toRightOf="@+id/goalEditText"
        app:layout_constraintTop_toBottomOf="@+id/goalEditText"/>
    <TextView
        android:textSize="20dp"
        android:textStyle="bold"
        android:id="@+id/unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="2dp"
        android:layout_marginBottom="@dimen/dimen_margin_6dp"
        app:layout_constraintBottom_toBottomOf="@+id/space"
        app:layout_constraintLeft_toRightOf="@+id/goalEditText"/>
</androidx.constraintlayout.widget.ConstraintLayout>
