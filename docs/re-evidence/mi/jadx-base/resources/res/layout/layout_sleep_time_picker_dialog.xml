<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/tv_dialog_title"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Dialog.Text.Title"/>
    <TextView
        android:id="@+id/tv_jump_today"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/today"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Dialog.Text.Today"/>
    <TextView
        android:textSize="@dimen/dimen_24sp"
        android:gravity="center"
        android:id="@+id/tv_dialog_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawableEnd="@drawable/sleep_diary_pick_time_more_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_dialog_title"
        style="@style/Dialog.Text.Description"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_174"
        android:weightSum="2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_dialog_description">
        <com.xiaomi.fitness.baseui.widget.SpinnerDatePicker
            android:id="@+id/date_picker"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="@dimen/size_174"
            android:layout_weight="2"
            app:sdp_layout="@layout/layout_for_date_picker_dialog_11"/>
        <com.xiaomi.fitness.baseui.widget.NumberPickerView
            android:id="@+id/dialog_picker_hour"
            android:focusable="true"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:npv_DividerColor="@color/transparent"
            app:npv_HintText="@string/unit_hour"
            app:npv_NumberDigits="1"
            app:npv_SelectItemBackgroundColor="@color/pressed_common_item_bg_color"
            app:npv_TextColorOuter="@color/divider_color"
            app:npv_TextSizeNormal="@dimen/font_16_7"
            app:npv_WrapSelectorWheel="true"
            style="@style/Picker.Number.DateDialog"/>
        <com.xiaomi.fitness.baseui.widget.NumberPickerView
            android:id="@+id/dialog_picker_minute"
            android:focusable="true"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:npv_DividerColor="@color/transparent"
            app:npv_HintText="@string/unit_min"
            app:npv_NumberDigits="1"
            app:npv_SelectItemBackgroundColor="@color/pressed_common_item_bg_color"
            app:npv_TextColorOuter="@color/divider_color"
            app:npv_TextSizeNormal="@dimen/font_16_7"
            app:npv_WrapSelectorWheel="true"
            style="@style/Picker.Number.DateDialog"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.constraintlayout.widget.ConstraintLayout>
