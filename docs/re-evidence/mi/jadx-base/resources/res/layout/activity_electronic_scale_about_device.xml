<?xml version="1.0" encoding="utf-8"?>
<miuix.springback.view.SpringBackLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_electronic_scale_about_device_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:scrollableView="@+id/scroll_view">
    <miuix.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/layout_activity"
            android:paddingBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_device_img"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_marginTop="40dp"
                android:src="@drawable/electronic_scale_icon_eight_electric_scale"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/dimen_20sp"
                android:textStyle="bold"
                android:textColor="@color/text_color"
                android:gravity="center"
                android:id="@+id/tv_device_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/electronic_scale_eight_electric"
                android:layout_marginHorizontal="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/iv_device_img"/>
            <com.xiaomi.fitness.widget.RightArrowBindingSingleLineTextView
                android:id="@+id/tv_device_model"
                android:tag="binding_1"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="40dp"
                android:layout_marginHorizontal="@dimen/page_content_padding_horizontal_large"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_device_name"
                app:showMore="false"
                app:title="@string/electronic_scale_device_model"/>
            <com.xiaomi.fitness.widget.RightArrowBindingSingleLineTextView
                android:id="@+id/tv_mac_address"
                android:tag="binding_2"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginHorizontal="@dimen/page_content_padding_horizontal_large"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_device_model"
                app:showMore="false"
                app:title="@string/electronic_scale_mac_address"/>
            <com.xiaomi.fitness.widget.RightArrowBindingSingleLineTextView
                android:id="@+id/tv_firmware_version"
                android:tag="binding_3"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginHorizontal="@dimen/page_content_padding_horizontal_large"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_mac_address"
                app:showMore="false"
                app:title="@string/electronic_scale_firmware_version"/>
            <com.xiaomi.fitness.widget.RightArrowBindingSingleLineTextView
                android:id="@+id/tv_serial_number"
                android:tag="binding_4"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginHorizontal="@dimen/page_content_padding_horizontal_large"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_firmware_version"
                app:showMore="false"
                app:title="@string/electronic_scale_serial_number"/>
            <com.xiaomi.fitness.widget.RightArrowBindingSingleLineTextView
                android:id="@+id/tv_privacy_policy"
                android:tag="binding_5"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginHorizontal="@dimen/page_content_padding_horizontal_large"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_serial_number"
                app:showMore="true"
                app:title="@string/electronic_scale_privacy_policy"/>
            <com.xiaomi.fitness.widget.RightArrowBindingSingleLineTextView
                android:id="@+id/tv_withdrawal_consent"
                android:tag="binding_6"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginHorizontal="@dimen/page_content_padding_horizontal_large"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_privacy_policy"
                app:showMore="true"
                app:title="@string/electronic_scale_withdrawal_consent"/>
        </LinearLayout>
    </miuix.core.widget.NestedScrollView>
</miuix.springback.view.SpringBackLayout>
