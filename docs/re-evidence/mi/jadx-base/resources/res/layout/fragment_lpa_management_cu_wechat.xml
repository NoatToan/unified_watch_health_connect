<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_lpa_management_cu_wechat_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <Button
        android:id="@+id/generate_qrcode"
        android:layout_marginTop="@dimen/dimen_margin_50dp"
        android:text="手表生成二维码"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/CommonBtn.Primary"/>
    <Button
        android:id="@+id/start_download"
        android:layout_marginTop="50dp"
        android:text="下载eSIM卡数据"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/generate_qrcode"
        style="@style/CommonBtn.Primary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
