<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/shape_card_bg_inner"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="160dp"
    android:paddingHorizontal="@dimen/dimen_margin_12dp"
    android:paddingVertical="@dimen/dimen_margin_12dp">
    <TextView
        android:id="@+id/training_indicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:drawablePadding="6dp"
        android:textDirection="locale"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/FontMedium.16sp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/latest_data_or_guide"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/training_indicator">
        <TextView
            android:textSize="@dimen/dimen_18sp"
            android:textColor="@color/text_color"
            android:gravity="start"
            android:id="@+id/latest_data"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_4dp"
            android:textDirection="locale"
            style="@style/FontMedium"/>
        <TextView
            android:textSize="@dimen/dimen_14sp"
            android:textColor="@color/text_color"
            android:gravity="start|center_vertical"
            android:id="@+id/guide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_4dp"
            android:text="@string/sport_measure_after_wear_device"
            android:drawableEnd="@drawable/ic_right_arrow"
            android:textDirection="locale"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/dimen_13sp"
        android:textColor="@color/text_color_30"
        android:gravity="start"
        android:id="@+id/description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textDirection="locale"
        app:layout_constraintBottom_toTopOf="@+id/level_bar"
        app:layout_constraintTop_toBottomOf="@+id/latest_data_or_guide"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/level_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_margin_20dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <com.xiaomi.fitness.baseui.widget.LevelBarView
            android:id="@+id/levelBarView"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_margin_30dp"
            app:levelBarHeight="10dp"
            app:levelBarRadius="5dp"/>
        <ImageView
            android:id="@+id/no_data_default_level_bar_view"
            android:background="@drawable/shape_card_bg_default_level_bar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_margin_10dp"
            android:layout_marginBottom="@dimen/dimen_margin_8dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/level_des_group"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_margin_30dp"
        android:weightSum="2"
        app:layout_constraintBottom_toBottomOf="parent">
        <TextView
            android:textSize="@dimen/dimen_12sp"
            android:textColor="@color/text_color_30"
            android:ellipsize="end"
            android:gravity="start"
            android:layout_gravity="center_vertical"
            android:id="@+id/start_level_des"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:layout_weight="1"
            android:textDirection="locale"/>
        <TextView
            android:textSize="@dimen/dimen_12sp"
            android:textColor="@color/text_color_30"
            android:ellipsize="end"
            android:gravity="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/end_level_des"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:layout_weight="1"
            android:textDirection="locale"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
