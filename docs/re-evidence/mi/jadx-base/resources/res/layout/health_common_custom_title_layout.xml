<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:tag="layout/health_common_custom_title_layout_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_back"
        android:background="@drawable/ic_left_back_black"
        android:layout_width="33.3dp"
        android:layout_height="33.3dp"
        android:layout_centerVertical="true"
        android:contentDescription="@string/back"
        android:layout_marginStart="@dimen/dimen_margin_18dp"/>
    <TextView
        android:textColor="@color/text_color"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="200dp"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        style="@style/FontMedium.16sp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/size_18"
        android:layout_alignParentEnd="true">
        <ImageView
            android:id="@+id/iv_history"
            android:background="@drawable/ui_common_ic_history"
            android:layout_width="33.3dp"
            android:layout_height="33.3dp"
            android:contentDescription="@string/web_history"/>
        <ImageView
            android:id="@+id/iv_share"
            android:background="@drawable/icon_share_enabled"
            android:layout_width="33.3dp"
            android:layout_height="33.3dp"
            android:contentDescription="@string/web_share"
            android:layout_marginStart="5.3dp"/>
    </LinearLayout>
</RelativeLayout>
