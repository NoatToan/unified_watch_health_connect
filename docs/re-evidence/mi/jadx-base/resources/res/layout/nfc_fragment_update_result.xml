<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/nfc_fragment_update_result_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:orientation="vertical"
        android:id="@+id/deviceContainnerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12.66dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.xiaomi.fitness.nfc.widget.DeviceImageView
            android:id="@+id/deviceView"
            android:layout_width="@dimen/dimen_margin_200dp"
            android:layout_height="@dimen/dimen_margin_200dp"
            android:layout_centerHorizontal="true"/>
        <ImageView
            android:id="@+id/statusView"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/nfc_card_issue_success_big"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <TextView
        android:textSize="@dimen/dimen_24sp"
        android:id="@+id/statusTextView"
        android:paddingBottom="@dimen/dimen_margin_3dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_20dp"
        android:text="@string/nfc_settings_mastercard_pwd_upgrade_succeed"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/deviceContainnerView"/>
    <TextView
        android:textSize="@dimen/dialog_text_size_14"
        android:gravity="center"
        android:id="@+id/descView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/nfc_settings_mastercard_pwd_upgrade_desc"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/statusTextView"/>
    <Button
        android:id="@+id/nextView"
        android:text="@string/passport_request_agree"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/CommonBtn.Black"/>
</androidx.constraintlayout.widget.ConstraintLayout>
