<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="372dp">
    <com.xiaomi.fitness.widget.view.HomeHeaderView
        android:id="@+id/health_header_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_47dp"
        app:header_desc="@string/health_title_subtitle"
        app:header_title="@string/health_main_tab_health_name"
        app:layout_constraintTop_toTopOf="parent"/>
    <RelativeLayout
        android:orientation="vertical"
        android:id="@+id/ll_target_container"
        android:background="@drawable/selector_round"
        android:layout_width="match_parent"
        android:layout_height="186dp"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="@dimen/page_padding_horizontal_large">
        <com.xiaomi.fitness.health.threetarget.model.ThreeTargetView
            android:id="@+id/targetView"
            android:layout_width="154dp"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="36dp"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="20dp"
            android:layout_toEndOf="@+id/targetView">
            <com.xiaomi.fitness.homepage.view.DataHeaderTargetItemView
                android:id="@+id/firstTargetItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"/>
            <com.xiaomi.fitness.homepage.view.DataHeaderTargetItemView
                android:id="@+id/secondTargetItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"/>
            <com.xiaomi.fitness.homepage.view.DataHeaderTargetItemView
                android:id="@+id/thirdTargetItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/imageContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_alignParentTop="true"
        android:layout_marginEnd="@dimen/page_padding_horizontal_large"
        android:layout_alignParentEnd="true">
        <ImageView
            android:id="@+id/img_virtual_avatar"
            android:layout_width="235dp"
            android:layout_height="337dp"
            android:scaleType="centerCrop"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</RelativeLayout>
