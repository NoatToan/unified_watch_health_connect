<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:tag="layout-large/layout_blood_pressure_data_title_view_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_title"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_3"
        android:layout_marginStart="@dimen/chart_common_padding_start"
        android:layout_marginEnd="@dimen/size_10">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_gravity="bottom"
                android:orientation="horizontal"
                android:id="@+id/ll_bp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/font_14"
                    android:textColor="@color/text_color"
                    android:gravity="bottom"
                    android:id="@+id/tv_bp_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/health_blood_pressure"
                    android:maxLines="1"
                    style="@style/FontMedium.14sp"/>
                <TextView
                    android:textSize="@dimen/font_33_3"
                    android:textColor="@color/text_color"
                    android:gravity="bottom"
                    android:id="@+id/tv_bp_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="200dp"
                    android:maxLines="1"
                    android:layout_marginStart="@dimen/size_3"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="14sp"
                    style="@style/FontMedium"/>
                <TextView
                    android:textSize="@dimen/font_14"
                    android:textColor="@color/text_color"
                    android:ellipsize="end"
                    android:gravity="bottom"
                    android:id="@+id/tv_bp_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/health_blood_pressure_unit_short"
                    android:maxLines="1"
                    android:layout_marginStart="@dimen/size_3"
                    android:autoSizeTextType="uniform"
                    style="@style/FontMedium.14sp"/>
            </LinearLayout>
            <LinearLayout
                android:layout_gravity="bottom"
                android:orientation="horizontal"
                android:id="@+id/ll_pulse"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="26dp">
                <TextView
                    android:textSize="@dimen/font_14"
                    android:textColor="@color/text_color"
                    android:gravity="bottom"
                    android:id="@+id/tv_pulse_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/health_blood_pressure_pulse"
                    style="@style/FontMedium.14sp"/>
                <TextView
                    android:textSize="@dimen/font_33_3"
                    android:textColor="@color/text_color"
                    android:gravity="bottom"
                    android:id="@+id/tv_pulse_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/size_3"
                    style="@style/FontMedium"/>
                <TextView
                    android:textSize="@dimen/font_14"
                    android:textColor="@color/text_color"
                    android:gravity="bottom"
                    android:id="@+id/tv_pulse_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/health_blood_pressure_unit_short"
                    android:layout_marginStart="@dimen/size_3"
                    style="@style/FontMedium.14sp"/>
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:textColor="@color/health_subtitle_text_color_40"
            android:id="@+id/tvDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            style="@style/FontRegular.12sp"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/font_30"
        android:layout_gravity="start|center_vertical"
        android:id="@+id/tvEmpty"
        android:paddingTop="@dimen/size_5"
        android:paddingBottom="@dimen/size_5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/chart_common_padding_start"
        android:layout_marginEnd="@dimen/size_30"
        android:autoSizeTextType="uniform"
        style="@style/FontMedium"/>
</FrameLayout>
