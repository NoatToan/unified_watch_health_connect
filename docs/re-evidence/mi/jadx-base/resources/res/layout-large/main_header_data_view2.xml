<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="306dp">
    <RelativeLayout
        android:id="@+id/ll_target_container"
        android:background="@drawable/selector_round"
        android:layout_width="match_parent"
        android:layout_height="186dp"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="@dimen/page_padding_horizontal_large">
        <com.xiaomi.fitness.health.threetarget.model.ThreeTargetView
            android:id="@+id/targetView"
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="97dp"
            android:layout_alignParentStart="true"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="70dp"
            android:layout_toEndOf="@+id/targetView">
            <com.xiaomi.fitness.homepage.view.DataHeaderTargetItemView
                android:id="@+id/firstTargetItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/size_10"/>
            <com.xiaomi.fitness.homepage.view.DataHeaderTargetItemView
                android:id="@+id/secondTargetItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/size_10"/>
            <com.xiaomi.fitness.homepage.view.DataHeaderTargetItemView
                android:id="@+id/thirdTargetItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </RelativeLayout>
    <com.xiaomi.fitness.widget.view.HomeHeaderView
        android:id="@+id/health_header_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_47dp"
        app:header_desc="@string/health_title_subtitle"
        app:header_title="@string/health_main_tab_health_name"
        app:layout_constraintTop_toTopOf="parent"/>
</RelativeLayout>
