<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout-large/trail_chart_layout_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dataContainer"
        android:background="@drawable/trail_record_data"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8.67dp"
        android:layout_marginStart="@dimen/page_extra_padding_horizontal_large"
        android:layout_marginEnd="@dimen/dimen_margin_20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/trail_data"
            android:textColor="@color/trail_black"
            android:id="@+id/data1View"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/FontLatinDemiBold"/>
        <TextView
            android:textSize="@dimen/trail_data"
            android:textColor="@color/trail_black"
            android:id="@+id/data2View"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26.67dp"
            android:text="26.25KM"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/data1View"
            style="@style/FontLatinDemiBold"/>
        <TextView
            android:textSize="@dimen/trail_data"
            android:textColor="@color/trail_black"
            android:id="@+id/data3View"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26.67dp"
            android:text="270千卡"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/data2View"
            style="@style/FontLatinDemiBold"/>
        <TextView
            android:textSize="@dimen/trail_data"
            android:textColor="@color/trail_black"
            android:id="@+id/data4View"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26.67dp"
            android:text="00:28:36"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/data3View"
            style="@style/FontLatinDemiBold"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.xiaomi.fitness.trail.widget.RecordChartView
        android:id="@+id/barView"
        android:layout_width="0dp"
        android:layout_height="150dp"
        android:paddingEnd="@dimen/dimen_margin_30dp"
        android:layout_marginStart="@dimen/dimen_margin_20dp"
        android:paddingHorizontal="@dimen/dimen_margin_10dp"
        app:layout_constraintBottom_toBottomOf="@+id/dataContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/dataContainer"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
