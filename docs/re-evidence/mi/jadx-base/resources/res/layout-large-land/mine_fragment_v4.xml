<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout-large-land/mine_fragment_v4_0"
    android:background="@color/mine_page_background"
    android:paddingTop="@dimen/dimen_margin_20dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.xiaomi.fitness.widget.view.HomeHeaderTabTitleView
        android:id="@+id/mine_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <miuix.springback.view.SpringBackLayout
        android:id="@+id/swipe_container"
        android:background="@color/mine_page_background"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mine_header"
        app:scrollableView="@+id/scrollView">
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="vertical"
                android:id="@+id/root_view"
                android:background="@color/mine_page_background"
                android:paddingBottom="@dimen/dimen_margin_20dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.xiaomi.fitness.mine.widget.MineUserInfoView
                    android:id="@+id/layout_user_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/page_extra_padding_horizontal_large"/>
                <com.xiaomi.fitness.mine.widget.MineAssetsView
                    android:id="@+id/layout_user_assets"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:layout_goneMarginTop="0dp"/>
                <com.xiaomi.fitness.mine.vip.MineVipView
                    android:id="@+id/vip_entrance"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:layout_goneMarginTop="0dp"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/mine_function_cn_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_margin_12dp"
                    app:layout_constraintTop_toBottomOf="@+id/layout_user_assets">
                    <View
                        android:id="@+id/cn_guide_line"
                        android:layout_width="@dimen/dimen_margin_1dp"
                        android:layout_height="1dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>
                    <View
                        android:id="@+id/mine_function_guideline_bottom"
                        android:layout_width="1dp"
                        android:layout_height="1dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>
                    <com.xiaomi.fitness.mine.widget.MineHabitView
                        android:id="@+id/layout_user_habit"
                        android:layout_width="0dp"
                        android:layout_height="210dp"
                        android:layout_marginEnd="@dimen/dimen_margin_4dp"
                        app:layout_constraintBottom_toBottomOf="@+id/mine_function_guideline_bottom"
                        app:layout_constraintEnd_toStartOf="@+id/cn_guide_line"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <com.xiaomi.fitness.mine.widget.MineWeekReportView
                        android:id="@+id/weekly_report_view"
                        android:layout_width="0dp"
                        android:layout_height="99dp"
                        android:layout_marginStart="@dimen/dimen_margin_4dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/cn_guide_line"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <com.xiaomi.fitness.mine.widget.MineActivePKView
                        android:id="@+id/active_pk_view"
                        android:layout_width="0dp"
                        android:layout_height="99dp"
                        android:layout_marginTop="@dimen/dimen_margin_8dp"
                        android:layout_marginStart="@dimen/dimen_margin_4dp"
                        app:layout_constraintBottom_toBottomOf="@+id/mine_function_guideline_bottom"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/cn_guide_line"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/mine_function_play_view"
                    android:layout_width="match_parent"
                    android:layout_height="87dp"
                    android:layout_marginTop="@dimen/dimen_margin_5dp"
                    app:layout_constraintTop_toBottomOf="@+id/layout_user_assets">
                    <com.xiaomi.fitness.mine.widget.MineActivePKPlayChannelView
                        android:id="@+id/play_active_pk_view"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <com.xiaomi.fitness.mine.widget.MedalEntranceView
                    android:id="@+id/medal_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_margin_12dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/guide_line"/>
                <com.fitness.banner.export.view.MultipleStyleBannerView
                    android:id="@+id/iv_banner"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_margin_12dp"
                    app:layout_constraintTop_toBottomOf="@+id/medal_view"
                    app:layout_goneMarginTop="0dp"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/health_visit_doctor"
                    android:background="@drawable/mine_label_bg_white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/page_extra_padding_horizontal_large"
                    android:paddingVertical="@dimen/dimen_margin_5dp"
                    app:layout_constraintTop_toBottomOf="@+id/iv_banner">
                    <TextView
                        android:textSize="17sp"
                        android:textColor="@color/text_color"
                        android:id="@+id/mine_health_visit_doctor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimen_margin_10dp"
                        android:text="@string/mine_health_visit_doctor"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/FontDemiBold"/>
                    <com.xiaomi.fitness.widget.RightArrowBindingSingleLineTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:card_rightValue="update"
                        app:icon="@drawable/mine_pingan_icon_new"
                        app:layout_constraintTop_toBottomOf="@+id/mine_health_visit_doctor"
                        app:showMore="true"
                        app:title="@string/mine_pingan_health"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="vertical"
                    android:background="@drawable/mine_label_bg_white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_margin_12dp"
                    app:layout_constraintTop_toBottomOf="@+id/health_visit_doctor">
                    <com.xiaomi.fitness.widget.RightArrowBindingSingleLineTextView
                        android:id="@+id/company_exclusive_entrance"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/page_extra_padding_horizontal_large"
                        app:card_rightValue="update"
                        app:icon="@drawable/ic_company_exclusive_entrance"
                        app:showMore="true"
                        app:title="@string/mine_company_exclusive_entrance"/>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/function_item_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.core.widget.NestedScrollView>
    </miuix.springback.view.SpringBackLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
