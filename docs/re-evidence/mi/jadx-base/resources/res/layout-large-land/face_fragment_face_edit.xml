<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootView"
    android:tag="layout-large-land/face_fragment_face_edit_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toTopOf="@+id/button_group"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/preview_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_40dp"
            android:layout_marginHorizontal="56dp"
            app:layout_constraintEnd_toStartOf="@+id/editor"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/outlineView"
                android:layout_width="320dp"
                android:layout_height="320dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.cardview.widget.CardView
                android:id="@+id/videoCardView"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardElevation="0dp"
                app:layout_constraintBottom_toBottomOf="@+id/outlineView"
                app:layout_constraintEnd_toEndOf="@+id/outlineView"
                app:layout_constraintStart_toStartOf="@+id/outlineView"
                app:layout_constraintTop_toTopOf="@+id/outlineView">
                <TextureView
                    android:id="@+id/mVideoView"
                    android:layout_width="20dp"
                    android:layout_height="20dp"/>
                <ImageView
                    android:id="@+id/video_placeholder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </androidx.cardview.widget.CardView>
            <com.xiaomi.fitness.watch.face.edit.ui.FaceEditPreviewView
                android:id="@+id/mImageView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleType="centerInside"
                app:layout_constraintBottom_toBottomOf="@+id/outlineView"
                app:layout_constraintEnd_toEndOf="@+id/outlineView"
                app:layout_constraintStart_toStartOf="@+id/outlineView"
                app:layout_constraintTop_toTopOf="@+id/outlineView"/>
            <ImageView
                android:id="@+id/aod_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="74dp"
                android:src="@drawable/face_edit_aod_preview"
                app:layout_constraintEnd_toEndOf="@+id/outlineView"
                app:layout_constraintStart_toStartOf="@+id/outlineView"
                app:layout_constraintTop_toBottomOf="@+id/outlineView"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.xiaomi.fitness.watch.face.widget.FaceEditPicker
            android:id="@+id/editor"
            android:tag="binding_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@+id/preview_container"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/button_group"
        android:background="@color/face_market_item_fill"
        android:paddingTop="@dimen/dimen_margin_13dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">
        <TextView
            android:id="@+id/actionUseView"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/CommonBtn.Primary"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
