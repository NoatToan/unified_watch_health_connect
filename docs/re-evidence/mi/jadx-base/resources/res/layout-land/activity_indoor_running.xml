<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:tag="layout-land/activity_indoor_running_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/startCl"
        android:tag="binding_1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="25dp"
        android:layout_marginTop="@dimen/dimen_margin_32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/endCl"
        app:layout_constraintHorizontal_weight="1.1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <include
            android:id="@+id/title"
            app:layout_constraintTop_toTopOf="parent"
            layout="@layout/view_indoor_title_land"/>
        <TextView
            android:textColor="@color/sport_detail_color"
            android:gravity="center_vertical"
            android:id="@+id/targetData"
            android:tag="binding_2"
            android:layout_width="190dp"
            android:layout_height="80dp"
            android:layout_marginBottom="20dp"
            android:autoSizeTextType="uniform"
            android:autoSizeStepGranularity="2dp"
            android:autoSizeMinTextSize="10dp"
            android:autoSizeMaxTextSize="70dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/FontDemiBold"/>
        <TextView
            android:textSize="70dp"
            android:id="@+id/goneTargetData"
            android:tag="binding_3"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="50dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="18dp"
            android:textStyle="bold"
            android:textColor="@color/sport_detail_color"
            android:id="@+id/unit"
            android:tag="binding_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="7dp"
            app:layout_constraintBottom_toBottomOf="@+id/goneTargetData"
            app:layout_constraintStart_toEndOf="@+id/goneTargetData"
            style="@style/FontDemiBold"/>
        <FrameLayout
            android:id="@+id/percentage"
            android:tag="binding_5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/targetData">
            <include
                app:layout_constraintBottom_toBottomOf="parent"
                layout="@layout/view_indoor_sport_target"/>
        </FrameLayout>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/sport_detail_color"
            android:id="@+id/bindDevice"
            android:tag="binding_6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/percentage"
            style="@style/FontRegular"/>
        <TextView
            android:gravity="center"
            android:id="@+id/line"
            android:tag="binding_7"
            android:layout_width="@dimen/margin_20dp"
            android:layout_height="wrap_content"
            android:text="|"
            app:layout_constraintBottom_toBottomOf="@+id/bindDevice"
            app:layout_constraintEnd_toStartOf="@+id/connect_tv"
            app:layout_constraintStart_toEndOf="@+id/bindDevice"
            app:layout_constraintTop_toTopOf="@+id/bindDevice"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/sport_detail_color"
            android:gravity="start"
            android:id="@+id/connect_tv"
            android:tag="binding_8"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/sport_connected"
            android:textDirection="locale"
            app:layout_constraintBottom_toBottomOf="@+id/bindDevice"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/line"
            app:layout_constraintTop_toTopOf="@+id/bindDevice"
            style="@style/FontRegular"/>
        <ImageView
            android:id="@+id/indoorNoPlaylist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_no_playlist"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/connect_tv"/>
        <com.xiaomi.fitness.sport.view.widget.RunningSportMusicView
            android:id="@+id/indoorRunningMusicView"
            android:background="@drawable/bg_indoor_running_music"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/connect_tv"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/endCl"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="65dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1.7"
        app:layout_constraintStart_toEndOf="@+id/startCl"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/sport_command_view"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/row11"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:weightSum="1"
                app:layout_constraintEnd_toStartOf="@+id/row12"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textSize="30dp"
                    android:textStyle="bold"
                    android:textColor="@color/sport_color_black"
                    android:gravity="center_vertical"
                    android:tag="binding_9"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/size_41"
                    android:fontFamily="@font/misanslatin_demibold"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/sport_unit_color"
                    android:tag="binding_10"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    style="@style/FontRegular"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/row12"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_weight="1.2"
                app:layout_constraintStart_toEndOf="@+id/row11"
                app:layout_constraintTop_toTopOf="@+id/row11"
                app:layout_constraintVertical_weight="1.2">
                <TextView
                    android:tag="binding_11"
                    style="@style/SportDataText"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/sport_unit_color"
                    android:tag="binding_12"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    style="@style/FontRegular"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/row21"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:layout_constraintEnd_toStartOf="@+id/row22"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/row11">
                <TextView
                    android:tag="binding_13"
                    style="@style/SportDataText"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/sport_unit_color"
                    android:tag="binding_14"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    style="@style/FontRegular"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/row22"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_weight="1.2"
                app:layout_constraintStart_toEndOf="@+id/row21"
                app:layout_constraintTop_toTopOf="@+id/row21">
                <TextView
                    android:tag="binding_15"
                    style="@style/SportDataText"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/sport_unit_color"
                    android:tag="binding_16"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    style="@style/FontRegular"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/row31"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:layout_constraintEnd_toStartOf="@+id/row32"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/row21">
                <TextView
                    android:tag="binding_17"
                    style="@style/SportDataText"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/sport_unit_color"
                    android:tag="binding_18"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    style="@style/FontRegular"/>
            </LinearLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/row32"
                android:tag="binding_19"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_weight="1.2"
                app:layout_constraintStart_toEndOf="@+id/row31"
                app:layout_constraintTop_toTopOf="@+id/row31">
                <TextView
                    android:textSize="34dp"
                    android:id="@+id/data_tv"
                    android:tag="binding_20"
                    android:layout_width="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/SportDataText"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/sport_unit_color"
                    android:tag="binding_21"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    app:layout_constraintStart_toStartOf="@+id/data_tv"
                    app:layout_constraintTop_toBottomOf="@+id/data_tv"
                    style="@style/FontRegular"/>
                <ImageView
                    android:id="@+id/hr_ic"
                    android:background="@drawable/heart_red"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginLeft="3dp"
                    android:layout_marginTop="9dp"
                    app:layout_constraintStart_toEndOf="@+id/data_tv"
                    app:layout_constraintTop_toTopOf="@+id/data_tv"/>
                <TextView
                    android:textSize="13dp"
                    android:textColor="@color/sport_detail_color"
                    android:tag="binding_22"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="3dp"
                    app:layout_constraintStart_toStartOf="@+id/hr_ic"
                    app:layout_constraintTop_toBottomOf="@+id/hr_ic"
                    style="@style/FontMedium"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.xiaomi.fitness.sport.view.widget.SportCommandView
            android:id="@+id/sport_command_view"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_marginEnd="@dimen/dimen_margin_20dp"
            android:layout_marginVertical="60dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
