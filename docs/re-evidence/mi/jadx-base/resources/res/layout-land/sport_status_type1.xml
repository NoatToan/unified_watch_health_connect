<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout-land/sport_status_type1_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/dimen_margin_14dp">
    <include
        android:id="@+id/time_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_10dp"
        android:layout_marginBottom="@dimen/dimen_margin_18dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/layout_time_info"/>
    <com.xiaomi.fitness.sport_capture.widgets.SpeedView
        android:id="@+id/speed"
        android:layout_width="98dp"
        android:layout_height="98dp"
        android:layout_marginBottom="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/up_down_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_margin_12dp"
        app:layout_constraintBottom_toTopOf="@+id/speed"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:paddingTop="@dimen/dimen_margin_7dp"
            android:paddingBottom="8dp"
            android:layout_width="14dp"
            android:layout_height="32dp"
            android:src="@mipmap/up_arrow"
            android:paddingStart="@dimen/dimen_margin_1dp"/>
        <TextView
            android:textSize="16dp"
            android:textColor="@color/white"
            android:id="@+id/up_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_margin_5dp"/>
        <ImageView
            android:paddingTop="@dimen/dimen_margin_7dp"
            android:paddingBottom="8dp"
            android:layout_width="14dp"
            android:layout_height="32dp"
            android:src="@mipmap/down_arrow"
            android:paddingStart="@dimen/dimen_margin_1dp"
            android:layout_marginStart="6dp"/>
        <TextView
            android:textSize="16dp"
            android:textColor="@color/white"
            android:id="@+id/down_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
    <include
        android:id="@+id/elevation_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_10dp"
        android:layout_marginBottom="@dimen/dimen_margin_4dp"
        app:layout_constraintBottom_toTopOf="@+id/up_down_layout"
        app:layout_constraintStart_toStartOf="parent"
        layout="@layout/layout_info"/>
    <include
        android:id="@+id/distance_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_margin_18dp"
        app:layout_constraintBottom_toTopOf="@+id/elevation_info"
        app:layout_constraintStart_toStartOf="parent"
        layout="@layout/layout_info"/>
    <com.xiaomi.fitness.sport_capture.widgets.PathView
        android:id="@+id/path_view"
        android:layout_width="98dp"
        android:layout_height="98dp"
        android:layout_marginBottom="@dimen/dimen_margin_6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <include
        android:id="@+id/hr_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toTopOf="@+id/path_view"
        app:layout_constraintEnd_toEndOf="parent"
        layout="@layout/layout_info"/>
    <include
        android:id="@+id/calorie_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_margin_18dp"
        app:layout_constraintBottom_toTopOf="@+id/hr_info"
        app:layout_constraintEnd_toEndOf="parent"
        layout="@layout/layout_info"/>
    <include
        android:id="@+id/device_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_margin_18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        layout="@layout/layout_device_info"/>
    <com.xiaomi.fitness.sport_capture.widgets.hr.HeartRateView
        android:id="@+id/hr_demo"
        android:visibility="gone"
        android:layout_width="98dp"
        android:layout_height="98dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
