<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout-land/view_eco_indoor_title_land_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="17dp"
        android:textColor="@color/sport_detail_color"
        android:id="@+id/sportType"
        android:tag="binding_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/FontNormal"/>
    <ImageView
        android:id="@+id/switchScreen"
        android:background="@drawable/vectorswitch"
        android:visibility="invisible"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toTopOf="@+id/sportType"
        app:layout_constraintEnd_toStartOf="@+id/sportType"/>
    <ImageView
        android:id="@+id/sportConfig"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/sporting_set"
        android:contentDescription="@string/sport_config"
        app:layout_constraintBottom_toBottomOf="@+id/sportType"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/sportType"/>
</androidx.constraintlayout.widget.ConstraintLayout>
