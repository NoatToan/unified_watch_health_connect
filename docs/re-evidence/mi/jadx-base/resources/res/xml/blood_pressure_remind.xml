<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.xiaomi.fitness.health.bloodpressure.ui.CustomerSwitchPreference
        android:layout="@layout/layout_two_textview_switch_button_customer"
        android:title="@string/health_blood_pressure_measure_remind"
        android:key="remind_enable"
        android:summary="@string/health_blood_pressure_measure_remind_tip"/>
    <miuix.preference.RadioButtonPreferenceCategory
        android:key="radio_group_remind"
        android:dependency="remind_enable">
        <miuix.preference.RadioSetPreferenceCategory>
            <com.xiaomi.fitness.health.bloodpressure.ui.CustomRadioPreference
                android:title="@string/health_blood_pressure_normal"
                android:key="normal_enable"
                android:summary="@string/health_blood_pressure_normal_tip"
                android:defaultValue="true"/>
            <miuix.preference.TextPreference
                android:layout="@layout/health_miuix_preference_text"
                android:title="@string/health_blood_pressure_repeat_mode"
                android:key="normal_repeat_mode"
                android:dependency="normal_enable"/>
            <miuix.preference.TextPreference
                android:layout="@layout/health_miuix_preference_text"
                android:title="@string/health_blood_pressure_remind_time"
                android:key="normal_remind"
                android:dependency="normal_enable"/>
        </miuix.preference.RadioSetPreferenceCategory>
        <miuix.preference.RadioSetPreferenceCategory>
            <com.xiaomi.fitness.health.bloodpressure.ui.CustomRadioPreference
                android:title="@string/health_blood_pressure_mild_abnormal"
                android:key="mid_enable"
                android:summary="@string/health_blood_pressure_mild_abnormal_tip"/>
            <miuix.preference.TextPreference
                android:layout="@layout/health_miuix_preference_text"
                android:title="@string/health_blood_pressure_repeat_mode"
                android:key="mid_repeat_mode"
                android:dependency="mid_enable"/>
            <miuix.preference.TextPreference
                android:layout="@layout/health_miuix_preference_text"
                android:title="@string/health_blood_pressure_remind_time"
                android:key="mid_remind1"
                android:dependency="mid_enable"/>
            <miuix.preference.TextPreference
                android:layout="@layout/health_miuix_preference_text"
                android:title="@string/health_blood_pressure_remind_time"
                android:key="mid_remind2"
                android:dependency="mid_enable"/>
        </miuix.preference.RadioSetPreferenceCategory>
        <miuix.preference.RadioSetPreferenceCategory>
            <com.xiaomi.fitness.health.bloodpressure.ui.CustomRadioPreference
                android:title="@string/health_blood_pressure_severe_abnormal"
                android:key="severe_enable"
                android:summary="@string/health_blood_pressure_severe_abnormal_tip"/>
            <miuix.preference.TextPreference
                android:layout="@layout/health_miuix_preference_text"
                android:title="@string/health_blood_pressure_remind_time"
                android:key="severe_remind1"
                android:dependency="severe_enable"/>
            <miuix.preference.TextPreference
                android:layout="@layout/health_miuix_preference_text"
                android:title="@string/health_blood_pressure_remind_time"
                android:key="severe_remind2"
                android:dependency="severe_enable"/>
            <miuix.preference.TextPreference
                android:layout="@layout/health_miuix_preference_text"
                android:title="@string/health_blood_pressure_remind_time"
                android:key="severe_remind3"
                android:dependency="severe_enable"/>
        </miuix.preference.RadioSetPreferenceCategory>
        <miuix.preference.RadioSetPreferenceCategory android:key="custom_category">
            <com.xiaomi.fitness.health.bloodpressure.ui.CustomRadioPreference
                android:title="@string/health_blood_pressure_custom_scheme"
                android:key="custom_enable"
                android:summary="@string/health_blood_pressure_custom_scheme_tip"/>
            <miuix.preference.TextPreference
                android:layout="@layout/health_miuix_preference_text"
                android:title="@string/health_blood_pressure_repeat_mode"
                android:key="custom_repeat_mode"
                android:dependency="custom_enable"/>
            <miuix.preference.DropDownPreference
                android:layout="@layout/health_miuix_preference_text"
                android:title="@string/health_blood_pressure_daily_reminders"
                android:key="custom_day_count"
                android:dependency="custom_enable"/>
        </miuix.preference.RadioSetPreferenceCategory>
    </miuix.preference.RadioButtonPreferenceCategory>
</PreferenceScreen>
