<?xml version="1.0" encoding="utf-8"?>
<MotionScene xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <ConstraintSet android:id="@+id/start">
        <Constraint
            android:id="@+id/cardView"
            android:background="@color/text_revert_color"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_margin_5dp"
            android:layout_marginEnd="@dimen/dimen_margin_5dp"
            app:cardCornerRadius="15dp"
            app:cardElevation="2dp"
            app:cardPreventCornerOverlap="true"
            app:cardUseCompatPadding="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/seeList"/>
        <Constraint
            android:gravity="center"
            android:id="@+id/locationBtn"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:layout_marginStart="@dimen/dimen_margin_5dp"
            app:cardCornerRadius="15dp"
            app:cardElevation="1.5dp"
            app:cardPreventCornerOverlap="true"
            app:cardUseCompatPadding="true"
            app:layout_constraintBottom_toTopOf="@+id/selectItem"
            app:layout_constraintStart_toStartOf="parent"/>
        <Constraint
            android:gravity="center"
            android:id="@+id/seeList"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:paddingVertical="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/locationBtn"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/locationBtn"/>
    </ConstraintSet>
    <ConstraintSet android:id="@+id/end">
        <Constraint
            android:id="@+id/cardView"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0"
            android:layout_marginStart="@dimen/dimen_margin_12dp"
            android:layout_marginEnd="@dimen/dimen_margin_12dp"
            app:cardCornerRadius="15dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/stub"/>
        <Constraint
            android:gravity="center"
            android:id="@+id/locationBtn"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:layout_marginTop="3dp"
            android:layout_marginStart="13dp"
            app:cardCornerRadius="15dp"
            app:cardElevation="1.5dp"
            app:cardPreventCornerOverlap="true"
            app:cardUseCompatPadding="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <Constraint
            android:gravity="center"
            android:id="@+id/seeList"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:paddingVertical="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/locationBtn"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/locationBtn"/>
    </ConstraintSet>
    <Transition
        app:constraintSetEnd="@+id/end"
        app:constraintSetStart="@+id/start"
        app:duration="800">
        <KeyFrameSet>
            <KeyAttribute
                android:alpha="0"
                app:framePosition="60"
                app:motionTarget="@+id/cardView"/>
        </KeyFrameSet>
    </Transition>
</MotionScene>
