<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout-sw600dp-land/activity_sleep_animal_share_0"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:background="@color/black_30"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/size_12"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_max="340dp">
                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_share"
                        android:layout_width="match_parent"
                        android:layout_height="502dp"
                        app:cardCornerRadius="@dimen/size_16"
                        app:cardElevation="0dp">
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/cl_card_bg"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/iv_card_bg"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="fitXY"
                                app:srcCompat="@drawable/health_sleep_animal_bg_default"/>
                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:id="@+id/cl_content"
                                android:background="@drawable/health_sleep_animal_share_shape_bg"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginTop="@dimen/size_12"
                                android:layout_marginBottom="@dimen/size_86"
                                android:layout_marginStart="@dimen/size_12"
                                android:layout_marginEnd="@dimen/size_12"
                                android:paddingHorizontal="@dimen/size_20"
                                android:paddingVertical="@dimen/size_20">
                                <com.xiaomi.fitness.widget.view.RoundImageView
                                    android:id="@+id/iv_user_avatar"
                                    android:background="@drawable/passport_default_avatar"
                                    android:layout_width="32.8dp"
                                    android:layout_height="32.8dp"
                                    android:importantForAccessibility="no"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"/>
                                <TextView
                                    android:textSize="12.6dp"
                                    android:textColor="@color/black"
                                    android:id="@+id/tv_user_name"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:maxLines="1"
                                    android:layout_marginStart="6.7dp"
                                    app:layout_constraintBottom_toTopOf="@+id/tv_time_range"
                                    app:layout_constraintStart_toEndOf="@+id/iv_user_avatar"
                                    app:layout_constraintTop_toTopOf="@+id/iv_user_avatar"
                                    app:layout_constraintVertical_chainStyle="packed"
                                    style="@style/FontMedium"/>
                                <TextView
                                    android:textSize="9.5dp"
                                    android:textColor="@color/black_60"
                                    android:id="@+id/tv_time_range"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:maxLines="1"
                                    app:layout_constraintBottom_toBottomOf="@+id/iv_user_avatar"
                                    app:layout_constraintStart_toStartOf="@+id/tv_user_name"
                                    app:layout_constraintTop_toBottomOf="@+id/tv_user_name"
                                    style="@style/FontRegular"/>
                                <TextView
                                    android:textSize="10.8dp"
                                    android:textColor="@color/black_60"
                                    android:gravity="center"
                                    android:id="@+id/tv_animal_label"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="24dp"
                                    android:text="@string/health_sleep_has_animal_report_card_title"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toBottomOf="@+id/tv_time_range"
                                    style="@style/FontMedium"/>
                                <TextView
                                    android:textSize="30dp"
                                    android:textColor="@color/black"
                                    android:gravity="center"
                                    android:id="@+id/tv_animal_type"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4.7dp"
                                    android:text="@string/health_sleep_animal_night_owl"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toBottomOf="@+id/tv_animal_label"
                                    style="@style/FontLatinSemiBold"/>
                                <TextView
                                    android:textSize="10.8dp"
                                    android:textColor="@color/black"
                                    android:gravity="center"
                                    android:id="@+id/tv_animal_desc"
                                    android:layout_width="213dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4.7dp"
                                    android:text="@string/health_sleep_animal_introduction_night_owl"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toBottomOf="@+id/tv_animal_type"
                                    style="@style/FontLatinRegular"/>
                                <com.xiaomi.fitness.health.sleep.view.SleepAnimalShadowLayout
                                    android:layout_gravity="center_horizontal"
                                    android:id="@+id/shadow_view"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="-3dp"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toBottomOf="@+id/tv_animal_desc"
                                    app:shadowColor="@color/health_sleep_animal_shadow_sheep"
                                    app:shadowDx="20dp"
                                    app:shadowDy="20dp"
                                    app:shadowRadius="13dp"
                                    app:shadowShape="oval">
                                    <com.xiaomi.fitness.widget.view.RoundImageView
                                        android:id="@+id/iv_animal_image"
                                        android:layout_width="162dp"
                                        android:layout_height="162dp"
                                        android:importantForAccessibility="no"
                                        app:innerStrokeColor="@color/health_sleep_animal_stroke_sheep"
                                        app:innerStrokeWidth="0.33dp"
                                        app:srcCompat="@drawable/health_sleep_animal_sheep"/>
                                </com.xiaomi.fitness.health.sleep.view.SleepAnimalShadowLayout>
                            </androidx.constraintlayout.widget.ConstraintLayout>
                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/iv_app_icon"
                                android:layout_width="45dp"
                                android:layout_height="45dp"
                                android:importantForAccessibility="no"
                                android:layout_marginStart="16dp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/cl_content"
                                app:srcCompat="@drawable/ic_launch_logo_rounded_corner"/>
                            <TextView
                                android:textSize="13.3sp"
                                android:textColor="@color/white"
                                android:id="@+id/tv_app_name"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="@string/app_name"
                                android:maxLines="1"
                                android:letterSpacing="0.06"
                                android:paddingHorizontal="@dimen/size_10"
                                app:layout_constraintBottom_toTopOf="@+id/tv_app_tip"
                                app:layout_constraintEnd_toStartOf="@+id/iv_share_qrcode"
                                app:layout_constraintStart_toEndOf="@+id/iv_app_icon"
                                app:layout_constraintTop_toTopOf="@+id/iv_app_icon"
                                app:layout_constraintVertical_chainStyle="packed"
                                style="@style/FontLatinSemiBold"/>
                            <TextView
                                android:textSize="@dimen/font_10"
                                android:textColor="@color/white"
                                android:id="@+id/tv_app_tip"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="@string/health_sleep_wear_xiaomi_wearable_device"
                                android:maxLines="2"
                                android:paddingHorizontal="@dimen/size_10"
                                app:layout_constraintBottom_toBottomOf="@+id/iv_app_icon"
                                app:layout_constraintEnd_toStartOf="@+id/iv_share_qrcode"
                                app:layout_constraintStart_toStartOf="@+id/tv_app_name"
                                app:layout_constraintTop_toBottomOf="@+id/tv_app_name"
                                style="@style/FontLatinMedium"/>
                            <ImageView
                                android:id="@+id/iv_share_qrcode_bg"
                                android:background="@drawable/health_common_share_radius_white_bg"
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                android:layout_marginEnd="@dimen/size_18"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/cl_content"/>
                            <ImageView
                                android:id="@+id/iv_share_qrcode"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:importantForAccessibility="no"
                                app:layout_constraintBottom_toBottomOf="@+id/iv_share_qrcode_bg"
                                app:layout_constraintEnd_toEndOf="@+id/iv_share_qrcode_bg"
                                app:layout_constraintStart_toStartOf="@+id/iv_share_qrcode_bg"
                                app:layout_constraintTop_toTopOf="@+id/iv_share_qrcode_bg"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.core.widget.NestedScrollView>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/fl_bottom"
        android:background="@color/black_30"
        android:layout_width="match_parent"
        android:layout_height="100dp">
        <FrameLayout
            android:background="@drawable/health_share_white_bottom_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:paddingBottom="@dimen/dimen_margin_5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">
                <RelativeLayout
                    android:orientation="vertical"
                    android:id="@+id/rlDownload"
                    android:layout_width="49dp"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="yes">
                    <ImageView
                        android:id="@+id/img_download"
                        android:layout_width="49dp"
                        android:layout_height="49dp"
                        android:src="@drawable/share_download"
                        android:layout_alignParentTop="true"
                        android:layout_centerHorizontal="true"
                        android:importantForAccessibility="no"/>
                    <TextView
                        android:textSize="@dimen/dimen_10sp"
                        android:textColor="@color/text_color_60"
                        android:gravity="center"
                        android:id="@+id/txt_download"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimen_margin_5dp"
                        android:text="@string/share_download"
                        android:layout_below="@+id/img_download"
                        android:layout_centerHorizontal="true"/>
                </RelativeLayout>
                <RelativeLayout
                    android:orientation="vertical"
                    android:id="@+id/rlShareWxSession"
                    android:layout_width="49dp"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="yes"
                    android:layout_marginStart="@dimen/dimen_margin_30dp">
                    <ImageView
                        android:id="@+id/img_share_wx_session"
                        android:layout_width="49dp"
                        android:layout_height="49dp"
                        android:src="@drawable/share_wx_session"
                        android:layout_alignParentTop="true"
                        android:layout_centerHorizontal="true"
                        android:importantForAccessibility="no"/>
                    <TextView
                        android:textSize="@dimen/dimen_10sp"
                        android:textColor="@color/text_color_60"
                        android:gravity="center"
                        android:id="@+id/txt_share_wx_session"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimen_margin_5dp"
                        android:text="@string/share_wx_session"
                        android:layout_below="@+id/img_share_wx_session"
                        android:layout_centerHorizontal="true"/>
                </RelativeLayout>
                <RelativeLayout
                    android:orientation="vertical"
                    android:id="@+id/rlShareTimeline"
                    android:layout_width="49dp"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="yes"
                    android:layout_marginStart="@dimen/dimen_margin_30dp">
                    <ImageView
                        android:id="@+id/img_share_wx_timeline"
                        android:layout_width="49dp"
                        android:layout_height="49dp"
                        android:src="@drawable/share_wx_timeline"
                        android:layout_alignParentTop="true"
                        android:layout_centerHorizontal="true"
                        android:importantForAccessibility="no"/>
                    <TextView
                        android:textSize="@dimen/dimen_10sp"
                        android:textColor="@color/text_color_60"
                        android:gravity="center"
                        android:id="@+id/txt_share_wx_timeline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimen_margin_5dp"
                        android:text="@string/share_wx_timeline"
                        android:layout_below="@+id/img_share_wx_timeline"
                        android:layout_centerHorizontal="true"/>
                </RelativeLayout>
                <RelativeLayout
                    android:orientation="vertical"
                    android:id="@+id/rlMore"
                    android:layout_width="49dp"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="yes"
                    android:layout_marginStart="@dimen/dimen_margin_30dp">
                    <ImageView
                        android:id="@+id/img_share_more"
                        android:layout_width="49dp"
                        android:layout_height="49dp"
                        android:src="@drawable/ic_share_more"
                        android:layout_alignParentTop="true"
                        android:layout_centerHorizontal="true"
                        android:importantForAccessibility="no"/>
                    <TextView
                        android:textSize="@dimen/dimen_10sp"
                        android:textColor="@color/text_color_60"
                        android:gravity="center"
                        android:id="@+id/txt_share_more"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimen_margin_5dp"
                        android:text="@string/more"
                        android:layout_below="@+id/img_share_more"
                        android:layout_centerHorizontal="true"/>
                </RelativeLayout>
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
