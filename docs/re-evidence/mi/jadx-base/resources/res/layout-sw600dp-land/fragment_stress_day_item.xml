<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/stress_container"
    android:tag="layout-sw600dp-land/fragment_stress_day_item_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.xiaomi.fitness.chart.view.BarChartRecyclerView
            android:id="@+id/bar_recycler"
            app:barChartMaxWidth="@dimen/size_3"
            app:barChartRoundRectRadiusRatio="0.25"
            app:barChartSegment="1"
            app:chartColor="@color/stress_chart"
            app:displayNumbers="48"
            app:enableEndDayXAxis="true"
            app:enableStartYAxisLabel="false"
            style="@style/ChartBaseStyle"/>
        <com.xiaomi.fitness.view.DataTitleView
            android:id="@+id/dataTitleView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/common_card_bg_white"
        android:padding="@dimen/dimen_margin_18dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="@dimen/health_detail_page_common_margin_horizontal"
        android:layout_marginEnd="@dimen/health_detail_page_common_margin_horizontal">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/img_header"
                android:background="@drawable/health_data_stress_square"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:scaleType="center"
                android:layout_alignParentTop="true"
                android:layout_marginEnd="@dimen/size_10"
                android:layout_alignParentStart="true"/>
            <TextView
                android:textStyle="bold"
                android:textColor="@color/text_color"
                android:id="@+id/txt_header_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_5_3"
                android:text="@string/health_stress_face_title"
                android:layout_toEndOf="@+id/img_header"
                style="@style/FontMedium.14sp"/>
        </RelativeLayout>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_12dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/health_pressure_face_icon_relax"
                android:background="@drawable/health_pressure_face_icon_relax"
                android:layout_width="12dp"
                android:layout_height="@dimen/dimen_margin_12dp"/>
            <TextView
                android:id="@+id/health_pressure_face_text_relax"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chart_level_relax"
                android:layout_marginStart="@dimen/dimen_margin_5dp"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/health_pressure_face_icon_mid"
                android:background="@drawable/health_pressure_face_icon_mid"
                android:layout_width="12dp"
                android:layout_height="@dimen/dimen_margin_12dp"
                android:layout_marginStart="66dp"/>
            <TextView
                android:id="@+id/health_pressure_face_text_mid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chart_level_mid"
                android:layout_marginStart="@dimen/dimen_margin_5dp"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/health_pressure_face_icon_sad"
                android:background="@drawable/health_pressure_face_icon_sad"
                android:layout_width="12dp"
                android:layout_height="@dimen/dimen_margin_12dp"
                android:layout_marginStart="66dp"
                android:layout_marginEnd="@dimen/dimen_margin_5dp"/>
            <TextView
                android:id="@+id/health_pressure_face_text_sad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chart_level_hard"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/health_pressure_face_icon_bad"
                android:background="@drawable/health_pressure_face_icon_bad"
                android:layout_width="12dp"
                android:layout_height="@dimen/dimen_margin_12dp"
                android:layout_marginStart="66dp"
                android:layout_marginEnd="@dimen/dimen_margin_5dp"/>
            <TextView
                android:gravity="start|center_vertical"
                android:id="@+id/health_pressure_face_text_bad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chart_level_bed"
                android:layout_marginStart="5dp"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <com.xiaomi.fitness.chart.view.ScrollChartRecycleView
            android:id="@+id/stress_face_chart_recycler"
            android:scrollbars="horizontal"
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:layout_marginTop="@dimen/dimen_margin_18dp"
            android:overScrollMode="never"
            app:displayNumbers="8"
            app:enableEndYAxisLabel="true"
            app:enableLineFill="false"
            app:enableScrollToScale="true"
            app:enableStartYAxisLabel="false"
            app:enableXAxisLineCircle="true"
            app:lineStrokeWidth="6"
            app:xAxisScaleDistance="10"/>
    </LinearLayout>
    <include
        android:id="@+id/ll_card"
        layout="@layout/layout_stress_dwm_common"/>
</LinearLayout>
