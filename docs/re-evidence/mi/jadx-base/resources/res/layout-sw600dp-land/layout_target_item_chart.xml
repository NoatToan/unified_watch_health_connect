<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/shape_data_item_bg"
    android:paddingBottom="20dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.xiaomi.fitness.widget.view.DataTitleSimpleView
        android:id="@+id/dataSimpleTitleView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/itemViewContainer"
        android:layout_width="141dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="71dp"
        android:paddingStart="18dp"
        app:layout_constraintBottom_toBottomOf="@+id/barChartRecycler"
        app:layout_constraintStart_toStartOf="parent">
        <com.xiaomi.fitness.baseui.widget.SportDetailItemView
            android:id="@+id/detailItemView1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:itemGravity="1"
            app:itemHeight="100dp"
            app:txtNameColor="@color/text_color"
            app:txtValueColor="@color/health_stand_chart"
            app:txtValueFont="@font/misanslatin_demibold"
            app:txtValueSize="@dimen/font_24"/>
        <com.xiaomi.fitness.baseui.widget.SportDetailItemView
            android:id="@+id/detailItemView2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26.67dp"
            app:itemGravity="1"
            app:itemHeight="100dp"
            app:txtNameColor="@color/text_color"
            app:txtValueColor="@color/health_stand_chart"
            app:txtValueFont="@font/misanslatin_demibold"
            app:txtValueSize="@dimen/font_24"/>
    </LinearLayout>
    <com.xiaomi.fitness.chart.view.BarChartRecyclerView
        android:id="@+id/barChartRecycler"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/size_20"
        app:autoXAxisTextSize="true"
        app:barChartRoundRectRadiusRatio="0.5"
        app:barSpace="0.64"
        app:chartColor="@color/health_stand_chart"
        app:contentPaddingBottom="71dp"
        app:displayNumbers="7"
        app:enableEndDayXAxis="true"
        app:enableEndYAxisLabel="true"
        app:enableStartYAxisLabel="false"
        app:highLightTodayXAxis="true"
        app:invalidChartColor="@color/health_stand_invalid_chart"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/itemViewContainer"
        app:layout_constraintTop_toTopOf="parent"
        app:showFlatRadius="true"
        app:showTargetProgress="true"
        style="@style/HealthTargetChart"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/tips_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:minHeight="@dimen/dimen_margin_40dp"
        android:layout_marginStart="@dimen/dimen_margin_18dp"
        android:layout_marginEnd="@dimen/dimen_margin_18dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/barChartRecycler">
        <TextView
            android:textColor="@color/target_tips_color"
            android:id="@+id/tip_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_margin_13dp"
            android:layout_marginBottom="@dimen/dimen_margin_13dp"
            android:layout_marginStart="@dimen/dimen_margin_16dp"
            android:layout_marginEnd="@dimen/dimen_margin_16dp"
            style="@style/FontNormal.12sp"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.constraintlayout.widget.ConstraintLayout>
