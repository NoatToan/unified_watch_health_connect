<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout-sw600dp-land/fragment_sport_target_chart_0"
    android:paddingBottom="@dimen/margin_20dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/target_weekbar_week_text_view"/>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/fragment_scroll_view"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/size_20"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/page_padding_horizontal_large">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:background="@drawable/shape_data_item_bg"
                android:paddingTop="18.7dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="18.7dp">
                <com.xiaomi.fitness.health.threetarget.view.VideoPreviewView
                    android:id="@+id/three_target_guide"
                    android:background="@color/shape_item_bg"
                    android:visibility="gone"
                    android:layout_width="160dp"
                    android:layout_height="80dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.xiaomi.fitness.health.threetarget.model.ThreeTargetView
                    android:id="@+id/three_targetview"
                    android:layout_width="160dp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="18.7dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerBottom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:overScrollMode="never"
                    android:layout_marginStart="200dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/layout_data_source"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <TextView
                        android:textSize="@dimen/text_size_9"
                        android:textColor="@color/text_color_40"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/health_target_data_source_dialog_title"
                        android:layout_marginEnd="@dimen/dimen_margin_3dp"
                        style="@style/FontNormal"/>
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/target_guide_icon"
                        android:background="@drawable/three_target_view_guide_icon"
                        android:padding="@dimen/dimen_margin_3dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <com.xiaomi.fitness.health.threetarget.view.TargetItemChartView
                android:id="@+id/layout_chart_calorie"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_12dp"
                app:goalType="calorie"/>
            <com.xiaomi.fitness.health.threetarget.view.TargetItemChartView
                android:id="@+id/layout_chart_step"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_12dp"
                app:goalType="step"/>
            <com.xiaomi.fitness.health.threetarget.view.TargetItemChartView
                android:id="@+id/layout_chart_mhIntensity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_12dp"
                app:goalType="mh_intensity"/>
            <com.xiaomi.fitness.health.threetarget.view.TargetItemChartView
                android:id="@+id/layout_chart_stand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_12dp"
                app:goalType="stand"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/medal_view"
                android:background="@drawable/shape_data_item_bg"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_12dp">
                <com.xiaomi.fitness.widget.view.DataTitleSimpleView
                    android:id="@+id/medal_title_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <View
                    android:background="@color/text_color_10"
                    android:layout_width="match_parent"
                    android:layout_height="0.3dp"
                    android:layout_marginTop="@dimen/margin_5dp"
                    android:layout_marginBottom="@dimen/dimen_margin_18dp"
                    android:layout_marginHorizontal="@dimen/size_18"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/medal_recycler_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/size_18"/>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/text_size_12"
                android:textColor="@color/text_color_40"
                android:id="@+id/iv_banner_title"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_12dp"
                android:layout_marginBottom="@dimen/dimen_margin_15dp"
                android:text="@string/sport_activity_recommend"
                android:layout_marginStart="@dimen/dimen_margin_18dp"
                style="@style/FontNormal"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_banner"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_margin_12dp"
                android:layout_marginHorizontal="@dimen/dimen_margin_18dp"
                app:layout_constraintDimensionRatio="3.45:1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/layout_medal"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
