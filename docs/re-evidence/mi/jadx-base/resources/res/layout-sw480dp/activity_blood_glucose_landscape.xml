<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout-sw480dp/activity_blood_glucose_landscape_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="10dp">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_25dp"
        android:paddingStart="@dimen/size_18"
        android:paddingEnd="@dimen/size_18">
        <ImageView
            android:id="@+id/ic_back"
            android:background="@drawable/ic_base_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="@dimen/text_size_16"
            android:textColor="@color/text_color"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/health_blood_glucose_agp_title"
            android:layout_marginStart="@dimen/dimen_margin_3dp"
            style="@style/FontMedium"/>
    </LinearLayout>
    <include
        android:id="@+id/agp_chart_guide"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_margin_20dp"
        android:layout_marginBottom="@dimen/dimen_margin_10dp"
        android:layout_marginStart="@dimen/dimen_margin_50dp"
        android:layout_marginEnd="@dimen/dimen_margin_50dp"
        layout="@layout/layout_blood_glucose_land_agp_guide"/>
    <FrameLayout
        android:id="@+id/fl_chart"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.xiaomi.fitness.chart.view.LineChartRecyclerView
            android:id="@+id/line_recycler"
            android:paddingTop="10dp"
            android:paddingBottom="@dimen/dimen_margin_10dp"
            android:layout_height="311dp"
            android:paddingStart="@dimen/dimen_margin_50dp"
            android:paddingEnd="@dimen/dimen_margin_50dp"
            app:displayNumbers="4"
            app:enableEndDayXAxis="true"
            app:enableLineFill="false"
            app:enableStartYAxisLabel="false"
            app:enableXAxisLineCircle="false"
            app:lineHighLightType="4"
            app:lineShaderBeginColor="@color/health_blood_glucose_chart_fill"
            app:lineShaderEndColor="@color/health_blood_glucose_chart_fill"
            app:lineStrokeWidth="3"
            app:xAxisLabelPosition="0"
            style="@style/ChartBaseStyle"/>
    </FrameLayout>
</LinearLayout>
